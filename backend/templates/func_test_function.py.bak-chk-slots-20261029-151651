/// <SignalCtl>
SetSignalRamp(signal* Sig,dword CycleTime,float step,float max)
{
  mRampId=StmCreate_Ramp(Sig,$Sig,max,CycleTime,(int)(max*CycleTime/step),0,0,0);  
  StmControl_Start(mRampId);   
  setTimer(StmControlDestroy,(int)(max*CycleTime/step));
}
on timer StmControlDestroy
{
  StmControl_Destroy(mRampId);     
}
/// <SignalCtl>
ResetSignalRamp()
{
  StmControl_Destroy(mRampId);    
}

