/// <BusCtl>
void SetBusLoad(float Load)
{ 
  float baseLoad;
  float curLoad;
  float nEst;
  int probe;
  //目标值限幅
  if (Load < 0) Load = 0;
  if (Load > 100) Load = 100;
  BusLoadTarget = Load;
  //先停发负载帧, 等总线统计刷新后取基础负载
  cancelTimer(timer_BusLoad);
  BusLoadnum = 0;
  TestWaitForTimeout(BusLoadSettle);
  baseLoad = canGetBusLoad(1);
  //目标不高于基础负载: 无需注入
  if (Load <= baseLoad + 0.5)
  {
    BusLoadPerFrame = 0;
    BusLoadnum = 0;
    return;
  }
  //标定: 每周期发10帧, 实测单帧带来的负载增量(%), 与波特率/帧长/ID位数无关
  probe = 10;
  BusLoadnum = probe;
  setTimerCyclic(timer_BusLoad,25);
  TestWaitForTimeout(BusLoadSettle);
  curLoad = canGetBusLoad(1);
  if (curLoad - baseLoad < 2.0)
  {
    probe = probe * 4;
    BusLoadnum = probe;
    TestWaitForTimeout(BusLoadSettle);
    curLoad = canGetBusLoad(1);
  }
  BusLoadPerFrame = (curLoad - baseLoad) / probe;
  if (BusLoadPerFrame < 0.01)
    BusLoadPerFrame = 0.9;   //标定失败兜底: 500k/8字节标准帧经验值
  //线性外推, 先取90%从下方逼近: 直接按目标外推容易把总线顶到饱和, 饱和后读数封顶无法判断过冲量
  nEst = (Load - baseLoad) / BusLoadPerFrame * 0.9;
  BusLoadnum = (int)(nEst + 0.5);
  if (BusLoadnum < 1) BusLoadnum = 1;
}
/// <BusCtl>
void TestBusLoad(float Load)
{ 
  float curLoad;
  float lastLoad;
  float err;
  int step;
  int iter;
  int bestNum;
  int bRising;
  SetBusLoad(Load);
  //闭环修正: 目标是"达到"目标负载(允许略高, 最多1%); 加帧后负载不再上升即到总线能力上限, 取当前值收工
  bestNum = 0;
  lastLoad = -1.0;
  bRising = 0;
  for (iter = 0; iter < 10; iter++)
  {
    TestWaitForTimeout(BusLoadSettle);
    curLoad = canGetBusLoad(1);
    err = BusLoadTarget - curLoad;
    if ((err <= 0) && (err >= -1.0))
    {
      bestNum = BusLoadnum;      //已达到目标(超出不到1%)
      break;
    }
    if (bRising && (lastLoad >= 0.0) && (curLoad <= lastLoad + 0.2))
      break;                     //加了帧负载却上不去: 已到上限, 取当前值
    if (BusLoadPerFrame < 0.01)  //目标不高于基础负载: 无需注入
      break;
    if ((curLoad >= 99.5) && (BusLoadTarget < 99.5))
      BusLoadnum = (int)(BusLoadnum * 0.75 + 0.5);   //读数封顶且目标在上限之下: 大步退
    else if (err < 0)
      BusLoadnum = (int)(BusLoadnum * BusLoadTarget / curLoad + 0.5);   //超出目标1%以上: 按比例退
    else
    {
      step = (int)(err / BusLoadPerFrame * 0.7 + 0.5);   //还差: 按剩余偏差的70%补, 至少补1帧
      if (step < 1) step = 1;
      BusLoadnum = BusLoadnum + step;
      bRising = 1;
    }
    if (BusLoadnum < 1) BusLoadnum = 1;
    lastLoad = curLoad;
  }
  if (bestNum > 0)               //末次迭代可能试过了头, 回到最小达标帧数
    BusLoadnum = bestNum;
  write("BusLoad target %f  actual %f  frames %d", BusLoadTarget, canGetBusLoad(1), BusLoadnum);
}
/// <BusCtl>
void CancelBusLoad()
{ 
  cancelTimer(timer_BusLoad);
  BusLoadnum = 0;
  BusLoadTarget = 0;
}
