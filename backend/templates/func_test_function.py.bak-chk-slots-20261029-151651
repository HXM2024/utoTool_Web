/// <SignalCheck>
long testWaitForSignalKeepMatch(signal * sig, float compareValue, long time)
{
  const long checkWindow_ms = 5;          // 每 5 毫秒检查一次
  long startTime;
  startTime=0;

  while (startTime <= time)
  {
    long res;

    res = testWaitForSignalMatch(sig, compareValue, checkWindow_ms); // checkWindow_ms 是毫秒


    if (res == -1) return -1;           // 检测出错
    if (res == 0)  return 0;            // 窗口内从未匹配 → 保持失败
  startTime += 5;
  }

    // 整个时间段内信号始终等于 compareValue
    return 1;
}
