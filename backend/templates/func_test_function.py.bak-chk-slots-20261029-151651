/// <SignalCtl>
SetSignalRate(signal* Sig, float step, float num)
{
    long i;
    float currentValue;
    float targetValue ;  // 目标值
    float nextValue;
    float minVal, maxVal;
    const float tolerance = 0.01;     // 单步校验容差
    const float finalTolerance = 0.01; // 目标达成容差（可调整）
    targetValue = num;
    // 步长为 0，直接警告并退出
    if (step == 0)
    {
        testStepWarning("步长设置为0，信号无变化！");
        return;
    }

    // 如果初始值已经满足目标（容差范围内），则直接返回
    currentValue = $Sig;
    if (abs(currentValue - targetValue) <= finalTolerance)
    {
        return;
    }
    if(currentValue > targetValue) //当前值大于预期值
      step = abs(step)*(-1);
    i = 0;
    while (1)
    {
        currentValue = $Sig;   // 获取当前信号值

        // 根据 step 符号判断是否已越过目标值（考虑容差）
        if (step > 0 && currentValue >= targetValue - finalTolerance)
            break;
        if (step < 0 && currentValue <= targetValue + finalTolerance)
            break;

        // 计算下一个设定值（不允许越过目标值）
        if (step > 0)
            nextValue = _min(currentValue + step, targetValue);
        else
            nextValue = _max(currentValue + step, targetValue);

        $Sig = nextValue;  // 赋值信号

        // 等待信号到达 nextValue 的容差范围内，超时 1000ms
        minVal = nextValue - tolerance;
        maxVal = nextValue + tolerance;
        if (testWaitForSignalInRange(Sig, minVal, maxVal, 1000) != 1)
        {
            TestStepFail("", "信号设置超时！第 %d 次，目标值：%.2f，当前设定：%.2f",
                         i + 1, targetValue, nextValue);
            return;
        }

        i++;
        if (i > 1000)
        {
            TestStepFail("", "信号设置步数过多，超过 1000 步");
            break;
        }
    }

    // 最后确保最终值精确为目标值（可选）
    $Sig = targetValue;
    if (testWaitForSignalInRange(Sig, targetValue - finalTolerance,
                                 targetValue + finalTolerance, 1000) != 1)
    {
        TestStepFail("", "信号最终值未达到目标 %.2f", targetValue);
    }
}
/// <Utility>
void SignalCheck_addTable(char Tablelname[],char ExpectHear[],char ExpectCell[],char ResultCell[],char Result[])
{
  long table = 0;
  int i=0,j=0;
  char Tabledescribe[200];
  
  snprintf(Tabledescribe,elcount(Tabledescribe),"Check %s %s",Tablelname,ExpectHear);
  // begin table
  
  table = TestInfoTable(Tabledescribe);
  // header
  TestInfoHeadingBegin(table, 0);
  TestInfoCell(table, "SigName");
  TestInfoCell(table, ExpectHear);
  TestInfoCell(table, "Result Value");
  TestInfoCell(table, "Result");  
  TestInfoHeadingEnd(table);
  // row 1
  TestInfoRow(table, 0);
  TestInfoCell(table, Tablelname);
  TestInfoCell(table, ExpectCell);
  TestInfoCell(table, ResultCell);
  TestInfoCell(table, Result);
  
  if(strncmp("pass",Result,4)==0)
  { 
    writeEx(-3,3,"%s %s",ExpectHear,ExpectCell);
    writeEx(-3,3,"Result %s",ResultCell);
    writeEx(-3,3,"+++%s+++ Value is Expect",Tablelname);
    TestSteppass(0, "Check Signal", table);
    TestSteppass("Check Signal","Check %s %s %s",Tablelname,ExpectHear,ExpectCell);
  }
  if(strncmp("fail",Result,4)==0)
  {
    writeEx(-3,3,"%s %s",ExpectHear,ExpectCell);
    writeEx(-3,3,"Result %s",ResultCell);    
    writeEx(-3,3,"+++%s+++ Value is Nonexpect",Tablelname);
    testStepFail(0, "Check Signal", table);
    testStepFail("Check Signal","Check %s %s %s",Tablelname,ExpectHear,ExpectCell);
  }
}
