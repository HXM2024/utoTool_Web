/// <Diag>
diagSendReq(byte code[])
{
  int i;
  char Code[100];
  diagRequest * req;
  snprintf(Code,elCount(Code),"");
  diagSetTarget("ABS_ESP");
  diagResize(req,elcount(code));
  for(i=0;i<elcount(code);i++)
  {
    DiagSetPrimitiveByte(req,i,code[i]);
  }
  diagSendRequest(req);
  testWaitForDiagRequestSent(req,100);
  testWaitForDiagResponse(req,500);
  if(DiagGetRespPrimitiveByte(req,0)==0x7f)
  {   
    for(i=0;i<(DiagGetRespPrimitiveSize(req));i++)
      { 
        snprintf(Code,elCount(Code),"%s%02X ",Code,DiagGetRespPrimitiveByte(req,i));
      }
    testStepFail("诊断负响应","响应码 %s",Code);
  }
  else{
    testSteppass("诊断正响应","诊断正响应");
  }
  diagStopTesterPresent();
}
