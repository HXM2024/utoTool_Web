/// <EnvCfg>
void Software_version(char CaliArray[],char ECUArray[],char SBTArray[],char FBTArray[],char SVNArray[],char VersArray[])
{ int i,len;
  diagRequest  *  diagReq;
  char CaliArr[10];
  char ECUArr[10];
  char SBTArr[4];
  char FBTArr[4];
  char SVNArr[4];
  char VersArr[4];
  const byte Cali  =3;
  const byte ECU   =13;
  const byte SBT   =23;
  const byte FBT   =27;
  const byte SVN   =47;
  const byte Vers  =57;
  diagSetTarget ("ABS_ESP");
  diagResize(diagReq,3);
  DiagSetPrimitiveByte(diagReq,0,0x22);
  DiagSetPrimitiveByte(diagReq,1,0x35);
  DiagSetPrimitiveByte(diagReq,2,0x70);
  diagSendRequest(diagReq);
  testWaitForDiagRequestSent(diagReq,50);
  testWaitForDiagResponse(diagReq,1000);
  for(i=0;i<DiagGetRespPrimitiveSize(diagReq);i++)
  {
    snprintf(CaliArr,10,"");
    snprintf(ECUArr,10,"");
    snprintf(SBTArr,4,"");
    snprintf(FBTArr,4,"");
    snprintf(SVNArr,4,"");
    snprintf(VersArr,4,"");
    switch(i)
    { 
      case Cali:
        for(len=0;len<strlen(CaliArray);len++)
        { 
          CaliArr[len]=DiagGetRespPrimitiveByte(diagReq,i+len);
          
        }
        if(strncmp(CaliArr,CaliArray,strlen(CaliArr))!=0 )
        {
          testStepFail("","标定数据版本不符 Expect:%s    Result:%s",CaliArr,CaliArray);
          if( TestWaitForTesterConfirmation("标定数据版本不符")==2)
          {stop();}
        }
        else
        {
          testStepPass("","标定数据版本符合:%s",CaliArr);
        }
        i+=strlen(CaliArray)-1;
        break;
       case ECU :        
        for(len=0;len<strlen(ECUArray);len++)
        {
          ECUArr[len]=DiagGetRespPrimitiveByte(diagReq,i+len);
        } 
        if(strncmp(ECUArr,ECUArray,strlen(ECUArr))!=0)
        {
          testStepFail("","内部代号不符 Expect:%s    Result:%s",ECUArr,ECUArray);
          if( TestWaitForTesterConfirmation("内部代号不符")==2)
          {stop();}
        }
        else
        {
          testStepPass("","内部代号符合:%s",ECUArr);
        }        
        i+=strlen(ECUArray)-1;
        break;
      case SBT :
        for(len=0;len<strlen(SBTArray);len++)
        {
          SBTArr[len]=DiagGetRespPrimitiveByte(diagReq,i+len);
        } 
        if(strncmp(SBTArr,SBTArray,strlen(SBTArr))!=0)
        {
          testStepFail("","SBT版本不符 Expect:%s    Result:%s",SBTArr,SBTArray);
          if( TestWaitForTesterConfirmation("SBT版本不符")==2)
          {stop();}
        }
        else
        {
          testStepPass("","SBT版本符合:%s",SBTArr);
        }        
        i+=strlen(SBTArray)-1;
        break;
      case FBT :
        for(len=0;len<strlen(FBTArray);len++)
        {
          FBTArr[len]=DiagGetRespPrimitiveByte(diagReq,i+len);
        } 
        if(strncmp(FBTArr,FBTArray,strlen(FBTArr))!=0)
        {
          testStepFail("","FBT版本不符 Expect:%s    Result:%s",FBTArr,FBTArray);
          if( TestWaitForTesterConfirmation("FBT版本不符")==2)
          {stop();}
        } 
        else
        {
          testStepPass("","FBT版本符合:%s",FBTArr);
        }    
        i+=strlen(FBTArray)-1;     
        break;
      case SVN :
        for(len=0;len<strlen(SVNArray);len++)
        {
          SVNArr[len]=DiagGetRespPrimitiveByte(diagReq,i+len);
        } 
        if(strncmp(SVNArr,SVNArray,strlen(SVNArr))!=0)
        {
          testStepFail("","SVN版本不符 Expect:%s    Result:%s",SVNArr,SVNArray);
          if( TestWaitForTesterConfirmation("SVN版本不符")==2)
          {stop();}
        } 
        else
        {
          testStepPass("","SVN版本符合:%s",SVNArr);
        } 
        i+=strlen(SVNArray)-1;        
        break;
      case Vers:
          snprintf(VersArr,elcount(VersArr),"%02X%02X", DiagGetRespPrimitiveByte(diagReq,i),DiagGetRespPrimitiveByte(diagReq,i+1));
          if(strncmp(VersArr,VersArray,strlen(VersArr))!=0)
          {
          testStepFail("","软件版本不符 Expect:%s    Result:%s",VersArr,VersArray);
            if( TestWaitForTesterConfirmation("软件版本不符")==2)
            {stop();}
          } 
          else
          {
            testStepPass("","软件版本符合:%s",VersArr);
          }
        
        break;   
    }
    //write("%X  %d",DiagGetRespPrimitiveByte(diagReq,i),i);
  }
}
