/**********************************
 Function name:   Msgtranjudge
判断外发报文是否出现在CAN总线上
ID[]：ID数组
tran：0：期望不出现，1：期望出现
***********************************/
/// <MsgCheck>
byte Msgtranjudge(word ID[],byte tran)
{
  int i,ii;
  for(i=0;i<elcount(ID);i++)
  {  TestJoinMessageEvent(ID[i]);
  }
  if(tran==0)
  { 
    ii=TestWaitForAnyJoinedEvent(50);
    if(ii==0)//停止发送
    {testSteppass("检测ECU通信","EPS停止发送报文。");return 1;}
    else if(ii>0)
    {testStepfail("检测ECU通信","EPS正常发送报文。");return 0;}
   }
  if(tran==1)
  { 
  ii=TestWaitForAnyJoinedEvent(1000);
    if(ii==0)//停止发送
    {testStepfail("检测ECU通信","EPS停止发送报文。");return 0;}
    else if(ii>0)
    {testSteppass("检测ECU通信","EPS正常发送报文。");return 1;}
   }
  if(tran==2)
  { 
   ii=TestWaitForAnyJoinedEvent(1000);
    if(ii==0)//停止发送
    {testStepWarning("检测ECU通信","EPS停止发送报文。");return 0;}
    else if(ii>0)
    {testStepWarning("检测ECU通信","EPS正常发送报文。");return 1;}
   }

}
