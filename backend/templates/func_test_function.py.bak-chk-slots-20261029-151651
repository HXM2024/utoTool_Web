/// <PowerCtl>
void Battery_Voltage_GreaterSet(sysvarFloat *Var,float Value)
{
  float Volt,currentVolt;
  xcpSetPollingCycle(Var,10);
  Volt=@sysvar::Prog_power::K30Volt;  
  while(1)
  { currentVolt=getxcp(Var);
    if(((Value+0.03) < currentVolt) && (currentVolt < (Value+0.07)))
    {break;}
    else
    {
      Volt+=((Value+0.05)-(currentVolt))/2;
      
      if(Volt>26 || Volt<0)
        {break;}
      VoltSet(Volt);
      testWaitForTimeout(100);
    }
  }
  writeex(-3,0,"电压设置 %gV",getxcp(Var));
  testStep("电压设置","电压--%g V",getxcp(Var));
  
}
/// <PowerCtl>
void Battery_Voltage_lessSet(sysvarFloat *Var,float Value)
{
  float Volt,currentVolt;
  Volt=@sysvar::Prog_power::K30Volt; 
  xcpSetPollingCycle(Var,10);
  while(1)
  { currentVolt=getxcp(Var);
    if(Value-0.07 < currentVolt && currentVolt < Value-0.03)
    {break;}
    else
    {
      Volt+=((Value-0.05)-(currentVolt))/2;
      if(Volt>26 || Volt<0)
        {break;}    
      VoltSet(Volt);
      testWaitForTimeout(100);
    }
