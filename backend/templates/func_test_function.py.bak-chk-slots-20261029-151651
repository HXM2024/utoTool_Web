/// <SignalCheck>
void SignalWaitCheckRate(signal* Sig, long timeout,  long CycleTime, float limit)
{
  float prevVal;
  float currVal;
  float deltaAngle;
  float angularSpeed;
  long elapsedMs = 0;
  float absSpeed ;
  
  if (CycleTime <= 0)
  {
    TestStepFail("", "CycleTime 必须大于 0");
    return;
  }

  prevVal = $Sig;

  while (1)
  {
    testwaitfortimeout(CycleTime);
    currVal = $Sig;
    deltaAngle = currVal - prevVal;
    angularSpeed = deltaAngle * (1000.0 / CycleTime);

    // 计算绝对值（兼容无 fabs 的环境）
    absSpeed = (angularSpeed >= 0) ? angularSpeed : -angularSpeed;
    
    if (absSpeed >= limit)   // 达到或超过限值（正反方向都检测）
    {
      TestStepPass("", "角速度达到限值：实际 %.2f °/s >= 目标 %.2f °/s（帧变化 %.2f° / %dms）", 
                   angularSpeed, limit, deltaAngle, CycleTime);
      break;
    }

    prevVal = currVal;  // 滑动窗口

    elapsedMs += CycleTime;
    if (elapsedMs >= timeout)
    {
      TestStepFail("", "超时 %dms，角速度未达限值：当前实际 %.2f °/s < 目标 %.2f °/s", 
                   timeout, angularSpeed, limit);
      break;
    }
  }
}
// 斜率区间判定：|角速度| 落入 [minLimit,maxLimit] 即通过
// 大于：minLimit=X, maxLimit=CHK_HIGH_LIMIT；小于：minLimit=0, maxLimit=X
/// <SignalCheck>
void SignalWaitCheckRate(signal* Sig, long timeout, long CycleTime, float minLimit, float maxLimit)
{
  float prevVal;
  float currVal;
  float deltaAngle;
  float angularSpeed;
  long elapsedMs = 0;
  float absSpeed;

  if (CycleTime <= 0)
  {
    TestStepFail("", "CycleTime 必须大于 0");
    return;
  }
  if (minLimit > maxLimit)
  {
    TestStepFail("", "区间下限 %.2f 大于上限 %.2f", minLimit, maxLimit);
    return;
  }

  prevVal = $Sig;

  while (1)
  {
    testwaitfortimeout(CycleTime);
    currVal = $Sig;
    deltaAngle = currVal - prevVal;
    angularSpeed = deltaAngle * (1000.0 / CycleTime);

    // 计算绝对值（兼容无 fabs 的环境）
    absSpeed = (angularSpeed >= 0) ? angularSpeed : -angularSpeed;

    if (absSpeed >= minLimit && absSpeed <= maxLimit)   // 落入限值区间（正反方向都检测）
    {
      TestStepPass("", "角速度落入区间：实际 %.2f °/s ∈ [%.2f, %.2f] °/s",
                   angularSpeed, minLimit, maxLimit);
      break;
    }

    prevVal = currVal;  // 滑动窗口

    elapsedMs += CycleTime;
    if (elapsedMs >= timeout)
    {
      TestStepFail("", "超时 %dms，角速度未落入 [%.2f, %.2f] °/s：当前实际 %.2f °/s",
                   timeout, minLimit, maxLimit, angularSpeed);
      break;
    }
  }
}
