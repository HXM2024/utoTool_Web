/// <Diag>
void Req14()
{ 
  int i;
  char Code[100];
  diagRequest  *  req14;
  diagSetTarget ("ABS_ESP");

  // 这样些可以不依赖dbc文件的定义，方便平台共用，也可以使用dbc中定义的诊断名称
  diagResize(req14,4);
  DiagSetPrimitiveByte(req14,0,0x14);
  DiagSetPrimitiveByte(req14,1,0xFF);
  DiagSetPrimitiveByte(req14,2,0xFF); 
  DiagSetPrimitiveByte(req14,3,0xFF);  
  
  
  diagSendRequest(req14);
  testWaitForDiagRequestSent(req14,100);
  testWaitForDiagResponse(req14,2000);
  if(DiagGetRespPrimitiveByte(req14,0)==0x7f)
  {   
    for(i=0;i<(DiagGetRespPrimitiveSize(req14));i++)
      { 
        snprintf(Code,elCount(Code),"%s%02X ",Code,DiagGetRespPrimitiveByte(req14,i));
      }
    testStepFail("诊断负响应","响应码 %s",Code);
  }else{
    testSteppass("诊断正响应","诊断正响应");
  }
  diagStopTesterPresent();
}
