// 设置本次检测的公共参数
/// <Internal>
// 追加一个检测槽位，返回槽位下标；槽位满时先结掉最早的一个，避免句柄泄漏
/// <Internal>
int ChkSlotPush(int Cond, float Low, float High, int Expect, char Name[])
{
  int idx;
  if (mChkCount >= CHK_MAX)
  {
    ChkReportAt(0);
    ChkSlotRemove(0);
  }
  idx = mChkCount;
  mChkIds[idx] = 0;
  mChkConds[idx] = Cond;
  mChkLows[idx] = Low;
  mChkHighs[idx] = High;
  mChkExpects[idx] = Expect;
  snprintf(mChkNames[idx], elcount(mChkNames[idx]), "%s", Name);
  mChkCount = idx + 1;
  return idx;
}

// 移除槽位（后面的前移）
/// <Internal>
void ChkSlotRemove(int idx)
{
  int i;
  if (idx < 0 || idx >= mChkCount) return;
  for (i = idx; i < mChkCount - 1; i++)
  {
    mChkIds[i]     = mChkIds[i + 1];
    mChkConds[i]   = mChkConds[i + 1];
    mChkLows[i]    = mChkLows[i + 1];
    mChkHighs[i]   = mChkHighs[i + 1];
    mChkExpects[i] = mChkExpects[i + 1];
    snprintf(mChkNames[i], elcount(mChkNames[i]), "%s", mChkNames[i + 1]);
  }
  mChkCount--;
  if (mChkCount < 0) mChkCount = 0;
}

// 判定指定槽位，结果交给 SignalCheck_addTable 输出表格
/// <Internal>
void ChkReportAt(int idx)
{
  long num;
  int ok;
  char CondHear[50];
  char CondValue[60];
  char ResultCell[100];
  char Result[10];

  if (idx < 0 || idx >= mChkCount) return;

  if (mChkIds[idx] == 0)
    num = 0;
  else
    num = ChkQuery_NumEvents(mChkIds[idx]);

  if (mChkConds[idx] == 2)
  {
    snprintf(CondHear, elcount(CondHear), "大于阈值");
    snprintf(CondValue, elcount(CondValue), "> %g", mChkLows[idx]);
  }
  else if (mChkConds[idx] == 3)
  {
    snprintf(CondHear, elcount(CondHear), "小于阈值");
    snprintf(CondValue, elcount(CondValue), "< %g", mChkHighs[idx]);
  }
  else if (mChkConds[idx] == 1)
  {
    snprintf(CondHear, elcount(CondHear), "区间外");
    snprintf(CondValue, elcount(CondValue), "[%g,%g]", mChkLows[idx], mChkHighs[idx]);
  }
  else if (mChkConds[idx] == 4)
  {
    snprintf(CondHear, elcount(CondHear), "维持不变");
    snprintf(CondValue, elcount(CondValue), "值不允许变化");
  }
  else if (mChkConds[idx] == 5)
  {
    snprintf(CondHear, elcount(CondHear), "不等于期望值");
    snprintf(CondValue, elcount(CondValue), "!= %g", mChkLows[idx]);
  }
  else if (mChkConds[idx] == 6)
  {
    snprintf(CondHear, elcount(CondHear), "等于期望值");
    snprintf(CondValue, elcount(CondValue), "== %g", mChkLows[idx]);
  }
  else
  {
    snprintf(CondHear, elcount(CondHear), "区间内");
    snprintf(CondValue, elcount(CondValue), "[%g,%g]", mChkLows[idx], mChkHighs[idx]);
  }

  // 区间外以“出现违规事件”为期望，其余以“无违规事件”为期望
  if (mChkExpects[idx] == 1)
    ok = (num > 0);
  else
    ok = (num == 0);

  if (ok == 1)
    snprintf(Result, elcount(Result), "pass");
  else
    snprintf(Result, elcount(Result), "fail");

  // 直白结论：始终满足 / 有几次不满足
  if (mChkConds[idx] == 2)
  {
    if (ok == 1) snprintf(ResultCell, elcount(ResultCell), "始终大于 %g", mChkLows[idx]);
    else         snprintf(ResultCell, elcount(ResultCell), "%d 次未大于 %g", num, mChkLows[idx]);
  }
  else if (mChkConds[idx] == 3)
  {
    if (ok == 1) snprintf(ResultCell, elcount(ResultCell), "始终小于 %g", mChkHighs[idx]);
    else         snprintf(ResultCell, elcount(ResultCell), "%d 次未小于 %g", num, mChkHighs[idx]);
  }
  else if (mChkConds[idx] == 1)
  {
    if (ok == 1) snprintf(ResultCell, elcount(ResultCell), "%d 次超出区间", num);
    else         snprintf(ResultCell, elcount(ResultCell), "始终未超出区间");
  }
  else if (mChkConds[idx] == 4)
  {
    if (ok == 1) snprintf(ResultCell, elcount(ResultCell), "值始终未变化");
    else         snprintf(ResultCell, elcount(ResultCell), "%d 次检测到值变化", num);
  }
  else if (mChkConds[idx] == 5)
  {
    if (ok == 1) snprintf(ResultCell, elcount(ResultCell), "%d 次不等于 %g", num, mChkLows[idx]);
    else         snprintf(ResultCell, elcount(ResultCell), "始终等于 %g", mChkLows[idx]);
  }
  else if (mChkConds[idx] == 6)
  {
    if (ok == 1) snprintf(ResultCell, elcount(ResultCell), "始终等于 %g", mChkLows[idx]);
    else         snprintf(ResultCell, elcount(ResultCell), "%d 次不等于 %g", num, mChkLows[idx]);
  }
  else
  {
    if (ok == 1) snprintf(ResultCell, elcount(ResultCell), "始终在 [%g,%g] 内", mChkLows[idx], mChkHighs[idx]);
    else         snprintf(ResultCell, elcount(ResultCell), "%d 次超出 [%g,%g]", num, mChkLows[idx], mChkHighs[idx]);
  }

  SignalCheck_addTable(mChkNames[idx], CondHear, CondValue, ResultCell, Result);
}

/// <ChkAssert>
// 释放函数：停止检测 -> 判定 -> 销毁。判定并释放**当前所有**在跑的检测（含并行检测）
void ResetChk()
{
  int i;
  cancelTimer(timer_ChkDestroy);

  for (i = 0; i < mChkCount; i++)
  {
    if (mChkIds[i] != 0)
      ChkControl_Stop(mChkIds[i]);
    ChkReportAt(i);
    if (mChkIds[i] != 0)
      ChkControl_Destroy(mChkIds[i]);
  }
  mChkCount = 0;
}

/// <ChkAssert>
// 按对象名释放：只判定并销毁该对象的检测（并行检测时用于单独收尾）
// Name 为信号名，或系统变量的 "namespace::name"
void ResetChk(char Name[])
{
  int i;
  int len;

  len = strlen(Name);
  if (len <= 0) return;

  for (i = 0; i < mChkCount; i++)
  {
    if (strlen(mChkNames[i]) != len) continue;
    if (strncmp(mChkNames[i], Name, len) != 0) continue;

    if (mChkIds[i] != 0)
      ChkControl_Stop(mChkIds[i]);
    ChkReportAt(i);
    if (mChkIds[i] != 0)
      ChkControl_Destroy(mChkIds[i]);
    ChkSlotRemove(i);
    return;
  }
}

// 定时释放：到期判定并销毁当前全部检测（并行检测共用同一个定时器，
// 多个检测要用不同窗口时，请用不带 Timeout 的重载 + 显式 ResetChk(Name)）
on timer timer_ChkDestroy
{
  ResetChk();
}

