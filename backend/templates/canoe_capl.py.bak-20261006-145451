  }

  if (@this)
    snprintf(gCmdK15Output, 100, "%s", OUTPUT_ON_CMD);
  else
    snprintf(gCmdK15Output, 100, "%s", OUTPUT_OFF_CMD);
  snprintf(gCmdK15Volt, 100, "%s%f", VOLT, @sysvar::Prog_power::K15Volt);
  snprintf(gCmdK15Curr, 100, "%s%f", CURR, @sysvar::Prog_power::K15Curr);
  StartK15Sequence(1);

  cancelTimer(tK15ReadCurr);
  if (@this && @Prog_power::K15led == 1)
    setTimerCyclic(tK15ReadCurr, 200);
  else
    setTimer(tK15ReadCurr, 1000);
