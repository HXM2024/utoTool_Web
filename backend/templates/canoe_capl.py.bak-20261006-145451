int ContainsStr(char s[], char sub[])
{
  int i, j, ls, lsub;
  ls   = strlen(s);
  lsub = strlen(sub);
  if (lsub == 0) return 0;
  if (lsub > ls) return 0;
  for (i = 0; i <= ls - lsub; i++)
  {
    j = 0;
    while (j < lsub && s[i + j] == sub[j]) j++;
    if (j == lsub) return 1;
  }
  return 0;
}

void AppendAscii(char dst[], int dstSize, byte src[], dword len)
{
  int i, n;
  n = strlen(dst);
  for (i = 0; i < len; i++)
  {
    if (src[i] >= 0x20 && src[i] <= 0x7E)
    {
      if (n < dstSize - 1)
      {
        dst[n]     = (char)src[i];
        dst[n + 1] = 0;
        n++;
      }
    }
  }
}

int IsK30Port(long port)
{
  long k30;
  k30 = sysGetVariableInt(sysvar::Prog_power::K30Port);
  if (port <= 0) return 0;
  if (port == k30) return 1;
  return 0;
}

int IsK15Port(long port)
{
  long k15;
  k15 = sysGetVariableInt(sysvar::Prog_power::K15Port);
  if (port <= 0) return 0;
  if (port == k15) return 1;
  return 0;
}

void PrintStatus()
{
  long k30, k15;
  k30 = sysGetVariableInt(sysvar::Prog_power::K30Port);
  k15 = sysGetVariableInt(sysvar::Prog_power::K15Port);
