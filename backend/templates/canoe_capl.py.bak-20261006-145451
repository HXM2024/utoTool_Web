    def _calc_occupy_bits(self, msg) -> list:
        """计算报文中未被信号占用的空白位（位级）

        参考 Creat CANoe.py #6311-6317:
        occupybit = set(range(msg.length*8)) - 所有信号占用的位
        返回排序后的空白位列表。
        """
        from backend.core.canoe_config.byte_order import calculate_byte_order
        # 收集所有信号占用的位
        occupied_bits = set()
        for sig in msg.signals:
            try:
                bo_str = self._get_byte_order_str(sig)
                result = calculate_byte_order(sig.start, sig.length, bo_str)
                occupied_bits = occupied_bits.union(result['bit_list'])
            except Exception:
                pass

        # 空白位 = 全部位 - 已占用位
        all_bits = set(range(msg.length * 8))
        occupy_bits = sorted(all_bits - occupied_bits)
        return occupy_bits

    def generate_node_simulation(self, messages, db_name: str = "") -> str:
        """生成节点仿真代码（参考 Creat CANoe.py #6874-6926）

        Args:
            messages: 同一节点的所有报文列表
            db_name: DBC名称

        Returns:
            CAPL代码
        """
        from backend.core.canoe_config.byte_order import get_byte_range

        sigstart = ''
        sigenv = ''
        counter_data = ''
        crc_data = ''
        all_occupy_bits = []

        for msg in messages:
            msg_id_hex = f"{msg.frame_id:X}"
            msg_name = msg.name

            # 计算该报文的空白位
            msg_occupy_bits = self._calc_occupy_bits(msg)
            all_occupy_bits.extend(msg_occupy_bits)

            for sig in msg.signals:
                sig_func_type = self._get_sig_func_type(sig)

                if 'CRC' in sig_func_type and sig_func_type != 'NoFunction':
                    sortedlist = get_byte_range(sig.start, sig.length, self._get_byte_order_str(sig))
                    crc_tbyte = ''
                    for index, i in enumerate(sortedlist):
                        if len(sortedlist) > 1:
                            if 'Motorola' in self._get_byte_order_str(sig):
                                bit_shift = (len(sortedlist) - index - 1) * 8
                            else:
                                bit_shift = index * 8
                            crc_tbyte += f'          data[{i}]=(CRC >> {bit_shift}) & 0xFF;\n'
                        else:
                            crc_tbyte += f'          data[{i}]=(CRC) & 0xFF;\n'

                    # occupySwitch: 仅当存在空白位时生成
                    occupy_switch = ''
                    if msg_occupy_bits:
                        occupy_switch = f'''for(da_i=0;da_i<elcount(occupy_bit);da_i++)
        {{
            Switch(@EV_{sig.name})
            {{
              case 0:data[occupy_bit[da_i]/8] &= ~(1<<occupy_bit[da_i]%8);break;
              case 1:data[occupy_bit[da_i]/8] |= (1<<occupy_bit[da_i]%8);break;
              default:break;
            }}
        }}
'''

                    crc_code = self._get_CRC_Code(sig_func_type, sortedlist, sig.name, msg.length)
                    crc_data += f'''
    /**********CRC**********/
    {{
        Word da_i;
        Word CRC;
        {occupy_switch}Switch(@EV_{sig.name})
        {{
          case 2:
          CRC=0;
{crc_tbyte}
          break;
          default:
{crc_code}
{crc_tbyte}
          break;
        }}
    }}
'''
                elif 'Counter' in sig_func_type:
                    maxvalue = sig.maximum if sig.maximum is not None else 0
                    counter_data += f'''
    /**********Counter**********/
    {{
        word i;
        i++;
        i%={int(maxvalue)}+1;
        switch(@EV_{sig.name})
        {{
            case 0:
            ${sig.name}=i;break;
            case 1: i=1;
            ${sig.name}=0;break;
        }}
    }}
'''
                else:
                    sigstart += f' @EV_{sig.name}=${sig.name};\n'
                    sigenv += f'''on envVar EV_{sig.name}
{{
  ${sig.name}=@EV_{sig.name};
}}
'''

        # variables: 有 occupy_bit 时定义，否则为空
        occupy_str = ''
        if all_occupy_bits:
            occupy_str = f'word occupy_bit[{len(all_occupy_bits)}]={{{",".join(str(b) for b in all_occupy_bits)}}};'

        # on start: 所有报文的 Cycle 和 DLC 初始化
        onstart_block = ''
        for msg in messages:
            msg_id_hex = f"{msg.frame_id:X}"
            msg_name = msg.name
            onstart_block += f' @Cycle_{msg_id_hex}={msg_name}.GenMsgCycleTime;\n'
            onstart_block += f' @DLC_{msg_id_hex}={msg_name}.dlc;\n'
        onstart_block += sigstart

        # Switch / DLC / Cycle 事件处理（每个报文一组）
        envvar_block = ''
        for msg in messages:
            msg_id_hex = f"{msg.frame_id:X}"
            msg_name = msg.name
            envvar_block += f'''
on envVar Switch_{msg_id_hex}
{{
  Switch(@Switch_{msg_id_hex})
  {{
    case 0:ILNodeControlSimulationOff("Node_{msg_id_hex}");break;
    case 1:ILNodeControlSimulationOn("Node_{msg_id_hex}");break;
  }}
}}
on envVar DLC_{msg_id_hex}
{{
  ILFaultInjectionSetMsgdlc({msg_name},@DLC_{msg_id_hex});
}}
on envVar Cycle_{msg_id_hex}
{{
 ILFaultInjectionSetMsgCycleTime({msg_name},@Cycle_{msg_id_hex});
}}
'''

        return f'''/*@!Encoding:936*/
includes
{{
  #include "TESTDLL.cin"
}}

variables
{{
  {occupy_str}
}}
on start
{{
{onstart_block}}}
dword applILTxPending (long aId, dword aDlc, byte data[])
{{
{counter_data}
{crc_data}
  return 1;
}}
{sigenv}
{envvar_block}
on busOff
{{
  resetCanEx(this.can);
}}'''

    def generate_eps_check(self, messages, unused_byte: int = 0,
                           ready_signal: str = "", ready_on: str = "", ready_off: str = "",
                           car_spd_signal: str = "") -> str:
        """生成 EPS 信号检查代码（EPSCheck.can，参考 Creat CANoe.py）

        Args:
            messages: EPS节点的所有报文列表
            unused_byte: 空白位的期望值（0 或 1），由前端滑块传入
            ready_signal: Ready 信号名（不用于 EPSCheck.can，传递给 Power_up.can）
            ready_on: ReadyOn 信号值（不用于 EPSCheck.can，传递给 Power_up.can）
            ready_off: ReadyOff 信号值（不用于 EPSCheck.can，传递给 Power_up.can）
            car_spd_signal: 车速信号名（不用于 EPSCheck.can，传递给 Power_up.can）

        Returns:
            CAPL代码
        """
        # 限制 unused_byte 仅取值 0 或 1
        unused_byte = 1 if int(unused_byte) else 0
        from backend.core.canoe_config.byte_order import get_byte_range

        msgcan = ''

        for msg in messages:
            msg_id = msg.frame_id
            msg_id_hex = f"{msg_id:X}"
            msg_name = msg.name
            sigcan = ''

            # 计算该报文的空白位（未被信号占用的位）
            occupy_bits = self._calc_occupy_bits(msg)

            for sig in msg.signals:
                sig_name = sig.name
                sig_func_type = self._get_sig_func_type(sig)

                if 'CRC' in sig_func_type and sig_func_type != 'NoFunction':
                    sortedlist = get_byte_range(sig.start, sig.length, self._get_byte_order_str(sig))
                    crc_tbyte = ''
                    for index, i in enumerate(sortedlist):
                        if len(sortedlist) > 1:
                            if 'Motorola' in self._get_byte_order_str(sig):
                                bit_shift = (len(sortedlist) - index - 1) * 8
                            else:
                                bit_shift = index * 8
                            crc_tbyte += f'''
        if(data[{i}] != ((CRC >> {bit_shift}) & 0xFF))
        {{
          @EpsSignalWar1 = 1;
          writeLineEx(-3, 0, "外发报文0x%03X的CRC校验错误,预期为:0x%02X,实际为:0x%02X", this.id, (CRC >> {bit_shift}) & 0xFF, data[{i}]);
        }}\n'''
                        else:
                            crc_tbyte += f'''
        if(data[{i}] != ((CRC) & 0xFF))
        {{
          @EpsSignalWar1 = 1;
          writeLineEx(-3, 0, "外发报文0x%03X的CRC校验错误,预期为:0x%02X,实际为:0x%02X", this.id, (CRC) & 0xFF, data[{i}]);
        }}\n'''

                    crc_code = self._get_CRC_Code(sig_func_type, sortedlist, sig_name, msg.length)
                    sigcan += f'''
    /**********CRC {sig_name}**********/
    if(@EpsSignalCheck)
    {{
        byte data[{msg.length}];
        word CRC;
        int i;
        for(i = 0; i < {msg.length}; i++)
        {{
          data[i] = this.byte(i);
        }}
        {crc_code}
        {crc_tbyte}
    }}
'''
                elif 'Counter' in sig_func_type:
                    maxvalue = sig.maximum if sig.maximum is not None else 0
                    sigcan += f'''
    /**********Counter {sig_name}**********/
    if(@EpsSignalCheck)
    {{
      max = ({sig_name}.maximum);
      time = timeNow() / 100.0 - time;
      target++;
      target %= (max+1);
      counter = getSignal({sig_name});
      if(time < this.GenMsgCycleTime * 1.5)
      {{
        if(counter == target)
        {{
        // 校验正确
        }} else {{
        @EpsSignalWar1 = 1;
        writeex(-3, 0, "外发报文0x%03X的counter校验错误,预期为:%d,实际为:%d", this.id, target, counter);
        }}
      }}
      target = counter;
      time = timeNow() / 100.0;
    }}
'''
                else:
                    sig_min = sig.minimum if sig.minimum is not None else 0
                    sig_max = sig.maximum if sig.maximum is not None else 0
                    sigcan += f'''
  {{
      if((${msg_name}::{sig_name} < {sig_min} || ${msg_name}::{sig_name} > {sig_max}) && @EpsSignalCheck)
          {{
            @EpsSignalWar=1;
            writeex(-3,0,"{msg_name}::{sig_name} out of range    %f",${msg_name}::{sig_name});
            writeex(1,3,"\\n{msg_name}::{sig_name} out of range    %f",${msg_name}::{sig_name});
          }}
  }}
'''

            # 生成空白Bit检测代码（参考 Creat CANoe.py #7021-7032）
            # 根据 unused_byte（前端滑块传入的期望值）判断空白位是否被占用
            occupy_bit_check = ''
            if len(occupy_bits) > 0:
                occupy_bit_list = ','.join(str(bit) for bit in occupy_bits)
                if unused_byte == 0:
                    # 期望空白位为 0，若该位为 1 则视为被占用
                    bit_check_expr = f'this.byte((int)(bit[i]/8)) & (0x1 << (bit[i] % 8))'
                else:
                    # 期望空白位为 1，若该位为 0 则视为被占用
                    bit_check_expr = f'!(this.byte((int)(bit[i]/8)) & (0x1 << (bit[i] % 8)))'
                occupy_bit_check = f'''  {{
    word bit[{len(occupy_bits)}] = {{{occupy_bit_list}}};
    int i;
    for(i = 0; i < elcount(bit); i++)
    {{
