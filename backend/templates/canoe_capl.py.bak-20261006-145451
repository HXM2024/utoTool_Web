    def _get_sig_func_type(self, sig):
        """获取信号的 GenSigFuncType 属性值"""
        GENSIGFUNCTYPE_CHOICES = [
            'NoFunction', 'Counter', 'CRC_Hig_xor_low', 'CRC_Xor_FF', 'CRC_CheckSum',
            'CRC8_1D_All', 'CRC8_2F_All', 'CRC8_1D_Cutoff', 'CRC8_2F_Cutoff',
            'CRC16_All', 'CRC16_Cutoff'
        ]
        try:
            attr = sig.dbc.attributes.get('GenSigFuncType')
            if attr:
                val = attr.value
                if isinstance(val, int):
                    if 0 <= val < len(GENSIGFUNCTYPE_CHOICES):
                        return GENSIGFUNCTYPE_CHOICES[val]
                val_str = str(val)
                if val_str in GENSIGFUNCTYPE_CHOICES:
                    return val_str
        except Exception:
            pass
        return 'NoFunction'

    def _get_byte_order_str(self, sig):
        """将 cantools 信号字节序转换为 calculate_byte_order 需要的格式"""
        if sig.byte_order == 'big_endian':
            return 'Motorola MSB'
        return 'Intel LSB'

    def _get_CRC_Code(self, CRCtype, sortedlist, sig_name, dlc):
        """生成 CRC 计算代码（参考 Creat CANoe.py）"""
        CRCCode = ''
        if CRCtype == 'CRC8':
            CRCCode = f'''CRC={CRCtype}(data,bit,{dlc})'''
        elif CRCtype == 'CRC16':
            CRCCode = f'''CRC={CRCtype}(data,bit,{dlc})'''
        elif CRCtype == 'CRC_Hig_xor_low':
            CRCCode = f'''CRC={CRCtype}(data,bit,{dlc})'''#f'''CRC={CRCtype}(data,bit,{dlc},{sig_name}.bitstart)'''
        elif CRCtype == 'CRC_Xor_FF':
            CRCCode = f'''CRC={CRCtype}(data,bit,{dlc})'''
        elif CRCtype == 'CRC_CheckSum':
            CRCCode = f'''CRC={CRCtype}(data,bit,{dlc})'''
        else:
            # 其他 CRC 类型（CRC8_1D_All, CRC8_2F_All, CRC8_1D_Cutoff, CRC8_2F_Cutoff, CRC16_All, CRC16_Cutoff）
            CRCCode = f'''CRC={CRCtype}(data,bit,{dlc})'''

        bit_str = ','.join(str(b) for b in sortedlist)
        CRCtxt = f'''{{
          byte bit[{len(sortedlist)}] = {{{bit_str}}};
          {CRCCode};
        }}
'''
        return CRCtxt

    def generate_test_dll(self, crc_algorithms: list = None) -> str:
        """生成 TESTDLL.cin 内容。

        Args:
            crc_algorithms: CRC 算法列表，每项为 {"name": "...", "code": "..."}。
                - None: 使用内置 TEST_DLL（向后兼容）
                - []: 仅生成骨架（头文件 + 工具函数），不含 CRC 算法
                - 非空列表: 骨架 + 用户定义的 CRC 算法代码

        Returns:
            TESTDLL.cin 文件内容
        """
        if crc_algorithms is None:
            # 向后兼容：未传参时使用内置完整 TEST_DLL
            return self.TEST_DLL

        # 动态模式：骨架 + 用户 CRC 算法代码
        parts = [self.TEST_DLL_SKELETON.rstrip()]
        for algo in crc_algorithms:
            code = (algo.get("code") or "").strip()
            if code:
                parts.append(code)
        return "\n\n".join(parts) + "\n"

