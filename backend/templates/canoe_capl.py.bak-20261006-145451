on sysvar Prog_power::K30
{
  if (!gK30Opened)
  {
    writeEx(0, 2, "K30 端口未验证通过，拒绝下发。");
    return;
  }

  if (@this)
    snprintf(gCmdK30Output, 100, "%s", OUTPUT_ON_CMD);
  else
    snprintf(gCmdK30Output, 100, "%s", OUTPUT_OFF_CMD);
  snprintf(gCmdK30Volt, 100, "%s%f", VOLT, @sysvar::Prog_power::K30Volt);
  snprintf(gCmdK30Curr, 100, "%s%f", CURR, @sysvar::Prog_power::K30Curr);
  StartK30Sequence(1);

  cancelTimer(tK30ReadCurr);
  if (@this && @Prog_power::K30led == 1)
    setTimerCyclic(tK30ReadCurr, 200);
  else
    setTimer(tK30ReadCurr, 1000);
}

on sysvar Prog_power::K15
{
  if (!gK15Opened)
  {
    writeEx(0, 2, "K15 端口未验证通过，拒绝下发。");
