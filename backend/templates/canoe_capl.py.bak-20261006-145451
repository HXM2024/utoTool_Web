// ==================================================================
// 发送命令
// ==================================================================
int SendCommand(long port, char cmd[])
{
  byte buffer[100];
  long len;
  int  i;

  if (port <= 0) return 0;
  if (IsK30Port(port) && gK30Sending) return 0;
  if (IsK15Port(port) && gK15Sending) return 0;

  len = strlen(cmd);
  if (len <= 0) return 0;
  if (len + 2 > 100) return 0;

  for (i = 0; i < len; i++)
    buffer[i] = (byte)cmd[i];
  buffer[len]     = 0x0D;
  buffer[len + 1] = 0x0A;

  if (Rs232Send(port, buffer, len + 2) == 0)
  {
    writeEx(0, 3, "端口 %d 发送失败: %s", port, cmd);
    return 0;
  }

  if (IsK30Port(port)) gK30Sending = 1;
  else if (IsK15Port(port)) gK15Sending = 1;
  return 1;
}

void StartK30Sequence(int type)
{
  if (gK30Sending)
  {
    cancelTimer(tK30Cmd);
    setTimer(tK30Cmd, 50);
    return;
  }
  gK30SendType = type;
  gK30SendStep = 0;
  cancelTimer(tK30Cmd);
  setTimer(tK30Cmd, 10);
}

void StartK15Sequence(int type)
{
  if (gK15Sending)
  {
    cancelTimer(tK15Cmd);
    setTimer(tK15Cmd, 50);
    return;
  }
  gK15SendType = type;
  gK15SendStep = 0;
  cancelTimer(tK15Cmd);
  setTimer(tK15Cmd, 10);
}

// ==================================================================
// 电流响应解析
// ==================================================================
int FeedReply(char buff[], byte data[], dword len)
{
  int  i, n;
  byte b;

  for (i = 0; i < len; i++)
  {
    b = data[i];
    if (b == 0x0D || b == 0x0A)
    {
      if (strlen(buff) > 0)
      {
        gParsedValue = atodbl(buff);
        buff[0] = 0;
        return 1;
      }
      buff[0] = 0;
    }
    else if (b >= 0x20 && b <= 0x7E)
    {
      n = strlen(buff);
      if (n < 15)
      {
        buff[n]     = (char)b;
        buff[n + 1] = 0;
      }
    }
  }
  return 0;
}

