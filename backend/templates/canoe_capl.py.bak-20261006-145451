    def generate_power_up(self, ready_signal: str = "", ready_on: str = "", ready_off: str = "",
                           can_channel: int = 1, relay_module: int = 0,
                           dtc_list: list = None) -> str:
        """生成 Power_up.can（参考 Creat CANoe.py PowerTest 模板）

        Args:
            ready_signal: Ready 信号名
            ready_on: ReadyOn 信号值
            ready_off: ReadyOff 信号值
            can_channel: CAN 通道（1 或 2，写入 CAPL channel 变量）
            relay_module: 继电器模块（0=老 1=单刀 2=双刀，写入 CAPL Relay 变量 +1）
            dtc_list: DTC 列表，动态生成 WhiteDTC 数组
        """
        ready_code = f"${ready_signal}={ready_on};" if ready_signal and ready_on else ""
        ready_off_code = f"${ready_signal}={ready_off};" if ready_signal and ready_off else ""

        # WhiteDTC 数组：动态长度 + 动态赋值
        dtc_items = list(dtc_list or [])
        dtc_count = max(len(dtc_items), 1)  # 至少保留 1 个槽位避免空数组
        # 数组声明
        dtc_declare = f"  dword WhiteDTC[{dtc_count}];"
        # 赋值代码
        if dtc_items:
            dtc_assign_lines = []
            for i, d in enumerate(dtc_items):
                # 规范化 DTC 值：确保 0x 前缀
                dv = str(d).strip()
                if not dv.lower().startswith('0x'):
                    # 纯数字时按十六进制处理
                    try:
                        int(dv, 16)
                        dv = '0x' + dv
                    except ValueError:
                        pass
                dtc_assign_lines.append(f"  WhiteDTC[{i}]={dv};")
            dtc_assign = "\n".join(dtc_assign_lines)
        else:
            # 默认占位
            dtc_assign = "  WhiteDTC[0]=0x112233;"

        # 模板含大量字面量花括号（CAPL 函数体、{dlc=8} 等），禁止使用 str.format
        relay_value = relay_module + 1  # 0=老→1, 1=单刀→2, 2=双刀→3
        tpl = self.POWER_UP_CAN
        tpl = tpl.replace("{{", "\x00").replace("}}", "\x01")
        tpl = tpl.replace("{ready_code}", ready_code)
        tpl = tpl.replace("{ready_off_code}", ready_off_code)
        tpl = tpl.replace("{channel_value}", str(can_channel))
        tpl = tpl.replace("{relay_value}", str(relay_value))
        tpl = tpl.replace("{dtc_declare}", dtc_declare)
        tpl = tpl.replace("{dtc_assign}", dtc_assign)
        return tpl.replace("\x00", "{").replace("\x01", "}")

