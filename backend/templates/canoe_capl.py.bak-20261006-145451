on timer tK30ReadCurr
{
  long port;
  port = sysGetVariableInt(sysvar::Prog_power::K30Port);
  if (!gK30Sending && SendCommand(port, MEAS_CURR))
  {
    gK30Reading    = 1;
    K30Currbuff[0] = 0;
  }
}

on timer tK15ReadCurr
{
  long port;
  port = sysGetVariableInt(sysvar::Prog_power::K15Port);
  if (!gK15Sending && SendCommand(port, MEAS_CURR))
  {
    gK15Reading    = 1;
    K15Currbuff[0] = 0;
  }
}

// ==================================================================
// 命令序列定时器
// ==================================================================
on timer tK30Cmd
{
  long port;
  int  sent;
  port = sysGetVariableInt(sysvar::Prog_power::K30Port);
  sent = 0;

  if (gK30SendType == 0)
  {
    switch (gK30SendStep)
    {
      case 0: sent = SendCommand(port, IDN);  break;
      case 1: sent = SendCommand(port, SYST); break;
      case 2: sent = SendCommand(port, CLS);  break;
      case 3: sent = SendCommand(port, RST);  break;
      default:
        cancelTimer(tK30Cmd);
        gK30SendStep = 0;
        return;
    }
  }
  else
  {
    switch (gK30SendStep)
    {
      case 0: sent = SendCommand(port, SYST);          break;
      case 1: sent = SendCommand(port, gCmdK30Volt);   break;
      case 2: sent = SendCommand(port, gCmdK30Curr);   break;
      case 3: sent = SendCommand(port, gCmdK30Output); break;
      default:
        cancelTimer(tK30Cmd);
        gK30SendStep = 0;
        return;
    }
  }
  if (sent) gK30SendStep++;
  setTimer(tK30Cmd, 100);
}

on timer tK15Cmd
{
  long port;
  int  sent;
  port = sysGetVariableInt(sysvar::Prog_power::K15Port);
  sent = 0;

  if (gK15SendType == 0)
  {
    switch (gK15SendStep)
    {
      case 0: sent = SendCommand(port, IDN);  break;
      case 1: sent = SendCommand(port, SYST); break;
      case 2: sent = SendCommand(port, CLS);  break;
      case 3: sent = SendCommand(port, RST);  break;
      default:
        cancelTimer(tK15Cmd);
        gK15SendStep = 0;
        return;
    }
  }
  else
  {
    switch (gK15SendStep)
    {
      case 0: sent = SendCommand(port, SYST);          break;
      case 1: sent = SendCommand(port, gCmdK15Volt);   break;
      case 2: sent = SendCommand(port, gCmdK15Curr);   break;
      case 3: sent = SendCommand(port, gCmdK15Output); break;
      default:
        cancelTimer(tK15Cmd);
        gK15SendStep = 0;
        return;
    }
  }
  if (sent) gK15SendStep++;
  setTimer(tK15Cmd, 100);
}

// ==================================================================
