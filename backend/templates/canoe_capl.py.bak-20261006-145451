// ==================================================================
// 手动发送
// ==================================================================
on sysvar sysvar::Prog_power::K30send
{
  long aDLC;
  long port;
  byte buffer[100];
  char buff[100];
  int  i;

  if (@this == 0) return;
  port = sysGetVariableInt(sysvar::Prog_power::K30Port);
  if (port <= 0 || !gK30Opened || gK30Sending) return;

  sysGetVariableData(sysvar::Prog_power::SendData, buffer, aDLC);
  if (aDLC <= 0) return;
  if (aDLC + 1 > 100) aDLC = 99;
  buffer[aDLC] = 0x0A;

  for (i = 0; i < aDLC; i++)
    buff[i] = (buffer[i] >= 0x20 && buffer[i] <= 0x7E) ? buffer[i] : '.';
  buff[aDLC] = 0;

  if (Rs232Send(port, buffer, aDLC + 1) == 0)
    writeEx(0, 3, "端口 %d 发送自定义数据失败. %s", port, buff);
  else
    writeEx(-3, 1, "端口 %d 发送自定义数据. %s", port, buff);
}

on sysvar Prog_power::ClearDate
{
  byte empty[1];
  sysSetVariableData(sysvar::Prog_power::SendData, empty, 0);
}

// ==================================================================
// 串口回调
// ==================================================================
RS232OnReceive( dword port, byte buffer[], dword number )
{
  if (gScanState == 1 && port == gScanPort)
  {
    AppendAscii(gScanBuf, 128, buffer, number);
    return;
  }
  if (gVerifyingChannel != 0 && port == gVerifyingPort)
  {
    AppendAscii(gVerifyBuf, 128, buffer, number);
    return;
  }

  if (IsK30Port(port))
  {
    if (gK30Reading && FeedReply(K30Currbuff, buffer, number))
    {
      @Prog_power::K30CurrAct = gParsedValue;
      gK30Reading = 0;
    }
  }
  else if (IsK15Port(port))
  {
    if (gK15Reading && FeedReply(K15Currbuff, buffer, number))
    {
      @Prog_power::K15CurrAct = gParsedValue;
      gK15Reading = 0;
    }
  }
}

RS232OnSend( dword port, byte buffer[], dword number )
{
  if (IsK30Port(port))      gK30Sending = 0;
  else if (IsK15Port(port)) gK15Sending = 0;
}

RS232OnError( dword port, dword errorFlags )
{
  if (IsK30Port(port))      gK30Sending = 0;
  else if (IsK15Port(port)) gK15Sending = 0;
  writeEx(0, 3, "端口 %d 错误: 0x%X", port, errorFlags);
}
