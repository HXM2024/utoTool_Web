void StartScan()
{
  writeEx(0, 1, "===== 开始扫描 COM1..COM16 (特征='%s') =====", gExpectedIdn);
  gScanning  = 1;
  gFoundK30  = 0;
  gFoundK15  = 0;
  gScanPort  = 1;
  gScanState = 0;
  ScanNextPort();
}

void ScanNextPort()
{
  byte buf[16];
  int  i, len;

  // 结束条件：超过 COM16 或已找到两台
  if (gScanPort > 16 || (gFoundK30 > 0 && gFoundK15 > 0))
  {
    writeEx(0, 1, "===== 扫描结束: K30=COM%d K15=COM%d =====",
            gFoundK30, gFoundK15);
    gScanning  = 0;
    gScanState = 0;
    gScanTried = 1;

    if (gFoundK30 > 0)
      sysSetVariableInt(sysvar::Prog_power::K30Port, gFoundK30);
    if (gFoundK15 > 0)
      sysSetVariableInt(sysvar::Prog_power::K15Port, gFoundK15);

    if (gFoundK30 > 0 || gFoundK15 > 0)
    {
      cancelTimer(tAutoOpen);
      setTimer(tAutoOpen, 300);
    }
    else
    {
      writeEx(0, 3,
        "未找到 ITECH 电源！请：1) 检查设备连线与波特率；"
        " 2) 在 System Variables 里手动设置 K30Port/K15Port；"
        " 3) 或按 's' 键重新扫描。");
    }
    return;
  }

  Rs232Close(gScanPort);
  if (Rs232Open(gScanPort) != 1)
  {
    gScanPort++;
    setTimer(tScan, 20);
    return;
  }

  if (Rs232Configure(gScanPort, 9600, 8, 1, 0) != 1
      || Rs232SetHandshake(gScanPort, 0, 0, 0, 0, 0) != 1
      || Rs232Receive(gScanPort, gScanRxBuf, 100) != 1)
  {
    writeEx(0, 2, "COM%d 配置失败，跳过。", gScanPort);
    Rs232Close(gScanPort);
    gScanPort++;
    setTimer(tScan, 20);
    return;
  }

  gScanBuf[0] = 0;
  gScanState = 1;

  len = strlen(IDN);
  for (i = 0; i < len; i++) buf[i] = (byte)IDN[i];
  buf[len]     = 0x0D;
  buf[len + 1] = 0x0A;
  Rs232Send(gScanPort, buf, len + 2);

  writeEx(0, 1, "探测 COM%d ...", gScanPort);
  setTimer(tScan, 300);
}

on timer tScan
{
  if (gScanState == 1)
  {
    if (strlen(gExpectedIdn) == 0 || ContainsStr(gScanBuf, gExpectedIdn))
    {
      if (gFoundK30 == 0)
      {
        gFoundK30 = gScanPort;
        writeEx(0, 1, "★ 找到 K30 电源: COM%d  (IDN='%s')", gScanPort, gScanBuf);
      }
      else if (gFoundK15 == 0)
      {
        gFoundK15 = gScanPort;
        writeEx(0, 1, "★ 找到 K15 电源: COM%d  (IDN='%s')", gScanPort, gScanBuf);
      }
    }
    Rs232Close(gScanPort);
    gScanState = 0;
    gScanPort++;
  }
  ScanNextPort();
}

// ==================================================================
// 打开 + 发 *IDN? + 验证
// ==================================================================
void StartVerify(long port, int channel)
{
  byte buf[16];
  int  i, len;

  if (port <= 0)
  {
    writeEx(0, 2, "StartVerify: 端口号无效 (%d), channel=%d", port, channel);
    if (channel == 1) { gK30Opened = 0; @Prog_power::K30led = 0; }
    else               { gK15Opened = 0; @Prog_power::K15led = 0; }
    return;
  }

  Rs232Close(port);

  if (Rs232Open(port) != 1)
  {
    writeEx(0, 3, "端口 %d 打开失败 (通道 %d).", port, channel);
    if (channel == 1) { gK30Opened = 0; @Prog_power::K30led = 0; }
    else               { gK15Opened = 0; @Prog_power::K15led = 0; }
    return;
  }
  if (Rs232Configure(port, 9600, 8, 1, 0) != 1
      || Rs232SetHandshake(port, 0, 0, 0, 0, 0) != 1
      || Rs232Receive(port, gRxCallbackBuffer, 100) != 1)
  {
    writeEx(0, 3, "端口 %d 配置失败.", port);
    Rs232Close(port);
    if (channel == 1) { gK30Opened = 0; @Prog_power::K30led = 0; }
    else               { gK15Opened = 0; @Prog_power::K15led = 0; }
    return;
  }

  len = strlen(IDN);
  for (i = 0; i < len; i++) buf[i] = (byte)IDN[i];
  buf[len]     = 0x0D;
  buf[len + 1] = 0x0A;
  Rs232Send(port, buf, len + 2);

  gVerifyingPort    = port;
  gVerifyingChannel = channel;
  gVerifyBuf[0]     = 0;

  writeEx(0, 1, "打开端口 %d (通道 %d)，等待 IDN...", port, channel);
  cancelTimer(tVerify);
  setTimer(tVerify, 500);
}

on timer tVerify
{
  long port;
  int  channel;
  int  ok;

  port    = gVerifyingPort;
  channel = gVerifyingChannel;
  ok      = 0;

  if (strlen(gExpectedIdn) == 0 || ContainsStr(gVerifyBuf, gExpectedIdn))
    ok = 1;

  if (channel == 1)
  {
    if (ok)
    {
      gK30Opened = 1;
      @Prog_power::K30led = 1;
      writeEx(0, 1, "K30 端口 %d 验证通过: %s", port, gVerifyBuf);
    }
    else
    {
      gK30Opened = 0;
      @Prog_power::K30led = 0;
      writeEx(0, 3, "K30 端口 %d 不是 ITECH 电源 (IDN='%s')，已关闭。",
              port, gVerifyBuf);
      Rs232Close(port);
    }

    if (sysGetVariableInt(sysvar::Prog_power::K15Port)
        == sysGetVariableInt(sysvar::Prog_power::K30Port))
    {
      gK15Opened = gK30Opened;
      @Prog_power::K15led = @Prog_power::K30led;
      writeEx(0, 1, "K15 与 K30 共用端口 %d，复用结果。", port);
    }
    else
    {
      StartVerify(sysGetVariableInt(sysvar::Prog_power::K15Port), 2);
    }
  }
  else if (channel == 2)
  {
    if (ok)
    {
      gK15Opened = 1;
      @Prog_power::K15led = 1;
      writeEx(0, 1, "K15 端口 %d 验证通过: %s", port, gVerifyBuf);
    }
    else
    {
      gK15Opened = 0;
      @Prog_power::K15led = 0;
      writeEx(0, 3, "K15 端口 %d 不是 ITECH 电源 (IDN='%s')，已关闭。",
              port, gVerifyBuf);
      Rs232Close(port);
    }
  }

  gVerifyingPort    = 0;
  gVerifyingChannel = 0;
}

// ==================================================================
// 自动打开主入口
// ==================================================================
void TryAutoOpen()
{
  long k30, k15;

  if (gScanning)
  {
    writeEx(0, 1, "[自动打开] 扫描中，跳过。");
    return;
  }
  if (gVerifyingChannel != 0)
  {
    writeEx(0, 1, "[自动打开] 验证中，跳过。");
    return;
  }

  k30 = sysGetVariableInt(sysvar::Prog_power::K30Port);
  k15 = sysGetVariableInt(sysvar::Prog_power::K15Port);

  writeEx(0, 1, "[自动打开] K30Port=%d Opened=%d | K15Port=%d Opened=%d",
          k30, gK30Opened, k15, gK15Opened);

  if (k30 <= 0 && k15 <= 0)
  {
    if (!gScanTried)
    {
      writeEx(0, 2, "[自动打开] 端口未配置，启动扫描（仅一次）。");
      StartScan();
    }
    else
    {
      writeEx(0, 2,
        "[自动打开] 端口未配置且已扫描过。请手动设置系统变量或按 's' 键重新扫描。");
    }
    return;
  }

  if (k30 > 0 && !gK30Opened)
  {
    StartVerify(k30, 1);
    return;
  }
  if (k15 > 0 && !gK15Opened)
  {
    StartVerify(k15, 2);
    return;
  }
}

on timer tAutoOpen
{
  TryAutoOpen();
}

