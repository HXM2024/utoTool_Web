<UNSDEF id='_0000000021E5AD50' oid='280A70D8EA434d8f953CE06041D8DCEA' temploid='235F7419D767419e90A69EC1BA238AFA' attrcatref='_0000000021BF3F00' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>Powertrain_CAN.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000000021E5AF40' oid='E549E1F32609413382F682CEE38EC55E' temploid='E70B735A87324ba88DABEB0BFD47FC4F' attrcatref='_0000000021BF3F00' usage='sys' v='0' df='hex'>
