<UNSDEF id='_0000000021E6F9F0' oid='B959DE1AE03C48549528712AE2E435D4' attrcatref='_0000000021BF3F00' usage='admin' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
<QUAL>CAN_FD.Baudrate</QUAL>
</UNSDEF>
<UNSDEF id='_0000000021E6FBE0' oid='D224C0D8004841d1B42DCCC356E3F541' attrcatref='_0000000021BF3F00' usage='admin' v='0' df='hex'>
