<UNSDEF id='_0000000021D7B380' oid='6EB7948A75CD448fB67D7481D723B79C' temploid='A48B0E68BFF3452cBF7B11F5D1B4A83F' attrcatref='_0000000021B45310' usage='sys' v='1792' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Request CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The request CAN identifier for physical requests. The hex value not only describes the identifier but also the priority of the message. The higher the number, the lower the priority.</TUV>
</DESC>
<QUAL>Comfort_CAN.ReqCanId</QUAL>
</UNSDEF>
<UNSDEF id='_0000000021D7B570' oid='87E871E7AAE64184BDC6895DF04A450E' temploid='0A7C8ACF629F4011A70F9CF7032B7E35' attrcatref='_0000000021B45310' usage='sys' v='1536' df='hex'>
<NAME>
<TUV xml:lang='en-US'>Response CAN-ID</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>The response CAN identifier for physical responses.The response for functional requests is sent via the physical path.</TUV>
</DESC>
<QUAL>Comfort_CAN.ResCanId</QUAL>
</UNSDEF>
