</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until next transmission of consecutive frame</TUV>
</DESC>
<QUAL>Powertrain_CAN.TimeCs</QUAL>
</UNSDEF>
<UNSDEF id='_0000000021DB0FA0' oid='DFA0DB5DC6BB4ea5BBF622FF33AEC834' temploid='492676D292244df38F342FEAA5396329' attrcatref='_0000000021B45D60' usage='sys' v='100' df='dec'>
