</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>CAN_FD.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_0000000021DC7760' oid='C70B3919F86949348430834877111C72' attrcatref='_0000000021B45D60' usage='admin' v='100' df='dec'>
