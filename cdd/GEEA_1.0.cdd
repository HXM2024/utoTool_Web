</DESC>
<QUAL>Powertrain_CAN.TimeoutCr</QUAL>
</UNSDEF>
<UNSDEF id='_0000000021DB1190' oid='14C6A98E61564b94BC793CDF2A9ACCDF' temploid='F9FFD1D6C4B74ca18E77F63C4FB48AC1' attrcatref='_0000000021B45310' usage='sys' v='4095' df='dec'>
