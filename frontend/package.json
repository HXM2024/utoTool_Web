{
  "name": "autotool-frontend",
  "version": "1.0.56",
  "description": "#Excel2Case#V1.0.00",
  "author": "AutoTool Team",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"npm run dev\" \"electron .\"",
    "electron:build": "npm run build && electron-builder",
    "electron:prod": "electron ."
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "axios": "^1.6.7",
    "echarts": "^5.5.0",
    "element-plus": "2.14.7",
    "highlight.js": "11.12.0",
    "pinia": "^2.1.7",
    "vue": "3.5.44",
    "vue-echarts": "^6.6.1",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "6.0.10",
    "concurrently": "^8.2.2",
    "electron": "^30.5.1",
    "electron-builder": "^25.1.7",
    "sass": "1.107.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "2.2.12"
  },
  "build": {
    "appId": "com.autotool.excel2case",
    "productName": "#Excel2Case#V1.0.00",
    "executableName": "#Excel2Case#V1.0.00",
    "directories": {
      "output": "release_v2"
    },
    "files": [
      "dist/**/*",
      "electron/main.js",
      "electron/preload.cjs",
      "electron/splash.html",
      "../AT.ico"
    ],
    "extraResources": [
      {
        "from": "electron/resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../AT.ico",
        "to": "AT.ico"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../AT.ico"
    },
    "publish": {
      "provider": "generic",
      "url": "https://127.0.0.1/"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "#Excel2Case#",
      "deleteAppDataOnUninstall": false,
      "displayLanguageSelector": false,
      "language": "2052",
      "installerIcon": "../AT.ico",
      "uninstallerIcon": "../AT.ico",
      "installerHeaderIcon": "../AT.ico"
    }
  }
}
