_Get_ChangAn_FixData()
{
  int i,j,k,n,Count;
  char Temp_Value_1[500];
  char Temp_Value_2[500];
  char Temp_Value_3[20][50];
  char Temp_Value_4[2000];
  int Count_Sig;
  
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
  snprintf(Temp_Value_4,elCount(Temp_Value_4),"%s","");
  getProfileString(ECU_project,"FixDataSave_Traversal","Null",Temp_Value_1, 500, file_name_1);
  
  FixDataSave_Count = 0;
  for(i=0;i<strlen(Temp_Value_1);i++)
  {
    if(Temp_Value_1[i] == 91)
    {
      for(j=i+1;j<strlen(Temp_Value_1);j++)
      {
        if(Temp_Value_1[j] == 44 || Temp_Value_1[j] == 93)
        {
          snprintf(Temp_Value_3[FixDataSave_Count],elCount(Temp_Value_3[FixDataSave_Count]),"%s",Temp_Value_2);
          FixDataSave_Count++;
          snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
          if(Temp_Value_1[j] == 93)
          {
            i = j;break;
          }
        }
        else
          snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s%c",Temp_Value_2,Temp_Value_1[j]);
      }
    }
  }
  for(i=0;i<FixDataSave_Count;i++)
  {
    int Error_Type_Count;
    getProfileString(ECU_project,Temp_Value_3[i],"Null",Temp_Value_4, 2000, file_name_1);
    FixDataSave[i].Error_Type_Count = 0;
    Error_Type_Count = 0;
    for(j=0;j<strlen(Temp_Value_4);j++)
    {
      if(Temp_Value_4[j] == 91)
      {
        for(k=j+1;k<strlen(Temp_Value_4);k++)
        {
          if(Temp_Value_4[k] == 93)
          {
            FixDataSave[i].Node = atol(Temp_Value_2);
            snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
            j = k;
            break;
          }
          else
            snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s%c",Temp_Value_2,Temp_Value_4[k]);
        }
      }
      if(Temp_Value_4[j] == 123)
      {
        Count_Sig = 0;
        for(k=j+1;k<strlen(Temp_Value_4);k++)
        {
          if(Temp_Value_4[k] == 91 && Count_Sig == 0)
          {
            Count = 0;
            for(n=k+1;n<strlen(Temp_Value_4);n++)
            {
              if(Temp_Value_4[n] == 44 || Temp_Value_4[n] == 93)
              {
                if(Count == 0)
                  FixDataSave[i].DTC[Error_Type_Count] = atol(Temp_Value_2);
                else if(Count == 1)
                  snprintf(FixDataSave[i].SigName[Error_Type_Count],elCount(FixDataSave[i].SigName[Error_Type_Count]),"%s",Temp_Value_2);
                else if(Count == 2)
                  FixDataSave[i].Invalid_Value[Error_Type_Count] = atol(Temp_Value_2);
                else if(Count == 3)
                  FixDataSave[i].Normal_Value[Error_Type_Count] = atol(Temp_Value_2);
                else if(Count == 4)
                  FixDataSave[i].Error_FPS[Error_Type_Count] = atol(Temp_Value_2);
                else if(Count == 5)
                  snprintf(FixDataSave[i].Error_Type[Error_Type_Count],elCount(FixDataSave[i].Error_Type[Error_Type_Count]),"%s",Temp_Value_2);
                Count++;
                snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
                if(Temp_Value_4[n] == 93)
                {
                  Count = 0;Count_Sig++;
                  k=n;break;
                }
              }
              else
                snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s%c",Temp_Value_2,Temp_Value_4[n]);
            }
          }
          if(Temp_Value_4[k] == 91 && Count_Sig == 1) //多个信号存储
          {
            FixDataSave[i].SigSaveCount[Error_Type_Count] = 0;
            for(n=k+1;n<strlen(Temp_Value_4);n++)
            {
              if(Temp_Value_4[n] == 44 || Temp_Value_4[n] == 93)
              {
                snprintf(FixDataSave[i].SigSave[Error_Type_Count][FixDataSave[i].SigSaveCount[Error_Type_Count]],elCount(FixDataSave[i].SigSave[Error_Type_Count][FixDataSave[i].SigSaveCount[Error_Type_Count]]),"%s",Temp_Value_2);
                
                FixDataSave[i].SigSaveCount[Error_Type_Count]++;
                snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
                if(Temp_Value_4[n] == 93)
                {
                  Count_Sig++;
                  k=n;break;
                }
              }
              else
                snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s%c",Temp_Value_2,Temp_Value_4[n]);
            }
          }
          if(Temp_Value_4[k] == 91 && Count_Sig == 2) //多个信号分别占用字节
          {
            for(n=k+1;n<strlen(Temp_Value_4);n++)
            {
              if(Temp_Value_4[n] == 44 || Temp_Value_4[n] == 93)
              {
                FixDataSave[i].OccupancyByte[Error_Type_Count][Count] = atol(Temp_Value_2);
                Count++;snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
                if(Temp_Value_4[n] == 93)
                {
                  Count = 0;Count_Sig++;
                  k=n;break;
                }
              }
              else
                snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s%c",Temp_Value_2,Temp_Value_4[n]);
            }
          }
          if(Temp_Value_4[k] == 125)
          {
            Error_Type_Count++;
            FixDataSave[i].Error_Type_Count = Error_Type_Count;
            j=k;break;
          }
        }
      }
    }
  }
}

_Get_FunDID_Data()
{
  int i,j,Count,k;
  char Temp_Value_1[1000];
  char Temp_Value_Temp[50];
  dword Temp_DID;
  
  DID_Function_Count = 0;
  Count = 0;
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s","");
  getProfileString(ECU_project,"DID_22_Fun_Traversal","Null",Temp_Value_1, 1000, file_name_1);
  for(i=0;i<strlen(Temp_Value_1);i++)
  {
    if(Temp_Value_1[i]==91)
    {
      for(j=i+1;j<strlen(Temp_Value_1);j++)
      {
        if(Temp_Value_1[j]==93)
        {
          DID_Function_Count = atol(Temp_Value_Temp);
          snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s","");
          i = j;
          break;
        }
        else
          snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s%c",Temp_Value_Temp,Temp_Value_1[j]);
      }
    }
    if(Temp_Value_1[i]==123)
    {
      for(j=i+1;j<strlen(Temp_Value_1);j++)
      {
        if(Temp_Value_1[j]==44 || Temp_Value_1[j]==125)
        {
          snprintf(DID_Function[Count].DID_Index,elCount(DID_Function[Count].DID_Index),"%s",Temp_Value_Temp);
          Count++;
          snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s","");
          if(Temp_Value_1[j]==125)
          {
            i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s%c",Temp_Value_Temp,Temp_Value_1[j]);
      }
    }
  }
  for(i=0;i<DID_Function_Count;i++)
  {
    _Get_FunDID_Data_2(i,DID_Function[i].DID_Index);
    DID_Function[i].Value_Set_Flage = 0;
    if(DID_Function[i].Time_Flage == 0) //非时间数据
    {
      for(j=0;j<mixArray_Len;j++)
      {
        if(strlen(DID_Function[i].Sig_Step) == 0)
        {
          if(DID_Function[i].DID_Byte[0] == mixArray[j].DID_1904[0]  && DID_Function[i].DID_Byte[1] == mixArray[j].DID_1904[01])
            snprintf(DID_Function[i].Sig_Step,elCount(DID_Function[i].Sig_Step),"%s",mixArray[j].Str_DID_1904);
        }
        if(strncmp(DID_Function[i].Sig_Step,mixArray[j].Str_DID_1904,strlen(DID_Function[i].Sig_Step)) == 0 && strlen(DID_Function[i].Sig_Step) == strlen(mixArray[j].Str_DID_1904))
        {
          if(strlen(DID_Function[i].Sig_From) == 0)
            snprintf(DID_Function[i].Sig_From,elCount(DID_Function[i].Sig_From),"%s",mixArray[j].Sig_Name_Node);
          if(strlen(DID_Function[i].Sig_Name) == 0)
            snprintf(DID_Function[i].Sig_Name,elCount(DID_Function[i].Sig_Name),"%s",mixArray[j].Sig_Name[0]);
          DID_Function[i].Max_Value = mixArray[j].DID_Value_max;
          DID_Function[i].Invalid = mixArray[j].Invalid;
          DID_Function[i].Invalid_LastValue = mixArray[j].Invalid_LastValue;
          break;
        }
      }
      if(DID_Function[i].Factor == 0 && DID_Function[i].Offset == 0 && DID_Function[i].Tolerance == 0) //连续三个数据未输入则修改数据获取来源为1904快照
      {
        for(j=0;j<mixArray_Len;j++)
        {
          if(strncmp(DID_Function[i].Sig_Step,mixArray[j].Str_DID_1904,strlen(DID_Function[i].Sig_Step)) == 0 && strlen(DID_Function[i].Sig_Step) == strlen(mixArray[j].Str_DID_1904))
          {
            DID_Function[i].Factor = mixArray[j].Factor;
            DID_Function[i].Offset = mixArray[j].Offset;
            DID_Function[i].Tolerance = mixArray[j].Tolerance;
            snprintf(DID_Function[i].Sig_Type,elCount(DID_Function[i].Sig_Type),"%s",mixArray[j].Symbol);
            break;
          }
        }
      }
    }
    else
    {
      if(strlen(DID_Function[i].LocalTime_SigName[0]) == 0 && strlen(DID_Function[i].LocalTime_SigName[1]) == 0)
      {
        if(strlen(DID_Function[i].Sig_Step) == 0)
          snprintf(DID_Function[i].Sig_Step,elCount(DID_Function[i].Sig_Step),"LocalTime");
        for(j=0;j<mixArray_Len;j++)
        {
          if(strncmp(DID_Function[i].Sig_Step,mixArray[j].Str_DID_1904,strlen(DID_Function[i].Sig_Step)) == 0 && strlen(DID_Function[i].Sig_Step) == strlen(mixArray[j].Str_DID_1904))
          {
            snprintf(DID_Function[i].Sig_Type,elCount(DID_Function[i].Sig_Type),"%s",mixArray[j].Symbol);
            snprintf(DID_Function[i].Sig_From,elCount(DID_Function[i].Sig_From),"%s",mixArray[j].Sig_Name_Node);
            for(Count = 0;Count<6;Count++)
            {
              for(k=0;k<3;k++)
                DID_Function[i].LocalTime_Config[Count][k] = mixArray[j].LocalTime[Count][k];
              for(k=0;k<6;k++)
                snprintf(DID_Function[i].LocalTime_SigDef[k],elCount(DID_Function[i].LocalTime_SigDef[k]),"%s",mixArray[j].LocalTime_Str[k]);
              for(k=0;k<6;k++)
                snprintf(DID_Function[i].LocalTime_SigName[k],elCount(DID_Function[i].LocalTime_SigName[k]),"%s",mixArray[j].Sig_Name[k]);
            }
            DID_Function[i].Invalid_LastValue = mixArray[j].Invalid_LastValue;
            break;
          }
        }
      }
    }
  }
}
_Get_FunDID_Data_2(int Index,char Str_Index[])
{
  int i,j,k,Count,Index_Count;
  char Temp_Value_1[500];
  char Temp_Value_Temp[50];
  
  Count = 0;
  Index_Count = 0;
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s","");
  getProfileString(ECU_project,Str_Index,"Null",Temp_Value_1, 500, file_name_1);
  for(i=0;i<strlen(Temp_Value_1);i++)
  {
    if(Temp_Value_1[i] == 40)
      Count++;
  }
  if(Count>9) //当输入数据过多时默认为时间参数
    DID_Function[Index].Time_Flage = 1;
  else
    DID_Function[Index].Time_Flage = 0;
  Count = 0;
  for(i=0;i<strlen(Temp_Value_1);i++)
  {
    if(Temp_Value_1[i] == 91)
    {
      for(j=i+1;j<strlen(Temp_Value_1);j++)
      {
        if(Temp_Value_1[j] == 40)
        {
          for(k=j+1;k<strlen(Temp_Value_1);k++)
          {
            if(Temp_Value_1[k] == 44 || Temp_Value_1[k] == 41)
            {
              if(DID_Function[Index].Time_Flage == 0)//非时间数据处理
              {
                switch(Count)
                {
                  case 0:DID_Function[Index].ExLen = atol(Temp_Value_Temp);break;
                  case 1:snprintf(DID_Function[Index].Sig_Step,elCount(DID_Function[Index].Sig_Step),"%s",Temp_Value_Temp);break;
                  case 2:DID_Function[Index].DID_Byte[Index_Count] = atol(Temp_Value_Temp);break;
                  case 3: if(Index_Count == 0)//信号类型
                            snprintf(DID_Function[Index].Sig_Type,elCount(DID_Function[Index].Sig_Type),"%s",Temp_Value_Temp);
                          else if(Index_Count == 1)//精度
                            strtod(Temp_Value_Temp,DID_Function[Index].Factor);
                          else if(Index_Count == 2)//偏移
                            strtod(Temp_Value_Temp,DID_Function[Index].Offset);
                          else if(Index_Count == 3)//误差
                            strtod(Temp_Value_Temp,DID_Function[Index].Tolerance);
                          break;
                  case 5: if(Index_Count == 0)//信号来源
                            snprintf(DID_Function[Index].Sig_From,elCount(DID_Function[Index].Sig_From),"%s",Temp_Value_Temp);
                          else if(Index_Count == 1)//信号名称
                            snprintf(DID_Function[Index].Sig_Name,elCount(DID_Function[Index].Sig_Name),"%s",Temp_Value_Temp);
                          break;
                  case 6: if(strstr(Temp_Value_Temp,"0x")!= -1 || strstr(Temp_Value_Temp,"0X")!= -1)
                          {
                            DID_Function[Index].Value_Set[Index_Count] = atol(Temp_Value_Temp);
                            DID_Function[Index].Value_Ex[Index_Count] = atol(Temp_Value_Temp);
                          }
                          else
                          {
                            strtod(Temp_Value_Temp,DID_Function[Index].Value_Set[Index_Count]);//预设值
                            strtod(Temp_Value_Temp,DID_Function[Index].Value_Ex[Index_Count]);
                          }
                          if(strlen(Temp_Value_Temp)>0)
                            DID_Function[Index].Value_Set_Count++;
                          break;
                  case 7: if(Index_Count == 0)//信号无效
                            snprintf(DID_Function[Index].SigInvalid,elCount(DID_Function[Index].SigInvalid),"%s",Temp_Value_Temp);
                          else if(Index_Count == 1)//信号无效值
                            DID_Function[Index].SigInvalidValue = atol(Temp_Value_Temp);
                          else if(Index_Count == 2)//信号正常值
                            DID_Function[Index].SigNormalValue = atol(Temp_Value_Temp);
                          break;
                  default :break;
                }
              }
              else//时间数据处理
              {
                switch(Count)
                {
                  case 0:DID_Function[Index].ExLen = atol(Temp_Value_Temp);break;
                  case 1:snprintf(DID_Function[Index].Sig_Step,elCount(DID_Function[Index].Sig_Step),"%s",Temp_Value_Temp);break;
                  case 2:DID_Function[Index].DID_Byte[Index_Count] = atol(Temp_Value_Temp);break;
                  case 3:snprintf(DID_Function[Index].Sig_From,elCount(DID_Function[Index].Sig_From),"%s",Temp_Value_Temp);break;
                  case 4:snprintf(DID_Function[Index].Sig_Type,elCount(DID_Function[Index].Sig_Type),"%s",Temp_Value_Temp);break; 
                  case 5: if(Index_Count == 0) //信号解析
                            snprintf(DID_Function[Index].LocalTime_SigDef[Count-4],elCount(DID_Function[Index].LocalTime_SigDef[Count-4]),"%s",Temp_Value_Temp);
                          else if(Index_Count == 1) //信号
                            snprintf(DID_Function[Index].LocalTime_SigName[Count-4],elCount(DID_Function[Index].LocalTime_SigName[Count-4]),"%s",Temp_Value_Temp);
                          else if(Index_Count == 2) //占用字节
                            DID_Function[Index].LocalTime_Config[Count-4][0] = atol(Temp_Value_Temp);
                          else if(Index_Count == 3) //起始字节
                            DID_Function[Index].LocalTime_Config[Count-4][1] = atol(Temp_Value_Temp);
                          else if(Index_Count == 4) //偏移
                            DID_Function[Index].LocalTime_Config[Count-4][2] = atol(Temp_Value_Temp);
                          break;
                  case 11: snprintf(DID_Function[Index].LocalTime_Set[Index_Count],elCount(DID_Function[Index].LocalTime_Set[Index_Count]),"%s",Temp_Value_Temp);//预设值
                          if(strlen(Temp_Value_Temp)>0)
                          {
                            _Set_Time(DID_Function[Index].LocalTime_Set[DID_Function[Index].Value_Set_Count],0);
                            snprintf(DID_Function[Index].LocalTime_Ex[DID_Function[Index].Value_Set_Count],elCount(DID_Function[Index].LocalTime_Ex[DID_Function[Index].Value_Set_Count]),"%s",Time_TempForSave);
                            DID_Function[Index].Value_Set_Count++;
                          }
                          break;
                  case 12: if(Index_Count == 0)//信号无效
                            snprintf(DID_Function[Index].SigInvalid,elCount(DID_Function[Index].SigInvalid),"%s",Temp_Value_Temp);
                          else if(Index_Count == 1)//信号无效值
                            DID_Function[Index].SigInvalidValue = atol(Temp_Value_Temp);
                          else if(Index_Count == 2)//信号正常值
                            DID_Function[Index].SigNormalValue = atol(Temp_Value_Temp);
                          break;
                  default :break;
                }
              }
              Index_Count++;
              snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s","");
              if(Temp_Value_1[k] == 41)
              {
                Count++;
                Index_Count = 0;
                j = k;break;
              }
            }
            else
              snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s%c",Temp_Value_Temp,Temp_Value_1[k]);
          }
        }
      }
    }
    if(Temp_Value_1[i] == 93)
      break;
  }
  DID_Function[Index].DID = (DID_Function[Index].DID_Byte[0]<<8) + (DID_Function[Index].DID_Byte[1]);
}

_Get_NRC_Mapping(byte Serve)
{
  int i,Flage_SpecialNRC22;
  char Str_Serve_Get[500];
  Flage_SpecialNRC22 = 0;
  Serve_NRCSpecial_Count = getProfileArray(ECU_project,"Serve_NRCSpecial",Str_Serve_Get,elCount(Str_Serve_Get),file_name_1); //不使用特殊NRC映射服务列表
  
  if(Serve != 0xFF) //特殊跳过标志
  {
    for(i=0;i<Serve_NRCSpecial_Count;i++)
    {
      Serve_NRCSpecial[i] = (Str_Serve_Get[i]&0xFF);
      if(Serve_NRCSpecial[i] == Serve)
      {
        Flage_SpecialNRC22 = 1; break;
      }
    }
    if(Flage_SpecialNRC22 == 1) //不使用映射
    {
      CarSpd_Invalid_NRC = 0x22;
      CarSpd_NRC = 0x22;
      H_Battery_NRC = 0x22;
      L_Battery_NRC = 0x22;
      Ready_NRC = 0x22;
      Gear_NRC = 0x22;
      TasTorque_NRC = 0x22;
    }
  }
  if(Flage_SpecialNRC22 == 0)
  {
    CarSpd_Invalid_NRC = getProfileInt(ECU_project,"CarSpd_Invalid_NRC",CarSpd_Invalid_NRC,file_name_1);
    CarSpd_NRC = getProfileInt(ECU_project,"CarSpd_NRC",CarSpd_NRC,file_name_1);
    H_Battery_NRC = getProfileInt(ECU_project,"H_Battery_NRC",H_Battery_NRC,file_name_1);
    L_Battery_NRC = getProfileInt(ECU_project,"L_Battery_NRC",L_Battery_NRC,file_name_1);
    Ready_NRC = getProfileInt(ECU_project,"Ready_NRC",Ready_NRC,file_name_1);
    Gear_NRC = getProfileInt(ECU_project,"Gear_NRC",Gear_NRC,file_name_1);
    TasTorque_NRC = getProfileInt(ECU_project,"TasTorque_NRC",TasTorque_NRC,file_name_1);
    Sensor_NRC = getProfileInt(ECU_project,"Sensor_NRC",Sensor_NRC,file_name_1);
    if(CarSpd_Invalid_NRC == 0)
      CarSpd_Invalid_NRC = 0x22;
    if(CarSpd_NRC == 0)
      CarSpd_NRC = 0x22;
    if(H_Battery_NRC == 0)
      H_Battery_NRC = 0x22;
    if(L_Battery_NRC == 0)  
      L_Battery_NRC = 0x22;
    if(Ready_NRC == 0)
      Ready_NRC = 0x22;
    if(Gear_NRC == 0)
      Gear_NRC = 0x22;
    if(TasTorque_NRC == 0)
      TasTorque_NRC = 0x22;
    if(Sensor_NRC == 0)
      Sensor_NRC = 0x22;
  }
}
_Get_CarSpd_Ready_Config()
{
  char TempStr[200];
  char TempStrAll[200];
  int i,j,Count;
  /*----------------------------------------------车速----------------------------------------------*/
  getProfileString(ECU_project, "CarSpd_Sig","Null",Struct_CarSpd.CarSpd_Sig, 50, file_name_1);
  Struct_CarSpd.Invalid_Value_Count = getProfileArray(ECU_project,"CarSpd_InvalidRange",Struct_CarSpd.Invalid_Value,elCount(Struct_CarSpd.Invalid_Value),file_name_1);
  Struct_CarSpd.Normal_Value_Count = getProfileArray(ECU_project,"CarSpdInvalid_Normal_Range",Struct_CarSpd.Normal_Value,elCount(Struct_CarSpd.Normal_Value),file_name_1);
  
  Count = 0;
  snprintf(TempStrAll,elCount(TempStrAll),"");
  getProfileString(ECU_project,"CarSpdInvalid_Attribute","Null",TempStrAll, 200, file_name_1);
  for(i=0;i<strlen(TempStrAll);i++)
  {
    if(TempStrAll[i] == 91)
    {
      for(j=i+1;j<strlen(TempStrAll);j++)
      {
        if(TempStrAll[j] == 44 || TempStrAll[j] == 93)
        {
          switch(Count)
          {
            case 0:
              snprintf(Struct_CarSpd.CarSpdInvalid_Sig,elCount(Struct_CarSpd.CarSpdInvalid_Sig),"%s",TempStr);break;
            case 1:
              Struct_CarSpd.Invalid_DTC = atol(TempStr);
              _ALL_DTC_Add(Struct_CarSpd.Invalid_DTC);break;
            case 2:
              Struct_CarSpd.Invalid_Time = atol(TempStr);break;
          }
          Count++;
          snprintf(TempStr,elCount(TempStr),"");
          if(TempStrAll[j] == 93)
          {
            i=j; break;
          }
        }
        else
          snprintf(TempStr,elCount(TempStr),"%s%c",TempStr,TempStrAll[j]);
      }
    }
  }
  
  Count = 0;
  snprintf(TempStrAll,elCount(TempStrAll),"");
  getProfileString(ECU_project,"CarSpdLost_Attribute","Null",TempStrAll, 200, file_name_1);
  for(i=0;i<strlen(TempStrAll);i++)
  {
    if(TempStrAll[i] == 91)
    {
      for(j=i+1;j<strlen(TempStrAll);j++)
      {
        if(TempStrAll[j] == 44 || TempStrAll[j] == 93)
        {
          switch(Count)
          {
            case 0:
              Struct_CarSpd.Sig_Id = atol(TempStr);break;
            case 1:
              Struct_CarSpd.Lost_DTC = atol(TempStr);
              _ALL_DTC_Add(Struct_CarSpd.Lost_DTC);break;
            case 2:
              Struct_CarSpd.Lost_Time = atol(TempStr);break;
          }
          Count++;
          snprintf(TempStr,elCount(TempStr),"");
          if(TempStrAll[j] == 93)
          {
            i=j; break;
          }
        }
        else
          snprintf(TempStr,elCount(TempStr),"%s%c",TempStr,TempStrAll[j]);
      }
    }
  }
  Count = 0;
  snprintf(TempStrAll,elCount(TempStrAll),"");
  getProfileString(ECU_project,"Auxiliary_Speed","Null",TempStrAll, 200, file_name_1);
  for(i=0;i<strlen(TempStrAll);i++)
  {
    if(TempStrAll[i] == 91)
    {
      for(j=i+1;j<strlen(TempStrAll);j++)
      {
        if(TempStrAll[j] == 44 || TempStrAll[j] == 93)
        {
          switch(Count)
          {
            case 0:
              Struct_CarSpd.Auxiliary_Speed_Node = atol(TempStr);break;
            case 1:
              snprintf(Struct_CarSpd.Auxiliary_Speed_Sig,elCount(Struct_CarSpd.Auxiliary_Speed_Sig),"%s",TempStr);break;
          }
          Count++;
          snprintf(TempStr,elCount(TempStr),"");
        }
        else
          snprintf(TempStr,elCount(TempStr),"%s%c",TempStr,TempStrAll[j]);
      }
    }
  }
  /*----------------------------------------------发动机----------------------------------------------*/
  getProfileString(ECU_project, "Ready_Sig","Null",Struct_Ready.Ready_Sig, 50, file_name_1);
  Struct_Ready.Ready_Active = getProfileInt(ECU_project,"Ready_Active",Struct_Ready.Ready_Active,file_name_1);
  Struct_Ready.Invalid_Value_Count = getProfileArray(ECU_project,"Ready_InvalidRange",Struct_Ready.Invalid_Value,elCount(Struct_Ready.Invalid_Value),file_name_1);
  Struct_Ready.Normal_Value_Count = getProfileArray(ECU_project,"ReadyInvalid_NormalRange",Struct_Ready.Normal_Value,elCount(Struct_Ready.Normal_Value),file_name_1);
  Struct_Ready.Ready_ValueRange_Count = getProfileArray(ECU_project,"Ready_Range",Struct_Ready.Ready_ValueRange,elCount(Struct_Ready.Ready_ValueRange),file_name_1);
  
  Count = 0;
  snprintf(TempStrAll,elCount(TempStrAll),"");
  getProfileString(ECU_project,"ReadyInvalid_Attribute","Null",TempStrAll, 200, file_name_1);
  for(i=0;i<strlen(TempStrAll);i++)
  {
    if(TempStrAll[i] == 91)
    {
      for(j=i+1;j<strlen(TempStrAll);j++)
      {
        if(TempStrAll[j] == 44 || TempStrAll[j] == 93)
        {
          switch(Count)
          {
            case 0:
              snprintf(Struct_Ready.ReadyInvalid_Sig,elCount(Struct_Ready.ReadyInvalid_Sig),"%s",TempStr);break;
            case 1:
              Struct_Ready.Invalid_DTC = atol(TempStr);
              _ALL_DTC_Add(Struct_Ready.Invalid_DTC);break;
            case 2:
              Struct_Ready.Invalid_Time = atol(TempStr);break;
          }
          Count++;
          snprintf(TempStr,elCount(TempStr),"");
          if(TempStrAll[j] == 93)
          {
            i=j; break;
          }
        }
        else
          snprintf(TempStr,elCount(TempStr),"%s%c",TempStr,TempStrAll[j]);
      }
    }
  }
  
  Count = 0;
  snprintf(TempStrAll,elCount(TempStrAll),"");
  getProfileString(ECU_project,"ReadyLost_Attribute","Null",TempStrAll, 200, file_name_1);
  for(i=0;i<strlen(TempStrAll);i++)
  {
    if(TempStrAll[i] == 91)
    {
      for(j=i+1;j<strlen(TempStrAll);j++)
      {
        if(TempStrAll[j] == 44 || TempStrAll[j] == 93)
        {
          switch(Count)
          {
            case 0:
              Struct_Ready.Sig_Id = atol(TempStr);break;
            case 1:
              Struct_Ready.Lost_DTC = atol(TempStr);
              _ALL_DTC_Add(Struct_Ready.Lost_DTC);break;
            case 2:
              Struct_Ready.Lost_Time = atol(TempStr);break;
          }
          Count++;
          snprintf(TempStr,elCount(TempStr),"");
          if(TempStrAll[j] == 93)
          {
            i=j; break;
          }
        }
        else
          snprintf(TempStr,elCount(TempStr),"%s%c",TempStr,TempStrAll[j]);
      }
    }
  }
}

_Get_AngleSig()
{
  char TempStr[100];
  snprintf(TempStr,elCount(TempStr),"");
  getProfileString(ECU_project,"Tx_AngleSig","Null",TempStr, 100, file_name_1);
  if((strncmp(TempStr,"nan",strlen(TempStr)) == 0 && strlen(TempStr) == 3)|| (strncmp(TempStr,"Null",strlen(TempStr)) == 0 && strlen(TempStr) == 4))
  {
    int Sw_temp;
    Sw_temp = _Check_StrPossion_Res("Angle",1); //检测字符串是否在预期输入快照中位置
    if(Sw_temp != -1)
      snprintf(Tx_AngleSig,elCount(Tx_AngleSig),"%s",mixArray[Sw_temp].Sig_Name[0]);
    else
    {
      writeEx(-3,0,"Angle 未查询到,后续测试角度信号检测不可信");
    }
  }
  else
    snprintf(Tx_AngleSig,elCount(Tx_AngleSig),"%s",TempStr);
}

void GetFunDID_Data(dword FunDID)
{
  char Temp_Value_1[1000];
  char Temp_Value_Temp[50];
  char StrData[100];
  int i,j,m,Count,ValueCount;
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"");
  snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"");
  snprintf(StrData,elCount(StrData),"FunDID%04X",FunDID);
  getProfileString(ECU_project,StrData,"Null",Temp_Value_1, 1000, file_name_1);
  FunDID_Read_CCPGroupCount = 0;
  for(i=0;i<strlen(Temp_Value_1);i++)
  {
    if(Temp_Value_1[i] == 40)
    {
      Count = 0; ValueCount = 0;
      for(j=i+1;j<strlen(Temp_Value_1);j++)
      {
        if(Temp_Value_1[j] == 91)
        {
          for(m=j+1;m<strlen(Temp_Value_1);m++)
          {
            if(Temp_Value_1[m]==93 || Temp_Value_1[m]==44)
            {
              if(Count == 0)
              {
                KeepDigitsOnly(Temp_Value_Temp);
                FunDID_Read_CCP[FunDID_Read_CCPGroupCount][FunDID_Read_CCPCount[FunDID_Read_CCPGroupCount]] = atol(Temp_Value_Temp);
                FunDID_Read_CCPCount[FunDID_Read_CCPGroupCount]++;
              }
              else if(Count == 1)
              {
                FunDID_Read_Vaule[FunDID_Read_CCPGroupCount][ValueCount] = atol(Temp_Value_Temp);
                ValueCount++;
              }
              else if(Count == 2)
                FunDID_Read_TuningSet[FunDID_Read_CCPGroupCount] = atol(Temp_Value_Temp);
              snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"");
              if(Temp_Value_1[m]==93)
              {
                j = m; Count++;
                break;
              }
            }
            else
              snprintf(Temp_Value_Temp,elCount(Temp_Value_Temp),"%s%c",Temp_Value_Temp,Temp_Value_1[m]);
          }
        }
        if(Count>2)
        {
          i = j;break;
        }
      }
    }
    if(Temp_Value_1[i] == 41)
      FunDID_Read_CCPGroupCount++;
  }
}

/*
    从VBF文件中获取数据
*/
void GetInforMationFromVBF()
{
  byte DataTemp[0x1000];//最小范围
  qword result;
  char TempForAdd[200];
  char TempSave[200];
  char FailePath1[300];
  char FailePath2[300];
  int i,j,Type;
  int Flage_SWP1,Flage_SWP2;
  int ChangeFlage;
  Flage_SWP1 = 0;Flage_SWP2 = 0;ChangeFlage = 0;
  //起始检测一次文件输入
  {
    sysGetVariableString(sysvar::DID::SWP1_Path,FailePath1,elCount(FailePath1));
    if(strlen(FailePath1)>5)
      Flage_SWP1 = 1;
    sysGetVariableString(sysvar::DID::SWP2_Path,FailePath2,elCount(FailePath2));
    if(strlen(FailePath2)>5)
       Flage_SWP2 = 1;
    if(Flage_SWP1 == 1 && Flage_SWP2 == 1 && FileInput_Type == 0) //文件存在且第一次读取则标志置为1
      FileInput_Type = 1;
    else if(Flage_SWP1 != 1 || Flage_SWP2 != 1) //文件不存在则标志置为 -1
      FileInput_Type = -1;
  }
  if(FileInput_Type == -1) //文件不存在则标志为 -1 ，进行文件输入检测
  {
    diagStartTesterPresent(Cdd_Name);
    openPanel("VBF文件输入");
    writeEx(-3,0,"文件输入,注意选择非压缩文件,测试时发现软件内部填充为非压缩vbf文件内容");
    for(Type = 0;Type<100;Type++)
    {
      testWaitForTimeout(1000);
      sysGetVariableString(sysvar::DID::SWP1_Path,FailePath1,elCount(FailePath1));
      if(strlen(FailePath1)>5)
        Flage_SWP1 = 1;
      sysGetVariableString(sysvar::DID::SWP2_Path,FailePath2,elCount(FailePath2));
      if(strlen(FailePath2)>5)
        Flage_SWP2 = 1;
      if(Flage_SWP1 == 1 && Flage_SWP2 == 1)
      {
        FileInput_Type = 1;
        break;
      }
    }
    if(Type>=100)
    {
      StopForVBFTest = 1; //用于停止测试标志
      _WriteEx_and_Report("","未获取到文件输入,后续测试关闭");
      return;
    }
    closePanel("VBF文件输入");
    diagStopTesterPresent(Cdd_Name);
    if(strlen(SWP1_Path) == 0)
      sysGetVariableString(sysvar::DID::SWP1_Path,SWP1_Path,elCount(SWP1_Path));
    if(strlen(SWP2_Path) == 0)
      sysGetVariableString(sysvar::DID::SWP2_Path,SWP2_Path,elCount(SWP2_Path));
  }
//  writeEx(-3,0,"SWP1存储 %s",SWP1_Path);
//  writeEx(-3,0,"SWP2存储 %s",SWP2_Path);
//  writeEx(-3,0,"SWP1获取 %s",FailePath1);
//  writeEx(-3,0,"SWP2获取 %s",FailePath2);
  if(strncmp(FailePath1,SWP1_Path,strlen(FailePath1)) != 0  || strncmp(FailePath2,SWP2_Path,strlen(FailePath2)) != 0)
  {
    ChangeFlage = 1;
//    writeEx(-3,0,"文件输入地址变更或用例重新执行");//全局变量在单独执行用例时会被清除
  }
  if(FileInput_Type == 1 || ChangeFlage == 1) //文件已输入进行数据获取
  {
    char FailePath[300];
    sysGetVariableString(sysvar::DID::SWP1_Path,SWP1_Path,elCount(SWP1_Path));
    sysGetVariableString(sysvar::DID::SWP2_Path,SWP2_Path,elCount(SWP2_Path));
    StopForVBFTest = 0;
    FileInput_Type++; //自增使下一次不在重新获取
    for(Type = 0;Type<2;Type++)
    {
      if(Type == 0)
        sysGetVariableString(sysvar::DID::SWP1_Path,FailePath,elCount(FailePath));
      else
        sysGetVariableString(sysvar::DID::SWP2_Path,FailePath,elCount(FailePath));
      snprintf(TempForAdd,elCount(TempForAdd),"%s","");
      snprintf(TempSave,elCount(TempSave),"%s","");
      GlbHandlefile = OpenFileRead(FailePath,1);
      if(GlbHandlefile == -1)
      {
        _WriteEx_and_Report("","打开文件错误");
        return;
      }
      result = fileGetBinaryBlock (DataTemp, elCount(DataTemp),GlbHandlefile);
      fileClose(GlbHandlefile);
      IndexVBF=Hexandchar_strstr(DataTemp,0,"verification_block_start = 0x");
      Index_VBF_7D=Hexandchar_strstr(DataTemp,IndexVBF,"}")-1;
      for(i = 0; i < 255; i++) //取前255个数据
        Struct_VBF_Addr[Type].DataSave[i] = DataTemp[i+Index_VBF_7D+9];
      Struct_VBF_Addr[Type].BlockCount = 0;
      IndexVBF=Hexandchar_strstr(DataTemp,0,"erase = {{");
      Index_VBF_7D=Hexandchar_strstr(DataTemp,IndexVBF,"}};");
      if(IndexVBF <= 1)
      {
        _WriteEx_and_Report("","读取数据异常");
        return;
      }
      for(i=IndexVBF-1;i<Index_VBF_7D;i++)
        snprintf(TempForAdd,elCount(TempForAdd),"%s%c",TempForAdd,DataTemp[i]);
      for(i=0;i<strlen(TempForAdd);i++)
      {
        if(TempForAdd[i] == 123)
        {
          for(j=i+1;j<strlen(TempForAdd);j++)
          {
            if(TempForAdd[j] == 44 || TempForAdd[j] == 125)
            {
              strtoul(TempSave,Struct_VBF_Addr[Type].StartAddr[Struct_VBF_Addr[Type].BlockCount]);
              Struct_VBF_Addr[Type].BlockCount++;
              snprintf(TempSave,elCount(TempSave),"%s","");
              i = j;
              break;
            }
            else
              snprintf(TempSave,elCount(TempSave),"%s%c",TempSave,TempForAdd[j]);
          }
        }
      }
    }
  }
}

/*
    根据输入的Testcase Title来修改寻址以及会话
*/
dword GetInformationFromTitle()
{
  char Title[400],TempForTitle[100],Sevre_Str[10];
  dword ReturnData ;
  int Title_Index,Count;
  long Offset;
  {
    Count = 0;
    Offset = 0;
    getProfileString("Project_Information", "ECU_project","Null",ECU_project, 200, file_name_1);  
    @sysvar::DID::funreq_ID=getProfileInt (ECU_project, "funreq_ID",0,file_name_1);
    funreq_ID = @sysvar::DID::funreq_ID;
    @sysvar::DID::phyreq_ID=getProfileInt (ECU_project, "phyreq_ID",0,file_name_1);
    phyreq_ID = @sysvar::DID::phyreq_ID;
    @sysvar::DID::Response_ID=getProfileInt (ECU_project, "Response_ID",0,file_name_1);
    Response_ID = @sysvar::DID::Response_ID;
    
    testGetCurrentTestCaseTitle(Title,400);
    snprintf(TempForTitle,elcount(TempForTitle),"");
    snprintf(Sevre_Str,elcount(Sevre_Str),"0x");
    Offset = strstr(Title,"_");
    snprintf(TempForTitle,Offset+2+4,"%s",Title); //汉字占用两字节
    //writeEx(-3,0,"%s",TempForTitle);
    if(strstr(TempForTitle,"物理")!= -1)
      ID_From_Title = phyreq_ID;
    else
      ID_From_Title = funreq_ID;
    if(strstr(TempForTitle,"默认")!= -1)
      Session_From_Title = defsession;
    else
      Session_From_Title = exsession;
    for(Count=3;Count<5;Count++)
      snprintf(Sevre_Str,elcount(Sevre_Str),"%s%c",Sevre_Str,TempForTitle[Count]);
    Serve_Form_Title = atol(Sevre_Str);
    //writeEx(-3,0,"%X , %d , %X",ID_From_Title,Session_From_Title,Serve_Form_Title);
    snprintf(TempForTitle,elcount(TempForTitle),"");
    Offset = strstr(Title,"_");
    SubString(Title,TempForTitle,Offset+1,4);
    snprintf(TempForTitle,elcount(TempForTitle),"0x%s",TempForTitle);
    DID_From_Title = atol(TempForTitle);
    
    snprintf(TempForTitle,elcount(TempForTitle),"");
    Offset = strstr(Title,"(");
    SubString(Title,TempForTitle,Offset+1,4);
    snprintf(TempForTitle,elcount(TempForTitle),"0x%s",TempForTitle);
    ReturnData = atol(TempForTitle);
  }
  return ReturnData;
}