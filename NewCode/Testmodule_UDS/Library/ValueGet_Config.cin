  getProfileString(ECU_project, "ALL_DTC","Null",Temp_Value, 5000, file_name_1);
  fileClose(GlbHandlefile);
  ALL_DTC_Num =0;
  for(i = 0;i<strlen(Temp_Value);i++)                  //查找INI文件中数组值并返回10进制
  {
    if(Temp_Value[i+1] == 48 && Temp_Value[i+2] == 120)
    {
      snprintf(Temp_2,elCount(Temp_2),"%s","");
      for(j=1;j<20;j++)
      {
        snprintf(Temp_2,elCount(Temp_2),"%s%c",Temp_2,HexToAsc(Temp_Value[i+j]));
        if(Temp_Value[i+j] == 44 || Temp_Value[i+j] == 125)
        {
          ALL_DTC_Num++;
          break;
        }
      }
      ALL_DTC[i/9] =  atol(Temp_2);
    }
  }
  @sysvar::DID::funreq_ID=getProfileInt (ECU_project, "funreq_ID",0,file_name_1);
  funreq_ID = @sysvar::DID::funreq_ID;
  @sysvar::DID::phyreq_ID=getProfileInt (ECU_project, "phyreq_ID",0,file_name_1);
  phyreq_ID = @sysvar::DID::phyreq_ID;
  @sysvar::DID::Response_ID=getProfileInt (ECU_project, "Response_ID",0,file_name_1);
  Response_ID = @sysvar::DID::Response_ID;
  _Get_ValueRange("NRC_22_Gears_Range",NRC_22_Gears_Range);
  _Get_ValueRange("ID_Range",ID_Range);
  _Get_ValueRange("High_Load_Range",High_Load_Range);
  Geely3_Flage = 0;
  if(strstr_off(ECU_project, 0, "Geely3") != -1)
    Geely3_Flage = 1;
  _Get_NRC_Mapping(0xFF);
  _get_Arry("NotNRC78_Serve");
  NotNRC78_Serve_Count = Arry_Len;
  for(i=0;i<NotNRC78_Serve_Count;i++)
    NotNRC78_Serve[i] = Arry_Data[i];
  testWaitForTimeout(200);
}
//从ini文件中获取数据
void Get_value_For_Power()
{
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString("Project_Information", "ECU_project","Null",ECU_project, 200, file_name_1); 
  Burn_in_Board = getProfileInt(ECU_project,"Burn_in_Board",Burn_in_Board,file_name_1);
  K15_OFF_Time = getProfileInt(ECU_project,"K15_OFF_Time",K15_OFF_Time,file_name_1);
  Board_Channel = getProfileInt(ECU_project,"Board_Channel",Board_Channel,file_name_1);
  if(Board_Channel != 1 && Board_Channel != 2)
    Board_Channel = 2;
  fileClose(GlbHandlefile);
  if(K15_OFF_Time==0)
    K15_OFF_Time = 1000;
  testWaitForTimeout(200);
}
void Get_value_For_NRC22_Loop()
{
  int i,Count,j;
  char Value_Data[1000];
  char Value_Data_Temp[100];
  
  snprintf(Value_Data,elCount(Value_Data),"%s","");
  snprintf(Value_Data_Temp,elCount(Value_Data_Temp),"%s","");
  NRC22_Loop_Fun_Count = 0;
  NRC22_Loop_Rsp_Count = 0;
  NRC22_Loop_Fun_Pos_Count = 0;
  
  _get_Arry("NRC22_Loop_Fun");
  for(i=0;i<Arry_Len;i++)
  {
    NRC22_Loop_Fun[NRC22_Loop_Fun_Count] = Arry_Data[i];
    NRC22_Loop_Fun_Count++;
  }
  _get_Arry("NRC22_Loop_Rsp");
  for(i=0;i<Arry_Len;i++)
  {
    NRC22_Loop_Rsp[NRC22_Loop_Rsp_Count] = Arry_Data[i];
    NRC22_Loop_Rsp_Count++;
  }
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project, "NRC22_Loop_Fun_Pos","Null",Value_Data, 1000, file_name_1);
  fileClose(GlbHandlefile);
  for(i=0;i<strlen(Value_Data);i++)
  {
    if(Value_Data[i] == 91)
    {
      Count = 0;
      for(j=i+1;i<strlen(Value_Data);j++)
      {
        if(Value_Data[j] == 44 || Value_Data[j] == 93)
        {
          NRC22_Loop_Fun_Pos[NRC22_Loop_Fun_Pos_Count][Count]  = atol(Value_Data_Temp);
          Count++;
          snprintf(Value_Data_Temp,elCount(Value_Data_Temp),"%s","");
          if(Value_Data[j] == 93)
          {
            NRC22_Loop_Fun_Pos_Count++; i=j;
            break;
          }
        }
        else
          snprintf(Value_Data_Temp,elCount(Value_Data_Temp),"%s%c",Value_Data_Temp,Value_Data[j]);
      }
    }
  }
  testWaitForTimeout(200);
}

/*
    用于获取输入字符串数据，用列表装载数据
*/
_Get_ValueRange(char Str[],dword List[])
{
  char Temp_Value_Range[500];
  char Temp_Value[500];
  int i,j;
  snprintf(Temp_Value_Range,elCount(Temp_Value_Range),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,Str ,"Null",Temp_Value_Range, 500, file_name_1);
  fileClose(GlbHandlefile);
  for(i=0;i<strlen(Temp_Value_Range);i++)     
  {
    if(Temp_Value_Range[i]==91)
    {
      snprintf(Temp_Value,elCount(Temp_Value),"%s","");
      for(j=i+1;j<50;j++)
      {
        if(Temp_Value_Range[j]==44 ||Temp_Value_Range[j]==93)
        {
          if(Temp_Value_Range[j]==44)
            List[0] = atol(Temp_Value);
          else
          {
            List[1] = atol(Temp_Value);
            break;
          }
          snprintf(Temp_Value,elCount(Temp_Value),"%s","");
        }
        else
          snprintf(Temp_Value,elCount(Temp_Value),"%s%c",Temp_Value,Temp_Value_Range[j]);
      }
    }
  }
  // testWaitForTimeout(10);
}

_Get_CarSpd_Engine()
{
  _Get_CarSpd_Ready_Config();
  
  if(strlen(Struct_CarSpd.CarSpdInvalid_Sig) == 0 || Struct_CarSpd.Invalid_DTC == 0)
    Struct_CarSpd.Invalid_DTC_Flage = 0;
  else
    Struct_CarSpd.Invalid_DTC_Flage = 1;
  if(Struct_CarSpd.Lost_DTC == 0)
    Struct_CarSpd.Lost_DTC_Flage = 0;
  else
    Struct_CarSpd.Lost_DTC_Flage = 1;
  
  if(strlen(Struct_Ready.ReadyInvalid_Sig) == 0 || Struct_Ready.Invalid_DTC == 0)
    Struct_Ready.Invalid_DTC_Flage = 0;
  else
    Struct_Ready.Invalid_DTC_Flage = 1;
  if(Struct_Ready.Lost_DTC == 0)
    Struct_Ready.Lost_DTC_Flage = 0;
  else
    Struct_Ready.Lost_DTC_Flage = 1;
}


_get_Arry(char srt[])
{
  char Temp_Value_0[500];
  char Temp_Value_2[50];
  int i,j,m;
  m = 0;
  snprintf(Temp_Value_0,elCount(Temp_Value_0),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,srt,"Null",Temp_Value_0, 1000, file_name_1);
  fileClose(GlbHandlefile);
  if(strncmp(Temp_Value_0,"Null",strlen(Temp_Value_0)) == 0 && strlen(Temp_Value_0) == strlen("Null"))
  {
    Arry_Len = 0;
    // _WriteEx_and_Report(srt,"未获取到输入数据");
  }
  else
  {
    Arry_Len = _ceil((strlen(Temp_Value_0)-1)/5.0);
    for(i = 0;i<strlen(Temp_Value_0);i++)                  
    {
      snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
      if(Temp_Value_0[i] == 48 && (Temp_Value_0[i+1] == 120 ||Temp_Value_0[i+1] == 88 ))
      {
        for(j=0;j<8;j++)
        {
          if(Temp_Value_0[i+j]==44 || i+j==strlen(Temp_Value_0)-1) 
          {
            m++; break;
          }
          else
            snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s%c",Temp_Value_2,HexToAsc(Temp_Value_0[i+j]));
        }
        Arry_Data[m-1] = atol(Temp_Value_2);
      }
    }
    if(strncmp(srt,"Read_Now_Session",strlen(srt)) == 0 && strlen(srt) == strlen("Read_Now_Session"))
    {
      if(Arry_Len>1)
      {
        Support_ReadSession = 1;
        Read_Now_Session[0] = 0x22;
        Read_Now_Session[1] = Arry_Data[0];
        Read_Now_Session[2] = Arry_Data[1];
      }
    }
  }
}

_Get_DTC_19()
{
  char Temp_Value_0[5000];
  char Temp_Value_1[5000];
  char Temp_Value_2[5000];
  char Temp_Value_3[5000];
  char Temp_Value_5[5000];
  char Temp_Value_6[5000];
  char Temp_Value_7[5000];
  char Temp_Value_8[5000];
  char Temp_Value_9[5000];
  char Temp_Value_10[5000];
  char Data_Str[100][100];
  char Data_Str_[10][300];
  int i,j,k,Flage_1904;
  int Flage_1;
  Flage_1 = 0;
  k=0;
  DTC_19_Count = 0;
  Flage_1904 = 0;
  mixArray_Len = 0;
  All_Node_Count = 0;
  Freeze_Frame_Number_Count = 0;
  Freeze_Frame_Special_Count = 0;
  Freeze_Frame_CAN_Error_Count =0;
  Freeze_Frame_Special_Invalid_Count = 0;
  ExDataRecord_Count = 0;
  Node_Invalid_Count = 0;
  snprintf(Temp_Value_0,elCount(Temp_Value_0),"%s","");
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
  snprintf(Temp_Value_3,elCount(Temp_Value_3),"%s","");
  snprintf(Temp_Value_5,elCount(Temp_Value_5),"%s","");
  snprintf(Temp_Value_6,elCount(Temp_Value_6),"%s","");
  snprintf(Temp_Value_7,elCount(Temp_Value_7),"%s","");
  snprintf(Temp_Value_8,elCount(Temp_Value_8),"%s","");
  snprintf(Temp_Value_9,elCount(Temp_Value_9),"%s","");
  snprintf(Temp_Value_10,elCount(Temp_Value_10),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString("Project_Information", "ECU_project","Null",ECU_project, 100, file_name_1);
  getProfileString(ECU_project,"DTC_19_Lost","Null",Temp_Value_0, 5000, file_name_1);
  getProfileString(ECU_project,"DTC_19_Invalid","Null",Temp_Value_6, 5000, file_name_1);
  getProfileString(ECU_project,"Freeze_Frame","Null",Temp_Value_2, 5000, file_name_1);
//  getProfileString(ECU_project,"NoDTC_Node","Null",Temp_Value_3, 5000, file_name_1);
  getProfileString(ECU_project,"DTC_ExtendedDataRecord","Null",Temp_Value_5, 5000, file_name_1);
  getProfileString(ECU_project,"Freeze_Frame_CAN_Error","Null",Temp_Value_7, 5000, file_name_1);
  getProfileString(ECU_project,"Freeze_Frame_Special","Null",Temp_Value_8, 5000, file_name_1);
  getProfileString(ECU_project,"Freeze_Frame_Special_Invalid","Null",Temp_Value_9, 5000, file_name_1);
  getProfileString(ECU_project,"DTC_Whitelist","Null",Temp_Value_10, 5000, file_name_1);
  fileClose(GlbHandlefile);
  /*DTC_19_Lost*/
  for(i=0;i<strlen(Temp_Value_0);i++)
  {
    if(Temp_Value_0[i]== 40)
    {
      for(j=i+1;j<5000;j++)
      {
        if(Temp_Value_0[j]==44 || Temp_Value_0[j]==41)
        {
          DTC_19[DTC_19_Count][k] = atol(Temp_Value_1);
          if(k==1)
            _ALL_DTC_Add(DTC_19[DTC_19_Count][k]);
          k++;
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
          if(Temp_Value_0[j]==41)
          {
            k=0;
            DTC_19_Count++;
            break;
          }
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_0[j]);
      }
    }
  }
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  
  /*DTC_19_Invalid*/
  for(i=0;i<strlen(Temp_Value_6);i++)
  {
    if(Temp_Value_6[i]== 40)
    {
      for(j=i+1;j<5000;j++)
      {
        if(Temp_Value_6[j]==44 || Temp_Value_6[j]==41)
        {
          if(k==0)
            Node_Invalid[Node_Invalid_Count].Node = atol(Temp_Value_1);
          else if(k==1)
          {
            Node_Invalid[Node_Invalid_Count].DTC = atol(Temp_Value_1);
            _ALL_DTC_Add(Node_Invalid[Node_Invalid_Count].DTC);
          }
          else if(k==2)
            Node_Invalid[Node_Invalid_Count].Mask = atol(Temp_Value_1);
          else if(k==3)
            Node_Invalid[Node_Invalid_Count].Time = atol(Temp_Value_1);
          else if(k==4)
            snprintf(Node_Invalid[Node_Invalid_Count].Signal_Name,elcount(Node_Invalid[Node_Invalid_Count].Signal_Name),"%s",Temp_Value_1);
          else if(k==5)
            Node_Invalid[Node_Invalid_Count].Invalid_Value = atol(Temp_Value_1);
          else if(k==6)
            Node_Invalid[Node_Invalid_Count].Normal_Value = atol(Temp_Value_1);
          k++;
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
          if(Temp_Value_6[j]==41)
          {
            k=0;
            Node_Invalid[Node_Invalid_Count].Invalid_Index = 0;
            Node_Invalid_Count++;
            break;
          }
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_6[j]);
      }
    }
  }
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  
  /*Freeze_Frame_Number*/
  for(i=0;i<strlen(Temp_Value_2);i++)
  {
    if(Temp_Value_2[i]==91)
    {
      for(j=i+1;j<5000;j++)
      {
        if(Temp_Value_2[j]==93)
        {
          snprintf(Data_Str[mixArray_Len],elcount(Temp_Value_1),"%s",Temp_Value_1);
          mixArray_Len++;
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
          break;
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_2[j]);
      }
    }
  }
  for(i=0;i<mixArray_Len;i++)
    _get_1904(Data_Str[i],i);
  
  /*19 06*/
  for(i=0;i<strlen(Temp_Value_5);i++)
  {
    if(Temp_Value_5[i]==91)
    {
      for(j=i+1;j<5000;j++)
      {
        if(Temp_Value_5[j]==93)
        {
          snprintf(Data_Str_[ExDataRecord_Count],elcount(Temp_Value_1),"%s",Temp_Value_1);
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
          ExDataRecord_Count++;
          break;
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_5[j]);
      }
    }
  }
  for(i=0;i<ExDataRecord_Count;i++)
    _get_1906(Data_Str_[i],i);

  {
    int Serve_Pos_19,Fun_Pos_04;
    Serve_Pos_19 = _Check_Serve(0x19,0,0);
    Fun_Pos_04 = _Check_Serve(0x19,0x04,4);
    if(Serve_Pos_19!= -1 && Fun_Pos_04!= -1)
    {
      for(i=0;i<Serve_Data[Serve_Pos_19].Serve_Para_Count[Fun_Pos_04];i++)
      {
        Freeze_Frame_Number[Freeze_Frame_Number_Count]  =Serve_Data[Serve_Pos_19].Serve_Para[Fun_Pos_04][i];
        Freeze_Frame_Number_Count++;
      }
    }
  }
  
  for(i=0;i<DTC_19_Count;i++)
  {
    All_Node[i] = DTC_19[i][0];
    All_Node_Count++;
  }

  for(i=0;i<strlen(Temp_Value_7);i++)
  {
    if(Temp_Value_7[i] == 91)
    {
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      for(j=i+1;j<5000;j++)
      {
        if(Temp_Value_7[j]==93)
        {
          snprintf(Freeze_Frame_CAN_Error[Freeze_Frame_CAN_Error_Count],elCount(Freeze_Frame_CAN_Error[Freeze_Frame_CAN_Error_Count]),"%s",Temp_Value_1);
          Freeze_Frame_CAN_Error_Count++;
          break;
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_7[j]);
      }
    }
  }
  for(i=0;i<strlen(Temp_Value_8);i++)
  {
    if(Temp_Value_8[i] == 91)
    {
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      for(j=i+1;j<strlen(Temp_Value_8);j++)
      {
        if(Temp_Value_8[j]==93)
        {
          snprintf(Freeze_Frame_Special[Freeze_Frame_Special_Count],elCount(Freeze_Frame_Special[Freeze_Frame_Special_Count]),"%s",Temp_Value_1);
          Freeze_Frame_Special_Count++;
          break;
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_8[j]);
      }
    }
  }
  for(i=0;i<strlen(Temp_Value_9);i++)
  {
    if(Temp_Value_9[i] == 91)
    {
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      for(j=i+1;j<5000;j++)
      {
        if(Temp_Value_8[j]==93)
        {
          snprintf(Freeze_Frame_Special_Invalid[Freeze_Frame_Special_Invalid_Count],elCount(Freeze_Frame_Special_Invalid[Freeze_Frame_Special_Invalid_Count]),"%s",Temp_Value_1);
          Freeze_Frame_Special_Invalid_Count++;
          break;
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_9[j]);
      }
    }
  }
  Group_Count = Freeze_Frame_Number_Count -1;
  
  /*白名单部分*/
  DTC_Whitelist_Count =0;
  for(i=0;i<strlen(Temp_Value_10);i++)
  {
    if(Temp_Value_10[i] == 123 )
    {
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      for(j=i+1;j<5000;j++)
      {
        if(Temp_Value_10[j]==44 || Temp_Value_10[j]==125)
        {
          DTC_Whitelist[DTC_Whitelist_Count] = atol(Temp_Value_1);
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
          DTC_Whitelist_Count++;
          if(Temp_Value_10[j]==125)
            break;
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_10[j]);
      }
    }
  }
  if((DTC_Whitelist_Count == 1) && (DTC_Whitelist[0]==0))/*未输入白名单时由于获取结尾符会导致多一个*/
    DTC_Whitelist_Count = 0;
  _get_Snapshot_Special();
  _Get_Advanced_function();
}
_get_1904(char str[],dword Possi)
{
  int k,n,x,count,flage_0;
  dword swhere;
  dword countmax;
  char time_temp[20];
  char time_temp_[20];
  char Temp_Value_00[2000];
  char Temp_Value_11[2000];
  snprintf(Temp_Value_00,elCount(Temp_Value_00),"%s","");
  snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString("Project_Information", "ECU_project","Null",ECU_project, 2000, file_name_1);
  getProfileString(ECU_project,str,"Null",Temp_Value_00, 2000, file_name_1);
  fileClose(GlbHandlefile);
  count = 0;
  x = 0;
  flage_0 =0;
  mixArray[Possi].Sig_Name_Count =0;
  mixArray[Possi].Snapshot_Loop_Count = 0;
  mixArray[Possi].InitValueFlage = 0;
  snprintf(mixArray[Possi].Str_DID_1904,elcount(str),"%s",str);
  if(strncmp(str,"LocalTime",strlen(str)) == 0 && strlen(str) == strlen("LocalTime"))
    flage_0 = 1;
  if(flage_0 == 0)
  {
    for(k=0;k<strlen(Temp_Value_00);k++)
    {
      if(Temp_Value_00[k]== 40)
      {
        for(n=k+1;n<2000;n++)
        {
          if(Temp_Value_00[n]==44 || Temp_Value_00[n]==41)
          {
            if(count==0) //DID
            {
              mixArray[Possi].DID_1904[x] = atol(Temp_Value_11);
              x++;
            }
            else if(count == 1) //长度
               mixArray[Possi].DID_1904_Len = atol(Temp_Value_11);
            else if(count == 2) //数据类型
              snprintf(mixArray[Possi].Symbol,elcount(Temp_Value_11),"%s",Temp_Value_11);
            else if(count == 3)//精度 + 偏移量 + 容差 + 最小值 + 最大值
            {
              if(x == 0)
                strtod(Temp_Value_11,mixArray[Possi].Factor);
              else if(x == 1)
                strtod(Temp_Value_11,mixArray[Possi].Offset);
              else if(x == 2)
                strtod(Temp_Value_11,mixArray[Possi].Tolerance);
              else if(x == 3)
                strtod(Temp_Value_11,mixArray[Possi].DID_Value_min);
              else if(x == 4)
                strtod(Temp_Value_11,mixArray[Possi].DID_Value_max);
              x++;
            }
            else if(count == 4) //无效值
            {
              if(strstr(Temp_Value_11,"-1") == -1)
                mixArray[Possi].Invalid_LastValue = 0;
              else
                mixArray[Possi].Invalid_LastValue = 1;
              mixArray[Possi].Invalid = _HexStrToQword(Temp_Value_11);
            }
            else if(count == 5) //初始值
            {
              if(strstr(Temp_Value_11,"-1") == -1)
              {
                mixArray[Possi].InitValue = _HexStrToQword(Temp_Value_11);
                mixArray[Possi].InitValueFlage = 1;
              }
            }
            else if(count == 6) //信号名
            {
              if(x == 0) //节点 
              {
                snprintf(mixArray[Possi].Sig_Name_Node,elcount(Temp_Value_11),"%s",Temp_Value_11);
                if(strlen(mixArray[Possi].Sig_Name_Node) == 0)   //未输入节点时当做空值处理防止报错
                  snprintf(mixArray[Possi].Sig_Name_Node,elCount(mixArray[Possi].Sig_Name_Node),"%s","NULL");
              }
              else //信号
              {
                snprintf(mixArray[Possi].Sig_Name[mixArray[Possi].Sig_Name_Count],elcount(Temp_Value_11),"%s",Temp_Value_11);
                if(strlen(mixArray[Possi].Sig_Name[mixArray[Possi].Sig_Name_Count]) == 0)   //未输入信号时当做空值处理防止报错
                  snprintf(mixArray[Possi].Sig_Name[mixArray[Possi].Sig_Name_Count],elCount(mixArray[Possi].Sig_Name[mixArray[Possi].Sig_Name_Count]),"%s","NULL");
                mixArray[Possi].Sig_Name_Count++;
              }
              x++;
            }
            else if(count == 7) //4次设置值
            {
              if(strstr(Temp_Value_11,"0x") != -1 || strstr(Temp_Value_11,"0X")!= -1)
                mixArray[Possi].Vaule_Set[x] = atol(Temp_Value_11);
              else
                mixArray[Possi].Vaule_Set[x] = atodbl(Temp_Value_11);
              x++;
            }
            else if(count == 8) //遍历值
            {
              if(strstr(Temp_Value_11,"0x")!= -1 || strstr(Temp_Value_11,"0X")!= -1)
                mixArray[Possi].Snapshot_Loop[x] = atol(Temp_Value_11);
              else
                mixArray[Possi].Snapshot_Loop[x] = atodbl(Temp_Value_11);
              if(strlen(Temp_Value_11)!= 0)
                mixArray[Possi].Snapshot_Loop_Count++;
              x++;
            }
            snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s","");
            if(Temp_Value_00[n]==41)
            {
              x = 0;  count++;  break;
            }
          }
          else
            snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s%c",Temp_Value_11,Temp_Value_00[n]);
        }
      }
    }
  }
  else
  {
    snprintf(mixArray[Possi].LocalTime_Value,elCount(mixArray[Possi].LocalTime_Value),"%s","");
    countmax = 0;
    for(k=0;k<elcount(Temp_Value_00);k++) //统计多少种数据
    {
      if(Temp_Value_00[k]== 40)
      {
        for(n=k+1;n<1000;n++)
        {
          if(Temp_Value_00[n]==41)
          {
            countmax++;
            break;
          }
        }
      }
    }
    for(k=0;k<strlen(Temp_Value_00);k++)
    {
      if(Temp_Value_00[k]== 40)
      {
        for(n=k+1;n<2000;n++)
        {
          if(Temp_Value_00[n]==44 || Temp_Value_00[n]==41)
          {
            if(count==0) //DID
            {
              mixArray[Possi].DID_1904[x] = atol(Temp_Value_11);
              x++;
            }
            else if(count == 1)//长度
               mixArray[Possi].DID_1904_Len = atol(Temp_Value_11);
            else if(count == 2) //节点
              snprintf(mixArray[Possi].Sig_Name_Node,elcount(Temp_Value_11),"%s",Temp_Value_11);  //节点
            else if(count == 3)//数据类型
              snprintf(mixArray[Possi].Symbol,elcount(Temp_Value_11),"%s",Temp_Value_11);
            else if(count >= 4 && count<countmax-3)
            {
              if(x == 0)
                snprintf(mixArray[Possi].LocalTime_Str[count-4],elcount(Temp_Value_11),"%s",Temp_Value_11);  //解析
              else if(x==1)
                snprintf(mixArray[Possi].Sig_Name[mixArray[Possi].Sig_Name_Count],elcount(Temp_Value_11),"%s",Temp_Value_11);  //信号
              else
                mixArray[Possi].LocalTime[count-4][x-2] = atol(Temp_Value_11);   //占用字节  -  起始字节  -  偏移  -  初始值
              if(x == 1)
                mixArray[Possi].Sig_Name_Count++;
              if(x == 5)
              {
                if(strstr(Temp_Value_11,"-1") == -1)
                  mixArray[Possi].InitValueFlage = 1;
              }
              x++;
            }
            else if(count == countmax -3)//无效值
            {
              if(strstr(Temp_Value_11,"-1") == -1)
                mixArray[Possi].Invalid_LastValue = 0;
              else
                mixArray[Possi].Invalid_LastValue = 1;
              mixArray[Possi].Invalid = atol(Temp_Value_11);
            }
            else if(count == countmax -2)//4次设置值
            {
              snprintf(mixArray[Possi].LocalTime_Set[x],elCount(mixArray[Possi].LocalTime_Set[x]),"%s",Temp_Value_11);
              snprintf(mixArray[Possi].LocalTime_Value_Set[x],elCount(mixArray[Possi].LocalTime_Value_Set[x]),"%s",Temp_Value_11);
              x++;
            }
            else if(count == countmax -1)//遍历值
            {
              snprintf(mixArray[Possi].Time_Snapshot_Loop[x],elCount(mixArray[Possi].Time_Snapshot_Loop[x]),"%s",Temp_Value_11);
              if(strlen(Temp_Value_11)!= 0)
                mixArray[Possi].Snapshot_Loop_Count++;
              x++;
            }
            snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s","");
            if(Temp_Value_00[n]==41)
            {
              x = 0;
              count++;
              break;
            }
          }
          else
            snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s%c",Temp_Value_11,Temp_Value_00[n]);
        }
      }
    }
  }
  mixArray[Possi].Step_Flage = 0;
}
_get_Snapshot_Special() //获取快照中特殊部分数据
{
  int i,j,k,n,Pos_Str,Pos_Snapshot;
  int Temp_p,Len;
  char Get_Str[3][200];     //共三组数据需获取,获取后统一装载到一个结构体内,需要时进行获取对应数据
  char Temp_Value_Save[1000];
  char Temp_Value_Joint[500];
  Snapshot_Special_Count = 0;
  snprintf(Get_Str[0],elCount(Get_Str[0]),"Freeze_Frame_CAN_Error_Sig");
  snprintf(Get_Str[1],elCount(Get_Str[1]),"Freeze_Frame_Special_Sig");
  snprintf(Get_Str[2],elCount(Get_Str[2]),"Freeze_Frame_Special_Invalid_Sig");
  for(k=0;k<3;k++)
  {
    char Temp_Str[100];
    int Temp_Pos,Count,Save_Flage;
    Count = 0;
    snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    snprintf(Temp_Value_Save,elCount(Temp_Value_Save),"%s","");
    snprintf(Temp_Value_Joint,elCount(Temp_Value_Joint),"%s","");
    GlbHandlefile = OpenFileRead (file_name_1,0);
    getProfileString(ECU_project,Get_Str[k],"Null",Temp_Value_Save, 1000, file_name_1);
    snprintf(Temp_Value_Joint,elCount(Temp_Value_Joint),"");
    fileClose(GlbHandlefile);
    if(k==0)
      Count = Freeze_Frame_CAN_Error_Count;
    else if(k==1)
      Count = Freeze_Frame_Special_Count;
    else if(k==2)
      Count = Freeze_Frame_Special_Invalid_Count;
    if(strlen(Temp_Value_Save) < 5)//无任何输入,均在DTC中存在(为空时会生成'nan')
    {
      for(i=0;i<Count;i++)
      {
        if(k==0)
          snprintf(Temp_Str,elCount(Temp_Str),"%s",Freeze_Frame_CAN_Error[i]);
        else if(k==1)
          snprintf(Temp_Str,elCount(Temp_Str),"%s",Freeze_Frame_Special[i]);
        else if(k==2)
          snprintf(Temp_Str,elCount(Temp_Str),"%s",Freeze_Frame_Special_Invalid[i]);
        Temp_Pos = _Check_StrPossion_Res(Temp_Str,1);
        Save_Flage = 1;
        for(j=0;j<Snapshot_Special_Count;j++) //判断是否已经存在，若已存在则跳过
        {
          if(strncmp(Temp_Str,Snapshot_Special[j].Snapshot,strlen(Temp_Str)) == 0 && strlen(Temp_Str) == strlen(Snapshot_Special[j].Snapshot))
          {
            Save_Flage = 0;
            break;
          }
        }
        if(Save_Flage == 1)  //不存在，进行装载
        {
          if(Temp_Pos == -1)
          {
//            _WriteEx_and_Report(Temp_Str,"未查询到对应数据");
          }
          else
          {
            Snapshot_Special[Snapshot_Special_Count].Sig_ID = atol(mixArray[Temp_Pos].Sig_Name_Node);
            snprintf(Snapshot_Special[Snapshot_Special_Count].Snapshot,elCount(Snapshot_Special[Snapshot_Special_Count].Snapshot),"%s",Temp_Str);
            for(j=0;j<Node_Invalid_Count;j++)
            {
              if(Node_Invalid[j].Node == Snapshot_Special[Snapshot_Special_Count].Sig_ID)
                break;
            }
          }
          if(j==Node_Invalid_Count)
          {
//            write("未查询到对应ID: 0x%03X 的无效DTC数据",Snapshot_Special[Snapshot_Special_Count].Sig_ID);
          }
          else
          {
            snprintf(Snapshot_Special[Snapshot_Special_Count].Sig_Name,elCount(Snapshot_Special[Snapshot_Special_Count].Sig_Name),"%s",Node_Invalid[j].Signal_Name);
            Snapshot_Special[Snapshot_Special_Count].Invalid_Value = Node_Invalid[j].Invalid_Value;
            Snapshot_Special[Snapshot_Special_Count].Normal_Value = Node_Invalid[j].Normal_Value;
            Snapshot_Special[Snapshot_Special_Count].Invalid_Time = Node_Invalid[j].Time;
            Snapshot_Special_Count++;
          }
        }
      }
    }
    else//存在输入
    {
      Pos_Snapshot = 0;
      Len = 0;
      for(i=0;i<strlen(Temp_Value_Save);i++)
      {
        if(Temp_Value_Save[i]== 91)  //查询到分割符，进行数据存储
        {
          Pos_Str = 0;
          
          if(k==0)
            snprintf(Temp_Str,elCount(Temp_Str),"%s",Freeze_Frame_CAN_Error[Pos_Snapshot]);
          else if(k==1)
            snprintf(Temp_Str,elCount(Temp_Str),"%s",Freeze_Frame_Special[Pos_Snapshot]);
          else if(k==2)
            snprintf(Temp_Str,elCount(Temp_Str),"%s",Freeze_Frame_Special_Invalid[Pos_Snapshot]);
          Save_Flage = 1;
          for(j=0;j<Snapshot_Special_Count;j++)  //个数累加不清空
          {
            if(strncmp(Temp_Str,Snapshot_Special[j].Snapshot,strlen(Temp_Str)) == 0 && strlen(Temp_Str) == strlen(Snapshot_Special[j].Snapshot)) //查询是否已经装载过
            {
//              Save_Flage = 0;
              break;
            }
          }
          Temp_p = j;
          Pos_Snapshot++;
          if(Save_Flage == 1)
          {
            snprintf(Snapshot_Special[Temp_p].Snapshot,elCount(Snapshot_Special[Temp_p].Snapshot),"%s",Temp_Str);  //获取当前对应的快照释义
            for(j=i+1;j<strlen(Temp_Value_Save);j++)
            {
              if(Temp_Value_Save[j] == 44 || Temp_Value_Save[j] == 93)
              {
                if(Pos_Str == 0 && Len>2) //ID
                  Snapshot_Special[Temp_p].Sig_ID = atol(Temp_Value_Joint);
                else if(Pos_Str == 1 && Len > 3 )
                  snprintf(Snapshot_Special[Temp_p].Sig_Name,elCount(Snapshot_Special[Temp_p].Sig_Name),"%s",Temp_Value_Joint);
                else if(Pos_Str == 2)
                {
                  Snapshot_Special[Temp_p].Invalid_Value = atol(Temp_Value_Joint);
                  Snapshot_Special[Temp_p].Invalid_Time = 500;/*********************存在未输入时间需使用DTC中时间*/
                }
                else if(Pos_Str == 3)
                  Snapshot_Special[Temp_p].Normal_Value = atol(Temp_Value_Joint);
                
                Pos_Str++;
                Len = 0;
                snprintf(Temp_Value_Joint,elCount(Temp_Value_Joint),"");
                if(Temp_Value_Save[j] == 93)
                {
                  if(strlen(Snapshot_Special[Temp_p].Sig_Name) == 0 || Snapshot_Special[Temp_p].Sig_ID == 0)
                  {
                    int Swhere;
                    Swhere = _Check_StrPossion_Res(Snapshot_Special[Temp_p].Snapshot,1);
                    if(Swhere == -1)
                    {
//                      _WriteEx_and_Report(Snapshot_Special[Temp_p].Snapshot,"未在快照中查询到对应数据");
                    }
                    else
                    {
                      Snapshot_Special[Temp_p].Sig_ID = atol(mixArray[Swhere].Sig_Name_Node);
                      for(n=0;n<Node_Invalid_Count;n++)
                      {
                        if(Snapshot_Special[Temp_p].Sig_ID == Node_Invalid[n].Node)
                        {
                          snprintf(Snapshot_Special[Temp_p].Sig_Name,elCount(Snapshot_Special[Temp_p].Sig_Name),"%s",Node_Invalid[n].Signal_Name);
                          Snapshot_Special[Temp_p].Invalid_Value = Node_Invalid[n].Invalid_Value;
                          Snapshot_Special[Temp_p].Normal_Value = Node_Invalid[n].Normal_Value;
                          Snapshot_Special[Temp_p].Invalid_Time = Node_Invalid[n].Time;
                          break;
                        }
                      }
                    }
                  }
                  if(Temp_p == Snapshot_Special_Count)
                    Snapshot_Special_Count++;
                  i=j;
                  break;
                }
              }
              else
              {
                Len++;
                snprintf(Temp_Value_Joint,elCount(Temp_Value_Joint),"%s%c",Temp_Value_Joint,Temp_Value_Save[j]);
              }
            }
          }
        }
      }
    }
  }
}
_get_1906(char str[],dword Possi)
{
  int n,k,count,x;
  char Temp_Value_00[1000];
  char Temp_Value_11[500];
  snprintf(Temp_Value_00,elCount(Temp_Value_00),"%s","");
  snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString("Project_Information", "ECU_project","Null",ECU_project, 2000, file_name_1);
  getProfileString(ECU_project,str,"Null",Temp_Value_00, 2000, file_name_1);
  fileClose(GlbHandlefile);
  count = 0;
  snprintf(ExDataRecord[Possi].Ex_Data_Record_Str,elCount(ExDataRecord[Possi].Ex_Data_Record_Str),str);
  for(n=0;n<1000;n++)
  {
    if(Temp_Value_00[n]==40)
    {
      for(k=n+1;k<500;k++)
      {
        if(Temp_Value_00[k]==44 || Temp_Value_00[k]==41)
        {
          if(count==0)
            ExDataRecord[Possi].Ex_Data_Record_Num_Flage = atol(Temp_Value_11);
          else if(count==1)
            ExDataRecord[Possi].Ex_Data_Record_Num = atol(Temp_Value_11);
          else if(count==2)
            ExDataRecord[Possi].Ex_Data_Record_Len = atol(Temp_Value_11);
          else
          {
            if(x==0)
              ExDataRecord[Possi].Ex_Data_Record_min = atol(Temp_Value_11);
            else if(x==1)
              ExDataRecord[Possi].Ex_Data_Record_max = atol(Temp_Value_11);
            x++;
          }
          snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s","");
          if(Temp_Value_00[k]==41)
          {
            count++;
            x=0;
            break;
          }
        }
        else
          snprintf(Temp_Value_11,elCount(Temp_Value_11),"%s%c",Temp_Value_11,Temp_Value_00[k]);
      }
    }
  }
}
_Get_Advanced_function()
{
  char Temp_Value_1[1000];
  char Temp_Value[100];
  int i,j,Count,Len;
  Advanced_function_Count = 0;
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value,elCount(Temp_Value),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,"Advanced_function","Null",Temp_Value_1,1000, file_name_1);
  fileClose(GlbHandlefile);
  for(i=0;i<strlen(Temp_Value_1);i++)
  {
    if(Temp_Value_1[i]==91)
    {
      Count = 0;
      Len = 0;
      for(j=i+1;j<strlen(Temp_Value_1);j++)
      {
        if(Temp_Value_1[j] == 44 || Temp_Value_1[j] == 93)
        {
          if(Count == 0)
            Advanced_function[Advanced_function_Count].Node = atol(Temp_Value);
          else if(Count == 1)
          {
            Advanced_function[Advanced_function_Count].DTC = atol(Temp_Value);
            if(Len>=1)
              Advanced_function[Advanced_function_Count].Falge_DTC = 1;
            else
              Advanced_function[Advanced_function_Count].Falge_DTC = 0;
          }
          else if(Count == 2)
            Advanced_function[Advanced_function_Count].Fun_Byte = atol(Temp_Value);
          else if(Count == 3)
            Advanced_function[Advanced_function_Count].Fun_Bit = atol(Temp_Value);
          Count++;
          snprintf(Temp_Value,elCount(Temp_Value),"%s","");
          if(Temp_Value_1[j] == 93)
          {
            Advanced_function_Count++;
            i=j;
            break;
          }
        }
        else
        {
          if(Count == 1)
            Len++;
          snprintf(Temp_Value,elCount(Temp_Value),"%s%c",Temp_Value,Temp_Value_1[j]);
        }
      }
    }
  }
  for(i=0;i<Advanced_function_Count;i++)
  {
    if(Advanced_function[i].Falge_DTC == 0 && Advanced_function[i].Node != 0)
    {
      for(j=0;j<DTC_19_Count;j++)
      {
        if(Advanced_function[i].Node == DTC_19[j][0])
        {
          Advanced_function[i].DTC = DTC_19[j][1];
          break;
        }
      }
    }
  }
}

_get_28_Case()//获取28测试项次中的车速及对应反馈
{
  char Temp_Value1[200];
  char Temp_Value2[20];
  int i,m,j,flage;
  m = 0;
  j = 0;
  flage = 0;
  snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
  snprintf(Sig_28_Set,elCount(Sig_28_Set),"%s","");
  snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,"DID28_Case","Null",Temp_Value1,1000, file_name_1);
  fileClose(GlbHandlefile);
  for(i=0;i<strlen(Temp_Value1);i++)
  {
    if(Temp_Value1[i]==91)
    {
      for(j=i+1;j<100;j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          if(flage == 1)
            strtod(Temp_Value2,Factor_28);
          else if(flage == 2)
            strtod(Temp_Value2,Offset_28);
          else if(flage == 3)
            strtod(Temp_Value2,Tolerance_28);
          else if(flage==4)
             DID28_Case_CarSpd_1 = atol(Temp_Value2);
          else if(flage==5)
            DID28_Case_CarSpd_Return_1 = atol(Temp_Value2);
          else if(flage==6)
            DID28_Sig_Invaild_Value=atol(Temp_Value2);
          else if(flage==7)
            DID28_Case_CarSpd_2 = atol(Temp_Value2);
          else if(flage==8)
            DID28_Case_CarSpd_Return_2 = atol(Temp_Value2);
          if(Temp_Value1[j]==93)
          { m=0; flage++; snprintf(Temp_Value2,elCount(Temp_Value2),"%s",""); break; }
          else
            snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
        }
        else
        {
          if(flage == 0 && Temp_Value1[j]!= 93)
            snprintf(Sig_28_Set,elCount(Sig_28_Set),"%s%c",Sig_28_Set,Temp_Value1[j]);
          else if(Temp_Value1[j]== 93)
            snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          else
            snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
        }
      }
    }
  }
  testWaitForTimeout(500);
}
int _Get_Read_Plural(char str[])
{
  char Temp_Value_0[1000];
  char Temp_Value_1[100];
  int i,j,k,Count,Count_Group,Flage;
  
  snprintf(Temp_Value_0,elCount(Temp_Value_0),"%s","");
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  DID_Read_Count = 0;
  Count_Group = 0;
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,str,"Null",Temp_Value_0, 1000, file_name_1);
  fileClose(GlbHandlefile);
  if(strlen(Temp_Value_0)<= 5)
    return -1;
  else
  {
    for(i=0;i<strlen(Temp_Value_0);i++)
    {
      if(Temp_Value_0[i] == 91)
      {
        Count = 0;
        for(j=i+1;j<strlen(Temp_Value_0);j++)
        {
          if(Temp_Value_0[j] == 44 || Temp_Value_0[j] == 93)
          {
            DID_Read[DID_Read_Count].DID_byte[Count] = atol(Temp_Value_1);
            Count++;
            snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
            if(Temp_Value_0[j] == 93)
            {
              i = j;
              DID_Read_Count++;
              Count_Group++;
              break;
            }
          }
          else
            snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_0[j]);
        }
      }
    }
    for(i=0;i<DID_Read_Count;i++)
      DID_Read[i].DID = ((DID_Read[i].DID_byte[0]<<8) + (DID_Read[i].DID_byte[1]));
    _get_Str_Traversal("DID_22_Traversal");
    
    for(i=0;i<DID_Read_Count;i++)
    {
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"DID_%04X",DID_Read[i].DID);
      Flage = 0;
      for(j=0;j<Traversal_Count;j++)
      {
        if(strncmp(Traversal_DID[j],Temp_Value_1,strlen(Traversal_DID[j])) == 0 && strlen(Traversal_DID[j]) == strlen(Temp_Value_1))
        {
          Flage = 1;
          _Get_DID(Traversal_DID[j]);
          DID_Read[i].LenExResp = DID_len_Ex-3;
          DID_Read[i].Analysis_Read = Analysis;
          DID_Read[i].Padding = UnUse_Byte;
          DID_Read[i].ExRspCheck = 1;
          if(Len_Input == 0)
          {
            DID_Read[i].ExRspCheck = 0;
            break;
          }
          if(Analysis == 1)
          {
            for(k=0;k<Len_Input;k++)
              DID_Read[i].ExResp_byte[k] = DID_Data[k];
            if(Len_Input < DID_len_Ex)
            {
              for(k=Len_Input;k<DID_len_Ex-3;k++)  /*减去 22 + DID长度*/
                DID_Read[i].ExResp_byte[k] = DID_Read[i].Padding;
            }
          }
          else
          {
            snprintf(DID_Read[i].ExResp,elCount(DID_Read[i].ExResp),"%s",DID_Data_str);
            if(Analysis == 2 && Len_Input < DID_len_Ex)
            {
              Len_Input = strlen(DID_Read[i].ExResp);
              for(k=Len_Input;k<DID_len_Ex-3;k++)   /*减去 22 + DID长度*/
                snprintf(DID_Read[i].ExResp,elCount(DID_Read[i].ExResp),"%s%c",DID_Read[i].ExResp,UnUse_Byte);
            }
          }
          break;
        }
      }
      if(Flage == 0)
      {
        DID_Read[i].LenExResp = 0;
        snprintf(DID_Read[i].ExResp,elCount(DID_Read[i].ExResp),"");
      }
    }
    return 1;
  }
}

