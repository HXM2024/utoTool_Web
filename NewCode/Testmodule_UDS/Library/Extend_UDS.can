  @sysvar::DID::WaitForRes = getProfileInt(ECU_pro,"p2cmax",@sysvar::DID::WaitForRes,file_name_2);
  @sysvar::DID::filler_0 = getProfileInt(ECU_pro,"filler",temp,file_name_2);
  @sysvar::DID::funreq_ID=getProfileInt (ECU_pro, "funreq_ID",0,file_name_2);
  @sysvar::DID::phyreq_ID=getProfileInt (ECU_pro, "phyreq_ID",0,file_name_2);
  @sysvar::DID::Response_ID=getProfileInt (ECU_pro, "Response_ID",0,file_name_2);
  fileClose (glbHandle);
}
_Read_File()
{
