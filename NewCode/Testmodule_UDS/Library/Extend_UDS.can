void _Check_DID_ALLHexToDec(char DID_ASCII[],int byte_1,int byte_2,long Len,char str[])  //16进制->16进制整体转为10进制
{
  diagRequest * req1;
  int i = 0, LenRx = 0,LenEx = 0;
  int flage = 0;
  qword Data_Temp = 0;
  char Buffer[200],Buffer_Check[200];  
  _Read_File();
  diagSetTarget (Cdd_Name_Ex);
  diagResize(req1,3);
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  Data_Temp = 0;
  sysGetVariableDescriptionForValue(sysvar::DID::ECU_platform,@sysvar::DID::ECU_platform,Platform,elcount(Platform));
  glbHandle = OpenFileRead (file_path,0);
  setFilePath(file_path,0); 
  getProfileString(Platform,str,"",DID_ASCII,elCount(DID_ASCII),file_name);
  DiagSetPrimitiveByte(req1,0,0x22);
  DiagSetPrimitiveByte(req1,1,byte_1);
  DiagSetPrimitiveByte(req1,2,byte_2);
  _SendAndWriteReport(req1,@sysvar::DID::phyreq_ID);
  LenRx = diagGetRespPrimitiveSize(req1);

  Not_Check_3570(DID_ASCII);
  if(Check_Flage == 0)
  {
      if(diagGetLastResponseCode(req1) == 0)
        {
            testStepFail("未收到响应");
            writeEx(-3,0,"未收到响应");
        }
      else if (diagGetLastResponseCode(req1) > 0)
        {
            testStepFail("收到消极应答");
            writeEx(-3,0,"收到消极应答");
        }
      else if(diagGetLastResponseCode(req1) == -1)
      {
        if(DiagGetRespPrimitiveByte(req1,0) == 0x62 && DiagGetRespPrimitiveByte(req1,1)==byte_1 && DiagGetRespPrimitiveByte(req1,2) == byte_2)
          { testStepPass(str,"前3 Byte符合预期");}
        else
          {testStepFail(str,"第0字节为为：0x%2X ,第1字节为为：0x%2X ,第2字节为为：0x%2X",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));}
        snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
        for(i=3;i<LenRx;i++)
          {
            if(DiagGetRespPrimitiveByte(req1,i)>0x0F)
              {
                snprintf(Buffer,elCount(Buffer),"%s%2X",Buffer,DiagGetRespPrimitiveByte(req1,i));
              }
            else
              {
                snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0");
                snprintf(Buffer,elCount(Buffer),"%s%X",Buffer,DiagGetRespPrimitiveByte(req1,i));
              }
          }
          strtoull(Buffer,Data_Temp);
          snprintf(Buffer_Check,elCount(Buffer_Check),"%s%I64u",Buffer_Check,Data_Temp);
          Check_information(Buffer_Check,DID_ASCII,str);
      }
      if(Len != LenRx)
      {
        testStepFail("长度异常","返回长度为：%d,预期长度为：%d",LenRx,Len);
      }
  }
  else 
  {
    testStepWarning(str,"未输入预期值，跳过检测");
    writeEx(-3,0,"%s,未输入预期值，跳过检测",str);
  }
}

void _Check_DID_Mix(char DID_ASCII_1[],char DID_ASCII_2[],int byte_1,int byte_2,long Len_1,long Len_2,char str_1[],char str_2[])  //混合解析方式
{
  diagRequest * req1;
  int i = 0, LenRx = 0;
  qword Data_Temp = 0;
  int flage = 0;
  char Buffer[200],Buffer_Check[200];
  _Read_File();
  diagSetTarget (Cdd_Name_Ex);
  diagResize(req1,3);
  snprintf(Buffer,elCount(Buffer),"%s","");                        //初始化字符串
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");            //初始化字符串
  Data_Temp = 0;
  sysGetVariableDescriptionForValue(sysvar::DID::ECU_platform,@sysvar::DID::ECU_platform,Platform,elcount(Platform));
  glbHandle = OpenFileRead (file_path,0);
  setFilePath(file_path,0); 
  
  getProfileString(Platform,str_1,"",DID_ASCII_1,elCount(DID_ASCII_1),file_name);
  getProfileString(Platform,str_2,"",DID_ASCII_2,elCount(DID_ASCII_2),file_name);
  
  DiagSetPrimitiveByte(req1,0,0x22);
  DiagSetPrimitiveByte(req1,1,byte_1);
  DiagSetPrimitiveByte(req1,2,byte_2);
  _SendAndWriteReport(req1,@sysvar::DID::phyreq_ID);
  LenRx = diagGetRespPrimitiveSize(req1);

  Not_Check_3570(DID_ASCII_1);
  if(Check_Flage == 0)
  {
      if(diagGetLastResponseCode(req1) == 0)
        {
            testStepFail("未收到响应");
            writeEx(-3,0,"未收到响应");
        }
      else if (diagGetLastResponseCode(req1) > 0)
        {
            testStepFail("收到消极应答");
            writeEx(-3,0,"收到消极应答");
        }
      else if(diagGetLastResponseCode(req1) == -1)
      {
        if(DiagGetRespPrimitiveByte(req1,0) == 0x62 && DiagGetRespPrimitiveByte(req1,1)==byte_1 && DiagGetRespPrimitiveByte(req1,2) == byte_2)
          { testStepPass(str_1,"前3 Byte符合预期");}
        else
          {testStepFail(str_1,"第0字节为为：0x%2X ,第1字节为为：0x%2X ,第2字节为为：0x%2X",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));}
        for(i=3;i<3+Len_1;i++)
        {
          Data_Temp += (DiagGetRespPrimitiveByte(req1,i)<<(4*Len_1-8*(i-3)));
        } 
        ltoa(Data_Temp,Buffer_Check,10);
        Check_information(Buffer_Check,DID_ASCII_1,str_1);
      }
  }
  else 
  {
    testStepWarning(str_1,"未输入预期值，跳过检测");
    writeEx(-3,0,"%s,未输入预期值，跳过检测",str_1);
  }
  Data_Temp = 0;
  snprintf(Buffer,elCount(Buffer),"%s","");                        //初始化字符串
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");            //初始化字符串
  Not_Check_3570(DID_ASCII_2);
  if(Check_Flage == 0)
  {
      if(diagGetLastResponseCode(req1) == 0)
        {
            testStepFail("未收到响应");
        }
      else if (diagGetLastResponseCode(req1) > 0)
        {
            testStepFail("收到消极应答");
        }
      else if(diagGetLastResponseCode(req1) == -1)
      {
        for(i=3+Len_1;i<LenRx;i++)
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,10);
          if(strlen(Buffer) == 1)
          {
            snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
          }
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
        }
        Check_information(Buffer_Check,DID_ASCII_2,str_2);
       
      }
    if(LenRx != (3+Len_1+Len_2))
    {testStepFail("长度异常","返回长度为：%d,预期长度为：%d",LenRx,(3+Len_1+Len_2));}
  }
  else 
  {
    testStepWarning(str_2,"未输入预期值，跳过检测");
    writeEx(-3,0,"%s,未输入预期值，跳过检测",str_2);
  }
}

testcase _Check_3570()
{ 
  char Check_Platform[6] = {J3_A,J3_B,J3_C,J3_E,J3_F,J3_G};    //不同平台可能会取不同的字节地址，故做判断区分
  _Start();
  sysGetVariableDescriptionForValue(sysvar::DID::ECU_platform,@sysvar::DID::ECU_platform,Platform,elcount(Platform));
  glbHandle = OpenFileRead (file_path,0);
  setFilePath(file_path,0);
  
  getProfileString(Platform,"Hardware_version","",Hardware_version_ASCII,elCount(Hardware_version_ASCII),file_name);
  getProfileString(Platform,"Hardware_number","",Hardware_number_ASCII,elCount(Hardware_number_ASCII),file_name);
  getProfileString(Platform,"Calibrate_version","",Calibrate_version_ASCII,elCount(Calibrate_version_ASCII),file_name);
  getProfileString(Platform,"SVN_Revision","",SVN_Revision_ASCII,elCount(SVN_Revision_ASCII),file_name);
  getProfileString(Platform,"Software_version","",Software_version_ASCII,elCount(Software_version_ASCII),file_name);
  getProfileString(Platform,"FBT","",FBT_ASCII,elCount(FBT_ASCII),file_name);
  getProfileString(Platform,"SBT","",SBT_ASCII,elCount(SBT_ASCII),file_name);
  getProfileString(Platform,"Hardware_Test","",Hardware_Test_ASCII,elCount(Hardware_Test_ASCII),file_name);
  getProfileString(Platform,"ECU_Number","",ECU_Number_ASCII,elCount(ECU_Number_ASCII),file_name);
  getProfileString(Platform,"SW","",SW_ASCII,elCount(SW_ASCII),file_name);
  getProfileString(Platform,"HW","",HW_ASCII,elCount(HW_ASCII),file_name);
//  sysGetVariableString(sysvar::DID::phyreq_ID,phyreq_ID,10);
//  sysGetVariableString(sysvar::DID::Response_ID,Response_ID,10);
//  sysGetVariableString(sysvar::DID::funreq_id,funreq_id,10);

  if (@sysvar::DID::ECU_platform == Check_Platform[0])
  {
     Check_J3_F();
  }
  if (@sysvar::DID::ECU_platform == Check_Platform[1])
  {
     Check_J3_F();
  }
  if (@sysvar::DID::ECU_platform == Check_Platform[2])
  {
     Check_J3_F();
  }
  if (@sysvar::DID::ECU_platform == Check_Platform[3])
  {
     Check_J3_F();
  }
  if (@sysvar::DID::ECU_platform == Check_Platform[4])
  {
     Check_J3_F();
  }
  if (@sysvar::DID::ECU_platform == Check_Platform[5])
  {
     Check_J3_F();
  }
  _End();
}


