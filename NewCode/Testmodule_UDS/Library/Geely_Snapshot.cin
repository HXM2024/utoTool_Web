  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    _Step_1904(Str_,0xFF);
  }
  testWaitForTimeout(5000);;
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    int Pos_;
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_2[0],elCount(Str_2[0]),"%s","");
    snprintf(Str_2[1],elCount(Str_2[1]),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    Pos_ = _Check_StrPossion_Res(Str_,1);    
    snprintf(Str_2[0],elCount(Str_2[0]),"20%s",mixArray[Pos_].LocalTime_Value_2[1]); //Geely3.0节点偏移2000
    Da_Temp[0] = mixArray[Pos_].Vaule_Ex_2[1];
    if(strncmp(Str_,"LocalTime",strlen(Str_))==0)
      _Check_1904_Specified(Str_,Str_2,0);
    else
      _Check_1904_Specified(Str_,Da_Temp,0);
    testWaitForTimeout(500);
  }
  _WriteEx_and_Report("","将数据恢复正常");
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    _Step_1904(Str_,0);
  }
}
void _19_04_06_Geely(dword ID,byte Session,dword DID_Set)//故障码全局快照（Steering Shaft Torque Sensor #2）的填充值测试
{
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Read_DID[3];
  float Da_Temp;
  char Str[50];
  dword DTC;
  int Pos,Fun_DIDPos,Pos_DTC;
  _Get_FunDID_Data();
  DTC = Snapshot_Geely_DTC;
  Pos_DTC = Get_Node_Pos(Node_1904,1);
  Send_Data_19[2] = (DTC_19[Pos_DTC][1]>>16);
  Send_Data_19[3] = (DTC_19[Pos_DTC][1]>>8);
  Send_Data_19[4] = (DTC_19[Pos_DTC][1]&0xFF);
  Read_DID[0] = 0x22; Read_DID[1] = (DID_Set>>8)&0xFF;  Read_DID[2] = (DID_Set&0xFF);_Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(DID_Set);
  snprintf(Str,elCount(Str),"%s","Torque");
  Pos = _Check_StrPossion_Res(Str,1);
  if(Pos == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }
  if(Fun_DIDPos != -1)
    DID_Function[Fun_DIDPos].Value_Set_Flage = 1;

  _WriteEx_and_Report("","此条用例需要人为操作，故力矩仅进行输出");
  _Set_Ready(0);
  StepByGeely3_0(0x19,1);
  _WriteEx_and_Report("","当前测试无力矩介入");
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Close_One_Node(DTC_19[Pos_DTC]);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_1904(SendData,0,Str,Da_Temp,2);
  Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,0,0,0);
  _Open_One_Node(DTC_19[Pos_DTC]);
  _TestWaitForTesterConfirmation("断开传感器后点击YES");
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Close_One_Node(DTC_19[Pos_DTC]);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_1904(SendData,0,Str,Da_Temp,1);
  Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,0,1,0);
  _Open_One_Node(DTC_19[Pos_DTC]);
  _TestWaitForTesterConfirmation("恢复传感器后点击YES");
  {
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
  }
  
  for(i=0;i<mixArray[Pos].Snapshot_Loop_Count;i++)
  {
    _TestWaitForTesterConfirmation("此处需人为判断，施加 %.2f Nm力矩并维持，然后点击YES",mixArray[Pos].Snapshot_Loop[i]);
    testWaitForTimeout(2000);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1000);
    _Close_One_Node(DTC_19[Pos_DTC]);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1904(SendData,0,Str,Da_Temp,2);
    Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,mixArray[Pos].Snapshot_Loop[i],0,2);
    _Open_One_Node(DTC_19[Pos_DTC]);
  }
  _TestWaitForTesterConfirmation("松开方向盘");
}

void _19_04_07_Geely(dword ID,byte Session,dword DID_Set)//故障码全局快照（Reduction Factor）的填充值测试
{
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Read_DID[3];
  int Pos,Fun_DIDPos;
  float Da_Temp;
  char Str[50];
  dword DTC;

  _Get_FunDID_Data();
  DTC = Snapshot_Geely_DTC;
  Send_Data_19[2] = (DTC>>16); Send_Data_19[3] = (DTC>>8); Send_Data_19[4] = (DTC&0xFF);
  Read_DID[0] = 0x22; Read_DID[1] = (DID_Set>>8)&0xFF;  Read_DID[2] = (DID_Set&0xFF);_Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(DID_Set);
  
  snprintf(Str,elCount(Str),"%s","ReductionFactor");
  Pos = _Check_StrPossion_Res(Str,1);  
  
  if(Pos == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }
  if(Fun_DIDPos != -1)
    DID_Function[Fun_DIDPos].Value_Set_Flage = 1;

  for(i=0;i<mixArray[Pos].Snapshot_Loop_Count;i++)
  {
    _Set_Ready(mixArray[Pos].Snapshot_Loop[i]);
    if(mixArray[Pos].Snapshot_Loop[i]==11 || mixArray[Pos].Snapshot_Loop[i] == 13)
      Da_Temp = 0;
    else
      Da_Temp = mixArray[Pos].Factor*0x8000 + mixArray[Pos].Offset;
    testWaitForTimeout(2000);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1000);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1904(SendData,0,Str,Da_Temp,0);
    Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,Da_Temp,0,0);
  }
}

void _19_04_08_Geely(dword ID,byte Session,dword DID_Set)//故障码全局快照（Internal Steering Angle）的填充值测试
{
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Read_DID[3];
  int Pos,Fun_DIDPos,Pos_DTC;
  float Da_Temp;
  char Str[50];

  _Get_FunDID_Data();
  Pos_DTC = Get_Node_Pos(Node_1904,1);
  Send_Data_19[2] = (DTC_19[Pos_DTC][1]>>16);
  Send_Data_19[3] = (DTC_19[Pos_DTC][1]>>8);
  Send_Data_19[4] = (DTC_19[Pos_DTC][1]&0xFF);
  Read_DID[0] = 0x22; Read_DID[1] = (DID_Set>>8)&0xFF;  Read_DID[2] = (DID_Set&0xFF);_Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(DID_Set);
  
  snprintf(Str,elCount(Str),"%s","Angle");
  Pos = _Check_StrPossion_Res(Str,1);  
  if(Pos == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }
  if(Fun_DIDPos != -1)
    DID_Function[Fun_DIDPos].Value_Set_Flage = 1;

  _Set_Ready(0);
  StepByGeely3_0(0x19,1);
  _Ang_Calibration_();
  testWaitForTimeout(1000);

  _WriteEx_and_Report("","此处不转动方向盘，查看当前输出角度");
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Close_One_Node(DTC_19[Pos_DTC]);
  Da_Temp = 0;
  _Send_Diag(6,ID,Send_Data_19);
  _Check_1904(SendData,0,"Angle",Da_Temp,0);
  Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,Da_Temp,0,0);
  _Open_One_Node(DTC_19[Pos_DTC]);
  _TestWaitForTesterConfirmation("断开传感器后点击YES");
  {
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(500);
    _Close_One_Node(DTC_19[Pos_DTC]);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1904(SendData,0,"Angle",Da_Temp,1);
    Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,Da_Temp,1,0);
    _Open_One_Node(DTC_19[Pos_DTC]);
  }
  {
    _TestWaitForTesterConfirmation("恢复传感器后点击YES");
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
  }

  for(i=0;i<mixArray[Pos].Snapshot_Loop_Count;i++)
  {
    _TestWaitForTesterConfirmation("此处需人为判断，转动方向盘到 %.2f °，然后点击YES，判断输出的角度与转动角度是否一致",mixArray[Pos].Snapshot_Loop[i]);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1000);
    _Close_One_Node(DTC_19[Pos_DTC]);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1904(SendData,0,"Angle",Da_Temp,2);
    Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,mixArray[Pos].Snapshot_Loop[i],0,2);
    _Open_One_Node(DTC_19[Pos_DTC]);
  }
}

