  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  _Open_One_Node(DTC_19[Pos]);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  
  _Step_1904(Str,0);
}

void _19_04_13_Geely(dword ID,byte Session)//故障码全局快照（Ready_State）的填充值测试
{
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  int Pos_;
  float Da_Temp[2];
  char Str[50];
  dword DTC;
  
  DTC = Snapshot_Geely_DTC;
  Send_Data_19[2] = (DTC>>16);
  Send_Data_19[3] = (DTC>>8);
  Send_Data_19[4] = (DTC&0xFF);
  
  snprintf(Str,elCount(Str),"%s","Ready_State");
  Pos_ = _Check_StrPossion_Res(Str,1);  
  if(Pos_ == -1)
  {
    snprintf(Str,elCount(Str),"%s","Usagemode");
    Pos_ = _Check_StrPossion_Res(Str,1); 
  }
  if(Pos_ == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }

  Da_Temp[0] = 0;
  _Set_Ready(0);
  StepByGeely3_0(0x19,1);
  _Set_Ready(0);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  
  Da_Temp[0] = 1;
  _Set_Ready(1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  
  Da_Temp[0] = 2;
  _Set_Ready(2);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  
  Da_Temp[0] = 11;
  _Set_Ready(11);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  
  Da_Temp[0] = 13;
  _Set_Ready(13);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
}

void _19_04_14_Geely(dword ID,byte Session)//故障码全局快照（Power_Lev）的填充值测试
{
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  int Pos,Pos_;
  float Da_Temp;
  byte Save;
  char Str[50];
  dword DTC;
  
  DTC = Snapshot_Geely_DTC;
  Send_Data_19[2] = (DTC>>16);
  Send_Data_19[3] = (DTC>>8);
  Send_Data_19[4] = (DTC&0xFF);
  
  snprintf(Str,elCount(Str),"%s","Power_Lev");
  Pos = Get_Node_Pos(Node_1904,1);
  Pos_ = _Check_StrPossion_Res(Str,1);  
  if(Pos_ == -1)
  {
    snprintf(Str,elCount(Str),"%s","ElPowerLevel");
    Pos_ = _Check_StrPossion_Res(Str,1); 
  }
  if(Pos_ == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }
  
  _Set_Ready(0);
  StepByGeely3_0(0x19,1);
  for(i=0;i<mixArray[Pos_].Snapshot_Loop_Count;i++)
  {
    Da_Temp = mixArray[Pos_].Snapshot_Loop[i];
    Save = (int)Da_Temp;
    _Set_Sig(PwrLvlElecMai_Sig,(Save>>4));
    _Set_Sig(PwrLvlElecSubtyp_Sig,(Save&0xF));
    testWaitForTimeout(1000);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1000);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1904(SendData,0,Str,Da_Temp,0);
  }
}
void _19_04_15_Geely(dword ID,byte Session,dword DID_Set)//故障码全局快照（Motor_Torque）的填充值测试
{
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Read_DID[3];
  int Pos_,Fun_DIDPos;
  float Da_Temp;
  char Str[50];
  dword DTC;
  
  _Get_FunDID_Data();
  DTC = Snapshot_Geely_DTC;
  Send_Data_19[2] = (DTC>>16); Send_Data_19[3] = (DTC>>8); Send_Data_19[4] = (DTC&0xFF);
  Read_DID[0] = 0x22; Read_DID[1] = (DID_Set>>8)&0xFF;  Read_DID[2] = (DID_Set&0xFF);_Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(DID_Set);

  snprintf(Str,elCount(Str),"%s","Power_Steering_Torque");
  Pos_ = _Check_StrPossion_Res(Str,1);  
  if(Pos_ == -1)
  {
    snprintf(Str,elCount(Str),"%s","Motor_Torque");
    Pos_ = _Check_StrPossion_Res(Str,1);  
    if(Pos_ == -1)
    {
      snprintf(Str,elCount(Str),"%s","Power_Steering_Motor_Torque");
      Pos_ = _Check_StrPossion_Res(Str,1);  
    }
  }
  if(Pos_ == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }
  if(Fun_DIDPos != -1)
    DID_Function[Fun_DIDPos].Value_Set_Flage = 1;

  _WriteEx_and_Report("","此条用例需要人为操作，故力矩仅进行输出");
  _Set_Ready(0);
  testWaitForTimeout(1000);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _WriteEx_and_Report("","此处测试无力矩介入情况");
  _Send_Diag(6,ID,Send_Data_19);
  _Check_1904(SendData,0,Str,Da_Temp,2);
  Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,0,0,2);
  
  for(i=0;i<mixArray[Pos_].Snapshot_Loop_Count;i++)
  {
    Da_Temp = mixArray[Pos_].Snapshot_Loop[i];
    _TestWaitForTesterConfirmation("此处需人为判断，施加力矩 %.2f Nm并维持，然后点击YES",mixArray[Pos_].Snapshot_Loop[i]);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1000);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1904(SendData,0,Str,Da_Temp,2);
    Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,mixArray[Pos_].Snapshot_Loop[i],0,2);
  }
  _TestWaitForTesterConfirmation("松开方向盘");
}
void _19_04_16_Geely(dword ID,byte Session,dword DID_Set)//故障码全局快照（ECU Power Supply Voltage）的填充值测试
{
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Read_DID[3];
  int i,Pos_,Fun_DIDPos;
  float Da_Temp;
  char Str[50];
  dword DTC;
  
  _Get_FunDID_Data();
  DTC = Snapshot_Geely_DTC;
  Send_Data_19[2] = (DTC>>16); Send_Data_19[3] = (DTC>>8); Send_Data_19[4] = (DTC&0xFF);
  Read_DID[0] = 0x22; Read_DID[1] = (DID_Set>>8)&0xFF;  Read_DID[2] = (DID_Set&0xFF);_Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(DID_Set);
  
  snprintf(Str,elCount(Str),"%s","Battery");
  Pos_ = _Check_StrPossion_Res(Str,1);  
  if(Pos_ == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }
  if(Fun_DIDPos != -1)
    DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  
  for(i=0;i<mixArray[Pos_].Snapshot_Loop_Count;i++)
  {
    _Set_Battery(mixArray[Pos_].Snapshot_Loop[i]);
    Da_Temp = mixArray[Pos_].Snapshot_Loop[i];
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1000);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1904(SendData,0,Str,Da_Temp,0);
    Check_ReadFunDID(Read_DID,Fun_DIDPos,ID,1,mixArray[Pos_].Snapshot_Loop[i],0,0);
  }
  _Set_Battery(12);
}
