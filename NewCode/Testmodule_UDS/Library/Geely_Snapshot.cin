  _Check_OCC_Resp(i,1);
  _WriteEx_and_Report("","步骤23-24完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(5000+H_Battery_Time);
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,2);
  _WriteEx_and_Report("","步骤25-26完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(5000+H_Battery_Time);
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,0);
  _WriteEx_and_Report("","步骤27-28完成");
  _Set_Battery(12);
}

void OCC_7()
{
  byte Send_Data19[6] = {0x19,0x06,0,0,0,0};
  dword DTC = 0xDC1A88;
  int i;
  i = 4;
  Send_Data19[2] = (DTC>>16)&0xFF;
  Send_Data19[3] = (DTC>>8)&0xFF;
  Send_Data19[4] =  DTC&0xFF;
  Send_Data19[5] = i;
  _Set_Ready(0);
  _Power_Down();
  _Power_Up();
  StepByGeely3_0(0x19,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Check_DTC_Res(0x09,0,DTC);
  _WriteEx_and_Report("","步骤1-4完成");
  
  RelayOFF(3);
  testWaitForTimeout(1000);
  RelayON(3);
  testWaitForTimeout(RecoverFastTime);
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,1);
  _WriteEx_and_Report("","步骤5-6完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(10000);
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,1);
  _WriteEx_and_Report("","步骤7-8完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(10000);
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,2);
  _WriteEx_and_Report("","步骤9-10完成");
  
  RelayOFF(3);
  testWaitForTimeout(1000);
  RelayON(3);
  testWaitForTimeout(RecoverFastTime);
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,2);
  _WriteEx_and_Report("","步骤11-12完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(10000);
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,3);
  _WriteEx_and_Report("","步骤13-14完成");
}

void OCC1_OCC3()
{
  byte Send_Data19[6] = {0x19,0x06,0,0,0,0};
  dword DTC = 0xC15182;
  int i,j;
  Send_Data19[2] = (DTC>>16)&0xFF;
  Send_Data19[3] = (DTC>>8)&0xFF;
  Send_Data19[4] =  DTC&0xFF;
  _Set_Ready(0);
  _Power_Down();
  _Power_Up();
  StepByGeely3_0(0x19,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Check_DTC_Res(0x09,0,DTC);
  _WriteEx_and_Report("","步骤1-4完成");
  
  _TestDisableMsg(0x1B0);
  testWaitForTimeout(10000);
  _TestEnableMsg(0x1B0);
  i = 1;
  Send_Data19[5] = i;
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,0);
  i = 3;
  Send_Data19[5] = i;
  _Send_Diag(6,phyreq_ID,Send_Data19);
  _Check_OCC_Resp(i,0);
  _WriteEx_and_Report("","步骤5-6完成");
  
  _Set_Ready(0);
  testWaitForTimeout(500);
  for(j=0;j<=259;j++)
  {
     _WriteEx_and_Report("","第 %d 次上下电",j+1);
    _K15_OFF();
    testWaitForTimeout(K15_OFF_Time);
    _K15_ON();
    testWaitForTimeout(1000);
    i = 1;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(j+1>=0xFF)
      _Check_OCC_Resp(i,0xFF);
    else
      _Check_OCC_Resp(i,j+1);
    
    i = 3;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(j+1>=0xFF)
      _Check_OCC_Resp(i,0xFF);
    else
      _Check_OCC_Resp(i,j+1);
  }
}

void OCC4_Count()
{
