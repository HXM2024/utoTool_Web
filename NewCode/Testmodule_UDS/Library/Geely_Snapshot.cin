/*@!Encoding:936*/
includes
{
  
}
variables
{
  int RecoverFastTime = 2000;      //快恢复
  int64 RecoverSlowTime = 60000;      //慢恢复
}

void _Check_OCC_Resp(byte OOC,int Ex)
{
  int i;
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,100);
  if(DiagGetRespPrimitiveSize(SendData) != 8)
  {
    testStepFail("","返回长度异常");
    return;
  }
  for(i=0;i<6;i++)
  {
    if(i==5)
      continue;
    if(i==0)
    {
      if(DiagGetRespPrimitiveByte(SendData,0) != (DiagGetPrimitiveByte(SendData,0)^0x40))
        testStepFail("","预期反馈为:0x%02X，实际反馈为:0x%02X",0x59,DiagGetRespPrimitiveByte(SendData,0));
    }
    else
    {
      if(DiagGetRespPrimitiveByte(SendData,i) != DiagGetPrimitiveByte(SendData,i))
        testStepFail("","预期反馈为:0x%02X，实际反馈为:0x%02X",DiagGetPrimitiveByte(SendData,i),DiagGetRespPrimitiveByte(SendData,i));
    }
  }
  if(DiagGetRespPrimitiveByte(SendData,6) != OOC)
    testStepFail("","预期反馈为:0x%02X，实际反馈为:0x%02X",OOC,DiagGetRespPrimitiveByte(SendData,6));
  else
    testStepPass("","预期反馈与实际一致");
  if(DiagGetRespPrimitiveByte(SendData,7) != Ex)
    testStepFail("","预期反馈为:0x%02X，实际反馈为:0x%02X",Ex,DiagGetRespPrimitiveByte(SendData,7));
  else
    testStepPass("","预期反馈与实际一致,0CC%d = %d",OOC,Ex);
}

void OCC_ALL()
{
  byte Send_Data19[6] = {0x19,0x06,0,0,0,0};
  dword DTC = 0xDC1A88;
  int i;
  Send_Data19[2] = (DTC>>16)&0xFF;
  Send_Data19[3] = (DTC>>8)&0xFF;
  Send_Data19[4] =  DTC&0xFF;
  _Set_Ready(0);
  _Power_Down();
  _Power_Up();
  StepByGeely3_0(0x19,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Check_DTC_Res(0x09,0,DTC);
  _WriteEx_and_Report("","步骤1-4完成");
  
  RelayOFF(3);  //常开端，BUSOFF需发送关闭
  testWaitForTimeout(1000);
  RelayON(3); //常开端，BUSOFF需发送开启
  testWaitForTimeout(RecoverFastTime);
  for(i=1;i<7;i++)
  {
    if(i==5)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==4 || i==7)
      _Check_OCC_Resp(i,1);
    else
      _Check_OCC_Resp(i,0);
  }
  _WriteEx_and_Report("","步骤5-6完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(10000);
  for(i=1;i<7;i++)
  {
    if(i==5)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==2 || i==6)
      _Check_OCC_Resp(i,0);
    else
      _Check_OCC_Resp(i,1);
  }
  _WriteEx_and_Report("","步骤7-8完成");
  
  RelayOFF(3);
  testWaitForTimeout(1000);
  RelayON(3);
  testWaitForTimeout(RecoverFastTime);
  for(i=1;i<7;i++)
  {
    if(i==5)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==1 ||i==2 || i==6)
      _Check_OCC_Resp(i,0);
    else if(i==3 ||i==7)
      _Check_OCC_Resp(i,1);
    else
      _Check_OCC_Resp(i,2);
  }
  _WriteEx_and_Report("","步骤9-10完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(10000);
  for(i=1;i<7;i++)
  {
    if(i==5 || i==6)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==1 )
      _Check_OCC_Resp(i,1);
    else if(i==2 )
      _Check_OCC_Resp(i,0);
    else
      _Check_OCC_Resp(i,2);
  }
  _WriteEx_and_Report("","步骤11-12完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(10000);
  for(i=1;i<7;i++)
  {
    if(i==5 || i==6)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==1 || i==4)
      _Check_OCC_Resp(i,2);
    else if(i==2 )
      _Check_OCC_Resp(i,1);
    else
      _Check_OCC_Resp(i,3);
  }
  _WriteEx_and_Report("","步骤13-14完成");
  
  RelayOFF(3);
  testWaitForTimeout(1000);
  RelayON(3);
  testWaitForTimeout(RecoverFastTime);
  for(i=1;i<7;i++)
  {
    if(i==5 || i==6)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==1 || i==2)
      _Check_OCC_Resp(i,0);
    else
      _Check_OCC_Resp(i,3);
  }
  _WriteEx_and_Report("","步骤15-16完成");
  
  RelayOFF(3);
  testWaitForTimeout(1000);
  RelayON(3);
  testWaitForTimeout(RecoverFastTime);
  for(i=3;i<5;i++)
  {
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    _Check_OCC_Resp(i,3);
  }
  _WriteEx_and_Report("","步骤17-18完成");
  
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(10000);
  for(i=1;i<7;i++)
  {
    if(i==5)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==1)
      _Check_OCC_Resp(i,1);
    else if(i==2 || i==6)
      _Check_OCC_Resp(i,0);
    else if(i==4)
      _Check_OCC_Resp(i,3);
    else 
      _Check_OCC_Resp(i,4);
  }
  _WriteEx_and_Report("","步骤19-20完成");
  
  RelayOFF(3);
  testWaitForTimeout(1000);
  RelayON(3);
  testWaitForTimeout(RecoverFastTime);
  for(i=1;i<7;i++)
  {
    if(i==5)
      continue;
    Send_Data19[5] = i;
    _Send_Diag(6,phyreq_ID,Send_Data19);
    if(i==1 ||i==2 || i==6)
      _Check_OCC_Resp(i,0);
    else 
      _Check_OCC_Resp(i,4);
  }
  _WriteEx_and_Report("","步骤21-22完成");
  
}

