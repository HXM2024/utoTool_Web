void _19_04_20_ALL_Geely(dword ID,byte Session)
{
  int i;
  byte mask;
  byte Data_Send[6] = {0x19,0x04,0,0,0,0x55};
  byte Did_Res[500];
  dword Did_Res_Len;
  
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    DTC_H = (DTC_19[Node_1904_Pos][1]>>16);
    DTC_M = (DTC_19[Node_1904_Pos][1]>>8);
    DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
    Data_Send[2] = DTC_H;
    Data_Send[3] = DTC_M;
    Data_Send[4] = DTC_L;
    Data_Send[5] = Freeze_Frame_Number[0];
    
    _Set_Ready(0);
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
    StepByGeely3_0(0x19,1);
    
    _WriteEx_and_Report("","第一次设置信号值");
    for(i=0;i<mixArray_Len;i++)
      _Step_1904(mixArray[i].Str_DID_1904,0);
    _WriteEx_and_Report("","等待5s后制造节点丢失当前故障");
    testWaitForTimeout(5000);
    _Close_One_Node(DTC_19[Node_1904_Pos]);
    mask = DTC_19[Node_1904_Pos][2];
    _Send_Diag(6,ID,Data_Send);
    _Check_1904(SendData,mask,"ALL",0,0);
    for(i=0;i<DiagGetRespPrimitiveSize(SendData);i++)
    {
      Did_Res[i] = diagGetRespPrimitiveByte(SendData,i);
      Did_Res_Len++;
    }
    
    _WriteEx_and_Report("","第二次设置信号值");
    for(i=0;i<mixArray_Len;i++)
      _Step_1904(mixArray[i].Str_DID_1904,1);
    testWaitForTimeout(2000);
    _Send_Diag(6,ID,Data_Send);
    _Check_Response_(SendData,Did_Res_Len,Did_Res,1);
    
    _WriteEx_and_Report("","恢复节点使其成为历史故障");
    _Open_One_Node(DTC_19[Node_1904_Pos]);
    testWaitForTimeout(1000);
    _Send_Diag(6,ID,Data_Send);
    _Check_Response_(SendData,Did_Res_Len,Did_Res,8);
    
    _WriteEx_and_Report("","第三次设置信号值");
    for(i=0;i<mixArray_Len;i++)
      _Step_1904(mixArray[i].Str_DID_1904,2);
    _WriteEx_and_Report("","等待5s后制造节点丢失当前故障");
    testWaitForTimeout(5000);
    _Close_One_Node(DTC_19[Node_1904_Pos]);
    _Send_Diag(6,ID,Data_Send);
    _Check_Response_(SendData,Did_Res_Len,Did_Res,1);
    
    _WriteEx_and_Report("","下电后设置第四次值，再上电");
    _Power_Down();
    testWaitForTimeout(2000);
    for(i=0;i<mixArray_Len;i++)
      _Step_1904(mixArray[i].Str_DID_1904,3);
    _K15_ON();
    testWaitForTimeout(8000);
    _Send_Diag(6,ID,Data_Send);
    _Check_Response_(SendData,Did_Res_Len,Did_Res,1);
    
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1500);
    _Send_Diag(6,ID,Data_Send);
    _Check_1904(SendData,mask,"ALL",0,0);
    _Open_One_Node(DTC_19[Node_1904_Pos]);
  }
}
