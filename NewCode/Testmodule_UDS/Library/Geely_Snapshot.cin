void _19_04_03_Geely(dword ID,byte Session)//故障码全局快照（时间.里程.电压.车速.usgmod.Electric Power Level）默认填充值测试
{
  dword ID_Save[6] = {0x360,0x1F0,0xE0,0x156,0x380,0x2E0};
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  int i;
  char Str_2[2][100];
  char Str_[100];
  float Da_Temp[2];
  dword DTC;
  
  DTC = Snapshot_Geely_DTC;
  _WriteEx_and_Report("","此用例需接入CAN卡打开ZCANPRO通道，使报文能够正常发送"); 
  Send_Data_19[2] = (DTC>>16);
  Send_Data_19[3] = (DTC>>8);
  Send_Data_19[4] = (DTC&0xFF);
  _Set_Ready(0);
  _Power_Down();
  Flage_Invalid_Geely = 1;
  for(i=0;i<elcount(ID_Save);i++)
    _TestDisableMsg(ID_Save[i]);
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(1000);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    snprintf(Str_2[0],elCount(Str_2[0]),"FFFFFFFFFFFF");
    Da_Temp[1] = Da_Temp[0];
    if(strncmp(Str_,"LocalTime",strlen(Str_))==0)
      _Check_1904_Specified(Str_,Str_2,1);
    else
      _Check_1904_Specified(Str_,Da_Temp,1);
    testWaitForTimeout(500);
  }
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    _Step_1904(Str_,0xFF);
  }
  testWaitForTimeout(200);
  for(i=0;i<elcount(ID_Save);i++)
    _TestEnableMsg(ID_Save[i]);
  testWaitForTimeout(1000);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    snprintf(Str_2[0],elCount(Str_2[0]),"FFFFFFFFFFFF");
    Da_Temp[1] = Da_Temp[0];
    if(strncmp(Str_,"LocalTime",strlen(Str_))==0)
      _Check_1904_Specified(Str_,Str_2,1);
    else
      _Check_1904_Specified(Str_,Da_Temp,1);
    testWaitForTimeout(500);
  }
  _WriteEx_and_Report("","测试完成发送正常值");
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    _Step_1904(Str_,0);
  }
}

