/*@!Encoding:936*/
includes
{
  #include "CCP_Change.cin"
}

variables
{
  message * CCPMsg={dlc=8};   //CCP装载MSG
  
  byte Value_All[1000][255];//装载全部有效数据
  
  dword Send_Invaild_CCP[500][2]; // 装载无效CCP以及无效值 例Send_Invaild_CCP[0][0]为无效CCP号 Send_Invaild_CCP[0][1]为无效值
  dword Send_Invaild_CCP_Count; // 装载无效CCP个数
  
  dword Send_Invaild_CCP_Plural[500][2]; // 装载复数个无效CCP
  dword Send_Invaild_CCP_Plural_Count; // 装载无效CCP个数
  
  dword Send_Vaild_CCP_Plural[500][2]; // 装载复数个有效CCP
  dword Send_Vaild_CCP_Plural_Count; // 装载有效CCP个数
  
  byte Max_Invaild_CCP_Count = 10;
  
  int CCP_Error_ID;
  
  int Off_Set_CCP,Off_Set_ExtCCP;
  int Max_Frame,Invaid_CCP_UB,Invaid_ExtCCP_UB;
  int Send_CCP_Count,Send_ExtCCP_Count;
  
  byte Blockid[2][50];     //装载发送CCP的byte0
  int     Blocksize[2];     //装载发送的Msg数量
  char Str_OutPut_InValidCCP[500];
  
  const UB_FlagePos = 24;
}

setLogFile(char name[],char path[])
{ 
  char logpath[500];
  
  snprintf(logpath,elCount(logpath),"%s%s",path,name);
  setLogFileName(logpath);  
//  snprintf(logpath,elCount(logpath),".\\Logging\\%s",name);
//  testReportFileName(logpath);
  startLogging();   
}

CCP_ValidList(word ccpid)
{
  int i,j;
  dword DTC_CCP[5];
  char name[200];
  snprintf(name,elCount(name),"CCP%d_ValidList",ccpid);
  setLogFile(name,".\\Logging\\CCP_有效值\\");
  testWaitForTimeout(500);

  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Clear_CCP_Config();
  
  for(i=0;i<CCPlen(ccpid);i++)
  { 
    writeEx(-3,0,"当前测试CCP%d有效值为0x%02X",ccpid,ValidValue(ccpid,i));
    teststep("CCP有效值测试","当前测试CCP%d有效值为0x%02X",ccpid,ValidValue(ccpid,i));
    _Set_Ready(0);
    testWaitForTimeout(1000);
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(20000);
    sendccp(ccpid,ValidValue(ccpid,i));
    testWaitForTimeout(CCP_Time-20000); 
    E103(0,i+1,ValidValue(ccpid,i));
    _Check_DTC_Res_NowOrHis(9,1,1,DTC_CCP);
  }
  stopLogging();
}

CCP_InValidList(word ccpid)
{
  int i;
  char name[200];
  byte Invalid_;
  int InValidCount;
  int Error_Count;
  snprintf(name,elCount(name),"CCP%d_InValidList",ccpid);
  setLogFile(name,".\\Logging\\CCP_无效值\\");
  testWaitForTimeout(500);

  _Clear_CCP_Config();
  InValidCount = 0;
  for(i=0;i<(256-CCPlen(ccpid));i++)
  { 
    Invalid_ = InValidValue(ccpid,i);
    writeEx(-3,0,"当前测试CCP%d无效值为0x%02X",ccpid,Invalid_);
    teststep("CCP有效值测试","当前测试CCP%d无效值为0x%02X",ccpid,Invalid_);
    _Set_Ready(0);
    testWaitForTimeout(1000);
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(24000);    

    sendccp(ccpid,Invalid_);
    testWaitForTimeout(CCP_Time-24000); 
    if(CCP_Stepping == 0)
      InValidCount = 1;
    else
      InValidCount += 1;
    Error_Count = E103(ccpid,InValidCount,Invalid_);
    if(Error_Count == -1 && CCP_Error_ID == 0) //程序出错处理，错误的将无效值当做有效值导致错误计数被清除，重新开始叠加
      InValidCount = 0;
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
  }
  stopLogging();
}
/*
  发送CCP报文
  Type == 0：正常发送全部有效值
  Type == 1：缺失部分Msg信号，未获取完整信号(当前仅在CCP<=504中生效)
  Type == 2：所有CCP均发送无效值
  Type == 3：某个CCP无效
  Type == 4：发送过程中断电
  Type == 5：发送过程中高压
  Type == 6：发送过程中低压
  Type == 0x08：CCP发送全0x00
  Type == 0x09：CCP发送全0xFF
  Type == 0x0A：CCP发送全0xAA
  Type == 0x82：所有CCP均发送无效值但不清除无效计数,测试无效CCP累加最大值
  Type == 0x14：无效发送过程中断电
  Type == 0x15：无效发送过程中高压
  Type == 0x16：无效发送过程中低压
  Type == 0x88：CCP发送全0x00,但不清除无效CCP计数
  Type == 0x89：CCP发送全0xFF,但不清除无效CCP计数
  Type == 0x8A：CCP发送全0xAA,但不清除无效CCP计数
*/
Sendccp(byte Type)
{
  int i,j;
  byte CCP_Pos_;
  byte Lost_Msg_ID;
  dword Invalid_CCP_ID;
  int Flage;
  byte Invaild_Va;
  byte Invaild_VaTemp;
  if((Type&0x80) != 0x80)
    Send_Invaild_CCP_Count = 0;
  
  Init_For_BlockID();
  if(Type == 1 || (Type&0x0F) == 4 || (Type&0x0F) == 5 || (Type&0x0F) == 6)
  {
    do{
      Lost_Msg_ID = random(256);
    }while((Lost_Msg_ID <=1 ) || (_Check_Dword_in_Num(Lost_Msg_ID,Blockid[0],Blocksize[0]) == -1));
  }
  else if(Type == 3)
  {
    do{
      Invalid_CCP_ID = random(ccpNums[elCount(ccpNums)-1]+1);
    }while(_Check_Dword_in_Num(Invalid_CCP_ID,ccpNums,ccpNumscount) == -1);
  }
  else if((Type&0x0F) == 0x08)
    Invaild_Va = 0x00;
  else if((Type&0x0F) == 0x09)
    Invaild_Va = 0xFF;
  else if((Type&0x0F) == 0x0A)
    Invaild_Va = 0xAA;
  
  if((Type&0x0F) == 5 ) // 实现发送过程中高压
  {
    int Time;
    Time = _Set_Battery(19);
    if(Time == 0)
      testWaitForTimeout(H_Battery_Time*1.1);
  }
  else if((Type&0x0F) == 6) // 实现发送过程中低压
  {
    int Time;
    Time = _Set_Battery(7);
    if(Time == 0)
      testWaitForTimeout(L_Battery_Time*1.1);
  }
  
  if(Geely_Architecture == 4 )
  {
    Send_CCP_Count = 0; Send_ExtCCP_Count = 0;
    Max_Frame = _max(Blocksize[0],Blocksize[1]);
    CCPMsg.byte(UB_FlagePos) = 0xC0;  //将UB位置设置为有效 
    for(i=0;i<Max_Frame;i++)
    {
      initCCP();
      if(Send_CCP_Count<Blocksize[0])
      {
        OutPut_CCP_Specify(0,Type,Blockid[0][i],Lost_Msg_ID,Invalid_CCP_ID,Invaild_Va);
        Send_CCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0x7F;
      
      if(Send_ExtCCP_Count<Blocksize[1])
      {
        OutPut_CCP_Specify(1,Type,Blockid[1][i],Lost_Msg_ID,Invalid_CCP_ID,Invaild_Va);
        Send_ExtCCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0xBF;
      
      if((Type == 1) && (CCPMsg.byte(0 + Off_Set_CCP) == Lost_Msg_ID)) // 实现不发送完整的VCP信号
      {
        _WriteEx_and_Report("","缺失BlockID为0x%02X的Msg",Lost_Msg_ID);
        continue;
      }
      else if(((Type&0x0F) == 4) && (CCPMsg.byte(0 + Off_Set_CCP) == Lost_Msg_ID)) // 实现发送过程中断电
      {
        _K30_OFF();
        testWaitForTimeout(1000);
      }
      output(CCPMsg);
      testWaitForTimeout(125);
    }
    if(Type == 2)
      _Sort_InPut_Arry(Send_Invaild_CCP,Send_Invaild_CCP_Count,elcount(Send_Invaild_CCP));
  }
  else
  {
    for(i=0;i<Blocksize[0];i++)
    { 
      initCCP();
      CCPMsg.id=0x250;
      OutPut_CCP_Specify(0,Type,Blockid[0][i],Lost_Msg_ID,Invalid_CCP_ID,Invaild_Va);
      if((Type == 1) && (CCPMsg.byte(0) == Lost_Msg_ID)) // 实现不发送完整的VCP信号
      {
        _WriteEx_and_Report("","缺失BlockID为0x%02X的Msg",Lost_Msg_ID);
        continue;
      }
      else if(((Type&0x0F) == 4) && (CCPMsg.byte(0) == Lost_Msg_ID)) // 实现发送过程中断电
      {
        _K30_OFF();
        testWaitForTimeout(1000);
      }
      output(CCPMsg);
      testWaitForTimeout(125);
    }
    for(i=0;i<Blocksize[1];i++)
    { 
      initCCP();
      CCPMsg.id=0x3F7;
      OutPut_CCP_Specify(1,Type,Blockid[1][i],Lost_Msg_ID,Invalid_CCP_ID,Invaild_Va);
      output(CCPMsg);
      testWaitForTimeout(125);
    }
  }
  if((Type&0x0F) == 4) // 实现发送过程中断电恢复
  {
    _K30_ON();
    testWaitForTimeout(1000);
  }  
  else if(((Type&0x0F) == 5) || ((Type&0x0F) == 6)) // 实现发送过程中电压恢复
    _Set_Battery(12);
}

/*
    指定CCP_ID数组进行丢失或无效
    CCP_Set[0]：装载丢失CCP号
    CCP_Set[1]：装载无效CCP号
    Lost_Len：共丢失CCP个数
    Invalid_Len：共无效CCP个数
    Type = 0：无效值均采用随机值
    Type = 1：无效值使用Invalid_Set值
*/
Sendccp(dword CCP_Set[][],byte Lost_Len,byte Invalid_Len,byte Type,dword Invalid_Set[])
{
  int i,j,n;
  byte CCP_Pos_;
  dword Invaild_Va;
  int Flage_Send;
  
  Send_Invaild_CCP_Count = 0;
  Init_For_BlockID();
  if(Geely_Architecture == 4)
  {
    Send_CCP_Count = 0; Send_ExtCCP_Count = 0;
    Max_Frame = _max(Blocksize[0],Blocksize[1]);
    CCPMsg.byte(UB_FlagePos) = 0xC0;  //将UB位置设置为有效 
    for(i=0;i<Max_Frame;i++)
    {
      initCCP();
      Flage_Send = 1;
      if(Send_CCP_Count<Blocksize[0])
      {
        CCPMsg.byte(0 + Off_Set_CCP)= Blockid[0][i];
        for(j=0;j<ccpNumscount;j++)
        { 
          if((Blockid[0][i]==(int)((ccpNums[j] + 6) / 7)) && (ccpNums[j]<=504))
          {
            CCP_Pos_ = (ccpNums[j] - (((int)((ccpNums[j] + 6) / 7)) * 7 - 6) + 1) + Off_Set_CCP;
            CCPMsg.byte(CCP_Pos_) = defaultValue(ccpNums[j]);
            for(n=0;n<Invalid_Len;n++)
            {
              if(ccpNums[j] == CCP_Set[1][n])
              {
                Invaild_Va = (Type == 0) ? InValid_Value(ccpNums[j]) : Invalid_Set[n];
                CCPMsg.byte(CCP_Pos_) = Invaild_Va;
                if(_Check_Dword_in_Num(Invaild_Va,Value_All[ccpNums[j]],CCPlen(ccpNums[j]))== -1)
                {
                  writeEx(-3,0,"无效CCP_%d为BlockID：%d的Byte_%d,无效值为0x%02X",ccpNums[j],Blockid[0][i],CCP_Pos_,Invaild_Va);
                  Send_Invaild_CCP[Send_Invaild_CCP_Count][0] = ccpNums[j];
                  Send_Invaild_CCP[Send_Invaild_CCP_Count][1] = Invaild_Va;
                  Send_Invaild_CCP_Count++;
                }
              }
            }
          }
        }
        Send_CCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0x7F; 
      
      if(Send_ExtCCP_Count<Blocksize[1])
      {
        CCPMsg.byte(0 + Off_Set_ExtCCP)= Blockid[1][i];
        for(j=0;j<ccpNumscount;j++)
        { 
          if((Blockid[1][i]==(int)((ccpNums[j] - 504 + 6) / 7)) && (ccpNums[j]>504))
          {
            CCP_Pos_ = (ccpNums[j] -504- (((int)((ccpNums[j] - 504 + 6) / 7)) * 7 - 6) + 1) + Off_Set_ExtCCP;
            CCPMsg.byte(CCP_Pos_) = defaultValue(ccpNums[j]);
            for(n=0;n<Invalid_Len;n++)
            {
              if(ccpNums[j] == CCP_Set[1][n])
              {
                Invaild_Va = (Type == 0) ? InValid_Value(ccpNums[j]) : Invalid_Set[n];
                CCPMsg.byte(CCP_Pos_) = Invaild_Va;
                if(_Check_Dword_in_Num(Invaild_Va,Value_All[ccpNums[j]],CCPlen(ccpNums[j]))== -1)
                {
                  writeEx(-3,0,"无效CCP_%d为BlockID：%d的Byte_%d,无效值为0x%02X",ccpNums[j],Blockid[0][i],CCP_Pos_,Invaild_Va);
                  Send_Invaild_CCP[Send_Invaild_CCP_Count][0] = ccpNums[j];
                  Send_Invaild_CCP[Send_Invaild_CCP_Count][1] = Invaild_Va;
                  Send_Invaild_CCP_Count++;
                }
              }
            }
          }
        }
        Send_ExtCCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0xBF; 
      
      for(j=0;j<Lost_Len;j++)
      {
        int CCP_Calculate;
        if(CCP_Set[0][j] <= 504)
        {
          CCP_Calculate  = (int)((CCP_Set[0][j] + 6) / 7);
          if(Blockid[0][i] == CCP_Calculate)
          {
            Flage_Send = 0;
            _WriteEx_and_Report("","缺失BlockID为0x%02X的Msg",CCP_Calculate);
            break;
          }
        }
        else if(CCP_Set[0][j] > 504)
        {
          CCP_Calculate  = (int)((CCP_Set[0][j] - 504 + 6) / 7);
          if(Blockid[1][i] == CCP_Calculate)
          {
            Flage_Send = 0;
            _WriteEx_and_Report("","缺失BlockID为0x%02X的Msg",CCP_Calculate);
            break;
          }
        }
      }
      if(Flage_Send == 1)
      {
        output(CCPMsg);
        testWaitForTimeout(125);
      }
      else
        testWaitForTimeout(20);
    }
  }
  else
  {
    for(i=0;i<Blocksize[0];i++)
    { 
      initCCP();
      CCPMsg.id=0x250;
      CCPMsg.byte(0)= Blockid[0][i];
      Flage_Send = 1;
      for(j=0;j<ccpNumscount;j++)
      { 
        if((Blockid[0][i]==(int)((ccpNums[j] + 6) / 7)) && (ccpNums[j]<=504))
        {
          CCP_Pos_ = (ccpNums[j] - (((int)((ccpNums[j] + 6) / 7)) * 7 - 6) + 1) + Off_Set_CCP;
          CCPMsg.byte(CCP_Pos_) = defaultValue(ccpNums[j]);
          for(n=0;n<Invalid_Len;n++)
          {
            if(ccpNums[j] == CCP_Set[1][n])
            {
              Invaild_Va = (Type == 0) ? InValid_Value(ccpNums[j]) : Invalid_Set[n];
              
              CCPMsg.byte(CCP_Pos_) = Invaild_Va;
              if(_Check_Dword_in_Num(Invaild_Va,Value_All[ccpNums[j]],CCPlen(ccpNums[j]))== -1)
              {
                writeEx(-3,0,"无效CCP_%d为BlockID：%d的Byte_%d,无效值为0x%02X",ccpNums[j],Blockid[0][i],CCP_Pos_,Invaild_Va);
                Send_Invaild_CCP[Send_Invaild_CCP_Count][0] = ccpNums[j];
                Send_Invaild_CCP[Send_Invaild_CCP_Count][1] = Invaild_Va;
                Send_Invaild_CCP_Count++;
              }
            }
          }
        }
      }
      for(j=0;j<Lost_Len;j++)
      {
        int CCP_Calculate;
        if(CCP_Set[0][j] <= 504)
        {
          CCP_Calculate  = (int)((CCP_Set[0][j] + 6) / 7);
          if(Blockid[0][i] == CCP_Calculate)
          {
            Flage_Send = 0;
            _WriteEx_and_Report("","缺失BlockID为0x%02X的Msg",CCP_Calculate);
            break;
          }
        }
      }
      if(Flage_Send == 1)
      {
        output(CCPMsg);
        testWaitForTimeout(125);
      }
      else
        testWaitForTimeout(20);
    }
    for(i=0;i<Blocksize[1];i++)
    { 
      initCCP();
      CCPMsg.id=0x3F7;
      CCPMsg.byte(0)= Blockid[1][i];
      for(j=0;j<ccpNumscount;j++)
      { 
        if((Blockid[1][i]==(int)((ccpNums[j] - 504 + 6) / 7)) && (ccpNums[j]>504))
        {
          CCP_Pos_ = (ccpNums[j] -504- (((int)((ccpNums[j] - 504 + 6) / 7)) * 7 - 6) + 1) + Off_Set_ExtCCP;
          CCPMsg.byte(CCP_Pos_) = defaultValue(ccpNums[j]);
          for(n=0;n<Invalid_Len;n++)
          {
            if(ccpNums[j] == CCP_Set[1][n])
            {
              Invaild_Va = (Type == 0) ? InValid_Value(ccpNums[j]) : Invalid_Set[n];
              CCPMsg.byte(CCP_Pos_) = Invaild_Va;
              if(_Check_Dword_in_Num(Invaild_Va,Value_All[ccpNums[j]],CCPlen(ccpNums[j]))== -1)
              {
                writeEx(-3,0,"无效CCP_%d为BlockID：%d的Byte_%d,无效值为0x%02X",ccpNums[j],Blockid[0][i],CCP_Pos_,Invaild_Va);
                Send_Invaild_CCP[Send_Invaild_CCP_Count][0] = ccpNums[j];
                Send_Invaild_CCP[Send_Invaild_CCP_Count][1] = Invaild_Va;
                Send_Invaild_CCP_Count++;
              }
            }
          }
        }
      }
      for(j=0;j<Lost_Len;j++)
      {
        int CCP_Calculate;
        if(CCP_Set[0][j] > 504)
        {
          CCP_Calculate  = (int)((CCP_Set[0][j]-504 + 6) / 7);
          if(Blockid[0][i] == CCP_Calculate)
          {
            Flage_Send = 0;
            _WriteEx_and_Report("","缺失BlockID为0x%02X的Msg",CCP_Calculate);
            break;
          }
        }
      }
      if(Flage_Send == 1)
      {
        output(CCPMsg);
        testWaitForTimeout(125);
      }
      else
        testWaitForTimeout(20);
    }
  }
}

/*
    指定CCP_ID发送指定值
*/
Sendccp(word CCPid,byte Value)
{
  int i,j;
  
  Init_For_BlockID();
  
  Send_CCP_Count = 0; Send_ExtCCP_Count = 0;
  if(Geely_Architecture == 4)
  {
    Max_Frame = _max(Blocksize[0],Blocksize[1]);
    CCPMsg.byte(UB_FlagePos) = 0xC0;  //将UB位置设置为有效 
    for(i=0;i<Max_Frame;i++)
    {
      initCCP();
      if(Send_CCP_Count<Blocksize[0])
      {
        OutPut_CCP_Specify(0,Blockid,i,CCPid,Value);
        Send_CCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0x7F; 
      
      if(Send_ExtCCP_Count<Blocksize[1])
      {
        OutPut_CCP_Specify(1,Blockid,i,CCPid,Value);
        Send_ExtCCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0xBF; 
      output(CCPMsg);
      testWaitForTimeout(125);
    }
  }
  else
  {
    for(i=0;i<Blocksize[0];i++)
    { 
      initCCP();
      CCPMsg.id=0x250;
      OutPut_CCP_Specify(0,Blockid,i,CCPid,Value);
      output(CCPMsg);
      testWaitForTimeout(125);
    }
    for(i=0;i<Blocksize[1];i++)
    { 
      initCCP();
      CCPMsg.id=0x3F7;
      OutPut_CCP_Specify(1,Blockid,i,CCPid,Value);
      output(CCPMsg);
      testWaitForTimeout(125);
    }
  }
}

/*
    指定CCP_ID范围发送指定值
*/
Sendccp(dword CCPid[],byte Value[],int Len)
{
  int i,j;
  Init_For_BlockID();
  Send_CCP_Count = 0; Send_ExtCCP_Count = 0;
  if(Geely_Architecture == 4)
  {
    Max_Frame = _max(Blocksize[0],Blocksize[1]);
    CCPMsg.byte(UB_FlagePos) = 0xC0;  //将UB位置设置为有效 
    for(i=0;i<Max_Frame;i++)
    {
      initCCP();
      if(Send_CCP_Count<Blocksize[0])
      {
        OutPut_CCP_Specify(0,Blockid,i,CCPid,Value,Len);
        Send_CCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0x7F; 
      
      if(Send_ExtCCP_Count<Blocksize[1])
      {
        OutPut_CCP_Specify(1,Blockid,i,CCPid,Value,Len);
        Send_ExtCCP_Count++;
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0xBF; 
      output(CCPMsg);
      testWaitForTimeout(125);
    }
  }
  else
  {
    for(i=0;i<Blocksize[0];i++)
    { 
      initCCP();
      CCPMsg.id=0x250;
      OutPut_CCP_Specify(0,Blockid,i,CCPid,Value,Len);
      output(CCPMsg);
      testWaitForTimeout(125);
    }
    for(i=0;i<Blocksize[1];i++)
    { 
      initCCP();
      CCPMsg.id=0x3F7;
      OutPut_CCP_Specify(1,Blockid,i,CCPid,Value,Len);
      output(CCPMsg);
      testWaitForTimeout(125);
    }
  }
}

/*
    乱序发送全部CCP
    Type == 0：乱序发送默认值
    Type == 1：发送无效值
    Type == 2：发送无效值(仅10个，且0x250/0x3F7中均存在部分)
    Type == 3：发送无效值(大于10个，且0x250/0x3F7中均存在部分)
*/
SendccpRandom(byte Type)
{
  int i;
  dword Save_Msg[100][2];   //[byte0,MsgID]
  dword OutPut_Msg[100][2]; //[byte0,MsgID]
  byte BlocksizeCCP[30],BlocksizeExtCCP[30];
  byte All_Len;
  int All_Count,Count_250,Count_3F7,min_0x3F7;
  int Random_Count,All_Count_250,All_Count_3F7;
  dword InValid_CCP_ExSend[30];
  
  snprintf(Str_OutPut_InValidCCP,elCount(Str_OutPut_InValidCCP),"无效CCP数据:");
  Init_For_BlockID();
  All_Len = 0;
  for(i=0;i<Blocksize[0];i++)
  {
    Save_Msg[i][0] = Blockid[0][i];
    Save_Msg[i][1] = 0x250;
    All_Len++;
  }
  for(i=0;i<Blocksize[1];i++)
  {
    Save_Msg[Blocksize[0] + i][0] = Blockid[1][i];
    Save_Msg[Blocksize[0] + i][1] = 0x3F7;
    All_Len++;
  }//装载全部数据的byte0以及ID
  if(Type == 2 || Type == 3)
  {
    if(Type == 2)
      All_Count = Max_Invaild_CCP_Count;
    else if(Type == 3)
    {
      do{
        All_Count = random(ccpNumscount);
      }while(All_Count<Max_Invaild_CCP_Count+2 || All_Count>(ccpNumscount-3));
    }
    Random_Count = 0;
    All_Count_250 = 0;
    All_Count_3F7 = 0;
    min_0x3F7 = Blocksize[1];
    if(min_0x3F7>2)
      min_0x3F7 = 2;
    for(i=0;i<ccpNumscount;i++)
    {
      if(ccpNums[i]<504)
        All_Count_250++;
      else
        All_Count_3F7++;
    }
    do{
      Count_250 = random(All_Count_250);
      Count_3F7 = All_Count - Count_250;
    }while(Count_3F7 < min_0x3F7 || Count_3F7 > Blocksize[1]);
    writeEx(-3,0,"当前无效ID为0x250的CCP个数为%d,0x3F7无效个数为%d",Count_250,Count_3F7);
    teststep("","当前无效ID为0x250的CCP个数为%d,0x3F7无效个数为%d",Count_250,Count_3F7);
    for(i=0;i<Count_250;i++)
    {
      do{
        InValid_CCP_ExSend[Random_Count] = ccpNums[random(All_Count_250)];
      }while(_Check_Dword_in_Num(InValid_CCP_ExSend[Random_Count],InValid_CCP_ExSend,Random_Count) != -1);
      Random_Count++;
    }
    for(i=0;i<Count_3F7;i++)
    {
      int Num;
      do{
        Num = random(ccpNumscount);
        InValid_CCP_ExSend[Random_Count] = ccpNums[Num];
      }while(_Check_Dword_in_Num(InValid_CCP_ExSend[Random_Count],InValid_CCP_ExSend,Random_Count) != -1 || Num<All_Count_250);
      Random_Count++;
    }
  }
  if(Geely_Architecture == 4)
  {
    Max_Frame = _max(Blocksize[0],Blocksize[1]);
    _Shuffle_And_Load_Msg(Max_Frame,Blockid[0],BlocksizeCCP);
    _Shuffle_And_Load_Msg(Max_Frame,Blockid[1],BlocksizeExtCCP);
    Send_CCP_Count = 0; Send_ExtCCP_Count = 0;
    CCPMsg.byte(UB_FlagePos) = 0xC0;  //将UB位置设置为有效 
    for(i=0;i<Max_Frame;i++)
    {
      initCCP();
      if(Send_CCP_Count<Blocksize[0] && (BlocksizeCCP[i] != 0))
      {
        CCPMsg.byte(0 + Off_Set_CCP) = BlocksizeCCP[i];
        OutPut_CCP_Specify(0,Type,BlocksizeCCP[i],InValid_CCP_ExSend,Random_Count);
        Send_CCP_Count++;
        CCPMsg.byte(UB_FlagePos) |= 0x80; 
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0x7F; 
      
      if(Send_ExtCCP_Count<Blocksize[1] && (BlocksizeExtCCP[i] != 0))
      {
        CCPMsg.byte(0 + Off_Set_ExtCCP) = BlocksizeExtCCP[i];
        OutPut_CCP_Specify(1,Type,BlocksizeExtCCP[i],InValid_CCP_ExSend,Random_Count);
        Send_ExtCCP_Count++;
        CCPMsg.byte(UB_FlagePos) |= 0x40; 
      }
      else
        CCPMsg.byte(UB_FlagePos) &= 0xBF; 
      
      output(CCPMsg);
      testWaitForTimeout(125);
    }
  }
  else
  {
    _Shuffle_And_Load_Msg(All_Len,Save_Msg,OutPut_Msg);
    for(i=0;i<All_Len;i++)
    {
      initCCP();
      CCPMsg.id=OutPut_Msg[i][1];
      CCPMsg.byte(0)= OutPut_Msg[i][0];
      if(OutPut_Msg[i][1] == 0x250)
        OutPut_CCP_Specify(0,Type,OutPut_Msg[i][0],InValid_CCP_ExSend,Random_Count);
      else
        OutPut_CCP_Specify(1,Type,OutPut_Msg[i][0],InValid_CCP_ExSend,Random_Count);
      output(CCPMsg);
      testWaitForTimeout(125);
    }
  }
  if(Type == 2 || Type == 3)
  {
    writeEx(-3,0,"%s",Str_OutPut_InValidCCP);
    testStep("",Str_OutPut_InValidCCP);
  }
}

/*
    获取对应CCP的默认值
*/
byte defaultValue(word ccpNum)
{
  byte value;
  int ii ;
  for(ii=0;ii<elcount(defaultValue[0]);ii++)
  { 
    if(ccpNum==defaultValue[0][ii])
    {
      value=defaultValue[1][ii];
      break;
    }
  }
  return value;
}
/*
    获取对应CCP的随机无效值
*/
byte InValid_Value(word ccpNum)
{
  
  byte value;
  do{
    value = random(0xFF+1);
  }while(_Check_Dword_in_Num(value,Value_All[ccpNum],CCPlen(ccpNum))!= -1);
  
  return value;
}

SetdefaultValue(word ccpNum[][])
{
  int i,ii ;
  for(i=0;i<elcount(ccpNum);i++)
  {
    for(ii=0;ii<elcount(defaultValue[0]);ii++)
    {
      if(ccpNum[i][0]==defaultValue[0][ii])
      {
         defaultValue[1][ii]=ccpNum[i][1];
        break;
      }
    }
  }
}


