_Check_RCS(byte type) /*0:不转动，无变化   1：存在角度变化*/
{
  float Angle_1;
  testStep("","检测遥控驾驶");
  writeEx(-3,0,"检测遥控驾驶");
  Angle_1 = _Get_Ang_Now();    
  _Active_RCS();
  _set_0x299_RemoteCtrCommand(7);
  testWaitForTimeout(500);
  _set_0x299_RemoteCtrCommand(0);
  _Close_RCS();
  _Check_AngChange(Angle_1,_Get_Ang_Now(),type);
  _Return_Ang();
}
_Check_SFS(byte type)
{
  int Tmep_Value;
  int Tmep_Value_2;
  testStep("","检测多助力模式");
  writeEx(-3,0,"检测多助力模式");
  Tmep_Value = _get_0x24C_SteeringMode();
  writeEx(-3,0,"操作前当前模式为  %d",Tmep_Value);
  if(Tmep_Value==1)
    _set_0x4E3_SteeringMode(3);
  else
    _set_0x4E3_SteeringMode(1);
  testWaitForTimeout(1000*1.5);
  Tmep_Value_2 = _get_0x24C_SteeringMode();
  writeEx(-3,0,"操作后当前模式为  %d",Tmep_Value_2);
  if(type==0)
  {
    if(Tmep_Value_2==Tmep_Value)
      _testStepPass("SFS","当前助力模式与预期一致,无变化");
    else
      _testStepFail("SFS","预期助力模式无变化,实测助力模式发生改变");
  }
  else
  {
    if(Tmep_Value_2==Tmep_Value)
      _testStepFail("SFS","预期助力模式发生改变,实测无变化");
    else
      _testStepPass("SFS","当前助力模式与预期一致,发生改变");
  }
}
_Check_ATS(byte type)
{
  int Tmep_Value,Tmep_Value_2;
  int Tmep_Value_3,Tmep_Value_4;
  testStep("","检测全地形模式");
  writeEx(-3,0,"检测全地形模式");
  Tmep_Value = _get_0x24C_SteeringMode();
  Tmep_Value_2 = _get_0x24C_AllowForSteeringMode();
  writeEx(-3,0,"操作前当前模式为  %d",Tmep_Value);
  writeEx(-3,0,"操作前是否允许设置标志位为  %d",Tmep_Value_2);
  if(Tmep_Value==1)
    _set_0x240_ActRoadMode(3);
  else
    _set_0x240_ActRoadMode(4);
  testWaitForTimeout(1000*1.5);
  Tmep_Value_3 = _get_0x24C_SteeringMode();
  Tmep_Value_4 = _get_0x24C_AllowForSteeringMode();
  writeEx(-3,0,"操作后当前模式为  %d",Tmep_Value_3);
  writeEx(-3,0,"操作后是否允许设置标志位为  %d",Tmep_Value_4);
  if(type==0)
  {
    if(Tmep_Value_3==Tmep_Value && Tmep_Value_2 == Tmep_Value_4)
      _testStepPass("ATS","当前助力模式与预期一致,无变化");
    else if(Tmep_Value_3!=Tmep_Value && Tmep_Value_2 != Tmep_Value_4)
      _testStepFail("ATS","预期助力模式无变化,实测助力模式发生改变");
    else if(Tmep_Value_3!=Tmep_Value && Tmep_Value_2 == Tmep_Value_4)
      _testStepFail("ATS","助力手感发生改变,但禁止切换标志位保持未变");
    else
      _testStepFail("ATS","助力手感未发生改变,但禁止切换标志位被改变");
  }
  else
  {
    if(Tmep_Value_3==Tmep_Value && Tmep_Value_2 == Tmep_Value_4)
      _testStepFail("ATS","预期助力模式发生改变,实测无变化");
    else if(Tmep_Value_3!=Tmep_Value && Tmep_Value_2 != Tmep_Value_4)
      _testStepPass("ATS","当前助力模式与预期一致,发生改变");
    else if(Tmep_Value_3!=Tmep_Value && Tmep_Value_2 == Tmep_Value_4)
      _testStepFail("ATS","助力手感发生改变,但禁止切换标志位保持未变");
    else
      _testStepFail("ATS","助力手感未发生改变,但禁止切换标志位被改变");
  }
  _set_0x240_ActRoadMode(1);
  testWaitForTimeout(100);
}
_Check_DST(byte type)
{
  float Angle_1;
  testStep("","检测DST控制状态");
  writeEx(-3,0,"检测DST控制状态");
  testWaitForTimeout(2000);
  Angle_1 = _Get_Ang_Now();
  _Active_DST();
  _Check_AngChange(Angle_1,_Get_Ang_Now(),type);
  if(type==1)
  {
    if(testWaitForSignalMatch(x27F_EPS_DST_Control_status,2,500)==1)/*DST激活后状态位为2*/
      _testStepPass("DST","DST激活后状态机变为激活状态");
    else
      _testStepFail("DST","DST激活后状态机外发异常");
    if(testWaitForSignalMatch(x27F_EPS_DST_Value_VD,1,500)==1)/*DST激活后输出值有效状态为1*/
      _testStepPass("DST","DST激活后输出值有效状态与期望一致保持为1");
    else
      _testStepFail("DST","DST激活后输出值有效状态异常");
  }
  _Close_DST();
  _Return_Ang();
}
_Check_APA(byte type)
{
  float Angle_1;
  testStep("","检测APA状态");
  writeEx(-3,0,"检测APA状态");
  _Active_APA();
  Angle_1  =_Get_Ang_Now();
  _Ang_Step_Increase(x134_APA_Tar_StrAgl,Angle_1+10);
  _Check_AngChange(Angle_1,_Get_Ang_Now(),type);
  if(type==1)
  {
    if(testWaitForSignalMatch(x135_EPS_APA_CtrlStas,2,500)==1)/*APA激活后状态机为2*/
      _testStepPass("APA","APA激活后状态机外发Active");
    else
      _testStepFail("APA","APA激活后状态机外发状态异常");
    _Ang_Step_Increase(x134_APA_Tar_StrAgl,0);
  }
  _Ang_Step_Increase(x134_APA_Tar_StrAgl,0);
  _Close_APA();
  _Return_Ang();
}
