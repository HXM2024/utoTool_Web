void _set_0x240_ActRoadMode(word value)
{
  @EV_x240_Actual_road_pattern = value;
  $x240_Actual_road_pattern = value;
  testStep("操作","_set_0x240_ActRoadMode:%d",value);
  testWaitForTimeout(@Cycle_240*3);
}
void _set_0x4E3_SteeringMode(word value)
{
  _set_0x4E3_Switch(1);
  @EV_x4E3_Steering_mode_Settings2 = value;
  $x4E3_Steering_mode_Settings2 = value;
  testStep("操作","_set_0x4E3_SteeringMode:%d",value);
  testWaitForTimeout(@Cycle_4E3*3);
  _set_0x4E3_Switch(0);                                   //事件型报文，触发3帧后停发   
  @EV_x4E3_Steering_mode_Settings2 = 0;
  $x4E3_Steering_mode_Settings2 = 0;
}
void _set_0x4E3_Switch(word value)
{
  @Switch_4E3 = value;
  testStep("操作","_set_0x4E3_Switch:%d",value);
}
