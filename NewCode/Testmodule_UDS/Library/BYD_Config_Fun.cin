float _Get_Ang_Now()
{
  float Ang;
  Ang = $x11F_LWS_ANGLE;
  return Ang;
}

void _Check_AngChange(float Ang_1,float Ang_2,byte type)/*type=0:期望角度无变化  type=1:期望角度存在变化*/
{
  float Ang_Change;
  Ang_Change = abs(Ang_2 - Ang_1);
  
  if(type==0)
  {
    writeEx(-3,0,"期望  功能未激活，角度  无变化");
    if(Ang_Change<=1)
      _testStepPass("","期望角度无变化,实测角度无变化");
    else
      _testStepFail("","期望角度无变化,实测角度变化值大于1°");
  }
  else
  {
    writeEx(-3,0,"期望  功能能够激活，角度  存在变化");
    if(Ang_Change<=2)
      _testStepFail("","期望角度存在变化,实测角度无变化");
    else if(Ang_Change>=5)
      _testStepPass("","期望角度存在变化,实测角度变化值大于5°");
    else
      _testStepPass("","期望角度存在变化,实测角度变化值较小,在5°以内");
  }
}

_testStepPass(char Str1[],char Str2[])
{
  testStepPass(Str1,Str2);
  writeEx(-3,0,"%s  %s",Str1,Str2);
}
_testStepFail(char Str1[],char Str2[])
{
  testStepFail(Str1,Str2);
  writeEx(-3,0,"%s  %s",Str1,Str2);
}
