      _testStepPass("LKA_Ang","角度控制车道保持调用独立曲线成功");
    else
      _testStepFail("LKA_Ang","角度控制车道保持未调用独立曲线");
    if(testWaitForSignalMatch(x1FC_EPSAngleCtrlSt_S,2,500)==1)/*LKA激活后状态机为2*/
      _testStepPass("LKA_Ang","LKA激活后状态机外发Active");
    else
      _testStepFail("LKA_Ang","LKA激活后状态机外发状态异常");
  }
  _Ang_Step_Increase(x1E2_ADAS_ECU_AngleReq,0);
  _Close_ADAS_LKA_Ang();
  _Return_Ang();
}
