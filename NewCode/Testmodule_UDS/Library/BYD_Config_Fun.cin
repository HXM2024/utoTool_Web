void _set_0x410_EnterRemoteCtr(word value)
{
  @EV_x410_Remote_driving_condition = value;
  $x410_Remote_driving_condition = value;
  testStep("操作","_set_0x410_EnterRemoteCtr:%d",value);
}
void _set_0x35C_GearState(word value)
{
  @EV_x35C_Gear_recognition = value;
  $x35C_Gear_recognition = value;
  testStep("操作","_set_0x35C_GearState:%d",value);
}
void _set_0x299_RemoteCtrCommand(word value)
{
  @EV_x299_Remote_control_command = value;
  $x299_Remote_control_command = value;
  testStep("操作","_set_0x299_RemoteCtrCommand:%d",value);
