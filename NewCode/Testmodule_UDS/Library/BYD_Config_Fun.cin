_Check_ADS_LDW(byte type)
{
  testStep("","检测高阶LDW");
  writeEx(-3,0,"检测高阶LDW");
  $x57_ADS_LdwWarningCmdVld = 1;
  testWaitForTimeout(20);
  $x57_ADS_LdwWarningCmd = 1;
  testWaitForTimeout(10);
  if(type==1 && LDW==1)
  {
    if(testWaitForSignalInRange(x6D_EPS_LdwWarnSts,1,2,500)==1)
      _testStepPass("高阶LDW","期望高阶LDW生效,实测LDW外发状态正常");
    else
      _testStepFail("高阶LDW","期望高阶LDW生效,实测外发状态异常");
  }
  else
  {
    if(testWaitForSignalInRange(x6D_EPS_LdwWarnSts,1,2,500)==1)
      _testStepFail("高阶LDW","期望高阶LDW不生效,实测LDW外发状态正常");
    else
      _testStepPass("高阶LDW","期望高阶LDW不生效,实测外发状态异常");
  }
  $x57_ADS_LdwWarningCmd = 0;
  testWaitForTimeout(500);
}
_Ang_Step_Increase(Signal *sg,int Ang_Target)
{
  float Ang_Now;
  int k;
  Ang_Now  =_Get_Ang_Now();
  if(Ang_Target>=Ang_Now)
  {
    for(k=(int)Ang_Now;k<=Ang_Target;k++)
    {
      setSignal(sg,k);
      testWaitForTimeout(20);
    }
  }
  else
  {
    for(k=(int)Ang_Now;k>=Ang_Target;k--)
    {
      setSignal(sg,k);
      testWaitForTimeout(20);
    } 
  }
}




_Return_Ang()
{
  testStep("回正","-----角度回正-----");
  _Set_Ready(Struct_Ready.Ready_Active);
  if(abs(_Get_Ang_Now())<=3) 
    return;
  else
  {
    _Set_CarSpd(5);
    testWaitForTimeout(2000);
    _Set_CarSpd(0);
  }
}
_BYD_unlockECU()
{
  _unlockECU();
}
_Check_DTC(qword DTC)
{
//  TestStep_ReadDTC("获取DTC",DTC,1,0,1,1);
  _85_Check_DTC(1,DTC);
}
_Check_DTC_Som(dword expDTC[])
{
  byte expStatus[20];
  int k;
  for(k=0;k<elcount(expDTC);k++)
    expStatus[k]=0x00;
  TestStep_Read_Multi_DTC("获取DTC",expDTC,expStatus,1,0);
}
_Check_DTC_Som_(dword expDTC_[],dword Count_)
{
  dword ReSize;
  dword DTC_Rx[100],DTC_Rx_Count;
  dword DTC_UnEx[100],DTC_UnEx_Count;
  dword expDTC[100],Count;
  int i,j,Temp_Flag;
  Count = 0;
  DTC_Rx_Count = 0;
  for(i=0;i<Count_;i++)
  {
    if(expDTC_[i] != 0 )
    {
      expDTC[Count] = expDTC_[i] ;
      Count++;
    }
  }
  DTC_UnEx_Count = 0;
  Temp_Flag = 0;
  _Send_01_Fault(@DID::phyreq_ID);
  ReSize = DiagGetRespPrimitiveSize(Diag01);
  DTC_Rx_Count = (ReSize-3)/4;
  for(i=0;i<DTC_Rx_Count;i++)
    DTC_Rx[i] = (diagGetRespPrimitiveByte(Diag01,i*4+3)<<16) | (diagGetRespPrimitiveByte(Diag01,i*4+4)<<8) | (diagGetRespPrimitiveByte(Diag01,i*4+5));
  for(i=0;i<Count;i++)
  {
    j = _Check_Dword_in_Num(expDTC[i],DTC_Rx,DTC_Rx_Count);
    if(j==-1)
    {
      Temp_Flag = -1;
      testStepFail("","期望 0x%06X DTC ,未报出",expDTC[i]);
    }
  }
  for(i=0;i<DTC_Rx_Count;i++)
  {
    j = _Check_Dword_in_Num(DTC_Rx[i],expDTC,Count);
    if(j==-1)
    {
      DTC_UnEx[DTC_UnEx_Count] = DTC_Rx[i];
      DTC_UnEx_Count++;
    }
  }
  if(DTC_UnEx_Count != 0)
  {
    for(i=0;i<DTC_UnEx_Count;i++)
    {
      j = _Check_Dword_in_Num(DTC_UnEx[i],DTC_Whitelist,DTC_UnEx_Count);
      if(j==-1)
      {
        Temp_Flag = -1;
        testStepFail("","出现非白名单中故障 0x%06X  ",DTC_UnEx[i]);
      }
    }
  }
  if(Temp_Flag == 0)
    testStepPass("","所有DTC均已获取到");
}
_Set_11_Restoration_BYD()
{  
  byte Temp[2]={0x11,0x01};
  _BYD_unlockECU();
  _Send_Diag(2,phyreq_ID,Temp);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
}
_Active_ADAS_LKA_Ang()
{
  testStep("操作","激活车道保持角度控制");
  writeEx(-3,0,"激活车道保持角度控制");
  _set_0x1E2_MotorTorque_LowerLimit(-3);
  _set_0x1E2_MotorTorque_UpperLimit(3);
  _set_0x1E2_AdasEcuAngleReqSt(0);
  testWaitForTimeout(50);
  _set_0x1E2_AdasEcuAngleReq(_Get_Ang_Now());
  _set_0x1E2_AdasEcuAngleReqSt(1);
  testWaitForTimeout(50);
  _set_0x1E2_AdasEcuAngleReqSt(2);
  testWaitForTimeout(500);
}
_Close_ADAS_LKA_Ang()
{
  _set_0x1E2_AdasEcuAngleReqSt(0);
  testWaitForTimeout(100);
}
