  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  _Init_CCP_();
  GetFunDID_Data(FunDID);
  DataCheckGreater = 1;
  for(i=0;i<FunDID_Read_CCPGroupCount;i++)
  {
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(2000);
    Sendccp(FunDID_Read_CCP[i],FunDID_Read_Vaule[i],FunDID_Read_CCPCount[i]);
    testWaitForTimeout(30000);
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
    testWaitForTimeout(2000);
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,FunDID_Read_TuningSet[i],0,0);
    _Set_Ready(0);
  }
  DataCheckGreater = 0;
}

