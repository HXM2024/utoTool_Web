void _Serve22_SigSet(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x0C};
  byte Res_Data_22[4] = {0x62,0x33,0x02,0xFF};
  byte Data_Send[6] = {0x19,0x04,0,0,0,0x20};
  byte mask;
  int Fun_DIDPos,result,DTC_Temp,SigFlage,SigFlageInvalid;
  
  Init_For_Snapshot();
  mask = 0;
  DTC_Temp = (FunDID == 0xDD0A)?1:0;
  SigFlageInvalid = 0;
  DTC_H = (DTC_19[Node_1904_Pos][1]>>16); DTC_M = (DTC_19[Node_1904_Pos][1]>>8); DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
  if(DTC_Temp == 1)
  {
    DTC_H = (Snapshot_Geely_DTC>>16); DTC_M = (Snapshot_Geely_DTC>>8); DTC_L = (Snapshot_Geely_DTC&0xFF);
  }
  Data_Send[2] = DTC_H; Data_Send[3] = DTC_M; Data_Send[4] = DTC_L;
  Send_Data_22[1] = (FunDID>>8)&0xFF; Send_Data_22[2] = (FunDID)&0xFF;
  Res_Data_22[1] = (FunDID>>8)&0xFF; Res_Data_22[2] = (FunDID)&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  if(Fun_DIDPos == -1)
  {
    _WriteEx_and_Report("","未查询到当前DID：%04X配置信息",FunDID);
    return;
  }
  _Set_Ready(0);
  _Power_Down();
  _TestDisableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(200);
  _Power_Up();
  StepByGeely3_0(0x19,1);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;

  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  if(DTC_Temp == 0)
  {
    _Close_One_Node(DTC_19[Node_1904_Pos]);
    mask = DTC_19[Node_1904_Pos][2];
  }
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,1,1);
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,0,1);
  testWaitForTimeout(1000);
  if(DTC_Temp == 0)
    _Open_One_Node(DTC_19[Node_1904_Pos]);
    
  /*超过最大值测试*/
  _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[0]);
  testWaitForTimeout(200);
  _TestEnableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(500);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,1,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  if(DTC_Temp == 0)
  {
    _Close_One_Node(DTC_19[Node_1904_Pos]);
    mask = DTC_19[Node_1904_Pos][2];
  }
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,0,1);
  testWaitForTimeout(1000);
  if(DTC_Temp == 0)
    _Open_One_Node(DTC_19[Node_1904_Pos]);
  
  /*正常值测试*/
  _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[1]);
  testWaitForTimeout(500);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,1,0,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  if(DTC_Temp == 0)
  {
    _Close_One_Node(DTC_19[Node_1904_Pos]);
    mask = DTC_19[Node_1904_Pos][2];
  }
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,DID_Function[Fun_DIDPos].Value_Set[1],0);
  testWaitForTimeout(1000);
  if(DTC_Temp == 0)
    _Open_One_Node(DTC_19[Node_1904_Pos]);
  
  /*信号无效后测试*/
  
  if(strlen(DID_Function[Fun_DIDPos].SigInvalid) > 3)
  {
    SigFlageInvalid = 1;
    _Set_Sig(DID_Function[Fun_DIDPos].SigInvalid,DID_Function[Fun_DIDPos].SigInvalidValue);
  }
  else
  {
    SigFlageInvalid = -1;
    SigFlage = _Invalid_Node(atol(DID_Function[Fun_DIDPos].Sig_From));
  }
  testWaitForTimeout(500);
  if(SigFlage == -1 && SigFlageInvalid == -1)
    _WriteEx_and_Report("","未查询到无效相关操作,跳过测试");
  else
  {
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,1,0,1);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(500);
    if(DTC_Temp == 0)
    {
      _Close_One_Node(DTC_19[Node_1904_Pos]);
      mask = DTC_19[Node_1904_Pos][2];
    }
    _Send_Diag(6,phyreq_ID,Data_Send);
    _Check_1904(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,DID_Function[Fun_DIDPos].Value_Set[1],0);
    testWaitForTimeout(1000);
    if(DTC_Temp == 0)
      _Open_One_Node(DTC_19[Node_1904_Pos]);
    if(SigFlageInvalid == 1)
      _Set_Sig(DID_Function[Fun_DIDPos].SigInvalid,DID_Function[Fun_DIDPos].SigNormalValue);
    else
      _Recover_Invalid_Node(atol(DID_Function[Fun_DIDPos].Sig_From));
    testWaitForTimeout(500);
  }

  
  /*有效值- 丢失*/
  _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[2]);
  testWaitForTimeout(10000);
  _TestDisableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(1000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,2,0,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  if(DTC_Temp == 0)
  {
    _Close_One_Node(DTC_19[Node_1904_Pos]);
    mask = DTC_19[Node_1904_Pos][2];
  }
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,DID_Function[Fun_DIDPos].Value_Set[2],0);
  testWaitForTimeout(1000);
  if(DTC_Temp == 0)
    _Open_One_Node(DTC_19[Node_1904_Pos]);
  _TestEnableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(1000);
  
  
  /*有效值- 最大值*/
  _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[3]);
  testWaitForTimeout(10000);
  _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[0]);
  testWaitForTimeout(1000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,1);
  _Clear_DTC(phyreq_ID); 
  testWaitForTimeout(500);
  if(DTC_Temp == 0)
  {
    _Close_One_Node(DTC_19[Node_1904_Pos]);
    mask = DTC_19[Node_1904_Pos][2];
  }
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,DID_Function[Fun_DIDPos].Value_Set[3],0);
  testWaitForTimeout(1000);

  if(DTC_Temp == 0)
    _Open_One_Node(DTC_19[Node_1904_Pos]);
  _Clear_DTC(phyreq_ID); 
  testWaitForTimeout(1000);
  _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[2]);
}

