                        ,0x99,0x12,0xF4,0xBA,0xE8,0xE6,0x91,0xBB,0x9C};//正确9C
  byte SendData2E[295];
  byte CleraSendData2E[295];
  byte ResData22[0x23];
  byte Data1002[2] = {0x10,0x02};
  byte Data2705[4] = {0x27,0x05,0xB1,0x8E};
  int i;
  dword Sess,Funreq;
  SendData2E[0] = 0x2E;
  CleraSendData2E[0] = 0x2E;
  ResData22[0] = 0x62;
  for(i=1;i<3;i++)
  {
    SendData2E[i] = DID_Read[i];
    ResData22[i] = DID_Read[i];
    CleraSendData2E[i] = DID_Read[i];
  }
  for(i=3;i<295;i++)
    SendData2E[i] = DID_2ED01C[i-3];
  for(i=260;i<292;i++)
    ResData22[i-260+3] = DID_2ED01C[i];
  testWaitForTesterConfirmation("此用例会优先进行擦除，当弹出第二个弹框后，使用DSA工具进行刷写，刷写完毕后点击YES进行后续操作",10000);
  _Send_Diag(2,phyreq_ID,Data1002);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
  _Send_Diag(4,phyreq_ID,Data2705);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(500);
  _Send_Diag(295,phyreq_ID,CleraSendData2E);
  _TestResult(SendData,phyreq_ID,"",-1);
  
  testWaitForTesterConfirmation("用DSA只烧录SBL(勾选不复位停留在SBL),不关闭DSA(会持续发送3E维持)，刷写完毕后点击Yes(此处等待10min)",600000);
  
  _WriteEx_and_Report("","进行写值");
  _Send_Diag(295,phyreq_ID,SendData2E);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(1000);
  _Set_11_Restoration(0);
  testWaitForTimeout(2000);
  for(i=0;i<4;i++)
  {
    if(i<2)
      Funreq = phyreq_ID;
    else
      Funreq = funreq_ID;
    if(i==0 || i == 2)
      Sess = defsession;
    else
      Sess = exsession;
    
    _SetSession(Sess);
    testWaitForTimeout(500);
    _Send_Diag(3,Funreq,DID_Read);
    _Check_Response(SendData,0x23,ResData22);
  }
  
  _Send_Diag(2,phyreq_ID,Data1002);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
  _Send_Diag(4,phyreq_ID,Data2705);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(295,phyreq_ID,CleraSendData2E);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(500);
  _SetSession(defsession);
  testWaitForTimeout(2000);
  _Send_Diag(3,Funreq,DID_Read);
  _TestResult(SendData,phyreq_ID,"",NRC22);
}
void _Serve22_11()/*22 D1 31用于Geely3.5以上平台测试*/
{
  byte Data1002[2] = {0x10,0x02};
  byte Data2705[4] = {0x27,0x05,0xB1,0x8E};
  byte CleraSendData2E[0x13];
  byte DID_Read[3] = {0x22,0xD1,0x31};
  byte Data1[16] = {0x68,0x81,0xf5,0xaf,0xf8,0xd4,0x6b,0xdd,0x71,0xad,0xe8,0x41,0xe8,0x2d,0xb3,0x24};
  byte DataWrite[19] = {0x2E,0xF1,0x09,0x68,0x81,0xf5,0xaf,0xf8,0xd4,0x6b,0xdd,0x71,0xad,0xe8,0x41,0xe8,0x2d,0xb3,0x24};
  byte DataRead[35] = {0x62,0xD1,0x31,0xa0,0x12,0x46,0xef,0x70,0xb3,0xb0,0xf0,0x77,0x4a,0x3a,0x9e,0x30,0xb6,0x0e,0xf4,0x86,0xe9,0x6e,0xc4,0x54,0x93,0x8f,0x19,0x8a,0xde,0x95,0x69,0x9a,0x7d,0x46,0xb9};
  int i;
  dword Sess,Funreq;
  
  CleraSendData2E[0] = 0x2E;CleraSendData2E[1] = 0xF1;CleraSendData2E[2] = 0x09;
  _Send_Diag(2,phyreq_ID,Data1002);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
  _Send_Diag(4,phyreq_ID,Data2705);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(500);
  _Send_Diag(0x13,phyreq_ID,CleraSendData2E);
  _TestResult(SendData,phyreq_ID,"",-1);
  
  testWaitForTesterConfirmation("用DSA只烧录SBL(勾选不复位停留在SBL),不关闭DSA(会持续发送3E维持)，刷写完毕后点击Yes(此处等待10min)",600000);
  
  _WriteEx_and_Report("","进行写值");
  _Send_Diag(0x13,phyreq_ID,DataWrite);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(1000);
  _Set_11_Restoration(0);
  testWaitForTimeout(2000);
  for(i=0;i<4;i++)
  {
    if(i<2)
      Funreq = phyreq_ID;
    else
      Funreq = funreq_ID;
    if(i==0 || i == 2)
      Sess = defsession;
    else
      Sess = exsession;
    
    _SetSession(Sess);
    testWaitForTimeout(500);
    _Send_Diag(3,Funreq,DID_Read);
    _Check_Response(SendData,35,DataRead);
  }
  _Send_Diag(2,phyreq_ID,Data1002);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
  _Send_Diag(4,phyreq_ID,Data2705);
  _TestResult(SendData,phyreq_ID,"",-1);
  for(i=3;i<0x13;i++)
    CleraSendData2E[i] = 0xFF;
  _Send_Diag(0x13,phyreq_ID,CleraSendData2E);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(500);
  _SetSession(defsession);
  testWaitForTimeout(2000);
}

void _Serve22_3017(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x30,0x17};
  byte Res_Data_22[4] = {0x62,0x30,0x17,0};
  int i,result ;
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  Res_Data_22[1] = (FunDID>>8)&0xFF;
  Res_Data_22[2] = (FunDID)&0xFF;
  for(i=0;i<Struct_Ready.Ready_ValueRange_Count;i++)
  {
    _Set_Ready(Struct_Ready.Ready_ValueRange[i]);
    testWaitForTimeout(500);
    if(Struct_Ready.Ready_ValueRange[i] == 0x0B || Struct_Ready.Ready_ValueRange[i] == 0x0D)
      Res_Data_22[3] = 2;
    else 
      Res_Data_22[3] = 1;
    
    _Send_Diag(3,ID,Send_Data_22);
    _Check_Response(SendData,elcount(Res_Data_22),Res_Data_22);
  }
  result = testWaitForTesterConfirmation("拔掉传感器线束，然后点击YES",60000);
  if(result == 1)
  {
    Res_Data_22[3] = 5;
    _Send_Diag(3,ID,Send_Data_22);
    _Check_Response(SendData,elcount(Res_Data_22),Res_Data_22);

    testWaitForTesterConfirmation("恢复传感器线束",60000);
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
  }
}
void _Serve22_3302(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x02};
  byte Res_Data_22[5] = {0x62,0x33,0x02,0xFF,0xFF};
  int Fun_DIDPos,result,i;
  Send_Data_22[1] = (FunDID>>8)&0xFF; Send_Data_22[2] = (FunDID)&0xFF;
  Res_Data_22[1] = (FunDID>>8)&0xFF; Res_Data_22[2] = (FunDID)&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  _Set_Ready(Struct_Ready.Ready_Active);
  result = testWaitForTesterConfirmation("拔掉传感器线束，然后点击YES",60000);
  if(result == 1)
  {
    _Send_Diag(3,ID,Send_Data_22);
    _Check_Response(SendData,elcount(Res_Data_22),Res_Data_22);
    testWaitForTesterConfirmation("恢复传感器线束",60000);
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
  }
  for(i=0;i<DID_Function[Fun_DIDPos].Value_Set_Count;i++)
  {
    _testWaitForTesterConfirmation("此处需人为判断，转动方向盘到角度 %.2f，然后点击YES",DID_Function[Fun_DIDPos].Value_Set[i]);
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,0,0,0,2);
  }
}

