void _Serve19_01_Geely(dword ID,byte Session) 
{
  byte Send_Data_08[3] = {0x19,0x02,0x08};
  byte Send_Data_19[6] = {0x19,0x06,0,0,0,0x02};
  byte Res[8] = {0x59,0x06,0,0,0,0x6C,0x02,0};
  int Pos,i;
  _Set_Ready(0);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(1000);
  if(Session!=defsession)
    _SetSession(Session);
  StepByGeely3_0(0x19,1);
  Pos = Get_Node_Pos(Node_1904,1);
  Send_Data_19[2] = (DTC_19[Pos][1]>>16);
  Send_Data_19[3] = (DTC_19[Pos][1]>>8);
  Send_Data_19[4] = (DTC_19[Pos][1]&0xFF);
  Res[2] = (DTC_19[Pos][1]>>16);
  Res[3] = (DTC_19[Pos][1]>>8);
  Res[4] = (DTC_19[Pos][1]&0xFF);
  _Clear_DTC(phyreq_ID);
  _Send_Diag(3,ID,Send_Data_08);
  _Check_190201(SendData,0,0);
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(3,ID,Send_Data_08);
  _Check_1902(SendData,DTC_19[Pos][1],0x2F);
  _Open_One_Node(DTC_19[Pos]);
  _Send_Diag(3,ID,Send_Data_08);
  _Check_1902(SendData,DTC_19[Pos][1],0x2E);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(6000);
  Res[7] = 0;
  StepByGeely3_0(0x19,1);
  if(Session != defsession)
    _SetSession(Session);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_Response(SendData,5,8,Res);
  _Send_Diag(3,ID,Send_Data_08);
  _Check_1902(SendData,DTC_19[Pos][1],0x2C);
  
  for(i=1;i<=257;i++)
  {
    _WriteEx_and_Report("","第 %d 次上下电",i);
    Res[7] = i;
    if(i>=255)
      Res[7] = 0xFF;
    
    _Set_Ready(0);
    _K15_OFF();
    testWaitForTimeout(2000);
    _K15_ON();
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(6000);
    if(Session != defsession)
      _SetSession(Session);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_Response(SendData,5,8,Res);
    if(i>=255)
      _Check_DTC_Res(0x08,0,DTC_19[Pos][1]);
    else
    {
      _Send_Diag(3,ID,Send_Data_08);
      _Check_1902(SendData,DTC_19[Pos][1],0x28);
    }
  }
}
void _Serve19_02_Geely(dword ID,byte Session) //故障溢出机制
{
  int i,Count;
  byte Send_Data_89[3] = {0x19,0x02,0x89};
  _Set_Ready(0);
  _Clear_DTC(phyreq_ID);
  StepByGeely3_0(0x19,1);
  Count = 0;
  for(i=0;i<DTC_19_Count;i++)
  {
    if(DTC_19[i][0] == Struct_Ready.Sig_Id) //发动机异常导致故障无法报出
      continue;
    Count++;
    _testDisableMsg(DTC_19[i][0]);
  }
  testWaitForTimeout(3000);
  _Open_All();
  testWaitForTimeout(2000);

  for(i=0;i<Node_Invalid_Count;i++)
  {
    if(Node_Invalid[i].Node == Struct_Ready.Sig_Id)
      continue;
    Count++;
    _Set_Sig(Node_Invalid[i].Signal_Name,Node_Invalid[i].Invalid_Value);
    testWaitForTimeout(Node_Invalid[i].Time*1.2);
    _Set_Sig(Node_Invalid[i].Signal_Name,Node_Invalid[i].Normal_Value);
    testWaitForTimeout(Node_Invalid[i].Time*1.2);
    // _Invalid_Node(Node_Invalid[i].Node);
  }
  // testWaitForTimeout(5000);
  _Invalid_Node(Struct_Ready.Sig_Id);
  testWaitForTimeout(2000);
  Count++;
  // for(i=0;i<Node_Invalid_Count;i++)
  //   _Recover_Invalid_Node(Node_Invalid[i].Node);
  testWaitForTimeout(6000);
  _Set_Battery(22);
  testWaitForTimeout(1000);
  _Set_Battery(8);
  testWaitForTimeout(1000);
  _Set_Battery(13);
  testWaitForTimeout(1000);
  Count = Count+2;
  if(Session != defsession)
    _SetSession(Session);
  _Send_Diag(3,ID,Send_Data_89);
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,2000);
  if(diagGetLastResponseCode(SendData) != -1)
    testStepFail("","未收到正响应");
  else
  {
    if(Count>=DTC_19_max)
    {
      if(DiagGetRespPrimitiveSize(SendData)<DTC_19_max*4+3)
        testStepFail("","返回故障长度未达到最大值");
      else
        testStepPass("","故障存储达到预期");
    }
    else
    {
      _WriteEx_and_Report("","当前制造故障个数为%d",Count);
      _WriteEx_and_Report("","当前存储故障个数为%d",(DiagGetRespPrimitiveSize(SendData)-3)/4);
    }
  }
}
void _Serve19_03_Geely(dword ID,byte Session) //获取DTC快照记录ID
{
  byte Send_Data_89[3] = {0x19,0x02,0x89};
  byte Send_Data_19[2] = {0x19,0x03};
  byte Res[2] = {0x59,0x03};
  int Pos1,Pos2,i;
  
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  StepByGeely3_0(0x19,1);
  Pos1 = Get_Node_Pos(Node_1904,1);
  Pos2 = Get_Node_Pos(0xE0,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_190201(SendData,0,0);
  _Send_Diag(2,ID,Send_Data_19);
  _TestResult(SendData,ID,"",-1);
  _Close_One_Node(DTC_19[Pos1]);
  _Send_Diag(2,ID,Send_Data_19);
  _Check_1903(SendData);
  _Close_One_Node(DTC_19[Pos2]);
  _Send_Diag(2,ID,Send_Data_19);
  _Check_1903(SendData);
  _Open_One_Node(DTC_19[Pos1]);
  _Open_One_Node(DTC_19[Pos2]);
}
void _Serve19_04_Geely(dword ID,byte Session) //19 04读快照
{
  byte Send_Data_89[3] = {0x19,0x02,0x89};
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Send_Data_19_2[6] = {0x19,0x04,0,0,0,0x20};
  byte Send_Data_02[2] = {0x10,0x02};
  byte Res_Data[200];
  int Pos,Pos_2,i,ResLen;
  
  Pos = Get_Node_Pos(Node_1904,1);
  Pos_2 = Get_Node_Pos(0xE0,1);
  Send_Data_19[2] = (DTC_19[Pos][1]>>16);
  Send_Data_19[3] = (DTC_19[Pos][1]>>8);
  Send_Data_19[4] = (DTC_19[Pos][1]&0xFF);
  Send_Data_19_2[2] = (DTC_19[Pos_2][1]>>16);
  Send_Data_19_2[3] = (DTC_19[Pos_2][1]>>8);
  Send_Data_19_2[4] = (DTC_19[Pos_2][1]&0xFF);
  
  _Set_Ready(0);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  _Clear_DTC(phyreq_ID);
  StepByGeely3_0(0x19,1);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_190201(SendData,0,0);
  
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0x2F);
  _Send_Diag(6,ID,Send_Data_19);
  _TestResult(SendData,ID,"",-1);
  ResLen = DiagGetRespPrimitiveSize(SendData);
  for(i=0;i<ResLen;i++)
    Res_Data[i] = DiagGetRespPrimitiveByte(SendData,i);
  
  _Set_Ready(0);
  _Send_Diag(2,ID,Send_Data_02);
  _TestResult(SendData,ID,"",-1);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(11000);
  if(Session != defsession)
    _SetSession(Session);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_Response(SendData,5,ResLen,Res_Data);
  _Set_Ready(0);
  _Set_11_Restoration();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  if(Session != defsession)
    _SetSession(Session);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_Response(SendData,5,ResLen,Res_Data);
  _Send_Diag(6,ID,Send_Data_19_2);
  _Check_19_NoFreeze(SendData,"ALL");
  
  _Open_One_Node(DTC_19[Pos]);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0x2E);//
  _Send_Diag(6,ID,Send_Data_19);
  _TestResult(SendData,ID,"",-1);
  ResLen = DiagGetRespPrimitiveSize(SendData);
  for(i=0;i<ResLen;i++)
    Res_Data[i] = DiagGetRespPrimitiveByte(SendData,i);
  _Set_Ready(0);
  _Send_Diag(2,ID,Send_Data_02);
  _TestResult(SendData,ID,"",-1);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(11000);
  if(Session != defsession)
    _SetSession(Session);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_Response(SendData,5,ResLen,Res_Data);
  _Set_Ready(0);
  _Set_11_Restoration();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  if(Session != defsession)
    _SetSession(Session);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_Response(SendData,5,ResLen,Res_Data);
  
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_19_NoFreeze(SendData,"ALL");
}
void _Serve19_06_Geely(dword ID,byte Session) //19 06读扩展
{
  byte Send_Data_89[3] = {0x19,0x02,0x89};
  byte Send_Data_19[6] = {0x19,0x06,0,0,0,0xFF};
  int Pos;
  char Time_First[50];
  char Time_FirstComPare[50];
  
  Pos = Get_Node_Pos(Node_1904,1);
  Send_Data_19[2] = (DTC_19[Pos][1]>>16);
  Send_Data_19[3] = (DTC_19[Pos][1]>>8);
  Send_Data_19[4] = (DTC_19[Pos][1]&0xFF);
  
  _Set_Ready(0);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  _Clear_DTC(phyreq_ID);
  
  if(_Check_StrPossion_Res("First_Time_Fault_Occurrence_Time",3)!= -1 && _Check_StrPossion_Res("Latest_Time_Fault_Occurrence_Time",3)!= -1)
  {
    int Sw_temp;
    StepByGeely3_0(0x19,1);
    snprintf(Time_First,elCount(Time_First),"%s","");
    snprintf(Time_FirstComPare,elCount(Time_FirstComPare),"%s","");
    Sw_temp = _Check_StrPossion_Res("LocalTime",1);
    _85_Check_DTC(1,0);
    
    _Step_1904("LocalTime",0); //取第0-3组数据
    testWaitForTimeout(1900);
    snprintf(Time_First,elCount(Time_First),"20%s%s",Time_First,mixArray[Sw_temp].LocalTime_Value);
    snprintf(Time_FirstComPare,elCount(Time_FirstComPare),"20%s",mixArray[Sw_temp].LocalTime_Value); //节点偏移2000
    _Close_One_Node(DTC_19[Pos]);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1906_Time_Geely(SendData,Time_FirstComPare,Time_FirstComPare); //时间戳1 | 时间戳1
    _Open_One_Node(DTC_19[Pos]);
    
    _Step_1904("LocalTime",1); //取第0-3组数据
    testWaitForTimeout(1900);
//    snprintf(Time_FirstComPare,elCount(Time_FirstComPare),"20%s",mixArray[Sw_temp].LocalTime_Value); //节点偏移2000
    _Close_One_Node(DTC_19[Pos]);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1906_Time_Geely(SendData,Time_First,Time_FirstComPare);//时间戳1 | 时间戳1
    _Open_One_Node(DTC_19[Pos]);
//    
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(200);
    _Step_1904("LocalTime",2); //取第0-3组数据
    testWaitForTimeout(1900);
    snprintf(Time_FirstComPare,elCount(Time_FirstComPare),"20%s",mixArray[Sw_temp].LocalTime_Value); //节点偏移2000
    snprintf(Time_First,elCount(Time_First),"20%s",mixArray[Sw_temp].LocalTime_Value); //节点偏移2000
    _Close_One_Node(DTC_19[Pos]);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1906_Time_Geely(SendData,Time_First,Time_FirstComPare);//时间戳3 | 时间戳3
    _Open_One_Node(DTC_19[Pos]);
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
    testWaitForTimeout(5000);
    _Step_1904("LocalTime",3); //取第0-3组数据
    testWaitForTimeout(1900);
    if(Session != defsession)
      _SetSession(Session);
    snprintf(Time_FirstComPare,elCount(Time_FirstComPare),"20%s",mixArray[Sw_temp].LocalTime_Value); //节点偏移2000
    _Close_One_Node(DTC_19[Pos]);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_1906_Time_Geely(SendData,Time_First,Time_FirstComPare);//时间戳3 | 时间戳3
    _Open_One_Node(DTC_19[Pos]);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(1000);
    _Send_Diag(6,ID,Send_Data_19);
    _Check_19_NoFreeze(SendData,"First_Time_Fault_Occurrence_Time");
  }
  else
    _WriteEx_and_Report("First_Time_Fault_Occurrence_Time","该项目内无此测试项");
}

void _Serve19_06_01_Geely(dword ID,byte Session) //19 06 (30)
{
  byte Send_Data_89[3] = {0x19,0x02,0x89};
  byte Send_Data_19[6] = {0x19,0x06,0,0,0,0x30};
  byte Send_Data_19_2[6] = {0x19,0x06,0,0,0,0x2};
  byte Res[8] = {0x59,0x06,0,0,0,0x02,0x30,0x80};
  int Pos,i,OCC2_Res;
  char Time_First[50];
  
  Pos = Get_Node_Pos(Node_1904,1);
  Send_Data_19[2] = (DTC_19[Pos][1]>>16);
  Send_Data_19[3] = (DTC_19[Pos][1]>>8);
  Send_Data_19[4] = (DTC_19[Pos][1]&0xFF);
  Send_Data_19_2[2] = (DTC_19[Pos][1]>>16);
  Send_Data_19_2[3] = (DTC_19[Pos][1]>>8);
  Send_Data_19_2[4] = (DTC_19[Pos][1]&0xFF);
  Res[2] = (DTC_19[Pos][1]>>16);
  Res[3] = (DTC_19[Pos][1]>>8);
  Res[4] = (DTC_19[Pos][1]&0xFF);
  
  _Set_Ready(0);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  _Clear_DTC(phyreq_ID);
  StepByGeely3_0(0x19,1);
  _Check_DTC_Res(0x89,0,DTC_19[Pos][1]);

  Res[5] = 0x2F;
  Res[7] = 0x80;
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_Response(SendData,8,Res);
  _Open_One_Node(DTC_19[Pos]);
  Res[5] = 0x2E;
  _Send_Diag(6,ID,Send_Data_19);
  _Check_Response(SendData,8,Res);
  Res[5] = 0x2C;
  for(i =1;i<=260;i++)
  {
    _WriteEx_and_Report("","第 %d 次上下电",i);
    _Set_Ready(0);
    _K15_OFF();
    testWaitForTimeout(3000);
    _K15_ON();
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(5000);
    if(i == 256)
      Res[7] = 0x08;
    testWaitForTimeout(1000);
    if(Session != defsession)
      _SetSession(Session);
    
    _Send_Diag(6,ID,Send_Data_19);
    _Check_Response(SendData,5,8,Res);
    
    OCC2_Res = i-1;
    if((i-1)>=0xFF)
      OCC2_Res = 0xFF;
    _Send_Diag(6,ID,Send_Data_19_2);
    _Check_OCC_Resp(2,OCC2_Res);
    if(i==1)
      Res[5] = 0x28;
  }
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_19_NoFreeze(SendData,"19 06");
}


void Serve_NRC22CarSpd_Lower(byte Serve,dword ID,byte Session,byte Type) //NRC22-车速小于3
{
  int i;
  char Serve_85_CarSpdQFTemp[10];
  byte Serve_85_CarSpdQF[10];
  int Serve_85_CarSpdQF_Count;
  int Res_Send_1_Step1;
  int Res_Send_2_Step1;
  
  GetInformationFlage = 0;
  
  /*--------获取QF数据--------*/
  Serve_85_CarSpdQF_Count = getProfileArray(ECU_project,"Serve_85_CarSpdQF",Serve_85_CarSpdQFTemp,elCount(Serve_85_CarSpdQFTemp),file_name_1);
  for(i=0;i<Serve_85_CarSpdQF_Count;i++)
    Serve_85_CarSpdQF[i] = Serve_85_CarSpdQFTemp[i];
  
  _Get_NRC_Mapping(Serve);
  
  _Set_Ready(0xB);
  _Set_CarSpd(NRC22_CarSpd-0.5);
  testWaitForTimeout(500);
  for(i=0;i<4;i++)
  {
    if(Session != defsession)
      _SetSession(Session);
    _Set_CarSpd_Invalid(i);
    testWaitForTimeout(1500);
    if(_Check_Dword_in_Num(i,Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)== -1)
    {
      Res_Send_1_Step1 = 0;
      Res_Send_2_Step1 = CarSpd_Invalid_NRC;
    }
    else
    {
      Res_Send_1_Step1 = 1;
      Res_Send_2_Step1 = -1;
    }
    
    _WriteEx_and_Report("","步骤1测试");
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
   
    _WriteEx_and_Report("","步骤2测试"); 
    if(Serve == 0x28 || Serve == 0x85 || Type == 1) //  28/85丢失车速节点后能正响应
    {
      Res_Send_1_Step1 = 1;
      Res_Send_2_Step1 = -1;
    }
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _WriteEx_and_Report("","步骤3测试");
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    _Set_Sig(CarSpd_E2E_Sig,2);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    if(Serve == 0x28 || Serve == 0x85 || Type == 1) //  28/85视E2E校验异常为通过
    {
      Res_Send_1_Step1 = 1;
      Res_Send_2_Step1 = -1;
    }
    else 
    {
      Res_Send_1_Step1 = 0;
      Res_Send_2_Step1 = CarSpd_Invalid_NRC;
    }
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _WriteEx_and_Report("","步骤4测试");
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    _Set_Sig(CarSpd_E2E_Sig,0);
    testWaitForTimeout(2000);
  }
  _Reset_CarSpd_Invalid();
}

void Serve_NRC22CarSpd_Upper(byte Serve,dword ID,byte Session,byte Type) //NRC22-车速大于3
{
  int i;
  char Serve_85_CarSpdQFTemp[10];
  byte Serve_85_CarSpdQF[10];
  int Serve_85_CarSpdQF_Count;
  int Res_Send_1_Step1;
  int Res_Send_2_Step1;
  GetInformationFlage = 0;
  
  /*--------获取QF数据--------*/
  Serve_85_CarSpdQF_Count = getProfileArray(ECU_project,"Serve_85_CarSpdQF",Serve_85_CarSpdQFTemp,elCount(Serve_85_CarSpdQFTemp),file_name_1);
  for(i=0;i<Serve_85_CarSpdQF_Count;i++)
    Serve_85_CarSpdQF[i] = Serve_85_CarSpdQFTemp[i];
  
  _Get_NRC_Mapping(Serve);
  
  _Set_Ready(0xB);
  _Set_CarSpd(NRC22_CarSpd+1);
  testWaitForTimeout(500);
  for(i=0;i<4;i++)
  {
    if(Session != defsession)
      _SetSession(Session);
    _Set_CarSpd_Invalid(i);
    testWaitForTimeout(1500);
    if(_Check_Dword_in_Num(i,Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)== -1)
    {
      Res_Send_2_Step1 = CarSpd_Invalid_NRC;
      Res_Send_1_Step1 = 0;
    }
    else
    {
      Res_Send_2_Step1 = CarSpd_NRC;
      Res_Send_1_Step1 = 0;
    }
    _WriteEx_and_Report("","步骤1测试");
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _WriteEx_and_Report("","步骤2测试");
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    if(Serve == 0x28 || Serve == 0x85 || Type == 1) //  28/85丢失车速节点后能正响应
    {
      Res_Send_1_Step1 = 1;
      Res_Send_2_Step1 = -1;
    }
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _WriteEx_and_Report("","步骤3测试");
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    _Set_Sig(CarSpd_E2E_Sig,2);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    if(Serve == 0x28 || Serve == 0x85 || Type == 1) //  28/85视E2E校验异常为通过
    {
      Res_Send_1_Step1 = 1;
      Res_Send_2_Step1 = -1;
    }
    else  
    {
      Res_Send_1_Step1 = 0;
      Res_Send_2_Step1 = CarSpd_Invalid_NRC;
    }
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
        
    _WriteEx_and_Report("","步骤4测试");
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    _Set_Sig(CarSpd_E2E_Sig,0);
    _Reset_CarSpd_Invalid();
    testWaitForTimeout(2000);
  }
}
Serve_NRC22_UsgMode(byte Serve,dword ID,byte Session,byte Type) //NRC22-发动机
{
  int i;
  int Res_Send_1_Step1;
  int Res_Send_2_Step1;
  byte UsgMode[5] = {0x0,0x1,0x2,0xB,0xD};
  GetInformationFlage = 0;
  
  _Get_NRC_Mapping(Serve);
  
  _Set_Ready(0xB);
  _Set_CarSpd(0);
  _Reset_CarSpd_Invalid();
  testWaitForTimeout(500);
  for(i=0;i<elcount(UsgMode);i++)
  {
    if(Session != defsession)
      _SetSession(Session);
    _Set_Ready(UsgMode[i]);
    testWaitForTimeout(1500);
    if(UsgMode[i] != 0xD)
    {
      Res_Send_2_Step1 = -1;
      Res_Send_1_Step1 = 1;
    }
    else
    {
      Res_Send_2_Step1 = Ready_NRC;
      Res_Send_1_Step1 = 0;
    }
    _WriteEx_and_Report("","步骤1测试");
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _WriteEx_and_Report("","步骤2测试");
    _TestDisableMsg(Struct_Ready.Sig_Id);
    testWaitForTimeout(1500);
    if(Serve == 0x28 || Serve == 0x85 || Type == 1) //  28/85丢失节点后能正响应
    {
      Res_Send_1_Step1 = 1;
      Res_Send_2_Step1 = -1;
    }
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _WriteEx_and_Report("","步骤3测试");
    _TestEnableMsg(Struct_Ready.Sig_Id);
    testWaitForTimeout(1500);
    _Set_Sig(PwrLvlElecMai_Sig,1); //防止CRC出现全0值恰好通过校验
    _Set_Sig(UsgMode_E2E_Sig,2);
    testWaitForTimeout(1500);
    if(Serve == 0x28 || Serve == 0x85 || Type == 1) //  28/85视E2E校验异常为通过
    {
      Res_Send_1_Step1 = 1;
      Res_Send_2_Step1 = -1;
    }
    else
    {
      Res_Send_1_Step1 = 0;
      Res_Send_2_Step1 = Ready_NRC;
    }
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
        
    _WriteEx_and_Report("","步骤4测试");
    _TestDisableMsg(Struct_Ready.Sig_Id);
    testWaitForTimeout(1500);
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _TestEnableMsg(Struct_Ready.Sig_Id);
    _Set_Sig(PwrLvlElecMai_Sig,0);
    _Set_Sig(UsgMode_E2E_Sig,0);
    testWaitForTimeout(2000);
  }
}

Serve_NRC22_Battery(byte Serve,dword ID,byte Session) //NRC22-电压
{
  int i;
  int Res_Send_1_Step1;
  int Res_Send_2_Step1;
  float Temp_Battery[4];
  int NRC22_Res,Serve_Pos;
  int Fun_DIDPos,Send_Flage;
  byte Send_D111[3] = {0x22,0xD1,0x11};
  dword FunDID = 0xD111;
  GetInformationFlage = 0;
  Send_Flage = 1;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  if(Fun_DIDPos == -1)
  {
    Send_Flage = 0;
    _WriteEx_and_Report("功能DID","未获取到对应的DID:0x%04X数据",FunDID);
  }
  _Get_NRC_Mapping(Serve);
  Serve_Pos = _Check_Serve(Serve,0,0);
  if(Serve == 0x10)
    NRC22_Res = _Check_Serve(Serve,0x02,7);
  else
    NRC22_Res = _Check_Serve(Serve,Serve_Data[Serve_Pos].Serve_Fun[0],7);
  
  _Set_Ready(0xB);
  _Set_CarSpd(0);
  _Reset_CarSpd_Invalid();
  testWaitForTimeout(500);
  
  Temp_Battery[0]=NRC22_Battery_Low+0.2;
  Temp_Battery[1]=NRC22_Battery_Hight-0.2;
  Temp_Battery[2]=NRC22_Battery_Low-0.2;
  Temp_Battery[3]=NRC22_Battery_Hight+0.2;
  
  for(i=0;i<4;i++)
  {
    if(Session != defsession)
      _SetSession(Session);
    _Set_Battery(Temp_Battery[i]);
    if(Send_Flage == 1) //读取并判断电压
    {
      Check_ReadFunDID(Send_D111,Fun_DIDPos,phyreq_ID,1,0,0,Temp_Battery[i]);
    }
    if(i>1)
    {
      if(i == 3)
        Res_Send_2_Step1 = H_Battery_NRC;
      if(i == 2)
        Res_Send_2_Step1 = L_Battery_NRC;
      Res_Send_1_Step1 = 0;
      if((NRC22_Res & 2) == 0)
      {
        Res_Send_2_Step1 = -1;
        Res_Send_1_Step1 = 1;
      }
    }
    else
    {
      Res_Send_2_Step1 = -1;
      Res_Send_1_Step1 = 1;
    }
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    if(Set_Battery_RS232 == 1)
      _Set_Battery(12);
  }
  if(Set_Battery_RS232 == 0)
    _Set_Battery(12);
}

Serve_NRC22_NRC_Priority(byte Serve,dword ID,byte Session,byte Type) //NRC22-NRC优先级
{
  int i;
  int Res_Send_1_Step1;
  int Res_Send_2_Step1;
  int Res_Send_1_Step2;
  int Res_Send_2_Step2;
  int Res_Send_1_Step3;
  int Res_Send_2_Step3;
  int NRC22_Res,Serve_Pos;
  int Flage;
  
  GetInformationFlage = 0;
  _Get_NRC_Mapping(Serve);
  
  Serve_Pos = _Check_Serve(Serve,0,0);
  // if(Serve == 0x10)
  //   NRC22_Res = _Check_Serve(Serve,0x02,7);
  // else
  //   NRC22_Res = _Check_Serve(Serve,Serve_Data[Serve_Pos].Serve_Fun[0],7);
  NRC22_Res = (Serve == 0x10) ? (_Check_Serve(Serve,0x02,7)):(_Check_Serve(Serve,Serve_Data[Serve_Pos].Serve_Fun[0],7));
  Flage = ((NRC22_Res & 2) == 0)?1:0;
  
  for(i=0;i<5;i++)
  {
    if(i == 0)
    {
      _Set_Ready(0xD);
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_CarSpd_Invalid(0);
      _Set_Battery(NRC22_Battery_Low-0.2);
      testWaitForTimeout(1000);
      Res_Send_2_Step1 = CarSpd_Invalid_NRC;
      Res_Send_1_Step1 = 0;
    }
    else if(i == 1)
    {
      _Set_Ready(0xD);
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_CarSpd_Invalid(3);
      _Set_Battery(NRC22_Battery_Low-0.2);
      testWaitForTimeout(1000);
      Res_Send_2_Step1 = CarSpd_NRC;
      Res_Send_1_Step1 = 0;
    }
    else if(i == 2)
    {
      _Set_Ready(0xD);
      _Set_CarSpd(NRC22_CarSpd-1);
      _Set_CarSpd_Invalid(3);
      _Set_Battery(NRC22_Battery_Low-0.2);
      testWaitForTimeout(1000);
      Res_Send_2_Step1 = Ready_NRC;
      Res_Send_1_Step1 = 0;
    }
    else if(i == 3)
    {
      _Set_Ready(0xB);
      _Set_CarSpd(NRC22_CarSpd-1);
      _Set_CarSpd_Invalid(3);
      _Set_Battery(NRC22_Battery_Low-0.2);
      testWaitForTimeout(1000);
      Res_Send_2_Step1 = L_Battery_NRC;
      Res_Send_1_Step1 = 0;  
      if(Flage == 1)
      {
        Res_Send_2_Step1 = -1;
        Res_Send_1_Step1 = 1;
      }
    }
    else if(i == 4)
    {
      _Set_Ready(0xB);
      _Set_CarSpd(NRC22_CarSpd-1);
      _Set_CarSpd_Invalid(3);
      _Set_Battery(13);
      testWaitForTimeout(1000);
      Res_Send_2_Step1 = -1;
      Res_Send_1_Step1 = 1;
    }
    if((Serve == 0x28 || Serve == 0x85) && Res_Send_2_Step1 != -1)
    {
      Res_Send_1_Step2 = Ready_NRC;
      Res_Send_2_Step2 = Ready_NRC;
      Res_Send_1_Step3 = L_Battery_NRC;
      Res_Send_2_Step3 = L_Battery_NRC;
  	  if(i == 3)
  	  {
  		  Res_Send_1_Step2 = L_Battery_NRC;
  		  Res_Send_2_Step2 = L_Battery_NRC;
  	  }
    }
    else
    {
      Res_Send_1_Step2 = Res_Send_1_Step1;
      Res_Send_2_Step2 = Res_Send_2_Step1;
      Res_Send_1_Step3 = Res_Send_1_Step1;
      Res_Send_2_Step3 = Res_Send_2_Step1;
    }
    
    if(Type == 1)
    {
      if(Flage == 0)
      {
        Res_Send_1_Step3 = 0;Res_Send_2_Step3 = L_Battery_NRC;
      }
      else
      {
        Res_Send_1_Step3 = 1;Res_Send_2_Step3 = -1;
      }
      if(i>3)
      {
        Res_Send_1_Step1 = 1;Res_Send_2_Step1 = -1;
        Res_Send_1_Step2 = 1;Res_Send_2_Step2 = -1;
        Res_Send_1_Step3 = 1;Res_Send_2_Step3 = -1;
      }
      switch(i)
      {
        case 0: Res_Send_1_Step2 = 0; Res_Send_2_Step2 = Ready_NRC;break;
        case 1: Res_Send_1_Step2 = 0; Res_Send_2_Step2 = Ready_NRC;break;
        case 2: Res_Send_1_Step2 = 0; Res_Send_2_Step2 = Ready_NRC;break;
        default:break;
      }
    }

    _SetSession(Session);
    testWaitForTimeout(1000);
    
    _WriteEx_and_Report("","步骤1测试");
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
    
    _WriteEx_and_Report("","步骤2测试");
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step2,Res_Send_2_Step2);
    
    _WriteEx_and_Report("","步骤3测试");
    _TestDisableMsg(Struct_Ready.Sig_Id);
    testWaitForTimeout(1500);
    Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step3,Res_Send_2_Step3);
    
    {
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _Set_Ready(0xB);
      _Set_CarSpd(NRC22_CarSpd-1);
      _Set_CarSpd_Invalid(3);
      if(Set_Battery_RS232 == 1 && i != 4)
        _Set_Battery(13);
      testWaitForTimeout(1000);
    }
  }
}

Serve_NRC22_PowerUp(byte Serve,dword ID,byte Session) //NRC22-上电
{
  int Res_Send_1_Step1;
  int Res_Send_2_Step1;
  GetInformationFlage = 0;
  _Get_NRC_Mapping(Serve);
  
  _Set_Ready(1);
  _Set_CarSpd(0);
  _Set_CarSpd_Invalid(3);
  testWaitForTimeout(1000);
  _Power_Down();
  
  _Set_Ready(0xD);
  _Set_CarSpd(NRC22_CarSpd+1);
  _Set_CarSpd_Invalid(0);
  _TestDisableMsg(Struct_CarSpd.Sig_Id);
  _TestDisableMsg(Struct_Ready.Sig_Id);
  testWaitForTimeout(1000);
  _K15_ON();
  testWaitForTimeout(3000);
  _SetSession(Session);
  
  Res_Send_1_Step1 = 1;
  Res_Send_2_Step1 = -1;
  Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
  _TestEnableMsg(Struct_CarSpd.Sig_Id);
  _TestEnableMsg(Struct_Ready.Sig_Id);
  testWaitForTimeout(7000);
  if(Session != defsession)
    _SetSession(Session);
  Res_Send_1_Step1 = 0;
  Res_Send_2_Step1 = CarSpd_Invalid_NRC;
  Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
  
  _Set_Ready(0x1);
  _Set_CarSpd(0);
  _Reset_CarSpd_Invalid();
  testWaitForTimeout(2000);
  _K15_OFF();
  testWaitForTimeout(3000);
  _TestDisableMsg(Struct_CarSpd.Sig_Id);
  _TestDisableMsg(Struct_Ready.Sig_Id);
  testWaitForTimeout(1000);
  _K15_ON();
  testWaitForTimeout(3000);
  _SetSession(Session);
  Res_Send_1_Step1 = 1;
  Res_Send_2_Step1 = -1;
  Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
  _TestEnableMsg(Struct_CarSpd.Sig_Id);
  _TestEnableMsg(Struct_Ready.Sig_Id);
  testWaitForTimeout(3000);
  Geely_NRC22_Test(Serve,ID,Session,Res_Send_1_Step1,Res_Send_2_Step1);
  
}

/*
    Geely3.0以及以上平台NRC22测试发送数据
    Serve：对应服务
    Res_1:发送数据1对应返回值
    Res_2:发送数据2对应返回值
    仅存在一次发送时使用Res_2对应的值
*/
int Geely_NRC22_Test(byte Serve,dword ID,byte Session,int Res_1,int Res_2)
{
  byte Send_10[2]={0x10,0x02};
  byte Send_11[2]={0x11,0x01};
  byte Send_28[3]={0x28,0x00,0x01};
  byte Send_85_1[2]={0x85,0x02};
  byte Send_85_2[2]={0x85,0x01};
  
  if(GetInformationFlage == 0 && Serve == 0x10)
  {
    /*--------获取预编程数据--------*/
    _get_Arry("Pre_Programmed");
    for(i=0;i<Arry_Len;i++)
      Data_Programmed[i] = Arry_Data[i];
    Data_Programmed_Count = Arry_Len;
    GetInformationFlage = 1;
  }
  if(Serve == 0x10)
  {
    _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
    _Check_31Routine_Rx(Data_Programmed,Res_1);
    _Send_Diag(2,ID,Send_10);
    _TestResult(SendData,ID,"",Res_2);
    if(diagGetLastResponseCode(SendData) == -1)
    {
      testWaitForTimeout(2000);
      _SetSession(defsession);
      testWaitForTimeout(2000);
      if(Session != defsession)
        _SetSession(Session);
    }
  }
  else if(Serve == 0x11)
  {
    _Send_Diag(2,ID,Send_11);
    _TestResult(SendData,ID,"",Res_2);
    if(diagGetLastResponseCode(SendData) == -1)
    {
      testWaitForTimeout(2000);
      if(Session != defsession)
        _SetSession(Session);
    }
  }
  else if(Serve == 0x28)
  {
    _Send_Diag(3,ID,Send_28);
    _TestResult(SendData,ID,"",Res_2);
  }
  else if(Serve == 0x85)
  {
    _Send_Diag(2,ID,Send_85_1);
    _TestResult(SendData,ID,"",Res_2);
    _Send_Diag(2,ID,Send_85_2);
    _TestResult(SendData,ID,"",Res_2);
  }
  
  return diagGetLastResponseCode(SendData);
}


