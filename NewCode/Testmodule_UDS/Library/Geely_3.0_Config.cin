void _Serve22_DD07(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Send_Data_22[3] = {0x22,0x33,0x02};
  int Pos,Pos_,Fun_DIDPos;
  char Da_Temp[2][50];
  char Str[50];
  char Te[100];
  
  snprintf(Str,elCount(Str),"%s","LocalTime");
  Flage_Invalid_Geely = 1;
  Pos = Get_Node_Pos(Node_1904,1);
  Pos_ = _Check_StrPossion_Res(Str,1);  
  if(Pos_ == -1)
  {
    _WriteEx_and_Report("","未查询到正确的DID字符串索引，跳过测试");
    return;
  }
  Send_Data_19[2] = (DTC_19[Pos][1]>>16);Send_Data_19[3] = (DTC_19[Pos][1]>>8);Send_Data_19[4] = (DTC_19[Pos][1]&0xFF);
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  if(Fun_DIDPos == -1)
  {
    _WriteEx_and_Report("","未查询到当前DID：%04X配置信息",FunDID);
    return;
  }
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  TimeInvalid_FirstTime = 1;
  _Set_Ready(0);
  _Power_Down();
  _TestDisableMsg(atol(mixArray[Pos_].Sig_Name_Node));
  testWaitForTimeout(200);
  _Power_Up();
  StepByGeely3_0(0x19,1);
  snprintf(DID_Function[Fun_DIDPos].LocalTime_Ex[0],elCount(DID_Function[Fun_DIDPos].LocalTime_Ex[0]),"FFFFFFFFFFFF");
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,1,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  snprintf(Da_Temp[0],elCount(Da_Temp[0]),"FFFFFFFFFFFF"); //Geely3.0节点偏移2000
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(6,phyreq_ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,1);
  _Open_One_Node(DTC_19[Pos]);

  snprintf(Te,elCount(Te),"%s","100/0/0_24:60:60");
  _WriteEx_and_Report("   设置LocalTime",Te);
  _Set_Time(Te,1);
  testWaitForTimeout(500);
  _TestEnableMsg(atol(mixArray[Pos_].Sig_Name_Node));
  testWaitForTimeout(2000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,1,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,1);
  _Open_One_Node(DTC_19[Pos]);
  TimeInvalid_FirstTime = 0;

  
  snprintf(Te,elCount(Te),"%s","99/12/31_23:59:59");
  _WriteEx_and_Report("   设置LocalTime",Te);
  _Set_Time(Te,1);
  testWaitForTimeout(2000);
  snprintf(DID_Function[Fun_DIDPos].LocalTime_Ex[0],elCount(DID_Function[Fun_DIDPos].LocalTime_Ex[0]),"20991231235959");
  snprintf(Da_Temp[0],elCount(Da_Temp[0]),"20991231235959"); //Geely3.0节点偏移2000
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  _Open_One_Node(DTC_19[Pos]);
  
  _Set_Sig(DID_Function[Fun_DIDPos].SigInvalid,DID_Function[Fun_DIDPos].SigInvalidValue);
  testWaitForTimeout(2000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  _Open_One_Node(DTC_19[Pos]);
  _Set_Sig(DID_Function[Fun_DIDPos].SigInvalid,DID_Function[Fun_DIDPos].SigNormalValue);

  snprintf(Te,elCount(Te),"%s","24/03/22_05:22:22"); 
  _WriteEx_and_Report("   设置LocalTime",Te);
  _Set_Time(Te,1);
  testWaitForTimeout(10000);
  _TestDisableMsg(atol(mixArray[Pos_].Sig_Name_Node));
  snprintf(DID_Function[Fun_DIDPos].LocalTime_Ex[0],elCount(DID_Function[Fun_DIDPos].LocalTime_Ex[0]),"20240322052222");
  snprintf(Da_Temp[0],elCount(Da_Temp[0]),"20240322052222"); //Geely3.0节点偏移2000
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  _Open_One_Node(DTC_19[Pos]);
  _TestEnableMsg(atol(mixArray[Pos_].Sig_Name_Node));
  
  snprintf(Te,elCount(Te),"%s","24/03/15_02:58:39"); 
  _WriteEx_and_Report("   设置LocalTime",Te);
  _Set_Time(Te,1);
  testWaitForTimeout(10000);
  snprintf(Te,elCount(Te),"%s","100/00/00_24:60:60"); 
  _WriteEx_and_Report("   设置LocalTime",Te);
  _Set_Time(Te,1);
  testWaitForTimeout(2000);
  snprintf(DID_Function[Fun_DIDPos].LocalTime_Ex[0],elCount(DID_Function[Fun_DIDPos].LocalTime_Ex[0]),"20240315025839");
  snprintf(Da_Temp[0],elCount(Da_Temp[0]),"20240315025839"); //Geely3.0节点偏移2000
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,1);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(6,ID,Send_Data_19);
  _Get_1904_All_Data(SendData);
  _Check_1904_Specified(Str,Da_Temp,0);
  _Open_One_Node(DTC_19[Pos]);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Step_1904(Str,0);
}


