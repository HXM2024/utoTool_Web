void _Serve22_D134(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x02};
  byte Res_Data_22[4] = {0x62,0x33,0x02,0xFF};
  int Fun_DIDPos,i;
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  Res_Data_22[1] = (FunDID>>8)&0xFF;
  Res_Data_22[2] = (FunDID)&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  _Set_Ready(0);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  for(i=0;i<6;i++)
  {
    if(i == 4)
      continue;
    _Set_Sig(CarMode_Sig,i);
    testWaitForTimeout(200);
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,i,0,0);
  }
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(200);
  for(i=0;i<6;i++)
  {
    if(i == 4)
      continue;
    _Set_Sig(CarMode_Sig,i);
    testWaitForTimeout(200);
    if(i<3)
      Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,0);
    else 
      Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,0);
  }
  _Set_Ready(0x0B);
  testWaitForTimeout(200);
  _Set_Sig(CarMode_Sig,5);
  testWaitForTimeout(200);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,5,0,0);
  _Set_Sig(CarMode_Sig,3);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,0);
  _Set_Sig(CarMode_Sig,0);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,0);
  _Set_Sig(CarMode_Sig,5);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,0);
}

void _Serve22_D900(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x02};
  byte Res_Data_22[4] = {0x62,0x33,0x02,0xFF};
  int Fun_DIDPos,i;
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  Res_Data_22[1] = (FunDID>>8)&0xFF;
  Res_Data_22[2] = (FunDID)&0xFF;
  diagStartTesterPresent(Cdd_Name);
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  _Init_CCP_();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(2000);
  Sendccp(16,2);
  testWaitForTimeout(5000);
  _Set_Sig(SteerSetgSteerMod,2);
  for(i=1;i<4;i++)
  {
    _Set_Sig(SteerAsscLvl,i);
    testWaitForTimeout(200);
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,i,0,0);
  }
  _Set_Sig(SteerAsscLvl,0);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,0);
  _Set_Sig(SteerAsscLvl,7);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,0);
  _Set_Sig(SteerSetg_UB,0);
  testWaitForTimeout(500);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,0);
  for(i=6;i<9;i++)
  {
    _Set_Sig(LatCtrlReqSafeLatCtrlModReq,i);
    testWaitForTimeout(200);
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,5,0,0);
  }
  for(i=1;i<2;i++) //2不测，未查到需求，E2E:0x11未做
  {
    _Set_Sig(LatCtrlReqSafeLatCtrlModReq,i);
    testWaitForTimeout(200);
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,4,0,0);
  }
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,0);
  diagStopTesterPresent(Cdd_Name);
}

void _Serve22_D901(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x02};
  int Fun_DIDPos,i;
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  _Init_CCP_();
  // testWaitForTesterConfirmation("此处不验证值仅打印输出",60000);
  GetFunDID_Data(FunDID);

  for(i=0;i<FunDID_Read_CCPGroupCount;i++)
  {
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(2000);
    Sendccp(FunDID_Read_CCP[i],FunDID_Read_Vaule[i],FunDID_Read_CCPCount[i]);
    testWaitForTimeout(30000);
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
    testWaitForTimeout(2000);
    Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,FunDID_Read_TuningSet[i],0,0);
    _Set_Ready(0);
  }
}

void _Serve22_D902(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x02};
  int Fun_DIDPos,i;
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  _Init_CCP_();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(2000);
  Sendccp(142,0x80);
  testWaitForTimeout(5000);
  _Set_Ready(0);
  testWaitForTimeout(2000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,0);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(2000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,2,0,0);
  testWaitForTesterConfirmation("转动方向盘到一个角度，然后点击YES",60000);
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,13);
  testWaitForTimeout(1000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,0);
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,0);
  _Ang_Calibration_();
  testWaitForTimeout(1000);
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,13);
  testWaitForTimeout(1000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,1,0,0);
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,0);
}

void _Serve22_D904(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x02};
  int Fun_DIDPos,i;
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  
  _Init_CCP_();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(2000);
  Sendccp(316,0x81);
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  _Set_Ready(0);
  testWaitForTimeout(1000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0,0,0);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(2000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,1,0,0);
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,2);
  testWaitForTimeout(1000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,2,0,0);
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,0);
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,1);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,4,0,0);
  testWaitForTesterConfirmation("断开传感器, 然后点击YES",60000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,3,0,0);
  testWaitForTesterConfirmation("连接传感器, 然后点击YES",60000);
  _Power_Down();
  testWaitForTimeout(1000);
  _Power_Up();
  _Set_Sig(LatCtrlReqSafeLatCtrlModReq,0);
}

void _Serve22_21AB(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x02};
