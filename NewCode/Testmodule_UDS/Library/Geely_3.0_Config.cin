void _Serve22_DD0C(dword FunDID,dword ID,byte Session)/*用于Geely3.5以上平台测试*/
{
  byte Send_Data_22[3] = {0x22,0x33,0x0C};
  byte Res_Data_22[4] = {0x62,0x33,0x02,0xFF};
  byte Data_Send[6] = {0x19,0x04,0,0,0,0x20};
  byte mask;
  int Fun_DIDPos,result ,i,j;
  byte TempEx;
  diagStartTesterPresent(Cdd_Name);
  Init_For_Snapshot();
  DTC_H = (Snapshot_Geely_DTC>>16); DTC_M = (Snapshot_Geely_DTC>>8); DTC_L = (Snapshot_Geely_DTC&0xFF);
  Data_Send[2] = DTC_H;  Data_Send[3] = DTC_M;  Data_Send[4] = DTC_L;
  Send_Data_22[1] = (FunDID>>8)&0xFF; Send_Data_22[2] = (FunDID)&0xFF;
  Res_Data_22[1] = (FunDID>>8)&0xFF; Res_Data_22[2] = (FunDID)&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  _Power_Down();
  _TestDisableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(200);
  _Power_Up();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  DID_Function[Fun_DIDPos].Value_Set_Flage = 1;
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,0,0xFF,0,0);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,0,DID_Function[Fun_DIDPos].Sig_Step,0xFF,0);


  /*超过最大值测试*/
  _Set_Sig(PwrLvlElecMai_Sig,6);
  _Set_Sig(PwrLvlElecSubtyp_Sig,6);
  testWaitForTimeout(200);
  _TestEnableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(6000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0xFF,0,0);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,0,DID_Function[Fun_DIDPos].Sig_Step,0xFF,0);
  
  /*正常值测试*/
  _Set_Sig(PwrLvlElecMai_Sig,5);
  _Set_Sig(PwrLvlElecSubtyp_Sig,0x0F);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0x5F,0,0);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,0,DID_Function[Fun_DIDPos].Sig_Step,0x5F,0);
  
  /*信号无效后测试*/
  
  _Set_Sig(DID_Function[Fun_DIDPos].SigInvalid,DID_Function[Fun_DIDPos].SigInvalidValue);
  testWaitForTimeout(200);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0x5F,0,0);
 _Clear_DTC(phyreq_ID);
 testWaitForTimeout(500);
 _Send_Diag(6,phyreq_ID,Data_Send);
 _Check_1904(SendData,0,DID_Function[Fun_DIDPos].Sig_Step,0x5F,0);
 _Set_Sig(DID_Function[Fun_DIDPos].SigInvalid,DID_Function[Fun_DIDPos].SigNormalValue);
 testWaitForTimeout(1000);
  
  /*有效值- 丢失*/
  _Set_Sig(PwrLvlElecMai_Sig,1);
  _Set_Sig(PwrLvlElecSubtyp_Sig,1);
  testWaitForTimeout(10000);
  _TestDisableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(6000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0x11,0,0);
  _Clear_DTC(phyreq_ID); 
  testWaitForTimeout(500);
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,0,DID_Function[Fun_DIDPos].Sig_Step,0x11,0);
  _TestEnableMsg(atol(DID_Function[Fun_DIDPos].Sig_From));
  testWaitForTimeout(1000);
  
  
  /*有效值- 最大值*/
  _Set_Sig(PwrLvlElecMai_Sig,3);
  _Set_Sig(PwrLvlElecSubtyp_Sig,0x0F);
  testWaitForTimeout(10000);
  _Set_Sig(PwrLvlElecMai_Sig,0x0A);
  _Set_Sig(PwrLvlElecSubtyp_Sig,0x0A);
  testWaitForTimeout(1000);
  Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,0x3F,0,0);
  _Clear_DTC(phyreq_ID); 
  testWaitForTimeout(500);
  _Send_Diag(6,phyreq_ID,Data_Send);
  _Check_1904(SendData,0,DID_Function[Fun_DIDPos].Sig_Step,0x3F,0);
  testWaitForTimeout(1000);
  diagStopTesterPresent(Cdd_Name);
  
  
  for(i=0;i<=0xF;i++)
  {
    _Set_Sig(PwrLvlElecMai_Sig,i);
    for(j=0;j<=0xF;j++)
    {
      _Set_Sig(PwrLvlElecSubtyp_Sig,j);
      testWaitForTimeout(200);
      if((i!=1 && i!= 2 && i<=5) || (i == 1 && j<2) || (i == 2 && j< 5))
        TempEx = ((i<<4)|j);
      Check_ReadFunDID(Send_Data_22,Fun_DIDPos,ID,1,TempEx,0,0);
      _Clear_DTC(phyreq_ID); 
      testWaitForTimeout(500);
      _Send_Diag(6,phyreq_ID,Data_Send);
      _Check_1904(SendData,0,DID_Function[Fun_DIDPos].Sig_Step,TempEx,0);
    }
  }
  _Set_Sig(PwrLvlElecMai_Sig,0);
  _Set_Sig(PwrLvlElecSubtyp_Sig,0);
}

void _Serve19_02_1_Geely(dword ID,byte Session)  //19 02 读故障
{
  byte Send_Data_89[3] = {0x19,0x02,0x89};
  byte Send_Data_19[6] = {0x19,0x04,0,0,0,0x20};
  byte Send_Data_BT[2] = {0x10,0x02};
  int Pos;
  Pos = Get_Node_Pos(Node_1904,1);
  Send_Data_19[2] = (DTC_19[Pos][1]>>16);
  Send_Data_19[3] = (DTC_19[Pos][1]>>8);
  Send_Data_19[4] = (DTC_19[Pos][1]&0xFF);
  
  _Set_Ready(0);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  if(Session!=defsession)
    _SetSession(Session);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_190201(SendData,0,0);
  _Close_One_Node(DTC_19[Pos]);
  StepByGeely3_0(0x19,1);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0x2F);
  _Open_One_Node(DTC_19[Pos]);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0x2E);
  _Send_Diag(6,ID,Send_Data_19);
  if(diagGetLastResponseCode(SendData)==0)
    testWaitForDiagResponse(SendData,200);
  if(DiagGetRespPrimitiveSize(SendData)<=7)
    testStepFail("","未收到快照信息");
  
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  _K30_OFF();
  testWaitForTimeout(3000);
  _K30_ON();
  testWaitForTimeout(7000);
  if(Session != defsession)
    _SetSession(Session);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_190201(SendData,0,0);
  _Send_Diag(6,ID,Send_Data_19);
  _Check_19_NoFreeze(SendData,"ALL");
  
  _Close_One_Node(DTC_19[Pos]);
  _Open_One_Node(DTC_19[Pos]);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_190201(SendData,DTC_19[Pos][1],0X2E);
  _Set_Ready(0);
  _Send_Diag(2,phyreq_ID,Send_Data_BT);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(11000);
  if(Session!=defsession)
    _SetSession(Session);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0X2C);
  _Set_Ready(0);
  _Set_11_Restoration();
  StepByGeely3_0(0x19,1);
  if(Session!=defsession)
    _SetSession(Session);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0X28);
  
  _Set_Ready(0);
  StepByGeely3_0(0x19,1);
  _Close_One_Node(DTC_19[Pos]);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0X2F);
  _Set_Ready(0);
  _Send_Diag(2,phyreq_ID,Send_Data_BT);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(11000);
  if(Session!=defsession)
    _SetSession(Session);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0X2F);
  _Set_Ready(0);
  _Set_11_Restoration();
  StepByGeely3_0(0x19,1);
  if(Session!=defsession)
    _SetSession(Session);
  _Send_Diag(3,ID,Send_Data_89);
  _Check_1902(SendData,DTC_19[Pos][1],0X2F);
  _Open_One_Node(DTC_19[Pos]);
}
