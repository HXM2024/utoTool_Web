  _Send_Diag(3,phyreq_ID,Read_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Chery);
  _Close_All_Advanced_function();
  testWaitForTimeout(2000);
  _Advanced_function_DTC(Write_Config_SGMW,DTC_Ex);
  _85_Check_DTC(1,0);
  _Open_All_Advanced_function();
  testWaitForTimeout(1000);
}
void Config_Is_0xC4_Chery() /*配置转角外发*/
{
  dword DTC_Ex[20];
  int i;
  for(i=3;i<Config_Len;i++)
    Write_Config_Chery[i] = 0;
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_11_Restoration();
  testWaitForTimeout(2000);
  _WriteEx_and_Report("","/*----------------开始测试----------------*/");
  
  Write_Config_Chery[31] = 0x10;
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(3,phyreq_ID,Read_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Chery);
  _Check_EPS_TX(0,0x0C4);
  
  _Set_11_Restoration();
  testWaitForTimeout(2000);
  _Send_Diag(3,phyreq_ID,Read_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Chery);
  _Close_All_Advanced_function();
  testWaitForTimeout(2000);
  _Advanced_function_DTC(Write_Config_SGMW,DTC_Ex);
  _85_Check_DTC(1,0);
  _Open_All_Advanced_function();
  _Check_EPS_TX(1,0x0C4);
  testWaitForTimeout(1000);
}
void Config_No_0xC4_Chery() /*不配置转角外发*/
{
  dword DTC_Ex[20];
  int i;
  for(i=3;i<Config_Len;i++)
    Write_Config_Chery[i] = 0;
  Write_Config_Chery[31] = 0x10;
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_11_Restoration();
  testWaitForTimeout(2000);
  _WriteEx_and_Report("","/*----------------开始测试----------------*/");
  
  Write_Config_Chery[31] = 0x00;
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(3,phyreq_ID,Read_Config_Chery);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Chery);
  _Check_EPS_TX(1,0x0C4);
  
  _Set_11_Restoration();
