void Config_NO_Chery() /*不配置LKA和APA*/
{
  dword DTC_Ex[20];
  int i;
  for(i=3;i<Config_Len;i++)
    Write_Config_Chery[i] = 0;
  Write_Config_Chery[11] = 0x80;
  
