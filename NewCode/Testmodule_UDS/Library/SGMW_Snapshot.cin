_19_04_8(dword ID,byte Session) /*里程及时间特殊策略_总线丢失时当前循环填充值测试*/
{
  byte Data_Send[6] = {0x19,0x04,0,0,0,0xff};
  char Str_[100];
  dword Node_L[10];
  dword Node_Count_;
  float Da_Temp[2];
  char Str_2[2][100];
  int i,n;
  
  DTC_H = (DTC_19[Node_1904_Pos][1]>>16);
  DTC_M = (DTC_19[Node_1904_Pos][1]>>8);
  DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
  Data_Send[2] = DTC_H;
