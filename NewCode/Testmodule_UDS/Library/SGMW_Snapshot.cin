_19_04_17(dword ID,byte Session) /*ECU同时可存储DTC的最小数量*/
{
  int i,len,dtc_num;
  byte Data_Send[3] = {0x19,0x02,0x09};
  _Clear_DTC(phyreq_ID);
  _Close_All();
  testWaitForTimeout(5000);
  _Open_All();
  for(i=0;i<Node_Invalid_Count;i++)
  {
    _Set_Sig(Node_Invalid[i].Signal_Name,Node_Invalid[i].Invalid_Value);
    testWaitForTimeout(Node_Invalid[i].Time*1.2);
    _Set_Sig(Node_Invalid[i].Signal_Name,Node_Invalid[i].Normal_Value);
    testWaitForTimeout(Node_Invalid[i].Time*1.2);
  }
  testWaitForTimeout(2000);

  Data_Send[2] = 0x09;
  _Send_Diag(3,ID,Data_Send);
  if(diagGetLastResponseCode(SendData)==0)
    testWaitForDiagResponse(SendData,2000);
  if(diagGetLastResponseCode(SendData)==-1)
  {
    len = DiagGetRespPrimitiveSize(SendData);
    dtc_num = (len-3)/4;
    if(Node_Invalid_Count+DTC_19_Count<=DTC_19_max)
    {
      if(dtc_num==(Node_Invalid_Count+DTC_19_Count))
        testStepPass("","当前网络DTC个数未达到最小值,反馈DTC个数与期望个数一致");
      else
        testStepFail("","当前网络DTC个数未达到最小值,反馈DTC个数为 %d ,期望个数为 %d",dtc_num,Node_Invalid_Count+DTC_19_Count);
    }
    else
    {
      if(dtc_num>DTC_19_max)
        testStepPass("","当前网络DTC个数达到最小值,反馈DTC个数为 %d ,最小个数为 %d",dtc_num,DTC_19_max);
      else
        testStepFail("","当前网络DTC个数达到最小值,反馈DTC个数为 %d ,最小个数为 %d",dtc_num,DTC_19_max);
    }
  }
}

