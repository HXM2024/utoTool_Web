 int _Step_1904_Skip(char str[],dword Type) //取第0-3组数据
{
  int n;
  int Sw_temp,Step_Flage;
  char str_T[500];
  char Te[500];
  snprintf(str_T,elCount(str_T),"%s","");
  snprintf(str_T,elCount(str_T),"%s",str);
  Sw_temp = _Check_StrPossion_Res(str,1);
  _Str_Upper(str_T);
  Step_Flage = -1;
  snprintf(Te,elCount(Te),"%s","");
  if(Sw_temp!= -1) 
    Step_Flage = _Check_mixArray_SetValue(str,Sw_temp);
  if(Sw_temp!= -1 && Step_Flage == 1)
  {
    if(((strncmp(str_T,"CARSPD",strlen(str_T)) == 0) || (strncmp(str_T,"VEHICLESPEED",strlen(str_T)) == 0)))
    {
//      _Set_CarSpd(mixArray[Sw_temp].Vaule_Set[Type]);
      _Set_Sig(mixArray[Sw_temp].Sig_Name[0],mixArray[Sw_temp].Vaule_Set[Type]);
      CarSpd_Now = mixArray[Sw_temp].Vaule_Set[Type];
      mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
      mixArray[Sw_temp].Step_Flage = 1;
      if(Group_Count>1)
        mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
      return 0;
    }
    else if(strncmp(str_T,"READY_STATE",strlen(str_T)) == 0 )
    {
      _Set_Sig(mixArray[Sw_temp].Sig_Name[0],mixArray[Sw_temp].Vaule_Set[Type]);
      Engine_State = mixArray[Sw_temp].Vaule_Set[Type];
      mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
      mixArray[Sw_temp].Step_Flage = 1;
      if(Group_Count>1)
        mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
      return 0;
    }
    else if(strncmp(str_T,"MILEAGE",strlen(str_T)) == 0 )
    {
      _Set_Sig(mixArray[Sw_temp].Sig_Name[0],mixArray[Sw_temp].Vaule_Set[Type]);
      mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
      mixArray[Sw_temp].Step_Flage = 1;
      if(Group_Count>1)
        mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
      return 0;
    }
    else if(strncmp(str_T,"LOCALTIME",strlen(str_T)) == 0)
    {
      snprintf(Te,elCount(Te),"%s",mixArray[Sw_temp].LocalTime_Set[Type]);
      _WriteEx_and_Report("   设置LocalTime",Te);
      mixArray[Sw_temp].Step_Flage = 1;
      _Set_Time(Te,1);
      testWaitForTimeout(1000);
      if(Group_Count>1)
        snprintf(mixArray[Sw_temp].LocalTime_Value_2[Type],elCount(mixArray[Sw_temp].LocalTime_Value_2[Type]),"%s",mixArray[Sw_temp].LocalTime_Value);
      snprintf(mixArray[Sw_temp].LocalTime_Value_Set[Type],elCount(mixArray[Sw_temp].LocalTime_Value_Set[Type]),"%s",mixArray[Sw_temp].LocalTime_Value);
      return 0;
    }
    for(n=0;n<mixArray_Len;n++)
    {
      if(strncmp(str,mixArray[n].Str_DID_1904,strlen(str)) == 0 )
      {
        _Check_ID_(mixArray[n].Sig_Name_Node);
        if(Canoe_Node_Flage == 1)
        {
          char str__[50];
          snprintf(str__,elCount(str__),"%s","");
          snprintf(str__,elCount(str__),"EV_%s",mixArray[n].Sig_Name[0]);
          setSignal(mixArray[n].Sig_Name[0],(int)mixArray[Sw_temp].Vaule_Set[Type]);
          putValue(str__,(int)mixArray[Sw_temp].Vaule_Set[Type]);
          mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
          mixArray[Sw_temp].Step_Flage = 1;
          testWaitForTimeout(100);
          if(Group_Count>1)
            mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
          return 0;
        }
      }
    }
  }
  else if(Step_Flage == 0)
  {
    mixArray[Sw_temp].Step_Flage = -1;
    _WriteEx_and_Report(str,"输入值为全0,跳过测试");
    return -1;
  }
  {
    mixArray[Sw_temp].Step_Flage = -1;
    return -1;
  }
}

void Snapshot_Change(dword ID,byte Session)
{
  int i;
  byte Data_Send[6] = {0x19,0x04,0,0,0,0xff};
  float Da_Temp[2];
  char Str_Temp[2][50];
  DTC_H = (DTC_19[Node_1904_Pos][1]>>16);
  DTC_M = (DTC_19[Node_1904_Pos][1]>>8);
  DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
  Data_Send[2] = DTC_H;
  Data_Send[3] = DTC_M;
  Data_Send[4] = DTC_L;
  _Close_All();
  testWaitForTimeout(5000);
  TestStep_ReadDTC("",DTC_19[Node_1904_Pos][1],1,0,1,1);
  _Open_All();
  testWaitForTimeout(2000);
  _WriteEx_and_Report("","设置第一次值");
  for(i=0;i<mixArray_Len;i++)
  {
    _Step_1904_Skip(mixArray[i].Str_DID_1904,0);
    _Step_1904_(mixArray[i].Str_DID_1904,0,1);
  }
  testWaitForTimeout(1000);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(200);
  _Send_Diag(6,ID,Data_Send);
  _Check_19_NoFreeze(SendData,"All");
  _WriteEx_and_Report("","丢失节点保持当前故障，两组快照均为第一次值");
  _Close_One_Node(DTC_19[Node_1904_Pos]);
  testWaitForTimeout(1000);
  _Send_Diag(6,ID,Data_Send);
  _Check_1904(SendData,"All",Da_Temp,Str_Temp,2);
  _WriteEx_and_Report("","设置第二次值");
  for(i=0;i<mixArray_Len;i++)
  {
    _Step_1904_Skip(mixArray[i].Str_DID_1904,1);
    _Step_1904_(mixArray[i].Str_DID_1904,1,2);
    _Step_1904_(mixArray[i].Str_DID_1904,0,1);
  }
  testWaitForTimeout(1000);
  _WriteEx_and_Report("","故障恢复为历史故障，两组快照保持第一次值");
  _Open_One_Node(DTC_19[Node_1904_Pos]);
  _Send_Diag(6,ID,Data_Send);
  _Check_1904(SendData,"All",Da_Temp,Str_Temp,2);
  
  _WriteEx_and_Report("","再次制造丢失，第零组快照保持不变，第一组快照更新为第二次值");
  _Close_One_Node(DTC_19[Node_1904_Pos]);
  testWaitForTimeout(1000);
  for(i=0;i<mixArray_Len;i++)
    _Step_1904_(mixArray[i].Str_DID_1904,1,1);
  _Send_Diag(6,ID,Data_Send);
  _Check_1904(SendData,"All",Da_Temp,Str_Temp,2);
  
  _WriteEx_and_Report("","下电并设置第三次值");
  _K15_OFF();
  testWaitForTimeout(500);
  _Power_Down_19();
  testWaitForTimeout(K15_OFF_Time);
  for(i=0;i<mixArray_Len;i++)
  {
    _Step_1904_Skip(mixArray[i].Str_DID_1904,2);
    _Step_1904_(mixArray[i].Str_DID_1904,2,1);
  }
  testWaitForTimeout(1000);
  _WriteEx_and_Report("","重新上电，第零组快照保持不变，第一组快照更新为第三次值");
  _Power_Up_19();
  if(Session != defsession)
    _SetSession(Session);
  testWaitForTimeout(5000);
  _Send_Diag(6,ID,Data_Send);
  _Check_1904(SendData,"All",Da_Temp,Str_Temp,2);
  
  _WriteEx_and_Report("","下电并停发报文，设置第四次值");
  _Power_Down_19();
  testWaitForTimeout(K15_OFF_Time);
  _Close_All();
  testWaitForTimeout(2000);
  _Open_All(DTC_19[Node_1904_Pos]);

  for(i=0;i<mixArray_Len;i++)
  {
    _Step_1904_Skip(mixArray[i].Str_DID_1904,3);
    _Step_1904_(mixArray[i].Str_DID_1904,3,1);
  }
  testWaitForTimeout(1000);
  _WriteEx_and_Report("","重新上电检测第零组快照保持不变，第一组快照更新为第四次值");
  _Power_Up_19();
  testWaitForTimeout(5000);
  _Send_Diag(6,ID,Data_Send);
  _Check_1904(SendData,"All",Da_Temp,Str_Temp,2);
  _WriteEx_and_Report("","清除DTC并等待2s，检测两组快照均更新为第四次值");
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  for(i=0;i<mixArray_Len;i++)
    _Step_1904_(mixArray[i].Str_DID_1904,3,0);
  _Send_Diag(6,ID,Data_Send);
  _Check_1904(SendData,"All",Da_Temp,Str_Temp,2);
  _Open_All();
}

_19_04_3(dword ID,byte Session) /*所有故障码快照记录及更新一致性测试*/
{
  byte Data_Send[6] = {0x19,0x04,0,0,0,0xff};
  float Da_Temp[2];
  char Str_Temp[2][50];
  int i;
  _Close_All();
  _Power_Down();
  testWaitForTimeout(1000);
  _Power_Up();
  _SetSession(Session);
  diagStartTesterPresent(Cdd_Name);
  testWaitForTimeout(5000);
  _Open_All(DTC_19[Node_1904_Pos]);
  for(i=0;i<mixArray_Len;i++)
  {
    _Step_1904_Skip(mixArray[i].Str_DID_1904,0);
    _Step_1904_(mixArray[i].Str_DID_1904,0,1);
  }
  _Clear_DTC(phyreq_ID);
  DTC_H = (DTC_19[Node_1904_Pos][1]>>16);
  DTC_M = (DTC_19[Node_1904_Pos][1]>>8);
  DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
  Data_Send[2] = DTC_H;
  Data_Send[3] = DTC_M;
  Data_Send[4] = DTC_L;
  for(i=0;i<Freeze_Frame_Number_Count;i++)
  {
    testWaitForTimeout(2000);
    Data_Send[5] = Freeze_Frame_Number[i];
    _Send_Diag(6,ID,Data_Send);
    _Check_1904(SendData,"All",Da_Temp,Str_Temp,2);
    testWaitForTimeout(300);
  }
  _Open_All();
}
_19_04_4(dword ID,byte Session) /*总线信号丢失时的填充值测试*/
{
  byte Data_Send[6] = {0x19,0x04,0,0,0,0xff};
  float Da_Temp[2];
  char Str_[100];
  char Str_2[2][100];
  int i;
  
  DTC_H = (DTC_19[Node_1904_Pos][1]>>16);
  DTC_M = (DTC_19[Node_1904_Pos][1]>>8);
  DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
  Data_Send[2] = DTC_H;
  Data_Send[3] = DTC_M;
  Data_Send[4] = DTC_L;
  _Power_Down();
  _Close_All();
  testWaitForTimeout(1000);
  _Power_Up();
  _SetSession(Session);
  diagStartTesterPresent(Cdd_Name);
  testWaitForTimeout(5000);
  TestStep_ReadDTC("",DTC_19[Node_1904_Pos][1],1,0,1,1);
  _Open_One_Node(DTC_19[Node_1904_Pos]);
  
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Send_Diag(6,ID,Data_Send);
  _Check_19_NoFreeze(SendData,"All");
  testWaitForTimeout(2000);
  _Close_One_Node(DTC_19[Node_1904_Pos]);
  testWaitForTimeout(2000);

  _Send_Diag(6,ID,Data_Send);
  _Get_1904_All_Data(SendData);
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    if(strncmp(Str_,"LocalTime",strlen(Str_))==0)
      _Check_1904_Specified(Str_,Str_2,1);
    else
      _Check_1904_Specified(Str_,Da_Temp,1);
    testWaitForTimeout(500);
  }
  _Open_All();
}
