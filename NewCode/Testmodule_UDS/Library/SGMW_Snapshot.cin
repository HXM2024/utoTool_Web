    testWaitForTimeout(500);
  }
  _Open_All();
  diagStopTesterPresent(Cdd_Name);
}

_19_04_6(dword ID,byte Session) /*总线信号无效时填充值测试*/
{
  byte Data_Send[6] = {0x19,0x04,0,0,0,0xff};
  float Da_Temp[2];
  char Str_[100];
  char Str_2[2][100];
  int i,Temp_P;
  dword Node_Temp;
  dword Node_L[10];
  dword Node_Count_;
  
  DTC_H = (DTC_19[Node_1904_Pos][1]>>16);
  DTC_M = (DTC_19[Node_1904_Pos][1]>>8);
  DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
  Data_Send[2] = DTC_H;
  Data_Send[3] = DTC_M;
  Data_Send[4] = DTC_L;
  Node_Count_ = 0;
  _Power_Down();
  testWaitForTimeout(1000);
  _Close_All();
  _Power_Up();
  _SetSession(Session);
  diagStartTesterPresent(Cdd_Name);
  testWaitForTimeout(5000);
  _Open_One_Node(DTC_19[Node_1904_Pos]);
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    Temp_P = _Check_StrPossion_Res(Str_,1);
    if(Temp_P != -1)
    {
      Node_L[Node_Count_] = atol(mixArray[Temp_P].Sig_Name_Node);
      _Invalid_Node(Str_,Node_L[Node_Count_]);
      Node_Count_++;
      testWaitForTimeout(500);
      _TestEnableMsg(atol(mixArray[Temp_P].Sig_Name_Node));
    }
  }
  testWaitForTimeout(1000);
  for(i=0;i<mixArray_Len;i++)
  {
    _Step_1904_Skip(mixArray[i].Str_DID_1904,0);
    _Step_1904_(mixArray[i].Str_DID_1904,0,1);
  }
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(2000);
  _Send_Diag(6,ID,Data_Send);
  _Check_19_NoFreeze(SendData,"ALL");
  testWaitForTimeout(1000);
  _Close_One_Node(DTC_19[Node_1904_Pos]);
  testWaitForTimeout(500);
  _Send_Diag(6,ID,Data_Send);
  _Get_1904_All_Data(SendData);
  for(i=0;i<Freeze_Frame_CAN_Error_Count;i++)
  {
    snprintf(Str_,elCount(Str_),"%s","");
    snprintf(Str_,elCount(Str_),"%s",Freeze_Frame_CAN_Error[i]);
    if(strncmp(Str_,"LocalTime",strlen(Str_))==0)
      _Check_1904_Specified(Str_,Str_2,1);
    else
      _Check_1904_Specified(Str_,Da_Temp,1);
    testWaitForTimeout(500);
  }
  _Open_All();
  for(i=0;i<Node_Count_;i++)
    _Recover_Invalid_Node("",Node_L[i]);
}
