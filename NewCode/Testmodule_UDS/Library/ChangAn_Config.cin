void FixDataSave_7(dword ID,byte Session)  /*遍历所有信号*/
{
  byte Data_Send[3] = {0x22,0xF1,0xF0};
  int i,j,k,ReLen,Flage;
  dword DTC_Ex;
  byte Return_Data[200];
  dword NextDID,RealPos;
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    冻结帧测试时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  _Clear_DTC(phyreq_ID);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(3000);
  DTC_Cover_For_FixDataSave(0,2);
  NextDID = (FixDataSave_LastPos|0xF1F0)+1;
  if(NextDID>0xF1F5)
    NextDID = 0xF1F0;
  for(i=0;i<FixDataSave_Count+1;i++)
  {
    for(j=0;j<FixDataSave[i].Error_Type_Count;j++)
    {
      Flage = 0;
      DTC_Ex = FixDataSave[i].DTC[j];
      _Save_Arry_FixData();
      writeEx(-3,0,"/*------------------------------------*/");
      writeEx(-3,0,"0x%03X %s : %s",FixDataSave[i].Node,FixDataSave[i].SigName[j],FixDataSave[i].Error_Type[j]);
      ReLen = DataGet_ByDTC(DTC_Ex,FixDataSave[i].Error_FPS[j]+2,10,5,Return_Data); //故障帧数FixDataSave[i].Error_FPS[j]+2
      testWaitForTimeout(500);
      _85_Check_DTC(9,DTC_Ex);
      for(k=0xF0;k<=0xF5;k++)
      {
        Data_Send[2] = k;
        _Send_Diag(3,ID,Data_Send);
        _Check_FixDataSave(1,0);
        testWaitForTimeout(100);
      }
      Res_DID_Count = 0;Res_DID = NextDID;
      Cover_Arry(NextDID,DTC_Ex,Return_Data,ReLen);
      RealPos = _Check_Dword_in_Num(DTC_Ex,DTC_list_F0ToF5,elcount(DTC_list_F0ToF5));
      if(RealPos == -1)
        testStepfail("","DTC:0x%06X 未在冻结帧中查询到",DTC_Ex);
      RealPos = (RealPos|0xF1F0);
      Flage = _Compara_FixDataSave_Change(2,0);
      testWaitForTimeout(1000);
      if(RealPos != NextDID)
      {
        testStepFail("","新的DTC产生时，DID与预期不符，期望为0x%04X，实际为0x%04X",NextDID,RealPos);
        NextDID = RealPos; //防止后续出现连续错误
      }
      else
        testStepPass("","新的DTC产生时，读取的DID顺序往后覆盖");
      
      NextDID = (NextDID+1>0xF1F5)?0xF1F0:(NextDID+1);
      if(Flage == -1)
      {
        char Str[200];
        snprintf(Str,elCount(Str),"[ 信号: %s  故障类型: %s  ] \n",FixDataSave[i].SigName[j],FixDataSave[i].Error_Type[j]);
        File_Write(Error_File,Error_FileName,Str,2);
      }
    }
  }
}

void Fac_Config()
{
  _Set_Ready(0);
  for(i=3;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  _SetSession(exsession);
  _unlockECU();
  _get_Arry("Angle_Calibration");
  _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(200);
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(200);
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  _Set_11_Restoration(0);
  _85_Check_DTC(1,Unconfigured);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  
  Write_Config_ChangAn[3] = 0x01;
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(200);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  _SetSession(defsession);
  _Set_11_Restoration();
  _85_Check_DTC(1,0);
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *无助力*",60000);
  
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(500);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  _SetSession(defsession);
  for(i=3;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  Write_Config_ChangAn[4] = 0xFF;
  Write_Config_ChangAn[5] = 0xFF;
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(200);
  _Set_11_Restoration(0);
  _85_Check_DTC(1,Unconfigured);
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  _Set_Ready(0);
  testWaitForTimeout(500);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  
}

void Fac_Angle_Calibration()
{
  byte Angle_Data[5] = {0x31,0x01,0xFE,0xE0,0x02};
  _Set_Ready(0);
  for(i=3;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  Write_Config_ChangAn[3] = 0x01;
  _SetSession(exsession);
  _unlockECU();
  testWaitForTimeout(200);
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(200);
  _Set_11_Restoration(0);
  
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(5,phyreq_ID,Angle_Data);
  _TestResult(SendData,phyreq_ID,"",-1);
  _85_Check_DTC(1,Ang_NotCal);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  _SetSession(defsession);
  _Set_11_Restoration();
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  
  Angle_Data[4] = 0x01;
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(5,phyreq_ID,Angle_Data);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(200);
  _85_Check_DTC(1,0);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *无助力*",60000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(500);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  _SetSession(defsession);
  _Set_11_Restoration();
  _Set_Ready(0);
  testWaitForTimeout(2000);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *无助力*",60000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
}

void Fac_AngleAndConfig()
{
  byte Angle_Data[5] = {0x31,0x01,0xFE,0xE0,0x02};
  dword DTC_Ex[2];
  DTC_Ex[0] = Ang_NotCal;
  DTC_Ex[1] = Unconfigured;
  
  _Set_Ready(0);
  for(i=3;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_11_Restoration(0);
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(5,phyreq_ID,Angle_Data);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(500);
  _Check_DTC(1,DTC_Ex);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  _SetSession(defsession);
  _Set_11_Restoration();
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  testWaitForTesterConfirmation("转动方向盘，此时应当 *有助力*",60000);
  
  _WriteEx_and_Report("","/*-------测试结束,进行恢复-------*/");
  Angle_Data[4] = 0x01;
  _get_Arry("Config_ALL");
  for(i=0;i<3;i++)
    Write_Config_ChangAn[i] = Arry_Data[i];
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(5,phyreq_ID,Angle_Data);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(200);
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_11_Restoration(0);
}

