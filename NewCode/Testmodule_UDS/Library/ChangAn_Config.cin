/*
  输入数据检测所在原始配置函数的所在位置
  DTC_Type:故障类型(Lost/CRC/Cntr/Invalid...)
  Node:节点ID
  Type = 1: 返回DTC_Type对应的DTC值
*/
int64 _Return_FixDataSave_Pos(byte Type,char DTC_Type[],dword Node)
{
  int64 Return_Value;
  int Node_Pos,ErrorType_Pos,i;
  char Temp_Str_Input[50];
  char Temp_Str_Config[50];
  Return_Value = -1;
  Node_Pos = -1;
  ErrorType_Pos = -1;
  
  toUpper(Temp_Str_Input,DTC_Type,elCount(DTC_Type));
  for(i=0;i<FixDataSave_Count;i++)
  {
    if(FixDataSave[i].Node == Node)
    {
      Node_Pos = i;break;
    }
  }
  if(Node_Pos == -1)
  {
    _WriteEx_and_Report("","0x%03X未查询到对应节点位置",Node);
    return -2;
  }
  
  for(i=0;i<FixDataSave[Node_Pos].Error_Type_Count;i++)
  {
    toUpper(Temp_Str_Config,FixDataSave[Node_Pos].Error_Type[i],elCount(FixDataSave[Node_Pos].Error_Type[i]));
    if(strncmp(Temp_Str_Input,Temp_Str_Config,strlen(Temp_Str_Input)) == 0 && strlen(Temp_Str_Input) == strlen(Temp_Str_Config))
    {
      ErrorType_Pos = i; break;
    }
  }
  if(ErrorType_Pos == -1)
  {
    _WriteEx_and_Report(DTC_Type,"未查询到对应故障类型所在位置");
    return -1;
  }
  
  if(Type == 1)
  {
    return FixDataSave[Node_Pos].DTC[ErrorType_Pos];
  }
  
  return 0;
}
/*
  检测返回的数据冻结帧数据值
  Type = 0：返回值为全0
  Type = 1：仅读取判断正响应，不做其余判断
  Type = 2：返回值为是否为指定DTC所对应的DID
*/
int _Check_FixDataSave(byte Type,dword DTC)
{
  int ReSize,i,Flage,Return_Value;
  Return_Value = 0;
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,1000);
  if(diagGetLastResponseCode(SendData) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(SendData) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(SendData) == -1)
  {
    ReSize = DiagGetRespPrimitiveSize(SendData);
    Flage = 0;
    if(ReSize!= Res_FixData_Len)
      testStepFail("","返回数据长度异常，跳过数据部分检测");
    else
    {
      switch(DiagGetRespPrimitiveByte(SendData,2))
      {
        case 0xF0:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F0[i] = DiagGetRespPrimitiveByte(SendData,i);
          DTC_list_F0ToF5[0] = ((Temp_Res_F1F0[3]&0xFF)<<16)|((Temp_Res_F1F0[4]&0xFF)<<8)|(Temp_Res_F1F0[5]&0xFF);
          break;
        case 0xF1:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F1[i] = DiagGetRespPrimitiveByte(SendData,i);
          DTC_list_F0ToF5[1] = ((Temp_Res_F1F1[3]&0xFF)<<16)|((Temp_Res_F1F1[4]&0xFF)<<8)|(Temp_Res_F1F1[5]&0xFF);
          break;
        case 0xF2:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F2[i] = DiagGetRespPrimitiveByte(SendData,i);
          DTC_list_F0ToF5[2] = ((Temp_Res_F1F2[3]&0xFF)<<16)|((Temp_Res_F1F2[4]&0xFF)<<8)|(Temp_Res_F1F2[5]&0xFF);
          break;
        case 0xF3:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F3[i] = DiagGetRespPrimitiveByte(SendData,i);
          DTC_list_F0ToF5[3] = ((Temp_Res_F1F3[3]&0xFF)<<16)|((Temp_Res_F1F3[4]&0xFF)<<8)|(Temp_Res_F1F3[5]&0xFF);
          break;
        case 0xF4:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F4[i] = DiagGetRespPrimitiveByte(SendData,i);
          DTC_list_F0ToF5[4] = ((Temp_Res_F1F4[3]&0xFF)<<16)|((Temp_Res_F1F4[4]&0xFF)<<8)|(Temp_Res_F1F4[5]&0xFF);
          break;
        case 0xF5:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F5[i] = DiagGetRespPrimitiveByte(SendData,i);
          DTC_list_F0ToF5[5] = ((Temp_Res_F1F5[3]&0xFF)<<16)|((Temp_Res_F1F5[4]&0xFF)<<8)|(Temp_Res_F1F5[5]&0xFF);
          break;
        default:
            writeEx(-3,0,"收到非预期应答");break;
      }
      
      for(i=0;i<3;i++)
      {
        if(i==0)
        {
          if(DiagGetRespPrimitiveByte(SendData,i) != (DiagGetPrimitiveByte(SendData,0)^0x40))
          {
            testStepFail("","实际反馈值与预期不等,期望为 0x%02X,实际为 0x%02X",(DiagGetPrimitiveByte(SendData,0)^0x40),DiagGetRespPrimitiveByte(SendData,0));
            Flage = 1;
          }
        }
        else
        {
          if(DiagGetRespPrimitiveByte(SendData,i) != DiagGetPrimitiveByte(SendData,i))
          {
            testStepFail("","实际反馈值与预期不等,期望数据Byte_%d为 0x%02X,实际为 0x%02X",i,DiagGetPrimitiveByte(SendData,i),DiagGetRespPrimitiveByte(SendData,i));
            Flage = 1;
          }
        }
      }
      if(Flage == 0)
        testStepPass("","前三字节与预期一致");
      Flage = 0;
      if(Type == 0)
      {
        for(i=3;i<ReSize;i++)
        {
          if(DiagGetRespPrimitiveByte(SendData,i) != 0)
          {
            Flage = 1;
            testStepFail("","实际反馈值与预期不等,期望数据Byte_%d为 0x00,实际为 0x%02X",i,DiagGetRespPrimitiveByte(SendData,i));
          }
        }
        if(Flage == 0)
          testStepPass("","返回数据与预期一致,均全为0x00");
        return 0;
      }
      else if(Type == 2)
      {
        dword DTC_Res;
        DTC_Res = (DiagGetRespPrimitiveByte(SendData,3)<<16) + (DiagGetRespPrimitiveByte(SendData,4)<<8) + DiagGetRespPrimitiveByte(SendData,5);
        if(DTC_Res == DTC)
        {
          Res_DID = (DiagGetRespPrimitiveByte(SendData,1)<<8) + DiagGetRespPrimitiveByte(SendData,2);
          _WriteEx_and_Report("","0x%04X",Res_DID);
          return Res_DID;
        }
        else
          return -1;
      }
    }
  }
  return 0;
}
/*
  检测返回的数据冻结帧数据值
  Type = 2：返回值为是否为指定DTC所对应的DID中数据
*/
int _Check_FixDataSave(byte Type,dword DTC[])
{
  int ReSize,i,Flage,Return_Value;
  Return_Value = 0;
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,1000);
  if(diagGetLastResponseCode(SendData) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(SendData) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(SendData) == -1)
  {
    ReSize = DiagGetRespPrimitiveSize(SendData);
    Flage = 0;
    if(ReSize!= Res_FixData_Len)
      testStepFail("","返回数据长度异常，跳过数据部分检测");
    else
    {
      switch(DiagGetRespPrimitiveByte(SendData,2))
      {
        case 0xF0:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F0[i] = DiagGetRespPrimitiveByte(SendData,i);
          break;
        case 0xF1:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F1[i] = DiagGetRespPrimitiveByte(SendData,i);
          break;
        case 0xF2:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F2[i] = DiagGetRespPrimitiveByte(SendData,i);
          break;
        case 0xF3:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F3[i] = DiagGetRespPrimitiveByte(SendData,i);
          break;
        case 0xF4:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F4[i] = DiagGetRespPrimitiveByte(SendData,i);
          break;
        case 0xF5:
          for(i=0;i<ReSize;i++)
            Temp_Res_F1F5[i] = DiagGetRespPrimitiveByte(SendData,i);
          break;
        default:
            writeEx(-3,0,"收到非预期应答");break;
      }
      for(i=0;i<3;i++)
      {
        if(i==0)
        {
          if(DiagGetRespPrimitiveByte(SendData,i) != (DiagGetPrimitiveByte(SendData,0)^0x40))
          {
            testStepFail("","实际反馈值与预期不等,期望为 0x%02X,实际为 0x%02X",(DiagGetPrimitiveByte(SendData,0)^0x40),DiagGetRespPrimitiveByte(SendData,0));
            Flage = 1;
          }
        }
        else
        {
          if(DiagGetRespPrimitiveByte(SendData,i) != DiagGetPrimitiveByte(SendData,i))
          {
            testStepFail("","实际反馈值与预期不等,期望数据Byte_%d为 0x%02X,实际为 0x%02X",i,DiagGetPrimitiveByte(SendData,i),DiagGetRespPrimitiveByte(SendData,i));
            Flage = 1;
          }
        }
      }
      if(Flage == 0)
        testStepPass("","前三字节与预期一致");
      Flage = 0;
      if(Type == 0)
      {
        for(i=3;i<ReSize;i++)
        {
          if(DiagGetRespPrimitiveByte(SendData,i) != 0)
          {
            Flage = 1;
            testStepFail("","实际反馈值与预期不等,期望数据Byte_%d为 0x00,实际为 0x%02X",i,DiagGetRespPrimitiveByte(SendData,i));
          }
        }
        if(Flage == 0)
          testStepPass("","返回数据与预期一致,均全为0x00");
        return 0;
      }
      else if(Type == 2)
      {
        dword DTC_Res;
        dword DTC_Input[10],DTC_Input_Len;
        DTC_Input_Len = 0;
        for(i=0;i<elCount(DTC);i++)
        {
          if(DTC[i] != 0)
          {
            DTC_Input[DTC_Input_Len] = DTC[i];
            DTC_Input_Len++;
          }
        }
        DTC_Res = (DiagGetRespPrimitiveByte(SendData,3)<<16) + (DiagGetRespPrimitiveByte(SendData,4)<<8) + DiagGetRespPrimitiveByte(SendData,5);
        for(i=0;i<DTC_Input_Len;i++)
        {
          if(DTC_Res == DTC_Input[i])
          {
            Res_DID_[Res_DID_Count] = (DiagGetRespPrimitiveByte(SendData,1)<<8) + DiagGetRespPrimitiveByte(SendData,2);
            _WriteEx_and_Report("","0x%04X",Res_DID_[Res_DID_Count]);
            Res_DID_Count++;
            return Res_DID_[Res_DID_Count-1];
          }
        }
      }
    }
  }
  return 0;
}

_Save_Arry_FixData()
{
  int i;
  for(i=0;i<Res_FixData_Len;i++)
  {
    Temp_Res_F1F0_1[i] = Temp_Res_F1F0[i];
    Temp_Res_F1F1_1[i] = Temp_Res_F1F1[i];
    Temp_Res_F1F2_1[i] = Temp_Res_F1F2[i];
    Temp_Res_F1F3_1[i] = Temp_Res_F1F3[i];
    Temp_Res_F1F4_1[i] = Temp_Res_F1F4[i];
    Temp_Res_F1F5_1[i] = Temp_Res_F1F5[i];
  }
}

/*
  判断冻结帧数据是否与期望一致
  Type = 0：期望不变
  Type = 1：期望变化
  Type = 2：期望两组数据一致
  Check_DID = 0:检测全部DID
*/
int _Compara_FixDataSave_Change(byte Type,dword Check_DID)
{
  int x,i,Flage,Return_Value; 
  dword DID_Temp;
  char DID_[10];
  byte Compara[200];
  byte Compara_1[200];
  Return_Value = 0;
  if(Check_DID == 0)
  {
    for(x=0;x<6;x++)
    {
      if(x == 0)
      {
        for(i=0;i<Res_FixData_Len;i++)
        {
          Compara[i] = Temp_Res_F1F0[i];
          Compara_1[i] = Temp_Res_F1F0_1[i];
        }
      }
      else if(x == 1)
      {
        for(i=0;i<Res_FixData_Len;i++)
        {
          Compara[i] = Temp_Res_F1F1[i];
          Compara_1[i] = Temp_Res_F1F1_1[i];
        }
      }
      else if(x == 2)
      {
        for(i=0;i<Res_FixData_Len;i++)
        {
          Compara[i] = Temp_Res_F1F2[i];
          Compara_1[i] = Temp_Res_F1F2_1[i];
        }
      }
      else if(x == 3)
      {
        for(i=0;i<Res_FixData_Len;i++)
        {
          Compara[i] = Temp_Res_F1F3[i];
          Compara_1[i] = Temp_Res_F1F3_1[i];
        }
      }
      else if(x == 4)
      {
        for(i=0;i<Res_FixData_Len;i++)
        {
          Compara[i] = Temp_Res_F1F4[i];
          Compara_1[i] = Temp_Res_F1F4_1[i];
        }
      }
      else if(x == 5)
      {
        for(i=0;i<Res_FixData_Len;i++)
        {
          Compara[i] = Temp_Res_F1F5[i];
          Compara_1[i] = Temp_Res_F1F5_1[i];
        }
      }
      DID_Temp = (Compara[1]<<8) + Compara[2];
      snprintf(DID_,elCount(DID_),"%04X",DID_Temp);
      if(Res_DID_Count == 0)
      {
        if(DID_Temp == Res_DID)
          Return_Value = _Compara_Arry(Type,Compara,Compara_1,Res_FixData_Len,DID_);
        else
          Return_Value = _Compara_Arry(0,Compara,Compara_1,Res_FixData_Len,DID_);
      }
      else
      {
        int k,Check_Flage_;
        Check_Flage_ = 0;
        for(k=0;k<Res_DID_Count;k++)
        {
          if(DID_Temp == Res_DID_[k])
          {
            _Compara_Arry(Type,Compara,Compara_1,Res_FixData_Len,DID_);
            Check_Flage_ = 1;
            break;
          }
        }
        if(Check_Flage_ == 0)
          _Compara_Arry(0,Compara,Compara_1,Res_FixData_Len,DID_);
      }
    }
  }
  return Return_Value;
}

/*
  判断冻结帧数据是否与期望一致
*/
int _Compara_FixDataSave_Change(dword ReadDid,dword Data_Input[],int Len_Input)
{
  int i,Count,Retu; 
  dword DID_Temp;
  char DID_[10];
  byte Compara[200];
  byte Compara_Input[200];
  Retu = 0;
  switch(ReadDid)
  {
    case 0xF1F0:
      for(i=0;i<Res_FixData_Len;i++)
        Compara[i] = Temp_Res_F1F0[i];
      break;
    case 0xF1F1:
      for(i=0;i<Res_FixData_Len;i++)
        Compara[i] = Temp_Res_F1F1[i];
      break;
    case 0xF1F2:
      for(i=0;i<Res_FixData_Len;i++)
        Compara[i] = Temp_Res_F1F2[i];
      break;
    case 0xF1F3:
      for(i=0;i<Res_FixData_Len;i++)
        Compara[i] = Temp_Res_F1F3[i];
      break;
    case 0xF1F4:
      for(i=0;i<Res_FixData_Len;i++)
        Compara[i] = Temp_Res_F1F4[i];
      break;
    case 0xF1F5:
      for(i=0;i<Res_FixData_Len;i++)
        Compara[i] = Temp_Res_F1F5[i];
      break;
    default:
      _WriteEx_and_Report("","未收到正确的DID,即DTC与DID不匹配");
      Retu = -1;
      return Retu;
  }
  snprintf(DID_,elCount(DID_),"%04X",ReadDid);
  for(i=0;i<6;i++)
    Compara_Input[i] = Compara[i];
  Count = 6;  
  for(i=0;i<Len_Input;i++)
  {
    Compara_Input[Count] = Data_Input[i] &0xFF;
    // writeEx(-3,0,"对比数据 Compara_Input[%d] = 0x%02X",Count,Compara_Input[Count]);
    Count++;
  }
  Retu = _Compara_Arry(2,Compara,Compara_Input,Res_FixData_Len,DID_);
  return Retu;
}
/*
  判断冻结帧数据是否与期望一致
  Type = 0：期望不变
  Type = 1：期望变化
  Type = 2：期望两组数据一致
  Len_Check：对比长度
  OutPut：打印输出内容
*/
int _Compara_Arry(byte Type,byte ExData_1[],byte ExData_2[],int Len_Check,char OutPut[])
{
  int Flage,Return_Value;
  Flage = 0;
  Return_Value = 0;
  
  for(i=0;i<Len_Check;i++)
  {
    if(ExData_1[i] != ExData_2[i])
      Flage = 1;
  }
  if(Type == 0)
  {
    if(Flage == 0)
      testStepPass(OutPut,"期望无变化，实际未发生改变");
    else
    {
      Return_Value = -1;
      testStepFail(OutPut,"期望无变化，实际发生改变");
    }
  }
  else if(Type == 1)
  {
    if(Flage == 0)
    {
      Return_Value = -1;
      testStepFail(OutPut,"期望发生变化，实际未发生改变");
    }
    else
      testStepPass(OutPut,"期望发生变化，实际发生改变");
  }
  else if(Type == 2)
  {
    if(Flage == 0)
      testStepPass(OutPut,"期望数据与预期一致,实际一致");
    else
    {
      Return_Value = -1;
      writeEx(-3,0,"%s,返回数据与实际数据不符",OutPut);
      testStepFail(OutPut,"返回数据与实际数据不符");
    }
  }
  return Return_Value;
}


/*
    跳过某个DTC或者某个节点，覆盖目前全部存在的值再确定最后一次值的位置
    Type == 0：输入为ID
    Type == 1：输入为DTC

    Type == 2：倒序覆盖，不使用ID
*/
void DTC_Cover_For_FixDataSave(dword ID,int Type)
{
  int i,j,Count,k,Temp;
  byte Data_Send[3] = {0x22,0xF1,0xF0};
  Count = 0;
  
  for(k=0xF0;k<=0xF5;k++)
  {
    Data_Send[2] = k;
    _Send_Diag(3,phyreq_ID,Data_Send);
    _Check_FixDataSave(1,0);
    testWaitForTimeout(100);
  }
  if(ID != 0 && Type != 2)
  {
    for(i=0;i<FixDataSave_Count+1;i++)
    {
      if(Type == 0 && FixDataSave[i].Node == ID)
        continue;
      for(j=0;j<FixDataSave[i].Error_Type_Count;j++)
      {
        if(Type == 1 && FixDataSave[i].DTC[j] == ID)
          continue;
        if(_Check_Dword_in_Num(FixDataSave[i].DTC[j],DTC_list_F0ToF5,elcount(DTC_list_F0ToF5)) != -1)
          continue;
        if(strncmp(FixDataSave[i].Error_Type[j],"Lost",strlen(FixDataSave[i].Error_Type[j])) == 0 && strlen(FixDataSave[i].Error_Type[j]) == strlen("Lost"))
        { 
          if(FixDataSave[i].Node == Struct_Ready.Sig_Id) //丢失节点跳过发动机情况
            continue;
          _TestDisableMsg(FixDataSave[i].Node);
          testWaitForTimeout(500);
          _TestEnableMsg(FixDataSave[i].Node);
          testWaitForTimeout(500);
          Count++;
        }
        else
        {
          _Set_Sig(FixDataSave[i].SigName[j],FixDataSave[i].Invalid_Value[j]);
          testWaitForTimeout(500);
          _Set_Sig(FixDataSave[i].SigName[j],FixDataSave[i].Normal_Value[j]);
          testWaitForTimeout(500);
          Count++;
        }
        if(Count>=7)
        {
          testWaitForTimeout(500);
          for(k=0xF0;k<=0xF5;k++)
          {
            Data_Send[2] = k;
            _Send_Diag(3,phyreq_ID,Data_Send);
            _Check_FixDataSave(1,0);
            testWaitForTimeout(100);
          }
          Count = _Check_Dword_in_Num(FixDataSave[i].DTC[j],DTC_list_F0ToF5,elcount(DTC_list_F0ToF5));
          FixDataSave_LastPos = (Count != -1)?Count:0; //装载最后一次DTC位置
          Temp = (FixDataSave_LastPos|0xF1F0)+1;
          if(Temp>0xF1F5)
            Temp = 0xF1F0;
          _WriteEx_and_Report("","已完成冻结帧全部值覆盖，记录最后一次值的位置为%04X",Temp);
          return;
        }
      }
    }
  }
  else if(Type == 2)
  {
    for(i=FixDataSave_Count;i>0;i--)
    {
      for(j=FixDataSave[i].Error_Type_Count-1;j>0;j--)
      {
        if(_Check_Dword_in_Num(FixDataSave[i].DTC[j],DTC_list_F0ToF5,elcount(DTC_list_F0ToF5)) != -1)
          continue;
        if(strncmp(FixDataSave[i].Error_Type[j],"Lost",strlen(FixDataSave[i].Error_Type[j])) == 0 && strlen(FixDataSave[i].Error_Type[j]) == strlen("Lost"))
        { 
          if(FixDataSave[i].Node == Struct_Ready.Sig_Id) //丢失节点跳过发动机情况
            continue;
          _TestDisableMsg(FixDataSave[i].Node);
          testWaitForTimeout(500);
          _TestEnableMsg(FixDataSave[i].Node);
          testWaitForTimeout(500);
          Count++;
        }
        else
        {
          _Set_Sig(FixDataSave[i].SigName[j],FixDataSave[i].Invalid_Value[j]);
          testWaitForTimeout(500);
          _Set_Sig(FixDataSave[i].SigName[j],FixDataSave[i].Normal_Value[j]);
          testWaitForTimeout(500);
          Count++;
        }
        if(Count>=7)
        {
          testWaitForTimeout(500);
          for(k=0xF0;k<=0xF5;k++)
          {
            Data_Send[2] = k;
            _Send_Diag(3,phyreq_ID,Data_Send);
            _Check_FixDataSave(1,0);
            testWaitForTimeout(100);
          }
          Count = _Check_Dword_in_Num(FixDataSave[i].DTC[j],DTC_list_F0ToF5,elcount(DTC_list_F0ToF5));
          FixDataSave_LastPos = (Count != -1)?Count:0; //装载最后一次DTC位置
          if(Count == -1)
            _WriteEx_and_Report("","最后一次位置未在返回中，后续位置不可信");
          Temp = (FixDataSave_LastPos|0xF1F0)+1;
          if(Temp>0xF1F5)
            Temp = 0xF1F0;
          _WriteEx_and_Report("","已完成冻结帧全部值覆盖，记录最后一次值的位置为%04X",Temp);
          return;
        }
      }
    }
  }
}

/*
    查找输入信息所在结构体位置
    ID_Pos 返回ID所在位置
    Type == 0：节点输入
    Type == 1：DTC输入
*/
int ID_PosFromStruct(dword ID,int ID_Pos,int Type)
{
  int i,j;
  for(i=0;i<FixDataSave_Count+1;i++)
  {
    ID_Pos = i;
    if(Type == 0)
    {
      if(FixDataSave[i].Node == ID)
        return i;
    }
    else if(Type == 1)
    {
      for(j=0;j<FixDataSave[i].Error_Type_Count;j++)
      {
        if(ID == FixDataSave[i].DTC[j])
          return j;
      }
    }
  }
  if(Type == 0)
    _WriteEx_and_Report("","未查询到%X节点输入位置",ID);
  else if(Type == 1)
    _WriteEx_and_Report("","未查询到0x%X DTC输入位置",ID);
  return 0;
}
/*
      对指定DID数据进行覆盖
      指定的DID     对应的DTC
      装载的纯数据DataGet   长度Len
*/
void Cover_Arry(dword DID,dword DTC,byte DataGet[],int Len)
{
  int i;
  byte DataBefor[6];
  DataBefor[0] = 0x62;             DataBefor[1] = ((DID>>8)&0xFF);
  DataBefor[2] = (DID&0xFF);       DataBefor[3] = ((DTC>>16)&0xFF);
  DataBefor[4] = ((DTC>>8)&0xFF);  DataBefor[5] = ((DTC>>0)&0xFF);
  for(i=0;i<Len+6;i++)
  {
    switch(DID)
    {
      case 0xF1F0:
        Temp_Res_F1F0_1[i] = (i<6)?DataBefor[i]:DataGet[i-6];break;
      case 0xF1F1:
        Temp_Res_F1F1_1[i] = (i<6)?DataBefor[i]:DataGet[i-6];break;
      case 0xF1F2:
        Temp_Res_F1F2_1[i] = (i<6)?DataBefor[i]:DataGet[i-6];break;
      case 0xF1F3:
        Temp_Res_F1F3_1[i] = (i<6)?DataBefor[i]:DataGet[i-6];break;
      case 0xF1F4:
        Temp_Res_F1F4_1[i] = (i<6)?DataBefor[i]:DataGet[i-6];break;
      case 0xF1F5:
        Temp_Res_F1F5_1[i] = (i<6)?DataBefor[i]:DataGet[i-6];break;
    }
  }
}

void FixDataSave_1(dword ID,byte Session)  /*烧录完程序后读取冻结帧默认值*/
{
  byte Data_Send[3] = {0x22,0xF1,0xF0};
  int i;
  for(i=0xF0;i<=0xF5;i++)
  {
    Data_Send[2] = i;
    _Send_Diag(3,ID,Data_Send);
    _Check_FixDataSave(0,0);
    testWaitForTimeout(100);
  }
}

void FixDataSave_2(dword ID,byte Session)  /*存储机制测试*/
{
  byte SendData2E[6] = {0x2E,0x01,0x00,0x01,0xFF,0x07}; 
  byte SendData22Read[3] = {0x22,0x01,0x00}; 
  byte Data_Send[3] = {0x22,0xF1,0xF0};
  byte DataGet[200];
  int ID_Pos,DTC_Pos,ReLen,i;
  dword DTC = 0xE21187;

  testWaitForTimeout(1000);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  _unlockECU();
  _Send_Diag(elcount(SendData2E),phyreq_ID,SendData2E);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(elcount(SendData22Read),phyreq_ID,SendData22Read);
  _Check_Response_Config(SendData,SendData2E);
  testWaitForTimeout(1000);
  _85_Check_DTC(1,0);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(3000);
  DTC_Cover_For_FixDataSave(DTC,1);
  _Save_Arry_FixData();
  DTC_Pos = ID_PosFromStruct(DTC,ID_Pos,1);
  ReLen = DataGet_ByDTC(DTC,15,10,5,DataGet);
  Res_DID = ((FixDataSave_LastPos+1)|0xF1F0);
  if(Res_DID>0xF1F5)
    Res_DID = 0xF1F0;
  _85_Check_DTC(9,DTC);
  
  Cover_Arry(Res_DID,DTC,DataGet,ReLen);
  for(i=0xF0;i<=0xF5;i++)
  {
    Data_Send[2] = i;
    _Send_Diag(3,ID,Data_Send);
    _Check_FixDataSave(1,0);
    testWaitForTimeout(100);
  }
  _Compara_FixDataSave_Change(2,0);
  ReLen = DataGet_ByDTC(DTC,11,10,5,DataGet);
  Cover_Arry(Res_DID,DTC,DataGet,ReLen);
  for(i=0xF0;i<=0xF5;i++)
  {
    Data_Send[2] = i;
    _Send_Diag(3,ID,Data_Send);
    _Check_FixDataSave(1,0);
    testWaitForTimeout(100);
  }
  _Compara_FixDataSave_Change(2,0);
}

