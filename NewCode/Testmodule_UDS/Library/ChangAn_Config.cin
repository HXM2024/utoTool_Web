void FixDataSave_5(dword ID,byte Session)  /*重启,上下点火异常工况测试*/
{
  byte Data_Send[3] = {0x22,0xF1,0xF0};
  byte DataGet[200];
  int ID_Pos,DTC_Pos,ReLen,TempPos,i;
  dword DTC = 0xE21681;

  testWaitForTimeout(1000);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(500);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(3000);
  DTC_Cover_For_FixDataSave(DTC,1);
  _Save_Arry_FixData();
  DTC_Pos = ID_PosFromStruct(DTC,ID_Pos,1);
  ReLen = DataGet_ByDTC(DTC,15,10,5,DataGet);
  Res_DID = ((FixDataSave_LastPos+1)|0xF1F0);
  if(Res_DID>0xF1F5)
    Res_DID = 0xF1F0;
  _85_Check_DTC(9,DTC);
  Cover_Arry(Res_DID,DTC,DataGet,ReLen);
  for(i=0xF0;i<=0xF5;i++)
  {
    Data_Send[2] = i;
    _Send_Diag(3,ID,Data_Send);
    _Check_FixDataSave(1,0);
    testWaitForTimeout(100);
  }
  _Compara_FixDataSave_Change(2,0);
  _Save_Arry_FixData();
  _Set_11_Restoration();
  for(i=0xF0;i<=0xF5;i++)
  {
    Data_Send[2] = i;
    _Send_Diag(3,ID,Data_Send);
    _Check_FixDataSave(1,0);
    testWaitForTimeout(100);
  }
  _Compara_FixDataSave_Change(0,0);

  DTC = 0xE21486; 
  TempPos = _Check_Dword_in_Num(DTC,DTC_list_F0ToF5,elcount(DTC_list_F0ToF5)); 
  Res_DID = ( TempPos != -1)?(Res_DID+1):(TempPos|0xF1F0);//检测该DTC是否在返回中，不在则位置+1，在则直接返回原位置
  if(Res_DID>0xF1F5)
    Res_DID = 0xF1F0;
  ReLen = DataGet_ByDTC(DTC,11,10,5,DataGet);
  Cover_Arry(Res_DID,DTC,DataGet,ReLen);
  for(i=0xF0;i<=0xF5;i++)
  {
    Data_Send[2] = i;
    _Send_Diag(3,ID,Data_Send);
    _Check_FixDataSave(1,0);
    testWaitForTimeout(100);
  }
  _Compara_FixDataSave_Change(2,0);
  _Save_Arry_FixData();
  _Power_Down();
  testWaitForTimeout(3000);
  _Power_Up();
  for(i=0xF0;i<=0xF5;i++)
  {
    Data_Send[2] = i;
    _Send_Diag(3,ID,Data_Send);
    _Check_FixDataSave(1,0);
    testWaitForTimeout(100);
  }
  _Compara_FixDataSave_Change(0,0);
}


