  dword DTC_list_F0ToF5[6];
  int FixDataSave_LastPos;
}
void Init_ChangAn_Config()
{
  int i;
  Init_Main_Special("\\长安_配置字\\",exsession);  
  _get_Arry("Config_ALL");
  for(i=0;i<3;i++)
    Write_Config_ChangAn[i] = Arry_Data[i];
  for(i=3;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  _get_Arry("Read_Config");
  for(i=0;i<3;i++)
    Read_Config_ChangAn[i] = Arry_Data[i];
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_11_Restoration();
  testWaitForTimeout(1000);
  _WriteEx_and_Report("","/*----------------开始测试----------------*/");
}
void Init_ChangAn_Config(byte Type)
{
  int i;
  Init_Main_Special("\\长安_配置字\\",exsession);  
  _get_Arry("Config_ALL");
  for(i=0;i<3;i++)
    Write_Config_ChangAn[i] = Arry_Data[i];
  for(i=3;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  _get_Arry("Read_Config");
  for(i=0;i<3;i++)
    Read_Config_ChangAn[i] = Arry_Data[i];
}
void End_CCAG()
{
  int i;
  for(i=0;i<6;i++)
    Res_DID_[i] = 0;
  Res_DID_Count = 0;
  Res_DID = 0;
  End_Main();
}

void Init_Main_Def_ChangAn()
{
  Init();
  _Start();
  testWaitForTimeout(50);
  _SetSession(defsession);
}

void Config_Default_ChangAn()
{
  dword DTC_Ex[100];
  int i;
  for(i=3;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  _85_Check_DTC(1,Unconfigured);
  _Close_All_Advanced_function();
  testWaitForTimeout(5000);
  _85_Check_DTC(1,Unconfigured);
  _Open_All_Advanced_function();
}
void Config_ALL_ChangAn()
{
  dword DTC_Ex[100];
  int i;
  _get_Arry("Config_ALL");
  for(i=0;i<Arry_Len;i++)
    Write_Config_ChangAn[i] = Arry_Data[i];
  _Close_All_Advanced_function();
  testWaitForTimeout(2000);
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  if(DTC_IsRest == 0)
    _85_Check_DTC(1,0);
  else
    _85_Check_DTC(1,Unconfigured);
  _Set_11_Restoration();
  testWaitForTimeout(CAN_Init_Time+2000);
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  _Advanced_function_DTC(Write_Config_ChangAn,DTC_Ex);
  _Check_DTC(1,DTC_Ex);
  _Open_All_Advanced_function();
  testWaitForTimeout(2000);
}
void Config_DTC_ChangAn()
{
  dword DTC_Ex[100];
  int i;
  Write_Config_ChangAn[3] = 0;
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  _Set_11_Restoration();
  testWaitForTimeout(CAN_Init_Time+2000);
  _85_Check_DTC(1,Unconfigured);
  
  Write_Config_ChangAn[3] = 1;
  for(i=4;i<Config_Len;i++)
    Write_Config_ChangAn[i] = 0;
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_ChangAn);
  _Set_11_Restoration();
  testWaitForTimeout(CAN_Init_Time+2000);
  _85_Check_DTC(1,0);
}
void Config_Byte0_ChangAn() /*整车调试参数*/
{
  dword DTC_Ex[100];
  int i;
  byte Temp,j;
  Temp = (Write_Config_ChangAn[3]&0xF0);
  _Close_All_Advanced_function();
  testWaitForTimeout(2000);
  for(j=1;j<3;j++)
  {
    for(i=4;i<Config_Len;i++)
      Write_Config_ChangAn[i] = 0;
    Write_Config_ChangAn[3] = (Temp|j);
    _unlockECU();
    _Send_Diag(Config_Len,phyreq_ID,Write_Config_ChangAn);
    _TestResult(SendData,phyreq_ID,"",-1);
    _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
    _TestResult(SendData,phyreq_ID,"",-1);
    _Check_Response_Config(SendData,Write_Config_ChangAn);
    _Set_11_Restoration();
    _Send_Diag(3,phyreq_ID,Read_Config_ChangAn);
    _TestResult(SendData,phyreq_ID,"",-1);
    _Check_Response_Config(SendData,Write_Config_ChangAn);
    _85_Check_DTC(1,0);
  }
  _Open_All_Advanced_function();
  testWaitForTimeout(2000);
}
