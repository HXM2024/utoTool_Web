_2100_config_21(byte type) /*否定响应码测试*/
{
  byte data[3] = {0x40,0x04,0x00};
  byte data_2[3] = {0x80,0x04,0x00};
  byte data_3[3] = {0xc0,0x00,0x00};
  byte data_4[3] = {0x00,0x80,0x00};
  byte data_5[3] = {0x00,0x08,0x02};
  byte data_6[3] = {0x82,0x39,0x00};
  char Temp_Str[50];
  snprintf(Temp_Str,elCount(Temp_Str),"%s_Functional",Cdd_Name_3);
  diagStartTesterPresent(Temp_Str);
  testStep("","擦除配置字并重启");
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  testStep("","写入预期配置字");
  _BYD_unlockECU();
  _Send_BYD_Config(type,data,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x31);
  _Check_ReadConfig(0,data);
  
  testWaitForTimeout(1000);
  _Send_BYD_Config(type,data_2,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x31);
  _Check_ReadConfig(0,data_2);
  
  testWaitForTimeout(1000);
  _Send_BYD_Config(type,data_3,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x31);
  _Check_ReadConfig(0,data_3);
  
  testWaitForTimeout(1000);
  _Send_BYD_Config(type,data_4,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x31);
  _Check_ReadConfig(0,data_4);
  
  testWaitForTimeout(1000);
  _Send_BYD_Config(type,data_5,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x31);
  _Check_ReadConfig(0,data_5);
  
  testWaitForTimeout(1000);
  _Send_BYD_Config(type,data_6,0);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x10);
  _Check_ReadConfig(0,data_6);
  diagStopTesterPresent(Temp_Str);
}
_2100_config_22() /*否定响应码测试*/
{
  byte data[3] = {0x81,0x39,0x10};
  byte data1[3] = {0x82,0x39,0x10};
  byte data_1[11] = {0x2E,0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte data_2[11] = {0x2E,0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x55};
  byte data_3[11] = {0x2E,0x21,0x00,0xff,0xff,0xff,0xff,0xff,0xff,0xff,0xff};
  char Temp_Str[50];
  snprintf(Temp_Str,elCount(Temp_Str),"%s_Functional",Cdd_Name_3);
  diagStartTesterPresent(Temp_Str);
  testStep("","擦除配置字并重启");
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  testStep("","写入预期配置字");
  _BYD_unlockECU();
  _Send_BYD_Config(0,data,1);
  _Check_ReadConfig(1,data);
  
  _Send_Diag(11,@DID::phyreq_ID,data_1);
  _TestResult(SendData,@DID::phyreq_ID,"",0x22);
  _Check_ReadConfig(1,data);
  _Send_Diag(11,@DID::phyreq_ID,data_2);
  _TestResult(SendData,@DID::phyreq_ID,"",0x22);
  _Check_ReadConfig(1,data);
  _Send_Diag(11,@DID::phyreq_ID,data_3);
  _TestResult(SendData,@DID::phyreq_ID,"",0x22);
  _Check_ReadConfig(1,data);
  
  _Send_BYD_Config(0,data1,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x22);
  _Check_ReadConfig(1,data);
  
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Send_Diag(11,@DID::phyreq_ID,data_1);
  _TestResult(SendData,@DID::phyreq_ID,"",0x10);
  
  _Send_Diag(11,@DID::phyreq_ID,data_2);
  _TestResult(SendData,@DID::phyreq_ID,"",0x31);
  
  _Send_Diag(11,@DID::phyreq_ID,data_3);
  _TestResult(SendData,@DID::phyreq_ID,"",0x31);
  diagStopTesterPresent(Temp_Str);
}

_F1A1_Default_Config()
{
