testcase Case_F1A1_config_0()/*遍历默认配置车型*/
{
  int i;
  Init_Config();
  for(i=0;i<Default_Config_Count;i++)
  {
    writeEx(-3,0,"/---------------------------------------/");
    writeEx(-3,0,"               %s               ",Default_Config[i].Str_Config);
    writeEx(-3,0,"/---------------------------------------/");
    teststep("","/---------------------------------------/");
    teststep("开始测试",Default_Config[i].Str_Config);
    teststep("","/---------------------------------------/");
    _2100_config_0(Default_Config[i].Data_Config_Send,Default_Config[i].Str_Config,i,1);
  }
  End_Config();
}
