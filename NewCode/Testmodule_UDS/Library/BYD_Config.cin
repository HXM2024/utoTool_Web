  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  _Check_ReadConfig(1,data);
  _Check_DTC_Som(ExDTC);
  _open_node();
  _Check_Fun("LKA_Ang",1);
  _Check_Fun("DST",1);
