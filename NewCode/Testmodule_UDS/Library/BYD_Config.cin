_Other_BYD_05()
{
  byte data[2]={0x85,0x82};
  dword Ex[1];
  _SetSession(3);
  testDisableMsg(DTC_19[1][0]);
  _WriteEx_and_Report("","丢失节点 0x%03X",DTC_19[1][0]);
  testWaitForTimeout(DTC_19[1][3]*0.5);
  _Send_01_Fault(phyreq_ID);
  _Send_Diag(2,@DID::funreq_ID,data);
  _Check_Response_DTC(Diag01,Ex);
  testWaitForTimeout(DTC_19[1][3]*0.6);
  _85_Check_DTC(1,0);
  testEnableMsg(DTC_19[1][0]);
  testWaitForTimeout(5000);
}
_Other_BYD_06()
{
  byte data[3]={0x28,0x83,0x03};
  _SetSession(3);
  _Send_Diag(3,@DID::funreq_ID,data);
  _TestResult(BYD_Config,@DID::funreq_ID,"",0);
  testWaitForTimeout(200);
  data[1] = 0x80;
  _Send_Diag(3,@DID::funreq_ID,data);
  _TestResult(BYD_Config,@DID::funreq_ID,"",0);
  if(testWaitForMessage(EPS_TxID_1,1000)==1)
    testStepPass("","时间小于1s");
  else
    testStepFail("","时间大于1s");
}
_Other_BYD_07()
{
  byte data[3]={0x28,0x83,0x03};
  _SetSession(3);
  _Send_Diag(3,@DID::funreq_ID,data);
  _TestResult(BYD_Config,@DID::funreq_ID,"",0);
  testWaitForTimeout(200);
  if(testWaitForMessage(EPS_TxID_1,1000)==1)
    testStepFail("","发送28 83 03后仍然在外发报文");
  else
    testStepPass("","外发报文停发");
  _Set_11_Restoration_BYD();
  if(testWaitForMessage(EPS_TxID_1,2000)==1)
    testStepPass("","外发报文外发时间小于2s");
  else
    testStepFail("","外发报文外发时间大于2s");
}
_BYD_34_Serve(dword ID,byte Session)
{
  byte Da[2]={0x34,0x00};
  _Send_Diag(2,ID,Da);
  _TestResult(SendData,ID,"",0x7F);
}
_BYD_36_Serve(dword ID,byte Session)
{
  byte Da[63],i;
  Da[0] = 0x36;
  for(i=1;i<63;i++)
  {
    Da[i] = 0;
  }
  _Send_Diag(63,ID,Da);
  _TestResult(SendData,ID,"",0x7F);
}
_BYD_37_Serve(dword ID,byte Session)
{
  byte Da[2]={0x37,0x00};
  _Send_Diag(2,ID,Da);
  _TestResult(SendData,ID,"",0x7F);
}



testcase Case_2100_config_0()/*遍历默认配置车型*/
{
  int i;
  Init_Config();
  for(i=0;i<Default_Config_Count;i++)
  {
    writeEx(-3,0,"/---------------------------------------/");
    writeEx(-3,0,"               %s               ",Default_Config[i].Str_Config);
    writeEx(-3,0,"/---------------------------------------/");
    teststep("","/---------------------------------------/");
    teststep("开始测试",Default_Config[i].Str_Config);
    teststep("","/---------------------------------------/");
    _2100_config_0(Default_Config[i].Data_Config_Send,Default_Config[i].Str_Config,i,0);
  }
  End_Config();
}
