variables
{
  dword glbHandle12;
  char ECU_project3[50];
  
  
  byte ADS_Torque;
  byte LKA_Ang;
  byte DST;
  byte tune;
  byte Auto_Driver;
  byte Vehicle_Category;
  byte RCS;
  byte SFS;
  byte ATS;
  byte LKA_Torque;
  byte APA;
  byte LDW;
  byte ADS_Ang;
  byte SVC;
  byte SAC;
  byte SMS;
  byte VOT;
  byte Car_Config[4];
  diagRequest *BYD_Config;
  diagRequest *ReadData;
  dword LKA_Ang_ID = 0x1FC;
  dword LKA_Torque_ID = 0x318;
  dword APA_ID = 0x135;
  dword DST_ID = 0x27F;
  dword ADS_ID = 0x06D;
  dword SVC_SAC_ID = 0x094;
  dword Lose_0x1E2_DTC ;
  dword Lose_0x27E_DTC ;
  dword Lose_0x410_DTC ;
  dword Lose_0x240_DTC ;
  dword Lose_0x134_DTC ;
  dword Lose_0x057_DTC ;
  dword Lose_0x316_DTC ;
  char Cdd_Name_3[50];
  
  
