void _2100_config_17(byte type) /*配置高阶ADS方案多级振感功能（扭矩）*/
{
  byte data[3] = {0x81,0x01,0x00};
  testStep("","擦除配置字并重启");
  _lost_node();
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  testStep("","写入预期配置字");
  _BYD_unlockECU();
  _Send_BYD_Config(type,data,1);
  _Check_ReadConfig(1,data);
  _Check_DTC(0);
  _open_node();
  _Check_Fun("ADS_Torque",0);
  _Check_Fun("ADS_LDW",0);
  
  testStep("","第一次检测完毕并重启");
  _lost_node();
  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  _Check_ReadConfig(1,data);
  _Check_DTC(Lose_0x057_DTC);
  _open_node();
  _Check_Fun("ADS_Torque",1);
  _Check_Fun("ADS_LDW",1);
}
