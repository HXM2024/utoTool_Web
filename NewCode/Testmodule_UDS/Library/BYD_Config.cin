_F1A1_config_1() /*配置字擦除*/
{
  byte data[3] = {0x81,0x39,0x10};
  byte data_1[3] = {0x82,0x39,0x10};
  _lost_node();
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  
  testStep("","写入预期配置字,开始测试");
  _Send_BYD_Config(1,data,1);
  _Set_11_Restoration_BYD();
  _Check_ReadConfig(1,data);
   
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_Fun("ADS_Torque",0);
  _Check_ReadConfig(0,data);
  _Set_11_Restoration_BYD();
  _Check_DTC(Unconfigured);
  
  _BYD_unlockECU();
  _Send_BYD_Config(1,data_1,1);
  _Set_11_Restoration_BYD();
  _Check_ReadConfig(1,data_1);
  
  _BYD_unlockECU();
  _Clear_BYD_Config(1);
  _Check_Fun("ADS_Torque",0);
  _Check_ReadConfig(0,data_1);
  _Set_11_Restoration_BYD();
  _Check_DTC(Unconfigured);
  
  _open_node();
}
_F1A1_config_2() /*否定响应码测试*/
{
  byte data[3] = {0x80,0x04,0x00};
  byte data_1[3] = {0xc0,0x00,0x00};
  byte data_2[3] = {0x01,0x38,0x00};
  byte data_4[3] = {0x01,0x39,0x00};
  byte data_5[3] = {0x00,0x80,0x00};
  byte data_6[3] = {0x00,0x08,0x02};
  byte data_7[3] = {0x82,0x39,0x00};
  byte data_3[11] = {0x2E,0xF1,0xA1,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  
  char Temp_Str[50];
  snprintf(Temp_Str,elCount(Temp_Str),"%s_Functional",Cdd_Name_3);
  diagStartTesterPresent(Temp_Str);
  testStep("","擦除配置字并重启");
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  testStep("","写入预期配置字");
  _BYD_unlockECU();
  _Send_BYD_Config(1,data,1);
  _Check_ReadConfig(0,data);
  
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Send_BYD_Config(1,data_1,1);
  _Check_ReadConfig(0,data);
  
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Send_BYD_Config(1,data_2,1);
  _Check_ReadConfig(1,data_2);
  _Send_Diag(11,@DID::phyreq_ID,data_3);
  _TestResult(SendData,@DID::phyreq_ID,"",0x22);
  _Check_ReadConfig(1,data_2);
  _Send_BYD_Config(1,data_4,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x22);
  _Check_ReadConfig(1,data_2);
  
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Send_Diag(11,@DID::phyreq_ID,data_3);
  _TestResult(SendData,@DID::phyreq_ID,"",0x10);
  _Check_ReadConfig(0,data_2);
  
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Send_BYD_Config(1,data_5,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x31);
  _Check_ReadConfig(0,data_2);
  
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Send_BYD_Config(1,data_6,1);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x31);
  _Check_ReadConfig(0,data_2);
  
  _Clear_BYD_Config(0);
  _Check_ReadConfig(0,data);
  _Send_BYD_Config(1,data_7,0);
  _TestResult(BYD_Config,@DID::phyreq_ID,"",0x10);
  _Check_ReadConfig(0,data_2);
  
  diagStopTesterPresent(Temp_Str);
}

_Other_BYD_01()
