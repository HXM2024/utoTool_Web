}
void End_Config()
{
  stopLogging();
  testWaitForTimeout(1000);
}

void _2100_config_0(byte Input[],char _Str[],int POS,byte type) /*默认车型配置遍历  0:21 00  1:F1 A1*/
{
  byte data[11];
  int i;
  dword ExDTC[50],ExDTC_Count;
  for(i=3;i<11;i++)
    data[i] = Input[i-3];
  data[0] = 0x2E;
  if(type == 0)
  {
    data[1] = 0x21;
    data[2] = 0x00;
  }
  else
  {
    data[1] = 0xF1;
    data[2] = 0xA1;
  }
  ExDTC_Count = 0;
  Init_BYD_Config_Fun(Input);
  testStep(_Str,"擦除配置字并重启");
  _lost_node();
  _BYD_unlockECU();
  _Clear_BYD_Config(0);
  _Check_ReadConfig_(0,data);
  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  testStep("","写入预期配置字");
  _BYD_unlockECU();
  _Send_Diag(11,@DID::phyreq_ID,data);
  _TestResult(SendData,@DID::phyreq_ID,"",-1);
  _Check_ReadConfig_(1,data);
  _Check_DTC(0);
  _open_node();
  for(i=0;i<Config_Fun_Count;i++)
  {
    _Check_Fun(Config_Fun[i].Str_Fun,0);
    if(Config_Fun[i].Exist != 0)
    {
      ExDTC[ExDTC_Count] = Config_Fun[i].DTC;
      ExDTC_Count++;
    }
  }
  testStep(_Str,"第一次检测完毕并重启");
  
  _lost_node();
  _Set_11_Restoration_BYD();
  testWaitForTimeout(4500);/*BYD上电3s内不检测网络故障*/
  _Check_ReadConfig_(1,data);
  _Check_DTC_Som_(ExDTC,ExDTC_Count);
  _open_node();
  for(i=0;i<Config_Fun_Count;i++)
    _Check_Fun(Config_Fun[i].Str_Fun,1);
  
}
