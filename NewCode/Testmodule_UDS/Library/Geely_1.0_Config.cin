/*@!Encoding:936*/

variables
{
  byte Read_Config_Geely1_0[3] = {0x22,0xF1,0x01};
  byte Write_Config_Geely1_0[255];
}

void Init_Geely1_0_Config()
{
  int i;
  Init_Main_Special("\\Geely1.0_配置字\\",exsession);
  _get_Arry("Config_ALL");
  for(i=0;i<3;i++)
    Write_Config_Geely1_0[i] = Arry_Data[i];
  for(i=3;i<Config_Len;i++)
    Write_Config_Geely1_0[i] = 0;
  _get_Arry("Read_Config");
  for(i=0;i<3;i++)
    Read_Config_Geely1_0[i] = Arry_Data[i];
}

void Config_MPV()
{
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_Geely1_0);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(3,phyreq_ID,Read_Config_Geely1_0);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Geely1_0);
  _Set_11_Restoration();
  _Send_Diag(3,phyreq_ID,Read_Config_Geely1_0);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Geely1_0);
  _85_Check_DTC(1,Unconfigured);
}
