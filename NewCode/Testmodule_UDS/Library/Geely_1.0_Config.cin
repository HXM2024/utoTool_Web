void Config_DrvMode()
{
  dword DTC_Ex[10];
  int i;
  Write_Config_Geely1_0[4] = 0x08;
  _unlockECU();
  _Send_Diag(Config_Len,phyreq_ID,Write_Config_Geely1_0);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Send_Diag(3,phyreq_ID,Read_Config_Geely1_0);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Geely1_0);
  _Set_11_Restoration();
  _Send_Diag(3,phyreq_ID,Read_Config_Geely1_0);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Check_Response_Config(SendData,Write_Config_Geely1_0);
  _Close_All_Advanced_function();
  testWaitForTimeout(CAN_Init_Time+2000);
  _Advanced_function_DTC(Write_Config_Geely1_0,DTC_Ex);
  _Check_DTC(1,DTC_Ex);
  _Open_All_Advanced_function();
  testWaitForTimeout(2000);
}
