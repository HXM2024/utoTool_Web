void CCP_33()  /*报故障码的前提条件-电压9_18V*/
{
  dword DTC_CCP[2];
  byte Send_Data[3];
  int Fun_DIDPos;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(0xD111);
  
  if(Fun_DIDPos!= -1)
  {
    Send_Data[0] = 0x22;
    Send_Data[1] = DID_Function[Fun_DIDPos].DID_Byte[0];
    Send_Data[2] = DID_Function[Fun_DIDPos].DID_Byte[1];
  }

  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Clear_CCP_Config();

  _Set_Battery(8.9);
  if(Fun_DIDPos!= -1)
    Check_ReadFunDID(Send_Data,Fun_DIDPos,phyreq_ID,1,8.8,0,0);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(CCP_Time);
   _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Battery(9.3);
  if(Fun_DIDPos!= -1)
    Check_ReadFunDID(Send_Data,Fun_DIDPos,phyreq_ID,1,9.3,0,0);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
  _Clear_DTC(phyreq_ID);

  _Set_Ready(0);
  testWaitForTimeout(500);
  _Set_Battery(18.3);
  if(Fun_DIDPos!= -1)
    Check_ReadFunDID(Send_Data,Fun_DIDPos,phyreq_ID,1,18.3,0,0);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(CCP_Time);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);


  _Set_Battery(17.9);
  if(Fun_DIDPos!= -1)
    Check_ReadFunDID(Send_Data,Fun_DIDPos,phyreq_ID,1,17.9,0,0);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
  _Clear_DTC(phyreq_ID);

  _Set_Battery(12);
}

