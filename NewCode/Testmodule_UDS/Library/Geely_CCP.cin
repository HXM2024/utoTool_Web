void CCP_20()  /*无效值覆盖_CCP[1]=00_所有CCP=FF(GEEA3.5)*/
{
  dword DTC_CCP[2];
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Clear_CCP_Config();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(3000);
  sendccp(ccpNums[0],0);
  testWaitForTimeout(CCP_Time-3000);
  E103(ccpNums[0],1,0);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
  
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(1000);
  E103(ccpNums[0],1,0);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);
  
  _Set_Ready(0);
  testWaitForTimeout(1000);
  _K15_OFF();
  testWaitForTimeout(K15_OFF_Time);
  _K15_ON();
  testWaitForTimeout(2000);
  _Check_E103_ALL_0();

  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(10000);
  Sendccp(0x09);
  testWaitForTimeout(4000);
  _Check_E103_ALL_0();
  testWaitForTimeout(CCP_Time-14000);
  _Check_E103_Invalid(1);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
  
  _Set_Ready(1);
  _Check_E103_Invalid(1);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
  _Set_Ready(Struct_Ready.Ready_Active);
  _Check_E103_ALL_0();
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
}

