void CCP_14()  /*先有效后无效*/
{
  _Clear_CCP_Config();

  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(24000);
  Sendccp(2);
  testWaitForTimeout(CCP_Time-23000);
  _Check_E103_Invalid(1);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
}

void CCP_15()  /*改变Useage mode(0x2E0)*/
{
  int j,i;
  int Ready_InActiveValue[3] = {0,1,2};
  int Ready_ActiveValue[2] = {11,13};
  _Clear_CCP_Config();

  for(j=0;j<elcount(Ready_ActiveValue);j++)
  {
    for(i=0;i<elcount(Ready_InActiveValue);i++)
    {
      _Set_Ready(Ready_ActiveValue[j]);
      testWaitForTimeout(24000);
      Sendccp(2);
      testWaitForTimeout(CCP_Time-24000);
      _Check_E103_Invalid(1);
      _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
      _Set_Ready(Ready_InActiveValue[i]);
      testWaitForTimeout(1000);
      _Set_Ready(Ready_ActiveValue[j]);
      testWaitForTimeout(5000);
      Sendccp(0);
      testWaitForTimeout(CCP_Time-5000);
      _Check_E103_ALL_0();
      _Check_DTC_Res_InHis_NotNowOrHis(9,0xE30056,0xE30055);
      _Set_Ready(0);
      testWaitForTimeout(1000);
    }
  }
}

