/*
  Type用于区分3.0/3.5策略
  Type = 0: 3.0策略，按照接收CCP顺序记录无效值
  Type = 1: 3.5策略，从小到大重新排列CCP记录无效值
*/
void CCP_25(byte Type)  /*无效值覆盖（随机无效值被有效值覆盖）*/
{
  dword DTC_CCP[2];
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Clear_CCP_Config();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(22000);
  SendccpRandom(1);
  testWaitForTimeout(CCP_Time-22000);
  if(Type == 1)
    _Sort_InPut_Arry(Send_Invaild_CCP,Send_Invaild_CCP_Count,elcount(Send_Invaild_CCP));
  _Check_E103_Invalid(1);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);

  _Set_Ready(0);
  testWaitForTimeout(1000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(22000);
  Sendccp(0);
  testWaitForTimeout(CCP_Time-22000);
  _Check_E103_ALL_0();
  _Check_DTC_Res_InHis_NotNowOrHis(9,0xE30056,0xE30055);
}

void CCP_26(byte Type)  /*无效CCP参数记录_仅记录前10个*/
