/*@!Encoding:936*/
includes
{
  #include "CCP_Config.cin"
  #include "Geely_CCP_VauleTestCase.cin"
}

variables
{
  Byte Get_CCP[3];
  dword CCP_Time = 32000; //CCP故障被诊断时间
  dword CCP_Lost_Invalid[2][20];
}

_Init_CCP_()
{
  Init();
  Get_CCP[0] = 0x22;
  Get_CCP[1] = 0xE1;
  Get_CCP[2] = 0x03;
  init_CCP_ALL();
  Send_Invaild_CCP_Plural_Count = 0;
  Send_Invaild_CCP_Count = 0;
  Send_Vaild_CCP_Plural_Count = 0;
  _Set_Ready(0);
  testWaitForTimeout(200);
  ccpNumscount = elcount(ccpNums);
}

void CCP_1()  /*没有接收到VCP信号-默认状态*/
{
  _Clear_CCP();
  _Set_Ready(0);
  testWaitForTimeout(500);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(CCP_Time);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30055,0xE30056);
}

void CCP_2()  /*没有接收到完整的VCP信号*/
{
  _Clear_CCP();
  _Set_Ready(0);
  testWaitForTimeout(500);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(3000);
  Sendccp(1);
  testWaitForTimeout(CCP_Time);
  _Check_E103_ALL_0();
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30055,0xE30056);
}

void CCP_3()  /*无效的VCP信号接收*/
{
  dword DTC_CCP[2];
  _Clear_CCP();
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Set_Ready(0);
  testWaitForTimeout(500);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(24000);
  Sendccp(2);
  testWaitForTimeout(CCP_Time-24000);
  _Check_DTC_Res_NowOrHis(9,1,0,DTC_CCP);
  _Check_E103_Invalid(1);
}

void CCP_4()  /*无效的某个CCP信号接收*/
{
  dword DTC_CCP[2];
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Clear_CCP();
  _Set_Ready(0);
  testWaitForTimeout(500);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(24000);
  Sendccp(3);
  testWaitForTimeout(CCP_Time-24000);
  _Check_E103_Invalid(1);
  _Check_DTC_Res_NowOrHis(9,1,0,DTC_CCP);
}

void CCP_5()  /*接收有效的VCP信号过程中断电*/
{
  dword DTC_CCP[2];
  _Clear_CCP();
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Set_Ready(0);
  testWaitForTimeout(500);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(5000);
  Sendccp(4);
  testWaitForTimeout(6000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  
  testWaitForTimeout(CCP_Time);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30055,0xE30056);
  _Set_Ready(0);
  testWaitForTimeout(2000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(2000);
  Sendccp(0);
  testWaitForTimeout(2000);
  
  _K30_OFF();
  testWaitForTimeout(3000);
  _K30_ON();
  testWaitForTimeout(6000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);
  testWaitForTimeout(CCP_Time);
  _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
}

void CCP_6(byte Type)  /*丢失与无效同时存在*/
{
  dword DTC_CCP[2];
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  CCP_Lost_Invalid[0][0] = ccpNums[4];
  CCP_Lost_Invalid[0][1] = ccpNums[5];
  CCP_Lost_Invalid[1][0] = ccpNums[1];
  CCP_Lost_Invalid[1][1] = ccpNums[2];
  if(Type == 0)
  {
    _Clear_CCP();
    _Set_Ready(0);
    testWaitForTimeout(500);
  }
  else
    _Clear_CCP_Config();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(5000);
  Sendccp(CCP_Lost_Invalid,2,2,0,DTC_CCP);
  testWaitForTimeout(1000);
  _Set_Ready(1);
  testWaitForTimeout(1000);
  _Check_E103_ALL_0();
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(10000);
  _Set_Ready(1);
  testWaitForTimeout(1000);
  _Check_E103_ALL_0();
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);
}

void CCP_7(byte Type)  /*报故障码的前提条件-Car Mode=0：normal*/
{
  dword DTC_CCP[2];
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  if(Type == 0)
  {
    _Clear_CCP();
    _Set_Ready(0);
    testWaitForTimeout(500);
  }
  else
    _Clear_CCP_Config();

  _Set_Sig(CarMode_Sig,1);
  testWaitForTimeout(2000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(CCP_Time);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Sig(CarMode_Sig,2);
  testWaitForTimeout(6000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Sig(CarMode_Sig,3);
  testWaitForTimeout(6000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Sig(CarMode_Sig,5);
  testWaitForTimeout(6000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Sig(CarMode_Sig,0);
  testWaitForTimeout(6000);
  if(Type == 0)
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30055,0xE30056);
  else
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
}

void CCP_8(byte Type)  /*报故障码的前提条件-电压9_18V*/
{
  dword DTC_CCP[2];
  byte Send_Data[3];
  int Fun_DIDPos;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(0xD111);
  if(Fun_DIDPos!= -1)
  {
    Send_Data[0] = 0x22;
    Send_Data[1] = DID_Function[Fun_DIDPos].DID_Byte[0];
    Send_Data[2] = DID_Function[Fun_DIDPos].DID_Byte[1];
  }

  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  if(Type == 0)
  {
    _Clear_CCP();
    _Set_Ready(0);
    testWaitForTimeout(500);
  }
  else
    _Clear_CCP_Config();

  _Set_Battery(8.9);
  if(Fun_DIDPos!= -1)
    Check_ReadFunDID(Send_Data,Fun_DIDPos,phyreq_ID,1,8.8,0,0);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(CCP_Time);
   _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Battery(18.3);
  if(Fun_DIDPos!= -1)
    Check_ReadFunDID(Send_Data,Fun_DIDPos,phyreq_ID,1,18.3,0,0);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Battery(12);
  if(Fun_DIDPos!= -1)
    Check_ReadFunDID(Send_Data,Fun_DIDPos,phyreq_ID,1,12,0,0);
  testWaitForTimeout(2000);
  if(Type == 0)
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30055,0xE30056);
  else
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
}

void CCP_9(byte Type)  /*报故障码的前提条件-ElPowerLevel !=1 or 2*/
{
  dword DTC_CCP[2];
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  if(Type == 0)
  {
    _Clear_CCP();
    _Set_Ready(0);
    testWaitForTimeout(500);
  }
  else
    _Clear_CCP_Config();

  _Set_Sig(PwrLvlElecSubtyp_Sig,0);
  _Set_Sig(PwrLvlElecMai_Sig,1);
  testWaitForTimeout(2000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(CCP_Time+1000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Sig(PwrLvlElecMai_Sig,2);
  testWaitForTimeout(2000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);

  _Set_Sig(PwrLvlElecMai_Sig,3);
  testWaitForTimeout(2000);
  if(Type == 0)
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30055,0xE30056);
  else
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
}

