void CCP_28(byte Type)  /*无效CCP参数记录_多次发送不同无效值（GEEA3.5)*/
{
  _Clear_CCP_Config();
  {
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x08);
    _Check_E103_ALL_0();
    testWaitForTimeout(9000);
    Sendccp(0x0A);
    _Check_E103_ALL_0();
    testWaitForTimeout(8000);
    Sendccp(0x09);
    _Check_E103_ALL_0();
    testWaitForTimeout(CCP_Time-21000);
    _Check_E103_Invalid(1);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤1-4完成");
  }
  {
    _Set_Ready(0);
    testWaitForTimeout(1000);
    if(Type == 1)
    {
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _K15_ON();
      testWaitForTimeout(2000);
      _Check_E103_ALL_0();
    }
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x09);
    _Check_E103_ALL_0();
    testWaitForTimeout(9000);
    Sendccp(0x08);
    _Check_E103_ALL_0();
    testWaitForTimeout(8000);
    Sendccp(0x0A);
    _Check_E103_ALL_0();
    testWaitForTimeout(CCP_Time-21000);
    _Check_E103_Invalid(1);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤5-8完成");
  }
  {
    _Set_Ready(0);
    testWaitForTimeout(1000);
    if(Type == 1)
    {
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _K15_ON();
      testWaitForTimeout(2000);
      _Check_E103_ALL_0();
    }
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x0A);
    _Check_E103_ALL_0();
    testWaitForTimeout(9000);
    Sendccp(0x09);
    _Check_E103_ALL_0();
    testWaitForTimeout(8000);
    Sendccp(0x08);
    _Check_E103_ALL_0();
    testWaitForTimeout(CCP_Time-20000);
    _Check_E103_Invalid(1);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤9-12完成");
  }
  {
    _Set_Ready(0);
    testWaitForTimeout(1000);
    if(Type == 1)
    {
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _K15_ON();
      testWaitForTimeout(2000);
      _Check_E103_ALL_0();
    }
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x08);
    _Check_E103_ALL_0();
    testWaitForTimeout(9000);
    Sendccp(0x09);
    _Check_E103_ALL_0();
    testWaitForTimeout(8000);
    testWaitForTimeout(CCP_Time-20000);
    _Check_E103_Invalid(1);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤13-16完成");
  }
}

void CCP_29(byte Type)  /*无效CCP参数记录_多次发送不同无效值（GEEA3.0)*/
{
  int i,n;
  int Temp,Flage;
  
  _Clear_CCP_Config();
  {
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x08);
    testWaitForTimeout(9000);
    Sendccp(0x0A);
    testWaitForTimeout(8000);
    Sendccp(0x09);
    
    for(i=0;i<Send_Invaild_CCP_Count;i++)
    {
      Send_Invaild_CCP_Plural[i][0] = Send_Invaild_CCP[i][0];
      Send_Invaild_CCP_Plural[i][1] = Send_Invaild_CCP[i][1];
    }
    Temp = Send_Invaild_CCP_Count;
    testWaitForTimeout(CCP_Time-21000);
    _Check_E103_Invalid(1);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤1-4完成");
  }
  {
    _Set_Ready(0);
    testWaitForTimeout(1000);
    if(Type == 1)
    {
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _K15_ON();
      testWaitForTimeout(2000);
      _Check_E103_Invalid(1);
    }
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x09);
    testWaitForTimeout(9000);
    Sendccp(0x08);
    testWaitForTimeout(8000);
    Sendccp(0x0A);
    testWaitForTimeout(CCP_Time-21000);
    Send_Invaild_CCP_Plural_Count = Temp + Send_Invaild_CCP_Count;
    for(i=0;i<Send_Invaild_CCP_Count;i++)
    {
      Flage = _Check_Dword_in_Num(Send_Invaild_CCP[i][0],Send_Invaild_CCP_Plural,Send_Invaild_CCP_Plural_Count);
      if(Flage != -1)
      {
        Send_Invaild_CCP_Plural[Flage][0] = Send_Invaild_CCP[i][0];
        Send_Invaild_CCP_Plural[Flage][1] = Send_Invaild_CCP[i][1];
      }
    }
//    for(i=0;i<Send_Invaild_CCP_Plural_Count;i++)
//      writeEx(-3,0,"CCP[%d] = 0x%02X",Send_Invaild_CCP_Plural[i][0],Send_Invaild_CCP_Plural[i][1]);
    Temp = Send_Invaild_CCP_Plural_Count;
    _Check_E103_Invalid(2);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤5-8完成");
  }
  {
    _Set_Ready(0);
    testWaitForTimeout(1000);
    if(Type == 1)
    {
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _K15_ON();
      testWaitForTimeout(2000);
      _Check_E103_Invalid(2);
    }
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x0A);
    testWaitForTimeout(9000);
    Sendccp(0x09);
    testWaitForTimeout(8000);
    Sendccp(0x08);
    testWaitForTimeout(CCP_Time-20000);
    Send_Invaild_CCP_Plural_Count = Temp + Send_Invaild_CCP_Count;
    for(i=0;i<Send_Invaild_CCP_Count;i++)
    {
      Flage = _Check_Dword_in_Num(Send_Invaild_CCP[i][0],Send_Invaild_CCP_Plural,Send_Invaild_CCP_Plural_Count);
      if(Flage != -1)
      {
        Send_Invaild_CCP_Plural[Flage][0] = Send_Invaild_CCP[i][0];
        Send_Invaild_CCP_Plural[Flage][1] = Send_Invaild_CCP[i][1];
      }
    }
    _Check_E103_Invalid(2);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤9-12完成");
  }
  {
    _Set_Ready(0);
    testWaitForTimeout(1000);
    if(Type == 1)
    {
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _K15_ON();
      testWaitForTimeout(2000);
      _Check_E103_Invalid(2);
    }
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(4000);
    Sendccp(0x08);
    testWaitForTimeout(9000);
    Sendccp(0x09);
    testWaitForTimeout(8000);
    testWaitForTimeout(CCP_Time-20000);
    _Check_E103_Invalid(2);
    _Check_DTC_InNow_NotInNowAndHis(9,0xE30056,0xE30055);
    _WriteEx_and_Report("","步骤13-16完成");
  }
}

void CCP_30()  /*无效CCP参数记录-无效个数最大记录值0xFF（GEEA3.0）*/
{
  int i;

  _Clear_CCP_Config();

  for(i=0;i<260;i+=ccpNumscount)
  {
    _Set_Ready(0);
    testWaitForTimeout(1000);
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(24000);
    Sendccp(0x82);
    testWaitForTimeout(1000);
    testWaitForTimeout(CCP_Time-24000);
    if(i==0)
      _Check_E103_Invalid(1);
  }
  _Check_E103_Invalid(1);
}

void CCP_31()  /*接收有效的VCP信号过程中断电*/
{
  dword DTC_CCP[2];
  byte DiagSend[3] = {0x19,0x02,0x09};
  DTC_CCP[0] = 0xE30055;
  DTC_CCP[1] = 0xE30056;
  _Clear_CCP_Config();

  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(12000);
  Sendccp(4);
  testWaitForTimeout(CCP_Time-10000);
  _Check_DTC_Res_NowOrHis(9,9,1,DTC_CCP);
}

