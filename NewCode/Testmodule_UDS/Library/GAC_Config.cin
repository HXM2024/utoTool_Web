void GAC_UnFac_Config(dword ID,byte Session)
{
  int i,j,k,ServePos,DIDPos;
  byte DataRead[3] = {0x22,0x01,0x10};
  byte DataWrite[4] = {0x2E,0x01,0x10,0x00};
  byte DataWrite_Other[100],DataSend_31H[6];
  dword DID,TempRID;
  DID = 0x0100;
  ServePos = _Check_Serve(0x2E,0,0);
  DIDPos   = _Check_Serve(0x2E,DID,4);
  DataWrite_Other[0] = 0x2E;
  DataWrite_Other[1] = (DID>>8)&0xFF;
  DataWrite_Other[2] = (DID>>0)&0xFF;
  DataSend_31H[0] = 0x31;
  _Send_Diag(elCount(DataRead),ID,DataRead);
  _TestResult(SendData,ID,"",-1);
  for(i=0;i<=0x0F;i++)
  {
    DataWrite[3] = i;
    _unlockECU();
    _Send_Diag(elCount(DataWrite),ID,DataWrite);
    _TestResult(SendData,ID,"",-1);
    _WriteEx_and_Report("","重置解锁状态测试是否在工厂模式中");
    _SetSession(exsession);
    _Send_Diag(elCount(DataRead),ID,DataRead);_TestResult(SendData,ID,"",-1);
    _Check_Response_Config(SendData,DataWrite);
    _SetSession(defsession);
    _SetSession(exsession);
    _unlockECU();
    for(k=0;k<3;k++)
    {
      if(k == 0)
        _Set_11_Restoration(0);
      else if(k == 1)
      {
        _Power_Down();testWaitForTimeout(1000);
        _Power_Up();testWaitForTimeout(1000);
      }
      else if(k == 2)
      {
        _K30_OFF();testWaitForTimeout(2000);
        _K30_ON(); testWaitForTimeout(2000);
      }
      _WriteEx_and_Report("","验证是否需要安全访问");
      _SetSession(defsession);
      _SetSession(exsession);
      if(DIDPos != -1)
      {
        for(j=0;j<Serve_Data[ServePos].Serve_Fun_Len[DIDPos]-3;j++)
          DataWrite_Other[j+3] = i;
        _Send_Diag(Serve_Data[ServePos].Serve_Fun_Len[DIDPos],ID,DataWrite_Other);
        _TestResult(SendData,ID,"",NRC33);
        testWaitForTimeout(100);
      }
      for(j=0;j<Serve_31_Hex_Count;j++)
      {
        TempRID = ((Serve_31_Hex[j].Routine[0]<<8)|(Serve_31_Hex[j].Routine[1]));
        if(TempRID == 0x0203)
          continue;
        DataSend_31H[2] = Serve_31_Hex[j].Routine[0];DataSend_31H[3] = Serve_31_Hex[j].Routine[1];
        DataSend_31H[1] = Serve_31_Hex[j].Control_Type[0];
        if(Serve_31_Hex[j].Routine_Len > 4)
          DataSend_31H[4] = Serve_31_Hex[j].Control_Option[0][0];
        _Send_Diag(Serve_31_Hex[j].Routine_Len,ID,DataSend_31H);
        _TestResult(SendData,ID,"",NRC33);
        if(Serve_31_Hex[j].Control_Type_Count>1)
        {
          DataSend_31H[1] = Serve_31_Hex[j].Control_Type[1];
          _Send_Diag(Serve_31_Hex[j].Routine_Len,ID,DataSend_31H);
          _TestResult(SendData,ID,"",NRC33);
        }
        testWaitForTimeout(50);
      }
    }
  }
}

void GAC_Fac_Config(dword ID,byte Session)
{
  int i,j,k,ServePos,DIDPos;
  byte DataRead[3] = {0x22,0x01,0x10};
  byte DataWrite[4] = {0x2E,0x01,0x10,0x00};
  byte DataWrite_Other[100],DataSend_31H[6];
  dword DID,TempRID;
  DID = 0x0100;
  ServePos = _Check_Serve(0x2E,0,0);
  DIDPos   = _Check_Serve(0x2E,DID,4);
  DataWrite_Other[0] = 0x2E;
  DataWrite_Other[1] = (DID>>8)&0xFF;
  DataWrite_Other[2] = (DID>>0)&0xFF;
  DataSend_31H[0] = 0x31;
  _Send_Diag(elCount(DataRead),ID,DataRead);
  _TestResult(SendData,ID,"",-1);
  for(i=0x10;i<=0xFF;i++)
  {
    DataWrite[3] = i;
    _unlockECU();
    _Send_Diag(elCount(DataWrite),ID,DataWrite);
    _TestResult(SendData,ID,"",-1);
    _WriteEx_and_Report("","重置解锁状态测试是否在工厂模式中");
    _SetSession(exsession);
    _Send_Diag(elCount(DataRead),ID,DataRead);_TestResult(SendData,ID,"",-1);
    _Check_Response_Config(SendData,DataWrite);
    _SetSession(defsession);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC24);

    for(k=0;k<3;k++)
    {
      if(k == 0)
        _Set_11_Restoration(0);
      else if(k == 1)
      {
        _Power_Down();testWaitForTimeout(1000);
        _Power_Up();testWaitForTimeout(1000);
      }
      else if(k == 2)
      {
        _K30_OFF();testWaitForTimeout(2000);
        _K30_ON(); testWaitForTimeout(2000);
      }
      _WriteEx_and_Report("","验证是否需要安全访问");
      _SetSession(defsession);
      _SetSession(exsession);
      if(DIDPos != -1)
      {
        for(j=0;j<Serve_Data[ServePos].Serve_Fun_Len[DIDPos]-3;j++)
          DataWrite_Other[j+3] = i;
        _Send_Diag(Serve_Data[ServePos].Serve_Fun_Len[DIDPos],ID,DataWrite_Other);
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(100);
      }
      for(j=0;j<Serve_31_Hex_Count;j++)
      {
        TempRID = ((Serve_31_Hex[j].Routine[0]<<8)|(Serve_31_Hex[j].Routine[1]));
        if(TempRID == 0x0203)
          continue;
        DataSend_31H[2] = Serve_31_Hex[j].Routine[0];DataSend_31H[3] = Serve_31_Hex[j].Routine[1];
        DataSend_31H[1] = Serve_31_Hex[j].Control_Type[0];
        if(Serve_31_Hex[j].Routine_Len > 4)
          DataSend_31H[4] = Serve_31_Hex[j].Control_Option[0][0];
        _Send_Diag(Serve_31_Hex[j].Routine_Len,ID,DataSend_31H);
        _Check_31Routine_Rx(DataSend_31H,1);
        if(Serve_31_Hex[j].Control_Type_Count>1)
        {
          DataSend_31H[1] = Serve_31_Hex[j].Control_Type[1];
          _Send_Diag(Serve_31_Hex[j].Routine_Len,ID,DataSend_31H);
          _Check_31Routine_Rx(DataSend_31H,1);
        }
        testWaitForTimeout(50);
      }
    }
  }
}

void GAC_ALL_Zero_Config(dword ID,byte Session)
{
  int i,k;
  byte DataRead[3] = {0x22,0x01,0x10};
  byte DataWrite[4] = {0x2E,0x01,0x10,0x00};
  _Send_Diag(elCount(DataRead),ID,DataRead);
  _TestResult(SendData,ID,"",-1);
  for(i=0x01;i<=0xFF;i++)
  {
    DataWrite[3] = 0;
    _unlockECU();
    _Send_Diag(elCount(DataWrite),ID,DataWrite);
    _TestResult(SendData,ID,"",-1);
    _WriteEx_and_Report("","重置解锁状态测试是否在工厂模式中");
    _SetSession(exsession);
    _Send_Diag(elCount(DataRead),ID,DataRead);_TestResult(SendData,ID,"",-1);
    _Check_Response_Config(SendData,DataWrite);
    _unlockECU();
    DataWrite[3] = i;
    _Send_Diag(elCount(DataWrite),ID,DataWrite);
    _TestResult(SendData,ID,"",NRC22);
    DataWrite[3] = 0;
    _Send_Diag(elCount(DataRead),ID,DataRead);_TestResult(SendData,ID,"",-1);
    _Check_Response_Config(SendData,DataWrite);

    for(k=0;k<3;k++)
    {
      if(k == 0)
        _Set_11_Restoration(0);
      else if(k == 1)
      {
        _Power_Down();testWaitForTimeout(1000);
        _Power_Up();testWaitForTimeout(1000);
      }
      else if(k == 2)
      {
        _K30_OFF();testWaitForTimeout(2000);
        _K30_ON(); testWaitForTimeout(2000);
      }
      _Send_Diag(elCount(DataRead),ID,DataRead);_TestResult(SendData,ID,"",-1);
      _Check_Response_Config(SendData,DataWrite);
    }
  }
}

void GAC_Config_Turn(dword ID,byte Session)
{
  byte SendData_2E[0x0B] = {0x2E,0x01,0x01,0x03,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte SendData_2201[3] = {0x22,0x01,0x01};
  byte SendData_2202[3] = {0x22,0x01,0x02};
  byte GetNowSteeringMode[4];
  int i;
  char SetSteeringModeSig[100],GetSteeringModeSig[100];

  snprintf(SetSteeringModeSig,elCount(SetSteeringModeSig),"x190_GSM_VehDriveMode");
  snprintf(GetSteeringModeSig,elCount(GetSteeringModeSig),"x366_EPS_SteeringModeSt");
  SendData_2E[0] = 0x2E;SendData_2E[1] = 0x01; SendData_2E[2] = 0x01;
  GetNowSteeringMode[0] = 0x62;GetNowSteeringMode[1] = 0x01;
  GetNowSteeringMode[2] = 0x02;GetNowSteeringMode[3] = 0x00;

  _SetSession(exsession);
  _unlockECU();
  _Set_Sig(SetSteeringModeSig,0x01);
  _Check_SignalMacth(GetSteeringModeSig,2,500);
  for(i=3;i<0x0B;i++)
    SendData_2E[i] = 0x00;
  SendData_2E[3] = 0x03;
  _Send_Diag(elCount(SendData_2E),ID,SendData_2E); _TestResult(SendData,ID,"",-1);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  GetNowSteeringMode[3] = 0x03;_Check_Response_Config(SendData,GetNowSteeringMode);
  _Check_SignalMacth(GetSteeringModeSig,3,500);
  _Power_Down(); testWaitForTimeout(2000);   _Power_Up(); testWaitForTimeout(2000);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,GetNowSteeringMode);
  _Set_Sig(SetSteeringModeSig,0x03);
  _Check_SignalMacth(GetSteeringModeSig,1,500);

  _SetSession(exsession);
  _unlockECU();
  _Set_Sig(SetSteeringModeSig,0x05);
  _Check_SignalMacth(GetSteeringModeSig,3,500);
  SendData_2E[3] = 0x02;SendData_2E[4] = 0x0F;
  _Send_Diag(elCount(SendData_2E),ID,SendData_2E); _TestResult(SendData,ID,"",-1);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  SendData_2E[3] = 0x02;SendData_2E[4] = 0x00; _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  GetNowSteeringMode[3] = 0x02; _Check_Response_Config(SendData,GetNowSteeringMode);
  _Check_SignalMacth(GetSteeringModeSig,1,500);
  _Set_11_Restoration(0);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,GetNowSteeringMode);
  _Set_Sig(SetSteeringModeSig,0x02);
  _Check_SignalMacth(GetSteeringModeSig,2,500);

  _SetSession(exsession);
  _unlockECU();
  _Set_Sig(SetSteeringModeSig,0x03);
  _Check_SignalMacth(GetSteeringModeSig,1,500);
  SendData_2E[3] = 0x01;SendData_2E[4] = 0x00;
  _Send_Diag(elCount(SendData_2E),ID,SendData_2E); _TestResult(SendData,ID,"",-1);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  GetNowSteeringMode[3] = 0x01; _Check_Response_Config(SendData,GetNowSteeringMode);
  _Check_SignalMacth(GetSteeringModeSig,2,500);
  _K30_OFF(); testWaitForTimeout(2000);  _K30_ON(); testWaitForTimeout(2000);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,GetNowSteeringMode);
  _Set_Sig(SetSteeringModeSig,0x05);
  _Check_SignalMacth(GetSteeringModeSig,3,500);
}

void GAC_Config_Turn_Off(dword ID,byte Session)
{
  byte SendData_2E[0x0B] = {0x2E,0x01,0x01,0x03,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte SendData_2201[3] = {0x22,0x01,0x01};
  byte SendData_2202[3] = {0x22,0x01,0x02};
  byte GetNowSteeringMode[4];
  int i;
  char SetSteeringModeSig[100],GetSteeringModeSig[100];

  snprintf(SetSteeringModeSig,elCount(SetSteeringModeSig),"x190_GSM_VehDriveMode");
  snprintf(GetSteeringModeSig,elCount(GetSteeringModeSig),"x366_EPS_SteeringModeSt");
  SendData_2E[0] = 0x2E;SendData_2E[1] = 0x01; SendData_2E[2] = 0x01;
  GetNowSteeringMode[0] = 0x62;GetNowSteeringMode[1] = 0x01;
  GetNowSteeringMode[2] = 0x02;GetNowSteeringMode[3] = 0x00;
  
  _SetSession(exsession);
  _unlockECU();
  _Set_Sig(SetSteeringModeSig,0x01);
  _Check_SignalMacth(GetSteeringModeSig,1,500);
  for(i=3;i<0x0B;i++)
    SendData_2E[i] = 0x00;
  SendData_2E[3] = 0x04;  SendData_2E[4] = 0x0F;
  _Send_Diag(elCount(SendData_2E),ID,SendData_2E); _TestResult(SendData,ID,"",-1);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  SendData_2E[3] = 0x01;  SendData_2E[4] = 0x00; _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  GetNowSteeringMode[3] = 0x01;_Check_Response_Config(SendData,GetNowSteeringMode);
  _Check_SignalMacth(GetSteeringModeSig,2,500);
  _Power_Down(); testWaitForTimeout(2000);   _Power_Up(); testWaitForTimeout(2000);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,GetNowSteeringMode);
  _Set_Sig(SetSteeringModeSig,0x03);
  _Check_SignalMacth(GetSteeringModeSig,1,500);

  _SetSession(exsession);
  _unlockECU();
  _Set_Sig(SetSteeringModeSig,0x01);
  _Check_SignalMacth(GetSteeringModeSig,2,500);
  SendData_2E[3] = 0xFF;SendData_2E[4] = 0x00;
  _Send_Diag(elCount(SendData_2E),ID,SendData_2E); _TestResult(SendData,ID,"",NRC31);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  SendData_2E[3] = 0x01;SendData_2E[4] = 0x00; _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  GetNowSteeringMode[3] = 0x01; _Check_Response_Config(SendData,GetNowSteeringMode);
  _Check_SignalMacth(GetSteeringModeSig,2,500);
  _Set_11_Restoration(0);
  _Send_Diag(elCount(SendData_2201),ID,SendData_2201); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,SendData_2E);
  _Send_Diag(elCount(SendData_2202),ID,SendData_2202); _TestResult(SendData,ID,"",-1);
  _Check_Response_Config(SendData,GetNowSteeringMode);
  _Set_Sig(SetSteeringModeSig,0x05);
  _Check_SignalMacth(GetSteeringModeSig,3,500);
}


