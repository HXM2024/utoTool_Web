void GAC_31_0203(dword ID,byte Session)/*检测编程条件*/
{
  byte Serve_1002[2]={0x10,0x02};
  _get_Arry("Pre_Programmed");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",-1);
  _Send_Diag(2,ID,Serve_1002);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(defsession);
  testWaitForTimeout(1000);
  _Set_11_Restoration();
  _SetSession(exsession);
  Arry_Data[1] |=0x80;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",0);
  _Send_Diag(2,ID,Serve_1002);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(defsession);
  testWaitForTimeout(1000);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(1000);
  Arry_Data[1] &=0x0F;
  _SetSession(exsession);
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",-1);
  _Send_Diag(2,ID,Serve_1002);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(defsession);
  testWaitForTimeout(1000);
  _K30_OFF();
  testWaitForTimeout(2000);
  _K30_ON();
  testWaitForTimeout(2000);
  _SetSession(exsession);
  Arry_Data[1] |=0x80;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",0);
  _Send_Diag(2,ID,Serve_1002);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(defsession);
  testWaitForTimeout(1000);
}

void GAC_31_64D1(dword ID,byte Session)/*中位标定*/
{
  byte Clear_Ang[10];
  int i,Len_Clear_Ang,Pos;
  float AngNow;
  _WriteEx_and_Report("","此条用例需要接入传感器");
  _WriteEx_and_Report("","步骤1");
  _get_Arry("Clear_Angle_Calibration");
  Len_Clear_Ang = Arry_Len;
  for(i=0;i<Arry_Len;i++)
    Clear_Ang[i] = Arry_Data[i];
  _Set_CarSpd(5);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  _unlockECU();
  _Send_Diag(Len_Clear_Ang,ID,Clear_Ang);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(500);
  _Check_DTC_Res(0x01,Ang_NotCal,0);
  _get_Arry("Angle_Calibration");
  Arry_Data[1] |= 0x80; 
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",0);
  testWaitForTimeout(100);
  Arry_Data[1] = 0x03;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _Check_DTC_Res(0x01,0,Ang_NotCal);
  Pos = _Check_StrPossion_Res("Angle",1);
  if(Pos != -1)
  {
    AngNow = _Get_Signal(mixArray[Pos].Sig_Name[0]);
    if(AngNow>= 1 || AngNow<= -1)
      testStepfail("","当前角度非0°，为%.2f",AngNow);
    else
      testStepPass("","当前角度在0°左右");
  }
  else
  {
    diagStartTesterPresent(Cdd_Name);
    _TestWaitForTesterConfirmation("查看当前角度是否为0°");
  }
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  if(Pos != -1)
  {
    AngNow = _Get_Signal(mixArray[Pos].Sig_Name[0]);
    if(AngNow>= 1 || AngNow<= -1)
      testStepfail("","当前角度非0°，为%.2f",AngNow);
    else
      testStepPass("","当前角度在0°左右");
  }
  else
    _TestWaitForTesterConfirmation("查看当前角度是否为0°");
  
  _WriteEx_and_Report("","步骤2");
  _unlockECU();
  _Send_Diag(Len_Clear_Ang,ID,Clear_Ang);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(500);
  _Check_DTC_Res(0x01,Ang_NotCal,0);
  _get_Arry("Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  testWaitForTimeout(100);
  Arry_Data[1] = 0x83;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",0);
  _Check_DTC_Res(0x01,0,Ang_NotCal);

  _Set_11_Restoration(0);
  if(Pos != -1)
  {
    AngNow = _Get_Signal(mixArray[Pos].Sig_Name[0]);
    if(AngNow>= 1 || AngNow<= -1)
      testStepfail("","当前角度非0°，为%.2f",AngNow);
    else
      testStepPass("","当前角度在0°左右");
  }
  else
    _TestWaitForTesterConfirmation("查看当前角度是否为0°");

  _WriteEx_and_Report("","步骤3");
  _unlockECU();
  _Send_Diag(Len_Clear_Ang,ID,Clear_Ang);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(500);
  _Check_DTC_Res(0x01,Ang_NotCal,0);
  _get_Arry("Angle_Calibration");
  Arry_Data[1] = 0x81;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",0);
  testWaitForTimeout(100);
  Arry_Data[1] = 0x83;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",0);
  _Check_DTC_Res(0x01,0,Ang_NotCal);
  
  _Set_CarSpd(6);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  _K30_OFF();
  testWaitForTimeout(2000);
  _K30_ON();
  testWaitForTimeout(2000);
  if(Pos != -1)
  {
    AngNow = _Get_Signal(mixArray[Pos].Sig_Name[0]);
    if(AngNow>= 1 || AngNow<= -1)
      testStepfail("","当前角度非0°，为%.2f",AngNow);
    else
      testStepPass("","当前角度在0°左右");
  }
  else
    _TestWaitForTesterConfirmation("查看当前角度是否为0°");
  _WriteEx_and_Report("","步骤4");
  _unlockECU();
  _Send_Diag(Len_Clear_Ang,ID,Clear_Ang);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(500);
  _Check_DTC_Res(0x01,Ang_NotCal,0);
  _get_Arry("Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  testWaitForTimeout(100);
  Arry_Data[1] = 0x03;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _Check_DTC_Res(0x01,0,Ang_NotCal);
  if(Pos != -1)
  {
    AngNow = _Get_Signal(mixArray[Pos].Sig_Name[0]);
    if(AngNow>= 1 || AngNow<= -1)
      testStepfail("","当前角度非0°，为%.2f",AngNow);
    else
      testStepPass("","当前角度在0°左右");
  }
  else
    _TestWaitForTesterConfirmation("查看当前角度是否为0°");
}

void GAC_31_64D2(dword ID,byte Session)/*清除中位标定*/
{
  byte Angle_Calibration[10];
  int i,Len_Angle_Calibration,Pos;
  float AngNow;
  _WriteEx_and_Report("","此条用例需要接入传感器");
  _WriteEx_and_Report("","步骤1");
  _get_Arry("Angle_Calibration");
  Len_Angle_Calibration = Arry_Len;
  for(i=0;i<Arry_Len;i++)
    Angle_Calibration[i] = Arry_Data[i];
  _Set_CarSpd(5);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  _unlockECU();
  _get_Arry("Clear_Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",NRC22);
  Arry_Data[1] = 0x03;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",NRC24);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);

  _WriteEx_and_Report("","步骤2");
  _Set_CarSpd(0);
  _Set_Ready(0);
  testWaitForTimeout(1000);
  _unlockECU();
  _Send_Diag(Len_Angle_Calibration,ID,Angle_Calibration);
  _Check_31Routine_Rx(Angle_Calibration,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(0x01,0,Ang_NotCal);
  _get_Arry("Clear_Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  testWaitForTimeout(100);
  Arry_Data[1] = 0x03;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _Check_DTC_Res(0x01,Ang_NotCal,0);
  _Set_11_Restoration(0);
  _Check_DTC_Res(0x01,Ang_NotCal,0);

  _WriteEx_and_Report("","步骤3");
  _unlockECU();
  _Send_Diag(Len_Angle_Calibration,ID,Angle_Calibration);
  _Check_31Routine_Rx(Angle_Calibration,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(0x01,0,Ang_NotCal);
  _get_Arry("Clear_Angle_Calibration");
  Arry_Data[1] |= 0x80;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",0);
  testWaitForTimeout(100);
  Arry_Data[1] = 0x03;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _Check_DTC_Res(0x01,Ang_NotCal,0);
  
  _Set_CarSpd(6);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(1000);
  _K30_OFF();
  testWaitForTimeout(2000);
  _K30_ON();
  testWaitForTimeout(2000);
  _Check_DTC_Res(0x01,Ang_NotCal,0);

  _WriteEx_and_Report("","步骤4");
  _unlockECU();
  _Send_Diag(Len_Angle_Calibration,ID,Angle_Calibration);
  _Check_31Routine_Rx(Angle_Calibration,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(0x01,0,Ang_NotCal);
  _get_Arry("Clear_Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  testWaitForTimeout(100);
  Arry_Data[1] = 0x03;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _Check_DTC_Res(0x01,Ang_NotCal,0);

  _WriteEx_and_Report("","测试完成，重新对中");
  _Send_Diag(Len_Angle_Calibration,ID,Angle_Calibration);
  _Check_31Routine_Rx(Angle_Calibration,1);
}

void GAC_31_64D3(dword ID,byte Session)/*清除EOT末端值*/
{
  byte Angle_Calibration[10];
  byte DataSend[4] = {0x31,0x01,0x64,0xD3};
  dword EOT_DTC = 0x563054;
  int i,Len_Angle_Calibration,Pos;
  float AngNow;
  _WriteEx_and_Report("","此条用例需要接入传感器");
  diagStartTesterPresent(Cdd_Name);
  
  _Set_Ready(Struct_Ready.Ready_Active);
  _WriteEx_and_Report("","步骤1");
  _get_Arry("Angle_Calibration");
  _unlockECU();
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _TestWaitForTesterConfirmation("此处需人为判断末端值是否恢复到初始值");
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  _TestWaitForTesterConfirmation("此处需人为判断末端值是否恢复到初始值");


  _WriteEx_and_Report("","步骤2");
  _TestWaitForTesterConfirmation("往左打方向学习末端");
  _unlockECU();
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _Check_31Routine_Rx(DataSend,1);
  testWaitForTimeout(100);
  DataSend[1] = 0x83;
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _TestResult(SendData,ID,"",0);
  _Check_DTC_Res(0x01,EOT_DTC,0);
  _TestWaitForTesterConfirmation("此处需人为判断末端值是否被擦除");
  
  _WriteEx_and_Report("","步骤3");
  _TestWaitForTesterConfirmation("往右打方向学习末端");
  DataSend[1] = 0x81;
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _TestResult(SendData,ID,"",0);
  testWaitForTimeout(100);
  DataSend[1] = 0x03;
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _Check_31Routine_Rx(DataSend,1);
  _Check_DTC_Res(0x01,EOT_DTC,0);
  _K30_OFF();
  testWaitForTimeout(2000);
  _K30_ON();
  testWaitForTimeout(2000);
  _TestWaitForTesterConfirmation("此处需人为判断末端值是否被擦除");
  
  _WriteEx_and_Report("","步骤4");
  _TestWaitForTesterConfirmation("往左打方向学习末端");
  _unlockECU();
  DataSend[1] = 0x01;
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _Check_31Routine_Rx(DataSend,1);
  testWaitForTimeout(100);
  DataSend[1] = 0x03;
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _Check_31Routine_Rx(DataSend,1);
  _Check_DTC_Res(0x01,EOT_DTC,0);
  _Set_11_Restoration(0);
  _Check_DTC_Res(0x01,Ang_NotCal,0);
  _TestWaitForTesterConfirmation("此处需人为判断末端值是否被擦除");

  _WriteEx_and_Report("","步骤5");
  _TestWaitForTesterConfirmation("往右打方向学习末端");
  _unlockECU();
  DataSend[1] = 0x01;
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _Check_31Routine_Rx(DataSend,1);
  testWaitForTimeout(100);
  DataSend[1] = 0x03;
  _Send_Diag(elCount(DataSend),ID,DataSend);
  _Check_31Routine_Rx(DataSend,1);
  _Check_DTC_Res(0x01,EOT_DTC,0);
}

