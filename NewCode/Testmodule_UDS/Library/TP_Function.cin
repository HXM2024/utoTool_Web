_CANFD_TP_FC_11() /*等待流控制帧*/
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x31,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Data_Send_3[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  int i,FF_DL,Temp_SN;
  
  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  _TPgetFF(1);
  testWaitForTimeout((word)N_Bs_Time*0.8);
  _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
  _Check_NoResponse(N_Bs_Time+N_Bs_Time_Tolerance);
  _TPsendmsg_Phy(Data_Send_3,elcount(Data_Send_3),1);
  _Check_NoResponse(500);
  testWaitForTimeout(2000);
  
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  FF_DL = _TPgetFF(1);
  Temp_SN = _Get_CF_SN(FF_DL);
  testWaitForTimeout((word)N_Bs_Time*0.8);
  _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
  _Check_NoResponse(N_Bs_Time-N_Bs_Time_Tolerance);
  _TPsendmsg_Phy(Data_Send_3,elcount(Data_Send_3),1);
  if(N_WFTmax == 0)
    _Check_NoResponse(500);
  else
  {
    for(i=1;i<=Temp_SN;i++)
      _Check_TPgetCF(1,FF_DL,i);
  }
  testWaitForTimeout(2000);
}
_CANFD_TP_FC_11_1() /*等待流控制帧的N_WFTmax*/
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x31,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Data_Send_3[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  int i,FF_DL,Temp_SN;
  if(N_WFTmax == 0)
  {
    _WriteEx_and_Report("","不符合测试条件");
    return;
  }

  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  FF_DL = _TPgetFF(1);
  Temp_SN = _Get_CF_SN(FF_DL);
  for(i=0;i<N_WFTmax;i++)
  {
    testWaitForTimeout(10);
    _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
    _WriteEx_and_Report("","已发送 %d 次",i+1);
  }
  _TPsendmsg_Phy(Data_Send_3,elcount(Data_Send_3),1);
  for(i=1;i<=Temp_SN;i++)
    _Check_TPgetCF(1,FF_DL,i);
  testWaitForTimeout(2000);
  
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  FF_DL = _TPgetFF(1);
  Temp_SN = _Get_CF_SN(FF_DL);
  for(i=0;i<N_WFTmax+1;i++)
  {
    testWaitForTimeout(10);
    _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
    _WriteEx_and_Report("","已发送 %d 次",i+1);
  }
  _TPsendmsg_Phy(Data_Send_3,elcount(Data_Send_3),1);
  _Check_NoResponse(500);
}

_CANFD_TP_FC_12() /*流控帧请求测试*/
{
  byte Data_Send_1[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  _TPgetFF(0);
}
_CANFD_TP_FC_13() /*发送未知类型的诊断帧*/
{
  byte Data_Send_1[8] = {0x66,0x66,0x66,0x66,0x66,0x66,0x66,0x66};
  
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  _TPgetFF(0);
}


/*
    判断返回报文格式与时间
    Type：2 ：CANFD,  1 ：CAN
*/
_Check_Time(message *ResMsg,int Type,double Start_Time,double End_Time,char InfInput[])
{
  char Temp_StepWrite[200];
  snprintf(Temp_StepWrite,elCount(Temp_StepWrite),"%s,返回报文格式为",InfInput);
  if(Type == 2) //CANFD
  {
    if(ResMsg.FDF == 0)
    {
      snprintf(Temp_StepWrite,elCount(Temp_StepWrite),"%sCAN",Temp_StepWrite);
      testStepFail(InfInput,Temp_StepWrite);
    }
  }
  else if(Type == 1)
  {
    if(ResMsg.FDF == 1)
    {
      snprintf(Temp_StepWrite,elCount(Temp_StepWrite),"%sCANFD",Temp_StepWrite);
      testStepFail(InfInput,Temp_StepWrite);
    }
  }
  if(Res_NRC78_Flage == 0)
  {
    if(End_Time - Start_Time <= p2cmax)
      testStepPass(InfInput,"%s,响应时间为:%.2fms",InfInput,End_Time - Start_Time);
    else
      testStepFail(InfInput,"%s,响应超时，响应时间为:%.2fms",InfInput,End_Time - Start_Time);
  }
  else
  {
    if(End_Time - Start_Time <= 5000)  // NRC78等待时间
      testStepPass(InfInput,"%s,响应时间为:%.2fms",InfInput,End_Time - Start_Time);
    else
      testStepFail(InfInput,"%s,响应超时，响应时间为:%.2fms",InfInput,End_Time - Start_Time);
  }
}
/*
    判断返回报文内容
*/
_Check_ResMsg(message *ResMsg,int Res,int Type,double Start_Time,double End_Time,char InfInput[])
{
  char Str_Step[200];
  int i;
  
  _Check_Time(ResMsg,Type,Start_Time,End_Time,InfInput);
  if(ResMsg.byte(1) != 0x7F)
  {
    if(Res != -1)
    {
      snprintf(Str_Step,elCount(Str_Step),"实际收到肯定响应：");
      for(i=0;i<8;i++)
        snprintf(Str_Step,elCount(Str_Step),"%s%02X ",Str_Step,ResMsg.byte(i));
      testStepFail(InfInput,Str_Step);
    }
    else
      testStepPass(InfInput,"响应结果与预期一致为正响应");
  }
  else if(ResMsg.byte(1) == 0x7F && ResMsg.byte(3) != 0x78)
  {
    if(Res != ResMsg.byte(3) && Res!= -1 && Res!= 0)
    {
      snprintf(Str_Step,elCount(Str_Step),"期望收到响应 NRC%02X ,实际收到消极应答 NRC%02X",Res, ResMsg.byte(3));
      testStepFail(InfInput,Str_Step);
    }
    else if( Res == -1)
    {
      snprintf(Str_Step,elCount(Str_Step),"期望收到肯定响应 ,实际收到消极应答 NRC%02X", ResMsg.byte(3));
      testStepFail(InfInput,Str_Step);
    }
    else if( Res == 0)
    {
      snprintf(Str_Step,elCount(Str_Step),"期望无响应 ,实际收到消极应答 NRC%02X", ResMsg.byte(3));
      testStepFail(InfInput,Str_Step);
    }
  }
}

/*
    判断返回报文格式
    Res：返回结果
    Type：2 ：CANFD,  1 ：CAN
    MsgID:发送报文ID
    Send_Data:发送数据
*/
Send_Check_ResMsg(dword MsgID,byte Send_Data[],int Res,int Type,char InputStr[])
{
  message *Msg;
  message *SendMsg;
  double Start_Time,Start_Time_2,End_Time,End_Time_2,End_Time_3;
  dword Count_NRC78;
  int Send_Len,i,j,Count_Frame,DataSend_Len;
  int Input_Len,Res_Falge,ResLen;
  char Stepid[100];
  
  snprintf(Stepid,elCount(Stepid),"%s ",InputStr);
  Input_Len = elCount(Send_Data);
  Count_NRC78 = 0;
  Count_Frame = 0;
  
  /*功能寻址下 部分NRC不响应，可进行补充*/
  if(MsgID == @DID::funreq_ID && (Res == 0x12 || Res == 0x13))
    Res = 0;
  if((Support_CAN & Type) == 0)
    Res = 0;
  
  SendMsg.id = MsgID;
  DataSend_Len = elcount(Send_Data);
  if(Type == 2)
  {
    SendMsg.FDF = 1;
    if((Send_Data[0]>>4) == 1 || Send_Data[0] == 0)
    {
      snprintf(Stepid,elCount(Stepid),"%s_%02X服务",Stepid,Send_Data[2]);
      Send_Len = (Send_Data[0]&0xF)*256 + Send_Data[1];
      if(Send_Len<=62)
        Send_Data[0] = 0x00;
      if(Send_Data[0] == 0)
        Send_Len = Send_Data[1];
      if(Send_Len>8 && Send_Len<64)
      {
        if(Send_Len<=10)
          DataSend_Len = 12;
        else if(Send_Len<=14)
          DataSend_Len = 16;
        else if(Send_Len<=18)
          DataSend_Len = 20;
        else if(Send_Len<=22)
          DataSend_Len = 24;
        else if(Send_Len<=30)
          DataSend_Len = 32;
        else if(Send_Len<=46)
          DataSend_Len = 48;
        else if(Send_Len<=62)
          DataSend_Len = 64;
      }
    }
    else
      DataSend_Len = (Send_Data[0]&0xF);
    if(DataSend_Len<8)
      DataSend_Len = 8;
    else if(DataSend_Len>=64)
      DataSend_Len = 64;
    _TPsendmsg_Phy(Send_Data,DataSend_Len,1);
  }
  else
  {
    SendMsg.FDF = 0;
    SendMsg.dlc = 8;
    SendMsg.DataLength = 8;
    _TPsendmsg_Phy(Send_Data,8,0);
    if(Send_Data[0]>>4 == 1)
      snprintf(Stepid,elCount(Stepid),"%s_%02X服务",Stepid,Send_Data[2]);
  }
  /*等待报文发送，防止中途出现3E 80/00被打断*/
  testWaitForMessage(MsgID,1000);
  testGetWaitEventMsgData(Msg);
  if(Msg.byte(1) == 0x3E && Send_Data[1] != 0x3E)
  {
    testWaitForMessage(MsgID,1000);
    testGetWaitEventMsgData(Msg);
  }
  
  if(Msg.byte(0)>>4 == 1 && Type == 1) //发送报文数据为首帧，首帧肯定会有流控帧
  {
    Send_Len = (Msg.byte(0)&0xF)*256 + (Msg.byte(1));
    Start_Time = (double)timeNow()/100;
    testWaitForMessage(@DID::Response_ID,p2cmax);
    testGetWaitEventMsgData(Msg);
    
    /*判断是否收到流控帧*/
    if(Msg.byte(0) == 0x30)
    {
      _WriteEx_and_Report("","收到流控制帧");
      End_Time = (double)timeNow()/100;
      _Check_Time(Msg,Type,Start_Time,End_Time,Stepid);
      
      /*等待诊断请求数据全部发送完*/
      testWaitForTimeout(10);
      Count_Frame = _ceil((Send_Len-6)/7)+1;
      for(i=1;i<=Count_Frame;i++)
      {
        SendMsg.byte(0) = (0x20|(i&0xF)); //连续帧SN设置
        for(j=0;j<7;j++)
        {
          if((i*7+1+j) >= Input_Len) //长度补足
            SendMsg.byte(j+1) = 0x55;
          else if((i*7+j) > Send_Len) //多余数据处理
            SendMsg.byte(j+1) = 0x55;
          else
            SendMsg.byte(j+1) = Send_Data[i*7+1+j];
        }
        output(SendMsg);
        for(j=0;j<8;j++)
          SendMsg.byte(j) = 0;
        if(i != Count_Frame) //等于最后一帧时此处不等待时间防止提前反馈
          testWaitForTimeout((int)N_Cs_Time*0.8);
        else
          testWaitForMessage(MsgID,N_Cs_Time);
      }
    }
    else if(Msg.byte(0) == 0x32)
    {
      _WriteEx_and_Report("","收到溢出流控制帧");
      End_Time = (double)timeNow()/100;
      _Check_Time(Msg,Type,Start_Time,End_Time,Stepid);
    }
    Start_Time = (double)timeNow()/100;
    /*判断流控帧后续的响应*/
    testWaitForMessage(@DID::Response_ID,p2cmax);
    testGetWaitEventMsgData(Msg);
    if(Msg.byte(1) == Send_Data[2]+0x40) // 正响应
    {
      End_Time = (double)timeNow()/100;
      _Check_ResMsg(Msg,Res,Type,Start_Time,End_Time,Stepid);
    }
    else if(Msg.byte(1) == 0x7F && Msg.byte(3) != 0x78) //消极应答
    {
       End_Time = (double)timeNow()/100;
      _Check_ResMsg(Msg,Res,Type,Start_Time,End_Time,Stepid);
    }
    else if(Msg.byte(1) == 0x7F && Msg.byte(3) == 0x78) //NRC78
    {
      End_Time = (double)timeNow()/100;
      _Check_Time(Msg,Type,Start_Time,End_Time,Stepid);
      do{
        Count_NRC78++;
        Res_NRC78_Flage = 1;
        Start_Time_2 = (double)timeNow()/100;
        if(Count_NRC78 != 1) // 后续收到NRC78
        {
          End_Time_2 = (double)timeNow()/100;
          _Check_Time(Msg,Type,End_Time_3,End_Time_2,Stepid);
          End_Time_3 = (double)timeNow()/100;
        }
        testWaitForMessage(@DID::Response_ID,5000);
        testGetWaitEventMsgData(Msg);
        if(Msg.byte(1) == Send_Data[2]+0x40) // 正响应
        {
          End_Time_2 = (double)timeNow()/100;
          _Check_ResMsg(Msg,Res,Type,Start_Time_2,End_Time_2,Stepid);
        }
        else if(Msg.byte(1) == 0x7F && Msg.byte(3) != 0x78) //消极应答
        {
           End_Time_2 = (double)timeNow()/100;
          _Check_ResMsg(Msg,Res,Type,Start_Time_2,End_Time_2,Stepid);
        }
      }while(Msg.byte(1) == 0x7F && Msg.byte(3) == 0x78);
      Count_NRC78 = 0;
      Res_NRC78_Flage = 0;
    }
  }
  else //发送报文数据为单帧
  {
    if(Msg.byte(0) == 0)
      snprintf(Stepid,elCount(Stepid),"%s_%02X服务",Stepid,Send_Data[2]);
    else
      snprintf(Stepid,elCount(Stepid),"%s_%02X服务",Stepid,Send_Data[1]);
    Start_Time = (double)timeNow()/100;
    Res_Falge = testWaitForMessage(@DID::Response_ID,p2cmax);
    testGetWaitEventMsgData(Msg);
    
    if(Res_Falge == 0 )
    {
      if(Res == 0)
      {
        testStepPass(Stepid,"与期望一致在%dms无响应",p2cmax);
        Res_Falge = testWaitForMessage(@DID::Response_ID,p2cmax);
        testGetWaitEventMsgData(Msg);
        if(Res_Falge != 0)
          testStepFail(Stepid,"期望无响应，实际收到超时应答");
      }
      else
      {
        testStepFail(Stepid,"未在规定时间%dms内收到应答",p2cmax);
        Res_Falge = testWaitForMessage(@DID::Response_ID,1000);
        testGetWaitEventMsgData(Msg);
      }
    }
    else if(Res == 0 && Res_Falge != 0)
      testStepFail(Stepid,"期望无响应，实际收到应答");
    
    if(Res != 0)
    {
      if(Msg.byte(0)>>4 == 1) /*收到多帧，判断首帧*/
      {
        byte Data[8] = {0x30,0,0,0x55,0x55,0x55,0x55,0x55};
        End_Time = (double)timeNow()/100;
        _Check_ResMsg(Msg,Res,Type,Start_Time,End_Time,Stepid);
        _TPsendmsg_Phy(Data,8,Type);
        
        if(Msg.byte(2) == 0x67 && Msg.byte(3) == RequestSeed_27)  //种子
        {
          ResLen = (Msg.byte(0)&0xF) + Msg.byte(1);
          if(Msg.FDF == 0 || Response_CanFD == 0)//CAN格式种子
          {
            for(i=0;i<4;i++)
              Seed_Save[i] = Msg.byte(i+4);
            Count_Frame = _ceil((ResLen-6)/7)+1;
            for(i=1;i<=Count_Frame;i++)
            {
              if(testWaitForMessage(@DID::Response_ID,p2cmax))
              {
                testGetWaitEventMsgData(Msg);
                for(j=1;j<8;j++)
                  Seed_Save[4+(i-1)*7+j-1] = Msg.byte(j);
              }
            }
          }
          else//CANFD格式
          {
            for(i=0;i<SendKey_Len-2;i++)
              Seed_Save[i] = Msg.byte(i+2);
          }
        }
      }
      else if(Msg.byte(0) == 0 && Type == 2) /*CANFD格式单帧响应*/
      {
        End_Time = (double)timeNow()/100;
        _Check_ResMsg(Msg,Res,Type,Start_Time,End_Time,Stepid);
      }
      else
      {
        if(Msg.byte(1) == Send_Data[1]+0x40) // 正响应
        {
          End_Time = (double)timeNow()/100;
          _Check_ResMsg(Msg,Res,Type,Start_Time,End_Time,Stepid);
          if(Msg.byte(1) == 0x67 && Msg.byte(2) == RequestSeed_27)  //种子
          {
            for(i=0;i<SendKey_Len-2;i++)
              Seed_Save[i] = Msg.byte(i+3);
          }
        }
        else if(Msg.byte(1) == 0x7F && Msg.byte(3) != 0x78) //消极应答
        {
           End_Time = (double)timeNow()/100;
          _Check_ResMsg(Msg,Res,Type,Start_Time,End_Time,Stepid);
        }
        else if(Msg.byte(1) == 0x7F && Msg.byte(3) == 0x78) //NRC78
        {
          End_Time = (double)timeNow()/100;
          _Check_Time(Msg,Type,Start_Time,End_Time,Stepid);
          do{
            Count_NRC78++;
            Res_NRC78_Flage = 1;
            Start_Time_2 = (double)timeNow()/100;
            if(Count_NRC78 != 1) // 后续收到NRC78
            {
              End_Time_2 = (double)timeNow()/100;
              _Check_Time(Msg,Type,End_Time_3,End_Time_2,Stepid);
              End_Time_3 = (double)timeNow()/100;
            }
            testWaitForMessage(@DID::Response_ID,5000);
            testGetWaitEventMsgData(Msg);
            if(Msg.byte(1) == Send_Data[2]+0x40) // 正响应
            {
              End_Time_2 = (double)timeNow()/100;
              _Check_ResMsg(Msg,Res,Type,Start_Time_2,End_Time_2,Stepid);
              if(Msg.byte(2) == 0x67 && Msg.byte(3) == RequestSeed_27)  //种子
              {
                ResLen = (Msg.byte(0)&0xF) + Msg.byte(1);
                if(Msg.FDF == 0 || Response_CanFD == 0)//CAN格式种子
                {
                  for(i=0;i<4;i++)
                    Seed_Save[i] = Msg.byte(i+4);
                  Count_Frame = _ceil((ResLen-6)/7)+1;
                  for(i=1;i<=Count_Frame;i++)
                  {
                    if(testWaitForMessage(@DID::Response_ID,p2cmax))
                    {
                      testGetWaitEventMsgData(Msg);
                      for(j=1;j<8;j++)
                        Seed_Save[4+(i-1)*7+j-1] = Msg.byte(j);
                    }
                  }
                }
                else//CANFD格式
                {
                  for(i=0;i<SendKey_Len-2;i++)
                    Seed_Save[i] = Msg.byte(i+2);
                }
              }
            }
            else if(Msg.byte(1) == 0x7F && Msg.byte(3) != 0x78) //消极应答
            {
               End_Time_2 = (double)timeNow()/100;
              _Check_ResMsg(Msg,Res,Type,Start_Time_2,End_Time_2,Stepid);
            }
          }while(Msg.byte(1) == 0x7F && Msg.byte(3) == 0x78);
          Count_NRC78 = 0;
          Res_NRC78_Flage = 0;
        }
      }
    }
  }
  testWaitForTimeout(10); //发送完毕后等待20ms防止下一帧发送过快
}
/*将种子计算出密钥并存储*/
_FromSeedToKey(byte Key_D[])
{
  int i;
  dword Temp_seed;
  
  for(i=0;i<16;i++)
  {
    Seed_AES[i] = Seed_Save[i];
    Seed_CBC[i] = Seed_Save[i];
  }
  if(AES_128 == 0)
  {
    Temp_seed = 0;
    for(i=0;i<4;i++)
      Temp_seed = (Temp_seed | (Seed_Save[i]<<(3-i)*8));
    _Send_Key_NoResponse(SendKey_Len,@DID::phyreq_ID,Temp_seed,2);
    for(i=0;i<4;i++)
      Key_D[3+i] = Key_Save[i];
  }
  else
  {
    _Send_Key_NoResponse(SendKey_Len,@DID::phyreq_ID,Temp_seed,2);
    for(i=0;i<SendKey_Len-2;i++)
      Key_D[4+i] = Key_Save[i];
  }
}

/*
    Type：2 ：CANFD,  1 ：CAN
*/
_Message_Type_Check(byte Type) /*报文格式验证*/
{
  char Str_Step_Same[50];
  char Str_Step_Diff[50];
  
  int Serve_Pos,Serve_Pos11;
  byte Data_Send_10[3] = {0x02,0x10,0x01};
  byte Data_Send_11[3] = {0x02,0x11,0x01};
  byte Data_Send_14[5] = {0x04,0x14,0xFF,0xFF,0xFF};
  byte Data_Send_27_Seed[3] = {0x02,0x27,0xFF};
  byte Data_Send_27_Key[20] ;
  byte Data_Send_31[10] ;
  byte Data_Send_2E[400];
  byte Data_Send_28[10];
  byte Data_Send_85[10];
  byte Data_Send_19[10];
  byte Data_Send_3E[3] = {0x02,0x3E,0x00};
  int Send_Type; //发送报文格式
  /*----------------------初始化部分----------------------*/
  if(Type == 1)
  {
    Send_Type = 2;
    snprintf(Str_Step_Same,elCount(Str_Step_Same),"CAN");
    snprintf(Str_Step_Diff,elCount(Str_Step_Diff),"CANFD");
  }
  else
  {
    Send_Type = 1;
    snprintf(Str_Step_Same,elCount(Str_Step_Same),"CANFD");
    snprintf(Str_Step_Diff,elCount(Str_Step_Diff),"CAN");
  }
  {   /*---------27服务---------*/
    Data_Send_27_Seed[2] = RequestSeed_27;
    if(SendKey_Len == 0x12)
    {
      Data_Send_27_Key[0] = 0x00;
      Data_Send_27_Key[1] = 0x12;
      Data_Send_27_Key[2] = 0x27;
      Data_Send_27_Key[3] = SendKey_27;
    }
    else
    {
      Data_Send_27_Key[0] = 0x06;
      Data_Send_27_Key[1] = 0x27;
      Data_Send_27_Key[2] = SendKey_27;
    }
  }
  {   /*---------11服务---------*/
    Serve_Pos11 = _Check_Serve(0x11,0,0);
    Data_Send_11[2] = Serve_Data[Serve_Pos11].Serve_Fun[0];
  }
  {   /*---------28服务---------*/
    Serve_Pos = _Check_Serve(0x28,0,0);
    Data_Send_28[0] = 0x03;  Data_Send_28[1] = 0x28;
    Data_Send_28[2] = Serve_Data[Serve_Pos].Serve_Fun[0];
    Data_Send_28[3] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  }
  {   /*---------85服务---------*/
    Serve_Pos = _Check_Serve(0x85,0,0);
    Data_Send_85[0] = 0x02;;  Data_Send_85[1] = 0x85;
    Data_Send_85[2] = Serve_Data[Serve_Pos].Serve_Fun[0];
  }
  {   /*---------19服务---------*/
    // Serve_Pos = _Check_Serve(0x19,0,0);
    Data_Send_19[0] = 0x03;  Data_Send_19[1] = 0x19;
    Data_Send_19[2] = 0x02;  Data_Send_19[3] = 0x01;
    // Data_Send_19[2] = Serve_Data[Serve_Pos].Serve_Fun[1];
    // Data_Send_19[3] = Serve_Data[Serve_Pos].Serve_Para[1][0];
  }
  /*------------------------------------------------------*/
  Data_Send_10[2] = 0x01;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  _Other_1002();
  Data_Send_10[2] = 0x02;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Send_Type,Str_Step_Diff);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  testWaitForTimeout(7000);
  
  if(((Serve_Data[Serve_Pos11].Serve_Session[0])&0x01) == 0)  //服务不支持默认会话
  {
    Data_Send_10[2] = 0x03;
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  }
  if(_Check_Serve(0x11,Data_Send_11[2],5) == 1) //BYD进入1002后由于11服务需要安全访问，故增加此步骤
  {
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Type,Str_Step_Same);
    _FromSeedToKey(Data_Send_27_Key);
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Type,Str_Step_Same);
  }
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_11,-1,Send_Type,Str_Step_Diff);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_11,-1,Type,Str_Step_Same);
  Session_BIN = 1;
  testWaitForTimeout(3000);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_14,-1,Send_Type,Str_Step_Diff);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_14,-1,Type,Str_Step_Same);
  _WriteEx_and_Report("","进入10 02/11服务/14服务验证完成");
  
  Data_Send_10[2] = 0x03;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Send_Type,Str_Step_Diff);
  _FromSeedToKey(Data_Send_27_Key);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Send_Type,Str_Step_Diff);
  
  _get_Arry("Angle_Calibration");
  if(Arry_Len>2)
  {
    Data_Send_31[0] = Arry_Len;
    for(i=1;i<Arry_Len+1;i++)
      Data_Send_31[i] = Arry_Data[i-1];
  }
  else
  {
    byte Data[20];
    _Get_31_ServeData(0,Data,0);
    for(i=1;i<Len_31H+1;i++)
      Data_Send_31[i] = Data[i-1];
    Data[0] = Len_31H;
  }
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_31,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_31,-1,Send_Type,Str_Step_Diff);
  _WriteEx_and_Report("","安全访问以及31服务测试完成");
  
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Type,Str_Step_Same);
  _FromSeedToKey(Data_Send_27_Key);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Type,Str_Step_Same);
  
  _get_Str_Traversal("DID_2E_Traversal");
  if(Traversal_Count==0)
    _WriteEx_and_Report("","未收到2E数据输入");
  else
  {
    _get_2E_DID(Traversal_DID[0]);
    if(DID_2E_SendData_1_Len<=8)
    {
      Data_Send_2E[0] = DID_2E_SendData_1_Len;
      for(i=1;i<DID_2E_SendData_1_Len+1;i++)
        Data_Send_2E[i] = DID_2E_SendData_1[i-1];
    }
    else
    {
      Data_Send_2E[0] = 0x10;
      Data_Send_2E[1] = DID_2E_SendData_1_Len;
      if(DID_2E_SendData_1_Len>255)
      {
        Data_Send_2E[0] = (0x10 | (DID_2E_SendData_1_Len/255));
        Data_Send_2E[1] = (DID_2E_SendData_1_Len&0xFF);
      }
      for(i=0;i<DID_2E_SendData_1_Len;i++)
        Data_Send_2E[i+2] = DID_2E_SendData_1[i];
      
    }
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_2E,-1,Send_Type,Str_Step_Diff);
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_2E,-1,Type,Str_Step_Same);
  }
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_28,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_28,-1,Send_Type,Str_Step_Diff);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_85,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_85,-1,Send_Type,Str_Step_Diff);
  _WriteEx_and_Report("","2E/28/85服务测试完成");
  
  Data_Send_10[2] = 0x01;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  testWaitForTimeout(200);
  
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_19,-1,Type,Str_Step_Same);
  testWaitForTimeout(1000);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_19,-1,Send_Type,Str_Step_Diff);
  testWaitForTimeout(1000);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_3E,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_3E,-1,Send_Type,Str_Step_Diff);
}

_Message_Type_Check_ALL(byte Type) /*报文格式验证*/
{
  char Str_Step_Same[50];
  char Str_Step_Diff[50];
  
  int Serve_Pos,Serve_Pos11;
  byte Data_Send_10[3] = {0x02,0x10,0x01};
  byte Data_Send_11[3] = {0x02,0x11,0x01};
  byte Data_Send_14[5] = {0x04,0x14,0xFF,0xFF,0xFF};
  byte Data_Send_27_Seed[3] = {0x02,0x27,0xFF};
  byte Data_Send_27_Key[20] ;
  byte Data_Send_27_KeyCAN[20] ;
  byte Data_Send_31[10] ;
  byte Data_Send_2E[400];
  byte Data_Send_28[10];
  byte Data_Send_85[10];
  byte Data_Send_19[10];
  byte Data_Send_3E[3] = {0x02,0x3E,0x00};
  int Send_Type; //发送报文格式
  /*----------------------初始化部分----------------------*/
  {
    Type = 2;
    Send_Type = 1;
    snprintf(Str_Step_Same,elCount(Str_Step_Same),"CANFD");
    snprintf(Str_Step_Diff,elCount(Str_Step_Diff),"CAN");
  }
  {   /*---------27服务---------*/
    Data_Send_27_Seed[2] = RequestSeed_27;
    if(SendKey_Len == 0x12)
    {
      Data_Send_27_Key[0] = 0x00;
      Data_Send_27_Key[1] = 0x12;
      Data_Send_27_Key[2] = 0x27;
      Data_Send_27_Key[3] = SendKey_27;
      Data_Send_27_KeyCAN[0] = 0x10;
    }
    else
    {
      Data_Send_27_Key[0] = 0x06;
      Data_Send_27_Key[1] = 0x27;
      Data_Send_27_Key[2] = SendKey_27;
    }
  }
  {   /*---------11服务---------*/
    Serve_Pos11 = _Check_Serve(0x11,0,0);
    Data_Send_11[2] = Serve_Data[Serve_Pos11].Serve_Fun[0];
  }
  {   /*---------28服务---------*/
    Serve_Pos = _Check_Serve(0x28,0,0);
    Data_Send_28[0] = 0x03;  Data_Send_28[1] = 0x28;
    Data_Send_28[2] = Serve_Data[Serve_Pos].Serve_Fun[0];
    Data_Send_28[3] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  }
  {   /*---------85服务---------*/
    Serve_Pos = _Check_Serve(0x85,0,0);
    Data_Send_85[0] = 0x02;;  Data_Send_85[1] = 0x85;
    Data_Send_85[2] = Serve_Data[Serve_Pos].Serve_Fun[0];
  }
  {   /*---------19服务---------*/
    // Serve_Pos = _Check_Serve(0x19,0,0);
    Data_Send_19[0] = 0x03;  Data_Send_19[1] = 0x19;
    Data_Send_19[2] = 0x02;  Data_Send_19[3] = 0x01;
    // Data_Send_19[2] = Serve_Data[Serve_Pos].Serve_Fun[1];
    // Data_Send_19[3] = Serve_Data[Serve_Pos].Serve_Para[1][0];
  }
  /*------------------------------------------------------*/
  Data_Send_10[2] = 0x01;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  _Other_1002();
  Data_Send_10[2] = 0x02;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Send_Type,Str_Step_Diff);
  testWaitForTimeout(7000);
  
  if((Serve_Data[Serve_Pos11].Serve_Session[0])&0x01 == 0)  //服务不支持默认会话
  {
    Data_Send_10[2] = 0x03;
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  }
  if(_Check_Serve(0x11,Data_Send_11[2],5) == 1) //BYD进入1002后由于11服务需要安全访问，故增加此步骤
  {
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Type,Str_Step_Same);
    testWaitForTimeout(100);
    _FromSeedToKey(Data_Send_27_Key);
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Type,Str_Step_Same);
    testWaitForTimeout(100);
  }
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_11,-1,Type,Str_Step_Same);
  testWaitForTimeout(3000);
  Session_BIN = 1;
  
  _Other_1002();
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  testWaitForTimeout(7000);
  
  if(((Serve_Data[Serve_Pos11].Serve_Session[0])&0x01) == 0)  //服务不支持默认会话
  {
    Data_Send_10[2] = 0x03;
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  }
  if(_Check_Serve(0x11,Data_Send_11[2],5) == 1) //BYD进入1002后由于11服务需要安全访问，故增加此步骤
  {
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Type,Str_Step_Same);
    testWaitForTimeout(100);
    _FromSeedToKey(Data_Send_27_Key);
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Type,Str_Step_Same);
    testWaitForTimeout(100);
  }
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_11,-1,Send_Type,Str_Step_Diff);
  Session_BIN = 1;
  testWaitForTimeout(3000);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_14,-1,Send_Type,Str_Step_Diff);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_14,-1,Type,Str_Step_Same);
  _WriteEx_and_Report("","进入10 02/11服务/14服务验证完成");
  
  Data_Send_10[2] = 0x03;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Type,Str_Step_Same);
  _FromSeedToKey(Data_Send_27_Key);
  for(i=1;i<elcount(Data_Send_27_Key);i++)
    Data_Send_27_KeyCAN[i] = Data_Send_27_Key[i];
  if(Type == 1)
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_KeyCAN,-1,Send_Type,Str_Step_Diff);
  else
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Type,Str_Step_Same);
  
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Send_Type,Str_Step_Diff);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Send_Type,Str_Step_Diff);
  _FromSeedToKey(Data_Send_27_Key);
  for(i=1;i<elcount(Data_Send_27_Key);i++)
    Data_Send_27_KeyCAN[i] = Data_Send_27_Key[i];
  if(Send_Type == 1)
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_KeyCAN,-1,Send_Type,Str_Step_Diff);
  else
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Send_Type,Str_Step_Diff);
  
  _get_Arry("Angle_Calibration");
  if(Arry_Len>2)
  {
    Data_Send_31[0] = Arry_Len;
    for(i=1;i<Arry_Len+1;i++)
      Data_Send_31[i] = Arry_Data[i-1];
  }
  else
  {
    byte Data[20];
    _Get_31_ServeData(0,Data,0);
    for(i=1;i<Len_31H+1;i++)
      Data_Send_31[i] = Data[i-1];
    Data[0] = Len_31H;
  }
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_31,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_31,-1,Send_Type,Str_Step_Diff);
  _WriteEx_and_Report("","安全访问以及31服务测试完成");
  
  
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Seed,-1,Type,Str_Step_Same);
  _FromSeedToKey(Data_Send_27_Key);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_27_Key,-1,Type,Str_Step_Same);
  
  _get_Str_Traversal("DID_2E_Traversal");
  if(Traversal_Count==0)
    _WriteEx_and_Report("","未收到2E数据输入");
  else
  {
    _get_2E_DID(Traversal_DID[0]);
    if(DID_2E_SendData_1_Len<=8)
    {
      Data_Send_2E[0] = DID_2E_SendData_1_Len;
      for(i=1;i<DID_2E_SendData_1_Len+1;i++)
        Data_Send_2E[i] = DID_2E_SendData_1[i-1];
    }
    else
    {
      Data_Send_2E[0] = 0x10;
      Data_Send_2E[1] = DID_2E_SendData_1_Len;
      if(DID_2E_SendData_1_Len>255)
      {
        Data_Send_2E[0] = (0x10 | (DID_2E_SendData_1_Len/255));
        Data_Send_2E[1] = (DID_2E_SendData_1_Len&0xFF);
      }
      for(i=0;i<DID_2E_SendData_1_Len;i++)
        Data_Send_2E[i+2] = DID_2E_SendData_1[i];
    }
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_2E,-1,Send_Type,Str_Step_Diff);
    testWaitForTimeout(100);
    Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_2E,-1,Type,Str_Step_Same);
  }
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_28,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_28,-1,Send_Type,Str_Step_Diff);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_85,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_85,-1,Send_Type,Str_Step_Diff);
  _WriteEx_and_Report("","2E/28/85服务测试完成");
  
  Data_Send_10[2] = 0x01;
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_10,-1,Type,Str_Step_Same);
  testWaitForTimeout(200);
  
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_19,-1,Type,Str_Step_Same);
  testWaitForTimeout(1000);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_19,-1,Send_Type,Str_Step_Diff);
  testWaitForTimeout(1000);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_3E,-1,Type,Str_Step_Same);
  Send_Check_ResMsg(@DID::phyreq_ID,Data_Send_3E,-1,Send_Type,Str_Step_Diff);
}




