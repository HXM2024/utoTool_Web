_CAN_TP_CF_19()/*等待流控制帧*/
{
  byte Data[8] = {0x03,0x22,0x22,0x00,0x55,0x55,0x55,0x55};
  byte Data_1[8] = {0x31,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Data_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  int i,Temp_SN;
  
  _Get_DID_TP(Data,2);
  Data[0] = 1 + _TP_CAN_DID_Input;
  
  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFF(1);
  testWaitForTimeout((dword)N_Bs_Time*0.8);
  _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
  _Check_NoResponse(N_Bs_Time + N_Bs_Time_Tolerance);
  _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
  _TPgetCF(0);
  testWaitForTimeout(2000);
  
  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFF(1);
  testWaitForTimeout((dword)N_Bs_Time*0.8);
  _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
  _Check_NoResponse(N_Bs_Time - N_Bs_Time_Tolerance);
  _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
  if(N_WFTmax == 0)
    _TPgetCF(0);
  else
  {
    Temp_SN=(_TP_CAN_DID_Len-6)/7;
    if((_TP_CAN_DID_Len-6)%7 != 0)
      Temp_SN+=1;
    for(i=1;i<=Temp_SN;i++)
      _Check_TPgetCF(1,_TP_CAN_DID_Len,i);
    _TPgetCF(0);
    testWaitForTimeout(1000);
  }
}
_CAN_TP_CF_19_1()/*等待流控制帧的N_WFTmax*/
{
  byte Data[8] = {0x03,0x22,0x22,0x00,0x55,0x55,0x55,0x55};
  byte Data_1[8] = {0x31,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Data_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  int i,Temp_SN;
  
  if(N_WFTmax == 0)
  {
    _WriteEx_and_Report("","最大个数为0，不适用");
    return;
  }

  _Get_DID_TP(Data,2);
  Data[0] = 1 + _TP_CAN_DID_Input;
  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFF(1);
  for(i=0;i<N_WFTmax;i++)
  {
    testWaitForTimeout(10);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    writeEx(-3,0,"当前已发送 %d 次",i+1);
  }
  testWaitForTimeout(10);
  _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
  Temp_SN=(_TP_CAN_DID_Len-6)/7;
  if((_TP_CAN_DID_Len-6)%7 != 0)
    Temp_SN+=1;
  for(i=1;i<=Temp_SN;i++)
    _Check_TPgetCF(1,_TP_CAN_DID_Len,i);
  _TPgetCF(0);
  testWaitForTimeout(2000);

  
  _Get_DID_TP(Data,2);
  Data[0] = 1 + _TP_CAN_DID_Input;
  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFF(1);
  for(i=0;i<N_WFTmax+1;i++)
  {
    testWaitForTimeout(10);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    writeEx(-3,0,"当前已发送 %d 次",i+1);
  }
  testWaitForTimeout(10);
  _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
  _Check_NoResponse(500);

}

