{
  byte Data[8] = {0x00,0x22,0xf1,0x80,0x55,0x55,0x55,0x55};
  byte Len[4] = {0x00,0x01,0x08,0x09};
  int i;
  _Get_DID_TP(Data,2);
  for(i=0;i<4;i++)
  {
    Data[0] = Len[i];
    _TPsendmsg_Phy(Data,elCount(Data),1);
    if(Len[i] == 0x01)
      _Check_ResponseRx_(1,300);
    else
      _TPgetSF(0);
    testWaitForTimeout(1000);
  }
}
_CANFD_TP_SF_2() /*单帧请求报文（CAN_DL=12）SF_DL测试*/
{
  byte Data[12] = {0x00,0x22,0xf1,0x80,0x11,0x11,0x11,0x11,0x11,0x11,0x00,0x00};
  byte Len[4] = {0x07,0x08,0x0A,0x0B};
  byte Len_[4] = {0x01,0x08,0x09,0x0A};
  int i;
  _Get_DID_TP(Data,3);
  for(i=0;i<4;i++)
  {
    Data[1] = Len[i];
    _TPsendmsg_Phy(Data,elCount(Data),1);
    if(Len[i] == 0x08 || Len[i] == 0x0A)
      _Check_ResponseRx_(1,300);
    else
      _TPgetSF(0);
    testWaitForTimeout(1000);
  }
  testWaitForTimeout(3000);
  for(i=0;i<4;i++)
  {
    if(i==0)
    {
      _Get_DID_TP(Data,3);
      Data[0] = Len_[i];
      Data[1] = 0x0A;
    }
    else
    {
      Data[0] = Len_[i];
      _Get_DID_TP(Data,2);
    }
    _TPsendmsg_Phy(Data,elCount(Data),1);
    _TPgetSF(0);
    testWaitForTimeout(1000);
  }
}
