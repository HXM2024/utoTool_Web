  byte Data_1[8] = {0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_2[8] = {0x22,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_3[8] = {0x02,0x3E,0x80,0x55,0x55,0x55,0x55,0x55};
  byte Data_4[8] = {0x03,0x22,0x80,0x55,0x55,0x55,0x55,0x55};
  byte Data_5[8] = {0x30,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_6[8] = {0x03,0x22,0x35,0x70,0x00,0x00,0x00,0x00};
  int i,Temp_SN,Len;
  _Get_TP_DID("TP_CAN_DID");
  {
    _TPsendmsg_Phy(Data,elCount(Data),0);
