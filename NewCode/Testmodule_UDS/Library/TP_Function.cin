_CAN_TP_CF_7()/*错误连续帧报文*/
{
  byte Data[8] = {0x10,0x1B,0x22,0x00,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x41,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_2[8] = {0x42,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_3[8] = {0x43,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  
  byte Data1[8] = {0x10,0x1B,0x22,0x00,0x00,0x00,0x00,0x00};
  byte Data_11[8] = {0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_22[8] = {0x23,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_33[8] = {0x22,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
    
  {
    _TPsendmsg_Phy(Data1,elCount(Data1),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_11,elCount(Data_11),0);
      testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_22,elCount(Data_22),0);
      testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_33,elCount(Data_33),0);
    _TPgetCF(0);
  }
  testWaitForTimeout(1000);

  {
    _TPsendmsg_Phy(Data1,elCount(Data1),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_33,elCount(Data_33),0);
      testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_11,elCount(Data_11),0);
      testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_22,elCount(Data_22),0);
    _TPgetCF(0);
  }
  testWaitForTimeout(1000);

  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFC(1);
  _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
  testWaitForTimeout(STmin+5);
  _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
    testWaitForTimeout(STmin+5);
  _TPsendmsg_Phy(Data_3,elCount(Data_3),0);
  _TPgetCF(0);
  testWaitForTimeout(1000);
}
