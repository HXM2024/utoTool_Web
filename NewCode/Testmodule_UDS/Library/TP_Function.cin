testcase HardwareTest()
{
  int i,OutPut_Count,m;
  byte Data[8] = {0x02,0x10,0x05,0x55,0x55,0x55,0x55,0x55};
  
  byte Data_Send[8] = {0x02,0x73,0x01,0x32,0x33,0x30,0x32,0x30};
  byte Data_ResPose[8] = {0x20,0x73,0x01,0,0,0,0,0};
  
  message *Msg;
  
  Init_Main_Special("\\特殊工况\\",defsession);
  OutPut_Count = 0;
  _K15_OFF();
  testWaitForTimeout(2000);
  
  for(i=0;i<200;i++)
  {
    _TPsendmsg(Data,elCount(Data),HardwareTest_ID,0);
    if(i<15)
      testWaitForTimeout(5);
    else if(i==15)
      _K15_ON_NoTime();
    else
    {
      if(testWaitForMessage(0x100,5))
      {
        testGetWaitEventMsgData(Msg);
        if(Brushed_Or_Brushless == 1)
        {
          if((Msg.byte(0)== 0x20) && (Msg.byte(1)== 0x50) && (Msg.byte(2)== 0x05) && (Msg.byte(3)== 0xAA)) /* && (Msg.byte(4)== 0x55) && (Msg.byte(5)== 0x55) && (Msg.byte(6)== 0x55) && (Msg.byte(7)== 0x55)无规范，屏蔽*/
            testStepPass("","收到响应与预期一致");
          else
            testStepFail("","收到响应与预期不一致");
        }
        else if(Brushed_Or_Brushless == 0)
        {
          if((Msg.byte(0)== 0x48) && (Msg.byte(1)== 0x61) && (Msg.byte(2)== 0x72) && (Msg.byte(3)== 0x64) && (Msg.byte(4)== 0x77) && (Msg.byte(5)== 0x61) && (Msg.byte(6)== 0x72) && (Msg.byte(7)== 0x65))
            testStepPass("","收到响应与预期一致");
          else
            testStepFail("","收到响应与预期不一致");
        }
        break;
      }
    }
  }
  _Get_HardwareTest_Data_Value();
  OutPut_Count = HardwareTest_Data_Len/5;
  if((HardwareTest_Data_Len%5)!= 0 )
    OutPut_Count = OutPut_Count+1;
  Data_Send[0] = 0x02;
  Data_Send[1] = 0x73;
  Data_ResPose[0] = 0x20;
  Data_ResPose[1] = 0x73;
  for(i=1;i<=OutPut_Count;i++)
  {
    Data_Send[2] = i;
    Data_ResPose[2] = i;
    for(m=3;m<8;m++)
    {
      if((i-1)*5+m-3>=HardwareTest_Data_Len) /*防止长度报错*/
      {
        Data_Send[m] = 0x55;
        Data_ResPose[m] = 0x00; 
      }
      else
      {
        Data_Send[m] = HardwareTest_Data[(i-1)*5+m-3];
        Data_ResPose[m] = 0x00; 
      }
    }
    _TPsendmsg(Data_Send,elCount(Data_Send),1,0);
    _Check_ResTP(0x100,Data_ResPose,8);
  }
  testWaitForTimeout(1000);
  if(i==200)
    testStepFail("","未收到工装应答");
  Data_Send[0] = 0x03;
  Data_Send[1] = 0x74;
  Data_ResPose[0] = 0x20;
  Data_ResPose[1] = 0x74;
  for(i=1;i<=OutPut_Count;i++)
  {
    Data_Send[2] = i;
    Data_ResPose[2] = i;
    for(m=3;m<8;m++)
    {
      if((i-1)*5+m-3>=HardwareTest_Data_Len) /*防止长度报错*/
      {
        Data_Send[m] = 0x20;
        Data_ResPose[m] = 0x00; 
      }
      else
      {
        Data_Send[m] = 0x20;
        Data_ResPose[m] = HardwareTest_Data[(i-1)*5+m-3]; 
      }
    }
    _TPsendmsg(Data_Send,elCount(Data_Send),1,0);
    _Check_ResTP(0x100,Data_ResPose,8);
  }
  
  _WriteEx_and_Report("","上下电防止停留在工装中");
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  End_Main();
}

testcase Case_Message_Type_Check_CAN()
{
  _WriteEx_and_Report("","测试前注意将通讯通道改为CANFD格式,否则CANFD报文无法正常发出");
  Init_Main_Def();  
  if((Support_CAN & 2) != 0)
    _WriteEx_and_Report("","当前输入支持CANFD格式，此用例不适用");
  else
    _Message_Type_Check(1);  //CAN格式
  End_Main();
}
testcase Case_Message_Type_Check_CANFD()
{
  _WriteEx_and_Report("","测试前注意将通讯通道改为CANFD格式,否则CANFD报文无法正常发出");
  Init_Main_Def();
  if((Support_CAN & 1) != 0)
    _WriteEx_and_Report("","当前输入支持CAN格式，此用例不适用");
  else
    _Message_Type_Check(2);  //CANFD格式
  End_Main();
}
testcase Case_Message_Type_Check_ALL()
{
  _WriteEx_and_Report("","测试前注意将通讯通道改为CANFD格式,否则CANFD报文无法正常发出");
  Init_Main_Def();
  if( Support_CAN != 3)
    _WriteEx_and_Report("","当前输入不兼容，此用例不适用");
  else
    _Message_Type_Check_ALL(3);  //CANFD格式 兼容 CAN格式
  End_Main();
}

