  byte Data[48] = {0x00,0x22,0xf1,0x80,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11};
  byte Len[4] = {0x1E,0x1F,0x2E,0x2F};
  byte Len_[3] = {0x0D,0x3F,0x3E};
  int i;
  _Get_DID_TP(Data,3);
  for(i=0;i<4;i++)
  {
    Data[1] = Len[i];
    _TPsendmsg_Phy(Data,elCount(Data),1);
    if(Len[i] == 0x1F || Len[i] == 0x2E)
      _Check_ResponseRx_(1,300);
    else
      _TPgetSF(0);
    testWaitForTimeout(1000);
  }
  testWaitForTimeout(3000);
  for(i=0;i<3;i++)
  {
    if(i==0)
    {
      _Get_DID_TP(Data,3);
      Data[0] = Len_[i];
      Data[1] = 0x2E;
    }
    else
    {
      Data[0] = Len_[i];
      _Get_DID_TP(Data,2);
    }
    _TPsendmsg_Phy(Data,elCount(Data),1);
    _TPgetSF(0);
    testWaitForTimeout(1000);
  }
}
