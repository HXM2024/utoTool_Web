      _Check_TPgetCF(1,_TP_CAN_DID_Len,i); 
  }
  testWaitForTimeout(2000);
  {
    _TPsendmsg_Phy(Data_6,elCount(Data_6),0);
    Len = _TPgetFF(1);
    _TPsendmsg_Phy(Data_5,elCount(Data_5),0);
    _Check_TPgetCF(1,Len,1); 
    _TPsendmsg_Phy(Data_3,elCount(Data_3),0);
    Temp_SN=(Len-6)/7;
    if((Len-6)%7 != 0)
      Temp_SN+=1;
    for(i=2;i<=Temp_SN;i++)
      _Check_TPgetCF(1,Len,i); 
  }
}
