_CANFD_TP_FC_8() /*控制器收到的BlockSize测试*/
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte BlockSize[5] = {0x00,0x01,0x02,0x08,0xFF};
  int i,j,FF_DL,Temp_SN,Fal;
  
  if(DID_22_Support>=3)
  {
    Data_Send_1[0] = 0x07;
    Data_Send_1[4] = 0x35;
    Data_Send_1[5] = 0x70;
    Data_Send_1[6] = 0x35;
    Data_Send_1[7] = 0x70;
  }
  for(j=0;j<elcount(BlockSize);j++)
  {
    Data_Send_2[1] = BlockSize[j];
    _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
    FF_DL = _TPgetFF(1);
    _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
//    Temp_SN=(FF_DL-6)/7;
//    if((FF_DL-6)%7 != 0)
//      Temp_SN+=1;
    Temp_SN = _Get_CF_SN(FF_DL);
    if(BlockSize[j] != 0)
    {
      for(i=1;i<=BlockSize[j];i++)
      {
        if(i>Temp_SN)
          break;
        _Check_TPgetCF(1,FF_DL,i);
      }
      Fal = _Check_NoResponse_(500);
      if(Fal == -1)
        testStepFail("","0x%02X BlockSize块收到超过预期的流控帧数量",BlockSize[j]);
      else
        testStepPass("","0x%02X BlockSize块收到符合预期的流控帧数量",BlockSize[j]);
    }
    else
    {
      for(i=1;i<=Temp_SN;i++)
        _Check_TPgetCF(1,FF_DL,i);
      Fal = _Check_NoResponse_(500);
      if(Fal == -1)
        testStepFail("","0x%02X BlockSize块收到超过预期的流控帧数量",BlockSize[j]);
      else
        testStepPass("","0x%02X BlockSize块收到符合预期的流控帧数量",BlockSize[j]);
    
    }
    testWaitForTimeout(3000);
  }
}

