_CAN_TP_Disturb_1() /*控制器多帧发送被非预期单帧请求报文干扰*/
{
  byte Data[8] = {0x03,0x22,0x22,0x00,0x55,0x55,0x55,0x55};
  byte Data_1[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Data_2[8] = {0x03,0x22,0xF1,0x84,0x55,0x55,0x55,0x55};
  int i,Temp_SN,len;
  _Get_DID_TP(Data,2);
  if(_TP_CAN_DID_Len<=0x0D)
    writeEx(-3,0,"当前选择DID反馈仅两帧,无法测试多帧干扰");
  else
  {
    _TPsendmsg_Phy(Data,elCount(Data),0);
    len = _TPgetFF(1);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    _TPgetCF_21(1);
    _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
    if(MF_Phy_SF_TxDisturb == 0)
    {
      Temp_SN=(len-6)/7;
      if((len-6)%7 != 0)
        Temp_SN+=1;
      for(i=2;i<=Temp_SN;i++)
        _Check_TPgetCF(1,len,i);
    }
    else
      _TPgetNotCF(1,2);
  }
}
