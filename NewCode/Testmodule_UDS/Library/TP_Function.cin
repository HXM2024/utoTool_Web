void Init_TP()
{
  _WriteEx_and_Report("","初始化");
  Get_value();
  _Get_CarSpd_Engine();
  diagStopTesterPresent(Cdd_Name);/*关闭cdd文件，防止自动发流控帧对测试造成干扰*/
  creat_log("\\UDS_TP_Logging\\");
  startLogging();
}
void End_TP()
{
  stopLogging();
  testWaitForTimeout(1000);
}
_Get_TP_DID(char str[])
{
  char Temp_Value1[200];
  char Temp_Value2[20];
  int i,m,j,flage;
  m=0;flage = 0;
  _TP_CAN_DID_Input = 0;
  snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
  snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,str,"Null",Temp_Value1,1000, file_name_1);
  fileClose(GlbHandlefile);
  for(i=0;i<strlen(Temp_Value1);i++)
  {
    if(Temp_Value1[i] == 123)
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j] == 44 || Temp_Value1[j] == 125)
        {
          _TP_CAN_DID[m] = atol(Temp_Value2);
          _TP_CAN_DID_Input++;
          m++;
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          if( Temp_Value1[j] == 125)
            break;
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    else if(Temp_Value1[i] == 91)
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==93)
        {
          _TP_CAN_DID_Len = atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          break;
        }
        snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
  }
}

_TPsendmsg_Phy(byte data[],byte length,byte type)   //物理寻址发送
{
  char comment[50];
  int i;
  message * msg;
  msg.id = @DID::phyreq_ID;
  msg.dlc=length;//将报文长度赋值到message对象
  msg.DataLength=length;//将报文长度赋值到message对象
  
  if(elCount(data)>=length)
  {
    for(i=0;i<length;i++)
      msg.byte(i)=data[i];//将数值赋值到message对象
  }
  else
  {
    for(i=0;i<elCount(data);i++)
      msg.byte(i)=data[i];//将数值赋值到message对象
    for(i=elCount(data);i<length;i++)
      msg.byte(i)=Send_filler;//默认填充值
  }
  if(type==1)
  {
    msg.FDF = 1;
    msg.BRS = 1;
  }
  else
  {
    msg.FDF = 0;
    msg.BRS = 0;
  }
  output(msg);//发送报文
  //判断发送报文的帧类型并写入报告
  if((msg.byte(0)&0xF0)==0x00)
    snprintf(comment,elCount(comment),"已发送单帧报文");
  else if((msg.byte(0)&0xF0)==0x10)
    snprintf(comment,elCount(comment),"已发送首帧报文");
  else if((msg.byte(0)&0xF0)==0x20)
    snprintf(comment,elCount(comment),"已发送连续帧报文");
  else if((msg.byte(0)&0xF0)==0x30)
    snprintf(comment,elCount(comment),"已发送流控帧报文");
  else
    snprintf(comment,elCount(comment),"已发送报文");
  
  for(i=0;i<elCount(data);i++)
  {
    snprintf(comment,elCount(comment),"%s %02X",comment,data[i]);
  }
  testCaseComment(comment);
}

