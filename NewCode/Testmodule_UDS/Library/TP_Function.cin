_CAN_TP_CF_10()/*连续帧SN值测试*/
{
  byte Data[8] = {0x10,0x29,0x22,0x35,0x70,0x00,0x00,0x00};
  byte Data_1[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Size[4]= {0x01,0x02,0x80,0xff};
  int i,j,flage,m;
  int Temp_SN;
  byte Start_Byte;
  
  {
    Start_Byte = 0x20;
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    for(i = Start_Byte;i<=0x24;i++)
    {
      Data_1[0] = i;
      testWaitForTimeout(STmin+5);
      _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    }
    _Check_NoResponse_(500);
  }
  testWaitForTimeout(3000);
  
  {
    int Wait_Time;
    Wait_Time = N_Cr_Time- STmin - 10;
    if(Wait_Time<=0)
      Wait_Time = STmin;
    
    flage = 0;m=1;
    Start_Byte = 0x21;
    Data[1] = 0x7D;
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    for(j=0;j<2;j++)
    {
      if(flage == 0)
      {
        for(i=Start_Byte;i<=0x2F;i++)
        {
          if(j==1 && i ==0x23)
          {
            flage = 1;
            break;
          }
          Data_1[0] = i;
          testWaitForTimeout(STmin+5);
          _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
          m++;
          if(BS == 0)
            _Check_NoResponse(Wait_Time);
          else
          {
            if(j==0 && m==BS+1)
              _TPgetFC(1);
            else if( m==BS+1)
              _Check_NoResponse(Wait_Time);
            if(m==BS+1)
              m=1;
          }
        }
      }
    }
   _Check_NoResponse_(500);
  }
  testWaitForTimeout(3000);
  
  {
    int Wait_Time;
    Wait_Time = N_Cr_Time- STmin - 10;
    if(Wait_Time<=0)
      Wait_Time = STmin;
    
    flage = 0;m=1;
    Start_Byte = 0x21;
    Data[1] = 0x7D;
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    for(j=0;j<2;j++)
    {
      if(flage == 0)
      {
        if(j==1)
          Start_Byte = 0x20;
        for(i=Start_Byte;i<=0x2F;i++)
        {
          Data_1[0] = i;
          testWaitForTimeout(STmin+5);
          _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
          if(j==1 && i ==0x21)
          {
            flage = 1;
            break;
          }
          m++;
          if(BS == 0)
            _Check_NoResponse(Wait_Time);
          else
          {
            if(m==BS+1)
              _TPgetFC(1);
            else if( m==BS+1)
              _Check_NoResponse(Wait_Time);
            if(m==BS+1)
              m=1;
          }
        }
      }
    }
   _Check_NRC(0);
  }
  testWaitForTimeout(3000);
  
}
