}
_Check_TPgetCF(byte passcondition,int Len,byte SN)  //检测连续帧结束后的填充值，预期DID反馈总长度
{
  message 0x00 msg;
  char comment[50];
  byte i;
  int Start_Len;
  int Temp;
  byte Flage ;
  Flage = 0;
  if(testWaitForMessage(@DID::Response_ID,300))
  {
    testGetWaitEventMsgData(msg);
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    testCaseComment(comment);
    if((msg.byte(0)&0xf0)==0x20)
    {
      if(passcondition==0)
        testStepFail("收到连续帧");
      else
      {
        testStepPass("收到连续帧");
        if(SN>0xF)
          SN = SN - 0xF -1;
        if((msg.byte(0)&0x0f)==(SN&0x0F))
          testStepPass("","收到连续帧序列号与预期一致，0x%02X",((SN&0x0F)|0x20));
        else
          testStepFail("","收到连续帧序列号与预期不一致,预期为0x%x,实际为0x%x",(SN&0x0F),(msg.byte(0)&0x0f));
        if(Response_CanFD == 0)
        {
          Start_Len = ((msg.byte(0)&0x0F)-1)*7+6;
          Temp = Len - Start_Len;
          if(Temp+1<8)
          {
            for(i= Temp+1;i<8;i++)
            {
              if(msg.byte(i)!= TP_filler)
                Flage = 1;
            }
            if(Flage==1)
              testStepFail("非数据域填充值出现错误");
            else
              testStepPass("非数据域填充值与预期一致");
          }
        }
        else
        {
          Start_Len = ((msg.byte(0)&0x0F)-1)*63+64-2;
          Temp = Len - Start_Len;
          if(Temp+1<64)
          {
            for(i= Temp+1;i<msg.DataLength;i++)
            {
              if(msg.byte(i)!= TP_filler)
                Flage = 1;
            }
            if(Flage==1)
              testStepFail("非数据域填充值出现错误");
            else
              testStepPass("非数据域填充值与预期一致");
          }
        }
      }
    }
    else
      testStepFail("收到非连续帧");
  }
  else
  {
    if(passcondition==0)
      testStepPass("未收到连续帧或数据帧");
    else
      testStepFail("未收到连续帧或数据帧");
  }
}
/*
    Type==0:判断是否为NRC13或NRC31
    Type==1:判断是否为具体NRC7F
    Type==2:判断是否为具体NRC13
    Type==3:判断为NRC但不判断具体值
*/
_Check_NRC(byte Type)
{
  message 0x00 msg;
  char comment[50];
  int i;
  int Flage;
  Flage = 0;
  if(testWaitForMessage(@DID::Response_ID,2000))//对于接收ID等待1000ms，收到报文返回值为1
  {
    testGetWaitEventMsgData(msg);//将收到的报文赋值给msg
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    testCaseComment(comment);
    if(((msg.byte(0))==0x03) &&((msg.byte(1))==0x7F))
    {
      if(Type == 0)
      {
        if((msg.byte(3)==0x13) ||(msg.byte(3)==0x31))
          testStepPass("","收到NRC码0x%2X",msg.byte(3));
        else
          testStepFail("","收到非预期NRC码0x%2X",msg.byte(3));
      }
      else if(Type == 1)
      {
        if((msg.byte(3)==0x7F) )
          testStepPass("","收到NRC码0x%2X",msg.byte(3));
        else
          testStepFail("","收到非预期NRC码0x%2X",msg.byte(3));
      }
      else if(Type == 2)
      {
        if((msg.byte(3)==0x13) )
          testStepPass("","收到NRC码0x%2X",msg.byte(3));
        else
          testStepFail("","收到非预期NRC码0x%2X",msg.byte(3));
      }
      else if(Type == 3)
      {
        if((msg.byte(1)==0x7F) && (msg.byte(3)!=0x78))
          testStepPass("","收到NRC码0x%2X",msg.byte(3));
        else
          testStepFail("","收到非NRC应答");
      }
      for(i=4;i<8;i++)
      {
        if(((msg.byte(i))!= TP_filler))
          Flage = 1;
      }
      if(Flage == 0)
        testStepPass("非数据域填充值与预期一致");
      else
        testStepFail("非数据域填充值出现错误");
    }
    else
      testStepFail("未收到NRC码");
  }
  else
    testStepFail("未收到响应");
}

 _Check_NoResponse(dword Time)
{
  if(testWaitForMessage(@DID::Response_ID,Time))
    testStepFail("收到响应数据");
  else
    testStepPass("未收到响应数据");
}

int _Check_NoResponse_(dword Time)
{
  int Flage;
  if(testWaitForMessage(@DID::Response_ID,Time))
  {
    testStepFail("收到响应数据");
    Flage = -1;
  }
  else
  {
    testStepPass("未收到响应数据");
    Flage = 1;
  }
  return Flage;
}
/*
  Type == 1 : 期望应答
  Type == 0 : 期望不应答
*/
int _Check_ResponseRx_(byte Type, word Time)
{
  int Flage;
  int Re;
  Re = testWaitForMessage(@DID::Response_ID,Time);
  if(Type == 1)
  {
    if(Re == 0)
    {
      testStepFail("未收到响应数据");
      Flage = -1;
    }
    else
    {
      testStepPass("收到响应数据");
      Flage = 1;
    }
  }
  else if(Type == 0)
  {
    if(Re == 0)
    {
      testStepPass("未收到响应数据");
      Flage = 1;
    }
    else
    {
      testStepFail("收到响应数据");
      Flage = -1;
    }
  }
  return Flage;
}

/*
  Serve:服务
  返回不同长度个数
*/
void GetSevreFunDLC(byte Serve,dword FunData[][])
{
  int Serve_Pos,i;
  Serve_Pos = _Check_Serve(Serve,0,0);
  DLCTest_Count = 0;
  if(Serve != 0x31)
  {
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      if(_Check_Dword_in_Num(Serve_Data[Serve_Pos].Serve_Fun_Len[i],FunData,DLCTest_Count) == -1)
      {
        FunData[DLCTest_Count][0] = Serve_Data[Serve_Pos].Serve_Fun_Len[i];
        FunData[DLCTest_Count][1] = Serve_Data[Serve_Pos].Serve_Fun[i];
        DLCTest_Count++;
      }
    }
  }
  else
  {
    for(i=0;i<Serve_31_Hex_Count;i++)
    {
      if(_Check_Dword_in_Num(Serve_31_Hex[i].Routine_Len,FunData,DLCTest_Count) == -1)
      {
        FunData[DLCTest_Count][0] = Serve_31_Hex[i].Routine_Len;
        FunData[DLCTest_Count][1] = ((Serve_31_Hex[i].Routine[0]<<8)&0xFF00) + (Serve_31_Hex[i].Routine[1]&0xFF);
        DLCTest_Count++;
      }
    }
  }
}

void DLC_Error_INFCPL_Test(int DLC_Now)
{
  byte Data[8];
  int Serve_Pos,Fun_Pos,Flage,i;
  dword DataList[20][2];
  Init();
  Flage = _Check_Serve(0x14,0,0);//支持14服务则为APP
  Data[0] = DLC_Now-1;
  if(Flage != -1)//APP下
  {
    for(Serve_Pos=0;Serve_Pos<Serve_Data_Count;Serve_Pos++)
    {
      Data[1] = Serve_Data[Serve_Pos].Serve;
      GetSevreFunDLC(Serve_Data[Serve_Pos].Serve,DataList);
      for(i=0;i<DLCTest_Count;i++)
      {
        Data[2] = DataList[i][1];
        if(Serve_Data[Serve_Pos].Serve == 0x22 || Serve_Data[Serve_Pos].Serve == 0x2E)
        {
          Data[2] =  (DataList[i][1]>>8)&0xFF;
          Data[3] =   DataList[i][1]    &0xFF;
        }
        else if(Serve_Data[Serve_Pos].Serve == 0x14)
        {
          Data[2] = 0xFF;Data[3] = 0xFF;Data[4] = 0xFF;
        }
        else if(Serve_Data[Serve_Pos].Serve == 0x28)
        {
          Data[3] = Serve_Data[Serve_Pos].Serve_Para[0][0];
        }
        else if(Serve_Data[Serve_Pos].Serve == 0x19)
        {
          if(DataList[i][1] == 0x01 || DataList[i][1] == 0x02)
            Data[3] = 0x09;
          else if(DataList[i][1] == 0x04 || DataList[i][1] == 0x06)
          {
            Data[3] = (DTC_19[0][1]>>16)&0xFF;
            Data[4] = (DTC_19[0][1]>>8) &0xFF;
            Data[5] = (DTC_19[0][1]>>0) &0xFF;
            Data[6] = Freeze_Frame_Number[0];
          }
        }
        _TPsendmsg_Phy(Data,DLC_Now,0);
        if(DataList[i][0] < DLC_Now)
          _Check_ResponseRx_(1,p2cmax);
        else
          _Check_ResponseRx_(0,p2cmax);
        testWaitForTimeout(200);
      }
    }
    {
      Data[1] = 0x31;
      GetSevreFunDLC(0x31,DataList);
      for(i=0;i<DLCTest_Count;i++)
      {
        Fun_Pos = _Check_Serve(0x01,DataList[i][1],12);
        Data[2] = Serve_31_Hex[Fun_Pos].Control_Type[0];
        Data[3] = (DataList[i][1]>>8) &0xFF;
        Data[4] = DataList[i][1]      &0xFF;
        _TPsendmsg_Phy(Data,DLC_Now,0);
        if(DataList[i][0] < DLC_Now)
          _Check_ResponseRx_(1,p2cmax);
        else
          _Check_ResponseRx_(0,p2cmax);
        testWaitForTimeout(200);
        if(DLC_Now<5)
          break;
      }
    }
  }
}

_TPgetSF(byte passcondition)  //单帧--------仅当为0时期望不收到单帧
{
  message 0x00 msg;
  char comment[50];
  byte SF_DL;
  byte Flage;
  byte i;
  Flage =0;
  if(testWaitForMessage(@DID::Response_ID,1000))//对于接收ID等待1000ms，收到报文返回值为1
  {
    testGetWaitEventMsgData(msg);//将收到的报文赋值给msg
    
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    }
    testCaseComment(comment);
    
    if((msg.byte(0)&0xF0)==0x00)//判断是不是单帧
    {
      if(passcondition==0)
        testStepFail("收到单帧响应");
      else
      {
        testStepPass("收到单帧响应");
        SF_DL = msg.byte(0)&0x0F;
        if(SF_DL!=7)
        {
          /*非数据部分填充值*/
          for(i=SF_DL+1;i<8;i++)
          {
            if(msg.byte(i)!= TP_filler)
              Flage=1;
          }
          if(Flage==1)
            testStepFail("非数据域填充值存在非预期情况");
          else
            testStepPass("非数据域填充值与预期一致");
        }
      }
    }
    else
      testStepFail("收到非单帧响应");
  }
  else
  {
    if(passcondition==0)
      testStepPass("未收到单帧或数据帧");
    else
      testStepFail("未收到单帧或数据帧");
  }
}
_Check_10_01(byte passcondition)
{
  message 0x00 msg;
  char comment[50];
  byte Flage;
  byte i;
  Flage =0;
  if(testWaitForMessage(@DID::Response_ID,1000))//对于接收ID等待1000ms，收到报文返回值为1
  {
    testGetWaitEventMsgData(msg);//将收到的报文赋值给msg
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    testCaseComment(comment);
    if(msg.byte(1)==0x50 &&  msg.byte(2)==0x01)
    {
      if(passcondition==0)
        testStepFail("收到10 01正响应");
      else
        testStepPass("收到10 01正响应");
    }
    else
      testStepFail("收到非预期响应");
  }
  else
  {
    if(passcondition==0)
      testStepPass("未收到应答");
    else
      testStepFail("未收到应答");
  }
}

_Get_HardwareTest_Data_Value()
{
  char Temp_Value1[1000];
  char Temp_Value2[20];
  int i,j;
  
  HardwareTest_Data_Len = 0;
  snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
  snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
  GlbHandlefile = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,"HardwareTest_Data","Null",Temp_Value1,1000, file_name_1);
  fileClose(GlbHandlefile);
  for(i=0;i<strlen(Temp_Value1);i++)
  {
    if(Temp_Value1[i] == 123)
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j] == 44 || Temp_Value1[j] == 125)
        {
          HardwareTest_Data[HardwareTest_Data_Len] = atol(Temp_Value2);
          HardwareTest_Data_Len++;
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          if( Temp_Value1[j] == 125)
            break;
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
  }
}
/*
    检测返回报文是否与预期一致
    当Ex_Len为-1时，期望不响应
    ID：响应ID
*/
_Check_ResTP(dword ID,byte Ex[],int Ex_Len)
{
  int Re;
  int i,Flage;
  message * Msg;
  Flage = 0;
  Re = testWaitForMessage(ID,1000);
  if(Ex_Len != -1)
  {
    if(Re > 0)
    {
      testGetWaitEventMsgData(Msg);
      for(i=0;i<Ex_Len;i++)
      {
        if(Msg.byte(i) != Ex[i])
        {
          testStepFail("","Byte_%d反馈与预期不一致,反馈值为0x%02X,预期值为0x%02X",i,Msg.byte(i),Ex[i]);
          Flage = 1;
        }
      }
      if(Flage == 0)
        testStepPass("","反馈与预期一致");
    }
    else
      testStepFail("","期望收到响应，实际无应答");
  }
  else
  {
    if(Re != 0)
      testStepFail("","期望无响应，实际收到应答");
    else if(Re == 0)
      testStepPass("","期望无响应，实际未收到应答与预期一致");
  }
}
