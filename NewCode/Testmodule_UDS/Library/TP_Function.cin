_CANFD_TP_FF_1() /*首帧请求报文FF_DL错误测试*/
{
  byte Data[8] = {0x10,0x00,0xf1,0x80,0x00,0x00,0x00,0x00};
  byte Filler[9] = {0x0A,0x0B,0x0F,0x13,0x17,0x1F,0x2F,0x2F,0x3E};
  byte Len[9] = {8,12,16,20,24,32,48,64,64};
  
  int i;
  _Get_DID_TP(Data,3);
  _TPsendmsg_Phy(Data,8,1);
  _TPgetSF(0);
  testWaitForTimeout(1000);
  
  for(i=0;i<elcount(Filler);i++)
  {
    Data[1] = Filler[i];
    _TPsendmsg_Phy(Data,Len[i],1);
    
    if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD") && Len[i] == 8 )
    {
      _TPgetFC(1);
    }
    else
      _Check_NoResponse_(500);
    testWaitForTimeout(1000);
  }
  
