_CAN_TP_SF_2()  /*单帧请求CAN帧报文的DLC错误测试(不应答 DLC=1-7)*/
{
  int i;
  byte Data[8];
  _Init_Struct();
  _Get_DTC_19();
  for(i=1;i<8;i++)
  {
    switch (i)
    {
      case 1:Data[0] = i   ; break;
      case 2:Data[0] = i   ; Data[1] = 0x10;break;
      case 3:Data[0] = i-1 ; Data[1] = 0x10;Data[2] = 0x01;break;
      case 4:Data[0] = i-1 ; Data[1] = 0x19;Data[2] = 0x02;Data[3] = 0x01;break;
      case 5:Data[0] = i-1 ; Data[1] = 0x14;Data[2] = 0xFF;Data[3] = 0xFF;Data[4] = 0xFF;break;
      case 6:Data[0] = i-1 ; Data[1] = 0x31;Data[2] = 0x01;Data[3] = Serve_31_Hex[0].Routine[0];Data[4] = Serve_31_Hex[0].Routine[1];Data[5] = 0x01;break;
      case 7:Data[0] = i-1 ; Data[1] = 0x19;Data[2] = 0x04;Data[3] = (DTC_19[0][1]>>16)&0xFF;Data[4] = (DTC_19[0][1]>>8)&0xFF;Data[5] = (DTC_19[0][1])&0xFF;Data[6] = 0xFF;break;
      default: break;
    }
    _TPsendmsg_Phy(Data,i,0);
    _Check_ResponseRx_(0,100);
    testWaitForTimeout(500);
  }
}

_CAN_TP_SF_3()  /*单帧请求CAN帧报文的DLC错误测试_(应答 DLC = 1或2)*/
{
  byte Data[2];
  int i,Flage;
  _Init_Struct();
  Flage = _Check_Serve(0x14,0,0);//支持14服务则为APP
  for(i=0;i<7;i++)
  {
    Data[0] = i;
    _TPsendmsg_Phy(Data,1,0);
    _Check_ResponseRx_(0,100);
  }
  testWaitForTimeout(2000);
  Data[0] = 1;
  for(i=0;i<=0xFF;i++)
  {
    Data[1] = i;
    _TPsendmsg_Phy(Data,2,0);
    if(i==0x37 && Flage != -1) //APP与BT不同，BT下37服务仅一个长度可能出现响应现象
       _Check_ResponseRx_(1,100);
    else
       _Check_ResponseRx_(0,100);
  }
  testWaitForTimeout(2000);
}

