_85_Serve_8(dword ID,byte Session)/* NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[100];
  
  Serve_Pos = _Check_Serve(0x85,0,0);
  
  if(_Check_Serve_IDAndSess(0x85,ID,Session) == 1)
  {
    Send_Data[0] = 0x85;
    _Set_NRC_Step(0x85,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
}
_85_Serve_9_CarSpd(dword ID,byte Session)/*  NRC22车速*/
{
  byte Tem_0[2] = {0x85,0x01};
  byte Tem_1[2] = {0x85,0x02};
  int Serve_Pos,NRC22_Flage;
  
  Serve_Pos = _Check_Serve(0x85,0,0);
  if(_Check_Serve_IDAndSess(0x85,ID,Session) == 1)
  {
    NRC22_Flage = _Set_NRC22(0x85,Serve_Data[Serve_Pos].Serve_Fun[0],2);
    if(NRC22_Flage == -1)
      _WriteEx_and_Report("","无NRC22条件");
    else if((NRC22_Flage &0x01) != 0)
    {
      _Set_CarSpd(NRC22_CarSpd+1);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",CarSpd_NRC);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",CarSpd_NRC);
      
      if(_Check_Serve(0x85,0x01,9)==1)
      {
        Tem_0[1]=0X81;
        _Send_Diag(2,ID,Tem_0);
        _TestResult(SendData,ID,"",CarSpd_NRC);
        Tem_0[1]=0X01;
      }  
      if(_Check_Serve(0x85,0x02,9)==1)
      {
        Tem_0[1]=0X82;
        _Send_Diag(2,ID,Tem_0);
        _TestResult(SendData,ID,"",CarSpd_NRC);
        Tem_0[1]=0X02;
      }
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",-1);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
      testWaitForTimeout(Struct_CarSpd.Invalid_Time*1.5);
      if(Geely3_Flage == 1)
      {
        _Send_Diag(2,ID,Tem_0);
        _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
        _Send_Diag(2,ID,Tem_1);
        _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
      }
      else
      {
        _Send_Diag(2,ID,Tem_0);
        _TestResult(SendData,ID,"",-1);
        _Send_Diag(2,ID,Tem_1);
        _TestResult(SendData,ID,"",-1);
      }
      _Reset_CarSpd_Invalid();
      _Set_CarSpd(0);
    }
    else
      _WriteEx_and_Report("","无NRC22车速条件");
  }
}
_85_Serve_9_Ready(dword ID,byte Session)/*  NRC22-发动机*/
{
  byte Tem_0[2] = {0x85,0x01};
  int Serve_Pos,NRC22_Flage;
  
  Serve_Pos = _Check_Serve(0x85,0,0);
  if(_Check_Serve_IDAndSess(0x85,ID,Session) == 1)
  {
    NRC22_Flage = _Set_NRC22(0x85,Serve_Data[Serve_Pos].Serve_Fun[0],2);
    if(NRC22_Flage == -1)
      _WriteEx_and_Report("","无NRC22条件");
    else if((NRC22_Flage &0x20) != 0)
    {
      Tem_0[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
      _Set_Ready(Ready_NRC22);
      testWaitForTimeout(1000);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",Ready_NRC);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",-1);
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Set_Ready(0);
      testWaitForTimeout(1000);
    }
    else
      _WriteEx_and_Report("","无NRC22发动机条件");
  }
}


_85_Serve_10(dword ID,byte Session)/*  NRC22-吉利3.0*/
{
  byte Tem_0[2] = {0x85,0x01};
  byte Tem_1[2] = {0x85,0x02};
  char Serve_85_CarSpdQFTemp[10];
  byte Serve_85_CarSpdQF[10];
  int Serve_85_CarSpdQF_Count;
  int i,j;
  Serve_85_CarSpdQF_Count = getProfileArray(ECU_project,"Serve_85_CarSpdQF",Serve_85_CarSpdQFTemp,elCount(Serve_85_CarSpdQFTemp),file_name_1);
  for(i=0;i<Serve_85_CarSpdQF_Count;i++)
    Serve_85_CarSpdQF[i] = Serve_85_CarSpdQFTemp[i];
  diagStartTesterPresent(Cdd_Name);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  
  for(j=0;j<7;j++)
  {
    diagStartTesterPresent(Cdd_Name);
    if(j==1)
      _Set_CarSpd(NRC22_CarSpd+1);
    else 
      _Set_CarSpd(NRC22_CarSpd-1);
    
    _Set_Ready(0xB);
    _Set_CarSpd_Invalid(3);
    if(j==0 || j==1)  /*此用例测试VehSpdLgtQf=2或3能支持85服务，需要遍历VehSpdLgtQf值*/
    {
      _WriteEx_and_Report("","测试支持85服务的VehSpdLgtQf，需要遍历VehSpdLgtQf值");
      for(i=0;i<4;i++)
      {
        _Set_CarSpd_Invalid(i);
        testWaitForTimeout(1000);
        if((_Check_Dword_in_Num(i,Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)!= -1) && j == 0)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",-1);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",-1);
        }
        else
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
        }
      }
      if(j==1)
      {
        _Set_CarSpd_Invalid(0);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
        _Send_Diag(2,ID,Tem_0);
        _TestResult(SendData,ID,"",-1);
        _Send_Diag(2,ID,Tem_1);
        _TestResult(SendData,ID,"",-1);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        _WriteEx_and_Report("","步骤5-9测试结束");
      }
      else
        _WriteEx_and_Report("","步骤1-4测试结束");
    }
    else if(j==2)  /*此用例测试Usgmode≠0xD(driving)能支持85服务，需要遍历Usgmode值以及丢失*/
    {
      _WriteEx_and_Report("","此用例测试Usgmode≠0xD(driving)能支持85服务，需要遍历Usgmode值以及丢失");
      for(i=0;i<5;i++)
      {
        byte Temp[5]={0,1,2,0xB,0xD};
        _Set_Ready(Temp[i]);
        testWaitForTimeout(1000);
        _Send_Diag(2,ID,Tem_0);
        if(Temp[i]==0xD)
          _TestResult(SendData,ID,"",Ready_NRC);
        else
          _TestResult(SendData,ID,"",-1);
        _Send_Diag(2,ID,Tem_1);
        if(Temp[i]==0xD)
          _TestResult(SendData,ID,"",Ready_NRC);
        else
          _TestResult(SendData,ID,"",-1);
      }
      _Set_Ready(0xD);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(3000);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",-1);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      _WriteEx_and_Report("","步骤10-15测试结束");
    }
    else if(j==3)/*测试电压条件*/
    { 
      float Temp[4]={1,2,3,4};
      _WriteEx_and_Report("","测试电压条件");
      Temp[0]=NRC22_Battery_Low+0.2;
      Temp[1]=NRC22_Battery_Hight-0.2;
      Temp[2]=NRC22_Battery_Low-0.2;
      Temp[3]=NRC22_Battery_Hight+0.2;
      for(i=0;i<4;i++)
      {
        _Set_Battery(Temp[i]);
        if(i<2)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",-1);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",-1);
        }
        else if(i==2)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",L_Battery_NRC);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",L_Battery_NRC);
        }
        else if(i==3)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",H_Battery_NRC);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",H_Battery_NRC);
        }
      }
      _Set_Battery(12);
      _WriteEx_and_Report("","步骤16-19测试结束");
    }
    else if(j==4)/*Usgmode(0x2E0:VehModMngtGlbSafe1)=0xD，车速<3km/h，VehSpdLgtQf=3，电压为13.5V时丢失0xE0节点发送报文：*/
    {
      _WriteEx_and_Report("","Usgmode(0x2E0:VehModMngtGlbSafe1)=0xD，车速<3km/h，VehSpdLgtQf=3，电压为13.5V时丢失0xE0节点发送报文");
      _Set_Ready(0xD);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(5000);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",Ready_NRC);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",Ready_NRC);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _Set_Ready(0xB);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(5000);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",-1);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _WriteEx_and_Report("","步骤20-21测试结束");
    }
    else if(j==5)/*步骤22&23、VehSpdLgtQf不满足；步骤24、车速不满足；步骤25&26、VehSpdLgtQf满足取值遍历*/
    {
      int Qf[4] = {1,0,2,3};
      _Set_Ready(0xD);
      _WriteEx_and_Report("","步骤22&23：VehSpdLgtQf不满足。步骤24：车速不满足。步骤25&26：VehSpdLgtQf满足取值遍历");
      _WriteEx_and_Report("","步骤22，步骤23，步骤25，步骤26");
      for(i=0;i<4;i++)
      {
        _Set_CarSpd_Invalid(Qf[i]);
        testWaitForTimeout(500);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(2000);
        if(_Check_Dword_in_Num(Qf[i],Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)!= -1)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",-1);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",-1);
        }
        else
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
        }
        _TestEnableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(2000);
      }
      _WriteEx_and_Report("","步骤24，放于循环外测试");
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_CarSpd_Invalid(2);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",CarSpd_NRC);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",CarSpd_NRC);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("","步骤22-26测试结束");
    }
    else if(j==6)/*在Usgmode不满足且Usgmode和车速均丢失的前提下设计以下电压临界值步骤情况*/
    {
      float Temp[4]={1,2,3,4};
      _WriteEx_and_Report("","在Usgmode不满足且Usgmode和车速均丢失的前提下设计以下电压临界值步骤情况");
      Temp[0]=NRC22_Battery_Low+0.2;
      Temp[1]=NRC22_Battery_Hight-0.2;
      Temp[2]=NRC22_Battery_Low-0.2;
      Temp[3]=NRC22_Battery_Hight+0.2;
      _Set_Ready(0xD);
      _Set_CarSpd_Invalid(3);
      _Set_CarSpd(NRC22_CarSpd-1);
      testWaitForTimeout(1000);
      for(i=0;i<4;i++)
      {
        _Set_Battery(Temp[i]);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(2000);
        if(i<2)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",-1);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",-1);
        }
        else if(i==2)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",L_Battery_NRC);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",L_Battery_NRC);
        }
        else if(i==3)
        {
          _Send_Diag(2,ID,Tem_0);
          _TestResult(SendData,ID,"",H_Battery_NRC);
          _Send_Diag(2,ID,Tem_1);
          _TestResult(SendData,ID,"",H_Battery_NRC);
        }
        _TestEnableMsg(Struct_Ready.Sig_Id);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(1000);
      }
      _Set_Battery(12);
      _WriteEx_and_Report("","步骤27-30测试结束");
    }
  }
  _Set_CarSpd(0);
  _Reset_CarSpd_Invalid();
}
_85_Serve_11(dword ID,byte Session)/*  NRC13*/
{
  byte Tem[2] = {0x85,0x01};
  int i,len;
  len = _Check_CANFD_Flage();
  StepByGeely3_0(0x85,Close);
  if(_Check_Serve_IDAndSess(0x85,ID,Session) == 1)
  {
    for(i=1;i<=len;i++)
    {
      if(i==2)
        continue;
      _Send_Diag(i,ID,Tem);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
}
_85_Serve_12(dword ID,byte Session)/*  NRC12*/
{
  byte Tem[2] = {0x85,0x01};
  int Serve_Pos,i;
  byte Send_Data[100];
  
  Serve_Pos = _Check_Serve(0x85,0,0);
  StepByGeely3_0(0x85,Close);
  if(_Check_Serve_IDAndSess(0x85,ID,Session) == 1)
  {
    for(i=0;i<=0xFF;i++)
    {
      if((_Check_Serve(0x85,i,4)!=-1) || ((_Check_Serve(0x85,(i&0x0F),4)!=-1) && ((i>>4)==0x08) && (_Check_Serve(0x85,i&0x0F,9) == 1)))
        continue;
      Tem[1]=i;
      _Send_Diag(2,ID,Tem);
      _TestResult(SendData,ID,"",NRC12);
      testWaitForTimeout(50);
    }
  }
}
_85_Serve_13(dword ID,byte Session)/*  85服务禁止前的当前故障在85禁止后14清除读取不到*/
{
  byte Send85_1[2] = {0x85,0x01};
  byte Send85_2[2] = {0x85,0x02};
  int i;
  for(i=0;i<5;i++)
  {
    if(i != 0)
    {
      _SetSession(Session);
      testWaitForTimeout(300);
    }
    StepByGeely3_0(0x85,Active);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _Check_DTC_Res(1,Struct_CarSpd.Lost_DTC,0);
    StepByGeely3_0(0x85,Close);
    _Send_Diag(2,ID,Send85_2);
    _TestResult(SendData,ID,"",-1);
    _Check_DTC_Res(1,Struct_CarSpd.Lost_DTC,0);
    StepByGeely3_0(0x85,Active);
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _Check_DTC_Res(1,0,Struct_CarSpd.Lost_DTC);
    if(i == 0)
    {
      _WriteEx_and_Report("","/*--------------11复位------------*/");
      _Set_11_Restoration();
      testWaitForTimeout(CAN_Init_Time + Struct_CarSpd.Lost_Time*1.5);
    }
    else if(i == 1)
    {
      _WriteEx_and_Report("","/*--------------正常上下电------------*/");
      _Set_Ready(0);
      testWaitForTimeout(200);
      _Power_Down();
      testWaitForTimeout(2000);
      _Power_Up();
      StepByGeely3_0(0x85,Active);
      testWaitForTimeout( Struct_CarSpd.Lost_Time*1.5);
    }
    else if(i == 2)
    {
      _WriteEx_and_Report("","/*--------------异常断电------------*/");
      _K30_OFF();
      testWaitForTimeout(2000);
      _K30_ON();
      testWaitForTimeout(CAN_Init_Time);
      StepByGeely3_0(0x85,Active);
      if(Geely3_Flage == 1 && CAN_Init_Time<5000)
        testWaitForTimeout(5000);
      testWaitForTimeout( Struct_CarSpd.Lost_Time*1.5);
    }
    else if(i == 3)
    {
      _WriteEx_and_Report("","/*--------------S3Time超时------------*/");
      testWaitForTimeout(6000);
      testWaitForTimeout( Struct_CarSpd.Lost_Time*1.5);
    }
    else if(i == 4)
    {
      _WriteEx_and_Report("","/*--------------会话切换------------*/");
      _SetSession(exsession);
      testWaitForTimeout(200);
      testWaitForTimeout( Struct_CarSpd.Lost_Time*1.5);
      _Check_DTC_Res(1,0,Struct_CarSpd.Lost_DTC);
      _SetSession(defsession);
      testWaitForTimeout(200);
      testWaitForTimeout( Struct_CarSpd.Lost_Time*1.5);
    }
    _Check_DTC_Res(1,Struct_CarSpd.Lost_DTC,0);
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout( Struct_CarSpd.Lost_Time*1.1);
    _WriteEx_and_Report("","/*---------------------------*/");
  }
}

_85_Serve_14(dword ID,byte Session)/*  K30 OFF->ON异常断电后功能实现正常*/
{
  byte Send85_2[2];
  int i,Res;
  Send85_2[0] = 0x85;
  for(i=0;i<2;i++)
  {
    if(i == 0)
    {
      Send85_2[1] = 0x02;
      Res = -1;
    }
    else
    {
      Send85_2[1] = 0x82;
      Res = 0;
    }
    StepByGeely3_0(0x85,Active);
    _Clear_DTC(phyreq_ID);
    _Check_DTC_Res(9,0,Struct_CarSpd.Lost_DTC);
    StepByGeely3_0(0x85,Close);
    _Send_Diag(2,ID,Send85_2);
    _TestResult(SendData,ID,"",Res);
    StepByGeely3_0(0x85,Active);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _Check_DTC_Res(9,0,Struct_CarSpd.Lost_DTC);
    _K30_OFF();
    testWaitForTimeout(2000);
    _K30_ON();
    testWaitForTimeout(CAN_Init_Time);
    if(Geely3_Flage == 1 && CAN_Init_Time<5000)
      testWaitForTimeout(6000-CAN_Init_Time);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _Check_DTC_Res(1,Struct_CarSpd.Lost_DTC,0);
    _SetSession(Session);
    StepByGeely3_0(0x85,Close);
    _Send_Diag(2,ID,Send85_2);
    _TestResult(SendData,ID,"",Res);
    testWaitForTimeout(100);
    _Clear_DTC(phyreq_ID);
    StepByGeely3_0(0x85,Active);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _Check_DTC_Res(9,0,Struct_CarSpd.Lost_DTC);
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _SetSession(defsession);
    testWaitForTimeout(500);
    _SetSession(Session);
    testWaitForTimeout(500);
  }
}

_85_Serve_15(dword ID,byte Session)/*85服务禁止和启用时的故障码检测*/
{
  byte Send85_2[2];
  int Res;
  Send85_2[0] = 0x85; Send85_2[1] = 0x02;
  Res = -1;

  StepByGeely3_0(0x85,Active);
  _Clear_DTC(phyreq_ID);
  _TestDisableMsg(Struct_CarSpd.Sig_Id);
  testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
  _Check_DTC_InNow_NotInNowAndHis(0x09,Struct_CarSpd.Lost_DTC,0);
  _SetSession(Session);
  testWaitForTimeout(200);
  StepByGeely3_0(0x85,Close);
  _Send_Diag(2,ID,Send85_2);
  _TestResult(SendData,ID,"",Res);
  StepByGeely3_0(0x85,Active);
  _Check_DTC_InNow_NotInNowAndHis(0x09,Struct_CarSpd.Lost_DTC,0);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
  _Check_DTC_InNow_NotInNowAndHis(0x09,0,Struct_CarSpd.Lost_DTC);
  _WriteEx_and_Report("","步骤1-2测试完成");

  Send85_2[1] = 0x01;
  StepByGeely3_0(0x85,Close);
  _Send_Diag(2,ID,Send85_2);
  _TestResult(SendData,ID,"",Res);
  if(Geely3_Flage == 1)
  {
    diagStartTesterPresent(Cdd_Name);
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(5000);
  }
  testWaitForTimeout((word)Struct_CarSpd.Lost_Time*0.2);
  _Check_DTC_InNow_NotInNowAndHis(0x09,0,Struct_CarSpd.Lost_DTC);
  testWaitForTimeout(Struct_CarSpd.Lost_Time*1.2);
  _Check_DTC_InNow_NotInNowAndHis(0x09,Struct_CarSpd.Lost_DTC,0);
  _WriteEx_and_Report("","步骤3-4测试完成");
  _SetSession(defsession);
  testWaitForTimeout(500);
}


_Abnormal_NRC_1() /*10h-NRC13*/
{
  int i,len;
  byte data[2]={0x10,0x01};
