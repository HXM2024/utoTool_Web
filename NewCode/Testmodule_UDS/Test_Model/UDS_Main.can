void General_31_AngCal()
{
  byte AngCal[10],AngCal_Check[10];
  int i,RID_Pos,Send_Len,Check_Flage,Ready_Flage;
  dword RID;
  float AngNow;
  char Common[50];
  _get_Arry("Angle_Calibration");
  _Get_AngleSig();
  if(Arry_Len>1)
  {
    Check_Flage = 0;Ready_Flage = 0;
    RID = (Arry_Data[2]<<8)|Arry_Data[3];
    Send_Len = Arry_Len;
    for(i=0;i<Arry_Len;i++)
    {
      AngCal[i] = Arry_Data[i];
      AngCal_Check[i] = Arry_Data[i];
    }
    RID_Pos = _Check_Serve(AngCal[1],RID,12);
    if(Serve_31_Hex[RID_Pos].Control_Type_Count >=2)
    {
      Check_Flage = 1;
      AngCal_Check[1] = Serve_31_Hex[RID_Pos].Control_Type[1];
    }
    if((Serve_31_Hex[RID_Pos].Serve_NRC22[0]&0x20) == 1)
      Ready_Flage = 1;
  }
  else
  {
    _WriteEx_and_Report("","Angle_Calibration数组为空");
    return;
  }
  for(i=0;i<3;i++)
  {
    if(getSignal(Struct_Ready.Ready_Sig) == 0)
      _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(1000);
    if(i == 0)
      _TestWaitForTesterConfirmation("向左侧转动方向盘，使其角度不为0");
    else
      _TestWaitForTesterConfirmation("向右侧转动方向盘，使其角度不为0");
    _unlockECU();
    if(Ready_Flage == 1)
      _Set_Ready(0);
    _Send_Diag(Send_Len,phyreq_ID,AngCal);
    _Check_31Routine_Rx(AngCal,1);
    if(Check_Flage == 1)
    {
      testWaitForTimeout(200);
      _Send_Diag(Send_Len,phyreq_ID,AngCal_Check);
      _Check_31Routine_Rx(AngCal_Check,1);
    }
    AngNow = getSignal(Tx_AngleSig);
    if(AngNow>1 || AngNow<-1)
      testStepfail("","对中完毕后角度误差过大，期望为0 ± 1°,实际为 %.1f°",AngNow);
    else
      testSteppass("","对中完毕后角度误差在0 ± 1°范围内");
    if(i==0)
    {
      snprintf(Common,elCount(Common),"正常上下电");
      _Set_Ready(0);
      testWaitForTimeout(1000);
      _K15_OFF();
      testWaitForTimeout(3000);
      _K15_ON();
      testWaitForTimeout(2000);
      _Set_Ready(Struct_Ready.Ready_Active);
    }
    else if(i ==1)
    {
      snprintf(Common,elCount(Common),"11复位");
      _Set_11_Restoration(0);
    }
    else if(i ==2)
    {
      snprintf(Common,elCount(Common),"异常断电");
      _K30_OFF();
      testWaitForTimeout(3000);
      _K30_ON();
      testWaitForTimeout(2000);
    }
    AngNow = getSignal(Tx_AngleSig);
    if(AngNow>1 || AngNow<-1)
      testStepfail("","%s后，角度误差过大，期望为0 ± 1°,实际为 %.1f°",Common,AngNow);
    else
      testSteppass("","%s后，角度误差在0 ± 1°范围内",Common);
  }
  _Set_Ready(Struct_Ready.Ready_Active);
  _Set_CarSpd(10);
  testWaitForTimeout(1000);
  _TestWaitForTesterConfirmation("左右打方向盘，验证回正功能是否正常");
  _Set_CarSpd(0);
}

void General_31_AngCal_Clear()
{
  byte AngCal_Clear[10],AngCal_Check[10],Ang_Cal[10];
  int i,RID_Pos,Send_Len,Check_Flage,Ready_Flage,Send_Len_Cail;
  dword RID;
  float AngNow;
  char Common[50];

  diagStartTesterPresent(Cdd_Name);
  _get_Arry("Angle_Calibration");
  {
    Send_Len_Cail = Arry_Len;
    for(i=0;i<Arry_Len;i++)
      Ang_Cal[i] = Arry_Data[i];
  }
  _get_Arry("Clear_Angle_Calibration");
  _Get_AngleSig();
  if(Arry_Len>1)
  {
    Check_Flage = 0;Ready_Flage = 0;
    RID = (Arry_Data[2]<<8)|Arry_Data[3];
    Send_Len = Arry_Len;
    for(i=0;i<Arry_Len;i++)
    {
      AngCal_Clear[i] = Arry_Data[i];
      AngCal_Check[i] = Arry_Data[i];
    }
    RID_Pos = _Check_Serve(AngCal_Clear[1],RID,12);
    if(Serve_31_Hex[RID_Pos].Control_Type_Count >=2)
    {
      Check_Flage = 1;
      AngCal_Check[1] = Serve_31_Hex[RID_Pos].Control_Type[1];
    }
    if((Serve_31_Hex[RID_Pos].Serve_NRC22[0]&0x20) == 1)
      Ready_Flage = 1;
  }
  else
  {
    _WriteEx_and_Report("","Clear_Angle_Calibration数组为空");
    return;
  }
  for(i=0;i<3;i++)
  {
    _unlockECU();
    _Send_Diag(Send_Len_Cail,phyreq_ID,Ang_Cal);
    _Check_31Routine_Rx(Ang_Cal,1);
    testWaitForTimeout(200);
    _Check_DTC_Res(1,0,Ang_NotCal);
    if(getSignal(Struct_Ready.Ready_Sig) == 0)
      _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(1000);
    if(i == 0)
      _TestWaitForTesterConfirmation("向左侧转动方向盘，使其角度不为0");
    else
      _TestWaitForTesterConfirmation("向右侧转动方向盘，使其角度不为0");
    if(Ready_Flage == 1)
      _Set_Ready(0);
    _Send_Diag(Send_Len,phyreq_ID,AngCal_Clear);
    _Check_31Routine_Rx(AngCal_Clear,1);
    if(Check_Flage == 1)
    {
      testWaitForTimeout(200);
      _Send_Diag(Send_Len,phyreq_ID,AngCal_Check);
      _Check_31Routine_Rx(AngCal_Check,1);
    }
    testWaitForTimeout(200);
    _Check_DTC_Res(1,Ang_NotCal,0);
    AngNow = getSignal(Tx_AngleSig);
    if(AngNow != 0 && (AngNow < 740 || AngNow > -740))
      testStepfail("","清除对中后期望角度保持为0或无效值,实际为 %.1f°",AngNow);
    else
      testSteppass("","清除对中后角度为0或者无效值,当前为 %.1f°",AngNow);
    if(i==0)
    {
      snprintf(Common,elCount(Common),"正常上下电");
      _Set_Ready(0);
      testWaitForTimeout(1000);
      _K15_OFF();
      testWaitForTimeout(3000);
      _K15_ON();
      testWaitForTimeout(2000);
      _Set_Ready(Struct_Ready.Ready_Active);
    }
    else if(i ==1)
    {
      snprintf(Common,elCount(Common),"11复位");
      _Set_11_Restoration(0);
    }
    else if(i ==2)
    {
      snprintf(Common,elCount(Common),"异常断电");
      _K30_OFF();
      testWaitForTimeout(3000);
      _K30_ON();
      testWaitForTimeout(2000);
    }
    AngNow = getSignal(Tx_AngleSig);
    if(AngNow != 0 && (AngNow < 740 || AngNow > -740))
      testStepfail("","%s后，清除对中后期望角度保持为0或无效值,实际为 %.1f°",Common,AngNow);
    else
      testSteppass("","%s后，清除对中后角度保持为0或无效值",Common);
  }
  _Set_Ready(Struct_Ready.Ready_Active);
  _Set_CarSpd(10);
  testWaitForTimeout(1000);
  _TestWaitForTesterConfirmation("左右打方向盘，验证是否无回正功能");
  _Set_CarSpd(0);
  _unlockECU();
  _Send_Diag(Send_Len_Cail,phyreq_ID,Ang_Cal);
  _Check_31Routine_Rx(Ang_Cal,1);
  testWaitForTimeout(200);
  _SetSession(defsession);
}


void Geely_31_0206()
{
  byte SendData[6] = {0x31,0x01,0x02,0x06,0,0};
  int Send_Len,i;
  dword FunDID;
  int FunPos;
  dword Send_ID;
  
  Send_Len = 4;
  FunDID = 0x0206;
  _get_Arry("Pre_Programmed");
  if(Arry_Len>1)
  {
    FunDID = (Arry_Data[2]<<8)|Arry_Data[3];
    Send_Len = Arry_Len;
    for(i=0;i<Arry_Len;i++)
      SendData[i] = Arry_Data[i];
  }
  FunPos = _Check_Serve(0x01,FunDID,12);
  if(FunPos != -1)
  {
    _Set_Ready(0);
    _unlockECU();
    for(i=0;i<2;i++)
    {
      if(i == 0)
        Send_ID = phyreq_ID;
      else
        Send_ID = funreq_ID;
      _Set_CarSpd(NRC22_CarSpd-1);
      testWaitForTimeout(1000);
      _Send_Diag(Send_Len,Send_ID,SendData);
      _Check_31Routine_Rx(SendData,1);
      _Set_CarSpd(NRC22_CarSpd+1);
      testWaitForTimeout(1000);
      _Send_Diag(Send_Len,Send_ID,SendData);
      if((Serve_31_Hex[FunPos].Serve_NRC22[0]&1) == 1)
        _Check_31Routine_Rx(SendData,0);
      else
        _Check_31Routine_Rx(SendData,1);
      _Set_CarSpd(NRC22_CarSpd-1);
      testWaitForTimeout(500);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
      _Send_Diag(Send_Len,Send_ID,SendData);
      _Check_31Routine_Rx(SendData,1);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(2000);
    }
  }
}
