_31_Serve_30(dword ID,byte Session)/*NRC12*/
{
  dword i,j,n,Flage_;
  byte Len;
  byte Send_Data[100];
  int Flag;
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历31服务NRC12数据时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  for(j=0;j<Serve_31_Hex_Count;j++)
  {
    writeEx(-3,0,"/*-----------0x%02X 0x%02X-----------*/",Serve_31_Hex[j].Routine[0],Serve_31_Hex[j].Routine[1]);
    testStep("","/*-----------0x%02X 0x%02X-----------*/",Serve_31_Hex[j].Routine[0],Serve_31_Hex[j].Routine[1]);
    if(_Check_Serve_IDAndSess(0x31,j,ID,Session)!=1)
    {
      writeEx(-3,0,"当前测试项次不支持当前寻址或会话");
      continue;
    }
    if(Session != defsession)
      _SetSession(defsession);
    _SetSession(Session);
    testWaitForTimeout(200);
    if(LoopServe_Search_SecurityAccess(0x31,j) == 1)
      _unlockECU();
    testWaitForTimeout(500);
    Send_Data[0] = 0x31;
    Send_Data[2] = Serve_31_Hex[j].Routine[0];
    Send_Data[3] = Serve_31_Hex[j].Routine[1];
    if(Serve_31_Hex[j].Routine_Len == 5)
      Send_Data[4] = Serve_31_Hex[j].Control_Option[0][0];
    Len = Serve_31_Hex[j].Routine_Len;
    for(i=0;i<=0xFF;i++)
    {
      Send_Data[1] =i;
      Flage_ = 0;
      for(n=0;n<Serve_31_Hex[j].Control_Type_Count;n++)
      {
        if((i == Serve_31_Hex[j].Control_Type[n]) || ((i&0xF0)==0X80 && (i&0x0F)==Serve_31_Hex[j].Control_Type[n] && Serve_31_Hex[j].Control_Type_RSP[n] == 1))
        {
          Flage_ = 1;
          break;
        }
      }
      if(Flage_ == 1)
        continue;
      _Send_Diag(Len,ID,Send_Data);
      Flag = _TestResult(SendData,ID,"",NRC12);
      if(Flag == -1)
      {
        char Str[50];
        if(Serve_31_Hex[j].Routine_Len == 5)
        {
          snprintf(Str,elCount(Str),"[  0x%02X 0x%02X 0x%02X 0x%02X 0x%02X  ] \n",Send_Data[0],Send_Data[1],Send_Data[2],Send_Data[3],Send_Data[4]);
          File_Write(Error_File,Error_FileName,Str,2);
        }
        else
        {
          snprintf(Str,elCount(Str),"[  0x%02X 0x%02X 0x%02X 0x%02X  ] \n",Send_Data[0],Send_Data[1],Send_Data[2],Send_Data[3]);
          File_Write(Error_File,Error_FileName,Str,2);
        }
      }
      testWaitForTimeout(20);
    }
  }
}
_31_Serve_31(dword ID,byte Session)/*NRC13*/
{
  dword i,j;
  byte Len;
  byte Send_Data[100];
  int Flag;
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历31服务NRC13数据时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  Len = _Check_CANFD_Flage();
  for(j=0;j<Serve_31_Hex_Count;j++)
  {
    writeEx(-3,0,"/*-----------0x%02X 0x%02X-----------*/",Serve_31_Hex[j].Routine[0],Serve_31_Hex[j].Routine[1]);
    testStep("","/*-----------0x%02X 0x%02X-----------*/",Serve_31_Hex[j].Routine[0],Serve_31_Hex[j].Routine[1]);
    if(_Check_Serve_IDAndSess(0x31,j,ID,Session)!=1)
    {
      writeEx(-3,0,"当前测试项次不支持当前寻址或会话");
      continue;
    }
    if(Session != defsession)
      _SetSession(defsession);
    _SetSession(Session);
    testWaitForTimeout(200);
    if(LoopServe_Search_SecurityAccess(0x31,j) == 1)
      _unlockECU();
    testWaitForTimeout(500);
    Send_Data[0] = 0x31;
    Send_Data[1] = Serve_31_Hex[j].Control_Type[0];
    Send_Data[2] = Serve_31_Hex[j].Routine[0];
    Send_Data[3] = Serve_31_Hex[j].Routine[1];
    if(Serve_31_Hex[j].Routine_Len == 5)
      Send_Data[4] = Serve_31_Hex[j].Control_Option_Count[0];
    for(i=1;i<=Len;i++)
    {
      if(i==Serve_31_Hex[j].Routine_Len)
        continue;
      _Send_Diag(i,ID,Send_Data);
      Flag = _TestResult(SendData,ID,"",NRC13);
      if(Flag == -1)
      {
        char Str[50];
        if(Serve_31_Hex[j].Routine_Len == 5)
        {
          snprintf(Str,elCount(Str),"[  0x%02X 0x%02X 0x%02X 0x%02X 0x%02X  ] \n",Send_Data[0],Send_Data[1],Send_Data[2],Send_Data[3],Send_Data[4]);
          File_Write(Error_File,Error_FileName,Str,2);
        }
        else
        {
          snprintf(Str,elCount(Str),"[  0x%02X 0x%02X 0x%02X 0x%02X  ] \n",Send_Data[0],Send_Data[1],Send_Data[2],Send_Data[3]);
          File_Write(Error_File,Error_FileName,Str,2);
        }
      }
      testWaitForTimeout(20);
    }
  }
}
_31_Serve_32(dword ID,byte Session)/*NRC31  RID*/
{
  byte Tem[4] = {0x31,0x01,0X00,0X00};
  word byte1;
  word byte2;
  int Flage;
  if(_Check_Serve_IDAndSess(0x31,ID,Session) != 1)
  {
    _WriteEx_and_Report("","当前寻址及服务不支持");
    return;
  }
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历31服务NRC31 RID数据时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  if(LoopServe_Search_SecurityAccess(0x31) == 1)
    _unlockECU();
  {
    for(byte1=0;byte1<=0XFF;byte1++)
    {
      Tem[2] =byte1;
      for(byte2=0;byte2<=0XFF;byte2++)
      {
        Tem[3] =byte2;
        if(_Check_SendData_In_31H(Tem)!=-1)
          continue;
        else
        {
          _Send_Diag(4,ID,Tem);
          Flage = _TestResult(SendData,ID,"",NRC31);
          if(Flage == -1)
          {
            char Str[30];
            snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
            File_Write(Error_File,Error_FileName,Str,2);
          }
          testWaitForTimeout(20);
        }
      }
    }
  }
}
_31_Serve_32_(dword ID,byte Session)/*NRC31 例程控制选项*/
{
  byte Temp_Send[5] = {0x31,0x01,0x00,0x00,0x00};
  word byte1;
  int i,j,Flage,Flage_;
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历31服务NRC31 例程控制选项数据时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    if(Serve_31_Hex[i].Routine_Len == 5)
    {
      Temp_Send[1] = Serve_31_Hex[i].Control_Type[0];
      Temp_Send[2] = Serve_31_Hex[i].Routine[0];
      Temp_Send[3] = Serve_31_Hex[i].Routine[1];    
      if(_Check_Serve_IDAndSess(0x31,i,ID,Session)!=1)
      {
        writeEx(-3,0,"当前测试项次不支持当前寻址或会话");
        continue;
      }
      if(i != 0)
      {
        _SetSession(defsession);
        if(Session != defsession)
          _SetSession(Session);
      }
      if(LoopServe_Search_SecurityAccess(0x31,i) == 1)
        _unlockECU();
      for(byte1=0;byte1<=0XFF;byte1++)
      {
        Temp_Send[4] =byte1;
        Flage = 0;
        for(j=0;j<Serve_31_Hex[i].Control_Option_Count[0];j++)
        {
          if(byte1 == Serve_31_Hex[i].Control_Option[0][j])
          {
            Flage = 1;
            break;
          }
        }
        if(Flage == 1)
          continue;
        else
        {
          _Send_Diag(5,ID,Temp_Send);
          Flage_ = _TestResult(SendData,ID,"",NRC31);
          if(Flage_ == -1)
          {
            char Str[50];
            snprintf(Str,elCount(Str),"[  0x31 0x%02X 0x%02X 0x%02X 0x%02X  ] \n",Temp_Send[1],Temp_Send[2],Temp_Send[3],Temp_Send[4]);
            File_Write(Error_File,Error_FileName,Str,2);
          }
        }
      }
    }
  }
  _WriteEx_and_Report("",Fault_Data_Report);
  write(Fault_Data_Write);
}

_31_Serve_33(dword ID,byte Session)/*NRC22*/
{
  dword RID;
  _get_Arry("Pre_Programmed");
  if(Arry_Len == 0)
    _WriteEx_and_Report("","未获取到相应数据,跳过");
  else
  {
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if(_Check_Serve(Arry_Data[1],RID,10)&0x1==1)
    {
      _unlockECU();
      _Set_CarSpd(NRC22_CarSpd+1);
      testWaitForTimeout(1000);
      Arry_Data[1] = 0X01;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _TestResult(SendData,ID,"",NRC22);
      Arry_Data[1] = 0X03;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _TestResult(SendData,ID,"",NRC24);
      _Set_CarSpd(NRC22_CarSpd);
      testWaitForTimeout(1000);
      Arry_Data[1] = 0X01;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
      Arry_Data[1] = 0X03;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
      _Set_CarSpd(NRC22_CarSpd+1);
      testWaitForTimeout(1000);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
      testWaitForTimeout(_max(Struct_CarSpd.Invalid_Time,Struct_CarSpd.Lost_Time)+500);
      Arry_Data[1] = 0X01;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
      Arry_Data[1] = 0X03;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      _Reset_CarSpd_Invalid();
      _Set_CarSpd(0);
    }
    else
      _WriteEx_and_Report("","当前项目无NRC22车速条件,跳过检测");
  }
}
_31_Serve_33_Ready(dword ID,byte Session)/*NRC22-发动机*/
{
  dword RID;
  byte Flage_;
  byte Send_Data[100];
  byte Send_Len;
  Flage_ = 0;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    Send_Data[0] = 0x31;
    if((Serve_31_Hex[i].Serve_NRC22[0] &0x20) > 0)
    {
      Flage_ = 1;
      _SetSession(defsession);
      testWaitForTimeout(100);
      _unlockECU();
      _Set_Ready(Struct_Ready.Ready_Active);
      testWaitForTimeout(1000);
      Send_Data[1] = Serve_31_Hex[i].Control_Type[0];
      Send_Data[2] = Serve_31_Hex[i].Routine[0];
      Send_Data[3] = Serve_31_Hex[i].Routine[1];
      Send_Len = Serve_31_Hex[i].Routine_Len;
      if(Send_Len>4)
        Send_Data[3] = Serve_31_Hex[i].Control_Option_Count[0];
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC22);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",-1);
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Set_Ready(0);
      testWaitForTimeout(1000);
    }
  }
  if(Flage_ == 0)
    _WriteEx_and_Report("","当前31服务中，无NRC22发动机条件");
}
_31_Serve_34(dword ID,byte Session)/*NRC33*/
{
  dword RID;
  int i,j,k,MaxCount,n;
  byte Send_Data[100];
  Send_Data[0] = 0x31;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    for(j=0;j<Serve_31_Hex[i].Control_Type_Count;j++)
    {
      Send_Data[1] = Serve_31_Hex[i].Control_Type[j];
      Send_Data[2] = Serve_31_Hex[i].Routine[0];
      Send_Data[3] = Serve_31_Hex[i].Routine[1];
      if(Serve_31_Hex[i].Control_Option_Count[j] == 0)
      {
        _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
        if( Serve_31_Hex[i].Security_Access[0] == 1)
          _TestResult(SendData,ID,"",NRC33);
        else
          _TestResult(SendData,ID,"",-1);
        if(Serve_31_Hex[i].Control_Type_RSP[j] == 1)
        {
          Send_Data[1] = Send_Data[1]|0x80;
          _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
          if( Serve_31_Hex[i].Security_Access[0] == 1)
            _TestResult(SendData,ID,"",NRC33);
          else
            _TestResult(SendData,ID,"",0);
        }
      }
      else
      {
        MaxCount = 1;
        if(Serve_31_Hex[i].Control_Type_RSP[j] == 1)
          MaxCount = 2;
        for(n=0;n<MaxCount;n++)
        {
          if(n == 0)
            Send_Data[1] = Serve_31_Hex[i].Control_Type[j];
          else
            Send_Data[1] = Serve_31_Hex[i].Control_Type[j]|0x80;
          for(k=0;k<Serve_31_Hex[i].Control_Option_Count[j];k++)
          {
            Send_Data[4] = Serve_31_Hex[i].Control_Option[j][k];
            _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
            if( Serve_31_Hex[i].Security_Access[0] == 1)
              _TestResult(SendData,ID,"",NRC33);
            else
            {
              if(n==0)
                _TestResult(SendData,ID,"",-1);
              else if(n == 1)
                _TestResult(SendData,ID,"",0);
            }
          }
        }
      }
    }
    _SetSession(defsession);
    testWaitForTimeout(500);
    if(Session != defsession)
    {
      _SetSession(Session);
      testWaitForTimeout(500);
    }
  }
}
_31_Serve_34_1(dword ID,byte Session)/*NRC33*/
{
  char str[100];
  dword RID;
  _unlockECU();
  _get_Arry("Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",-1);
  _SetSession(exsession);
  _get_Arry("Clear_Angle_Calibration");
  if(Arry_Len == 0)
    _WriteEx_and_Report("","未获取到相应数据,跳过");
  else
  {
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if(_Check_Serve(Arry_Data[1],RID,11)==1)
    {
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _TestResult(SendData,ID,"",NRC33);
      _Set_Ready(Struct_Ready.Ready_Active);
      _Set_CarSpd(10);
      testWaitForTimeout(1000);
      snprintf(str,elCount(str),"%s","");
      snprintf(str,elCount(str),"转动方向盘并查看回正状态，若有回正则点击YES,无回正则点击No,然后松开方向盘");
      if(testWaitForTesterConfirmation(str,60000)==1)
        testStepPass("","清除对中回NRC33情况下回正正常");
      else
        testStepFail("","清除对中回NRC33无回正");
      
      _Set_CarSpd(0);
      testWaitForTimeout(2000);
    }
    else
      _WriteEx_and_Report("","当前项目清除对中无NRC33条件,跳过检测");
  }
}
_31_Serve_34_2(dword ID,byte Session)/*NRC33*/
{
  char str[100];
  dword RID;
  _unlockECU();
  _get_Arry("Clear_Angle_Calibration");
  if(Arry_Len == 0)
  {
    _WriteEx_and_Report("","无清除中位DID,后续无法验证中位信息,跳过测试");
    return;
  }
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",-1);
  _SetSession(exsession);
  _get_Arry("Angle_Calibration");
  if(Arry_Len == 0)
    _WriteEx_and_Report("","未获取到相应数据,跳过");
  else
  {
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if(_Check_Serve(Arry_Data[1],RID,11)==1)
    {
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _TestResult(SendData,ID,"",NRC33);
      _Set_Ready(Struct_Ready.Ready_Active);
      _Set_CarSpd(10);
      testWaitForTimeout(1000);
      snprintf(str,elCount(str),"%s","");
      snprintf(str,elCount(str),"转动方向盘并查看回正状态，若有回正则点击YES,无回正则点击No,然后松开方向盘");
      if(testWaitForTesterConfirmation(str,60000)==2)
        testStepPass("","对中回NRC33情况下无回正");
      else
        testStepFail("","对中回NRC33存在回正");
      
      _Set_CarSpd(0);
      testWaitForTimeout(2000);
    }
    else
      _WriteEx_and_Report("","当前项目对中无NRC33条件,跳过检测");
  }
  _unlockECU();
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _TestResult(SendData,ID,"",-1);
}

_31_Serve_35(dword ID,byte Session)/*NRC22-工厂模式力矩*/
{
  char str[200];
  dword RID;
  byte Temp_1[6]={0x2E,0x01,0x00,0x00,0x00,0x00};
  int i;
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(6,ID,Temp_1);
  _TestResult(SendData,ID,"",-1);
  /*出现部分长安项目需要重启进入工厂模式才能生效*/
  _Set_11_Restoration();
  _SetSession(exsession);
  _unlockECU();
  if(NRC22_TasTorque_Fac_Flage!=1)
    _WriteEx_and_Report(ECU_project,"无工厂模式力矩不同导致回NRC22");
  else
  {
    for(i=0;i<2;i++)
    {
      _get_Arry("Pre_Programmed");
      snprintf(str,elCount(str),"%s","");
      if(i==0)
        snprintf(str,elCount(str),"控制力矩满足工厂模式NRC22条件,大于 %.2f Nm,并保持",NRC22_TasTorque_Fac+0.2);
      else
        snprintf(str,elCount(str),"控制力矩满足工厂模式NRC22条件,大于 %.2f Nm,并保持",(NRC22_TasTorque_Fac+0.2)*(-1));
      testWaitForTesterConfirmation(str,30000);
      _Send_Diag(Arry_Len,ID,Arry_Data);
      RID = (Arry_Data[2]<<8) + Arry_Data[3];
      if((_Check_Serve(Arry_Data[1],RID,10)&0x4)==4)
        _TestResult(SendData,ID,"",NRC22);
      else
        _Check_31Routine_Rx(Arry_Data,1);
      _get_Arry("Angle_Calibration");
      Arry_Data[4] = 0x02;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      RID = (Arry_Data[2]<<8) + Arry_Data[3];
      if((_Check_Serve(Arry_Data[1],RID,10)&0x4)==4)
        _TestResult(SendData,ID,"",NRC22);
      else
      {
        _Check_31Routine_Rx(Arry_Data,1);
        TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
      }
      testWaitForTimeout(100);
      _get_Arry("Angle_Calibrationn");
      _Send_Diag(Arry_Len,ID,Arry_Data);
      RID = (Arry_Data[2]<<8) + Arry_Data[3];
      if((_Check_Serve(Arry_Data[1],RID,10)&0x4)==4)
      {
        _TestResult(SendData,ID,"",NRC22);
        TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
      }
      else
      {
        _Check_31Routine_Rx(Arry_Data,1);
        TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
      }
      snprintf(str,elCount(str),"%s","");
      if(i==0)
        snprintf(str,elCount(str),"控制力矩不满足工厂模式NRC22条件,小于 %.2f Nm,并保持",NRC22_TasTorque_Fac-0.2);
      else
        snprintf(str,elCount(str),"控制力矩不满足工厂模式NRC22条件,小于 %.2f Nm,并保持",(NRC22_TasTorque_Fac-0.2)*(-1));
      testWaitForTesterConfirmation(str,30000);
      _get_Arry("Pre_Programmed");
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
      _get_Arry("Angle_Calibration");
      Arry_Data[4] = 0x02;
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
      TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
      testWaitForTimeout(100);
      _get_Arry("Angle_Calibration");
      _Send_Diag(Arry_Len,ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
      TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
    }
    snprintf(str,elCount(str),"%s","");
    snprintf(str,elCount(str),"松开方向盘");
    testWaitForTesterConfirmation(str,30000);
  }
}
