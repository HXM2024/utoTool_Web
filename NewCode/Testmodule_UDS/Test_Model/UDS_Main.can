        testWaitForTimeout(1000);
        _K15_OFF();
        testWaitForTimeout(3000);
        _K15_ON();
        testWaitForTimeout(500);
        _Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(2000);
      }
      _TestWaitForTesterConfirmation("进行角度自学习，查看自学习情况，应当学习成功");
      _unlockECU();
      _Send_Diag(Send_Len,Send_ID,SendData_Close);
      _Check_31Routine_Rx(SendData_Close,1);
      _TestWaitForTesterConfirmation("进行角度自学习，查看自学习情况，应当学习失败");
      {
        _K15_OFF();
        _K30_OFF();
        testWaitForTimeout(3000);
        _K15_ON();
        _K30_ON();
        testWaitForTimeout(3000);
      }
      _TestWaitForTesterConfirmation("进行角度自学习，查看自学习情况，应当学习失败");
      _unlockECU();
      _Send_Diag(Send_Len,Send_ID,SendData_Open);
      _Check_31Routine_Rx(SendData_Open,1);
      _TestWaitForTesterConfirmation("进行角度自学习，查看自学习情况，应当学习成功");
      {
        _K15_OFF();
        _K30_OFF();
        testWaitForTimeout(3000);
        _K15_ON();
        _K30_ON();
        testWaitForTimeout(3000);
      }
      _TestWaitForTesterConfirmation("进行角度自学习，查看自学习情况，应当学习成功");
      _SetSession(defsession);
      testWaitForTimeout(1000);
    }
  }
}

