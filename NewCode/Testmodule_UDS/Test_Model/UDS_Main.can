_27_Serve_18(dword ID,byte Session)  /*未解锁状态-11重启*/
{
  dword seed;
  int i,j,max,x;
  int Serve_Pos;
  byte Temp[2] ={0x11,0x01};
  diagStartTesterPresent(Cdd_Name);
  Serve_Pos = _Check_Serve(0x11,0,0);
  Temp[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  if( Serve_Data[Serve_Pos].Security_Access[0]==1)
    _WriteEx_and_Report("","11复位需要安全访问条件，此条用例不适用");
  else
  {
    if(Serve_Data[Serve_Pos].RSP[0]==1)
      max = 2;
    else
      max = 1;
    for(j=0;j<max;j++)
    {
      if(j==1)
        Temp[1] = (Serve_Data[Serve_Pos].Serve_Fun[0]|0x80);
      if(Restoration_Error_Count == 0)
      {
        for(i=1;i<Error_Count;i++)
        {
          _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
          _TestResult(SendData,ID,"",NRC35);
          testWaitForTimeout(200);
          _Send_Diag(2,phyreq_ID,Temp);
          if(j==0)
            _TestResult(SendData,ID,"",-1);
          else
            _TestResult(SendData,ID,"",0);
          testWaitForTimeout(2000);
          _SetSession(exsession);
          testWaitForTimeout(1000);
        }
        _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
        _TestResult(SendData,ID,"",NRC36);
        testWaitForTimeout(Error_Count_Delay*0.6);
        _Send_Diag(2,phyreq_ID,Temp);
        if(j==0)
          _TestResult(SendData,ID,"",-1);
        else
          _TestResult(SendData,ID,"",0);
        testWaitForTimeout(2000);
        _SetSession(exsession);
        testWaitForTimeout(500);
        if(Error_Count_Delay_Reset==1)
        {
          testWaitForTimeout(Error_Count_Delay*0.6);
          seed = _get_seed(ID);
          _TestResult(SendData,ID,"",NRC37);
          _Send_Key(SendKey_Len,ID,seed,1);
          _TestResult(SendData,ID,"",NRC24);
        }
        testWaitForTimeout(Error_Count_Delay*0.6);
        _SetSession(exsession);
        _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
        _TestResult(SendData,ID,"",-1);
        _SetSession(exsession);
      }
      else
      {
//        for(i=1;i<=Error_Count;i++)
//        {
//          _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
//          _TestResult(SendData,ID,"",NRC35);
//          _Send_Diag(2,phyreq_ID,Temp);
//          _TestResult(SendData,ID,"",-1);
//          testWaitForTimeout(2000);
//          _SetSession(exsession);
//          testWaitForTimeout(1000);
//        }
//        _Check_Error_Count(ID,Error_Count);
//        seed = _get_seed(ID);
//        _TestResult(SendData,ID,"",NRC37);
//        testWaitForTimeout(Error_Count_Delay*0.6);
//        _Send_Diag(2,phyreq_ID,Temp);
//        if(j==0)
//          _TestResult(SendData,ID,"",-1);
//        else
//          _TestResult(SendData,ID,"",0);
//        testWaitForTimeout(2000);
//        _SetSession(exsession);
//        testWaitForTimeout(500);
//        if(Error_Count_Delay_Reset==1)
//        {
//          testWaitForTimeout(Error_Count_Delay*0.6);
//          seed = _get_seed(ID);
//          _TestResult(SendData,ID,"",NRC37);
//          _Send_Key(SendKey_Len,ID,seed,1);
//          _TestResult(SendData,ID,"",NRC24);
//        }
//        testWaitForTimeout(Error_Count_Delay*0.6);
//        _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
//        _TestResult(SendData,ID,"",-1);
        
        x = 1;
        for(i=1;i<=Error_Count;i++)
        {
          _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
          if(i == Error_Count)
            _TestResult(SendData,ID,"",0x36);
          else
            _TestResult(SendData,ID,"",0x35);
          if(x==i && i!=Error_Count)
          {
            _Send_Diag(2,phyreq_ID,Temp);
            if(j==0)
              _TestResult(SendData,ID,"",-1);
            else
              _TestResult(SendData,ID,"",0);
            testWaitForTimeout(500);
            _SetSession(exsession);
            testWaitForTimeout(1000);
            x++;
            i = 0;
          }
        }
        seed = _get_seed(ID);
        _TestResult(SendData,ID,"",NRC37);
        testWaitForTimeout(Error_Count_Delay*0.5);
        _Send_Diag(2,phyreq_ID,Temp);
        if(j==0)
          _TestResult(SendData,ID,"",-1);
        else
          _TestResult(SendData,ID,"",0);
        testWaitForTimeout(Wait_Time_11);
        _SetSession(exsession);
        testWaitForTimeout(Error_Count_Delay*0.5);
        if(Error_Count_Delay_Reset==1)
        {
          seed = _get_seed(ID);
          _TestResult(SendData,ID,"",NRC37);
          testWaitForTimeout(Error_Count_Delay*0.6);
        }
        seed = _get_seed(ID);
        _TestResult(SendData,ID,"",-1);
        _Send_Key(SendKey_Len,ID,seed,0);
        _TestResult(SendData,ID,"",-1);
        _SetSession(exsession);
      }
    }
  }
}

_27_Serve_19(dword ID,byte Session)  /*不连续重复请求种子验证重复率*/
{
  qword i;
  diagStartTesterPresent(Cdd_Name);
  _Set_Ready(0);
  testWaitForTimeout(2000);
  if(AES_128 != 0)      //AES-128算法要求请求种子具备随机性
  {
    for(i=0;i<Request_Seed_Count;i++)
    {
      _SetSession(Session);
      testWaitForTimeout(200);
      _get_seed(ID);
      Get_Seed_Flage = 1;
      writeEx(-3,0,"当前测试次数 %d 次",i+1);
      if(i%100==0 && i!=0)
      {
        _Power_Down();
        _Power_Up();
        testWaitForTimeout(1000);
      }
    }
  }
  else
  {
    for(i=0;i<Request_Seed_Count;i++)
    {
      writeEx(-3,0,"当前测试次数 %d 次",i+1);
      _SetSession(exsession);
      testWaitForTimeout(200);
      _get_seed(ID);
      Get_Seed_Flage = 1;
//    if(i==(word)random(Request_Seed_Count))
      if(i%100==0 && i!=0)
      {
        _Power_Down();
        _Power_Up();
        testWaitForTimeout(200);
      }
    }
  }
  testWaitForTimeout(2000);
  _Check_Repeat(Request_Seed_Count,1);
}
_27_Serve_19_1(dword ID,byte Session)  /*连续重复请求种子验证重复率*/
{
  qword i;
  diagStartTesterPresent(Cdd_Name);
  _Set_Ready(0);
  testWaitForTimeout(2000);
  if(Request_Error_Count == 0 && Request_Seed_Consistency == 0)
  {
    if(AES_128 != 0)      //AES-128算法要求请求种子具备随机性
    {
      for(i=0;i<Request_Seed_Count;i++)
      {
        _get_seed(ID);
        Get_Seed_Flage = 1;
        testWaitForTimeout(200);
        writeEx(-3,0,"当前测试次数 %d 次",i+1);
        if(i%100==0 && i!=0)
        {
          _Power_Down();
          testWaitForTimeout(1000);
          _Power_Up();
          _SetSession(Session);
        }
        testWaitForTimeout(200);
      }
      
    }
    else
    {
      for(i=0;i<Request_Seed_Count;i++)
      {
        writeEx(-3,0,"当前测试次数 %d 次",i+1);
        _get_seed(ID);
        Get_Seed_Flage = 1;
//        if(i==(word)random(Request_Seed_Count))
        if(i%100==0 && i!=0)
        {
          _Power_Down();
          testWaitForTimeout(1000);
          _Power_Up();
          _SetSession(exsession);
        }
        testWaitForTimeout(200);
      }
    }
    testWaitForTimeout(2000);
    _Check_Repeat(Request_Seed_Count,1);
  }
  else
    _WriteEx_and_Report("","连续请求种子错误计数器累加或种子一致,跳过测试");
}
_27_Serve_19_2(dword ID,byte Session)  /*多次过安全访问*/
{
  qword i;
  byte Seed[2] = {0x27,0x01};
  byte SeedKey[100];
  int Serve_Pos;
  Serve_Pos = _Check_Serve(0x27,0,0);
  Seed[1] = RequestSeed_27;
  SeedKey[0] = 0x27;
  SeedKey[1] = SendKey_27;
  _Set_Ready(0);
  testWaitForTimeout(2000);
  for(i=0;i<Request_Unlock_Count;i++)
  {
    _SetSession(exsession);
    _Send_Diag(2,ID,Seed);
    _TestResult(SendData,ID,"",-1);
    _Send_Diag(SendKey_Len,ID,SeedKey);
    _TestResult(SendData,ID,"",NRC35);
    if(diagGetLastResponseCode(SendData) == -1)
    {
      _WriteEx_and_Report("","当种子为全0时通过了安全访问");
      break;
    }
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    if(i%100==0 && i!=0)
    {
      _Power_Down();
      testWaitForTimeout(1000);
      _Power_Up();
      _SetSession(exsession);
    }
    testWaitForTimeout(50);
    
    Get_Seed_Flage = 1;
  }
  _Check_Repeat(Request_Unlock_Count,1);
}
_27_Serve_20(dword ID,byte Session) /*优先级*/
{
  byte Send_Data[100];
  int Serve_Pos,j;
  
  Serve_Pos = _Check_Serve(0x27,0,0);
  if(_Check_Serve_IDAndSess(0x27,ID,Session) == 1)
  {
    Send_Data[0] = 0x27;
    for(j=0;j<Serve_Data[Serve_Pos].Serve_Fun_Count;j++)
    {
      _Set_NRC_Step(0x27,Serve_Data[Serve_Pos].Serve_Fun[j],6,Send_Data);
      if(Fun_NRC_Count == 0)
      {
        _WriteEx_and_Report("","未输入NRC，跳过测试");
        return;
      }
      if(j==0)
        _WriteEx_and_Report("","测试请求种子NRC优先级");
      else
      {
        _WriteEx_and_Report("","测试发送秘钥NRC优先级");
        _SetSession(Session);
        testWaitForTimeout(200);
      }
      for(i=0;i<Fun_NRC_Count;i++)
      {
        if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        {
          _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,j,Send_Data);
        }
        if(i == Fun_NRC_Count)
        {
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",-1);
        }
        else
        {
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",Fun_NRC[i]);
        }
        testWaitForTimeout(100);
        if(Fun_NRC[i] == 0x24)
        {
          _get_seed(ID);
          testWaitForTimeout(200);
        }
      }
      if(Serve_Data[Serve_Pos].Serve_Fun[j] == RequestSeed_27)
      {
        _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      }
      else if(Serve_Data[Serve_Pos].Serve_Fun[j] == SendKey_27)
      {
        if(_Check_NRC_In_List(0x27,Serve_Data[Serve_Pos].Serve_Fun[j],0x24) != 1)
        {
          _Send_Key(SendKey_Len,ID,0,0);
          _TestResult(SendData,ID,"",NRC24);
        }
        _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      }
    }
  }
}
_27_Serve_22(dword ID,byte Session)  /*NRC13*/
{
  int i;
  byte Temp_Seed[2]={0x27,0x01};
  byte Temp_Key[2]={0x27,0x01};
  int Len;
  Temp_Seed[1] = RequestSeed_27;
  Temp_Key[1] = SendKey_27;
  Len = _Check_CANFD_Flage();
  if(SendKey_Len == 0x12)
    Len = 0x13;
  _WriteEx_and_Report("种子","遍历请求种子子功能长度");
  for(i=1;i<=Len;i++)
  {
    if(i==2)
    {
      _WriteEx_and_Report("","0x02 长度支持,跳过检测");
      continue;
    }
    _Send_Diag(i,ID,Temp_Seed);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(50);
  }
  testWaitForTimeout(1000);
  
  _SetSession(Session);
  _WriteEx_and_Report("密钥","遍历密钥子功能长度");
  for(i=1;i<=Len;i++)
  {
    if(i==SendKey_Len)
    {
      _WriteEx_and_Report("","长度支持,跳过检测");
      continue;
    }
//    if(Request_Error_Count == 0)
    {
      /*防止NRC24>NRC13*/
       _Send_Diag(2,ID,Temp_Seed);
    }
    _Send_Diag(i,ID,Temp_Key);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(50);
  }
}
_27_Serve_23(dword ID,byte Session)  /*NRC12*/
{
  word i;
  byte Temp_Seed[2]={0x27,0x01};
  int Serve_Pos;
  
  Serve_Pos = _Check_Serve(0x27,0,0);
  
  for(i=0;i<=0xff;i++)
  {
    Temp_Seed[1] = i;
    if(i==RequestSeed_27 || i==SendKey_27)
    {
      _WriteEx_and_Report("","跳过该子功能检测");
      continue;
    }
    if(Serve_Data[Serve_Pos].RSP[0]==1)
    {
      if(i == (Serve_Data[Serve_Pos].Serve_Fun[0]|0x80) || i == (Serve_Data[Serve_Pos].Serve_Fun[1]|0x80))
        continue;
    }
    if(APP_BT_27_Flage==1 &&(i==BT_RequestSeed_27 || i==BT_SendKey_27))
    {
      _WriteEx_and_Report("","BT支持该子功能,跳过该子功能检测");
      continue;
    }
    _Send_Diag(2,ID,Temp_Seed);
    _TestResult(SendData,ID,"",NRC12);
    testWaitForTimeout(100);
  }
}
_27_Serve_24(dword ID,byte Session)  /*NRC24*/
{
  dword seed;
  int i,flage=0;
  
  _Send_Key(SendKey_Len,ID,0,1);
  _TestResult(SendData,ID,"",NRC24);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  Seed_Count = 0; /*用于重置种子存储位置,验证后续种子是否为全0*/
  seed = _get_seed(ID);
  if(AES_128==0)
  {
    if(seed==0)
      testStepPass("","通过安全访问后,返回种子为全0");
    else
      testStepFail("","通过安全访问后,返回种子不为0");
  }
  else if(AES_128 != 0)
  {
    for(i=0;i<16;i++)
    {
      if(Seed_Count_List_AES128[0][i]!=0)
        flage=1;
    }
    if(flage==0)
      testStepPass("","通过安全访问后,返回种子为全0");
    else
      testStepFail("","通过安全访问后,返回种子不为0");
  }
  _Send_Key(SendKey_Len,ID,seed,0);
  _TestResult(SendData,ID,"",NRC24);
}
_27_Serve_25(dword ID,byte Session)  /*NRC22*/
{
  byte Temp_Seed[2]={0x27,0x01};
  dword seed;
  int Serve_Pos;
  diagStartTesterPresent(Cdd_Name);
  Serve_Pos = _Check_Serve(0x27,0,0);
  Temp_Seed[1] = RequestSeed_27;
  if(Serve_Data[Serve_Pos].Serve_NRC22[0]&0x01 != 0)
  {
    _Set_CarSpd(NRC22_CarSpd+1);
    testWaitForTimeout(1000);
      seed = _get_seed(ID);
      _TestResult(SendData,ID,"",NRC22);
      _Send_Key(SendKey_Len,ID,seed,0);
      _TestResult(SendData,ID,"",NRC22);
      _Set_CarSpd(NRC22_CarSpd);
      testWaitForTimeout(1000);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
      _Set_CarSpd(NRC22_CarSpd+1);
      testWaitForTimeout(1000);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.1);
      _SetSession(exsession);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.1);
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
      testWaitForTimeout(Struct_CarSpd.Invalid_Time*1.1);
      _SetSession(exsession);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
  }
  else
    _WriteEx_and_Report("","无NRC22车速条件");
}
_27_Serve_26(dword ID,byte Session)  /*无响应*/
{
  byte Temp_Seed[2]={0x27,0x01};
  Temp_Seed[1] = RequestSeed_27;
  _Send_Diag(2,ID,Temp_Seed);
  _TestResult(SendData,ID,"",0);
  Temp_Seed[1] = SendKey_27;
  _Send_Diag(SendKey_Len,ID,Temp_Seed);
  _TestResult(SendData,ID,"",0);
  if(APP_BT_27_Flage == 1)
  {
    Temp_Seed[1] = BT_RequestSeed_27;
    _Send_Diag(2,ID,Temp_Seed);
    _TestResult(SendData,ID,"",0);
    Temp_Seed[1] = BT_SendKey_27;
    _Send_Diag(SendKey_Len,ID,Temp_Seed);
    _TestResult(SendData,ID,"",0);
  }
}
_27_Serve_27(dword ID,byte Session)  /*F18C与请求种子顺序互换*/
{
  byte Get_F18C[3] = {0x22,0xF1,0x8C};
  dword seed;
  
  if(AES_128 != 2)
  {
    _WriteEx_and_Report("","此安全算法无需请求序列号操作，跳过测试");
  }
  else
  {
    _WriteEx_and_Report("","优先发送获取序列号测试");
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
    _SetSession(defsession);
    testWaitForTimeout(200);
    _SetSession(Session);
    testWaitForTimeout(200);
    _WriteEx_and_Report("","优先发送获取种子测试");
    Get_Seed_Flage = 1;
    seed = _get_seed(ID);
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    _WriteEx_and_Report("","获取序列号");
    _Send_Diag(3,ID,Get_F18C,500);
    {
      byte Falge_AES_CBC;
      int m;
      Falge_AES_CBC = 0;
      if(diagGetLastResponseCode(SendData) == -1)
      {
        if(DiagGetRespPrimitiveSize(SendData) == 22)
        {
          for(m=0;m<16;m++)
            Serial_number[m] = DiagGetRespPrimitiveByte(SendData,m+6);
          /*序列号移位*/
          LeftMove(Serial_number,3);
          /*用ECU KEY加密移位后的序列号 获取密钥KEY*/
          AES128_CBC_encrypt_buffer(Secret_KEY,Serial_number,KEY_Len,ECU_Key,Iv);
        }
        else
        {
          testStepFail("序列号长度错误");
          Falge_AES_CBC =1;
        }
      }
      else
      {
        testStepFail("获取序列号失败");
        Falge_AES_CBC =1;
      }
      if(Falge_AES_CBC == 0)
      {
        _Send_Key(SendKey_Len,ID,seed,0);
        _TestResult(SendData,ID,"",-1);
      }
    }
  }
}

_27_Serve_30(dword ID,byte Session)   /*已解锁状态-11重启&KL15*/
{
  int i;
  for(i=0;i<Serve_11_Unlock_Count;i++)
  {
    _WriteEx_and_Report("","当前测试次数 %d",i+1);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
    _Power_Down();
    testWaitForTimeout(1000);
    _Power_Up();
    testWaitForTimeout(1000);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
    _Set_11_Restoration(0);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
  }
  _Check_Repeat(Serve_11_Unlock_Count,1);
}
_27_Serve_30_(dword ID,byte Session) /*已解锁状态-会话切换*/
{
  dword seed;
  dword skey;
  byte data[2]={0x10,0x02};

  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  _WriteEx_and_Report("","切换会话由10 01->10 03");
  _SetSession(defsession);
  _SetSession(Session);
  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  _WriteEx_and_Report("","切换会话由10 02->10 03");
  if(Pre_Programmed_1002 == 1)
  {
    _get_Arry("Pre_Programmed");
    if(Arry_Len == 0)
      _WriteEx_and_Report("","未查询到对应预编程报文");
    else
    {
      _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
      _TestResult(SendData,phyreq_ID,"",-1);
    }
  }
  _Send_Diag(2,phyreq_ID,data);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
  _SetSession(defsession);
  testWaitForTimeout(2000);
  _SetSession(exsession);
  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  _WriteEx_and_Report("","切换会话由10 03->10 03");
  _SetSession(exsession);
  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
}

_27_Serve_31(dword ID,byte Session)   /*长度不对的正确秘钥*/
{
  int i;
  for(i=3;i<=SendKey_Len+1;i++)
  {
    if(i == SendKey_Len)
      continue;
    _Send_Key_(i,ID,_get_seed(ID),-1);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(100);
  }
  
  for(i=2;i<=4;i++)
  {
    _SetSession(exsession);
    _Send_Key_(i*(SendKey_Len-2)+2,ID,_get_seed(ID),-1);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(100);
  }
}
_27_Serve_32(dword ID,byte Session)   /*子功能错误的正确秘钥*/
{
  int i;
  int Pos;
  Pos = _Check_Serve(0x27,0,0);
  for(i=0;i<=0xFF;i++)
  {
    if(i==RequestSeed_27 || i==SendKey_27)
      continue;
    if(APP_BT_27_Flage == 1 && (i==BT_RequestSeed_27 || i==BT_SendKey_27))
      continue;
    if((Serve_Data[Pos].RSP[0] == 1) && ((i == (RequestSeed_27|0x80)) || (i == (SendKey_27|0x80))))
      continue;
    if((Serve_Data[Pos].RSP[0] == 1) && (APP_BT_27_Flage == 1) && ((i == (BT_RequestSeed_27|0x80)) || (i == (BT_SendKey_27|0x80))))
      continue;
    _SetSession(exsession);
    _Send_Key_(SendKey_Len,ID,_get_seed(ID),i);
    _TestResult(SendData,ID,"",NRC12);
    testWaitForTimeout(20);
  }
}
void _Serve27_33(dword ID,byte Session)/*肯定响应抑制位*/
{
  byte Data_Send_27[2]={0x27,0x00};
  int i,Serve_Pos;
  Serve_Pos = _Check_Serve(0x27,0,0);
  if(Serve_Data[Serve_Pos].RSP[0] == 1)
  {
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[1]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[1],ID,Data_Send_27);
    _TestResult(SendData,ID,"",NRC24);
    
    for(i=0;i<Error_Count;i++)
    {
      Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[0]|0x80;
      _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Data_Send_27);
      _TestResult(SendData,ID,"",0);
      
      Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[1]|0x80;
      _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[1],ID,Data_Send_27);
      if(i<Error_Count-1)
        _TestResult(SendData,ID,"",NRC35);
      else
        _TestResult(SendData,ID,"",NRC36);
      testWaitForTimeout(50);
    }
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[0]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Data_Send_27);
    _TestResult(SendData,ID,"",NRC37);
    
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[1]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[1],ID,Data_Send_27);
    _TestResult(SendData,ID,"",0x24);
    
    diagStartTesterPresent(Cdd_Name);
    testWaitForTimeout(Error_Count_Delay*1.1+1000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  }
  else
    _WriteEx_and_Report("","NRC12中已经测试，此处不再执行");
}
void _Serve27_34(dword ID,byte Session)/*肯定响应抑制位混合测试*/
{
  byte Data_Send_27[2]={0x27,0x00};
  byte Data_Res_27[20];
  int i,Serve_Pos;
  dword Seed;
  Serve_Pos = _Check_Serve(0x27,0,0);
  Data_Res_27[0] = 0x67;
  Data_Res_27[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  if(Serve_Data[Serve_Pos].RSP[0] == 1)
  {
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[0]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Data_Send_27);
    _TestResult(SendData,ID,"",0);
    testWaitForTimeout(600);
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[1]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[1],ID,Data_Send_27);
    _TestResult(SendData,ID,"",0x35);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);

    _SetSession(exsession);
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[0]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Data_Send_27);
    _TestResult(SendData,ID,"",0);
    testWaitForTimeout(600);
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[1];
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[1],ID,Data_Send_27);
    _TestResult(SendData,ID,"",0x35);

    testWaitForTimeout(200);
    _Send_Key_(SendKey_Len,ID,_get_seed(ID),Serve_Data[Serve_Pos].Serve_Fun[1]|0x80);
    _TestResult(SendData,ID,"",0);
    _get_seed(ID);
    _Check_Response(SendData,Serve_Data[Serve_Pos].Serve_Fun_Len[1],Data_Res_27);
    testWaitForTimeout(1200);

    _SetSession(exsession);
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[0];
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Data_Send_27);
    _TestResult(SendData,ID,"",-1);
    testWaitForTimeout(600);
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[1]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[1],ID,Data_Send_27);
    _TestResult(SendData,ID,"",0x35);

    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[0]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Data_Send_27);
    _TestResult(SendData,ID,"",0);
    testWaitForTimeout(600);
    Data_Send_27[1]=Serve_Data[Serve_Pos].Serve_Fun[1]|0x80;
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[1],ID,Data_Send_27);
    if(Error_Count==2)
      _TestResult(SendData,ID,"",NRC36);
    else
      _TestResult(SendData,ID,"",NRC35);
    
    diagStartTesterPresent(Cdd_Name);
    testWaitForTimeout(Error_Count_Delay*1.1+1000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    testWaitForTimeout(600);
  }
  else
    _WriteEx_and_Report("","不支持肯定响应抑制位");
}

_Serve27_35(dword ID,byte Session)/*未解锁状态-上下电及11复位(重启会使计数器清0，且重置等待时间)*/
{
  dword seed;
  int i,j;
  byte Temp[2] ={0x11,0x01};
  diagStartTesterPresent(Cdd_Name);
  _Set_Ready(0);
  testWaitForTimeout(1000);
  for(j=0;j<3;j++)
  {
    for(i=0;i<Error_Count-1;i++)
    {
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
      _TestResult(SendData,ID,"",NRC35);
      testWaitForTimeout(50);// 加入操作NV块时间，防止过短无法写入错误计数器
      Get_Seed_Flage = 1;
    }
    if(j==0)
    {
      _K15_OFF();
      testWaitForTimeout(3000);
      _K15_ON();
      testWaitForTimeout(3000);
    }
    else
    {
      if(j==2)
        Temp[1] = 0x81;
      _Send_Diag(2,phyreq_ID,Temp);
      if(j==1)
        _TestResult(SendData,ID,"",-1);
      else
        _TestResult(SendData,ID,"",0);
      testWaitForTimeout(2000);
    }
    
    for(i=0;i<Error_Count-1;i++)
    {
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
      _TestResult(SendData,ID,"",NRC35);
      testWaitForTimeout(50);// 加入操作NV块时间，防止过短无法写入错误计数器
    }
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC36);
    testWaitForTimeout(Error_Count_Delay*0.6);
    if(j==0)
    {
      _K15_OFF();
      testWaitForTimeout(3000);
      _K15_ON();
      testWaitForTimeout(2000);
    }
    else
      _Set_11_Restoration(0);
    testWaitForTimeout(Error_Count_Delay*0.5);
    _SetSession(exsession);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
    testWaitForTimeout(Error_Count_Delay*0.6);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _SetSession(defsession);
    _SetSession(exsession);
  }
}

