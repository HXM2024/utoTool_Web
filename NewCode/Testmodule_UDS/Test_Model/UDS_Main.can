_31_Serve_53(dword ID,byte Session)/*肯定响应抑制位*/
{
  int i,j,k,Len_Send;
  byte Send_Data31[10];
  Send_Data31[0] = 0x31;
  _unlockECU();
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    for(j=0;j<Serve_31_Hex[i].Control_Type_Count;j++)
    {
      for(k=0;k<Serve_31_Hex[i].Control_Option_Count[j];k++)
      {
        Send_Data31[1] = Serve_31_Hex[i].Control_Type[j];
        Send_Data31[2] = Serve_31_Hex[i].Routine[0];
        Send_Data31[3] = Serve_31_Hex[i].Routine[1];
        Len_Send = Serve_31_Hex[i].Routine_Len;
        if(Len_Send == 5)
          Send_Data31[4] = Serve_31_Hex[i].Control_Option[j][k];
        Send_Data31[1] = (Send_Data31[1]|0x80);
        _Send_Diag(Len_Send,ID,Send_Data31);
        _TestResult(SendData,ID,"",NRC12);
        testWaitForTimeout(200);
      }
    }
  }
}

_3E_Serve_1(dword ID,byte Session)/*  3E 00 */
{
  byte Tem[2] = {0x3E,0x00};
  int Flage;
  Flage = _Check_Fun_IDAndSess(0x3E,0x00,ID,Session);
  _Send_Diag(2,ID,Tem);
  if(Flage == 1)
    _TestResult(SendData,ID,"",-1);
  else if((Flage == -2) || (Flage == -1))
    _TestResult(SendData,ID,"",NRC12);
  else if(Flage == 0 )
    _TestResult(SendData,ID,"",NRC7F);
}

_3E_Serve_2(dword ID,byte Session)/*  3E 80 */
{
  byte Tem[2] = {0x3E,0x80};
  int Flage;
  Flage = _Check_Fun_IDAndSess(0x3E,0x00,ID,Session);
  _Send_Diag(2,ID,Tem);
  if(Flage == 1)
  {
    if(_Check_Serve(0x3E,0,9)==1)
      _TestResult(SendData,ID,"",0);
    else
      _TestResult(SendData,ID,"",NRC12);
  }
  else if((Flage == -2) || (Flage == -1))
    _TestResult(SendData,ID,"",NRC12);
  else if(Flage == 0 )
    _TestResult(SendData,ID,"",NRC7F);
}

_3E_Serve_3(dword ID,byte Session)/*  NRC */
{
  int Serve_Pos,i;
  byte Send_Data[100];
  
  Serve_Pos = _Check_Serve(0x3E,0,0);
  if(_Check_Serve_IDAndSess(0x3E,ID,Session) == 1)
  {
    _Set_CarSpd(NRC22_CarSpd + 1);
    Send_Data[0] = 0x3E;
    _Set_NRC_Step(0x3E,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","当前寻址或会话不支持该子功能");
}
_3E_Serve_4(dword ID,byte Session)/*  NRC13 */
{
  byte Send_Data[2] = {0x3E,0x00};
  int Len;
  Len = _Check_CANFD_Flage();
  for(i=1;i<=Len;i++)
  {
    if(i==0x02)
      continue;
    _Send_Diag(i,ID,Send_Data);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(50);
  }
}
_3E_Serve_5(dword ID,byte Session)/*  NRC12 */
{
  byte Send_Data[2] = {0x3E,0x01};
  int Serve_Pos,i;
  
  Serve_Pos = _Check_Serve(0x3E,0,0);
  if(_Check_Serve_IDAndSess(0x3E,ID,Session) == 1)
  {
    for(i=0;i<=0xFF;i++)
    {
      if((_Check_Serve(0x3E,i,4)!=-1) || ((_Check_Serve(0x3E,(i&0x0F),4)!=-1) && ((i>>4)==0x08) && (_Check_Serve(0x3E,i&0x0F,9) == 1)))
        continue;
      Send_Data[1]=i;
      _Send_Diag(2,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC12);
      testWaitForTimeout(50);
    }
  }
}
_3E_Serve_6(dword ID,byte Session)/*  3E 00 */
{
  byte Tem[2] = {0x3E,0x00};
  byte Tem_1[3] = {0x28,0x03,0x01};
  byte Tem_2[2] = {0x01,0x03};
  int Serve_Pos;
  int Check_Flag;
  Serve_Pos = _Check_Serve(0x28,0,0);
  Check_Flag = 1;
  for(i=0;i<2;i++)
  {
    if(_Check_Serve(0x28,Tem_2[i],4)!= -1)
    {
      Tem_1[1] = Tem_2[i];
      break;
    }
  }
  if(i==2)
  {
    Tem_1[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
    Check_Flag = 0;
  }
  Tem_1[2] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  
  _SetSession(Session);
  testWaitForTimeout(3000);
  _Send_Diag(2,ID,Tem);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(3000);;
  _Send_Diag(3,ID,Tem_1);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(50);
  if(Check_Flag == 1)
    _Check_EPS_TX(0,EPS_TxID_1);
  _SetSession(defsession);
}
_3E_Serve_7(dword ID,byte Session)/*  3E 80 */
{
  byte Tem[2] = {0x3E,0x80};
  byte Tem_1[3] = {0x28,0x03,0x01};
  byte Tem_2[2] = {0x01,0x03};
  int Serve_Pos;
  int Check_Flag;
  Serve_Pos = _Check_Serve(0x28,0,0);
  Check_Flag = 1;
  for(i=0;i<2;i++)
  {
    if(_Check_Serve(0x28,Tem_2[i],4)!= -1)
    {
      Tem_1[1] = Tem_2[i];
      break;
    }
  }
  if(i==2)
  {
    Tem_1[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
    Check_Flag = 0;
  }
  Tem_1[2] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  
  if(_Check_Serve(0x3E,0,9)==0)
  {
    _Send_Diag(2,ID,Tem);
    _TestResult(SendData,ID,"",NRC12);
  }
  else
  {
    _SetSession(Session);
    testWaitForTimeout(3000);
    _Send_Diag(2,ID,Tem);
    _Check_NoResponse(SendData);
    testWaitForTimeout(3000);;
    _Send_Diag(3,ID,Tem_1);
    _TestResult(SendData,ID,"",-1);
    testWaitForTimeout(50);
    if(Check_Flag == 1)
      _Check_EPS_TX(0,EPS_TxID_1);
    _SetSession(defsession);
  }
}

