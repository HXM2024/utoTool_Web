void _APP_Valid_1002()
{
  byte Send_1002[2] = {0x10,0x02};
  byte Send_19[3] = {0x19,0x02,0x01};
  byte Send_2[2] = {0x11,0x02};
  int Serve_Pos,MsgFlage,DiagFlage;
  int Time;
  Serve_Pos = _Check_Serve(0x11,0,0);
  Send_2[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  _Set_Ready(0);
  testWaitForTimeout(500);
  for(Time=0;Time<1000;Time=Time+5)
  {
    MsgFlage = 0;
    DiagFlage = 0;
    _WriteEx_and_Report("","K30异常复位");
    _SetSession(exsession);
    _Other_1002();
    _Send_Diag_NoTime(2,phyreq_ID,Send_1002);
    if(Time == 0)
      Time = 1;
    testWaitForTimeout(Time);
    _WriteEx_and_Report("","等待 %d ms",Time);
    _Power_Down_();
    testWaitForTimeout(1000);
    _Power_Up_();
    testWaitForTimeout(2000);
    if(Time == 1)
      Time = Time -1;
    _Send_Diag(3,phyreq_ID,Send_19);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,1000);
    if(diagGetLastResponseCode(SendData) != -1 )
    {
      DiagFlage = -1;
      testStep("","19服务响应异常,当前时间为 %d ms",Time);
    }
    MsgFlage = _Check_EPS_TX(1,EPS_TxID_1);
    if(MsgFlage == -1 && DiagFlage == -1)
    {
      testStepFail("","当前APP异常,等待时间为 %d ms",Time);
      {
        /*新增判断，当出现APP异常时，需要判断返回APP后再看是否正常*/
        _SetSession(defsession);
        testWaitForTimeout(2000);
        _Send_Diag(3,phyreq_ID,Send_19);
        if(diagGetLastResponseCode(SendData) == 0)
          testWaitForDiagResponse(SendData,1000);
        if(diagGetLastResponseCode(SendData) != -1 )
          break;
      }
    }
    _WriteEx_and_Report("","11复位");
    _SetSession(exsession);
    _Other_1002();
    _Send_Diag(2,phyreq_ID,Send_1002);
    _TestResult(SendData,phyreq_ID,"",-1);
    testWaitForTimeout(2000);
    _Send_Diag_NoTime(2,phyreq_ID,Send_2);
    if(Time == 0)
      Time = 1;
    testWaitForTimeout(Time);
    _WriteEx_and_Report("","等待 %d ms",Time);
    _Power_Down_();
    testWaitForTimeout(1000);
    _Power_Up_();
    testWaitForTimeout(2000);
    if(Time == 1)
      Time = Time -1;
    _Send_Diag(3,phyreq_ID,Send_19);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,1000);
    if(diagGetLastResponseCode(SendData) != -1 )
    {
      DiagFlage = -1;
      testStep("","19服务响应异常,当前时间为 %d ms",Time);
    }
    MsgFlage = _Check_EPS_TX(1,EPS_TxID_1);
    if(MsgFlage == -1 && DiagFlage == -1)
    {
      testStepFail("","当前APP异常,等待时间为 %d ms",Time);
      {
        /*新增判断，当出现APP异常时，需要判断返回APP后再看是否正常*/
        _SetSession(defsession);
        testWaitForTimeout(2000);
        _Send_Diag(3,phyreq_ID,Send_19);
        if(diagGetLastResponseCode(SendData) == 0)
          testWaitForDiagResponse(SendData,1000);
        if(diagGetLastResponseCode(SendData) != -1 )
          break;
      }
    }
  }
}
void _APP_Valid_Serve_11()
{
  byte Send_19[3] = {0x19,0x02,0x01};
  byte Send_2[2] = {0x11,0x02};
  int Serve_Pos,MsgFlage,DiagFlage;
  int Time,Flage,Access;
  Flage = 1;Access = 0;
  MsgFlage = 0;
  DiagFlage = 0;
  Serve_Pos = _Check_Serve(0x11,0,0);
  Send_2[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  if(Serve_Data[Serve_Pos].Security_Access[0] == 1)
  {
    Flage = 0;
    Access = 1;
  }
  if(Flage == 1 && _Check_Serve_IDAndSess(0x11,phyreq_ID,defsession) != 1)
    Flage = 0;
  
  _Set_Ready(0);
  testWaitForTimeout(500);
  for(Time=0;Time<1000;Time=Time+5)
  {
    if(Access == 1)
      _unlockECU();
    else
      _SetSession(exsession);
    
    MsgFlage = 0;
    DiagFlage = 0;
    _Send_Diag_NoTime(2,phyreq_ID,Send_2);
    if(Time == 0)
      Time = 1;
    testWaitForTimeout(Time);
    _WriteEx_and_Report("","等待 %d ms",Time);
    _Power_Down_();
    testWaitForTimeout(1000);
    _Power_Up_();
    testWaitForTimeout(2000);
    if(Time == 1)
      Time = Time -1;
    _Send_Diag(3,phyreq_ID,Send_19);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,1000);
    if(diagGetLastResponseCode(SendData) != -1 )
    {
      DiagFlage = -1;
      testStep("","19服务响应异常,当前时间为 %d ms",Time);
    }
    MsgFlage = _Check_EPS_TX(1,EPS_TxID_1);
    if(MsgFlage == -1 && DiagFlage == -1)
    {
      testStepFail("","当前APP异常,等待时间为 %d ms",Time);
      {
        /*新增判断，当出现APP异常时，需要判断返回APP后再看是否正常*/
        _SetSession(defsession);
        testWaitForTimeout(2000);
        _Send_Diag(3,phyreq_ID,Send_19);
        if(diagGetLastResponseCode(SendData) == 0)
          testWaitForDiagResponse(SendData,1000);
        if(diagGetLastResponseCode(SendData) != -1 )
          break;
      }
    }
    
    if(Flage == 1)
    {
      _Send_Diag_NoTime(2,phyreq_ID,Send_2);
      if(Time == 0)
        Time = 1;
      testWaitForTimeout(Time);
      _WriteEx_and_Report("","等待 %d ms",Time);
      _Power_Down_();
      testWaitForTimeout(1000);
      _Power_Up_();
      testWaitForTimeout(2000);
      if(Time == 1)
        Time = Time -1;
      _Send_Diag(3,phyreq_ID,Send_19);
      if(diagGetLastResponseCode(SendData) == 0)
        testWaitForDiagResponse(SendData,1000);
      if(diagGetLastResponseCode(SendData) != -1 )
      {
        DiagFlage = -1;
        testStep("","19服务响应异常,当前时间为 %d ms",Time);
      }
      MsgFlage = _Check_EPS_TX(1,EPS_TxID_1);
      if(MsgFlage == -1 && DiagFlage == -1)
      {
        testStepFail("","当前APP异常,等待时间为 %d ms",Time);
        {
          /*新增判断，当出现APP异常时，需要判断返回APP后再看是否正常*/
          _SetSession(defsession);
          testWaitForTimeout(2000);
          _Send_Diag(3,phyreq_ID,Send_19);
          if(diagGetLastResponseCode(SendData) == 0)
            testWaitForDiagResponse(SendData,1000);
          if(diagGetLastResponseCode(SendData) != -1 )
            break;
        }
      }
    }
  }
}
