_Abnormal_NRC_9() /*31h-NRC13*/
{
  int i,len,Pos,Count,j;
  byte Send_Data[60];
  byte Send_Seed[2] = {0x27,0x00};
  byte Send_Data_1[10];
  byte Data_Support_Len[10];
  byte Data_Support[10][10];
  
  Send_Seed[1] = RequestSeed_27;
  len = _Check_CANFD_Flage();
  _Get_31_ServeData(0,Send_Data,0);
  testStep("步骤1","---------------------");
  _SetSession(exsession);
  testWaitForTimeout(500);
  _Send_Key(SendKey_Len+1,phyreq_ID,_get_seed(phyreq_ID),1);
  _TestResult(SendData,phyreq_ID,"",NRC13);
  _unlockECU();
  
  Count = 0;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    if(_Check_Dword_in_Num(Serve_31_Hex[i].Routine_Len,Data_Support_Len,Count) == -1)
    {
      Data_Support[Count][0] = 0x31;
      Data_Support[Count][1] = Serve_31_Hex[i].Control_Type[0];
      Data_Support[Count][2] = Serve_31_Hex[i].Routine[0];
      Data_Support[Count][3] = Serve_31_Hex[i].Routine[1];
      if(Serve_31_Hex[i].Control_Option_Count[0] != 0)
        Data_Support[Count][4] = Serve_31_Hex[i].Control_Option[0][0];
      Data_Support_Len[Count] = Serve_31_Hex[i].Routine_Len;
      Count++;
    }
  } //长度+子功能
  for(j=0;j<Count;j++)
  {
    for(i=0;i<10;i++)
      Send_Data[i] = Data_Support[j][i];
    for(i=1;i<=len;i++)
    {
      if(i==Data_Support_Len[j])
        continue;
      _Send_Diag(i,phyreq_ID,Send_Data);
      _TestResult(SendData,phyreq_ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  
  testStep("步骤2","---------------------");
  _Set_11_Restoration();
  _SetSession(exsession);
  _Send_Diag(7,phyreq_ID,Send_Seed);
  _TestResult(SendData,phyreq_ID,"",NRC13);
  _unlockECU();
  for(j=0;j<Count;j++)
  {
    for(i=0;i<10;i++)
      Send_Data[i] = Data_Support[j][i];
    for(i=1;i<=len;i++)
    {
      if(i==Data_Support_Len[j])
        continue;
      _Send_Diag(i,phyreq_ID,Send_Data);
      _TestResult(SendData,phyreq_ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  
  testStep("步骤3","---------------------");
  _K30_OFF();
  testWaitForTimeout(1000);
  _K30_ON();
  testWaitForTimeout(2000);
  _get_Str_Traversal("DID_2E_Traversal");
  _unlockECU();
  _get_2E_DID(Traversal_DID[0]);
  _Send_Diag(DID_2E_SendData_1_Len+1,phyreq_ID,DID_2E_SendData_1);
  _TestResult(SendData,phyreq_ID,"",NRC13);
  _unlockECU();
  for(j=0;j<Count;j++)
  {
    for(i=0;i<10;i++)
      Send_Data[i] = Data_Support[j][i];
    for(i=1;i<=len;i++)
    {
      if(i==Data_Support_Len[j])
        continue;
      _Send_Diag(i,phyreq_ID,Send_Data);
      _TestResult(SendData,phyreq_ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  
  testStep("步骤4","---------------------");
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  _unlockECU();
  _Get_31_ServeData(1,Send_Data,0);
//  _get_Arry("Angle_Calibration");
