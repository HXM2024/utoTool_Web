_85_Serve_2(dword ID,byte Session)/*   85 01/02  */
{
  byte Send_Data_0[2] = {0x85,0x01};
  byte Send_Data[2] = {0x85,0x02};
  int Retu;
  dword  Wait_Time;
  Retu = _Check_Serve_IDAndSess(0x85,ID,Session);
  if(Retu == 1)
  {
    StepByGeely3_0(0x85,Active);
    _85_Check_DTC(1,0);
    StepByGeely3_0(0x85,Close);
    _Send_Diag(2,ID,Send_Data);
    _TestResult(SendData,ID,"",-1);
    StepByGeely3_0(0x85,Active);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _85_Check_DTC(1,0);
    StepByGeely3_0(0x85,Close);
    _Send_Diag(2,ID,Send_Data_0);
    _TestResult(SendData,ID,"",-1);
    Wait_Time = Struct_CarSpd.Lost_Time*1.5;
    StepByGeely3_0(0x85,Active);
    if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))  //仅BYD项目85服务需要加上CAN_Init_Time时间
      Wait_Time = Wait_Time + CAN_Init_Time;
    testWaitForTimeout(Wait_Time);
    _85_Check_DTC(1,Struct_CarSpd.Lost_DTC);
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
  }
  else if(Retu == 0)
  {
    _Send_Diag(2,ID,Send_Data);
    _TestResult(SendData,ID,"",NRC7E);
  }
  else 
  {
    _Send_Diag(2,ID,Send_Data);
    _TestResult(SendData,ID,"",NRC7F);
  }
}
_85_Serve_3(dword ID,byte Session)/*  85 81/82 */
{
  byte Tem_0[2] = {0x85,0x01};
  byte Tem_1[2] = {0x85,0x02};
  int Serve_Pos;
  int Retu;
  dword  Wait_Time;
  Serve_Pos = _Check_Serve(0x85,0,0);
  Retu = _Check_Serve_IDAndSess(0x85,ID,Session);
  if(Retu == 1)
  {
    if(_Check_Serve(0x85,0x01,3)==1)
    {
      _WriteEx_and_Report("","肯定响应抑制位测试");
      Tem_0[1]=0x81;
      Tem_1[1]=0x82;
      StepByGeely3_0(0x85,Active);
      _85_Check_DTC(1,0);
      StepByGeely3_0(0x85,Close);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",0);
      StepByGeely3_0(0x85,Active);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
      _85_Check_DTC(1,0);
      StepByGeely3_0(0x85,Close);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",0);
      StepByGeely3_0(0x85,Active);
      Wait_Time = Struct_CarSpd.Lost_Time*1.5;
      if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD")) //仅BYD项目85服务需要加上CAN_Init_Time时间
        Wait_Time = Wait_Time + CAN_Init_Time;
      testWaitForTimeout(Wait_Time);
      _85_Check_DTC(1,Struct_CarSpd.Lost_DTC);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
    }
    else
    {
      Tem_0[1]=0x81;
      Tem_1[1]=0x82;
      StepByGeely3_0(0x85,Close);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",NRC12);
      _Send_Diag(2,ID,Tem_0);
      _TestResult(SendData,ID,"",NRC12);
    }
  }
  else if(Retu == 0)
  {
    _Send_Diag(2,ID,Tem_0);
    _TestResult(SendData,ID,"",NRC7E);
  }
  else 
  {
    _Send_Diag(2,ID,Tem_0);
    _TestResult(SendData,ID,"",NRC7F);
  }
}

_85_Serve_4(dword ID,byte Session)/*  S3Timeout*/
{
  byte Tem_0[2] = {0x85,0x02};
  byte Tem_1[2] = {0x85,0x82};
  diagStopTesterPresent(Cdd_Name);
  StepByGeely3_0(0x85,Active);
  _Clear_DTC(phyreq_ID);
  _85_Check_DTC(1,0);
  if(_Check_Fun_IDAndSess(0x85,0x02,ID,Session) == 1)
  {
    StepByGeely3_0(0x85,Close);
    _Send_Diag(2,ID,Tem_0);
    _TestResult(SendData,ID,"",-1);
    StepByGeely3_0(0x85,Active);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
    _85_Check_DTC(1,0);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5+S3_85_Time);
    _85_Check_DTC(1,Struct_CarSpd.Lost_DTC);
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(1000);
    _SetSession(Session);
    if(_Check_Serve(0x85,0x02,9)==1) /*肯定响应抑制位测试*/
    {
      _WriteEx_and_Report("","肯定响应抑制位测试");
      _Clear_DTC(phyreq_ID);
      _85_Check_DTC(1,0);
      StepByGeely3_0(0x85,Close);
      _Send_Diag(2,ID,Tem_1);
      _TestResult(SendData,ID,"",0);
      StepByGeely3_0(0x85,Active);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
      _85_Check_DTC(1,0);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5+S3_85_Time);
      _85_Check_DTC(1,Struct_CarSpd.Lost_DTC);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
    }
    else
      _WriteEx_and_Report("","当前项目不支持肯定响应抑制位,跳过检测");
  }
}
