_31_Serve_39(dword ID,byte Session)/*NRC22-车速*/
{
  dword RID;
  _Set_Ready(Struct_Ready.Ready_Active);
  _Set_CarSpd(NRC22_CarSpd-1);
  testWaitForTimeout(1000);
  _unlockECU();
  _get_Arry("Pre_Programmed");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _get_Arry("Angle_Calibration");
  Arry_Data[4] = 0x02;
  RID = (Arry_Data[2]<<8) + Arry_Data[3];
  if((_Check_Serve(Arry_Data[1],RID,10)&0x1)==1)
  {
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,1,1);
    _Set_CarSpd(NRC22_CarSpd+1);
    testWaitForTimeout(1000);
    _get_Arry("Pre_Programmed");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if((_Check_Serve(Arry_Data[1],RID,10)&0x1)==1)
       _TestResult(SendData,ID,"",NRC22);
    else
      _Check_31Routine_Rx(Arry_Data,1);
    
    _get_Arry("Angle_Calibration");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if((_Check_Serve(Arry_Data[1],RID,10)&0x1)==1)
    {
       _TestResult(SendData,ID,"",NRC22);
       TestStep_ReadDTC("",Ang_NotCal,1,0,1,1);
    }
    else
      _Check_31Routine_Rx(Arry_Data,1);
    _Set_CarSpd(NRC22_CarSpd-1);
    testWaitForTimeout(1000);
    _get_Arry("Angle_Calibration");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,0,1);
    
    _Set_CarSpd(NRC22_CarSpd+1);
    testWaitForTimeout(1000);
    _get_Arry("Angle_Calibration");
    Arry_Data[4] = 0x02;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _TestResult(SendData,ID,"",NRC22);
    TestStep_ReadDTC("",Ang_NotCal,1,0,0,1);
  }
  else
    _WriteEx_and_Report("","对中与清除对中无NRC22车速条件,跳过检测");
  _Set_CarSpd(0);
}
_31_Serve_40(dword ID,byte Session)/*NRC22-车速无效*/
{
  dword RID;
  _Set_Ready(Struct_Ready.Ready_Active);
  _get_Arry("Angle_Calibration");
  RID = (Arry_Data[2]<<8) + Arry_Data[3];
  if((_Check_Serve(Arry_Data[1],RID,10)&0x1)==1)
  {
    _Set_CarSpd(NRC22_CarSpd+1);
    testWaitForTimeout(1000);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
    _unlockECU();
    _get_Arry("Angle_Calibration");
    Arry_Data[4] = 0x02;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
    testWaitForTimeout(100);
    _get_Arry("Angle_Calibration");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
    testWaitForTimeout(Struct_CarSpd.Invalid_Time+500);
    _unlockECU();
    _get_Arry("Angle_Calibration");
    Arry_Data[4] = 0x02;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
    testWaitForTimeout(100);
    _get_Arry("Angle_Calibration");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
    _Reset_CarSpd_Invalid();
    _Set_CarSpd(0);
  }
  else
    _WriteEx_and_Report("","对中与清除对中无NRC22车速条件,跳过检测");
}

_31_Serve_41_NRC(dword ID,byte Session)  //NRC优先级
{  
  byte Send_Data[100];
  int j;
  int Flage_Error;
  dword Temp_DID;
  char Temp_Str[300];
  int _13_Count;
  
  {
    snprintf(Temp_Str,elCount(Temp_Str),"NRC优先级异常项次: ");
    Send_Data[0] = 0x31;
    for(j=0;j<Serve_31_Hex_Count;j++)
    {
      _13_Count = 0;
      Flage_Error = 0;
      if(Serve_31_Hex[j].Serve_NRC_Special_Count[0] != 0)
        Serve_31_NewNRC22 = 1;
      else
        Serve_31_NewNRC22 = 0;
      Temp_DID = ((Serve_31_Hex[j].Routine[0]<<8) | Serve_31_Hex[j].Routine[1]);
      if(Geely3_Flage == 1 && Session == defsession && Temp_DID != 0x307B && Temp_DID!= 0x0206)
        continue;
      _WriteEx_and_Report("","---------------------------------");
      _WriteEx_and_Report("","   开始测试 0x%04X 优先级",Temp_DID);
      _WriteEx_and_Report("","---------------------------------");
      _Set_NRC_Step(0x31,Temp_DID,Serve_31_Hex[j].Control_Type[0],Send_Data);
      if(Fun_NRC_Count == 0)
      {
        _WriteEx_and_Report("","未输入NRC，跳过测试");
        continue;
      }
      for(i=0;i<=Fun_NRC_Count;i++)
      {
        if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        {
          _Recover_NRC_Step(Fun_NRC[i-1],j,Temp_DID,Send_Data);
        }
        if(i == Fun_NRC_Count)
        {
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",-1);
        }
        else
        {
          if(Fun_NRC[i] == 0x24)  
            Send_Data[1] = 0x03;
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          if(Fun_NRC[i] == 0x31)
            _13_Count++;
          
          if(Serve_31_Len4_5 == 1 && NRC31_total == 2  &&  Fun_NRC[i] == 0x31 && NRC13_total == 1 && _13_Count==1)
            _TestResult(SendData,ID,"",0x13);
          else
            _TestResult(SendData,ID,"",Fun_NRC[i]);
          
          if(diagGetLastResponseCode(SendData) != Fun_NRC[i])
            Flage_Error = 1;
          if(Fun_NRC[i] == 0x24)  
            Send_Data[1] = Serve_31_Hex[j].Control_Type[0];
        }
        testWaitForTimeout(100);
      }
      _WriteEx_and_Report("","---------------------------------");
      _WriteEx_and_Report("","   0x%04X 优先级测试完成",Temp_DID);
      _WriteEx_and_Report("","---------------------------------");
      {
        _WriteEx_and_Report("","进行复位防止前面影响到后续测试");
        _Set_11_Restoration();
        _SetSession(Session);
      }
      if(Flage_Error == 1)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"%s  [ 0x%04X ]",Temp_Str,Temp_DID);
      }
    }
    _WriteEx_and_Report("",Temp_Str);
    Serve_31_NewNRC22 = 0;
  }
}
_31_Serve_41_Chery(dword ID,byte Session)/* 13(min)>31(rid)>33>12>13(total)>22*/
{
  int Fun_Pos;
  _Set_CarSpd(NRC22_CarSpd+1);
  testWaitForTimeout(1000);
  _get_Arry("Pre_Programmed");
  Fun_Pos = _Check_Serve(Arry_Data[1],(Arry_Data[2]<<8)+Arry_Data[3],12);
  Arry_Data[1] = 0x02;
  _Send_Diag(1,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][0]);
  _Send_Diag(6,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][1]);
  _get_Arry("Angle_Calibration");
  Arry_Data[1] = 0x02;
  _Send_Diag(6,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][2]);
  _unlockECU();
  _Send_Diag(6,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][3]);
  Arry_Data[1] = 0x01;
  _Send_Diag(6,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][4]);
  _Send_Diag(7,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][5]);
  Arry_Data[1] = 0x03;
  _Send_Diag(7,ID,Arry_Data);
  _TestResult(SendData,ID,"",NRC24);
}
_31_Serve_41_YunDu(dword ID,byte Session)/* 13>12>33>92>93>88*/
{
  int Fun_Pos;
  _Set_CarSpd(NRC22_CarSpd+1);
  _Set_Battery(NRC22_Battery_Low-0.3);
  _get_Arry("Angle_Calibration");
  Fun_Pos = _Check_Serve(Arry_Data[1],(Arry_Data[2]<<8)+Arry_Data[3],12);
  Arry_Data[1] =0x02;
  _Send_Diag(2,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][0]);
  _Send_Diag(4,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][1]);
  Arry_Data[1] =0x01;
  _Send_Diag(4,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][2]);
  _unlockECU();
  _Send_Diag(4,ID,Arry_Data);
  _TestResult(SendData,ID,"",0x93);
  _Set_Battery(NRC22_Battery_Hight+0.3);
  _Send_Diag(4,ID,Arry_Data);
  _TestResult(SendData,ID,"",0x92);
  _Set_Battery(12);
  _Send_Diag(4,ID,Arry_Data);
  _TestResult(SendData,ID,"",Serve_31_Hex[Fun_Pos].Serve_NRC[0][Serve_31_Hex[Fun_Pos].Serve_NRC_Count[0]-1]);
  _Set_CarSpd(0);
}
_31_Serve_42(dword ID,byte Session)/* 7F>13*/
{
  byte Send_Data[100];
  _Get_31_ServeData(0,Send_Data,0);
  
  _Send_Diag((Serve_31_Hex[0].Routine_Len-1),ID,Send_Data);
