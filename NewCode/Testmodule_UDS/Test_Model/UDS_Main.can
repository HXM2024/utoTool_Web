_19_Serve_13(dword ID,byte Session) /*故障发生时间*/
{
  int Pos_1904;
  byte DTC_H,DTC_M,DTC_L;
  byte mask;
  int i,m;
  char Time_First[50];
  byte Data_Send[6] = {0x19,0x06,0,0,0,0xFF};
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else if(_Check_Serve(0x19,0x06,4)==-1)
    _WriteEx_and_Report("","19服务不支持06子功能");
  else
  {
    Pos_1904 = Get_Node_Pos(Node_1904,1);
    DTC_H = (DTC_19[Pos_1904][1]>>16);
    DTC_M = (DTC_19[Pos_1904][1]>>8);
    DTC_L = (DTC_19[Pos_1904][1]&0xFF);
    Data_Send[2] = DTC_H;
    Data_Send[3] = DTC_M;
    Data_Send[4] = DTC_L;
//    _Set_Ready(0);
    if(_Check_StrPossion_Res("First_Time_Fault_Occurrence_Time",3)!= -1 && _Check_StrPossion_Res("Latest_Time_Fault_Occurrence_Time",3)!= -1)
    {
      int Sw_temp;
      _Set_Ready(Struct_Ready.Ready_Active);
      snprintf(Time_First,elCount(Time_First),"%s","");
      Sw_temp = _Check_StrPossion_Res("LocalTime",1);
      _85_Check_DTC(1,0);
      _Send_Diag(6,ID,Data_Send);
      _Check_19_NoFreeze(SendData,"First_Time_Fault_Occurrence_Time");
      _Set_Ready(0);
      _Step_1904("LocalTime",0); //取第0-3组数据
      snprintf(Time_First,elCount(Time_First),"%s%s",Time_First,mixArray[Sw_temp].LocalTime_Value);
      _Close_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      _Check_1906_Time(SendData,mixArray[Sw_temp].LocalTime_Value,mixArray[Sw_temp].LocalTime_Value);
      _Open_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      _Check_1906_Time(SendData,mixArray[Sw_temp].LocalTime_Value,mixArray[Sw_temp].LocalTime_Value);
      _Step_1904("LocalTime",1); //取第0-3组数据
      _Close_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      _Check_1906_Time(SendData,Time_First,mixArray[Sw_temp].LocalTime_Value);
      _Open_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      _Check_1906_Time(SendData,Time_First,mixArray[Sw_temp].LocalTime_Value);
      _Step_1904("LocalTime",2); //取第0-3组数据
      _Close_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      _Check_1906_Time(SendData,Time_First,mixArray[Sw_temp].LocalTime_Value);
      _Open_One_Node(DTC_19[Pos_1904]);
    }
    else
      _WriteEx_and_Report("First_Time_Fault_Occurrence_Time","该项目内无此测试项");
  }
}
_19_Serve_14(dword ID,byte Session) /*19 0A*/
{
  byte Data_Send[2] = {0x19,0x0a};
  dword DTC_Rx[500];
  dword DTC_in_ALL_DTC[500];
  dword DTC_Repeat[200][2];
  int DTC_Rx_Num;
  dword Byte_H,Byte_M,Byte_L;
  int LenRx,m,SWhere;
  DTC_Rx_Num=0;
  m = 0;
  
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    _Send_Diag_NoTime(2,ID,Data_Send);
    if(testWaitForMessage(Response_ID,50)==1)
      testStepPass("","收到首帧响应时间在50ms内");
    else
      testStepfail("","收到首帧响应时间在50ms外");
    testWaitForDiagResponse(SendData,4000);
    if(diagGetLastResponseCode(SendData)==-1)
    {
      LenRx = DiagGetRespPrimitiveSize(SendData);
      DTC_Rx_Num = (LenRx -3 )/4;
      if(DTC_Rx_Num != ALL_DTC_Num)
        testStepfail("","预期DTC个数与实际DTC个数不等，预期为%d个，实际为%d个",ALL_DTC_Num,DTC_Rx_Num);
      else
        testStepPass("","预期DTC个数与实际DTC个数一致，实际为%d个",ALL_DTC_Num);
      for(i=0;i<DTC_Rx_Num;i++)
      {
        Byte_H = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 0);
        Byte_M = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 1);
        Byte_L = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 2);
        DTC_Rx[i] = Byte_H<<16 | Byte_M<<8 | Byte_L ;
      }
      for(i=0;i<DTC_Rx_Num;i++)
      {
        SWhere = _Check_Dword_in_Num(DTC_Rx[i],ALL_DTC,ALL_DTC_Num);
        DTC_Repeat[i][0] = DTC_Rx[i]; /*装载所有DTC用于重复验证*/
        DTC_Repeat[i][1] = 0;
        if(SWhere == -1)
           testStepFail("","DTC = 0x%X 为非预期DTC",DTC_Rx[i]);
      }
      for(i=0;i<DTC_Rx_Num;i++)
      {
        SWhere = _Check_Dword_in_Num(DTC_Rx[i],DTC_Repeat,DTC_Rx_Num);
        if(SWhere != -1)
          DTC_Repeat[SWhere][1]+=1;
      }
      for(i=0;i<DTC_Rx_Num;i++)
      {
        if(DTC_Repeat[i][1]>1)
        {
          writeEx(-3,0,"DTC 0x%06X 重复",DTC_Repeat[i][0]);
          testStepFail("","获取到重复的DTC 0x%06X",DTC_Repeat[i][0]);
        }
      }
      for(i=0;i<ALL_DTC_Num;i++)
      {
        SWhere = _Check_Dword_in_Num(ALL_DTC[i],DTC_Rx,DTC_Rx_Num);
        if(SWhere == -1)
           testStepFail("","DTC = 0x%X 预期DTC未获取到",ALL_DTC[i]);
        else
          testStepPass("","0x%X 已获取到",ALL_DTC[i]);
      }
    }
    else
      testStepfail("","收到响应时间在4s外");
  }
}
_19_Serve_15(dword ID,byte Session) /*SuppressBit*/
{
  byte Data_Send_1[100];
  int Len;
  int Return_Len;
  int i,Serve_Pos,Pos;
  Serve_Pos = _Check_Serve(0x19,0,0);
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    Pos = Get_Node_Pos(Node_1904,1);
    StepByGeely3_0(0x19,1);
    _Close_One_Node(DTC_19[Pos]);
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Return_Len = _Get_19_ServeData(Data_Send_1,Serve_Data[Serve_Pos].Serve_Fun[i]);
      Data_Send_1[1] = Serve_Data[Serve_Pos].Serve_Fun[i] |0x80;
      _Send_Diag(Return_Len,ID,Data_Send_1);
      if(Serve_Data[Serve_Pos].RSP[i]==0)
        _TestResult(SendData,ID,"",NRC12);
      else
        _TestResult(SendData,ID,"",0);
    }
    _Open_One_Node(DTC_19[Pos]);
  }
}
_19_Serve_16(dword ID,byte Session) /*NRC12*/
{
  byte Data_Send_1[2] = {0x19,0x01};
  int i,Serve_Pos;
  int Len;
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    Serve_Pos = _Check_Serve(0x19,0,0);
    for(i=0;i<=0xff;i++)
    {
      Data_Send_1[1] = i;
      testWaitForTimeout(100);
      if(_Check_Serve(0x19,i,4)!= -1)
        continue;
      else if(_Check_Serve(0x19,(i&0x7F),4)!= -1 && _Check_Serve(0x19,(i&0x7F),9)==1)
        continue;
      Len =6;
      if(i==0x81 || i==0x82 )
        Len = 3;
      else if(i==0x8A)
        Len = 2;
      _Send_Diag(Len,ID,Data_Send_1);
      _TestResult(SendData,ID,"",NRC12);
    }
  }
}
_19_Serve_17(dword ID,byte Session) /*NRC13*/
{
  byte Data_Send_1[3] = {0x19,0x01,0x09};
  byte Data_Send_2[6] = {0x19,0x04,0x0,0x0,0x0,0xFF};
  byte DTC_H,DTC_M,DTC_L;
  int i,j,Len,Serve_Pos;
  Len = _Check_CANFD_Flage();
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    Serve_Pos = _Check_Serve(0x19,0,0);
    DTC_H = (DTC_19[1][1]>>16);
    DTC_M = (DTC_19[1][1]>>8);
    DTC_L = (DTC_19[1][1]&0xFF);
    Data_Send_2[2] = DTC_H;
    Data_Send_2[3] = DTC_M;
    Data_Send_2[4] = DTC_L;
    
    for(j=0;j<Serve_Data[Serve_Pos].Serve_Fun_Count;j++)
    {
      Data_Send_1[1] = Serve_Data[Serve_Pos].Serve_Fun[j];
      Data_Send_2[1] = Serve_Data[Serve_Pos].Serve_Fun[j];
      for(i=1;i<=Len;i++)
      {
        if(Data_Send_1[1] == 0x01 || Data_Send_1[1] == 0x02)
        {
          if(i==3)
            continue;
          _Send_Diag(i,ID,Data_Send_1);
          _TestResult(SendData,ID,"",NRC13);
        }
        else if(Data_Send_1[1] == 0x04 || Data_Send_1[1] == 0x06)
        {
          if(i==6)
            continue;
          _Send_Diag(i,ID,Data_Send_2);
          _TestResult(SendData,ID,"",NRC13);
        }
        else
        {
          if(i==2)
            continue;
          _Send_Diag(i,ID,Data_Send_2);
          _TestResult(SendData,ID,"",NRC13);
        }
      }
    }
  }
}
_19_Serve_18(dword ID,byte Session) /*NRC31*/
{
  byte Data_Send_1[6] = {0x19,0x04,0x0,0x0,0x0,0xFF};
  qword Ex_Data_Record_Num[30];
  byte DTC_H,DTC_M,DTC_L;
  dword Range;
  dword i,j,m,n;
  int k,Serve_Pos,Fun_Pos;
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    DTC_H = (DTC_19[0][1]>>16);
    DTC_M = (DTC_19[0][1]>>8);
    DTC_L = (DTC_19[0][1]&0xFF);
    _Close_One_Node(DTC_19[0]);
    Serve_Pos = _Check_Serve(0x19,0x06,0);
    Fun_Pos = _Check_Serve(0x19,0x06,4);
    if(Fun_Pos == -1)
      k = 1;
    else
      k = 2;
    for(j=0;j<k;j++)
    {
      if(j==0)
        Data_Send_1[1] = 0x04;
      else
        Data_Send_1[1] = 0x06;
      for(i=0;i<=255;i++)
      {
        do{
          Range = random(0xFFFFFE);
        }while(Range<(DTC_H) || ( _Check_Dword_in_Num(Range,ALL_DTC,ALL_DTC_Num)!=-1));
        Data_Send_1[2] = (Range>>16);
        Data_Send_1[3] = (Range>>8);
        Data_Send_1[4] = (Range&0xFF);
        if(j==0)
        {
          Data_Send_1[5] = 0x01;
          _Send_Diag(6,ID,Data_Send_1);
          _TestResult(SendData,ID,"",NRC31);
          testWaitForTimeout(20);
        }
        Data_Send_1[5] = 0xff;
        _Send_Diag(6,ID,Data_Send_1);
        _TestResult(SendData,ID,"",NRC31);
        testWaitForTimeout(20);
      }
      Data_Send_1[2] = DTC_H;
      Data_Send_1[3] = DTC_M;
      Data_Send_1[4] = DTC_L;
      if(j==1)
      {
        n=1;
        for(m=0;m<Serve_Data[Serve_Pos].Serve_Para_Count[Fun_Pos];m++)
        {
          if(Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][m]==1)
            continue;
          Ex_Data_Record_Num[n] = Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][m];
          n++;
        }
        Ex_Data_Record_Num[0] = 1;
      }
      for(i=0;i<0xff;i++)
      {
        if(j==0)
        {
          if(_Check_Dword_in_Num(i,Freeze_Frame_Number,Freeze_Frame_Number_Count)!=-1)
            continue;
        }
        else
        {
          if(_Check_Dword_in_Num(i,Ex_Data_Record_Num,n)!=-1)
            continue;
        }
        Data_Send_1[5] = i;
        _Send_Diag(6,ID,Data_Send_1);
        _TestResult(SendData,ID,"",NRC31);
      }
      _Open_One_Node(DTC_19[0]);
    }
  }
}
_19_Serve_19(dword ID,byte Session) /*19 01/02*/
{
  byte Data_Send_1[3] = {0x19,0x01,0x0};
  byte Data_Send_2[3] = {0x19,0x02,0x0};
