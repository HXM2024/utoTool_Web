  for(Time=0;Time<1000;Time=Time+5)
  {
    MsgFlage = 0;
    DiagFlage = 0;
    _SetSession(exsession);
    _Send_Key_NoResponse(SendKey_Len,phyreq_ID,_get_seed(phyreq_ID),1);
    Get_Seed_Flage = 1;
    if(Time == 0)
      Time = 1;
    testWaitForTimeout(Time);
    _WriteEx_and_Report("","等待 %d ms",Time);
    _Power_Down_();
    testWaitForTimeout(1000);
    _Power_Up_();
    testWaitForTimeout(2000);
    if(Time == 1)
      Time = Time -1;
    _Send_Diag(3,phyreq_ID,Send_19);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,1000);
    if(diagGetLastResponseCode(SendData) != -1 )
    {
      DiagFlage = -1;
      testStep("","19服务响应异常,当前时间为 %d ms",Time);
    }
    MsgFlage = _Check_EPS_TX(1,EPS_TxID_1);
    if(MsgFlage == -1 && DiagFlage == -1)
    {
      testStepFail("","当前APP异常,等待时间为 %d ms",Time);
      {
        /*新增判断，当出现APP异常时，需要判断返回APP后再看是否正常*/
        _SetSession(defsession);
        testWaitForTimeout(2000);
        _Send_Diag(3,phyreq_ID,Send_19);
        if(diagGetLastResponseCode(SendData) == 0)
          testWaitForDiagResponse(SendData,1000);
        if(diagGetLastResponseCode(SendData) != -1 )
          break;
      }
    }
    
    _SetSession(exsession);
    _Send_Key_NoResponse(SendKey_Len,phyreq_ID,_get_seed(phyreq_ID),0);
    if(Time == 0)
      Time = 1;
    testWaitForTimeout(Time);
    _WriteEx_and_Report("","等待 %d ms",Time);
    _Power_Down_();
    testWaitForTimeout(1000);
    _Power_Up_();
    testWaitForTimeout(2000);
    if(Time == 1)
      Time = Time -1;
    _Send_Diag(3,phyreq_ID,Send_19);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,1000);
    if(diagGetLastResponseCode(SendData) != -1 )
    {
      DiagFlage = -1;
      testStep("","19服务响应异常,当前时间为 %d ms",Time);
    }
    MsgFlage = _Check_EPS_TX(1,EPS_TxID_1);
    if(MsgFlage == -1 && DiagFlage == -1)
    {
      testStepFail("","当前APP异常,等待时间为 %d ms",Time);
      {
        /*新增判断，当出现APP异常时，需要判断返回APP后再看是否正常*/
        _SetSession(defsession);
        testWaitForTimeout(2000);
        _Send_Diag(3,phyreq_ID,Send_19);
        if(diagGetLastResponseCode(SendData) == 0)
          testWaitForDiagResponse(SendData,1000);
        if(diagGetLastResponseCode(SendData) != -1 )
          break;
      }
    }
  }
}

void _APP_Valid_Serve_Other()
{
  byte Send_19[3] = {0x19,0x02,0x01};
  byte Data_Send[4];
  byte Len[5] = {4,3,3,3,2};
  int i,Time,Flage;
  int Pos_28,Pos_85,MsgFlage,DiagFlage;
  
  Pos_28 = _Check_Serve(0x28,0,0);
  Pos_85 = _Check_Serve(0x85,0,0);
  _Set_Ready(0);
  testWaitForTimeout(500);
  for(Time=0;Time<1000;Time=Time+5)
  {
    if(Flage == 0)
    {
      for(i=0;i<5;i++)
      {
        if(i==0)
        {
          Data_Send[0] = 0x14; Data_Send[1] = 0xFF;
          Data_Send[2] = 0xFF; Data_Send[3] = 0xFF;
        }
        else if(i==1)
        {
          Data_Send[0] = 0x19; Data_Send[1] = 0x02;
          Data_Send[2] = 0x89; 
        }
        else if(i==2)
        {
          Data_Send[0] = 0x22; Data_Send[1] = 0x35;
          Data_Send[2] = 0x70; 
        }
        else if(i==3)
        {
          Data_Send[0] = 0x28; Data_Send[1] = Serve_Data[Pos_28].Serve_Fun[0];
          Data_Send[2] = Serve_Data[Pos_28].Serve_Para[0][0]; 
        }
        else if(i==4)
        {
          Data_Send[0] = 0x85; Data_Send[1] = Serve_Data[Pos_85].Serve_Fun[0];
        }
        MsgFlage = 0;
        DiagFlage = 0;
        if(i>2)
          _SetSession(exsession);
        _Send_Diag_NoTime(Len[i],phyreq_ID,Data_Send);
        if(Time == 0)
          Time = 1;
        testWaitForTimeout(Time);
        _WriteEx_and_Report("","等待 %d ms",Time);
        _Power_Down_();
        testWaitForTimeout(1000);
        _Power_Up_();
        testWaitForTimeout(2000);
        if(Time == 1)
          Time = Time -1;
        _Send_Diag(3,phyreq_ID,Send_19);
        if(diagGetLastResponseCode(SendData) == 0)
          testWaitForDiagResponse(SendData,1000);
        if(diagGetLastResponseCode(SendData) != -1 )
        {
          DiagFlage = -1;
          testStep("","19服务响应异常,当前时间为 %d ms",Time);
        }
        MsgFlage = _Check_EPS_TX(1,EPS_TxID_1);
        if(MsgFlage == -1 && DiagFlage == -1)
        {
          testStepFail("","当前APP异常,等待时间为 %d ms",Time);
          {
            /*新增判断，当出现APP异常时，需要判断返回APP后再看是否正常*/
            _SetSession(defsession);
            testWaitForTimeout(2000);
            _Send_Diag(3,phyreq_ID,Send_19);
            if(diagGetLastResponseCode(SendData) == 0)
              testWaitForDiagResponse(SendData,1000);
            if(diagGetLastResponseCode(SendData) != -1 )
              break;
          }
        }
      }
    }
  }
}

void _Geely1_0_NRC22_Test()
{
  byte Send_1101[2] = {0x11,0x01};
  byte Send_1103[2] = {0x11,0x03};
  byte Send_1002[2] = {0x10,0x02};
  byte Send_85[2] = {0x85,0x01};
  byte Send_28[3] = {0x28,0x00,0X01};
  byte Send_14[4] = {0x14,0xFF,0xFF,0xFF};
  _TestDisableMsg(Struct_Ready.Sig_Id);
  testWaitForTimeout(1000);
  _SetSession(exsession);
  _Send_Diag(2,phyreq_ID,Send_1101);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(700);
  _SetSession(exsession);
  _Send_Diag(2,phyreq_ID,Send_1002);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
  _SetSession(defsession);
  testWaitForTimeout(2000);
  _SetSession(exsession);
  _Send_Diag(2,phyreq_ID,Send_1103);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(700);
  _SetSession(exsession);
  _Send_Diag(2,phyreq_ID,Send_1101);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(700);
  _Send_Diag(4,phyreq_ID,Send_14);
  _TestResult(SendData,phyreq_ID,"",-1);
  _SetSession(exsession);
  _Send_Diag(2,phyreq_ID,Send_1101);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(700);
  _SetSession(exsession);
  _Send_Diag(3,phyreq_ID,Send_28);
  _TestResult(SendData,phyreq_ID,"",-1);
  _SetSession(exsession);
  _Send_Diag(2,phyreq_ID,Send_1103);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(700);
  _SetSession(exsession);
  _Send_Diag(2,phyreq_ID,Send_85);
  _TestResult(SendData,phyreq_ID,"",-1);
  _TestEnableMsg(Struct_Ready.Sig_Id);
}

void _Interrupt_10H()
{
  byte Data_Send[2] = {0x10,0x02};
  _SetSession(exsession);
  _Other_1002();
  _Send_Diag_3E80_After_NRC78(elcount(Data_Send),phyreq_ID,Data_Send);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000);
  _SetSession(defsession);
  testWaitForTimeout(2000);
}

void _Interrupt_11H()
{
  int Serve_Pos,i;
  Byte Send_Data_11[2];
  Serve_Pos = _Check_Serve(0x11,0,0);
  Send_Data_11[0] = 0x11;
  for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
  {
    Send_Data_11[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
    _SetSession(exsession);
    if(Serve_Data[Serve_Pos].Security_Access[i] == 1)
      _unlockECU();
    _Send_Diag_3E80_After_NRC78(elcount(Send_Data_11),phyreq_ID,Send_Data_11);
    _TestResult(SendData,phyreq_ID,"",-1);
    testWaitForTimeout(2000);
  }
}

void _Interrupt_14H()
{
  int Serve_Pos,i;
  Byte Send_Data_14[4] = {0x14,0xFF,0xFF,0xFF};

  if((_Set_NRC22(0x14,0,2)&0x20) != 0)
  {
    float Ready_Now;
    Ready_Now = _Get_Ready();
    if(Ready_Now == Ready_NRC22)
    {
      if(Ready_NRC22 == 0)
        _Set_Ready(Struct_Ready.Ready_Active);
      else
        _Set_Ready(0);
    }
  }
  _Send_Diag_3E80_After_NRC78(elcount(Send_Data_14),phyreq_ID,Send_Data_14);
  _TestResult(SendData,phyreq_ID,"",-1);
}

void _Interrupt_27H()
{
  _SetSession(exsession);
  _Send_Key_NRC78(SendKey_Len,phyreq_ID,_get_seed_NRC78(phyreq_ID),0);
  testWaitForTimeout(2000);
  _SetSession(exsession);
  _Send_Key_NRC78(SendKey_Len,phyreq_ID,_get_seed_NRC78(phyreq_ID),0);
}

void _Interrupt_2EH()
{
  int i;
  _get_Str_Traversal("DID_2E_Traversal");
  for(i=0;i<Traversal_Count;i++)
  {

    _SetSession(defsession);
    testWaitForTimeout(200);
    _unlockECU();
    _get_2E_DID(Traversal_DID[i]);
    writeEx(-3,0,"0x%02X  0x%02X",DID_2E_SendData_1[1],DID_2E_SendData_1[2]);
    _Send_Diag_3E80_After_NRC78(DID_2E_SendData_1_Len,phyreq_ID,DID_2E_SendData_1);
    _TestResult(SendData,phyreq_ID,"",-1);
    testWaitForTimeout(200);
  }
}

void _Interrupt_31H()
{
  int i;
  byte Send_Data_31[10];
  _SetSession(exsession);
  _unlockECU();
  Send_Data_31[0] = 0x31;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    Send_Data_31[2] = Serve_31_Hex[i].Routine[0];
    Send_Data_31[3] = Serve_31_Hex[i].Routine[1];
    Send_Data_31[1] = Serve_31_Hex[i].Control_Type[0];
    if(Serve_31_Hex[i].Routine_Len==5)
      Send_Data_31[4] = Serve_31_Hex[i].Control_Option[0][0];
    _Send_Diag_3E80_After_NRC78(Serve_31_Hex[i].Routine_Len,phyreq_ID,Send_Data_31);
    _TestResult(SendData,phyreq_ID,"",-1);
    testWaitForTimeout(500);
  }
}

void _10_Phy_Def_01(dword ID)
{
  byte Send_Data[2]={0x10,0x01};
  byte Serve_27[2] = {0x27,0x01};
  Serve_27[1] = RequestSeed_27;
  if( Serve_10_01_Time_Flage == 0 )
  {
    _Send_Diag(2,ID,Send_Data);
    testWaitForDiagResponse(SendData,p2cmax);
    _TestResult(SendData,ID,"",-1);
    _Send_Diag(2,phyreq_ID,Serve_27);
    _TestResult(SendData,phyreq_ID,"",NRC7F);
    _Send_And_Check_NowSession(ID,defsession);
  }
  else
  {
    _Send_Diag_NoTime(2,ID,Send_Data);
    _Check_10_01(6,Send_Data[1],P2can_server,P2_can_server);
    _Send_Diag(2,phyreq_ID,Serve_27);
    _TestResult(SendData,phyreq_ID,"",NRC7F);
    _Send_And_Check_NowSession(ID,defsession);
  }
}
void _10_Phy_Def_02(dword ID,dword Session)
{
  byte Temp_0[2]={0x10,0x2};
  byte Temp_14[4]={0x14,0xff,0xff,0xff};
  
  if(_Check_Serve(0x10,0x02,4)==-1) //子功能不支持
  {
    _Send_Diag(2,ID,Temp_0);
    _TestResult(SendData,ID,"",NRC12);
    _Send_Diag(4,phyreq_ID,Temp_14);
    _TestResult(SendData,ID,"",-1);
    _Send_And_Check_NowSession(ID,Session);
  }
  else
  {
    if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
    {
      _Other_1002();
      _Send_Diag(2,ID,Temp_0);
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      testWaitForTimeout(2000);/*进入10 02 后需延时1S防止无响应问题*/
      _Send_Diag(4,phyreq_ID,Temp_14);
      _TestResult(SendData,phyreq_ID,"",NRC11);
      _Send_And_Check_NowSession(ID,2);
      _SetSession(defsession); // 退出10 02
    }
    else
    {
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",NRC7E);
      _Send_Diag(4,phyreq_ID,Temp_14);
      _TestResult(SendData,phyreq_ID,"",-1);
      _Send_And_Check_NowSession(ID,Session);
    }
  }
}
