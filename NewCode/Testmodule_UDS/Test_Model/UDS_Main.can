  _unlockECU();
  _get_Arry("Angle_Calibration");
  Arry_Data[1] = 0X01;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  Arry_Data[1] = 0X03;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  for(i=0;i<=0xFF;i++)
  {
    Arry_Data[1] = i;
    if(i==1 || i==3)
      continue;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _TestResult(SendData,ID,"",NRC12);
  }
}
