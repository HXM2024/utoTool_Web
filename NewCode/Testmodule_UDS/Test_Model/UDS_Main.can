_27_Serve_02(dword ID,byte Session) /*支持的子功能*/
{
  byte Temp[2]={0x27,0x00};
  _WriteEx_and_Report("","检测安全访问");
  _unlockECU();
  if(APP_BT_27_Flage==1)
  {
    _WriteEx_and_Report("","BT与APP不一致，检测APP下请求BT支持的子功能");
    DiagSetPrimitiveByte(reqseed,1,BT_RequestSeed_27);
    DiagSetPrimitiveByte(sendkey,1,BT_SendKey_27);
    _SendAndWriteReport(reqseed,ID);
    if(diagGetLastResponseCode(reqseed) == 0x7E)
      _TestResult(reqseed,ID,"",NRC7E);
    else
      _TestResult(reqseed,ID,"",NRC12);
    _SendAndWriteReport(sendkey,ID);
    if(diagGetLastResponseCode(sendkey) == 0x7E)
      _TestResult(sendkey,ID,"",NRC7E);
    else
      _TestResult(sendkey,ID,"",NRC12);
  }
  DiagSetPrimitiveByte(reqseed,1,RequestSeed_27);
  DiagSetPrimitiveByte(sendkey,1,SendKey_27);
  Temp[1] = RequestSeed_27;
  if(_Check_Serve(0x27,RequestSeed_27,9)==1)
  {
    _WriteEx_and_Report("","当支持肯定响应抑制位时检测返回结果");
    DiagSetPrimitiveByte(reqseed,1,RequestSeed_27|0x80);
    DiagSetPrimitiveByte(sendkey,1,SendKey_27|0x80);
    _SendAndWriteReport(sendkey,ID);
    _TestResult(sendkey,ID,"",NRC24);
    _SendAndWriteReport(reqseed,ID);
    _Check_NoResponse(reqseed);
    _SendAndWriteReport(sendkey,ID);
    _TestResult(sendkey,ID,"",NRC24);
  }
  else if(_Check_Serve(0x27,RequestSeed_27,9)==0)
  {
    _WriteEx_and_Report("","不支持肯定响应抑制位时检测返回结果");
    DiagSetPrimitiveByte(reqseed,1,RequestSeed_27|0x80);
    DiagSetPrimitiveByte(sendkey,1,SendKey_27|0x80);
    _SendAndWriteReport(sendkey,ID);
    _TestResult(sendkey,ID,"",NRC12);
    _SendAndWriteReport(reqseed,ID);
    _TestResult(sendkey,ID,"",NRC12);
    _SendAndWriteReport(sendkey,ID);
    _TestResult(sendkey,ID,"",NRC12);
  }
}
