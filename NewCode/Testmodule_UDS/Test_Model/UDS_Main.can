    Data_Send[2] = DTC_H;
    Data_Send[3] = DTC_M;
    Data_Send[4] = DTC_L;
    
    if(_Check_StrPossion_Res("DTC_Aging_counter",3)!= -1)
    {
      if(DTC_Aging_Counter_Clear == 1)
      {
        _85_Check_DTC(1,0);
        _Close_One_Node(DTC_19[Pos_1904]);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",0);
        _Open_One_Node(DTC_19[Pos_1904]);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",0);
        _Set_Ready(0);_K15_OFF();
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();_Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(1000);
        testWaitForTimeout(CAN_Init_Time);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",0);
        _K15_OFF();_Set_Ready(0);
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();_Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(1000);
        testWaitForTimeout(CAN_Init_Time);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",1);
        _Close_One_Node(DTC_19[Pos_1904]);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",0);
        _Open_One_Node(DTC_19[Pos_1904]);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",0);
        _K15_OFF();_Set_Ready(0);
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();_Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(1000);
        testWaitForTimeout(CAN_Init_Time);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",0);
        _K15_OFF();_Set_Ready(0);
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();_Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(1000);
        testWaitForTimeout(CAN_Init_Time);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",1);
        _Set_Ready(0);
        for(i=1;i<DTC_Aging_counter_max;i++)
        {
          _WriteEx_and_Report("","当前已上下电次数 %d",i);
          _K15_OFF();
          testWaitForTimeout(K15_OFF_Time);
          _K15_ON();
          testWaitForTimeout(CAN_Init_Time);
          _Send_Diag(6,ID,Data_Send);
          _Check_1906(SendData,"DTC_Aging_counter",i+1);
        }
        _K15_OFF();
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();
        testWaitForTimeout(1000);
        testWaitForTimeout(CAN_Init_Time);
        _Send_Diag(6,ID,Data_Send);
        _Check_19_NoFreeze(SendData,"DTC_Aging_counter");
      }
      else
      {
        dword Value;
        _WriteEx_and_Report("","老化计数器无法被14服务清零,此处验证次数能够正常叠加");
        _85_Check_DTC(1,0);
        _Close_One_Node(DTC_19[Pos_1904]);
        _Send_Diag(6,ID,Data_Send);
        Value = _Get_1906_(SendData,"DTC_Aging_counter");
        _Open_One_Node(DTC_19[Pos_1904]);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",Value);
        _K15_OFF();_Set_Ready(0);
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();_Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(1000);
        testWaitForTimeout(CAN_Init_Time);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",Value);
        _Set_Ready(0);
        _K15_OFF();
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();
        testWaitForTimeout(1000);
        testWaitForTimeout(CAN_Init_Time);
        _Send_Diag(6,ID,Data_Send);
        _Check_1906(SendData,"DTC_Aging_counter",Value);
        _Close_One_Node(DTC_19[Pos_1904]);
        _Send_Diag(6,ID,Data_Send);
