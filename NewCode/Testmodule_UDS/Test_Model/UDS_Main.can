  {
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
  }
  testWaitForTimeout(100);
  _get_Arry("Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  RID = (Arry_Data[2]<<8) + Arry_Data[3];
  if((_Check_Serve(Arry_Data[1],RID,10)&0x2)==2)
    _TestResult(SendData,ID,"",NRC22);
  else
  {
    _Check_31Routine_Rx(Arry_Data,1);
     TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
  }
  _Set_Battery(NRC22_Battery_Hight-0.2);
  _get_Arry("Pre_Programmed");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  _get_Arry("Angle_Calibration");
  Arry_Data[4] = 0x02;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
  testWaitForTimeout(100);
  _get_Arry("Angle_Calibration");
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_31Routine_Rx(Arry_Data,1);
  TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
  
  _Set_Battery(12);
}
_31_Serve_37(dword ID,byte Session)/*NRC22-退工厂模式力矩*/
{
  char str[200];
  dword RID;
  byte Temp_1[6]={0x2E,0x01,0x00,0x01,0x00,0x00};
  int i;
  _SetSession(exsession);
  _unlockECU();
  _Send_Diag(6,ID,Temp_1);
  _TestResult(SendData,ID,"",-1);
  
  /*出现部分长安项目需要重启进入工厂模式才能生效*/
  _Set_11_Restoration();
  _SetSession(exsession);
  _unlockECU();
  
  for(i=0;i<2;i++)
  {
    _get_Arry("Pre_Programmed");
    snprintf(str,elCount(str),"%s","");
    if(i==0)
      snprintf(str,elCount(str),"控制力矩满足NRC22条件,大于 %.2f Nm,并保持",NRC22_TasTorque+0.2);
    else
      snprintf(str,elCount(str),"控制力矩满足NRC22条件,大于 %.2f Nm,并保持",(NRC22_TasTorque+0.2)*(-1));
    testWaitForTesterConfirmation(str,30000);
    _Send_Diag(Arry_Len,ID,Arry_Data);
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if((_Check_Serve(Arry_Data[1],RID,10)&0x4)==4)
      _TestResult(SendData,ID,"",NRC22);
    else
      _TestResult(SendData,ID,"",-1);
    _get_Arry("Angle_Calibration");
    Arry_Data[4] = 0x02;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if((_Check_Serve(Arry_Data[1],RID,10)&0x4)==4)
    {
      _TestResult(SendData,ID,"",NRC22);
      TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
    }
    else
    {
      _Check_31Routine_Rx(Arry_Data,1);
      TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
    }
    testWaitForTimeout(100);
    _get_Arry("Angle_Calibration");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    RID = (Arry_Data[2]<<8) + Arry_Data[3];
    if((_Check_Serve(Arry_Data[1],RID,10)&0x4)==4)
      _TestResult(SendData,ID,"",NRC22);
    else
    {
      _Check_31Routine_Rx(Arry_Data,1);
      TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
    }
    snprintf(str,elCount(str),"%s","");
    if(i==0)
      snprintf(str,elCount(str),"控制力矩不满足NRC22条件,小于 %.2f Nm,并保持",NRC22_TasTorque-0.2);
    else
      snprintf(str,elCount(str),"控制力矩不满足NRC22条件,小于 %.2f Nm,并保持",(NRC22_TasTorque-0.2)*(-1));
    testWaitForTesterConfirmation(str,30000);
    _get_Arry("Pre_Programmed");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    _get_Arry("Angle_Calibration");
    Arry_Data[4] = 0x02;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,1,0);
    testWaitForTimeout(100);
    _get_Arry("Angle_Calibration");
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    TestStep_ReadDTC("",Ang_NotCal,1,0,0,0);
  }
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"松开方向盘");
  testWaitForTesterConfirmation(str,30000);
}
