_28_Serve_17(dword ID,byte Session)/*  车速-NRC22 */
{
  byte Temp_1[3] = {0x28,0x03,0x03};
  int Serve_Pos,i,j;
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,Session) == 1)
  {
    if((_Set_NRC22(0x28,Serve_Data[Serve_Pos].Serve_Fun[0],2) & 1 )!= 0)
    {
      for(j=0;j<2;j++)
      {
        for(i=0;i<2;i++)
        {
          if(i==0 && j==0)
          {}
          else
          {
            _SetSession(Session);
            testWaitForTimeout(500);
          }
          Temp_1[1] = 0x00;
          if(i == 0)
            Temp_1[1] = 0x03;
          if(j==1)
            Temp_1[1] = (Temp_1[1] | 0x80);
          _Set_CarSpd(NRC22_CarSpd+1);
          testWaitForTimeout(500);
          _Send_Diag(3,ID,Temp_1);
          _TestResult(SendData,ID,"",NRC22);
          _Set_CarSpd(NRC22_CarSpd);
          testWaitForTimeout(500);
          _Send_Diag(3,ID,Temp_1);
          if(j==0)
            _TestResult(SendData,ID,"",-1);
          else
            _TestResult(SendData,ID,"",0);
          _TestDisableMsg(Struct_CarSpd.Sig_Id);
          testWaitForTimeout(Struct_CarSpd.Lost_Time*1.2);
          _Send_Diag(3,ID,Temp_1);
          if(j==0)
            _TestResult(SendData,ID,"",-1);
          else
            _TestResult(SendData,ID,"",0);
          _TestEnableMsg(Struct_CarSpd.Sig_Id);
          testWaitForTimeout(1000);
          _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
          _Send_Diag(3,ID,Temp_1);
          if(j==0)
            _TestResult(SendData,ID,"",-1);
          else
            _TestResult(SendData,ID,"",0);
          _Reset_CarSpd_Invalid();
          _SetSession(defsession);
          testWaitForTimeout(1000);
        }
      }
    }
    else
      _WriteEx_and_Report("","NRC22无车速条件");
  }
  else
    _WriteEx_and_Report("","当前寻址或会话不支持该服务");
}
_28_Serve_18(dword ID,byte Session)/*  档位-NRC22 */
{
  byte Temp_1[3] = {0x28,0x03,0x03};
  int Serve_Pos,i,j;
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,Session) == 1)
  {
    if((_Set_NRC22(0x28,Serve_Data[Serve_Pos].Serve_Fun[0],2) & 0x08 )!= 0)
    {
      for(i=0;i<2;i++)
      {
        if(i==1 && Session != defsession)
          _SetSession(Session);
        testWaitForTimeout(500);
        Temp_1[1] = 0x00;
        if(i == 0)
          Temp_1[1] = 0x03;
        if(strlen(Gears_Signal) == 0)
        {
          _WriteEx_and_Report("","未收到正确的档位信号,跳过测试");
          return;
        }
        if(NRC_22_Gears_Range[0]==0 && NRC_22_Gears_Range[1] == 0 && NRC_22_Gears_Normal==0)
        {
          _WriteEx_and_Report("","未收到正确的档位范围,跳过测试");
          return;
        }
        for(j=NRC_22_Gears_Range[0];j<=NRC_22_Gears_Range[1];j++)
        {
          _Set_Gears(j);
          testWaitForTimeout(500);
          if(j==NRC_22_Gears_Normal)
          {
            _Send_Diag(3,ID,Temp_1);
            _TestResult(SendData,ID,"",-1);
            _SetSession(defsession);
            testWaitForTimeout(500);
            if(Session != defsession)
            {
              _SetSession(Session);
              testWaitForTimeout(500);
            }
          }
          else
          {
            _Send_Diag(3,ID,Temp_1);
            _TestResult(SendData,ID,"",NRC22);
          }
        }
        _TestDisableMsg(Gears_ID);
        testWaitForTimeout(1000);
        _Send_Diag(3,ID,Temp_1);
        _TestResult(SendData,ID,"",-1);
        _TestEnableMsg(Gears_ID);
        testWaitForTimeout(1000);
        _SetSession(defsession);
        testWaitForTimeout(1000);
      }
      _Set_Gears(NRC_22_Gears_Normal);
    }
    else
      _WriteEx_and_Report("","NRC22无档位条件");
  }
  else
    _WriteEx_and_Report("","当前寻址或会话不支持该服务");
}
_28_Serve_19(dword ID,byte Session)/*  发动机-NRC22 */
{
  byte Temp_1[3] = {0x28,0x03,0x03};
  int Serve_Pos,i,j;
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,Session) == 1)
  {
    if((_Set_NRC22(0x28,Serve_Data[Serve_Pos].Serve_Fun[0],2) & 0x20 )!= 0)
    {
      Temp_1[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
      Temp_1[2] = Serve_Data[Serve_Pos].Serve_Para[0][0];
      _Set_Ready(Struct_Ready.Ready_Active);
      testWaitForTimeout(1000);
      _Send_Diag(3,ID,Temp_1);
      _TestResult(SendData,ID,"",NRC22);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Send_Diag(3,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Send_Diag(3,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.5);
      _Set_Ready(0);
      testWaitForTimeout(1000);
    }
    else
      _WriteEx_and_Report("","NRC22无发动机条件");
  }
  else
    _WriteEx_and_Report("","当前寻址或会话不支持该服务");
}

_28_Serve_20(dword ID,byte Session)/* 通讯立即停止验证 */
{
  byte Send_Data[5];
  int Serve_Pos,i,j,max_count,Rsp;
  byte DataSave[2] = {0x01,0x03};
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,Session)==1)
  {
    Send_Data[0] = 0x28;
    for(i=0;i<elcount(DataSave);i++)
    {
      if(_Check_Serve(0x28,DataSave[i],4) !=-1)
      {
        max_count = (_Check_Serve(0x28,DataSave[i],9)==0)?1:2;
        for(j=0;j<max_count;j++)
        {
          Rsp = (j==0)?-1:0;
          Send_Data[1] = (j==0) ? DataSave[i]:(DataSave[i]|0x80);
          Send_Data[2] = 0x03;
          _Send_Diag(3,ID,Send_Data);
          _TestResult(SendData,ID,"",Rsp);
          if(Wait_28H_Tx_Time != 0)
          {
            _WriteEx_and_Report("","等待 %d ms",Wait_28H_Tx_Time);
            testWaitForTimeout(Wait_28H_Tx_Time);
          }
          _Check_EPS_TX(0,EPS_TxID_1);
          testWaitForTimeout(1000);
          _SetSession(defsession);
          testWaitForTimeout(500);
          _SetSession(Session);
          testWaitForTimeout(1000);
        }
      }
    }
  }
  else
    _WriteEx_and_Report("","当前寻址或会话不支持");
}

_28_Serve_21(dword ID,byte Session)/* 异常断电后功能实现正常 */
{
  byte Send_Data[5];
  int Serve_Pos,i,j,max_count,Rsp;
  byte DataSave[3] = {0x01,0x02,0x03};
  char Str[200];
  byte Date_Fun;
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,Session)==1)
  {
    _get_28_Case();
    _get_Arry("Read_SigValue");
    Send_Data[0] = 0x28;
    for(i=0;i<elcount(DataSave);i++)
    {
      if(_Check_Serve(0x28,DataSave[i],4) !=-1)
      {
        max_count = (_Check_Serve(0x28,DataSave[i],9)==0)?1:2;
        for(j=0;j<max_count;j++)
        {
          Rsp = (j==0)?-1:0;
          Send_Data[1] = (j==0) ? DataSave[i]:(DataSave[i]|0x80);
          Send_Data[2] = 0x03;
          snprintf(Str,elCount(Str),"/*---------当前测试：0x28 0x%02X 0x03---------*/",Send_Data[1]);
          _WriteEx_and_Report("",Str);
        
          _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_1);
          testWaitForTimeout(500);
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          _Check_Return(1);
          _Check_EPS_TX(1,EPS_TxID_1);
          _Send_Diag(3,ID,Send_Data);
          _TestResult(SendData,ID,"",Rsp);
          testWaitForTimeout(Wait_28H_Time);
          _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2);
          testWaitForTimeout(500);
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          Date_Fun = (Send_Data[1]&0x0F) ;
          if(Date_Fun == 1)
          {
            _Check_Return(2);_Check_EPS_TX(0,EPS_TxID_1);
          }
          else if(Date_Fun == 2)
          {
            _Check_Return(1);_Check_EPS_TX(1,EPS_TxID_1);
          }
          else if(Date_Fun == 3)
          {
            _Check_Return(1);_Check_EPS_TX(0,EPS_TxID_1);
          }

          _K30_OFF();
          testWaitForTimeout(2000);
          _K30_ON();
          testWaitForTimeout(2000);
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          _Check_Return(2);
          _Check_EPS_TX(1,EPS_TxID_1);

          _SetSession(Session);
          testWaitForTimeout(1000);
          _Send_Diag(3,ID,Send_Data);
          _TestResult(SendData,ID,"",Rsp);
          testWaitForTimeout(Wait_28H_Time);
          _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2+5);
          testWaitForTimeout(500);
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          if(Date_Fun == 1)
          {
            _Check_Return(3);_Check_EPS_TX(0,EPS_TxID_1);
          }
          else if(Date_Fun == 2)
          {
            _Check_Return(2);_Check_EPS_TX(1,EPS_TxID_1);
          }
          else if(Date_Fun == 3)
          {
            _Check_Return(2);_Check_EPS_TX(0,EPS_TxID_1);
          }

          testWaitForTimeout(1000);
          _SetSession(defsession);
          testWaitForTimeout(500);
          _SetSession(Session);
          testWaitForTimeout(1000);
        }
      }
    }
  }
  else
    _WriteEx_and_Report("","当前寻址或会话不支持");
}

void _Serve28_21(dword ID,byte Session)/*  NRC22-吉利3.0*/
{
  byte Send_Data_01[3] = {0x28,0x00,0x01};
  char Serve_85_CarSpdQFTemp[10];
  byte Serve_85_CarSpdQF[10];
  int Serve_85_CarSpdQF_Count;
  int i,j;
  Serve_85_CarSpdQF_Count = getProfileArray(ECU_project,"Serve_85_CarSpdQF",Serve_85_CarSpdQFTemp,elCount(Serve_85_CarSpdQFTemp),file_name_1);
  for(i=0;i<Serve_85_CarSpdQF_Count;i++)
    Serve_85_CarSpdQF[i] = Serve_85_CarSpdQFTemp[i];
  
  diagStartTesterPresent(Cdd_Name);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  
  for(j=0;j<7;j++)
  {
    diagStartTesterPresent(Cdd_Name);
    if(j==1)
      _Set_CarSpd(NRC22_CarSpd+1);
    else 
      _Set_CarSpd(NRC22_CarSpd-1);
    
    _Set_Ready(0xB);
    _Set_CarSpd_Invalid(3);
    if(j==0 || j==1)  /*此用例测试VehSpdLgtQf=2或3能支持85服务，需要遍历VehSpdLgtQf值*/
    {
      _WriteEx_and_Report("","测试支持28服务的VehSpdLgtQf，需要遍历VehSpdLgtQf值");
      for(i=0;i<4;i++)
      {
        _Set_CarSpd_Invalid(i);
        testWaitForTimeout(1000);
        _Send_Diag(3,ID,Send_Data_01);
        if((_Check_Dword_in_Num(i,Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)!= -1) && j == 0)
          _TestResult(SendData,ID,"",-1);
        else
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
      }
      if(j==1)
      {
        _Set_CarSpd_Invalid(0);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
        _Send_Diag(3,ID,Send_Data_01);
        _TestResult(SendData,ID,"",-1);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        _WriteEx_and_Report("","步骤5-9测试结束");
      }
      else
        _WriteEx_and_Report("","步骤1-4测试结束");
    }
    else if(j==2)  /*此用例测试Usgmode≠0xD(driving)能支持85服务，需要遍历Usgmode值以及丢失*/
    {
      _WriteEx_and_Report("","此用例测试Usgmode≠0xD(driving)能支持28服务，需要遍历Usgmode值以及丢失");
      for(i=0;i<5;i++)
      {
        byte Temp[5]={0,1,2,0xB,0xD};
        _Set_Ready(Temp[i]);
        testWaitForTimeout(1000);
        _Send_Diag(3,ID,Send_Data_01);
        if(Temp[i]==0xD)
          _TestResult(SendData,ID,"",Ready_NRC);
        else
          _TestResult(SendData,ID,"",-1);
      }
      _Set_Ready(0xD);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(3000);
      _Send_Diag(3,ID,Send_Data_01);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      _WriteEx_and_Report("","步骤10-15测试结束");
    }
    else if(j==3)/*测试电压条件*/
    { 
      float Temp[4]={1,2,3,4};
      _WriteEx_and_Report("","测试电压条件");
      Temp[0]=NRC22_Battery_Low+0.2;
      Temp[1]=NRC22_Battery_Hight-0.2;
      Temp[2]=NRC22_Battery_Low-0.2;
      Temp[3]=NRC22_Battery_Hight+0.2;
      for(i=0;i<4;i++)
      {
        _Set_Battery(Temp[i]);
        _Send_Diag(3,ID,Send_Data_01);
        if(i<2)
          _TestResult(SendData,ID,"",-1);
        else if(i==2)
          _TestResult(SendData,ID,"",L_Battery_NRC);
        else if(i==3)
          _TestResult(SendData,ID,"",H_Battery_NRC);
      }
      _Set_Battery(12);
      _WriteEx_and_Report("","步骤16-19测试结束");
    }
    else if(j==4)/*Usgmode(0x2E0:VehModMngtGlbSafe1)=0xD，车速<3km/h，VehSpdLgtQf=3，电压为13.5V时丢失0xE0节点发送报文：*/
    {
      _WriteEx_and_Report("","Usgmode(0x2E0:VehModMngtGlbSafe1)=0xD，车速<3km/h，VehSpdLgtQf=3，电压为13.5V时丢失0xE0节点发送报文");
      _Set_Ready(0xD);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(5000);
      _Send_Diag(3,ID,Send_Data_01);
      _TestResult(SendData,ID,"",Ready_NRC);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _Set_Ready(0xB);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(5000);
      _Send_Diag(3,ID,Send_Data_01);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _WriteEx_and_Report("","步骤20-21测试结束");
    }
    else if(j==5)/*步骤22&23、VehSpdLgtQf不满足；步骤24、车速不满足；步骤25&26、VehSpdLgtQf满足取值遍历*/
    {
      int Qf[4] = {1,0,2,3};
      _Set_Ready(0xD);
      _WriteEx_and_Report("","步骤22&23：VehSpdLgtQf不满足。步骤24：车速不满足。步骤25&26：VehSpdLgtQf满足取值遍历");
      _WriteEx_and_Report("","步骤22，步骤23，步骤25，步骤26");
      for(i=0;i<4;i++)
      {
        _Set_CarSpd_Invalid(Qf[i]);
        testWaitForTimeout(500);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(2000);
        _Send_Diag(3,ID,Send_Data_01);
        if(_Check_Dword_in_Num(Qf[i],Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)!= -1)
          _TestResult(SendData,ID,"",-1);
        else
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
        _TestEnableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(2000);
      }
      _WriteEx_and_Report("","步骤24，放于循环外测试");
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_CarSpd_Invalid(2);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _Send_Diag(3,ID,Send_Data_01);
      _TestResult(SendData,ID,"",CarSpd_NRC);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("","步骤22-26测试结束");
    }
    else if(j==6)/*在Usgmode不满足且Usgmode和车速均丢失的前提下设计以下电压临界值步骤情况*/
    {
      float Temp[4]={1,2,3,4};
      _WriteEx_and_Report("","在Usgmode不满足且Usgmode和车速均丢失的前提下设计以下电压临界值步骤情况");
      Temp[0]=NRC22_Battery_Low+0.2;
      Temp[1]=NRC22_Battery_Hight-0.2;
      Temp[2]=NRC22_Battery_Low-0.2;
      Temp[3]=NRC22_Battery_Hight+0.2;
      _Set_Ready(0xD);
      _Set_CarSpd_Invalid(3);
      _Set_CarSpd(NRC22_CarSpd-1);
      testWaitForTimeout(1000);
      for(i=0;i<4;i++)
      {
        _Set_Battery(Temp[i]);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(2000);
        _Send_Diag(3,ID,Send_Data_01);
        if(i<2)
          _TestResult(SendData,ID,"",-1);
        else if(i==2)
          _TestResult(SendData,ID,"",L_Battery_NRC);
        else if(i==3)
          _TestResult(SendData,ID,"",H_Battery_NRC);
        _TestEnableMsg(Struct_Ready.Sig_Id);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(1000);
      }
      _Set_Battery(12);
      _WriteEx_and_Report("","步骤27-30测试结束");
    }
  }
  _Set_CarSpd(0);
  _Reset_CarSpd_Invalid();
}

_28_Serve_22(dword ID,byte Session)/* 静默时长 */
{
  byte Send_Data[5];
  int Serve_Pos,i;
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,Session)==1)
  {
    _get_28_Case();
    _get_Arry("Read_SigValue");
    Send_Data[0] = 0x28;Send_Data[1] = 0x03;Send_Data[2] = 0x03;

    _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_1);
    testWaitForTimeout(500);
    _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
    _Check_Return(1);
    _Check_EPS_TX(1,EPS_TxID_1);
    _Send_Diag(3,ID,Send_Data);
    _TestResult(SendData,ID,"",-1);
    testWaitForTimeout(500);
    _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2);
    testWaitForTimeout(500);
    for(i=0;i<=5*60;i+=4)
    {
      _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
      _Check_Return(0);
      _Check_EPS_TX(0,EPS_TxID_1);//此处存在1s检测报文是否停发
      testWaitForTimeout(3000);
      writeEx(-3,0,"第 %d s检测完毕",i+4);
    }
    testWaitForTimeout(2000); //等待时间结束，回到默认会话
    _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
    _Check_Return(2);
    _Check_EPS_TX(1,EPS_TxID_1);
    _Set_Sig(Sig_28_Set,0);
  }
  else
    _WriteEx_and_Report("","当前寻址或会话不支持");
}


_2E_Serve_1(dword ID,byte Session)/*  7F>13*/
{
  _get_Str_Traversal("DID_2E_Traversal");
  if(Traversal_Count>0)
    _get_2E_DID(Traversal_DID[0]);
  else
    _get_2E_DID("DID2E_Rx_NRC33");
  if(DID_2E_SendData_1_Len<3)
  {
    DID_2E_SendData_1_Len = 3;
    DID_2E_SendData_1[0] = 0x2E;
  }
  _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
  if(Geely3_Flage == 1 && ID == phyreq_ID)
    _TestResult(SendData,ID,"",NRC13);
  else
    _TestResult(SendData,ID,"",NRC7F);
}

_2E_Serve_2(dword ID,byte Session)/*  遍历*/
{
  int m;
  _get_Str_Traversal("DID_2E_Traversal");
  for(m=0;m<Traversal_Count;m++)
  {
    if(m>0)
    {
      _SetSession(defsession);
      testWaitForTimeout(200);
      _SetSession(exsession);
    }
    _get_2E_DID(Traversal_DID[m]);
    _Clear_Config(DID_2E_SendData_1,Session);
    _Check_DID_2E(ID,Session);
    testWaitForTimeout(100);
  }
}

_2E_Serve_3(dword ID,byte Session)/*  写入零件号*/
{
  char str1[200];
  byte Read_Data[200];
  int Read_Data_Len;
  int i,m,Flage_Read;
  _Get_Write_Part_number();
  if(DID_2E_SendData_1_Len==0)
    _WriteEx_and_Report("","未查询到零件号写入值,不执行后续操作");
  else
  {
    snprintf(str1,elCount(str1),"%s","");
    snprintf(str1,elCount(str1),"%s","获取第一次写入数据: ");
    if(Support_Read_2E_DID == 1)
    {
      for(i=0;i<DID_2E_SendData_1_Len;i++)
      {
        snprintf(str1,elCount(str1),"%s%02X",str1,DID_2E_SendData_1[i]);
        snprintf(str1,elCount(str1),"%s%s",str1,"  ");
      }
      _WriteEx_and_Report("",str1);
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _TestResult(SendData,phyreq_ID,"",-1);
      {
        Flage_Read = 0;
        if(diagGetLastResponseCode(SendData) == -1)
        {
          Read_Data_Len =  DiagGetRespPrimitiveSize(SendData);
          Flage_Read = 1;
          for(m=0;m<Read_Data_Len;m++)
            Read_Data[m] = DiagGetRespPrimitiveByte(SendData,m);
        }
      }
      if(Part_number_Fac==1)
        _unlockFactory();
      else
        _unlockECU();
      if(DID_2E_SendData_1_Response == -1)
      {
        _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(500);
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_Part_number(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
        _WriteEx_and_Report("","第一次写入判断完成");
        _Power_Down();
        testWaitForTimeout(2000);
        _Power_Up();
        testWaitForTimeout(1000);
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_Part_number(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
        _WriteEx_and_Report("","正常上下电读取判断完成");
        _Set_11_Restoration();
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_Part_number(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
        _WriteEx_and_Report("","11复位读取判断完成");
        _K30_OFF();
        testWaitForTimeout(2000);
        _K30_ON();
        testWaitForTimeout(1000);
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_Part_number(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
        _WriteEx_and_Report("","异常复位读取判断完成");
      }
      else
      {
        _WriteEx_and_Report("","期望结果不为正响应,验证异常写入后值不被改变");
        _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
        _TestResult(SendData,phyreq_ID,"",DID_2E_SendData_1_Response);
        if(Flage_Read == 0)
          _WriteEx_and_Report("","第一次读取时未获取到正确值,不再测试后续部分");
        else
        {
          _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
          _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
          _Power_Down();
          testWaitForTimeout(2000);
          _Power_Up();
          testWaitForTimeout(1000);
          _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
          _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
          _WriteEx_and_Report("","正常上下电读取判断完成");
          _Set_11_Restoration();
          _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
          _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
          _WriteEx_and_Report("","11复位读取判断完成");
          _K30_OFF();
          testWaitForTimeout(2000);
          _K30_ON();
          testWaitForTimeout(1000);
          _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
          _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
          _WriteEx_and_Report("","异常复位读取判断完成");
        }
      }
      if(Part_number_Fac==1)
        _unlockFactory();
      else
        _unlockECU();
      if(DID_2E_SendData_1_Response == -1 && DID_2E_SendData_2_Response == -1)
      {
        _Send_Diag(DID_2E_SendData_2_Len,ID,DID_2E_SendData_2);
        _TestResult(SendData,ID,"",-1);
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_Part_number(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
        _WriteEx_and_Report("","第二次写入判断完成");
      }
      else if(DID_2E_SendData_1_Response != -1 && DID_2E_SendData_2_Response == -1)
      {
        _WriteEx_and_Report("","第一次写入值未成功,验证第二次写入");
        _Send_Diag(DID_2E_SendData_2_Len,ID,DID_2E_SendData_2);
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(500);
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
        _WriteEx_and_Report("","第二次写入判断完成");
        _Power_Down();
        testWaitForTimeout(2000);
        _Power_Up();
        testWaitForTimeout(1000);
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
        _WriteEx_and_Report("","正常上下电读取判断完成");
        _Set_11_Restoration();
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
        _WriteEx_and_Report("","11复位读取判断完成");
        _K30_OFF();
        testWaitForTimeout(2000);
        _K30_ON();
        testWaitForTimeout(1000);
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
        _WriteEx_and_Report("","异常复位读取判断完成");
      }
      else if(DID_2E_SendData_2_Response != -1)
      {
        _Send_Diag(DID_2E_SendData_2_Len,ID,DID_2E_SendData_2);
        _TestResult(SendData,ID,"",DID_2E_SendData_2_Response);
      }
    }
    else
    {
      _WriteEx_and_Report("","不支持读取,仅验证写入后正响应");
      if(Part_number_Fac==1)
        _unlockFactory();
      else
        _unlockECU();
      _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,ID,"",-1);
    }
  }
}
_2E_Serve_4(dword ID,byte Session)/*  NRC优先级*/
{  
  int Serve_Pos,i;
  byte Send_Data[100];
  
   Serve_Pos = _Check_Serve(0x2E,0,0);
  if(_Check_Serve_IDAndSess(0x2E,ID,Session) == 1)
  {
    Send_Data[0] = 0x2E;
     _Set_NRC_Step(0x2E,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<Fun_NRC_Count;i++) 
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
      if(i == Fun_NRC_Count)
        _TestResult(SendData,ID,"",-1);
      else
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      testWaitForTimeout(100);
    }
  }
}
_2E_Serve_5(dword ID,byte Session)/*  NRC33 */
{
  byte Data[500];
  byte Data2[500];
  char Temp_Str[30];
  int Clear_Config_Flage,SWhere;
  int i=0,j=0,Len=0,Len2=0,flage,Unlock_Flage;
  dword TempRead;
  snprintf(Temp_Str,elCount(Temp_Str),"%s","");
  _get_Str_Traversal("DID_2E_Traversal");
  Clear_Config_Flage = 0;
  if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
  {
    for(i=0;i<Traversal_Count;i++)
    {
      if((strncmp(Traversal_DID[i],"DID2E_F1A1",strlen(Traversal_DID[i])) == 0 && strlen(Traversal_DID[i]) == strlen("DID2E_F1A1")) || (strncmp(Traversal_DID[i],"DID2E_2100",strlen(Traversal_DID[i])) == 0 && strlen(Traversal_DID[i]) == strlen("DID2E_2100")))
      {
        Clear_Config_Flage = 1;
        break;
      }
    }
  }
  if(Clear_Config_Flage == 1)
  {
    byte Data_Send[11] = {0x2E,0xF1,0xA1,0,0,0,0,0,0,0,0x55};
    _unlockECU();
    _Send_Diag(11,phyreq_ID,Data_Send);
    _TestResult(SendData,ID,"",-1);
    _SetSession(Session);
  }
  for(i=0;i<Traversal_Count;i++)
  {
    _get_2E_DID(Traversal_DID[i]);
    snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    snprintf(Temp_Str,elCount(Temp_Str),"  开始测试  %02X %02X",DID_2E_SendData_1[1],DID_2E_SendData_1[2]);
    _WriteEx_and_Report("","------------------------------------");
    _WriteEx_and_Report("",Temp_Str);
    _WriteEx_and_Report("","------------------------------------");
    if((DID_2E_SendData_1[1] == 0xF1 && DID_2E_SendData_1[2] == 0xA1) || (DID_2E_SendData_1[1] == 0x21 && DID_2E_SendData_1[2] == 0x00))
      SWhere = i;
    if(i>0)
      _SetSession(Session);
    if(Support_Read_2E_DID == 1)
    {
      TempRead = ((Read_2E_DID[1]<<8)|Read_2E_DID[2]);
      Unlock_Flage = _Check_Serve(0x22,TempRead,5);
      if(Unlock_Flage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,ID,Read_2E_DID);
      _TestResult(SendData,ID,"",-1);
      if(diagGetLastResponseCode(SendData)==-1)
      {
        Len = DiagGetRespPrimitiveSize(SendData);
        for(j=0;j<Len;j++)
          Data[j] = DiagGetRespPrimitiveByte(SendData,j);
      }
      else
        testStepFail("22读取数据","未收到正响应");
      _SetSession(Session);
      _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,ID,"",NRC33);
      
      if(Unlock_Flage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,ID,Read_2E_DID);
      _TestResult(SendData,ID,"",-1);
      if(diagGetLastResponseCode(SendData)==-1)
      {
        Len2 = DiagGetRespPrimitiveSize(SendData);
        for(j=0;j<Len2;j++)
          Data2[j] = DiagGetRespPrimitiveByte(SendData,j);
      }
      else
        testStepFail("22读取数据","未收到正响应");
      if(Len!=Len2 )
        testStepFail(Traversal_DID[i],"两次接收到的数据长度不一致,第一次长度为%d,第二次长度为%d",Len,Len2);
      else
      {
        for(j=0;j<Len;j++)
        {
          if(Data[j]!=Data2[j])
            flage=1;
        }
        if(flage==1)
          testStepFail(Traversal_DID[i],"两次返回的数据不一致");
        else
          testStepPass(Traversal_DID[i],"两次返回的数据一致");
      }
      
      if(Unlock_Flage == 1)
        _Set_11_Restoration(0);
      else
        _Set_11_Restoration();
      if(Session != defsession)
        _SetSession(Session);
      
      if(Unlock_Flage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,ID,Read_2E_DID);
      _TestResult(SendData,ID,"",-1);
      if(diagGetLastResponseCode(SendData)==-1)
      {
        Len2 = DiagGetRespPrimitiveSize(SendData);
        for(j=0;j<Len2;j++)
          Data2[j] = DiagGetRespPrimitiveByte(SendData,j);
      }
      else
        testStepFail("22读取数据","未收到正响应");
      if(Len!=Len2 )
        testStepFail(Traversal_DID[i],"第三次接收到的数据长度不一致,第一次长度为%d,第三次长度为%d",Len,Len2);
      else
      {
        for(j=0;j<Len;j++)
        {
          if(Data[j]!=Data2[j])
            flage=1;
        }
        if(flage==1)
          testStepFail(Traversal_DID[i],"第三次返回的数据不一致");
        else
          testStepPass(Traversal_DID[i],"第三次返回的数据一致");
      }
      
    }
    else
    {
      _WriteEx_and_Report(Traversal_DID[i],"不支持读取,仅验证返回NRC33");
      _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,ID,"",NRC33);
    }
  }
  if(Clear_Config_Flage == 1)
  {
    _unlockECU();
    _get_2E_DID(Traversal_DID[SWhere]);
    _Send_Diag(DID_2E_SendData_1_Len,phyreq_ID,DID_2E_SendData_1);
    _TestResult(SendData,ID,"",-1);
  }
}
_2E_Serve_6(dword ID,byte Session)/*  NRC13 */
{
  byte Data[400];
  int Len,i,j;
  char Temp_Str[30];
  _get_Str_Traversal("DID_2E_Traversal");
  for(j=0;j<Traversal_Count;j++)
  {
    _get_2E_DID(Traversal_DID[j]);
    if(j==0)
      _unlockECU();

    snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    snprintf(Temp_Str,elCount(Temp_Str),"  开始测试  %02X %02X",DID_2E_SendData_1[1],DID_2E_SendData_1[2]);
    _WriteEx_and_Report("","------------------------------------");
    _WriteEx_and_Report("",Temp_Str);
    _WriteEx_and_Report("","------------------------------------");
    for(i=0;i<DID_2E_SendData_1_Len;i++)
      Data[i] = DID_2E_SendData_1[i];
    if(DID_2E_SendData_1_Len<7)  
      Len = 7;
    else
      Len = DID_2E_SendData_1_Len+1;
    for(i=1;i<=Len;i++)
    {
      if(i==DID_2E_SendData_1_Len) 
        continue;
      _Send_Diag(i,ID,Data);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(20);
    }
  }
}
_2E_Serve_7(dword ID,byte Session)/*  NRC31 */
{  
  byte Send_Data[3]={0x2E,0xF1,0x80}; 
  dword byte1,byte2,Fun_Send;
  int Return_Va;
  int Flage,Serve_Pos;
  Return_Va = _Check_Serve_IDAndSess(0x2E,ID,Session);
  Serve_Pos = _Check_Serve(0x2E,0,0);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历2E服务NRC31数据时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  _unlockECU();
  if(Return_Va == 1 || Serve_Data[Serve_Pos].Serve_Fun_Count == 0)
  {
    if(Traversal_2E==0)
    {
      for(byte1=0;byte1<=0xff;byte1++)
      {
        Send_Data[1]=byte1;
        for(byte2=0;byte2<=0xff;byte2++)
        {
          Send_Data[2]=byte2;
          Fun_Send = (byte1 << 8) ^ byte2;
          if(_Check_Serve(0x2E,Fun_Send,4) != -1)
          {
            _WriteEx_and_Report("","该子功能支持，跳过检测");
            continue;
          }
          else
          {
            _Send_Diag(4,ID,Send_Data);
            Flage = _TestResult(SendData,ID,"",NRC31);
            testWaitForTimeout(10);
            if(Flage == -1)
            {
              char Str[30];
              snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
              File_Write(Error_File,Error_FileName,Str,2);
            }
          }
        }
      } 
    }
    if(Traversal_2E != 0)
    {
      Send_Data[1] = Traversal_2E;
      for(byte2=0;byte2<=0xff;byte2++)
      {
        Send_Data[2]=byte2;
        Fun_Send = (Traversal_2E << 8) ^ byte2;
        if(_Check_Serve(0x2E,Fun_Send,4) != -1)
        {
          _WriteEx_and_Report("","该子功能支持，跳过检测");
          continue;
        }
        else
        {
          _Send_Diag(4,ID,Send_Data);
          Flage = _TestResult(SendData,ID,"",NRC31);
          testWaitForTimeout(10);
          if(Flage == -1)
          {
            char Str[30];
            snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
            File_Write(Error_File,Error_FileName,Str,2);
          }
        }
      }
    }
  }
  else if(Return_Va == -1)
    _WriteEx_and_Report("","当前寻址不支持该服务");
  else if(Return_Va == 0)
    _WriteEx_and_Report("","当前会话不支持该服务");
}


_Serve31_01(dword ID,byte Session) /*新31例程遍历*/
{
  byte Send_Data[100];
  int i,Flage;
  _Set_11_Restoration();
  _Set_Ready(0);
  testWaitForTimeout(1000);//11服务规避检测对中影响
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    writeEx(-3,0,"/*-----------0x%02X 0x%02X-----------*/",Serve_31_Hex[i].Routine[0],Serve_31_Hex[i].Routine[1]);
    testStep("","/*-----------0x%02X 0x%02X-----------*/",Serve_31_Hex[i].Routine[0],Serve_31_Hex[i].Routine[1]);
    if(_Check_Serve_IDAndSess(0x31,i,ID,Session)!=1)
    {
      writeEx(-3,0,"当前测试项次不支持当前寻址或会话");
      continue;
    }
    if(Session != defsession)
      _SetSession(defsession);
    _SetSession(Session);
    testWaitForTimeout(200);
    if(LoopServe_Search_SecurityAccess(0x31,i) == 1)
      _unlockECU();
    testWaitForTimeout(500);
    _Get_31_ServeData(i,Send_Data,0);
    Send_Data[1] = 0x03;
    Flage = _Check_SendData_In_31H(Send_Data);
    _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
    if(Flage == -1)
      _TestResult(SendData,ID,"",NRC12);
    else
      _TestResult(SendData,ID,"",NRC24);
    testWaitForTimeout(200);
    if(Serve_31_Hex[i].Control_Type_RSP[0] == 1)
    {
      Send_Data[1] = 0x83;
      _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
      if(Flage == -1)
        _TestResult(SendData,ID,"",NRC12);
      else
        _TestResult(SendData,ID,"",NRC24);
      testWaitForTimeout(200);
    }
    Send_Data[1] = 0x01;
    _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
    _Check_31Routine_Rx(Send_Data,1);
    testWaitForTimeout(200);
    if(Serve_31_Hex[i].Control_Type_RSP[0] == 1)
    {
      Send_Data[1] = 0x81;
      _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",0);
      testWaitForTimeout(200);
    }
    if(Flage != -1)
    {
      Send_Data[1] = 0x03;
      _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
      _Check_31Routine_Rx(Send_Data,1);
      if(Serve_31_Hex[i].Control_Type_RSP[0] == 1)
      {
        Send_Data[1] = 0x83;
        _Send_Diag(Serve_31_Hex[i].Routine_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",0);
      }
    }
  }
  {
    _WriteEx_and_Report("","测试已完成,后续步骤为对中清除故障码");
    _SetSession(defsession);
    _Ang_Calibration_();
  }
}

_31_Serve_01(dword ID,byte Session) /*7F>13*/
{
   byte Send_Data[100];
  if(_Check_Serve_IDAndSess(0x31,ID,Session) == 1)
  {
    _WriteEx_and_Report("","当前寻址及服务会正响应，在其余用例中测试");
    return;
  }
  _Get_31_ServeData(0,Send_Data,0);
  
  _Send_Diag((Serve_31_Hex[0].Routine_Len-1),ID,Send_Data);
  _TestResult(SendData,ID,"",NRC7F);
}

_31_Serve_02(dword ID,byte Session) /*预编程*/
{
  _get_Arry("Pre_Programmed");
  if(Arry_Len>0)
  {
    if(Pre_Programmed_UnlockECU==1)
      _unlockECU();
    Arry_Data[1] = 0x03;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    for(i=0;i<4;i++)
      Pre_Programmed[i] = Arry_Data[i];
    if(_Check_SendData_In_31H(Arry_Data)==-1)
      _TestResult(SendData,ID,"",NRC12);
    else
      _TestResult(SendData,ID,"",NRC24);
    Arry_Data[1] = 0x01;
    _Send_Diag(4,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    Arry_Data[1] = 0x03;
    _Send_Diag(4,ID,Arry_Data);
    for(i=0;i<4;i++)
      Pre_Programmed[i] = Arry_Data[i];
    if(_Check_SendData_In_31H(Arry_Data)==-1)
      _TestResult(SendData,ID,"",NRC12);
    else
      _Check_31Routine_Rx(Arry_Data,1);
  }
  else
    _WriteEx_and_Report("","未查询到预编程数据输入");
}

_31_Serve_03_CCAG(dword ID,byte Session) /*清除角度对中*/
{
  _get_Arry("Clear_Angle_Calibration");
  if(Arry_Len>0)
  {
    _unlockECU();
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
  }
  else
    _WriteEx_and_Report("","未查询到清除角度对中数据输入");
}
_31_Serve_04_CCAG(dword ID,byte Session) /*角度对中*/
{
  _get_Arry("Angle_Calibration");
  if(Arry_Len>0)
  {
    _unlockECU();
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
  }
  else
    _WriteEx_and_Report("","未查询到角度对中数据输入");
}
_31_Serve_05_BYD(dword ID,byte Session) /*角度对中*/
{
    _Set_11_Restoration();
    testWaitForTimeout(1000);
    _SetSession(Session);
    _Set_Ready(Struct_Ready.Ready_Active);
    _Set_CarSpd(10);
    testWaitForTimeout(1000);
    
    _unlockECU();
    _get_Arry("Angle_Calibration");
    Arry_Data[1] = 0X03;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    if(_Check_SendData_In_31H(Arry_Data)!= -1)
      _TestResult(SendData,ID,"",NRC24);
    else
      _TestResult(SendData,ID,"",NRC12);
    Arry_Data[1] = 0X01;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    Arry_Data[1] = 0X03;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    if(_Check_SendData_In_31H(Arry_Data)!= -1)
      _Check_31Routine_Rx(Arry_Data,1);
    else
      _TestResult(SendData,ID,"",NRC12);
    
    _Set_Ready(0);
    _Set_CarSpd(0);
    testWaitForTimeout(2000);
}
_31_Serve_06_BYD(dword ID,byte Session) /*擦除角度对中*/
{
    _Set_11_Restoration();
    testWaitForTimeout(1000);
    _SetSession(Session);
    _Set_Ready(Struct_Ready.Ready_Active);
    _Set_CarSpd(10);
    testWaitForTimeout(1000);
    
    _unlockECU();
    _get_Arry("Clear_Angle_Calibration");
    Arry_Data[1] = 0X03;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    if(_Check_SendData_In_31H(Arry_Data)!= -1)
      _TestResult(SendData,ID,"",NRC24);
    else
      _TestResult(SendData,ID,"",NRC12);
    Arry_Data[1] = 0X01;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    Arry_Data[1] = 0X03;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    if(_Check_SendData_In_31H(Arry_Data)!= -1)
      _Check_31Routine_Rx(Arry_Data,1);
    else
      _TestResult(SendData,ID,"",NRC12);
    
    _Set_Ready(0);
    _Set_CarSpd(0);
    testWaitForTimeout(2000);
}
_31_Serve_07_BYD(dword ID,byte Session) /*擦除软止点*/
{
    _unlockECU();
    _get_Arry("Clear_SoftStop");
    Arry_Data[1] = 0X03;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    if(_Check_SendData_In_31H(Arry_Data)!= -1)
      _TestResult(SendData,ID,"",NRC24);
    else
      _TestResult(SendData,ID,"",NRC12);
    Arry_Data[1] = 0X01;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
    Arry_Data[1] = 0X03;
    _Send_Diag(Arry_Len,ID,Arry_Data);
    _Check_31Routine_Rx(Arry_Data,1);
}
