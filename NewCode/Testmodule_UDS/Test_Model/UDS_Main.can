_31_Serve_46_4(dword ID,byte Session)/* 对中 NVM等待中*/
{
  byte Send_Data[6] = {0x31,0x01,0x30,0x7B,0,0};
  byte SendDataCheck[6] = {0x31,0x03,0x30,0x7B,0,0};
  int Count;
  
  int Send_Len,i,Flage_For_Unlock;
  dword FunDID;
  Send_Len = 4;
  FunDID = 0x307B;
  _get_Arry("Angle_Calibration");
  if(Arry_Len>1)
  {
    Send_Len = Arry_Len;
    FunDID = (Arry_Data[2]<<8)|Arry_Data[3];
    for(i=0;i<Arry_Len;i++)
      Send_Data[i] = Arry_Data[i];
    for(i=0;i<Arry_Len;i++)
      SendDataCheck[i] = Send_Data[i];
    SendDataCheck[1] = 0x03;
  }
  Flage_For_Unlock = _Check_Serve(0x01,FunDID,11);

  Count = 0;
  diagStartTesterPresent(Cdd_Name);
  _ClearAngle(1);
  testWaitForTimeout(200);
  _Check_DTC_Res(1,Ang_NotCal,0);
  _SetSession(Session);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  if(Flage_For_Unlock == 1)
    _unlockECU();
  if(ID == phyreq_ID)
  {
    do{
      _Send_Diag(Send_Len,ID,Send_Data);
      Count++;
    }while(Count<=100 && diagGetLastResponseCode(SendData)!= 0x31);
    testWaitForTimeout(50);
  }
  else
  {
    message *Msg;
    Msg.dlc = 8;
    Msg.id = funreq_ID;
    Msg.byte(0) = Send_Len;
    if((Support_CAN & 2) != 0)
    {
      Msg.BRS = 1; Msg.FDF = 1;
    }
    for(i=0;i<Send_Len;i++)
      Msg.byte(i+1) = Send_Data[i];
    output(Msg);
    testWaitForTimeout(20);
    output(Msg);
    testWaitForTimeout(10);
  }
  _Send_Diag(Send_Len,ID,SendDataCheck);
  _Check_31Routine_Rx(SendDataCheck,5);
  testWaitForTimeout(200);
  
  _Send_Diag(Send_Len,ID,Send_Data);
  _Check_31Routine_Rx(Send_Data,1);
  testWaitForTimeout(50);
  _Send_Diag(Send_Len,ID,SendDataCheck);
  _Check_31Routine_Rx(SendDataCheck,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(1,0,Ang_NotCal);
}

