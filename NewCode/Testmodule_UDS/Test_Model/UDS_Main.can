_Serve23_01(dword ID,byte Session)
{
  byte Send_Data_23[8] = {0x23,0x24,0,0,0,0,0,0};
  if(_Check_Serve_IDAndSess(0x23,ID,Session) != 1)
  {
    _Send_Diag(0x8,ID,Send_Data_23);
    _TestResult(SendData,ID,"",NRC7F);
  }
}
_Serve23_02(dword ID,byte Session)
{
  byte Send_Data_22[3] = {0x22,0xD1,0x23};
  byte Send_Data_23[20] ;
  byte DataSaveFor23[100];
  int i,j,Flage,StructPos,DataPos,m,PosForLen;
  struct SaveDataForD123
  {
    dword Addr[10];
    int Len[10];
    int AddrCount;
  };
  struct SaveDataForD123 SaveData;
  int ResLen,OffSet,CountLen;
  int LenLen,AddLen;
  GetInforMationFromVBF();
  _Send_Diag(0x3,ID,Send_Data_22);
  _TestResult(SendData,ID,"",-1);
  if(diagGetLastResponseCode(SendData) == -1)
  {
    ResLen = DiagGetRespPrimitiveSize(SendData);
    if(ResLen != 0x17)
      testStepFail("","返回长度异常，期望长度为0x17，实际长度为0x%02X",ResLen);
    else
      testStepPass("","长度与预期一致");
    if(DiagGetRespPrimitiveByte(SendData,3) != 0x03)
      testStepFail("","返回数据段个数异常，期望为0x03，实际长度为0x%02X",DiagGetRespPrimitiveByte(SendData,3));
    else
      testStepPass("","返回数据段个数与预期一致为3");
    if(DiagGetRespPrimitiveByte(SendData,4) != 0x24)
      testStepFail("","返回数据段个数异常，期望为0x24，实际长度为0x%02X",DiagGetRespPrimitiveByte(SendData,3));
    else
      testStepPass("","返回数据段个数与预期一致为0x24");
    OffSet = 5;
    LenLen = (DiagGetRespPrimitiveByte(SendData,4)>>4)&0xF;
    AddLen = (DiagGetRespPrimitiveByte(SendData,4))&0xF;
    CountLen = LenLen + AddLen;
    SaveData.AddrCount = (ResLen - OffSet)/CountLen;
    for(i=0;i<SaveData.AddrCount;i++) //装载所有文件地址
    {
      SaveData.Len[i] = 0;
      SaveData.Addr[i] = 0;
      for(j=0;j<LenLen;j++)
        SaveData.Len[i] = SaveData.Len[i] + (DiagGetRespPrimitiveByte(SendData,j+OffSet+i*CountLen)<<(8*(LenLen-j-1)));
      for(j=0;j<AddLen;j++)
        SaveData.Addr[i] = SaveData.Addr[i] + (DiagGetRespPrimitiveByte(SendData,LenLen+j+OffSet+i*CountLen)<<(8*(AddLen-j-1)));
    }
    for(i=0;i<SaveData.AddrCount;i++)
    {
      for(j=0;j<2;j++)
      {
        if((SaveData.Addr[i] == Struct_VBF_Addr[j].StartAddr[0])  || (SaveData.Addr[i] != Struct_VBF_Addr[j].StartAddr[0]+SaveData.Len[i]))
          break;
      }
      if(j>=2)
        testStepFail("","当前返回数据地址不在文件地址中");
      else
        testStepPass("","返回地址段在输入文件中");
    }
  }
  _unlockECU();
  Send_Data_23[0] = 0x23;Send_Data_23[1] = 0x24;
  for(m=0;m<3;m++)
  {
    PosForLen = 0;
    for(i=0;i<AddLen;i++)
      Send_Data_23[i+2] = (SaveData.Addr[m]>>((AddLen-i-1)*8)&0xFF);
    for(i=0;i<LenLen;i++)
      Send_Data_23[i+2+AddLen] = (SaveData.Len[m]>>((LenLen-i-1)*8)&0xFF);
    _Send_Diag(2+AddLen+LenLen,ID,Send_Data_23);
    _TestResult(SendData,ID,"",-1);
    if(StopForVBFTest == 1)
    {
      _WriteEx_and_Report("","后续数据无法验证,跳过数据验证步骤");
      return;
    }
    if(diagGetLastResponseCode(SendData) == -1)
    {
      ResLen = DiagGetRespPrimitiveSize(SendData);
      if(ResLen!= SaveData.Len[m]+1)
        testStepFail("","23 24返回的长度异常,期望为0x%X，实际为0x%X",SaveData.Len[m]+1,ResLen);
      for(i=1;i<ResLen;i++)
        DataSaveFor23[i-1] = DiagGetRespPrimitiveByte(SendData,i);
      Flage = 0;
      for(i=0;i<2;i++)
      {
        for(j=0;j<Struct_VBF_Addr[i].BlockCount;j++)
        {
          if(SaveData.Addr[m] == Struct_VBF_Addr[i].StartAddr[j])
          {
            DataPos = j;
            Flage = 1; break;
          }
          if(SaveData.Addr[m] == Struct_VBF_Addr[i].StartAddr[j]+SaveData.Len[m])
          {
            DataPos = j; PosForLen = SaveData.Len[m];
            Flage = 1; break;
          }
        }
        if(Flage == 1)
        {
          StructPos = i;
          break;
        }
      }
      Flage = 0;
      if(PosForLen == 0)
      {
        for(i=0;i<ResLen-2;i++)
        {
          if(DataSaveFor23[i] != Struct_VBF_Addr[StructPos].DataSave[i])
          {
            testStepFail("","期望第 %d 数据位返回为0x%02X ,实际返回数据为0x%02X",i,Struct_VBF_Addr[StructPos].DataSave[i],DataSaveFor23[i]);
            Flage = 1;
          }
        }
      }
      else
      {
        for(i=0;i<ResLen-2;i++)
        {
          if(DataSaveFor23[i] != Struct_VBF_Addr[StructPos].DataSave[i+PosForLen])
          {
            testStepFail("","期望第 %d 数据位返回为0x%02X ,实际返回数据为0x%02X",i,Struct_VBF_Addr[StructPos].DataSave[i+PosForLen],DataSaveFor23[i]);
            Flage = 1;
          }
        }
      }
      if(Flage == 0)
        testStepPass("","返回数据与文件中数据完全一致");
    }
  }
}
void _Serve23_03(dword ID,byte Session)/*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[100];
  Serve_Pos = _Check_Serve(0x23,0,0);
  if(_Check_Serve_IDAndSess(0x23,ID,Session) == 1)
  {
    GetInforMationFromVBF();
    if(StopForVBFTest == 1)
      return;
    Send_Data[0] = 0x23;
    _Set_NRC_Step(0x23,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      if( Fun_NRC[i] == 0x31 && NRC31_Count == 1 && NRC31_total == 2)
      {        
        int k;
        _WriteEx_and_Report("","测试地址错误长度正确");
        Send_Data[6] = 0;
        Send_Data[7] = 3;
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
        testWaitForTimeout(100);
        Send_Data[6] = 0;
        Send_Data[7] = 0;
        for(k=0;k<4;k++) //默认地址占4个长度
          Send_Data[k+2] = (Struct_VBF_Addr[0].StartAddr[0]>>((4-k-1)*8)&0xFF);
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
}
void _Serve23_04(dword ID,byte Session)/*NRC13*/
{
  int Serve_Pos,i,Len;
  byte Send_Data[100];
  Serve_Pos = _Check_Serve(0x23,0,0);
  if(_Check_Serve_IDAndSess(0x23,ID,Session) == 1)
  {
    GetInforMationFromVBF();
    if(StopForVBFTest == 1)
      return;
    Send_Data[0] = 0x23; Send_Data[1] = 0x24;
    for(i=0;i<4;i++) //默认地址占4个长度
      Send_Data[i+2] = (Struct_VBF_Addr[0].StartAddr[0]>>((4-i-1)*8)&0xFF);
    Send_Data[6] = 0;Send_Data[7] = 0x03;
    Len = _Check_CANFD_Flage();
    if(Len < Serve_Data[Serve_Pos].Serve_Fun_Len[0])
      Len = Serve_Data[Serve_Pos].Serve_Fun_Len[0]+1;
    _unlockECU();
    for(i=1;i<=Len;i++)
    {
      if(i==Serve_Data[Serve_Pos].Serve_Fun_Len[0])
        continue;
      _Send_Diag(i,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(20);
    }
  }
}
void _Serve23_05(dword ID,byte Session)/*NRC31 地址和长度格式标识符*/
{
  int Serve_Pos,i;
  byte Send_Data[100];
  Serve_Pos = _Check_Serve(0x23,0,0);
  if(_Check_Serve_IDAndSess(0x23,ID,Session) == 1)
  {
    GetInforMationFromVBF();
    if(StopForVBFTest == 1)
      return;
    Send_Data[0] = 0x23; 
    for(i=0;i<4;i++) //默认地址占4个长度
      Send_Data[i+2] = (Struct_VBF_Addr[0].StartAddr[0]>>((4-i-1)*8)&0xFF);
    Send_Data[6] = 0;Send_Data[7] = 0x03;
    _unlockECU();
    for(i=0;i<=0xFF;i++)
    {
      Send_Data[1] = i;
      if(i==Serve_Data[Serve_Pos].Serve_Fun[0])
        continue;
      _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Send_Data);
      _TestResult(SendData,ID,"",NRC31);
      testWaitForTimeout(20);
    }
  }
}
void _Serve23_06(dword ID,byte Session)/*请求报文中地址内存无效*/
{
  byte Send_Data[100];
  int Serve_Pos,i;
  Serve_Pos = _Check_Serve(0x23,0,0);
  if(_Check_Serve_IDAndSess(0x23,ID,Session) == 1)
  {
    Send_Data[0] = 0x23; Send_Data[1] = 0x24;
    Send_Data[6] = 0;    Send_Data[7] = 0x03;
    for(i=2;i<6;i++)
      Send_Data[i] = 0xFF;
    _unlockECU();
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Send_Data);
    _TestResult(SendData,ID,"",NRC31);
  }
}
void _Serve23_07(dword ID,byte Session)/*请求报文中地址内存被限制*/
{
  byte Send_Data[100];
  int Serve_Pos,i;
  Serve_Pos = _Check_Serve(0x23,0,0);
  if(_Check_Serve_IDAndSess(0x23,ID,Session) == 1)
  {
    Send_Data[0] = 0x23; Send_Data[1] = 0x24;
    Send_Data[6] = 0;    Send_Data[7] = 0x03;
    GetInforMationFromVBF();
    if(StopForVBFTest == 1)
      return;
    for(i=0;i<4;i++) //默认地址占4个长度
      Send_Data[i+2] = (Struct_VBF_Addr[0].StartAddr[0]>>((4-i-1)*8)&0xFF);
    Send_Data[3] = Send_Data[3]+0x01;
    _unlockECU();
    _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[0],ID,Send_Data);
    _TestResult(SendData,ID,"",NRC31);
  }
}
