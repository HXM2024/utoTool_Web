_Not_Support_Fun(dword ID,dword session)
{
  int i;
  byte data_[1]={0x01};
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  if(session == exsession)
  {
    _SetSession(exsession);
    testWaitForTimeout(200);
  }
  if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
  {
    for(i=0;i<=0xFF;i++)
    {
      if(i==0x10 || i==0x11 || i==0x14 || i==0x19 || i==0x22 || i==0x27 || i==0x28 || i==0x2e || i==0x31 || i==0x3e || i==0x85 || i==0x34 || i==0x36 || i==0x37)
        continue;
      data_[0] = i;
      _Send_Diag_NoTime(1,ID,data_);
      _get_NRC11(ID);
      testWaitForTimeout(200);
    }
  }
  else
  {
    for(i=0;i<=0xFF;i++)
    {
      if(_Check_Serve(i,0,0) != -1 || i== 0x31)
        continue;
      data_[0] = i;
      _Send_Diag_NoTime(1,ID,data_);
      _get_NRC11(ID);
      testWaitForTimeout(200);
    }
  }
}

_High_BUS_loader_H_1(byte type,dword Time)/*对中*//*0:干扰报文优先级高于发送ID，1:干扰报文优先级低于发送ID*/
{
  byte data[4] = {0x14,0xff,0xff,0xff};
  dword Seed;
  int x;
  diagSetTarget(Cdd_Name);
  _get_Arry("Angle_Calibration");
  Time_Count_Time = 20*60*1000;
  setTimer(Time_Count,Time_Count_Time);
  if(type==0 )
    setTimer(CAN_BUS_loader_H,8);
  else 
    setTimer(CAN_BUS_loader_L,8);
  testWaitForTimeout(10000);
  do{
    _WriteEx_and_Report("","/*------------第 %d 次测试------------*/",x);
    _SetSession(defsession,Time);
    testWaitForTimeout(50);
    _SetSession(exsession,Time);
    testWaitForTimeout(50);
    Seed = _get_seed(phyreq_ID,Time);
    Get_Seed_Flage = 1;
    testWaitForTimeout(50);
    _Send_Key(SendKey_Len,phyreq_ID,Seed,0);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,Time);
    _TestResult(SendData,phyreq_ID,"",-1);
    Get_Seed_Flage = 1;
    testWaitForTimeout(50);
    _Send_Diag(Arry_Len,phyreq_ID,Arry_Data,Time);
    _Check_31Routine_Rx(Arry_Data,1);
    testWaitForTimeout(100);
    _Send_Diag(4,phyreq_ID,data);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,Time);
    _TestResult(SendData,phyreq_ID,"",-1);
    testWaitForTimeout(100);
    _Set_11_Restoration(Time,0);
    
    testWaitForTimeout(CAN_Init_Time-Wait_Time_11+500);
    _85_Check_DTC(1,0);
    x++;
//    ChkCreate_ErrorFramesOccured(0,0,500);
  }while(Time_Flage==0);
  
  if(type==0 )
    cancelTimer(CAN_BUS_loader_H);
  else 
    cancelTimer(CAN_BUS_loader_L);
  cancelTimer(Time_Count);
}
_High_BUS_loader_H_2(byte type,dword Time)/*写DID*//*0:干扰报文优先级高于发送ID，1:干扰报文优先级低于发送ID*/
{
  int i,x;
  dword Seed;
  diagSetTarget(Cdd_Name);
  _get_Str_Traversal("DID_2E_Traversal");
  _get_2E_DID(Traversal_DID[0]);
  if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
  {
    if((DID_2E_SendData_1[0] == 0x2E) && ((DID_2E_SendData_1[1] == 0xF1 && DID_2E_SendData_1[2] == 0xA1) || (DID_2E_SendData_1[1] == 0x21 && DID_2E_SendData_1[1] == 0x00)))
    {
      _Clear_BYD_Config_(0);
      _SetSession(defsession);
      _WriteEx_and_Report("","当前写入为BYD配置字，未防止返回NRC22故写入值为全0");
      DID_2E_SendData_1[1] = 0xF1;
      DID_2E_SendData_1[2] = 0xA1;
      for(i=3;i<DID_2E_SendData_1_Len;i++)
      {
        DID_2E_SendData_1[i] = 0x00;
      }
      DID_2E_SendData_1[DID_2E_SendData_1_Len-1] = 0x55;
      _get_2E_DID(Traversal_DID[0]);
    }
  }
  Time_Count_Time = 20*60*1000;
  setTimer(Time_Count,Time_Count_Time);  
  if(type==0 )
    setTimer(CAN_BUS_loader_H,8);
  else 
    setTimer(CAN_BUS_loader_L,8);
  testWaitForTimeout(10000);
  do{
    _WriteEx_and_Report("","/*------------第 %d 次测试------------*/",x);
    _SetSession(exsession,Time);
    Seed = _get_seed(phyreq_ID,Time);
    testWaitForTimeout(50);
    _Send_Key(SendKey_Len,phyreq_ID,Seed,0);
    Get_Seed_Flage = 1;
    testWaitForTimeout(50);
    _Send_Diag(DID_2E_SendData_1_Len,phyreq_ID,DID_2E_SendData_1,Time);
    _TestResult(SendData,phyreq_ID,"",DID_2E_SendData_1_Response);
    testWaitForTimeout(100);
    if(DID_2E_SendData_1_Response == -1 && Support_Read_2E_DID == 1)
    {
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID,Time);
      _Check_Response_2E(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
    }
    else
      _WriteEx_and_Report("","期望结果为非正响应,不检测写入数据");
    testWaitForTimeout(100);
    
    _Send_Diag(DID_2E_SendData_2_Len,phyreq_ID,DID_2E_SendData_2,Time);
    _TestResult(SendData,phyreq_ID,"",DID_2E_SendData_2_Response);
    testWaitForTimeout(100);
    if(DID_2E_SendData_2_Response == -1 && Support_Read_2E_DID == 1)
    {
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID,Time);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
    }
    else
      _WriteEx_and_Report("","期望结果为非正响应,不检测写入数据");
    testWaitForTimeout(100);
    _Set_11_Restoration(Time,0);
    if(DID_2E_SendData_2_Response == -1 && Support_Read_2E_DID == 1)
    {
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID,Time);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
    }
    x++;
  }while(Time_Flage==0);
  
  if(type==0 )
    cancelTimer(CAN_BUS_loader_H);
  else 
    cancelTimer(CAN_BUS_loader_L);
  cancelTimer(Time_Count);
}
