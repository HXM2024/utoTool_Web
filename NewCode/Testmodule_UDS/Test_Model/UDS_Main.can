Geely_31_SentError()
{
  int i;
  byte Send_Data[10];
  _SetSession(exsession);
  _Set_11_Restoration();
  _TestWaitForTesterConfirmation("断开传感器");
  _unlockECU();
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    Send_Data[0] = 0x31;
    Send_Data[1] = Serve_31_Hex[i].Control_Type[0];
    Send_Data[2] = Serve_31_Hex[i].Routine[0];
    Send_Data[3] = Serve_31_Hex[i].Routine[1];
    if(Serve_31_Hex[i].Routine_Len == 5)
      Send_Data[4] = Serve_31_Hex[i].Control_Option[0][0];
    if(Send_Data[2] == 0x30 && Send_Data[3] == 0x7B)
    {
      _Send_Diag(Serve_31_Hex[i].Routine_Len,phyreq_ID,Send_Data);
      _TestResult(SendData,phyreq_ID,"",NRC31);
      Send_Data[1] = 0x03;
      _Send_Diag(Serve_31_Hex[i].Routine_Len,phyreq_ID,Send_Data);
      _Check_31Routine_Rx(Send_Data,2);
    }
    else
    {
      _Send_Diag(Serve_31_Hex[i].Routine_Len,phyreq_ID,Send_Data);
      _Check_31Routine_Rx(Send_Data,1);
    }
  }
  _TestWaitForTesterConfirmation("恢复传感器");
  _Set_11_Restoration();
}

void BYD_31_0203()
{
  byte Send_Data_31H[4] = {0x31,0x01,0x02,0x03};
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Set_11_Restoration();
  _SetSession(exsession);
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  _SetSession(exsession);
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _K30_OFF();
  testWaitForTimeout(2000);
  _K30_ON();
  testWaitForTimeout(2000);
  _SetSession(exsession);
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Set_CarSpd(3);
  _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
  _TestDisableMsg(Struct_CarSpd.Sig_Id);
  testWaitForTimeout(Struct_CarSpd.Lost_Time*1.2);
  _SetSession(exsession);
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Reset_CarSpd_Invalid();
  _TestEnableMsg(Struct_CarSpd.Sig_Id);
}

void BYD_31_AC00()
{
  byte Send_Data_31H[4] = {0x31,0x01,0xAC,0x00};
  byte Send_Data_31H_Check[4] = {0x31,0x03,0xAC,0x00};
  _Set_Ready(Struct_Ready.Ready_Active);
  _Set_CarSpd(10);
  _TestWaitForTesterConfirmation("转动方向盘，到一定角度后  维持  并点击YES");
  _unlockECU();
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Send_Diag(elcount(Send_Data_31H_Check),phyreq_ID,Send_Data_31H_Check);
  _Check_31Routine_Rx(Send_Data_31H_Check,1);
  _TestWaitForTesterConfirmation("查看当前角度是否接近0°，然后松开方向盘");
  _Set_CarSpd(0);
  _Set_Ready(0);
  _K15_OFF();
  testWaitForTimeout(2000);
  _K15_ON();
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(2000);
  _TestWaitForTesterConfirmation("查看当前角度是否保持在0°附近，查看回正功能是否存在");
  _unlockECU();
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Send_Diag(elcount(Send_Data_31H_Check),phyreq_ID,Send_Data_31H_Check);
  _Check_31Routine_Rx(Send_Data_31H_Check,1);
  _Set_11_Restoration(0);
  _TestWaitForTesterConfirmation("查看当前角度是否保持在0°附近，查看回正功能是否存在");
  _unlockECU();
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Send_Diag(elcount(Send_Data_31H_Check),phyreq_ID,Send_Data_31H_Check);
  _Check_31Routine_Rx(Send_Data_31H_Check,1);
  _Set_CarSpd(10);
  _K30_OFF();
  testWaitForTimeout(2000);
  _K30_ON();
  testWaitForTimeout(2000);
  _TestWaitForTesterConfirmation("查看当前角度是否保持在0°附近，查看回正功能是否存在");
  _unlockECU();
  _Send_Diag(elcount(Send_Data_31H),phyreq_ID,Send_Data_31H);
  _Check_31Routine_Rx(Send_Data_31H,1);
  _Send_Diag(elcount(Send_Data_31H_Check),phyreq_ID,Send_Data_31H_Check);
  _Check_31Routine_Rx(Send_Data_31H_Check,1);
  _TestWaitForTesterConfirmation("查看当前角度是否保持在0°附近，查看回正功能是否存在");
}

