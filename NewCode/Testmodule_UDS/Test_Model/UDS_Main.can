void Geely_31_3080_307B()
{
  byte SendData_Clear[6] = {0x31,0x01,0x30,0x80,0,0};
  byte SendData_Cail[6] = {0x31,0x01,0x30,0x7B,0,0};
  byte SendData_Check[6] = {0x31,0x03,0x30,0x7B,0,0};
  int Send_Len_Clear,Send_Len_Cail,i,j;
  dword Send_ID;
  
  Send_Len_Clear = 4;
  Send_Len_Cail = 4;
  _get_Arry("Clear_Angle_Calibration");
  if(Arry_Len>1)
  {
    Send_Len_Clear = Arry_Len;
    for(i=0;i<Arry_Len;i++)
      SendData_Clear[i] = Arry_Data[i];
  }
  _get_Arry("Angle_Calibration");
  if(Arry_Len>1)
  {
    Send_Len_Cail = Arry_Len;
    for(i=0;i<Arry_Len;i++)
      SendData_Cail[i] = Arry_Data[i];
    for(i=0;i<Arry_Len;i++)
      SendData_Check[i] = Arry_Data[i];
    SendData_Check[1] = 0x03;
  }

  {
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(6000);
    _unlockECU();
    diagStartTesterPresent(Cdd_Name);
    for(i=0;i<2;i++)
    {
      if(i == 0)
        Send_ID = phyreq_ID;
      else
        Send_ID = funreq_ID;
      _Send_Diag(Send_Len_Clear,Send_ID,SendData_Clear);
      _Check_31Routine_Rx(SendData_Clear,1);
      testWaitForTimeout(500);
      _Check_DTC_Res(1,Ang_NotCal,0);
      _Send_Diag(Send_Len_Cail,Send_ID,SendData_Cail);
      _Check_31Routine_Rx(SendData_Cail,1);
      testWaitForTimeout(200);
      _Send_Diag(Send_Len_Cail,Send_ID,SendData_Check);
      _Check_31Routine_Rx(SendData_Check,1);
      testWaitForTimeout(500);
      _Check_DTC_Res(1,0,Ang_NotCal);
      testWaitForTimeout(1000);
      for(j=0;j<3;j++)
      {
        if(j==0)
        {
          _K15_OFF();
          _K30_OFF();
          testWaitForTimeout(3000);
          _K15_ON();
          _K30_ON();
          testWaitForTimeout(7000);
        }
        else if(j==1)
        {
          _Set_Ready(0);
          _Set_CarSpd(0);
          testWaitForTimeout(1000);
          _K15_OFF();
          testWaitForTimeout(3000);
          _K15_ON();
          testWaitForTimeout(500);
          _Set_Ready(Struct_Ready.Ready_Active);
          testWaitForTimeout(6000);
        }
        else
          _TestWaitForTesterConfirmation("转动方向盘");
        _unlockECU();
        _Send_Diag(Send_Len_Clear,Send_ID,SendData_Clear);
        _Check_31Routine_Rx(SendData_Clear,1);
        testWaitForTimeout(500);
        _Check_DTC_Res(1,Ang_NotCal,0);
        _Send_Diag(Send_Len_Cail,Send_ID,SendData_Cail);
        _Check_31Routine_Rx(SendData_Cail,1);
        testWaitForTimeout(200);
        _Send_Diag(Send_Len_Cail,Send_ID,SendData_Check);
        _Check_31Routine_Rx(SendData_Check,1);
        testWaitForTimeout(500);
        _Check_DTC_Res(1,0,Ang_NotCal);
        testWaitForTimeout(1000);
      }
    }
  }
}

