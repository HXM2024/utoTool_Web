_19_Serve_04(dword ID,byte Session) /*19 04*/
{
  int Pos_1904;
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    // if(strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("ChangAn") && ChangAn_New==1)
    //   _WriteEx_and_Report("","长安新平台,此用例不适用");
    // else
    {
      byte DTC_H,DTC_M,DTC_L;
      byte mask;
      byte Data_Send[6] = {0x19,0x04,0,0,0,0};
      char comment[100];
      int i;
      byte Pos_;
      byte Did_Res[500];
      dword Did_Res_Len;
      byte Did_Res2[500];
      dword Did_Res_Len2;
      Pos_ = 1;
      diagStartTesterPresent(Cdd_Name);
      snprintf(comment,elCount(comment),"%s","");
      Pos_1904 = Get_Node_Pos(Node_1904,1);
      DTC_H = (DTC_19[Pos_1904][1]>>16);
      DTC_M = (DTC_19[Pos_1904][1]>>8);
      DTC_L = (DTC_19[Pos_1904][1]&0xFF);
      Data_Send[2] = DTC_H;
      Data_Send[3] = DTC_M;
      Data_Send[4] = DTC_L;
      Data_Send[5] = Freeze_Frame_Number[0];
      Did_Res_Len = 0;
      _Send_Diag(6,ID,Data_Send);
      mask = DTC_19[Pos_1904][2];
      _Check_19_NoFreeze(SendData,"ALL");
      for(i=0;i<mixArray_Len;i++)
        _Step_1904(mixArray[i].Str_DID_1904,0);
      _Close_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      _Check_1904(SendData,mask,"ALL",0,0);//第2步
      for(i=0;i<DiagGetRespPrimitiveSize(SendData);i++)
      {
        Did_Res[i] = diagGetRespPrimitiveByte(SendData,i);
        Did_Res_Len++;
      }
      if(Freeze_Frame_Number_Count > 2)
      {
        Did_Res_Len2 = (Did_Res_Len - 6)*2+6;
        for(i=0;i<Did_Res_Len;i++)
          Did_Res2[i] = Did_Res[i];
        Did_Res2[Did_Res_Len] = Freeze_Frame_Number[1];
        for(i=0;i<Did_Res_Len-7;i++)
          Did_Res2[Did_Res_Len+1+i] = Did_Res[i+7];
        Data_Send[5] = 0xFF;
        _Send_Diag(6,ID,Data_Send);
        _Check_Response_(SendData,Did_Res_Len,Did_Res,0);
      }
      else
      {
        Data_Send[5] = 0xFF;
        _Send_Diag(6,ID,Data_Send);
        _Check_Response_(SendData,Did_Res_Len,Did_Res,0);
      }
      if(Freeze_Frame_Number_Count > 2)
      {
        Data_Send[5] = Freeze_Frame_Number[1];
        Did_Res[6] = Freeze_Frame_Number[1];
        _Send_Diag(6,ID,Data_Send);
        _Check_Response_(SendData,Did_Res_Len,Did_Res,0);
        Data_Send[5] = 0xFF; //装载全部到Did_Res进行判断
        Did_Res_Len = Did_Res_Len2;
        for(i=0;i<Did_Res_Len;i++)
          Did_Res[i] = Did_Res2[i];
      }
      if(Pos_1904 == 1)
        Pos_ = 0;
      DTC_H = (DTC_19[Pos_][1]>>16);
      DTC_M = (DTC_19[Pos_][1]>>8);
      DTC_L = (DTC_19[Pos_][1]&0xFF);
      Data_Send[2] = DTC_H;
      Data_Send[3] = DTC_M;
      Data_Send[4] = DTC_L;
      _Send_Diag(6,ID,Data_Send);
      _Check_19_NoFreeze(SendData,"ALL");
      DTC_H = (DTC_19[Pos_1904][1]>>16);
      DTC_M = (DTC_19[Pos_1904][1]>>8);
      DTC_L = (DTC_19[Pos_1904][1]&0xFF);
      Data_Send[2] = DTC_H;
      Data_Send[3] = DTC_M;
      Data_Send[4] = DTC_L;
      _Open_One_Node(DTC_19[Pos_1904]);
      testWaitForTimeout(2000);
      _Send_Diag(6,ID,Data_Send);
      _Check_Response_(SendData,Did_Res_Len,Did_Res,0);
      for(i=0;i<mixArray_Len;i++)
        _Step_1904(mixArray[i].Str_DID_1904,1);
      testWaitForTimeout(2000);
      _Close_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      if(Clear_1904==0)
      {
        _Check_1904(SendData,mask,"ALL",0,0);//第5步
      }
      else
        _Check_Response_(SendData,Did_Res_Len,Did_Res,0);
      _Open_One_Node(DTC_19[Pos_1904]);
      testWaitForTimeout(2000);
      for(i=0;i<mixArray_Len;i++)
        _Step_1904(mixArray[i].Str_DID_1904,2);
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _Close_One_Node(DTC_19[Pos_1904]);
      _K15_ON();
      testWaitForTimeout(CAN_Init_Time + 1000);
      _Open_One_Node(DTC_19[Pos_1904]);
      testWaitForTimeout(1000);
      _Send_Diag(6,ID,Data_Send);
      if(Clear_1904==0)
      {
        _Check_1904(SendData,mask,"ALL",0,0);//  第6步
      }
      else
        _Check_Response_(SendData,Did_Res_Len,Did_Res,0);
      _Close_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      if(Clear_1904==0)
      {
        _Check_1904(SendData,mask,"ALL",0,0);//   第7步
      }
      else
        _Check_Response_(SendData,Did_Res_Len,Did_Res,0);
      _Open_One_Node(DTC_19[Pos_1904]);
      testWaitForTimeout(1000);
      _Clear_DTC(phyreq_ID);
      for(i=0;i<mixArray_Len;i++)
        _Step_1904(mixArray[i].Str_DID_1904,3);
      _Close_One_Node(DTC_19[Pos_1904]);
      _Send_Diag(6,ID,Data_Send);
      _Check_1904(SendData,mask,"ALL",0,0);//  第9步
      _Open_One_Node(DTC_19[Pos_1904]);
      testWaitForTimeout(1000);
      _Clear_DTC(phyreq_ID);
      testWaitForTimeout(1000);
      _Send_Diag(6,ID,Data_Send);
      _Check_19_NoFreeze(SendData,"ALL");
      _Set_Battery(12);
    }
   }
}

_19_Serve_05(dword ID,byte Session) /*19 04单个快照信息*/
{
  int Pos_1904;
  char Check_Str[100];
  char Temp_Value_1[1000];
  char Temp_Value_2[1000];
  char Data_Str_[100][50];
  int i,j,len_Read;
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");

  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    GlbHandlefile = OpenFileRead (file_name_1,0);
    getProfileString(ECU_project,"Freeze_Frame","Null",Temp_Value_2, 1000, file_name_1);
    fileClose(GlbHandlefile);
    for(i=0;i<elcount(Temp_Value_2);i++)
    {
      if(Temp_Value_2[i]==91)
      {
        for(j=i+1;j<500;j++)
        {
          if(Temp_Value_2[j]==93)
          {
            snprintf(Data_Str_[len_Read],elcount(Temp_Value_1),"%s",Temp_Value_1);
            len_Read++;
            snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
            break;
          }
          else
            snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_2[j]);
        }
      }
    }
    if(Session != defsession)
      diagStartTesterPresent(Cdd_Name);
    for(i=0;i<mixArray_Len;i++)
    {
      snprintf(Check_Str,elCount(Check_Str),"%s","");
      snprintf(Check_Str,elCount(Check_Str),"%s",Data_Str_[i]);
      writeEx(-3,0,"----------------------------------------------");
      _WriteEx_and_Report("开始测试 : ",Check_Str);
      writeEx(-3,0,"----------------------------------------------");
      _Fun_1904(Check_Str,ID,Session);
    }
    diagStopTesterPresent(Cdd_Name);
  }
}
