              _SetSession(Session);
              snprintf(str,elCount(str),"%s","");
              if(i==0)
                snprintf(str,elCount(str),"控制力矩不满足NRC22条件,小于 %.2f Nm,并保持",NRC22_TasTorque-0.2);
              else
                snprintf(str,elCount(str),"控制力矩不满足NRC22条件,小于 %.2f Nm,并保持",(NRC22_TasTorque-0.2)*(-1));
              testWaitForTesterConfirmation(str,30000);
              _Send_Diag(2,ID,Send_Data);
              _TestResult(SendData,ID,"",-1);
              testWaitForTimeout(2000);
              _Send_And_Check_NowSession(ID,defsession); 
              if(Session== exsession && diagGetLastResponseCode(SendData)>0)
              {
                _Send_Diag(2,phyreq_ID,Send_Key);
                _TestResult(SendData,phyreq_ID,"",-1);
              }
              else
              {
                _Send_Diag(2,phyreq_ID,Send_Key);
                _TestResult(SendData,phyreq_ID,"",NRC7F);
              }
              snprintf(str,elCount(str),"%s","");
              snprintf(str,elCount(str),"松开方向盘");
              testWaitForTesterConfirmation(str,30000);
              testWaitForTimeout(2000);
          }
        }
        else
          _WriteEx_and_Report("","无NRC22力矩条件");
      }
      else
        _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[i]);
    }
  }
}

void _Serve11_06_Fac_Battery(dword ID,byte Session)   /*NRC22_工厂模式_电压*/
{
  int Serve_Pos,NRC22_Flage;
  int i,j;
  byte Send_Data[2],Send_Key[2];
  char str[300];
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持11服务,跳过检测");
  else
  {
    _WriteEx_and_Report("","测试工厂模式NRC22电压条件");
    Send_Data[0] = 0x11;
    Send_Key[0] = 0x27;
    Send_Key[1] = RequestSeed_27;
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
      {
        NRC22_Flage = _Set_NRC22(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],2);
        if(NRC22_Flage == -1)
          _WriteEx_and_Report("","无NRC22条件");
        else if((NRC22_Flage &0x02) != 0)
        {
            if(i==0)
              _Factory_Mode(0);
            _SetSession(Session);
            _Set_Battery(NRC22_Battery_Low - 0.2);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",NRC22);
            _Send_And_Check_NowSession(ID,Session); 
              testWaitForTimeout(2000);
            if(Session== exsession && diagGetLastResponseCode(SendData)>0)
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",-1);
            }
            else
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",NRC7F);
            }
            _SetSession(Session);
            _Set_Battery(NRC22_Battery_Low + 0.3);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",-1);
              testWaitForTimeout(2000);
            _Send_And_Check_NowSession(ID,defsession); 
            if(Session== exsession && diagGetLastResponseCode(SendData)>0)
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",-1);
            }
            else
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",NRC7F);
            }
            _SetSession(Session);
            _Set_Battery(NRC22_Battery_Hight + 0.3);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",NRC22);
            _Send_And_Check_NowSession(ID,Session); 
              testWaitForTimeout(2000);
            if(Session== exsession && diagGetLastResponseCode(SendData)>0)
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",-1);
            }
            else
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",NRC7F);
            }
            _SetSession(Session);
            _Set_Battery(NRC22_Battery_Hight - 0.2);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",-1);
              testWaitForTimeout(2000);
            _Send_And_Check_NowSession(ID,defsession); 
            if(Session== exsession && diagGetLastResponseCode(SendData)>0)
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",-1);
            }
            else
            {
              _Send_Diag(2,phyreq_ID,Send_Key);
              _TestResult(SendData,phyreq_ID,"",NRC7F);
            }
            _Set_Battery(12);
            _Factory_Mode(1);
        }
        else
          _WriteEx_and_Report("","无NRC22电压条件");
      }
      else
        _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[i]);
    }
  }
}
void _Serve11_06_Battery(dword ID,byte Session)   /*NRC22_电压*/
{
  int Serve_Pos,NRC22_Flage;
  int i,j;
  byte Send_Data[2],Send_Key[2];
  char str[300];
  
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持11服务,跳过检测");
  else
  {
    _WriteEx_and_Report("","测试NRC22电压条件");
    Send_Data[0] = 0x11;
    Send_Key[0] = 0x27;
    Send_Key[1] = RequestSeed_27;
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
      {
        NRC22_Flage = _Set_NRC22(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],2);
        if(NRC22_Flage == -1)
          _WriteEx_and_Report("","无NRC22条件");
        else if((NRC22_Flage &0x02) != 0)
        {
          if(i==0)
          {
            if(strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0)
              _Factory_Mode(1);
          }
          _SetSession(Session);
          _Set_Battery(NRC22_Battery_Low - 0.2);
          _Send_Diag(2,ID,Send_Data);
          _TestResult(SendData,ID,"",NRC22);
          _Send_And_Check_NowSession(ID,Session); 
            testWaitForTimeout(2000);
          if(Session== exsession && diagGetLastResponseCode(SendData)>0)
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",-1);
          }
          else
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",NRC7F);
          }
          _SetSession(Session);
          _Set_Battery(NRC22_Battery_Low + 0.3);
          _Send_Diag(2,ID,Send_Data);
          _TestResult(SendData,ID,"",-1);
            testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,defsession); 
          if(Session== exsession && diagGetLastResponseCode(SendData)>0)
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",-1);
          }
          else
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",NRC7F);
          }
          _SetSession(Session);
          _Set_Battery(NRC22_Battery_Hight + 0.3);
          _Send_Diag(2,ID,Send_Data);
          _TestResult(SendData,ID,"",NRC22);
            testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,Session); 
          if(Session== exsession && diagGetLastResponseCode(SendData)>0)
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",-1);
          }
          else
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",NRC7F);
          }
          _SetSession(Session);
          _Set_Battery(NRC22_Battery_Hight - 0.2);
          _Send_Diag(2,ID,Send_Data);
          _TestResult(SendData,ID,"",-1);
            testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,defsession); 
          if(Session== exsession && diagGetLastResponseCode(SendData)>0)
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",-1);
          }
          else
          {
            _Send_Diag(2,phyreq_ID,Send_Key);
            _TestResult(SendData,phyreq_ID,"",NRC7F);
          }
          _Set_Battery(12);
          if(strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0)
            _Factory_Mode(1);
        }
        else
          _WriteEx_and_Report("","无NRC22电压条件");
      }
      else
        _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[i]);
    }
  }
}
void _Serve11_07(dword ID,byte Session)   /*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[100];
  
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(_Check_Serve_IDAndSess(0x11,ID,Session) == 1)
  {
    Send_Data[0] = 0x11;
    _Set_NRC_Step(0x11,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[0]);
}

void _Serve11_08(dword ID,byte Session)/*  NRC22-吉利3.0*/
{
  byte Send_Data_01[2] = {0x11,0x01};
  byte Send_Data_81[2] = {0x11,0x81};
  char Serve_85_CarSpdQFTemp[10];
  byte Serve_85_CarSpdQF[10];
  int Serve_85_CarSpdQF_Count;
  int i,j;
  Serve_85_CarSpdQF_Count = getProfileArray(ECU_project,"Serve_85_CarSpdQF",Serve_85_CarSpdQFTemp,elCount(Serve_85_CarSpdQFTemp),file_name_1);
  for(i=0;i<Serve_85_CarSpdQF_Count;i++)
    Serve_85_CarSpdQF[i] = Serve_85_CarSpdQFTemp[i];
  
  diagStartTesterPresent(Cdd_Name);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  
  for(j=0;j<7;j++)
  {
    diagStartTesterPresent(Cdd_Name);
    if(j==1)
      _Set_CarSpd(NRC22_CarSpd+1);
    else 
      _Set_CarSpd(NRC22_CarSpd-1);
    
    _Set_Ready(0xB);
    _Set_CarSpd_Invalid(3);
    if(j==0 || j==1)  /*此用例测试VehSpdLgtQf=2或3能支持85服务，需要遍历VehSpdLgtQf值*/
    {
      _WriteEx_and_Report("","测试支持11服务的VehSpdLgtQf，需要遍历VehSpdLgtQf值");
      for(i=0;i<4;i++)
      {
        _Set_CarSpd_Invalid(i);
        testWaitForTimeout(1000);
        if((_Check_Dword_in_Num(i,Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)!= -1) && j == 0)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",0);
          StepForGeelyServe11(Session);
        }
        else
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
        }
      }
      if(j==1)
      {
        _Set_CarSpd_Invalid(0);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
        _Send_Diag(2,ID,Send_Data_01);
        _TestResult(SendData,ID,"",-1);
        StepForGeelyServe11(Session);
        _Send_Diag(2,ID,Send_Data_81);
        _TestResult(SendData,ID,"",-1);
        StepForGeelyServe11(Session);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        _WriteEx_and_Report("","步骤5-9测试结束");
      }
      else
        _WriteEx_and_Report("","步骤1-4测试结束");
    }
    else if(j==2)  /*此用例测试Usgmode≠0xD(driving)能支持85服务，需要遍历Usgmode值以及丢失*/
    {
      _WriteEx_and_Report("","此用例测试Usgmode≠0xD(driving)能支持11服务，需要遍历Usgmode值以及丢失");
      for(i=0;i<5;i++)
      {
        byte Temp[5]={0,1,2,0xB,0xD};
        _Set_Ready(Temp[i]);
        testWaitForTimeout(1000);
        _Send_Diag(2,ID,Send_Data_01);
        if(Temp[i]==0xD)
          _TestResult(SendData,ID,"",Ready_NRC);
        else
        {
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
        }
        _Send_Diag(2,ID,Send_Data_81);
        if(Temp[i]==0xD)
          _TestResult(SendData,ID,"",Ready_NRC);
        else
        {
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
        }
      }
      _Set_Ready(0xD);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(3000);
      _Send_Diag(2,ID,Send_Data_01);
      _TestResult(SendData,ID,"",-1);
      StepForGeelyServe11(Session);
      _Send_Diag(2,ID,Send_Data_81);
      _TestResult(SendData,ID,"",-1);
      StepForGeelyServe11(Session);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      _WriteEx_and_Report("","步骤10-15测试结束");
    }
    else if(j==3)/*测试电压条件*/
    { 
      float Temp[4]={1,2,3,4};
      _WriteEx_and_Report("","测试电压条件");
      Temp[0]=NRC22_Battery_Low+0.2;
      Temp[1]=NRC22_Battery_Hight-0.2;
      Temp[2]=NRC22_Battery_Low-0.2;
      Temp[3]=NRC22_Battery_Hight+0.2;
      for(i=0;i<4;i++)
      {
        _Set_Battery(Temp[i]);
        if(i<2)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
        }
        else if(i==2)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",L_Battery_NRC);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",L_Battery_NRC);
        }
        else if(i==3)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",H_Battery_NRC);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",H_Battery_NRC);
        }
      }
      _Set_Battery(12);
      _WriteEx_and_Report("","步骤16-19测试结束");
    }
    else if(j==4)/*Usgmode(0x2E0:VehModMngtGlbSafe1)=0xD，车速<3km/h，VehSpdLgtQf=3，电压为13.5V时丢失0xE0节点发送报文：*/
    {
      _WriteEx_and_Report("","Usgmode(0x2E0:VehModMngtGlbSafe1)=0xD，车速<3km/h，VehSpdLgtQf=3，电压为13.5V时丢失0xE0节点发送报文");
      _Set_Ready(0xD);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(5000);
      _Send_Diag(2,ID,Send_Data_01);
      _TestResult(SendData,ID,"",Ready_NRC);
      _Send_Diag(2,ID,Send_Data_81);
      _TestResult(SendData,ID,"",Ready_NRC);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _Set_Ready(0xB);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(5000);
      _Send_Diag(2,ID,Send_Data_01);
      _TestResult(SendData,ID,"",-1);
      StepForGeelyServe11(Session);
      _Send_Diag(2,ID,Send_Data_81);
      _TestResult(SendData,ID,"",-1);
      StepForGeelyServe11(Session);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _WriteEx_and_Report("","步骤20-21测试结束");
    }
    else if(j==5)/*步骤22&23、VehSpdLgtQf不满足；步骤24、车速不满足；步骤25&26、VehSpdLgtQf满足取值遍历*/
    {
      int Qf[4] = {1,0,2,3};
      _Set_Ready(0xD);
      _WriteEx_and_Report("","步骤22&23：VehSpdLgtQf不满足。步骤24：车速不满足。步骤25&26：VehSpdLgtQf满足取值遍历");
      _WriteEx_and_Report("","步骤22，步骤23，步骤25，步骤26");
      for(i=0;i<4;i++)
      {
        _Set_CarSpd_Invalid(Qf[i]);
        testWaitForTimeout(500);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(2000);
        if(_Check_Dword_in_Num(Qf[i],Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)!= -1)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
        }
        else
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
        }
        _TestEnableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(2000);
      }
      _WriteEx_and_Report("","步骤24，放于循环外测试");
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_CarSpd_Invalid(2);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _Send_Diag(2,ID,Send_Data_01);
      _TestResult(SendData,ID,"",CarSpd_NRC);
      _Send_Diag(2,ID,Send_Data_81);
      _TestResult(SendData,ID,"",CarSpd_NRC);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("","步骤22-26测试结束");
    }
    else if(j==6)/*在Usgmode不满足且Usgmode和车速均丢失的前提下设计以下电压临界值步骤情况*/
    {
      float Temp[4]={1,2,3,4};
      _WriteEx_and_Report("","在Usgmode不满足且Usgmode和车速均丢失的前提下设计以下电压临界值步骤情况");
      Temp[0]=NRC22_Battery_Low+0.2;
      Temp[1]=NRC22_Battery_Hight-0.2;
      Temp[2]=NRC22_Battery_Low-0.2;
      Temp[3]=NRC22_Battery_Hight+0.2;
      _Set_Ready(0xD);
      _Set_CarSpd_Invalid(3);
      _Set_CarSpd(NRC22_CarSpd-1);
      testWaitForTimeout(1000);
      for(i=0;i<4;i++)
      {
        _Set_Battery(Temp[i]);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(2000);
        if(i<2)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",-1);
          StepForGeelyServe11(Session);
        }
        else if(i==2)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",L_Battery_NRC);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",L_Battery_NRC);
        }
        else if(i==3)
        {
          _Send_Diag(2,ID,Send_Data_01);
          _TestResult(SendData,ID,"",H_Battery_NRC);
          _Send_Diag(2,ID,Send_Data_81);
          _TestResult(SendData,ID,"",H_Battery_NRC);
        }
        _TestEnableMsg(Struct_Ready.Sig_Id);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(1000);
      }
      _Set_Battery(12);
      _WriteEx_and_Report("","步骤27-30测试结束");
    }
  }
  _Set_CarSpd(0);
  _Reset_CarSpd_Invalid();
}

void _Serve14_01(dword ID,byte Session) // 14 FF FF FF
{
  byte Temp[1];
  byte Temp_3[2] = {0x11,0x01};
  
  _Set_Ready(0);
  _Power_Down();
  testWaitForTimeout(1000); 
  _Power_Up(); //上下电排除之前DTC的干扰
  StepByGeely3_0(0x19,1);
  testWaitForTimeout(CAN_Init_Time);
  if(Session != defsession)
  {
    _SetSession(Session);
    diagStartTesterPresent(Cdd_Name);
  }
  testWaitForTimeout(200);
  _WriteEx_and_Report("步骤1","丢失所有节点再恢复，制造车速节点当前故障，读取故障并清除");
  _Close_All();
  testWaitForTimeout(5000);
  _Open_All();
  testWaitForTimeout(4000);
  _TestDisableMsg(Struct_CarSpd.Sig_Id);
  testWaitForTimeout(Struct_CarSpd.Lost_Time*1.2);
  _Send_09_Fault(phyreq_ID);
  _Check_DTC_Mask(Diag09,Struct_CarSpd.Lost_DTC,0x9);
  // _Check_DTC(Diag09,Struct_CarSpd.Lost_DTC);
  _Clear_DTC(ID);
  Temp[0] = 0x54;
  _Check_Response(ClearDTC,1,Temp);
  _WriteEx_and_Report("步骤2","故障成熟前后分别读取DTC");
  testWaitForTimeout(10);
  _85_Check_DTC(9,0);
  testWaitForTimeout(Struct_CarSpd.Lost_Time*1.2);
  _Send_09_Fault(phyreq_ID);
  _Check_DTC_Mask(Diag09,Struct_CarSpd.Lost_DTC,0x09);
  
  if(_Check_Serve(0x11,0x01,4) != -1)
  {
    
    _WriteEx_and_Report("步骤3","当前支持11 01进行复位相关测试");
    if((Session == defsession) && (_Check_Serve(0x11,0x01,2)==4) && (_Check_Serve(0x11,0x01,5) == 0))
      _SetSession(exsession);
    if(_Check_Serve(0x11,0x01,5) == 1)
      _unlockECU();
    _Send_Diag(2,phyreq_ID,Temp_3);
    _TestResult(SendData,phyreq_ID,"",-1);
    testWaitForTimeout(Wait_Time_11 + CAN_Init_Time + Struct_CarSpd.Lost_Time*1.2);
    if(Session != defsession)
      _SetSession(Session);
    
    _Send_09_Fault(phyreq_ID);
    _Check_DTC_Mask(Diag09,Struct_CarSpd.Lost_DTC,0x09);
    _WriteEx_and_Report("步骤4","恢复节点使其成为历史故障，读取故障");
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _Send_09_Fault(phyreq_ID);
    _Check_DTC_Mask(Diag09,Struct_CarSpd.Lost_DTC,0x08);
    _WriteEx_and_Report("步骤5","清除故障，等待故障成熟时间后再次读取故障");
    _Clear_DTC(ID);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _Check_DTC_Res(0x09,0,Struct_CarSpd.Lost_DTC);
    _WriteEx_and_Report("步骤6","重启后再次读取故障");
    if((Session == defsession) && (_Check_Serve(0x11,0x01,2)==4) && (_Check_Serve(0x11,0x01,5) == 0))
      _SetSession(exsession);
    if(_Check_Serve(0x11,0x01,5) == 1)
      _unlockECU();
    _Send_Diag(2,phyreq_ID,Temp_3);
    _TestResult(SendData,phyreq_ID,"",-1);
    testWaitForTimeout(Wait_Time_11 + CAN_Init_Time + Struct_CarSpd.Lost_Time*1.2);
    if(Session != defsession)
      _SetSession(Session);
    _Check_DTC_Res(0x09,0,Struct_CarSpd.Lost_DTC);
  }
}

void _Serve14_02(dword ID) //NRC13
{
  byte Temp_0[4]={0x14,0xff,0xff,0xff};
  dword Len;
  Len = _Check_CANFD_Flage();
  _WriteEx_and_Report("遍历","14 FF FF FF服务长度");
  for(i=1;i<=Len;i++)
  {
    if(i==4)
    {
      _WriteEx_and_Report("","当前长度已测试，跳过");
      continue;
    }
    _Send_Diag(i,ID,Temp_0);
    if(ID == phyreq_ID)
      _TestResult(SendData,ID,"",NRC13);
    else if(ID == funreq_ID && Fun_NRC13 == 1)
      _TestResult(SendData,ID,"",NRC13);
    else if(ID == funreq_ID && Fun_NRC13 == 0)
      _Check_NoResponse(SendData);
  }
}

void _Serve14_03(dword ID) //清除指定DTC
{
  byte Temp_0[4]={0x14,0xff,0xff,0xff};
  int i = 0;
  if(Clear_DTC_Ex == 0)   //不支持清除指定DTC
  {
    for(i=0;i<ALL_DTC_Num;i++)
    {
      Temp_0[1] = (ALL_DTC[i]>>16) &0xFF;
      Temp_0[2] = (ALL_DTC[i]>>8) &0xFF;
      Temp_0[3] = ALL_DTC[i] &0xFF;
      
      _Send_Diag(4,ID,Temp_0);
      _TestResult(SendData,ID,"",NRC31);
      testWaitForTimeout(30);
    }
  }
  else
  {
    byte Get_19[3]={0x19,0x02,0x09};
    dword DTC_Res[255],Res_Len;
    dword DTC_Res_2[255],Res_Len_2;
    byte DTC_ResCount;
    byte DTC_ResCount_2;
    dword DTC_ResCheck[255];
    byte DTC_ResCount_Check;
    dword DTC_NotRes[255];
    byte DTC_NotResCount;
    int n;
    DTC_ResCount = 0;
    DTC_NotResCount = 0;
    DTC_ResCount_Check =0;
    Get_19[2] = 0x09;
    diagStartTesterPresent(Cdd_Name);
    {        
      int m;
      StepByGeely3_0(0x19,1);
      for(m=0;m<DTC_19_Count;m++)
      {
        if(DTC_19[m][0] == Struct_Ready.Sig_Id && Geely3_Flage == 1)
          continue;
        _TestDisableMsg(DTC_19[m][0]);
      }
      testWaitForTimeout(3000);  //制造当前故障
      for(m=0;m<DTC_19_Count;m++)
        _TestEnableMsg(DTC_19[m][0]);
      testWaitForTimeout(3000);  //转为历史故障
      for(m=0;m<Node_Invalid_Count;m++)
      {
        if(Node_Invalid[m].Node == Struct_Ready.Sig_Id && Geely3_Flage == 1)
          continue;
        _Set_Sig(Node_Invalid[m].Signal_Name,Node_Invalid[m].Invalid_Value);
        testWaitForTimeout(Node_Invalid[m].Time*1.2);
        _Set_Sig(Node_Invalid[m].Signal_Name,Node_Invalid[m].Normal_Value);
        testWaitForTimeout(Node_Invalid[m].Time*1.2);
        // _Invalid_Node(Node_Invalid[m].Node);
        // _Set_Sig(Node_Invalid[i].Signal_Name,Node_Invalid[i].Invalid_Value);
        // testWaitForTimeout(500);
        // _Recover_Invalid_Node(Node_Invalid[m].Node);
        // testWaitForTimeout(500);
      }
      _Send_Diag(3,ID,Get_19);
      if(diagGetLastResponseCode(SendData)==0)
        testWaitForDiagResponse(SendData,2000);
      if(diagGetLastResponseCode(SendData)!= -1)
        testStepFail("","未收到正响应");
      else
      {
        Res_Len = DiagGetRespPrimitiveSize(SendData);
        DTC_ResCount = (Res_Len - 3)/4;
        for(i=0;i<DTC_ResCount;i++)
          DTC_Res[i] = (diagGetRespPrimitiveByte(SendData,i*4+3+0)<<16) | (diagGetRespPrimitiveByte(SendData,i*4+3+1)<<8) | (diagGetRespPrimitiveByte(SendData,i*4+3+2));
          
        for(i=0;i<DTC_19_Count;i++)
        {
          if(_Check_Dword_in_Num(DTC_19[i][1],DTC_Res,DTC_ResCount) == -1)
          {
            testStepFail("","0x%06X未在返回数据中",DTC_19[i][1]);
            DTC_NotRes[DTC_NotResCount] = DTC_19[i][1];
            DTC_NotResCount++;
          }
        }
        for(i=0;i<Node_Invalid_Count;i++)
        {
          if(_Check_Dword_in_Num(Node_Invalid[i].DTC,DTC_Res,DTC_ResCount) == -1)
          {
            testStepFail("","0x%06X未在返回数据中",Node_Invalid[i].DTC);
            DTC_NotRes[DTC_NotResCount] = DTC_19[i][1];
            DTC_NotResCount++;
          }
        }
        if(DTC_NotResCount == 0)
          testStepPass("","所有网络节点DTC均已获取到");
        //确保仅清除指定DTC
        for(i=0;i<DTC_ResCount;i++)
          DTC_ResCheck[i] = DTC_Res[i];
        DTC_ResCount_Check = DTC_ResCount;
        for(i=0;i<DTC_ResCount;i++)
        {
          DTC_ResCount_2 = 0;
          Res_Len_2 = 0;
          Temp_0[1] = (DTC_Res[i]>>16) &0xFF;
          Temp_0[2] = (DTC_Res[i]>>8) &0xFF;
          Temp_0[3] = DTC_Res[i] &0xFF;
          _Send_Diag(4,ID,Temp_0);
          _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(200);/*增加200ms延时防止14服务响应过快但实际未处理完成*/
          _Send_Diag(3,ID,Get_19);
          if(diagGetLastResponseCode(SendData)==0)
            testWaitForDiagResponse(SendData,2000);
          if(diagGetLastResponseCode(SendData)!= -1)
            testStepFail("","未收到正响应");
          else
          {
            Res_Len_2 = DiagGetRespPrimitiveSize(SendData);
            DTC_ResCount_2 = (Res_Len_2 - 3)/4;
            for(n=0;n<DTC_ResCount_2;n++)
              DTC_Res_2[n] = (DiagGetPrimitiveByte(SendData,n*4+3+0)<<16) | (DiagGetPrimitiveByte(SendData,n*4+3+1)<<8) | (DiagGetPrimitiveByte(SendData,n*4+3+2));  //14清除后再次获取到的所有反馈DTC
            if(_Check_Dword_in_Num(DTC_Res[i],DTC_Res_2,DTC_ResCount_2) == -1)
              testStepPass("","指定DTC: 0x%X ,已被清除",DTC_Res[i]);
            else
              testStepFail("","指定DTC: 0x%X ,未被清除",DTC_Res[i]);
            if(DTC_ResCount_2!= DTC_ResCount_Check -1)
            {
              if(_Check_Dword_in_Num(DTC_Res[i],DTC_Whitelist,DTC_Whitelist_Count) == -1) //待清除DTC不在白名单中
              {
                if(DTC_ResCount_2 < DTC_ResCount_Check-1)
                  testStepFail("","有其余DTC被清除");
                else
                  testStepFail("","当前DTC个数与上次一致且待清除DTC不在白名单中,0x14未成功清除或出现新的DTC");
              }
              else
                _WriteEx_and_Report("","当前为白名单中故障,DTC清除后再次成熟");
            }
            
            //再获取第二次反馈的值做下一次判断的初始数组
            for(n=0;n<DTC_ResCount_2;n++)
              DTC_ResCheck[n] = DTC_Res_2[n];
            DTC_ResCount_Check = DTC_ResCount_2;
          }
        }
        //其余DTC仅判断正响应
        for(i=0;i<ALL_DTC_Num;i++)
        {
          if(_Check_Dword_in_Num(ALL_DTC[i],DTC_Res,DTC_ResCount) != -1)
            continue;
          Temp_0[1] = (ALL_DTC[i]>>16) &0xFF;
          Temp_0[2] = (ALL_DTC[i]>>8) &0xFF;
          Temp_0[3] = ALL_DTC[i] &0xFF;
          _Send_Diag(4,ID,Temp_0);
          _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(500);
        }

        _WriteEx_and_Report("","重启后检测无其余故障");
        _Set_11_Restoration();
        testWaitForTimeout(CAN_Init_Time + 2000);
        _85_Check_DTC(9,0);
      }
    }
  }
}

void _Serve14_05(dword ID,dword Session)  /*NRC31*/
{
  byte Temp_0[4]={0x14,0xff,0xff,0xff};
  byte Send_14;
  int i,Flage;
  dword DTC_Check;
  Init_For_14();
  if(ID == phyreq_ID && Session == defsession)
    Send_14 = Serve_14_31[0];
  else if(ID == phyreq_ID && Session == exsession)
    Send_14 = Serve_14_31[1];
  else if(ID == funreq_ID && Session == defsession)
    Send_14 = Serve_14_31[2];
  else if(ID == funreq_ID && Session == exsession)
    Send_14 = Serve_14_31[3];
  Flage = 0;
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历14服务NRC31数据时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  if(Clear_DTC_Ex == 0)   //不支持清除指定DTC
  {
    for(i=0;i<ALL_DTC_Num;i++)
    {
      Temp_0[1] = (ALL_DTC[i]>>16) &0xFF;
      Temp_0[2] = (ALL_DTC[i]>>8) &0xFF;
      Temp_0[3] = ALL_DTC[i] &0xFF;
      
      _Send_Diag(4,ID,Temp_0);
      if(ID == phyreq_ID)
        _TestResult(SendData,ID,"",NRC31);
      else if(ID == funreq_ID)
        _Check_NoResponse(SendData);
    }
  }
  else
  {
    int Byte_M,Byte_L;
    Temp_0[1] = Send_14;
    for(Byte_M = 0;Byte_M <= 0xFF;Byte_M++) 
    {
      Temp_0[2] = Byte_M;
      for(Byte_L = 0;Byte_L <= 0xFF;Byte_L++)
      {
        Temp_0[3] = Byte_L;
        DTC_Check =( (Temp_0[1] << 16) | (Byte_M << 8) | (Byte_L) );
        if( _Check_Dword_in_Num(DTC_Check,ALL_DTC,ALL_DTC_Num) == -1)
        {
          _Send_Diag(4,ID,Temp_0);
          Flage = _TestResult(SendData,ID,"",NRC31);
          if(Flage == -1)
          {
            char Str[50];
            snprintf(Str,elCount(Str),"[ 0x%02X 0x%02X 0x%02X ] \n",Send_14,Byte_M,Byte_L);
            File_Write(Error_File,Error_FileName,Str,2);
          }
        }
      }
    }
  }
}

void _Serve14_06(dword ID,dword Session)  /*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[100];
  
  Serve_Pos = _Check_Serve(0x14,0,0);
  if(_Check_Serve_IDAndSess(0x14,ID,Session) == 1)
  {
    Send_Data[0] = 0x14;
    _Set_NRC_Step(0x14,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
}

void _Serve14_07(dword ID,dword Session)  /*状态20/27测试*/
{
  dword DTC[100];
  byte Send[3] = {0x19,0x02,0x20};
  int i;
  if(Geely3_Flage == 1)
  {
    _Set_Ready(0);
    _Power_Down();
    testWaitForTimeout(1000); 
    _Power_Up(); //上下电排除之前DTC的干扰
    StepByGeely3_0(0x19,1);
    if(Session != defsession)
    {
      _SetSession(Session);
      diagStartTesterPresent(Cdd_Name);
    }
    _WriteEx_and_Report("Step","步骤1");
    testWaitForTimeout(200);
    _Close_All();
    testWaitForTimeout(5000);
    _Open_All();
    testWaitForTimeout(6000);
    for(i=0;i<DTC_19_Count;i++)
      DTC[i] = DTC_19[i][1];
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _Check_DTC(9,DTC);
    _Clear_DTC(ID);
    _Check_DTC_Res(0x09,0,Struct_CarSpd.Lost_DTC);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _Check_DTC_Res(0x09,Struct_CarSpd.Lost_DTC,0);
    _Set_11_Restoration();
    testWaitForTimeout(6000);
    _Check_DTC_Res(0x09,Struct_CarSpd.Lost_DTC,0);


    _WriteEx_and_Report("Step","步骤2");
    if(Session != defsession)
      _SetSession(Session);
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _Check_DTC_Res_InHis_NotNowOrHis(0x09,Struct_CarSpd.Lost_DTC,0);
    _Clear_DTC(ID);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _Check_DTC_Res(9,0,Struct_CarSpd.Lost_DTC);
    _Set_11_Restoration();
    testWaitForTimeout(6000);
    _Check_DTC_Res(9,0,Struct_CarSpd.Lost_DTC);

    _WriteEx_and_Report("Step","步骤3");
    if(Session != defsession)
      _SetSession(Session);
    _Close_All();
    testWaitForTimeout(5000);
    _Open_All();
    testWaitForTimeout(6000);
    Send[2] = 0x20;
    _Send_Diag(3,ID,Send);
    _Check_Response_DTC(SendData,DTC);
    _Clear_DTC(ID);
    testWaitForTimeout(3000);
    for(i=0;i<DTC_19_Count;i++)
      DTC[i] = 0;
    _Send_Diag(3,ID,Send);
    _Check_Response_DTC(SendData,DTC);
    _Clear_DTC(ID);
    testWaitForTimeout(3000);
    Send[2] = 0x27;
    _Send_Diag(3,ID,Send);
    _Check_Response_DTC(SendData,DTC);
  }
  else
    _WriteEx_and_Report("","非Geely3.0平台及以上项目，不测试此项内容");
}

void _Serve22_01(dword ID,byte Session)/*遍历需要判断的数据*/
{
  byte Temp_DID[3]={0x22,0x00,0x00};
  char Temp_Str[300];
  dword Fun_Temp;
  int m=0,Flage;
  
  if(_Check_Serve_IDAndSess(0x22,ID,Session) == 1)
  {
    snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
    testGetCurrentTestCaseTitle(Fault_Data_Write,400);
    snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历22DID数据时,异常响应: \n",Fault_Data_Write);
    File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
    
    _get_Arry("Read_Now_Session");
    _get_Str_Traversal("DID_22_Traversal");
    for(m=0;m<Traversal_Count;m++)
    { 
      snprintf(Temp_Str,elCount(Temp_Str),"遍历22服务_%s",Traversal_DID[m]);
      creat_log("\\DID_22\\",Temp_Str); //单独生成logging日志存放，防止过大导致一个logging不好查看
      testStep(Traversal_DID[m],"--------------------------------分隔符--------------------------------");
      startLogging();
      if(m > 0)
        _SetSession(Session);
      _Get_DID(Traversal_DID[m]);
      Temp_DID[1] = DID_byte1;
      Temp_DID[2] = DID_byte2;
      Fun_Temp = ((DID_byte1<<8)|DID_byte2);
      if(_Check_Serve(0x22,Fun_Temp,5) == 1)
      {
        if(Session == defsession)
        {
          _WriteEx_and_Report("","当前DID：%04X 读取需要安全访问，默认会话下验证返回NRC31",Fun_Temp);
          _Send_Diag(3,ID,Temp_DID);
          _TestResult(SendData,ID,"",NRC31);
          continue;
        }
        _unlockECU();
      }
      Flage = _Check_22DID(ID,Temp_DID,Session,0);
      stopLogging();
      testWaitForTimeout(500);
      if(Flage == -1)
      {
        char Str[50];
        snprintf(Str,elCount(Str),"[  %s  ] \n",Traversal_DID[m]);
        File_Write(Error_File,Error_FileName,Str,2);
      }
    }
  }
  else
    _WriteEx_and_Report("","当前服务不支持");
}
void _Serve22_02(dword ID,byte Session)/*遍历需要判断的数据并验证异常写入*/
{
  byte Temp_DID[3]={0x22,0x00,0x00};
  char Temp_Str[300];
  dword Fun_Temp;
  int m=0,Flage;
  
  if(_Check_Serve_IDAndSess(0x22,ID,Session) == 1)
  {
    snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
    testGetCurrentTestCaseTitle(Fault_Data_Write,400);
    snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历22DID数据并异常写入时,异常响应: \n",Fault_Data_Write);
    File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
    
    _get_Str_Traversal("DID_22_Traversal");
    for(m=0;m<Traversal_Count;m++)
    { 
      snprintf(Temp_Str,elCount(Temp_Str),"遍历22服务并异常写入_%s",Traversal_DID[m]);
      creat_log("\\DID_22\\",Temp_Str); //单独生成logging日志存放，防止过大导致一个logging不好查看
      testStep(Traversal_DID[m],"--------------------------------分隔符--------------------------------");
      startLogging();
      if(m > 0)
        _SetSession(Session);
      _Get_DID(Traversal_DID[m]);
      Temp_DID[1] = DID_byte1;
      Temp_DID[2] = DID_byte2;
      Fun_Temp = ((DID_byte1<<8)|DID_byte2);
      if(_Check_Serve(0x22,Fun_Temp,5) == 1)
      {
        if(Session == defsession)
        {
          _WriteEx_and_Report("","当前DID：%04X 读取需要安全访问，默认会话下验证返回NRC31",Fun_Temp);
          _Send_Diag(3,ID,Temp_DID);
          _TestResult(SendData,ID,"",NRC31);
          continue;
        }
        _unlockECU();
      }
      Flage = _Check_22DID(ID,Temp_DID,Session,1);
      stopLogging();
      testWaitForTimeout(500);
      if(Flage == -1)
      {
        char Str[50];
        snprintf(Str,elCount(Str),"[  %s  ] \n",Traversal_DID[m]);
        File_Write(Error_File,Error_FileName,Str,2);
      }
    }
  }
  else
    _WriteEx_and_Report("","当前服务不支持");
}

void _Serve22_03(dword ID,byte Session)/*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[100];
  
  Serve_Pos = _Check_Serve(0x22,0,0);
  if(_Check_Serve_IDAndSess(0x22,ID,Session) == 1)
  {
    Send_Data[0] = 0x22;
    _Set_NRC_Step(0x22,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
}

void _Serve22_04(dword ID,byte Session)/*NRC13*/
{
  byte Temp_0[3]={0x22,0xF1,0x80}; 
  byte i;
  int Len;
  int Return_Va,Serve_Pos;
  Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
  if(Return_Va == 1)
  {
    _get_Str_Traversal("DID_22_Traversal");
    _get_DID(Traversal_DID[0]);
    _WriteEx_and_Report("",Traversal_DID[0]);
    Temp_0[1] = DID_byte1;
    Temp_0[2] = DID_byte2;
    Len = _Check_CANFD_Flage();
    if(DID_22_Support > 1)
      Len = DID_22_Support*2+3;
    for(i=1;i<=Len;i++)
    {
      if((i%2==1)&&(i!=1)&&i<=DID_22_Support*2+1)
      {
        _WriteEx_and_Report("","当前长度支持，跳过检测");
        continue;
      }
      _Send_Diag(i,ID,Temp_0);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(300);
    }
  }
  else if(Return_Va == -1)
    _WriteEx_and_Report("","当前寻址不支持该服务");
  else if(Return_Va == 0)
    _WriteEx_and_Report("","当前会话不支持该服务");
}

void _Serve22_05(dword ID,byte Session)/*NRC31*/
{
  byte Send_Data[3]={0x22,0xF1,0x80}; 
  dword byte1,byte2,Fun_Send;
  int Return_Va;
  int Flage;
  Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历22服务NRC31时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  if(Return_Va == 1)
  {
    if(Traversal_22==0)
    {
      for(byte1=0;byte1<=0xff;byte1++)
      {
        Send_Data[1]=byte1;
        for(byte2=0;byte2<=0xff;byte2++)
        {
          Send_Data[2]=byte2;
          Fun_Send = (byte1 << 8) ^ byte2;
          if(_Check_Serve(0x22,Fun_Send,4) != -1)
          {
            _WriteEx_and_Report("","该子功能支持，跳过检测");
            continue;
          }
          else
          {
            _Send_Diag(3,ID,Send_Data);
            Flage = _TestResult(SendData,ID,"",NRC31);
            testWaitForTimeout(10);
            if(Flage == -1)
            {
              char Str[30];
              snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
              File_Write(Error_File,Error_FileName,Str,2);
            }
          }
        }
      } 
    }
    if(Traversal_22 != 0)
    {
      Send_Data[1] = Traversal_22;
      byte1 = Traversal_22;
      for(byte2=0;byte2<=0xff;byte2++)
      {
        Send_Data[2]=byte2;
        Fun_Send = (Traversal_22 << 8) ^ byte2;
        if(_Check_Serve(0x22,Fun_Send,4) != -1)
        {
          _WriteEx_and_Report("","该子功能支持，跳过检测");
          continue;
        }
        else
        {
          _Send_Diag(3,ID,Send_Data);
          Flage = _TestResult(SendData,ID,"",NRC31);
          testWaitForTimeout(10);
          if(Flage == -1)
          {
            char Str[30];
            snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
            File_Write(Error_File,Error_FileName,Str,2);
          }
        }
      }
    }
  }
  else if(Return_Va == -1)
    _WriteEx_and_Report("","当前寻址不支持该服务");
  else if(Return_Va == 0)
    _WriteEx_and_Report("","当前会话不支持该服务");
}

