_31_Serve_50(dword ID,byte Session)/* 30 83清除PDC*/
{
  byte Send_DataOpen[6] = {0x31,0x01,0x30,0x83,0,0};
  int Send_Len,i,Flage_For_Unlock;
  dword FunDID;
  Send_Len = 4;
  FunDID = 0x3083;
  _get_Arry("Pull_Drift_Compensation_Clear");
  if(Arry_Len>1)
  {
    Send_Len = Arry_Len;
    FunDID = (Arry_Data[2]<<8)|Arry_Data[3];
    for(i=0;i<Arry_Len;i++)
      Send_DataOpen[i] = Arry_Data[i];
  }
  Flage_For_Unlock = _Check_Serve(0x01,FunDID,11);
  if(Flage_For_Unlock == 1)
    _unlockECU();
  _Send_Diag(Send_Len,ID,Send_DataOpen);
  _Check_31Routine_Rx(Send_DataOpen,1);
}

_31_Serve_51(dword ID,byte Session)/* 30 8B重置PSCM转向角度学习*/
{
  byte Send_DataOpen[6] = {0x31,0x01,0x30,0x8B,0,0};
  int Send_Len,i,Flage_For_Unlock;
  dword FunDID;
  Send_Len = 4;
  FunDID = 0x308B;
  _get_Arry("Reset_PSCM_steering_angle_learning");
  if(Arry_Len>1)
  {
    Send_Len = Arry_Len;
    FunDID = (Arry_Data[2]<<8)|Arry_Data[3];
    for(i=0;i<Arry_Len;i++)
      Send_DataOpen[i] = Arry_Data[i];
  }
  Flage_For_Unlock = _Check_Serve(0x01,FunDID,11);
  if(Flage_For_Unlock == 1)
    _unlockECU();
  _Send_Diag(Send_Len,ID,Send_DataOpen);
  _Check_31Routine_Rx(Send_DataOpen,1);
}
