void BYD_31_3002()
{
  byte Send_Data_AngCal[4] = {0x31,0x01,0xAC,0x00};
  byte Send_Data_AngClear[4] = {0x31,0x01,0x30,0x02};
  byte Send_Data_AngClear_Check[4] = {0x31,0x03,0x30,0x02};
  _Set_Ready(Struct_Ready.Ready_Active);
  _Set_CarSpd(10);
  _unlockECU();
  _Send_Diag(elcount(Send_Data_AngClear),phyreq_ID,Send_Data_AngClear);
  _Check_31Routine_Rx(Send_Data_AngClear,1);
  _Send_Diag(elcount(Send_Data_AngClear_Check),phyreq_ID,Send_Data_AngClear_Check);
  _Check_31Routine_Rx(Send_Data_AngClear_Check,1);
  testWaitForTimeout(1000);
  _Check_DTC_Res(1,Ang_NotCal,0);
  _TestWaitForTesterConfirmation("查看当前助力状态以及角度自学习是否不为初始值,末端是否保持初始值");
  _Set_11_Restoration(0);
  testWaitForTimeout(CAN_Init_Time+1000);
  _TestWaitForTesterConfirmation("已11复位，查看当前助力状态以及角度自学习是否不为初始值,末端是否保持初始值");
  _Check_DTC_Res(1,Ang_NotCal,0);
  
  _Set_Ready(0);
  _Set_CarSpd(0);
  _unlockECU();
  _Send_Diag(elcount(Send_Data_AngCal),phyreq_ID,Send_Data_AngCal);
  _Check_31Routine_Rx(Send_Data_AngCal,1);
  testWaitForTimeout(1000);
  _Check_DTC_Res(1,0,Ang_NotCal);
  _Send_Diag(elcount(Send_Data_AngClear),phyreq_ID,Send_Data_AngClear);
  _Check_31Routine_Rx(Send_Data_AngClear,1);
  _Send_Diag(elcount(Send_Data_AngClear_Check),phyreq_ID,Send_Data_AngClear_Check);
  _Check_31Routine_Rx(Send_Data_AngClear_Check,1);
  testWaitForTimeout(1000);
  _Check_DTC_Res(1,Ang_NotCal,0);
  _TestWaitForTesterConfirmation("查看当前助力状态以及角度自学习是否不为初始值,末端是否保持初始值");
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(CAN_Init_Time+1000);
  _Set_Ready(Struct_Ready.Ready_Active);
  _TestWaitForTesterConfirmation("已正常上下电，查看当前助力状态以及角度自学习是否不为初始值,末端是否保持初始值");
  _Check_DTC_Res(1,Ang_NotCal,0);
  
  _unlockECU();
  _Send_Diag(elcount(Send_Data_AngCal),phyreq_ID,Send_Data_AngCal);
  _Check_31Routine_Rx(Send_Data_AngCal,1);
  testWaitForTimeout(1000);
  _Check_DTC_Res(1,0,Ang_NotCal);
  _Send_Diag(elcount(Send_Data_AngClear),phyreq_ID,Send_Data_AngClear);
  _Check_31Routine_Rx(Send_Data_AngClear,1);
  _Send_Diag(elcount(Send_Data_AngClear_Check),phyreq_ID,Send_Data_AngClear_Check);
  _Check_31Routine_Rx(Send_Data_AngClear_Check,1);
  testWaitForTimeout(1000);
  _Check_DTC_Res(1,Ang_NotCal,0);
  _TestWaitForTesterConfirmation("查看当前助力状态以及角度自学习是否不为初始值,末端是否保持初始值");
  _K30_OFF();
  testWaitForTimeout(2000);
  _K30_ON();
  testWaitForTimeout(CAN_Init_Time+2000);
  _TestWaitForTesterConfirmation("已异常复位，查看当前助力状态以及角度自学习是否不为初始值,末端是否保持初始值");
  _Check_DTC_Res(1,Ang_NotCal,0);
  
  _unlockECU();
  _Send_Diag(elcount(Send_Data_AngCal),phyreq_ID,Send_Data_AngCal);
  _Check_31Routine_Rx(Send_Data_AngCal,1);
  testWaitForTimeout(1000);
  _Check_DTC_Res(1,0,Ang_NotCal);
  _Send_Diag(elcount(Send_Data_AngClear),phyreq_ID,Send_Data_AngClear);
  _Check_31Routine_Rx(Send_Data_AngClear,1);

  writeEx(-3,0,"测试完成，完成角度对中");
  _Send_Diag(elcount(Send_Data_AngCal),phyreq_ID,Send_Data_AngCal);
  _Check_31Routine_Rx(Send_Data_AngCal,1);
}

