void _10_Phy_Def_08(dword ID,byte Session)/*NRC13*/
{
  byte Temp_0[2]={0x10,0x01};
  dword Len;
  char Temp_Str[300];
  int Flage_Return,m;
  int i,j,Serve_Pos;
  Len = _Check_CANFD_Flage();
  _WriteEx_and_Report("遍历","10 01服务长度");
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历11服务NRC13时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  Serve_Pos = _Check_Serve(0x10,0,0);
  for(j=0;j<Serve_Data[Serve_Pos].Serve_Fun_Count;j++)
  {
    Temp_0[1] = Serve_Data[Serve_Pos].Serve_Fun[j];
    if(_Check_Fun_IDAndSess(0x10,Temp_0[1],ID,Session) != 1)
      continue;
    for(i=1;i<=Len;i++)
    {
      if(i==2)
      {
        _WriteEx_and_Report("","当前长度已测试，跳过");
        continue;
      }
      _Send_Diag(i,ID,Temp_0);
      Flage_Return = _TestResult(SendData,ID,"",NRC13);
      if(Flage_Return == -1)
      {
        snprintf(Fault_Data_Send,elCount(Fault_Data_Send),"[  %s","");
        for(m=0;m<i;m++)
          snprintf(Fault_Data_Send,elCount(Fault_Data_Send),"%s %02X",Fault_Data_Send,DiagGetPrimitiveByte(SendData,m));
        snprintf(Fault_Data_Send,elCount(Fault_Data_Send),"%s  ] \n",Fault_Data_Send);
        File_Write(Error_File,Error_FileName,Fault_Data_Send,2);
      }
      testWaitForTimeout(50);
    }
  }
}

void _10_Phy_Def_09(dword ID,byte Session)/*NRC12*/
{
  byte Temp_0[2]={0x10,0x01};
  dword i=0;
  int Flage_Return,m;
  _WriteEx_and_Report("遍历","10服务子功能");
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历11服务NRC12时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  for(i=0;i<=0xFF;i++)
  {
    if((_Check_Serve(0x10,i,4) != -1) || (((i>>4)==0x08) && (_Check_Serve(0x10,i&0x0F,4) != -1) && (_Check_Serve(0x10,i&0x0F,9) == 1)) )
    {
      _WriteEx_and_Report("","当前子功能已测试，跳过");
      continue;
    }
    if(i==0x60 && Factory_1060 == 1)
    {
      _WriteEx_and_Report("","工厂模式子功能，跳过");
      continue;  
    }
    Temp_0[1] = i;
    _Send_Diag(2,ID,Temp_0);
    Flage_Return = _TestResult(SendData,ID,"",NRC12);
    if(Flage_Return == -1)
    {
      snprintf(Fault_Data_Send,elCount(Fault_Data_Send),"[  0x%02X 0x%02X  ] \n",DiagGetPrimitiveByte(SendData,0),DiagGetPrimitiveByte(SendData,1));
      File_Write(Error_File,Error_FileName,Fault_Data_Send,2);
    }
    testWaitForTimeout(50);
  }
}

void _10_Phy_Def_10_CarSpd(dword ID,byte Session)   /*车速*/
{
  byte Temp_0[2]={0x10,0x01};
  byte Temp_1[2]={0x10,0x02};
  int Serve_Pos,NRC22_Flage;
  Serve_Pos = _Check_Serve(0x10,0x02,4);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持10 02,跳过检测");
  else if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
  {
    _Other_1002();
    NRC22_Flage = _Set_NRC22(0x10,0x02,2);
    if(NRC22_Flage == -1)
      _WriteEx_and_Report("","无NRC22条件");
    else if((NRC22_Flage &0x01) != 0)
    {
       _WriteEx_and_Report("步骤0","设置车速 > NRC22车速");
      _Set_CarSpd(NRC22_CarSpd+1);
      _WriteEx_and_Report("步骤1","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",NRC22);
      _WriteEx_and_Report("步骤2","发送 04 14 FF FF FF 55 55 55");
      _Clear_DTC(phyreq_ID,-1,"");
      _Send_And_Check_NowSession(ID,Session); 
      _WriteEx_and_Report("步骤3","设置车速 = NRC22车速");
      _Set_CarSpd(NRC22_CarSpd);
      _WriteEx_and_Report("步骤4","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("步骤5","发送 04 14 FF FF FF 55 55 55");
      _Clear_DTC(phyreq_ID,NRC11,"");
      _Send_And_Check_NowSession(ID,2); 
      _WriteEx_and_Report("步骤6","发送 02 10 01 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,defsession); 
      _Other_1002();
      _WriteEx_and_Report("步骤7","设置车速 > NRC22车速，再丢失车速");
      _Set_CarSpd(NRC22_CarSpd+1);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.1);
      _WriteEx_and_Report("步骤8","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("步骤9","发送 04 14 FF FF FF 55 55 55");
      _Clear_DTC(phyreq_ID,NRC11,"");
      _Send_And_Check_NowSession(ID,2); 
      _WriteEx_and_Report("步骤10","发送 02 10 01 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,defsession); 
      _Set_CarSpd(0);
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _Other_1002();
      _WriteEx_and_Report("步骤11","设置车速 > NRC22车速，再无效车速");
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
      _WriteEx_and_Report("步骤12","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _WriteEx_and_Report("步骤13","发送 04 14 FF FF FF 55 55 55");
      _Clear_DTC(phyreq_ID,NRC11,"");
      _WriteEx_and_Report("步骤14","发送 02 10 01 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,defsession); 
    }
    else
      _WriteEx_and_Report("","无NRC22车速条件");
    _Reset_CarSpd_Invalid();
    _Set_CarSpd(0);
  }
  else
    _WriteEx_and_Report("","当前寻址及会话下不支持0x10 0x02");
}

void _10_Phy_Def_10_Battery(dword ID,byte Session)   /*电压*/
{
  byte Temp_0[2]={0x10,0x01};
  byte Temp_1[2]={0x10,0x02};
  byte Temp_2[4]={0x14,0xff,0xff,0xff};
  int Serve_Pos,NRC22_Flage;
  
  Serve_Pos = _Check_Serve(0x10,0x02,4);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持10 02,跳过检测");
  else if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
  {
    NRC22_Flage = _Set_NRC22(0x10,0x02,2);
    if(NRC22_Flage == -1)
      _WriteEx_and_Report("","无NRC22条件");
    else if((NRC22_Flage &0x02) != 0)
    {
      _Other_1002();
      _Set_Battery(12);
      _WriteEx_and_Report("步骤0","设置电压 > NRC22高压");
      _Set_Battery(NRC22_Battery_Hight+0.2);
      _WriteEx_and_Report("步骤1","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",NRC22);
      _WriteEx_and_Report("步骤2","发送 04 14 FF FF FF 55 55 55");
      _Send_Diag(4,phyreq_ID,Temp_2);
      _TestResult(SendData,phyreq_ID,"",-1);
      _Send_And_Check_NowSession(ID,Session); 
      _Set_Battery(NRC22_Battery_Hight-0.2);
      _WriteEx_and_Report("步骤4","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("步骤5","发送 04 14 FF FF FF 55 55 55");
      _Send_And_Check_NowSession(ID,2); 
      _Send_Diag(4,phyreq_ID,Temp_2);
      _TestResult(SendData,phyreq_ID,"",NRC11);
      _WriteEx_and_Report("步骤6","发送 02 10 01 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",-1); 
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,defsession); 
      if(Session != defsession)
        _SetSession(Session);
      
      _Send_And_Check_NowSession(ID,Session); 
      _WriteEx_and_Report("","设置电压恢复正常");
      _Set_Battery(12);
      _WriteEx_and_Report("步骤7","设置电压 < NRC22低压");
      _Set_Battery(NRC22_Battery_Low-0.2);
      _WriteEx_and_Report("步骤8","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",NRC22);
      _Send_And_Check_NowSession(ID,Session); 
      _WriteEx_and_Report("步骤9","发送 04 14 FF FF FF 55 55 55");
      _Send_Diag(4,phyreq_ID,Temp_2);
      _TestResult(SendData,phyreq_ID,"",-1);
      _WriteEx_and_Report("步骤10","设置电压 = NRC22低压");
      _Set_Battery(NRC22_Battery_Low+0.2);
      _WriteEx_and_Report("步骤11","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _Check_10_01(6,Temp_1[1],P2can_server,P2_can_server);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("步骤12","发送 04 14 FF FF FF 55 55 55");
      _Send_Diag(4,phyreq_ID,Temp_2);
      _TestResult(SendData,phyreq_ID,"",NRC11);
      _Send_And_Check_NowSession(ID,2); 
      _WriteEx_and_Report("步骤13","发送 02 10 01 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,defsession); 
      _WriteEx_and_Report("","设置电压恢复正常");
      _Set_Battery(12);
    }
    else
      _WriteEx_and_Report("","无NRC22电压条件");
  }
  else
    _WriteEx_and_Report("","当前寻址及会话下不支持0x10 0x02");
}
void _10_Phy_Def_10_Ready(dword ID,byte Session)   /*发动机*/
{
  byte Temp_0[2]={0x10,0x01};
  byte Temp_1[2]={0x10,0x02};
  int Serve_Pos,NRC22_Flage;
  
  Serve_Pos = _Check_Serve(0x10,0x02,4);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持10 02,跳过检测");
  else if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
  {
    _Other_1002();
    NRC22_Flage = _Set_NRC22(0x10,0x02,2);
    if(NRC22_Flage == -1)
      _WriteEx_and_Report("","无NRC22条件");
    else if((NRC22_Flage &0x20) != 0)
    {
      _Set_Ready(Ready_NRC22);
      testWaitForTimeout(500);
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",NRC22);
      testWaitForTimeout(500);
      _Send_And_Check_NowSession(ID,Session); 
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(1000);
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _SetSession(defsession);
      testWaitForTimeout(2000);
      _SetSession(Session);
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
      _Other_1002();
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(1000);
      _Send_And_Check_NowSession(ID,2); 
      _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
      testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
      if(Ready_NRC22 != 0)
        _Set_Ready(0);
      else
        _Set_Ready(Struct_Ready.Ready_Active);
      _SetSession(defsession);
      _SetSession(Session);
      _Other_1002();
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(1000);
      _Send_And_Check_NowSession(ID,2); 
      _SetSession(defsession);
    }
    else
      _WriteEx_and_Report("","无NRC22发动机条件");
  }
  else
    _WriteEx_and_Report("","当前寻址及会话下不支持0x10 0x02");
}
void _10_Phy_Def_10_Torque(dword ID,byte Session) /* NRC22-转矩 */
{
  byte Temp_0[2]={0x10,0x02};
  byte Temp_2[4]={0x14,0xff,0xff,0xff};
  char str[100];
  int Serve_Pos,NRC22_Flage,i;
  
  Serve_Pos = _Check_Serve(0x10,0x02,4);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持10 02,跳过检测");
  else if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
  {
    NRC22_Flage = _Set_NRC22(0x10,0x02,2);
    if(NRC22_Flage == -1)
      _WriteEx_and_Report("","无NRC22条件");
    else if((NRC22_Flage &0x04) != 0)
    {
      for(i=0;i<2;i++)  //左右侧
      {
        _SetSession(Session);
        _Other_1002();
        snprintf(str,elCount(str),"%s","");
        if(i==0)
          snprintf(str,elCount(str),"控制力矩满足NRC22条件,大于 %.2f Nm,并保持",NRC22_TasTorque+0.2);
        else
          snprintf(str,elCount(str),"控制力矩满足NRC22条件,大于 %.2f Nm,并保持",(NRC22_TasTorque+0.2)*(-1));
        testWaitForTesterConfirmation(str,30000);
        _Send_Diag(2,ID,Temp_0);
        _TestResult(SendData,ID,"",NRC22);
        _Send_And_Check_NowSession(ID,Session); 
        _Send_Diag(4,phyreq_ID,Temp_2);
        _TestResult(SendData,phyreq_ID,"",-1);
        snprintf(str,elCount(str),"%s","");
        if(i==0)
          snprintf(str,elCount(str),"控制力矩小于NRC22条件,小于 %.2f Nm,并保持",NRC22_TasTorque-0.2);
        else
          snprintf(str,elCount(str),"控制力矩小于NRC22条件,小于 %.2f Nm,并保持",(NRC22_TasTorque-0.2)*(-1));
        testWaitForTesterConfirmation(str,30000);
        _Send_Diag(2,ID,Temp_0);
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(2000);
        _Send_And_Check_NowSession(ID,2); 
        _SetSession(defsession); //退出10 02
        testWaitForTimeout(2000);
      }
      snprintf(str,elCount(str),"%s","");
      snprintf(str,elCount(str),"松开方向盘");
      testWaitForTesterConfirmation(str,30000);
    }
    else
      _WriteEx_and_Report("","无NRC22扭矩条件");
  }
  else
    _WriteEx_and_Report("","当前寻址及会话下不支持0x10 0x02");
}

void _10_Phy_Def_10_Geely3_0(dword ID,byte Session) /* NRC22-Geely3.0 */
{
  byte Temp_0[2]={0x10,0x02};
  byte Data_Programmed[10];
  int  Data_Programmed_Count;
  int i,j;
  char Serve_85_CarSpdQFTemp[10];
  byte Serve_85_CarSpdQF[10];
  int Serve_85_CarSpdQF_Count;
  Serve_85_CarSpdQF_Count = getProfileArray(ECU_project,"Serve_85_CarSpdQF",Serve_85_CarSpdQFTemp,elCount(Serve_85_CarSpdQFTemp),file_name_1);
  for(i=0;i<Serve_85_CarSpdQF_Count;i++)
    Serve_85_CarSpdQF[i] = Serve_85_CarSpdQFTemp[i];
  if(Geely3_Flage == 1 )
  {
    
    _Get_NRC_Mapping(0x10);
    _get_Arry("Pre_Programmed");
    for(i=0;i<Arry_Len;i++)
      Data_Programmed[i] = Arry_Data[i];
    Data_Programmed_Count = Arry_Len;
    for(j=0;j<2;j++)
    {
      if(j==1)
      {
        _WriteEx_and_Report("","车速大于NRC22车速，遍历VehSpdLgtQf值");
        _Set_CarSpd(NRC22_CarSpd+1);
      }
      else
      {
        _WriteEx_and_Report("","车速小于NRC22车速，遍历VehSpdLgtQf值");
        _Set_CarSpd(0);
      }
      _Set_Ready(0xB);
      for(i=0;i<4;i++)
      {
        _SetSession(defsession);
        if(Session != defsession)
          _SetSession(Session);
        _Set_CarSpd_Invalid(i);
        testWaitForTimeout(1000);
        _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
        if(((_Check_Dword_in_Num(i,Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)== -1) && j==0) || j==1)
          _Check_31Routine_Rx(Data_Programmed,0);
        else
          _Check_31Routine_Rx(Data_Programmed,1);
        _Send_Diag(2,ID,Temp_0);
        if(j==1)
        {
          _TestResult(SendData,ID,"",CarSpd_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else if(j==0 && (_Check_Dword_in_Num(i,Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)== -1))
        {
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else
        {
          _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,2); 
        }
      }
      if(j==0)
        _WriteEx_and_Report("","步骤1-4测试结束");
      else if(j==1)
        _WriteEx_and_Report("","步骤5-8测试结束");
    }
    {
      _WriteEx_and_Report("","发动机为0xB,车速QF为0,车速大于NRC22车速后丢失");
      _SetSession(defsession);
      if(Session != defsession)
        _SetSession(Session);
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_Ready(0xB);
      _Set_CarSpd_Invalid(0);
      testWaitForTimeout(1000);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time+500);
      _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
      _Check_31Routine_Rx(Data_Programmed,1);
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(1000);
      _WriteEx_and_Report("","步骤9测试结束");
    }
    {
      _WriteEx_and_Report("","车速小于NRC22车速,车速QF为3,遍历发动机值");
      _Set_CarSpd(NRC22_CarSpd-1);
      _Set_CarSpd_Invalid(3);
      for(i=0;i<Struct_Ready.Ready_ValueRange_Count;i++)
      {
        _SetSession(defsession);
        if(Session != defsession)
          _SetSession(Session);
        _Set_Ready(Struct_Ready.Ready_ValueRange[i]);
        testWaitForTimeout(1000);
        _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
        if(Struct_Ready.Ready_ValueRange[i] != Ready_NRC22)
        {
          _Check_31Routine_Rx(Data_Programmed,1);
          _Send_Diag(2,ID,Temp_0);
          _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,2); 
        }
        else
        {
          _Check_31Routine_Rx(Data_Programmed,0);
          _Send_Diag(2,ID,Temp_0);
          _TestResult(SendData,ID,"",Ready_NRC);
          testWaitForTimeout(2000);
        }
      }
      _WriteEx_and_Report("","步骤10-14测试结束");
    }
    {
      _WriteEx_and_Report("","车速小于NRC22车速,车速QF为3,发动机为0xD,丢失发动机");
      _SetSession(defsession);
      if(Session != defsession)
        _SetSession(Session);
      _Set_Ready(0xD);
      _TestDisableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(Struct_Ready.Lost_Time*1.5);
      _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
       _Check_31Routine_Rx(Data_Programmed,1);
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _TestEnableMsg(Struct_Ready.Sig_Id);
      testWaitForTimeout(1000);
      _WriteEx_and_Report("","步骤15测试结束");
    }
    {
      _WriteEx_and_Report("","车速小于NRC22车速,车速QF为3,发动机为0xB,电压测试");
      _Set_Ready(0xB);
      testWaitForTimeout(1000);
      for(i=0;i<4;i++)
      {
        _SetSession(defsession);
        if(Session != defsession)
          _SetSession(Session);
        if(i==0)
          _Set_Battery(NRC22_Battery_Low+0.2);
        else if(i==1)
          _Set_Battery(NRC22_Battery_Hight-0.2);
        else if(i==2)
          _Set_Battery(NRC22_Battery_Low-0.2);
        else
          _Set_Battery(NRC22_Battery_Hight+0.2);
        _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
        if(i<2)
          _Check_31Routine_Rx(Data_Programmed,1);
        else
          _Check_31Routine_Rx(Data_Programmed,0);
        _Send_Diag(2,ID,Temp_0);
        if(i == 2)
        {
          _TestResult(SendData,ID,"",L_Battery_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else if(i == 3)
        {
          _TestResult(SendData,ID,"",H_Battery_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else 
        {
          _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,2); 
        }
      }
      _Set_Battery(12);
      _WriteEx_and_Report("","步骤16-19测试结束");
    }
    {
      _WriteEx_and_Report("","车速小于NRC22车速,车速QF为3,发动机为0xD/0xB,车速丢失");
      _SetSession(defsession);
      if(Session != defsession)
        _SetSession(Session);
      _Set_Ready(0xD);
      _Set_CarSpd_Invalid(3);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
      _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
      _Check_31Routine_Rx(Data_Programmed,0);
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",Ready_NRC);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,defsession); 
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(2000);
        
      _Set_Ready(0xB);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(2000);
      _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
      _Check_31Routine_Rx(Data_Programmed,1);
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(2000);
      _WriteEx_and_Report("","步骤20-21测试结束");
    }
    {
      int Temp_Data[5] = {1,0,2,2,3};
      _WriteEx_and_Report("","车速小于NRC22车速,发动机为0xD,丢失发动机信号,车速QF遍历");
      for(i=0;i<5;i++)
      {
        _SetSession(defsession);
        if(Session != defsession)
          _SetSession(Session);
        _Set_Ready(0xD);
        if(i==2)
          _Set_CarSpd(NRC22_CarSpd+1);
        else
          _Set_CarSpd(NRC22_CarSpd-1);
        _Set_CarSpd_Invalid(Temp_Data[i]);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(2000);
        _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
        if((_Check_Dword_in_Num(Temp_Data[i],Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)!= -1) && i!=2)
          _Check_31Routine_Rx(Data_Programmed,1);
        else
          _Check_31Routine_Rx(Data_Programmed,0);
        _Send_Diag(2,ID,Temp_0);
        if(_Check_Dword_in_Num(Temp_Data[i],Serve_85_CarSpdQF,Serve_85_CarSpdQF_Count)== -1)
        {
          _TestResult(SendData,ID,"",CarSpd_Invalid_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else if(i == 2)
        {
          _TestResult(SendData,ID,"",CarSpd_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else
        {
          _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,2); 
        }
        _TestEnableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(1000);
      }
      _WriteEx_and_Report("","步骤22-26测试结束");
    }
    {
      _WriteEx_and_Report("","发动机为0xD,丢失发动机和车速信号,电压测试");
      _Set_Ready(0xD);
      for(i=0;i<4;i++)
      {
        _SetSession(defsession);
        if(Session != defsession)
          _SetSession(Session);
        
        if(i==0)
          _Set_Battery(NRC22_Battery_Low+0.2);
        else if(i==1)
          _Set_Battery(NRC22_Battery_Hight-0.2);
        else if(i==2)
          _Set_Battery(NRC22_Battery_Low-0.2);
        else
          _Set_Battery(NRC22_Battery_Hight+0.2);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.5);
        _TestDisableMsg(Struct_Ready.Sig_Id);
        testWaitForTimeout(Struct_Ready.Lost_Time*1.5);
        
        _Send_Diag(Data_Programmed_Count,ID,Data_Programmed);
        if(i<2)
          _Check_31Routine_Rx(Data_Programmed,1);
        else
          _Check_31Routine_Rx(Data_Programmed,0);
        _Send_Diag(2,ID,Temp_0);
        if(i == 2)
        {
          _TestResult(SendData,ID,"",L_Battery_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else if(i == 3)
        {
          _TestResult(SendData,ID,"",H_Battery_NRC);
          _Send_And_Check_NowSession(ID,defsession); 
        }
        else 
        {
          _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,2); 
        }
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        _TestEnableMsg(Struct_Ready.Sig_Id);
        _Set_Battery(12);
        testWaitForTimeout(1000);
      }
      _WriteEx_and_Report("","步骤27-30测试结束");
    }
    _Set_CarSpd(0);
    _Reset_CarSpd_Invalid();
    _Set_Ready(0);
  }
  else
    _WriteEx_and_Report("","非Geely3.0平台,不适用");
}

void _10_Phy_Def_11(dword ID) /* S3server */
{
  byte Temp_0[2]={0x10,0x03};
  byte Temp_1[3]={0x28,0x00,0x03};
  int Start_time=4900;/*设定起始的会话维持时间*/
  int Count_time=10;/*会话维持时间每次累计加10ms*/
  
  _WriteEx_and_Report("步骤1","发送 02 10 03 55 55 55 55 55");
  _Send_Diag(2,ID,Temp_0);
  if(diagGetLastResponseCode(SendData)==-1)
  {
    testStepPass("步骤1","收到肯定响应");
    _WriteEx_and_Report("步骤2","测试10 03的会话维持时间");
    _Send_And_Check_NowSession(ID,exsession); 
    for(Start_time;Start_time<5200;Start_time+=Count_time)
    {
      testWaitForTimeout(Start_time);
      _Send_Diag(3,phyreq_ID,Temp_1);
      if(diagGetLastResponseCode(SendData)== 0x7f)
        break;
    }
    _Send_And_Check_NowSession(ID,defsession); 
    if(4950<=Start_time && Start_time<=5050)
      testStepPass("","03会话维持时间在5s ± 50ms内，当前约为%d ms",Start_time);
    else
      testStepFail("","03会话维持时间不在5s ± 50ms内，当前约为%d ms",Start_time);;
  }
  else
    testStepFail("","10 03未收到响应或收到否定应答");
}

void _10_Phy_Ex_13(dword ID)
{
  byte Temp_1[2]={0x10,0x02};
  byte Temp_2[4]={0x14,0xff,0xff,0xff};
  byte Fun_Pos;
  Fun_Pos = _Check_Serve(0x10,0x02,4);
  if(_Check_Fun_IDAndSess(0x10,0x02,ID,exsession) == 1)
  {
    if(Other_1002 == 1)
    {
      _SetSession(exsession); 
      _Other_1002();
      _Send_Diag(2,ID,Temp_1);  
      _TestResult(SendData,ID,"",-1);
      _Send_And_Check_NowSession(ID,exsession); 
    }
    else 
    {
      _Send_Diag(2,ID,Temp_1);  
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);/*进入10 02 后需延时1S防止无响应问题*/
      _Send_And_Check_NowSession(ID,2); 
    }
    _SetSession(defsession);
    testWaitForTimeout(1000);
    _SetSession(exsession);
    if(Other_1002==1)
      _Other_1002();
    Temp_1[1]=0x82;
    _Send_Diag_NoTime(2,ID,Temp_1);  
    testWaitForDiagResponse(SendData,p2cmax);
    if(diagGetLastResponseCode(SendData)==0x78)
    {
      testWaitForDiagResponse(SendData,1000);
      _TestResult(SendData,ID,"",-1);
    }
    if(diagGetLastResponseCode(SendData)==0)
    {
      _TestResult(SendData,ID,"",0);
    }
    testWaitForTimeout(2000);/*进入10 02 后需延时1S防止无响应问题*/
    _Send_And_Check_NowSession(ID,2); 
    _Send_Diag(4,ID,Temp_2);
    _TestResult(SendData,ID,"",NRC11);
    testWaitForTimeout(1000);
    _SetSession(defsession);
  }
  else
    _WriteEx_and_Report("","当前不支持10 02,跳过测试");
}
void _10_Phy_Ex_19(dword ID,byte Session)/*NRC33*/
{
  byte Temp_2[2]={0x10,0x02};
  int Serve_Pos;
  Serve_Pos = _Check_Serve(0x10,02,0);
  if(_Check_Serve(0x10,02,4) == -1)
  {
    _WriteEx_and_Report("","当前不支持10 02");
    _Send_Diag(2,ID,Temp_2);
    _TestResult(SendData,ID,"",NRC12);
  }
  else
  {
    if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
    {
      if(_Check_Serve(0x10,0x02,5) == 1)
      {
        _Send_Diag(2,ID,Temp_2);
        _TestResult(SendData,ID,"",NRC33);
        _Switch_To_Def();
        _Switch_To_Ex();
        _WriteEx_and_Report("","发送预编程报文");
        _get_Arry("Pre_Programmed");
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        if(Pre_Programmed_UnlockECU == 1)
          _TestResult(SendData,phyreq_ID,"",NRC33);
        else
          _TestResult(SendData,phyreq_ID,"",-1);
        _Send_Diag(2,ID,Temp_2);
        _TestResult(SendData,ID,"",NRC33);
      }
      else
        _WriteEx_and_Report("跳过测试","0x10 0x02无需安全访问");
    }
  }
}
void _10_Phy_Ex_20(dword ID)/*NRC22预编程*/
{
  byte Temp_0[2]={0x10,0x03};
  byte Temp_1[2]={0x10,0x01};
  byte Temp_2[2]={0x10,0x02};
  byte Temp_3[4]={0x14,0xff,0xff,0xff};
  byte Temp_4[2]={0x10,0x82};
  int Serve_Pos,Fun_Pos;
  Serve_Pos = _Check_Serve(0x10,0,0);
  Fun_Pos = _Check_Serve(0x10,0x02,4);
  if(Fun_Pos == -1)
    _WriteEx_and_Report("","不支持10 02");
  else
  {
    if(Pre_Programmed_1002 == 1 )
    {
      _WriteEx_and_Report("步骤1","发送 02 10 03 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);  
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,exsession); 
      _Pre_Programmed();
      _WriteEx_and_Report("步骤3","发送 02 10 01 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);  
      _Check_10_01(6,Temp_1[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,defsession); 
      _WriteEx_and_Report("步骤4","发送 02 10 03 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0); 
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server); 
      _unlockECU();
      _WriteEx_and_Report("步骤7","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_2);  
      _TestResult(SendData,ID,"",NRC22);
      _Send_And_Check_NowSession(ID,exsession); 
      _WriteEx_and_Report("步骤8","发送 04 14 FF FF FF 55 55 55");
      _Send_Diag(4,ID,Temp_3);  
      _TestResult(SendData,ID,"",-1);
      if(Serve_Data[Serve_Pos].RSP[Fun_Pos] == 1)
      {
        _WriteEx_and_Report("步骤9","发送 02 10 82 55 55 55 55 55");
        _Send_Diag(2,ID,Temp_2);  
        _TestResult(SendData,ID,"",NRC22);
        _Send_And_Check_NowSession(ID,exsession); 
        _WriteEx_and_Report("步骤10","发送 04 14 FF FF FF 55 55 55");
        _Send_Diag(4,ID,Temp_3);  
        _TestResult(SendData,ID,"",-1);
      }
      else
        _WriteEx_and_Report("","10 02不支持肯定响应抑制位");
      
      _WriteEx_and_Report("","发送预编程报文");
      _get_Arry("Pre_Programmed");
      _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
      _TestResult(SendData,phyreq_ID,"",-1);
      
      _WriteEx_and_Report("步骤12","发送 02 10 03 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);  
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,exsession); 
      _unlockECU();
      _WriteEx_and_Report("步骤15","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_2);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _WriteEx_and_Report("步骤16","发送 04 14 FF FF FF 55 55 55");
      _Send_Diag(4,ID,Temp_3);  
      _TestResult(SendData,ID,"",NRC11);
      _Send_Diag(2,ID,Temp_1);  
      _TestResult(SendData,ID,"",-1);
      _Send_And_Check_NowSession(ID,defsession); 
    }
    if(Pre_Programmed_1002 == 0)
      _WriteEx_and_Report("跳过测试","该项目服务无预编程条件");
  }
}
void _10_Phy_Ex_21(dword ID)/*NRC22车速*/
{
