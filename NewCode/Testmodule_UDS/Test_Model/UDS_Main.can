    if(i==1 && _Check_Serve(0x28,0x01,4)==-1)
      _WriteEx_and_Report("","该项目不支持01子功能,跳过检测");
    else if(i==2 && _Check_Serve(0x28,0x02,4)==-1)
      _WriteEx_and_Report("","该项目不支持02子功能,跳过检测");
    else if(i==0 && _Check_Serve(0x28,0x03,4)==-1)
      _WriteEx_and_Report("","该项目不支持03子功能,跳过检测");
    else
    {
      for(j=0;j<2;j++)  /*0:03    1:83*/
      {
        if(j==1)
        {
          if(_Check_Serve(0x28,Temp_1[1],9) == 0)
          {
            _WriteEx_and_Report("","当前不支持肯定响应抑制位,跳过测试");
            continue;
          }
          Temp_1[1] = Temp_1[1]|0x80;
        }
        if(Count != 0)
          _SetSession(Session);
        Count++;
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_1);
        testWaitForTimeout(500);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        _Check_Return(1);
        _Check_EPS_TX(1,EPS_TxID_1);
        _Send_Diag(3,ID,Temp_1);
        if(j==1)
          _TestResult(SendData,ID,"",0);
        else
          _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(500);
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2);
        testWaitForTimeout(500);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        if(i==0 || i==2)
          _Check_Return(0);
        else
          _Check_Return(2);
        if(i==0 || i==1)
          _Check_EPS_TX(0,EPS_TxID_1);
        else
          _Check_EPS_TX(1,EPS_TxID_1); 
        _Power_Down();
        testWaitForTimeout(1000);
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2);
        CarSpd_Now = DID28_Case_CarSpd_2;
        _Power_Up();
        _SetSession(Session);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        _Check_Return(2);
        _Check_EPS_TX(1,EPS_TxID_1); 
        _Set_Sig(Sig_28_Set,0);
        snprintf(str,elCount(str),"%s  0x%02X  0x%02X","当前完成测试0x28",Temp_1[1],Temp_1[2]);
        _WriteEx_and_Report("",str);
      }
    }
  }
}
_28_Serve_9(dword ID,byte Session)/*  优先级 */
{  
  int Serve_Pos,i;
  byte Send_Data[100];
  
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,Session) == 1)
  {
    Send_Data[0] = 0x28;
    _Set_NRC_Step(0x28,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
      if(i == Fun_NRC_Count)
        _TestResult(SendData,ID,"",-1);
      else
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      testWaitForTimeout(100);
    }
  }
}
_28_Serve_10(dword ID,byte Session)/*  NRC13 */
{
  byte Temp_Data[3] ={0x28,0x00,0x03};
  int i,Len,Serve_Pos;
  Serve_Pos = _Check_Serve(0x28,0,0);
  Temp_Data[0] = 0x28;
  Temp_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  Temp_Data[2] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  Len = _Check_CANFD_Flage();
  if(Len < Serve_Data[Serve_Pos].Serve_Fun_Len[0])
    Len = Serve_Data[Serve_Pos].Serve_Fun_Len[0]+1;
  for(i=1;i<=Len;i++)
  {
    if(i==3)
      continue;
    _Send_Diag(i,ID,Temp_Data);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(50);
  }
}

_28_Serve_11(dword ID,byte Session)/*  NRC12 */
{
  byte Temp_Data[3] ={0x28,0x00,0x03};
  dword Byte1;
  int Serve_Pos;
  Serve_Pos = _Check_Serve(0x28,0,0);
  Temp_Data[2] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  for(Byte1=0;Byte1<=0xFF;Byte1++)
  {
    Temp_Data[1] = Byte1;
    if(((_Check_Serve(0x28,(Byte1&0x7F),4)!= -1) && (_Check_Serve(0x28,(Byte1&0x7F),9)== 1)) || (_Check_Serve(0x28,Byte1,4)!= -1))
      continue;
    _Send_Diag(3,ID,Temp_Data);
    _TestResult(SendData,ID,"",NRC12);
    testWaitForTimeout(50);
  }
}

_28_Serve_12(dword ID,byte Session)/*  NRC31 */
{
  byte Temp_Data[3] ={0x28,0x00,0x03};
  dword Byte1;
  int Serve_Pos,i,Flage;
  Serve_Pos = _Check_Serve(0x28,0,0);
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历28服务NRC31数据时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
  {
    Temp_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
    for(Byte1=0;Byte1<=0xFF;Byte1++)
    {
      Temp_Data[2]=Byte1;
      if(_Check_SendData_In_28H(Temp_Data)!= -1)
        continue;
      _Send_Diag(3,ID,Temp_Data);
      Flage = _TestResult(SendData,ID,"",NRC31);
      if(Flage == -1)
      {
        char Str[50];
        snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",Temp_Data[1],Temp_Data[2]);
        File_Write(Error_File,Error_FileName,Str,2);
      }
    }
  }
}
_28_Serve_13(dword ID,byte Session)/*  工厂模式力矩-NRC22 */
{
  byte Temp_1[3] = {0x28,0x03,0x03};
  byte Temp_2[6] = {0x2E,0x01,0x00,0x00,0x00,0x00};
  char str[100];
  int Serve_Pos;
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("ChangAn"))
  {
    if((_Set_NRC22(0x28,Serve_Data[Serve_Pos].Serve_Fun[0],2)&0x04) != 0)
    {
      _SetSession(exsession);
      _unlockECU();
      _Send_Diag(6,phyreq_ID,Temp_2);
      _TestResult(SendData,phyreq_ID,"",-1);
      _get_28_Case();
      _get_Arry("Read_SigValue");
      for(i=0;i<2;i++)
      {
        _SetSession(Session);
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_1);
        testWaitForTimeout(500);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        _Check_Return(1);
        _Check_EPS_TX(1,EPS_TxID_1);
        snprintf(str,elCount(str),"%s","");
        if(i==0)
          snprintf(str,elCount(str),"控制力矩满足工厂模式NRC22条件,大于 %.2f Nm,并保持",NRC22_TasTorque_Fac+0.2);
        else
          snprintf(str,elCount(str),"控制力矩满足工厂模式NRC22条件,大于 %.2f Nm,并保持",(NRC22_TasTorque_Fac+0.2)*(-1));
        testWaitForTesterConfirmation(str,30000);
        _Send_Diag(3,ID,Temp_1);
        _TestResult(SendData,ID,"",NRC22);
        testWaitForTimeout(500);
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2);
        testWaitForTimeout(500);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        _Check_Return(2);
        _Check_EPS_TX(1,EPS_TxID_1);
        snprintf(str,elCount(str),"%s","");
        if(i==0)
          snprintf(str,elCount(str),"控制力矩不满足工厂模式NRC22条件,小于 %.2f Nm,并保持",NRC22_TasTorque_Fac-0.2);
        else
          snprintf(str,elCount(str),"控制力矩不满足工厂模式NRC22条件,小于 %.2f Nm,并保持",(NRC22_TasTorque_Fac-0.2)*(-1));
        testWaitForTesterConfirmation(str,30000);
        _Send_Diag(3,ID,Temp_1);
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(500);
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2+5);
        testWaitForTimeout(500);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        _Check_Return(2);
        _Check_EPS_TX(0,EPS_TxID_1);
        snprintf(str,elCount(str),"%s","");
        snprintf(str,elCount(str),"松开方向盘");
        _SetSession(defsession);
        _Set_Sig(Sig_28_Set,0);
      }
      _Factory_Mode(1);
    }
    else
      _WriteEx_and_Report("","无NRC22车速条件");
  }
  else
    _WriteEx_and_Report("","当前测试项目非长安,跳过检测NRC22工厂模式力矩条件");
}
