variables
{
  byte NRC13 = 0x13;
  byte NRC31 = 0x31;
  byte NRC22 = 0x22;
  byte NRC7E = 0x7E;
  byte NRC7F = 0x7F;
  byte NRC11 = 0x11;
  byte NRC12 = 0x12;
  byte NRC78 = 0x78;
  byte NRC33 = 0x33;
  byte NRC24 = 0x24;
  byte NRC35 = 0x35;
  byte NRC36 = 0x36;
  byte NRC37 = 0x37;
  char Temp_Log_Name[200];
  mstimer CAN_BUS_loader_H;
  mstimer CAN_BUS_loader_L;
  qword count_Bus;
  mstimer Time_Count;
  byte Time_Flage;
  qword Time_Count_Time;
  int Change_Load;
}

on timer CAN_BUS_loader_H
{
  int k;
  message * mg1;
  qword ID;
  int H_Load,L_Load;
  if((phyreq_ID-0x100)<0)
    ID = 0x001;
  else
    ID = (phyreq_ID-0x100);
  if(ID == Response_ID || ID == funreq_ID)
    ID = ID - 0x10;
  mg1.id  = ID;
  mg1.dlc = 8;
  for(k=0;k<count_Bus;k++)
    output(mg1);
  testWaitForTimeout(100);
  if(Change_Load == 0)
  {
    H_Load = High_Load_Range[1];
    L_Load = High_Load_Range[0];
  }
  else
  {
    H_Load = High_Load_Range[1] - 20;
    L_Load = High_Load_Range[0] - 20;
  }
  if(canGetBusLoad(1)>H_Load)
    count_Bus--;
  else if(canGetBusLoad(1)<L_Load)
    count_Bus++;
  setTimer(CAN_BUS_loader_H,200);
}
on timer CAN_BUS_loader_L
{
  int k;
  message * mg2;
  qword ID;
  int H_Load,L_Load;
  if((phyreq_ID+0x100)>0x7FF)
    ID = 0X7FF;
  else
    ID = phyreq_ID+0x100;
  if(ID == Response_ID || ID == funreq_ID)
    ID = ID - 0x10;
  mg2.id  = ID;
  mg2.dlc = 8;
  for(k=0;k<count_Bus;k++)
    output(mg2);
  testWaitForTimeout(100);
  if(Change_Load == 0)
  {
    H_Load = High_Load_Range[1];
    L_Load = High_Load_Range[0];
  }
  else
  {
    H_Load = High_Load_Range[1] - 20;
    L_Load = High_Load_Range[0] - 20;
  }
  if(canGetBusLoad(1)>H_Load)
    count_Bus--;
  else if(canGetBusLoad(1)<L_Load)
    count_Bus++;
  setTimer(CAN_BUS_loader_L,200);
}
on timer Time_Count
{
  testWaitForTimeout(Time_Count_Time);
  Time_Flage =1;
}

void Init_Main_Traversal_DID(byte Session)
{
  Init();
  testWaitForTimeout(500);
  _Clear_DTC(phyreq_ID);
  _SetSession(Session);
}

void Init_Main_Def()
{
  Init();
  _Start();
  testWaitForTimeout(500);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(100);
  _SetSession(defsession);
  testWaitForTimeout(200);
  _WriteEx_and_Report("","初始化完成");
}
void Init_Main_Special(char Str[],byte Session)
{
  Init();
  _Start(Str);
  testWaitForTimeout(500);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(100);
  _SetSession(Session);
  testWaitForTimeout(200);
  _WriteEx_and_Report("","初始化完成");
}
void Init_Main_Ex()
{
  Init();
  _Start();
  testWaitForTimeout(500);
  _Clear_DTC(phyreq_ID);
  testWaitForTimeout(100);
  _SetSession(exsession);
  testWaitForTimeout(200);
  _WriteEx_and_Report("","初始化完成");
}
void End_Main()
{
  diagStopTesterPresent(Cdd_Name);
  _End();
  snprintf(Fault_Data_Report,elCount(Fault_Data_Report),"");
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"");
  snprintf(Fault_Data_Send,elCount(Fault_Data_Send),"");
  _Set_CarSpd(0);
  _Clear_Seed();
  Time_Flage = 0;
  Change_Load = 0;
  Get_Seed_Flage = 0;
  Serve_31_NewNRC22 = 0;
  for(i=0;i<Node_Temp_List_Count;i++)
    Node_Temp_List[i]=0;
  Node_Temp_List_Count =0;
  testWaitForTimeout(1000);
}

void Init()
{
  _WriteEx_and_Report("","初始化");
  count_Bus = 400;
  Get_value();
  _Init_Struct();
  _Get_DTC_19();
  _Get_CarSpd_Engine();
  diagSetTarget(Cdd_Name);
  if(Unlock_1002 == -1)
    Unlock_1002 = _Check_Serve(0x10,2,5);
  Support_ReadSession = 0;
  Res_NRC78 = 0;
}

void _ID_Traversal()
{
  byte Data[8] = {0x02,0x10,0x01,0x55,0x55,0x55,0x55,0x55};
  message *Msg;
  dword ID;
  int Res_Flage,i;
  Msg.dlc = 8;
  Msg.FDF = 0;
  Msg.BRS = 0;
  if(Support_CAN == 2)
  {
    Msg.FDF = 1;
    Msg.BRS = 1;
  }
  testWaitForTimeout(500);
  for(i=0;i<8;i++)
    Msg.byte(i) = Data[i];
  for(i=ID_Range[0];i<=ID_Range[1];i++)
  {
    Msg.id = i;
    Res_Flage = 0;
    output(Msg);
    if(i == Response_ID)
      testWaitForTimeout(2);  /*增加等待时间防止在此处里面发送后就判断到本身的返回*/
    Res_Flage = testWaitForMessage(Response_ID,100);
    if(Res_Flage == 1 )
    {
      if(i==phyreq_ID || i == funreq_ID)
        testStepPass("","0x%03X ID收到响应",i);
      else
        testStepFail("","0x%03X ID收到响应",i);
    }
    else if(Res_Flage == 0)
    {
      if(i==phyreq_ID || i == funreq_ID)
        testStepFail("","0x%03X ID未收到响应",i);
    }
  }
}

void _ID_ExTraversal()
{
  byte Data[8] = {0x02,0x10,0x01,0x55,0x55,0x55,0x55,0x55};
  message *Msg;
  message *RxMsg;
  dword ID;
  int Res_Flage;
  Msg.dlc = 8;
  Msg.FDF = 0;
  Msg.BRS = 0;
  if(Support_CAN == 2)
  {
    Msg.FDF = 1;
    Msg.BRS = 1;
  }
  Msg.id = phyreq_ID;
  for(i=0;i<8;i++)
    Msg.byte(i+1) = Data[i];
  testWaitForTimeout(100);
  for(i=0x01;i<=0xEF;i++)
  {
    Msg.byte(0) = i;
    output(Msg);
    Res_Flage = testWaitForMessage(Response_ID,100);
    if(Res_Flage == 1 )
    {
      testGetWaitEventMsgData(RxMsg);
      if(RxMsg.byte(0)<0xF0)
        testStepPass("","收到应答但Byte(0)不是诊断仪目标地址,当前应答Byte(0) = 0x%02X",RxMsg.byte(0));
      else
        testStepFail("","收到应答但Byte(0)在诊断仪目标地址范围内,当前应答Byte(0) = 0x%02X",RxMsg.byte(0));
    }
    else if(Res_Flage == 0)
      testStepPass("","0x%02X 无响应",i);
  }
}

void _ID_Mix_Traversal()
{
  byte Data[8] = {0x02,0x10,0x01,0x55,0x55,0x55,0x55,0x55};
  message * Msg;
  dword ID;
  int Res_Flage;
  dword ID_Hbyte,ID_Lbyte,Loop;
  Msg.dlc = 8;
  Msg.FDF = 0;
  Msg.BRS = 0;
  if(Support_CAN == 2)
  {
    Msg.FDF = 1;
    Msg.BRS = 1;
  }
  for(i=0;i<8;i++)
    Msg.byte(i) = Data[i];
  testWaitForTimeout(500);
  
  ID_Hbyte = 0x18DA0000;
  ID_Lbyte = 0x000000F1;
  Loop = 0;
  for(Loop=0;Loop<=0xFF;Loop++)
  {
    ID = ID_Hbyte + (Loop<<8) + ID_Lbyte;
    Msg.id = mkExtId(ID);
    Res_Flage = 0;
    output(Msg);
    Res_Flage = testWaitForMessage(Response_ID,100);
    if(Res_Flage == 1 )
      testStepFail("","0x%08X ID收到响应",ID);
  }

  ID_Hbyte = 0x18DB0000;
  ID_Lbyte = 0x000000F1;
  Loop = 0;
  for(Loop=0;Loop<=0xFF;Loop++)
  {
    ID = ID_Hbyte + (Loop<<8) + ID_Lbyte;
    Msg.id = mkExtId(ID);
    Res_Flage = 0;
    output(Msg);
    Res_Flage = testWaitForMessage(Response_ID,100);
    if(Res_Flage == 1 )
      testStepFail("","0x%08X ID收到响应",ID);
  }
}

