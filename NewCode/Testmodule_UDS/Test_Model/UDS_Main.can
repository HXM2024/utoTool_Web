_Abnormal_NRC_4() /*19h-NRC13*/
{
  int i,len,Count,Pos,j;
  byte data[10];
  byte Send_Seed[2] = {0x27,0x00};
  byte Send_Data[10];
  byte Data_Support_Len[100][2];
  
  Pos = _Check_Serve(0x19,0,0);
  Count = 0;
  for(i=0;i<Serve_Data[Pos].Serve_Fun_Count;i++)
  {
    if(_Check_Dword_in_Num(Serve_Data[Pos].Serve_Fun_Len[i],Data_Support_Len,Count) == -1)
    {
      Data_Support_Len[Count][0] = Serve_Data[Pos].Serve_Fun_Len[i];
      Data_Support_Len[Count][1] = Serve_Data[Pos].Serve_Fun[i];
      Count++;
    }
  } //长度+子功能
  data[0] = 0x19;
  len = _Get_Tx_Len();
  Send_Seed[1] = RequestSeed_27;
  testStep("步骤1","---------------------");
  _SetSession(exsession);
  testWaitForTimeout(500);
  _Send_Key(SendKey_Len+1,phyreq_ID,_get_seed(phyreq_ID),1);
  _TestResult(SendData,phyreq_ID,"",NRC13);
  for(j=0;j<Count;j++)
  {
    data[1] = Data_Support_Len[j][1];
    if(Data_Support_Len[j][0] == 3)
    {
      data[1] = 0x02;
      data[2] = 0x01;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 2)
    {
      data[1] = 0x0A;data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 6)
    {
      int Pos_1904;
      data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0xFF;
      
      Pos_1904 = Get_Node_Pos(Node_1904,1);
      data[2] = (DTC_19[Pos_1904][1]>>16);
      data[3] = (DTC_19[Pos_1904][1]>>8);
      data[4] = (DTC_19[Pos_1904][1]&0xFF);
    }
    for(i=1;i<=len;i++)
    {
      if(i==Data_Support_Len[j][0])
        continue;
      _Send_Diag(i,phyreq_ID,data);
      _TestResult(SendData,phyreq_ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  
  testStep("步骤2","---------------------");
  _Set_11_Restoration();
  testWaitForTimeout(2000);
  _SetSession(exsession);
  _Send_Diag(7,phyreq_ID,Send_Seed);
  _TestResult(SendData,phyreq_ID,"",NRC13);

  for(j=0;j<Count;j++)
  {
    data[1] = Data_Support_Len[j][1];
    if(Data_Support_Len[j][0] == 3)
    {
      data[1] = 0x02;
      data[2] = 0x01;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 2)
    {
      data[1] = 0x0A;data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 6)
    {
      int Pos_1904;
      data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0xFF;
      
      Pos_1904 = Get_Node_Pos(Node_1904,1);
      data[2] = (DTC_19[Pos_1904][1]>>16);
      data[3] = (DTC_19[Pos_1904][1]>>8);
      data[4] = (DTC_19[Pos_1904][1]&0xFF);
    }
    for(i=1;i<=len;i++)
    {
      if(i==Data_Support_Len[j][0])
        continue;
      _Send_Diag(i,phyreq_ID,data);
      _TestResult(SendData,phyreq_ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  
  testStep("步骤3","---------------------");
  _K30_OFF();
  testWaitForTimeout(1000);
  _K30_ON();
  testWaitForTimeout(2000);
  _get_Str_Traversal("DID_2E_Traversal");
  _unlockECU();
  _get_2E_DID(Traversal_DID[0]);
  _Send_Diag(DID_2E_SendData_1_Len+1,phyreq_ID,DID_2E_SendData_1);
  _TestResult(SendData,phyreq_ID,"",NRC13);

  for(j=0;j<Count;j++)
  {
    data[1] = Data_Support_Len[j][1];
    if(Data_Support_Len[j][0] == 3)
    {
      data[1] = 0x02;
      data[2] = 0x01;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 2)
    {
      data[1] = 0x0A;data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 6)
    {
      int Pos_1904;
      data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0xFF;
      
      Pos_1904 = Get_Node_Pos(Node_1904,1);
      data[2] = (DTC_19[Pos_1904][1]>>16);
      data[3] = (DTC_19[Pos_1904][1]>>8);
      data[4] = (DTC_19[Pos_1904][1]&0xFF);
    }
    for(i=1;i<=len;i++)
    {
      if(i==Data_Support_Len[j][0])
        continue;
      _Send_Diag(i,phyreq_ID,data);
      _TestResult(SendData,phyreq_ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  
  testStep("步骤4","---------------------");
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  _unlockECU();
  _Get_31_ServeData(0,Send_Data,0);
  _Send_Diag(Len_31H + 1,phyreq_ID,Send_Data);
  _TestResult(SendData,phyreq_ID,"",NRC13);

  for(j=0;j<Count;j++)
  {
    data[1] = Data_Support_Len[j][1];
    if(Data_Support_Len[j][0] == 3)
    {
      data[1] = 0x02;
      data[2] = 0x01;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 2)
    {
      data[1] = 0x0A;data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0;
    }
    else if(Data_Support_Len[j][0] == 6)
    {
      int Pos_1904;
      data[2] = 0;
      data[3] = 0;data[4] = 0;data[5] = 0xFF;
      
      Pos_1904 = Get_Node_Pos(Node_1904,1);
      data[2] = (DTC_19[Pos_1904][1]>>16);
      data[3] = (DTC_19[Pos_1904][1]>>8);
      data[4] = (DTC_19[Pos_1904][1]&0xFF);
    }
    for(i=1;i<=len;i++)
    {
      if(i==Data_Support_Len[j][0])
        continue;
      _Send_Diag(i,phyreq_ID,data);
      _TestResult(SendData,phyreq_ID,"",NRC13);
      testWaitForTimeout(50);
