_31_Serve_49(dword ID,byte Session)/* 角度中位自学习开关*/
{
  byte Send_DataOpen[5] = {0x31,0x01,0x30,0x82,0x01};
  byte Send_DataClose[5] = {0x31,0x01,0x30,0x82,0x00};
  int FunPos;
  FunPos = _Check_Serve(0x01,0x3082,12);
  if(FunPos != -1)
  {
    _unlockECU();
    _Send_Diag(5,ID,Send_DataClose);
    _Check_31Routine_Rx(Send_DataClose,1);
    testWaitForTimeout(500);
    _Send_Diag(5,ID,Send_DataOpen);
    _Check_31Routine_Rx(Send_DataOpen,1);
  }
}
