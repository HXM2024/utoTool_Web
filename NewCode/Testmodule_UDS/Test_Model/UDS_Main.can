}

void _Serve10_01(dword ID,byte Session)   /*NRC优先级*/
{
  int Serve_Pos,Fun_Pos,i,j;
  byte Send_Data[100];
  byte Temp_14[4]={0x14,0xff,0xff,0xff};
  int Re,Temp_Flage_0x7E;
  
  Serve_Pos = _Check_Serve(0x10,0,0);
  Send_Data[0] = 0x10;
  for(j=0;j<Serve_Data[Serve_Pos].Serve_Fun_Count;j++)
  {
    writeEx(-3,0,"/*-----------开始测试 0x10 0x%02X NRC优先级-----------*/",Serve_Data[Serve_Pos].Serve_Fun[j]);
    Temp_Flage_0x7E = 0;
    Fun_Pos = _Check_Serve(0x10,Serve_Data[Serve_Pos].Serve_Fun[j],4);
    Re = _Check_Fun_IDAndSess(0x10,Serve_Data[Serve_Pos].Serve_Fun[j],ID,Session);
    if(Re == 1)
    {
      if(Serve_Data[Serve_Pos].Serve_Fun[j] == 0x02 && Session == defsession)
        _Set_NRC_Step(0x10,Serve_Data[Serve_Pos].Serve_Fun[j],0,Send_Data);
      else
        _Set_NRC_Step(0x10,Serve_Data[Serve_Pos].Serve_Fun[j],6,Send_Data);
      if(Fun_NRC_Count == 0)
      {
        _WriteEx_and_Report("","未输入NRC，跳过测试");
        return;
      }
      for(i=0;i<=Fun_NRC_Count;i++)
      {
        if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        {
          _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,Fun_Pos,Send_Data);
          if(Pre_Programmed_1002==1 && Fun_NRC[i-1]==0x22 && Serve_Data[Serve_Pos].Serve_Fun[j] == 0x02)
          {
            _get_Arry("Pre_Programmed");
            if(Arry_Len == 0)
              _WriteEx_and_Report("","未查询到对应预编程报文");
            else
            {
              _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
              _TestResult(SendData,phyreq_ID,"",-1);
            }
          }
        }
        if(Fun_NRC[i] == 0x7E)
          continue;
        if(i == Fun_NRC_Count)
        {
          writeEx(-3,0,"期望收到 正响应");
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",-1);
          if(Serve_Data[Serve_Pos].Serve_Fun[j] == 0x02)
          {
            testWaitForTimeout(2000);
            _Send_Diag(4,phyreq_ID,Temp_14);
            _TestResult(SendData,phyreq_ID,"",NRC11);
            _SetSession(defsession);
            testWaitForTimeout(1000);
          }
        }
        else
        {
          writeEx(-3,0,"期望收到 NRC%02X",Fun_NRC[i]);
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",Fun_NRC[i]);
        }
        testWaitForTimeout(100);
      }
      _SetSession(Session);
      testWaitForTimeout(500);
    }
    else
    {
      if(Serve_Data[Serve_Pos].Serve_Fun[j] == 0x02)
        _Set_NRC_Step(0x10,Serve_Data[Serve_Pos].Serve_Fun[j],0,Send_Data);
      else
        _Set_NRC_Step(0x10,Serve_Data[Serve_Pos].Serve_Fun[j],6,Send_Data);
      if(Fun_NRC_Count == 0)
      {
        _WriteEx_and_Report("","未输入NRC，跳过测试");
        return;
      }
      for(i=0;i<Fun_NRC_Count;i++)
      {
        if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        {
          _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,Fun_Pos,Send_Data);
          if(Fun_NRC[i-1]==0x7E)
          {
            Send_Data[1] = Session;
            Temp_Flage_0x7E = 1;
          }
          if(Pre_Programmed_1002==1 && Fun_NRC[i-1]==0x22 && Send_Data[1] == 0x02)
          {
            _get_Arry("Pre_Programmed");
            if(Arry_Len == 0)
              _WriteEx_and_Report("","未查询到对应预编程报文");
            else
            {
              _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
              _TestResult(SendData,phyreq_ID,"",-1);
            }
          }
        }
        {
          writeEx(-3,0,"期望收到 NRC%02X",Fun_NRC[i]);
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",Fun_NRC[i]);
        }
        testWaitForTimeout(100);
      }
      if(Temp_Flage_0x7E == 1)
      {
        Fun_NRC_Send_Len = 2;
        Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[j];
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",0x7E);
      }
    }
  }
  // if(_Check_Serve_IDAndSess(0x10,ID,Session) == 1)
  // {
  //   Send_Data[0] = 0x10;
  //   Fun_Pos = _Check_Serve(0x10,0x02,4);
