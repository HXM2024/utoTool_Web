}

_19_Serve_20(dword ID,byte Session) /*NRC优先级*/
{
  int Serve_Pos,i,j;
  byte Send_Data[100];
  char Check_Str[100];
  
  Serve_Pos = _Check_Serve(0x19,0,0);
  if(_Check_Serve_IDAndSess(0x19,ID,Session) == 1)
  {
    Send_Data[0] = 0x19;
    for(j=0;j<Serve_Data[Serve_Pos].Serve_Fun_Count;j++)
    {
      _Set_NRC_Step(0x19,Serve_Data[Serve_Pos].Serve_Fun[j],6,Send_Data);
      if(Fun_NRC_Count == 0)
      {
        _WriteEx_and_Report("","未输入NRC，跳过测试");
        continue;
      }
      snprintf(Check_Str,elCount(Check_Str),"%s","");
      snprintf(Check_Str,elCount(Check_Str),"开始测试19服务NRC优先级 : 0x19 0x%02X",Serve_Data[Serve_Pos].Serve_Fun[j]);
      writeEx(-3,0,"----------------------------------------------");
      _WriteEx_and_Report("",Check_Str);
      writeEx(-3,0,"----------------------------------------------");
      for(i=0;i<=Fun_NRC_Count;i++)
      {
        if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        {
          _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,j,Send_Data);
          if((Serve_Data[Serve_Pos].Serve_Fun[j] == 0x04 || Serve_Data[Serve_Pos].Serve_Fun[j]==0x06) && Fun_NRC[i-1]==0x31 && NRC31_total==1)
          {
            _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
            _TestResult(SendData,ID,"",NRC31);
            Send_Data[5] = Serve_Data[Serve_Pos].Serve_Para[j][0];
          }
        }
        if(i==Fun_NRC_Count)
        {
          if(Serve_Data[Serve_Pos].Serve_Fun[j] == 0x01 || Serve_Data[Serve_Pos].Serve_Fun[j]==0x02)
            Send_Data[Fun_NRC_Send_Len -1] = 0x09;
          else if(Serve_Data[Serve_Pos].Serve_Fun[j] == 0x04 || Serve_Data[Serve_Pos].Serve_Fun[j]==0x06)
            Send_Data[Fun_NRC_Send_Len -1] = Serve_Data[Serve_Pos].Serve_Para[j][0];
        }
        if(i<Fun_NRC_Count)
          _WriteEx_and_Report("","/----- 测试NRC = 0x%02X -----/",Fun_NRC[i]);
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        if(i == Fun_NRC_Count)
        {
          if(Send_Data[1] == 0x0A)
          {
            if(diagGetLastResponseCode(SendData)==0)
              testWaitForDiagResponse(SendData,3000);
          }
          _TestResult(SendData,ID,"",-1);
        }
        else
          _TestResult(SendData,ID,"",Fun_NRC[i]);
        testWaitForTimeout(100);
      }
      testWaitForTimeout(1000);
    }
  }
}

_19_Serve_21(dword ID,byte Session) /*故障老化验证*/
{
  byte Data_3[3]={0x19,0x02,0x01};
  byte Data_0[3]={0x19,0x02,0x89};
  if(ID==funreq_ID && Fun_19==0)
  {
    _WriteEx_and_Report("","19服务不支持功能寻址");
    _Send_Diag(3,ID,Data_3);
    _TestResult(SendData,ID,"",NRC7F);
  }
  else
  {
    dword Ex[2];
    int i;
    _Set_Ready(Struct_Ready.Ready_Active);
    if(Geely3_Flage == 1)
      testWaitForTimeout(6000);
    _85_Check_DTC(9,0);
    _Close_One_Node(DTC_19[1]);
    _85_Check_DTC(1,DTC_19[1][1]);
    _Open_One_Node(DTC_19[1]);
    _85_Check_DTC(9,DTC_19[1][1]);
    _Set_Ready(0);
    for(i=0;i<DTC_Aging_counter_max;i++)
    {
      _K15_OFF();
      testWaitForTimeout(K15_OFF_Time);
      _K15_On();
      _WriteEx_and_Report("","  第%d次上下电  ",i+1);
      if(strncmp(ECU_project,"Geely3.0",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Geely3.0"))
      {
        _Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(7000);      
        _85_Check_DTC(9,DTC_19[1][1]);
         testWaitForTimeout(500);
        _Set_Ready(0);
         testWaitForTimeout(2000);
      }
      else
      {
        testWaitForTimeout(CAN_Init_Time);
        _85_Check_DTC(9,DTC_19[1][1]);
        testWaitForTimeout(500);
      }
    }
    _K15_OFF();
    testWaitForTimeout(K15_OFF_Time);
    _K15_On();
    if(strncmp(ECU_project,"Geely3.0",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Geely3.0"))
    {
      _Set_Ready(Struct_Ready.Ready_Active);
      testWaitForTimeout(7000);      
      _85_Check_DTC(9,0);
       testWaitForTimeout(500);
      _Set_Ready(0);
       testWaitForTimeout(2000);
    }
    else
    {
      testWaitForTimeout(CAN_Init_Time);
      _85_Check_DTC(9,0);
      testWaitForTimeout(500);
    }
  }
}
_19_Serve_22(dword ID,byte Session) /*19 02读取故障_上下电*/
{ 
  byte Data_3[3]={0x19,0x02,0x09};
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
    if(Session!=defsession)
      _SetSession(Session);
    StepByGeely3_0(0x19,1);
    diagStartTesterPresent(Cdd_Name);
    _Open_All();
    testWaitForTimeout(5000);
    _85_Check_DTC(9,0);
    _Close_One_Node(DTC_19[1]);
    _Send_Diag(3,ID,Data_3);
    _Check_190201(SendData,DTC_19[1][1],DTC_19[1][2]);
    
    _Open_One_Node(DTC_19[1]);
    testWaitForTimeout(1000);
    _Send_Diag(3,ID,Data_3);
    _Check_190201(SendData,DTC_19[1][1],DTC_19[1][2]);
    
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
    testWaitForTimeout(CAN_Init_Time-500);
    if(Session!=defsession)
      _SetSession(Session);
    _Send_Diag(3,ID,Data_3);
    _Check_190201(SendData,DTC_19[1][1],DTC_19[1][2]);
    
    _Clear_DTC(phyreq_ID);
    testWaitForTimeout(500);
    _85_Check_DTC(9,0);
    
    _Power_Down();
    testWaitForTimeout(2000);
    _Power_Up();
    testWaitForTimeout(CAN_Init_Time);
    _85_Check_DTC(9,0);
  }
}
