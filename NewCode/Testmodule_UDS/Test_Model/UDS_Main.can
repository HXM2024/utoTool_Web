_27_Serve_11(dword ID,byte Session)    /*未解锁状态-会话切换*/
{
  int i;
  dword seed;
  byte Data[2] = {0x10,0x02};
  byte Flage_;
  Flage_= 0;
  diagStartTesterPresent(Cdd_Name);
  if(Error_Count>=3)
  {
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC35);
    testWaitForTimeout(50);
    _SetSession(defsession);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC35);
    testWaitForTimeout(100);
    if(Unlock_1002==1)
      _WriteEx_and_Report("","10 02有安全访问条件,跳过测试");
    else 
    {
      if(Pre_Programmed_1002 == 1 && Pre_Programmed_UnlockECU ==1)
        _WriteEx_and_Report("","10 02有预编程条件且需安全访问,跳过测试");
      else if(Pre_Programmed_1002 == 1 && Pre_Programmed_UnlockECU == 0)
      {
        Flage_ = 1;
        _get_Arry("Pre_Programmed");
        if(Arry_Len == 0)
          _WriteEx_and_Report("","未查询到对应预编程报文");
        else
        {
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          _TestResult(SendData,phyreq_ID,"",-1);
        }
      }
      else if(Pre_Programmed_1002==0)
        Flage_ = 1;
      if(Flage_ == 1)
      {
        _Send_Diag(2,phyreq_ID,Data);
        _TestResult(SendData,phyreq_ID,"",-1);
        testWaitForTimeout(2000);
        _SetSession(defsession);
        testWaitForTimeout(1000);
      }
    }
    testWaitForTimeout(1000);
    _SetSession(exsession);
    for(i=3;i<=Error_Count;i++)
    {
      if(i==Error_Count)
      {
        _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
        _TestResult(SendData,ID,"",NRC36);
      }
      else
      {
        _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
        _TestResult(SendData,ID,"",NRC35);
      }
      testWaitForTimeout(50);
    }
    testWaitForTimeout(Error_Count_Delay*0.7);
    _SetSession(exsession);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
  }
  else if(Error_Count==2)
  {
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC35);
    testWaitForTimeout(50);
    _SetSession(defsession);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC36);
    testWaitForTimeout(Error_Count_Delay*1.1);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC35);
    testWaitForTimeout(500);

    if(Unlock_1002==1)
    {
      _SetSession(exsession);
      _WriteEx_and_Report("","10 02有安全访问条件,跳过测试");
    }
    else 
    {
      if(Pre_Programmed_1002 == 1 && Pre_Programmed_UnlockECU ==1)
        _WriteEx_and_Report("","10 02有预编程条件且需安全访问,跳过测试");
      else if(Pre_Programmed_1002 == 1 && Pre_Programmed_UnlockECU == 0)
      {
        Flage_ = 1;
        _get_Arry("Pre_Programmed");
        if(Arry_Len == 0)
          _WriteEx_and_Report("","未查询到对应预编程报文");
        else
        {
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          _TestResult(SendData,phyreq_ID,"",-1);
        }
      }
      else if(Pre_Programmed_1002==0)
        Flage_ = 1;
      if(Flage_ == 1)
      {
        _Send_Diag(2,phyreq_ID,Data);
        _TestResult(SendData,phyreq_ID,"",-1);
        testWaitForTimeout(2000);
        _SetSession(defsession);
        testWaitForTimeout(2000);
        _SetSession(exsession);
        if(Restoration_Error_Count == 1)
        {
          _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
          _TestResult(SendData,ID,"",NRC35);
        }
      }
    }
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC36);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
  }
  if(strncmp(ECU_project,"Seres",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Seres"))
    testWaitForTimeout(100000);
  testWaitForTimeout(Error_Count_Delay+3000);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
}

_27_Serve_12(dword ID,byte Session)   /*解锁后计数器清零*/
{
  int i;
  dword seed;
  diagStartTesterPresent(Cdd_Name);
  
  _WriteEx_and_Report("","步骤1: 错误计数器累加");
  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  testWaitForTimeout(500);
  
  _WriteEx_and_Report("","步骤2: 会话切换");
  // _SetSession(defsession);
  _SetSession(exsession);
  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(500);
  
  _WriteEx_and_Report("","步骤3: 11复位");
  _Set_11_Restoration(0);
  testWaitForTimeout(3000);
  _SetSession(exsession);
  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(500);
  
  _WriteEx_and_Report("","步骤4: 正常上下电");
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  testWaitForTimeout(2000);
  _SetSession(exsession);
  _Check_Error_Count(ID,Error_Count);
  seed = _get_seed(ID);
  _TestResult(SendData,ID,"",NRC37);
  _Send_Key(SendKey_Len,ID,seed,1);
  _TestResult(SendData,ID,"",NRC24);
  testWaitForTimeout(500);
  testWaitForTimeout(Error_Count_Delay+3000);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
}

_27_Serve_13(dword ID,byte Session)   /*未解锁状态-上下电*/
{
  dword seed;
  int i;
  diagStartTesterPresent(Cdd_Name);
  _Set_CarSpd(0);
  _Set_Ready(0);
  if(Restoration_Error_Count == 0)
  {
    for(i=1;i<=Error_Count;i++)
    {
      if(i==Error_Count)
      {
        _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
        _TestResult(SendData,ID,"",0x36);
      }
      else
      {
        _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
        _TestResult(SendData,ID,"",0x35);
        _K15_OFF();
        testWaitForTimeout(K15_OFF_Time);
        _K15_ON();
        testWaitForTimeout(2000);
        _SetSession(exsession);
      }
    }
    testWaitForTimeout(Error_Count_Delay*0.5);
    _K15_OFF();
    testWaitForTimeout(K15_OFF_Time);
    _K15_ON();
    testWaitForTimeout(2000);
    testWaitForTimeout(Error_Count_Delay*0.6);
    _SetSession(exsession);
    if(Error_Count_Delay_Reset==1)
    {
      seed = _get_seed(ID);
      _TestResult(SendData,ID,"",NRC37);
      _Send_Key(SendKey_Len,ID,seed,1);
      _TestResult(SendData,ID,"",NRC24);
      testWaitForTimeout(Error_Count_Delay*0.6);
      _SetSession(exsession);
    }
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",-1);
    _Send_Key(SendKey_Len,ID,seed,0);
    _TestResult(SendData,ID,"",-1);
  }
  else if(Restoration_Error_Count == 1)/*Restoration_Error_Count 重启是否会重置错误计数器*/
  {
    int j;
    j = 1;
    for(i=1;i<=Error_Count;i++)
    {
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
      if(i == Error_Count)
        _TestResult(SendData,ID,"",0x36);
      else
        _TestResult(SendData,ID,"",0x35);
      if(j==i && i!=Error_Count)
      {
        _K15_OFF();
        testWaitForTimeout(K15_OFF_Time+500);
        _K15_ON();
        testWaitForTimeout(500);
        _SetSession(exsession);
        testWaitForTimeout(1000);
        j++;
        i = 0;
      }
    }
  //  _Check_Error_Count(ID,Error_Count); 
  //  seed = _get_seed(ID);
  //  _TestResult(SendData,ID,"",NRC37);
   testWaitForTimeout(Error_Count_Delay*0.5);
   _K15_OFF();
   testWaitForTimeout(K15_OFF_Time);
   _K15_ON();
   testWaitForTimeout(1000);
   _SetSession(exsession);
   testWaitForTimeout(Error_Count_Delay*0.6);
   if(Error_Count_Delay_Reset==1)
   {
     seed = _get_seed(ID);
     _TestResult(SendData,ID,"",NRC37);
     testWaitForTimeout(Error_Count_Delay*0.6);
   }
   seed = _get_seed(ID);
   _TestResult(SendData,ID,"",-1);
   _Send_Key(SendKey_Len,ID,seed,0);
   _TestResult(SendData,ID,"",-1);
  }
}

_27_Serve_14(dword ID,byte Session)   /*下电对错误计数影响测试_错误计数器满*/
{
  dword seed;
  diagStartTesterPresent(Cdd_Name);
  _Set_CarSpd(0);
  _Set_Ready(0);
