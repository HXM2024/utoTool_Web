}
_31_Serve_43(dword ID,byte Session,byte Serv_)/* 特殊优先级处理*/
{
  int Serve_Pos,i,j;
  char Temp_Str[200];
  char Temp_Str_[200];
  byte Send_Data[100];
  dword Fun_;
  int Send_Len,Step_Battery,Count_Battery;
  if(Serv_ != 0x31)
    Serve_Pos = _Check_Serve(Serv_,0,0);
  snprintf(Temp_Str,elCount(Temp_Str),"");
  snprintf(Temp_Str_,elCount(Temp_Str_),"");
  snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务",Serv_);
  if(Serv_ != 0x31)
  {
    
  }
  else if(Serv_ == 0x31)
  {
    for(i=0;i<Serve_31_Hex_Count;i++)
    {
      if(Serve_31_Hex[i].Serve_NRC_Special_Count[0]!= 0)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务%02X%02X例程,特殊NRC优先级测试",Serv_,Serve_31_Hex[i].Routine[0],Serve_31_Hex[i].Routine[1]);
        {
          _WriteEx_and_Report("","------------------------------------------------------");
          _WriteEx_and_Report("",Temp_Str);
          _WriteEx_and_Report("","------------------------------------------------------");
          Send_Data[0] = 0x31;
          Send_Data[1] = Serve_31_Hex[i].Control_Type[0];
          Send_Data[2] = Serve_31_Hex[i].Routine[0];
          Send_Data[3] = Serve_31_Hex[i].Routine[1];
          Fun_ = ((Send_Data[2]<<8)|(Send_Data[3]));
          Send_Len = Serve_31_Hex[i].Routine_Len;
          Step_Battery = 0;
          Count_Battery = 0;
          if(Send_Len==5)
            Send_Data[4] = Serve_31_Hex[i].Control_Option[0][0];
          _unlockECU();
          testWaitForTimeout(300);
          _Set_NRC_Special_Step(0x31,Fun_,Send_Data[1],Send_Data);
          if((_Check_NRC_In_31H(Fun_,0,0X92) != -1) && (_Check_NRC_In_31H(Fun_,0,0X93) != -1)) //两个电压同时存在
            Count_Battery = 2;
          for(j=0;j<Fun_NRC_Count;j++)
          {
            if(Fun_NRC[j] == 0x92 || Fun_NRC[j] == 0x93)
              _Geely_NewNRC22(Fun_NRC[j],1);           
            if(Fun_NRC[j] == 0xF2)
            {
              _Geely_NewNRC22(Fun_NRC[j],0);
              _Set_CarSpd(0);
              _Geely_NewNRC22(Fun_NRC[j],1);
            }
            if(j==Fun_NRC_Count)
            {
              _Send_Diag(Send_Len,ID,Send_Data);
              _TestResult(SendData,ID,"",-1);
            }
            else
            {
              _Send_Diag(Send_Len,ID,Send_Data);
              _TestResult(SendData,ID,"",Fun_NRC[j]);
            }
            testWaitForTimeout(200);
            if(Fun_NRC[j] == 0x92 || Fun_NRC[j] == 0x93)
            {
              Step_Battery++;
              if(Step_Battery == 2)
                _Set_Battery(12);
            }
            else
              _Recover_NRC_Special_Step(Fun_NRC[j],Send_Data);
          }
        }
        _WriteEx_and_Report("","---------------------------------");
        {
          _WriteEx_and_Report("","进行复位防止前面影响到后续测试");
          _Set_11_Restoration();
          _SetSession(Session);
        }
      }
      else
        _WriteEx_and_Report("","无特殊优先级输入,跳过测试");
    }
  }
}

_31_Serve_44_VX11(dword ID,byte Session)/* 特殊优先级处理Geely1.0*/
{
  byte Data[4] = {0x31,0x01,0x32,0xF0};
  int Pos,Type_Pos;
  dword Rid;
  Rid = 0x32F0;
  Pos = _Check_Serve(0x01,Rid,12);
  if(Pos != -1)
  {
    Type_Pos = _Check_SendData_In_31H(Data);
    if(Type_Pos != -1)
    {
      if(Serve_31_Hex[Pos].Serve_NRC_Special_Count[Type_Pos]!= 0)
      {
        _unlockECU();
        _Set_CarSpd(NRC22_CarSpd+1);
        _Set_Ready(0);
        _Set_Battery(NRC22_Battery_Hight+0.2);
        _Send_Diag(4,ID,Data);
        _TestResult(SendData,ID,"",0x92);
        _Set_Battery(NRC22_Battery_Low-0.2);
        _Send_Diag(4,ID,Data);
        _TestResult(SendData,ID,"",0x93);
        _Set_Battery(14);
        _Send_Diag(4,ID,Data);
        _TestResult(SendData,ID,"",0x88);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
        _Send_Diag(4,ID,Data);
        _TestResult(SendData,ID,"",0x88);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
        _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
        _Send_Diag(4,ID,Data);
        _TestResult(SendData,ID,"",0x88);
        _Reset_CarSpd_Invalid();
        _Set_CarSpd(0);
        testWaitForTimeout(200);
        _TestDisableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
        _Send_Diag(4,ID,Data);
        _TestResult(SendData,ID,"",0xF2);
        _TestEnableMsg(Struct_CarSpd.Sig_Id);
        testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
        _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
        _Send_Diag(4,ID,Data);
        _TestResult(SendData,ID,"",0xF2);
        _Reset_CarSpd_Invalid();
        _Set_CarSpd(0);
        if(_Check_Dword_in_Num(0x84,Serve_31_Hex[Pos].Serve_NRC_Special[Type_Pos],Serve_31_Hex[Pos].Serve_NRC_Special_Count[Type_Pos])!= -1)
        {
          _Send_Diag(4,ID,Data);
          _TestResult(SendData,ID,"",0x84);
          _TestDisableMsg(Struct_Ready.Sig_Id);
          testWaitForTimeout(1000);
          _Send_Diag(4,ID,Data);
          _TestResult(SendData,ID,"",0x84);
          _TestEnableMsg(Struct_Ready.Sig_Id);
          testWaitForTimeout(1000);
          if(strlen(Struct_Ready.ReadyInvalid_Sig) != 0)
          {
            _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
            testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
            _Send_Diag(4,ID,Data);
            _TestResult(SendData,ID,"",0x84);
            _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
            testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
          }
          if(_Check_Dword_in_Num(0xF1,Serve_31_Hex[Pos].Serve_NRC_Special[Type_Pos],Serve_31_Hex[Pos].Serve_NRC_Special_Count[Type_Pos])!= -1)
          {
            _Set_Ready(Struct_Ready.Ready_Active);
            _TestDisableMsg(Struct_Ready.Sig_Id);
            testWaitForTimeout(1000);
            _Send_Diag(4,ID,Data);
            _TestResult(SendData,ID,"",0xF1);
            _TestEnableMsg(Struct_Ready.Sig_Id);
            testWaitForTimeout(1000);
            if(strlen(Struct_Ready.ReadyInvalid_Sig) != 0)
            {
              _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
              testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
              _Send_Diag(4,ID,Data);
              _TestResult(SendData,ID,"",0xF1);
              _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
              testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
            }
          }
          _Set_Ready(0);
        }
      }
      else
        _WriteEx_and_Report("","无特殊NRC优先级输入");
    }
    else
      _WriteEx_and_Report("","未查询到31 01 32 F0数据");
  }
  else
    _WriteEx_and_Report("","未查询到0x32F0 RID数据");
}
_31_Serve_45(dword ID,byte Session)/* 更新条件查询 02 06*/
{
  byte SendData[6] = {0x31,0x01,0x02,0x06,0,0};
  int Send_Len,i;
  dword FunDID;
  int FunPos;
  
  Send_Len = 4;
  FunDID = 0x0206;
  _get_Arry("Pre_Programmed");
  if(Arry_Len>1)
  {
    FunDID = (Arry_Data[2]<<8)|Arry_Data[3];
    Send_Len = Arry_Len;
    for(i=0;i<Arry_Len;i++)
      SendData[i] = Arry_Data[i];
  }
  FunPos = _Check_Serve(0x01,FunDID,12);
  if(FunPos != -1)
  {
    _Set_CarSpd(0);
    testWaitForTimeout(1000);
    _Send_Diag(Send_Len,ID,SendData);
    _Check_31Routine_Rx(SendData,1);
    _Set_CarSpd(NRC22_CarSpd+1);
    testWaitForTimeout(1000);
    _Send_Diag(Send_Len,ID,SendData);
      
    if((Serve_31_Hex[FunPos].Serve_NRC22[0]&1) == 1)
      _Check_31Routine_Rx(SendData,0);
    else
      _Check_31Routine_Rx(SendData,1);
    _Set_CarSpd(NRC22_CarSpd-1);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(1000);
    // _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
    _Send_Diag(Send_Len,ID,SendData);
    _Check_31Routine_Rx(SendData,1);
    // _Reset_CarSpd_Invalid();
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(500);
  }
}
_31_Serve_46(dword ID,byte Session)/* 对中 传感器，角度，扭矩正常*/
{
  byte Send_Data[6] = {0x31,0x01,0x30,0x7B,0,0};
  byte SendDataCheck[6] = {0x31,0x03,0x30,0x7B,0,0};
  int Send_Len,i,Flage_For_Unlock;
  dword FunDID;
  Send_Len = 4;
  FunDID = 0x307B;
  _get_Arry("Angle_Calibration");
  if(Arry_Len>1)
  {
    Send_Len = Arry_Len;
    FunDID = (Arry_Data[2]<<8)|Arry_Data[3];
    for(i=0;i<Arry_Len;i++)
      Send_Data[i] = Arry_Data[i];
    for(i=0;i<Arry_Len;i++)
      SendDataCheck[i] = Send_Data[i];
    SendDataCheck[1] = 0x03;
  }
  Flage_For_Unlock = _Check_Serve(0x01,FunDID,11);
  _Set_11_Restoration();
  
  diagStartTesterPresent(Cdd_Name);
  _ClearAngle(1);
  _SetSession(Session);
  _Set_Ready(0);
  StepByGeely3_0(0x19,1);
  if(Flage_For_Unlock == 1)
    _unlockECU();
  _Send_Diag(Send_Len,ID,SendDataCheck);
  _TestResult(SendData,ID,"",NRC24);
  testWaitForTimeout(50);
  _Send_Diag(Send_Len,ID,Send_Data);
  _Check_31Routine_Rx(Send_Data,1);
  testWaitForTimeout(50);
  _Send_Diag(Send_Len,ID,SendDataCheck);
  _Check_31Routine_Rx(SendDataCheck,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(1,0,Ang_NotCal);
  
  _WriteEx_and_Report("","此处测试不转动方向盘验证外发角度");
  _Power_Down();
  testWaitForTimeout(2000);
  _Power_Up();
  _TestWaitForTesterConfirmation("检测外发角度是否趋近0°");
  if(Geely3_Flage == 1)
  {
    _Set_Ready(Struct_Ready.Ready_Active);
    testWaitForTimeout(6000);
  }
  if(Session != defsession)
    _SetSession(Session);
  _Check_DTC_Res(1,0,Ang_NotCal);
  if(Flage_For_Unlock == 1)
    _unlockECU();
  _Send_Diag(Send_Len,ID,Send_Data);
  _Check_31Routine_Rx(Send_Data,1);
  testWaitForTimeout(50);
  _Send_Diag(Send_Len,ID,SendDataCheck);
  _Check_31Routine_Rx(SendDataCheck,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(1,0,Ang_NotCal);
  
  _TestWaitForTesterConfirmation("转动方向盘后点击Yes");
  _Check_DTC_Res(1,0,Ang_NotCal);
  if(Flage_For_Unlock == 1)
    _unlockECU();
  _Send_Diag(Send_Len,ID,Send_Data);
  _Check_31Routine_Rx(Send_Data,1);
  testWaitForTimeout(50);
  _Send_Diag(Send_Len,ID,SendDataCheck);
  _Check_31Routine_Rx(SendDataCheck,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(1,0,Ang_NotCal);
  
  _TestWaitForTesterConfirmation("转动方向盘向另一个方向后点击Yes");
  _Check_DTC_Res(1,0,Ang_NotCal);
  if(Flage_For_Unlock == 1)
    _unlockECU();
  _Send_Diag(Send_Len,ID,Send_Data);
  _Check_31Routine_Rx(Send_Data,1);
  testWaitForTimeout(50);
  _Send_Diag(Send_Len,ID,SendDataCheck);
  _Check_31Routine_Rx(SendDataCheck,1);
  testWaitForTimeout(200);
  _Check_DTC_Res(1,0,Ang_NotCal);
}

