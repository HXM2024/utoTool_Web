void _Serve10_02(dword ID,byte Session,byte Serv_,byte Type)/*遍历NRC22条件*/
{
  int Serve_Pos,i;
  int Fun_Count;
  char Temp_Str[200];
  char Temp_Str_[200];
  int Clear_Config_Flage,SWhere;
  int Flage_In,Start_Fun;
  Get_value_For_NRC22_Loop();
  if(Serv_ != 0x31)
    Serve_Pos = _Check_Serve(Serv_,0,0);
  snprintf(Temp_Str,elCount(Temp_Str),"");
  snprintf(Temp_Str_,elCount(Temp_Str_),"");
  snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务",Serv_);
  Start_Fun = 0;
  if(Serv_ != 0x31)
  {
    if(Serve_Pos != -1)
    {
      Fun_Count = Serve_Data[Serve_Pos].Serve_Fun_Count;
      
      Clear_Config_Flage = 0;
      if(Serv_ == 0x2E)
      {
        _get_Str_Traversal("DID_2E_Traversal");
        Fun_Count = Traversal_Count;
        if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
        {
          for(i=0;i<Traversal_Count;i++)
          {
            if((strncmp(Traversal_DID[i],"DID2E_F1A1",strlen(Traversal_DID[i])) == 0 && strlen(Traversal_DID[i]) == strlen("DID2E_F1A1")) || (strncmp(Traversal_DID[i],"DID2E_2100",strlen(Traversal_DID[i])) == 0 && strlen(Traversal_DID[i]) == strlen("DID2E_2100")))
            {
              SWhere = i;
              Clear_Config_Flage = 1;
              break;
            }
          }
          if(Clear_Config_Flage == 1)
          {
            byte Data_Send[11] = {0x2E,0xF1,0xA1,0,0,0,0,0,0,0,0x55};
            _unlockECU();
            _Send_Diag(11,phyreq_ID,Data_Send);
            _TestResult(SendData,ID,"",-1);
            _SetSession(Session);
          }
        }  
      }
      
      Flage_In = _Check_Dword_in_Num(Serv_,NRC22_Loop_Fun,NRC22_Loop_Fun_Count);/*判断是否检测全部子功能*/
      if(Flage_In == -1)
      {
        int Fun_Pos;
        Fun_Count = 1;
        Fun_Pos = _Check_Dword_in_Num(Serv_,NRC22_Loop_Fun_Pos,NRC22_Loop_Fun_Pos_Count);
        if(Fun_Pos!= -1)
        {
          Start_Fun = NRC22_Loop_Fun_Pos[Fun_Pos][1]-1;
          Fun_Count = Start_Fun+1;
        }
      }
      if(Serv_ == 0x22)  //22服务特殊处理,仅验证一个
        Fun_Count = 1;
      for(i=Start_Fun;i<Fun_Count;i++)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务%02X子功能,NRC22条件",Serv_,Serve_Data[Serve_Pos].Serve_Fun[i]);
        if(Serv_ == 0x14)
          snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务,NRC22条件",Serv_);
        if(_Check_Fun_IDAndSess(Serv_,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
        {
          _WriteEx_and_Report("","------------------------------------------------------");
          _WriteEx_and_Report("",Temp_Str);
          _WriteEx_and_Report("","------------------------------------------------------");
          _NRC22_Test_Loop(Serv_,i,ID,Session,Type);
        }
        else
        {
          snprintf(Temp_Str_,elCount(Temp_Str_),"0x%02X 0x%02X",Serv_,Serve_Data[Serve_Pos].Serve_Fun[i]);
          _WriteEx_and_Report(Temp_Str_,"当前寻址或会话下不支持该子功能");
        }
      }
      if(Clear_Config_Flage == 1)
      {
        _unlockECU();
        _get_2E_DID(Traversal_DID[SWhere]);
        _Send_Diag(DID_2E_SendData_1_Len,phyreq_ID,DID_2E_SendData_1);
        _TestResult(SendData,ID,"",-1);
      }
    }
  }
  else if(Serv_ == 0x31)
  {
    Fun_Count = Serve_31_Hex_Count;
    
    Flage_In = _Check_Dword_in_Num(Serv_,NRC22_Loop_Fun,NRC22_Loop_Fun_Count);/*判断是否检测全部子功能*/
    if(Flage_In == -1)
    {
      int Fun_Pos;
      Fun_Count = 1;
      Fun_Pos = _Check_Dword_in_Num(Serv_,NRC22_Loop_Fun_Pos,NRC22_Loop_Fun_Pos_Count);
      if(Fun_Pos!= -1)
      {
        Start_Fun = NRC22_Loop_Fun_Pos[Fun_Pos][1]-1;
        Fun_Count = Start_Fun+1;
      }
    }
    for(i=Start_Fun;i<Fun_Count;i++)
    {
      snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务%02X%02X例程,NRC22条件",Serv_,Serve_31_Hex[i].Routine[0],Serve_31_Hex[i].Routine[1]);
      {
        _WriteEx_and_Report("","------------------------------------------------------");
        _WriteEx_and_Report("",Temp_Str);
        _WriteEx_and_Report("","------------------------------------------------------");
        _NRC22_Test_Loop(Serv_,i,ID,Session,Type);
      }
    }
  }
}
void _Serve10_03(dword ID,byte Session)   /*1002自动退出诊断故障*/
{
  byte Send[2] = {0x10,0x02};
  _Set_Ready(0);
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(1000);
  StepByGeely3_0(0x19,1);
  _SetSession(Session);
  _85_Check_DTC(9,0);
  
  _Set_Ready(0);
  _Other_1002();
  _Send_Diag(2,ID,Send);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(S3_85_Time);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  _85_Check_DTC(9,0);
  _K30_OFF();
  testWaitForTimeout(1000);
  _K30_ON();
  testWaitForTimeout(CAN_Init_Time+1000);
  if(CAN_Init_Time+1000<5000 && Geely3_Flage == 1)
    testWaitForTimeout(5000 - CAN_Init_Time);
  _85_Check_DTC(9,Abnormal_Reset);
  _Set_Ready(0);
}
void _Serve10_04(dword ID,byte Session)   /*1002会话切换诊断故障*/
{
  byte Send[2] = {0x10,0x02};
  _Set_Ready(0);
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(1000);
  StepByGeely3_0(0x19,1);
  _SetSession(Session);
  _85_Check_DTC(9,0);
  
  _Set_Ready(0);
  _Other_1002();
  _Send_Diag(2,ID,Send);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(defsession);
  testWaitForTimeout(1000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  _85_Check_DTC(9,0);
  
  _K30_OFF();
  testWaitForTimeout(1000);
  _K30_ON();
  testWaitForTimeout(CAN_Init_Time+1000);
  if(CAN_Init_Time+1000<5000 && Geely3_Flage == 1)
    testWaitForTimeout(5000 - CAN_Init_Time);
  _85_Check_DTC(9,Abnormal_Reset);
  _Set_Ready(0);
}
void _Serve10_05(dword ID,byte Session)   /*1002复位诊断故障*/
{
  byte Send[2] = {0x10,0x02};
  byte Send_2[2] = {0x11,0x02};
  int Serve_Pos;
  Serve_Pos = _Check_Serve(0x11,0,0);
  Send_2[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  
  _Set_Ready(0);
  _Power_Down();
  _Power_Up();
  testWaitForTimeout(1000);
  StepByGeely3_0(0x19,1);
  _SetSession(Session);
  _85_Check_DTC(9,0);
  
  _Set_Ready(0);
  _Other_1002();
  _Send_Diag(2,ID,Send);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  if(Serve_Data[Serve_Pos].Security_Access[0] == 1)
  {
    Security_access_BT();
    testWaitForTimeout(500);
  }
  _Send_Diag(2,ID,Send_2);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(3000);
  _Set_Ready(Struct_Ready.Ready_Active);
  testWaitForTimeout(6000);
  _85_Check_DTC(9,0);
  
  _K30_OFF();
  testWaitForTimeout(1000);
  _K30_ON();
  testWaitForTimeout(CAN_Init_Time+1000);
  if(CAN_Init_Time+1000<5000 && Geely3_Flage == 1)
    testWaitForTimeout(5000 - CAN_Init_Time);
  _85_Check_DTC(9,Abnormal_Reset);
  _Set_Ready(0);
}

/*
    长安工厂模式力矩相关测试
    Type = 0：进入工厂模式
    Type = 1：退出工厂模式
*/
void _Serve10_CCAG_Torque(dword ID,byte Session,byte Type)/*工厂模式-力矩边界值*/
{
  byte Send_Data_1[2];
  Byte Send_Fac_In[6] = {0x2E,1,0,0,0,0};
  int i,j;
  float Torque_Set[4] = {2,1.9,-2,-1.9};
  Send_Data_1[0] = 0x10;
  if(Type == 0)
    Send_Fac_In[3] = 0;
  else
    Send_Fac_In[3] = 1;
  _unlockECU();
  _Send_Diag(6,phyreq_ID,Send_Fac_In);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_11_Restoration(0);
  testWaitForTimeout(1000);
  for(i=0;i<4;i++) 
  {
    _TestWaitForTesterConfirmation("施加方向盘力矩 %.2f Nm，并保持",Torque_Set[i]);
    for(j=1;j<4;j++)
    {
      if(j==2)
        _Pre_Programmed();
      Send_Data_1[1] = j;
      _Send_Diag(2,ID,Send_Data_1);
      if((j == 2) && (i==0 || i == 2))
        _TestResult(SendData,ID,"",0x22);
      else
      {
        _TestResult(SendData,ID,"",-1);
        if(j == 2)
        {
          testWaitForTimeout(1000);
          _SetSession(defsession);
          testWaitForTimeout(2000);
        }
      }
    }
  }
}

/*
    长安工厂模式电压相关测试
    Type = 0：进入工厂模式
    Type = 1：退出工厂模式
*/
void _Serve10_CCAG_Battery(dword ID,byte Session,byte Type)/*工厂模式-电压边界*/
{
  byte Send_Data_1[2];
  Byte Send_Fac_In[6] = {0x2E,1,0,0,0,0};
  int i,j;
  float Battery_Set[4] = {8.9,9,16.1,16};
  Send_Data_1[0] = 0x10;
  if(Type == 0)
    Send_Fac_In[3] = 0;
  else
    Send_Fac_In[3] = 1;
  _unlockECU();
  _Send_Diag(6,phyreq_ID,Send_Fac_In);
  _TestResult(SendData,phyreq_ID,"",-1);
  _Set_11_Restoration(0);
  testWaitForTimeout(1000);
  for(i=0;i<4;i++)
  {
    _Set_Battery(Battery_Set[i]);
    for(j=1;j<4;j++)
    {
      if(j==2)
        _Pre_Programmed();
      Send_Data_1[1] = j;
      _Send_Diag(2,ID,Send_Data_1);
      if((j == 2) && (i==0 || i == 2))
        _TestResult(SendData,ID,"",0x22);
      else
      {
        _TestResult(SendData,ID,"",-1);
        if(j == 2)
        {
          testWaitForTimeout(1000);
          _SetSession(defsession);
          testWaitForTimeout(2000);
        }
      }
    }
  }
}

void _ServeNRC7F(dword ID,byte Session,byte Serve)/*7F>13*/
{
  byte Send_Data[20];
  int Serve_Pos,i,j,k,LenMax,FlagePara,PosForPara;
  Send_Data[0] = Serve;
  Serve_Pos = _Check_Serve(Serve,0,0);
  
  if(Serve != 0x31)
  {
    if(_Check_Serve_IDAndSess(Serve,ID,Session) != 1)
    {
      for(i=1;i<20;i++)
        Send_Data[i] = 0;
      LenMax = Get_ServeMaxLen(Serve,1);
      if(Serve == 0x2E)
        LenMax = 3;
      for(i=1;i<=LenMax+1;i++)
      {
        if(Serve == 0x2E && i == 2)
          continue;
        if(Serve == 0x27 && (i > 3 && i < SendKey_Len))
          continue;
        if(i>=2) // 当长度≥2时开始遍历全部支持的子功能
        {
          for(j=0;j<Serve_Data[Serve_Pos].Serve_Fun_Count+1;j++)
          {
            PosForPara = j;
            if(Serve == 0x2E || Serve == 0x22)
            {
              if(j == Serve_Data[Serve_Pos].Serve_Fun_Count) //测试完全部支持子功能后测试1个不支持子功能
                _Get_Serve_NRC31(Serve,0,Send_Data);
              else
              {
                Send_Data[1] = (Serve_Data[Serve_Pos].Serve_Fun[j]>>8) &0xFF;
                Send_Data[2] = Serve_Data[Serve_Pos].Serve_Fun[j] &0xFF;
              }
            }
            else //非2E服务取子功能
            {
              if(j == Serve_Data[Serve_Pos].Serve_Fun_Count) //测试完全部支持子功能后测试1个不支持子功能
              {
                Send_Data[1] = _Get_Invalid_Fun(Serve,0);
                PosForPara = j-1;
              }
              else
                Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[j];
            }
            FlagePara = (Serve_Data[Serve_Pos].Serve_Para_Count[PosForPara] == 0)?0:1;
            if(FlagePara == 1 && i>2)
            {
              for(k=0;k<Serve_Data[Serve_Pos].Serve_Para_Count[PosForPara]+1;k++)
              {
                if(k == Serve_Data[Serve_Pos].Serve_Para_Count[PosForPara])
                  _Get_Serve_NRC31(Serve,0,Send_Data);
                else
                  Send_Data[2] = Serve_Data[Serve_Pos].Serve_Para[PosForPara][k];
                _Send_Diag(i,ID,Send_Data);
                _TestResult(SendData,ID,"",NRC7F);
                testWaitForTimeout(50);
              }
            }
            else
            {
              _Send_Diag(i,ID,Send_Data);
              _TestResult(SendData,ID,"",NRC7F);
              testWaitForTimeout(50);
            }
          }
        }
        else //长度为1，仅发送一次
        {
          _Send_Diag(i,ID,Send_Data);
          _TestResult(SendData,ID,"",NRC7F);
          testWaitForTimeout(50);
        }
      }
      if(Serve == 0x10 || Serve == 0x11)
        _Send_And_Check_NowSession(ID,Session); 
    }
  }
  else
  {
    for(i=1;i<20;i++)
      Send_Data[i] = 0;
    LenMax = Get_ServeMaxLen(Serve,1);
    for(i=1;i<=LenMax+1;i++)
    {
      if(i==3)
        continue;
      if(i==1)
      {
        _Send_Diag(i,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC7F);
        testWaitForTimeout(50);
      }
      else if(i==2) //无对应RID情况下，测试01-03例程控制，对0x70进行不支持测试
      {
        for(j=1;j<4;j++)
        {
          Send_Data[1] = j;
          _Send_Diag(i,ID,Send_Data);
          _TestResult(SendData,ID,"",NRC7F);
          testWaitForTimeout(50);
        }
        Send_Data[1] = 0x70;
        _Send_Diag(i,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC7F);
        testWaitForTimeout(50);
      }
      else
      {
        for(j=0;j<=Serve_31_Hex_Count;j++)
        {
          dword Temp_RID,RID_Pos;
          if(j != Serve_31_Hex_Count)
          {
            if(_Check_Serve_IDAndSess(0x31,j,ID,Session) == 1)
              continue;
          }
          if(j == Serve_31_Hex_Count)
            Send_Data[2] = _Get_Invalid_RID();
          else
          {
            Send_Data[2] = Serve_31_Hex[j].Routine[0];
            Send_Data[3] = Serve_31_Hex[j].Routine[1];
            Temp_RID = ((Send_Data[2]<<8)|Send_Data[3]);
          }
          RID_Pos = (j==Serve_31_Hex_Count)?(j-1):j;
          for(k=0;k<=Serve_31_Hex[RID_Pos].Control_Type_Count;k++)
          {
            Send_Data[1] = (k==Serve_31_Hex[RID_Pos].Control_Type_Count)?_Get_Invalid_RID_Control_Type(Temp_RID):Serve_31_Hex[RID_Pos].Control_Type[k];
            FlagePara = (k==Serve_31_Hex[RID_Pos].Control_Type_Count)?(k-1):k;
            if(i==4)
            {
              _Send_Diag(i,ID,Send_Data);
              _TestResult(SendData,ID,"",NRC7F);
              testWaitForTimeout(50);
            }
            if((Serve_31_Hex[RID_Pos].Routine_Len>=5) && i>=5 && j!=Serve_31_Hex_Count)
            {
              for(PosForPara=0;PosForPara<=Serve_31_Hex[RID_Pos].Control_Option_Count[FlagePara];PosForPara++)
              {
                if(PosForPara == Serve_31_Hex[RID_Pos].Control_Option_Count[FlagePara])
                  Send_Data[4] = _Get_Invalid_RID_Control_Option(0x31,Temp_RID,Serve_31_Hex[RID_Pos].Control_Type[FlagePara],0);
                else
                  Send_Data[4] = Serve_31_Hex[RID_Pos].Control_Option[FlagePara][PosForPara];
                _Send_Diag(i,ID,Send_Data);
                _TestResult(SendData,ID,"",NRC7F);
                testWaitForTimeout(50);
              }
            }
            else if((Serve_31_Hex[RID_Pos].Routine_Len || j==Serve_31_Hex_Count) && i>=5)
            {
              Send_Data[4] = random(255)&0xFF;
              _Send_Diag(i,ID,Send_Data);
              _TestResult(SendData,ID,"",NRC7F);
              testWaitForTimeout(50);
            }
          }
        }
      }
    }
  }
}
void _Serve11_01(dword ID,byte Session)/*遍历支持的子功能*/
{
  byte Send_Data[2];
  int Serve_Pos,Temp_Flage;
  byte Seed[2] = {0x27,0x02};
  Send_Data[0] = 0x11;
  Seed[1] = RequestSeed_27;
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","未查询到0x11服务支持");
  else
  {
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      if(i != 0)
        _SetSession(Session);
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      Temp_Flage = _Check_Fun_IDAndSess(0x11,Send_Data[1],ID,Session);
      if(Temp_Flage == 1)
      {
        if( Serve_Data[Serve_Pos].Security_Access[i] == 1)
        {
          _Send_Diag(2,ID,Send_Data);
          _TestResult(SendData,ID,"",NRC33);
          _Send_And_Check_NowSession(ID,Session); 
          _unlockECU();
        }
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(Wait_Time_11);
        _Send_Diag(2,phyreq_ID,Seed);
        _TestResult(SendData,phyreq_ID,"",NRC7F);
        _Send_And_Check_NowSession(ID,defsession); 
        /**************************助力检测***********************/
        {
          /*----------------暂无法实现---------------*/
        }
      }
      else if(Temp_Flage == 0 || (Temp_Flage == -1 && Session == defsession))
      {
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC7F);
        if(Session == exsession)
        {
          testWaitForTimeout(Wait_Time_11);
          _Send_Diag(2,phyreq_ID,Seed);
          _TestResult(SendData,phyreq_ID,"",-1);
        }
        _Send_And_Check_NowSession(phyreq_ID,Session); 
      }
      else if(Temp_Flage == -1 && Session == exsession)
      {
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC12);
        testWaitForTimeout(Wait_Time_11);
        _Send_Diag(2,phyreq_ID,Seed);
        _TestResult(SendData,phyreq_ID,"",-1);
        _Send_And_Check_NowSession(phyreq_ID,Session); 
      }
      testWaitForTimeout(2000);
    }
  }
}
void _Serve11_02(dword ID,byte Session)/*肯定响应抑制位测试*/
{
  _Step_Serve_RSP(0x11,ID,Session);
}

void _Serve11_03(dword ID,byte Session)/*NRC12*/
{
  byte Send_Data[2];
  int Serve_Pos,i;
  Send_Data[0] = 0x11;
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(_Check_Serve_IDAndSess(0x11,ID,Session) == 1)
  {
    if(Serve_Data[Serve_Pos].Security_Access[0]==1)
      _unlockECU();
    for(i=0;i<=0xFF;i++)
    {
      Send_Data[1] = i;
      if((_Check_Serve(0x11,i,4)!=-1) || ((_Check_Serve(0x11,(i&0x0F),4)!=-1) && ((i>>4)==0x08) && (_Check_Serve(0x11,i&0x0F,9) == 1)))
      {
        _WriteEx_and_Report("0x11服务","0x%02X该子功能支持",i);
        continue;
      }
      else
      {
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC12);
      }
    }
  }
  else
    _WriteEx_and_Report("","当前寻址或会话下不支持该服务");
}
void _Serve11_04(dword ID,byte Session)   /*NRC13*/
{
  byte Temp_0[2]={0x11,0x01};
  byte Len;
  int Serve_Pos,i;
  Len = _Check_CANFD_Flage();
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Len < Serve_Data[Serve_Pos].Serve_Fun_Len[0])
    Len = Serve_Data[Serve_Pos].Serve_Fun_Len[0]+1;
  if(_Check_Serve_IDAndSess(0x11,ID,Session) == 1)
  {
    if(Serve_Data[Serve_Pos].Security_Access[0]==1)
      _unlockECU();
    for(i=1;i<=Len;i++)
    {
      if(i==2)
      {
        _WriteEx_and_Report("","该长度支持，跳过");
        continue;
      }
      _Send_Diag(i,ID,Temp_0);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  else
    _WriteEx_and_Report("","当前寻址或会话下不支持该服务");
}

void _Serve11_05(dword ID,byte Session)   /*NRC22_车速*/
{
  int Serve_Pos,NRC22_Flage;
  int i;
  byte Send_Data[2];
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持11服务,跳过检测");
  else
  {
    Send_Data[0] = 0x11;
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
      {
        NRC22_Flage = _Set_NRC22(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],2);
        if(NRC22_Flage == -1)
          _WriteEx_and_Report("","无NRC22条件");
        else if((NRC22_Flage &0x01) != 0)
        {
          if(i != 0 && Session != defsession)
            _SetSession(defsession);
          if(Serve_Data[Serve_Pos].Security_Access[i] == 1)
            _unlockECU();
          else
            _SetSession(exsession);
          {
            /*******车速>NRC22车速*******/
            _Set_CarSpd(NRC22_CarSpd + 1);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",NRC22);
            _Send_And_Check_NowSession(ID,exsession); 
            testWaitForTimeout(2000);
          }
          {
            /*******车速 = NRC22车速*******/
            _Set_CarSpd(NRC22_CarSpd);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",-1);
            testWaitForTimeout(2000);
            _Send_And_Check_NowSession(ID,defsession); 
          }
          _Set_CarSpd(0);
          if(Session != defsession && Serve_Data[Serve_Pos].Security_Access[i] == 1)
            _unlockECU();
          else if(Session != defsession && Serve_Data[Serve_Pos].Security_Access[i] == 0)
            _SetSession(exsession);
          _Set_CarSpd(NRC22_CarSpd + 1);
          {
            /*******车速信号丢失*******/
            _WriteEx_and_Report("","丢失车速节点");
            _TestDisableMsg(Struct_CarSpd.Sig_Id);
            testWaitForTimeout(Struct_CarSpd.Lost_Time*1.2);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",-1);
            testWaitForTimeout(2000);
            _Send_And_Check_NowSession(ID,defsession); 
          }
          _Set_CarSpd(0);
          _TestEnableMsg(Struct_CarSpd.Sig_Id);
          testWaitForTimeout(Struct_CarSpd.Lost_Time*1.2);
          if(Session != defsession && Serve_Data[Serve_Pos].Security_Access[i] == 1)
            _unlockECU();
          else if(Session != defsession && Serve_Data[Serve_Pos].Security_Access[i] == 0)
            _SetSession(exsession);
          {
            /*******车速无效*******/
            _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",-1);
            testWaitForTimeout(2000);
            _Send_And_Check_NowSession(ID,defsession); 
          }
          _Reset_CarSpd_Invalid();
          _Set_CarSpd(0);
        }
        else
          _WriteEx_and_Report("","无NRC22车速条件");
      }
      else
        _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[i]);
    }
  }
}

void _Serve11_06(dword ID,byte Session)   /*NRC22_档位*/
{
  int Serve_Pos,NRC22_Flage;
  int i,j;
  byte Send_Data[2],Send_Data_2[2];
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持11服务,跳过检测");
  else
  {
    Send_Data[0] = 0x11;
    Send_Data_2[0] = 0x27;
    Send_Data_2[1] = RequestSeed_27;
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
      {
        NRC22_Flage = _Set_NRC22(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],2);
        if(NRC22_Flage == -1)
          _WriteEx_and_Report("","无NRC22条件");
        else if((NRC22_Flage &0x08) != 0)
        {
          if(i != 0 && Session != defsession)
            _SetSession(defsession);
          if(Serve_Data[Serve_Pos].Security_Access[i] == 1)
            _unlockECU();
          else
            _SetSession(exsession);
          {
            for(j=NRC_22_Gears_Range[0];j<=NRC_22_Gears_Range[1];j++)
            {
              if(j==NRC_22_Gears_Normal)
                continue;
              _Set_Gears(j);
              testWaitForTimeout(200);
              _Send_Diag(2,ID,Send_Data);
              _TestResult(SendData,ID,"",NRC22);
              testWaitForTimeout(2000);
              _Send_Diag(2,ID,Send_Data_2);
              _TestResult(SendData,ID,"",-1);
              _Send_And_Check_NowSession(ID,exsession); 
            }
            {
              _TestDisableMsg(Gears_ID);
              testWaitForTimeout(1000);
              _Send_Diag(2,ID,Send_Data);
              _TestResult(SendData,ID,"",-1);
              testWaitForTimeout(2000);
              _Send_Diag(2,ID,Send_Data_2);
              _TestResult(SendData,ID,"",NRC7F);
              _Send_And_Check_NowSession(ID,defsession); 
            }
            _TestEnableMsg(Gears_ID);
            testWaitForTimeout(1000);
            if(Session != defsession && Serve_Data[Serve_Pos].Security_Access[i] == 1)
              _unlockECU();
            else if(Session != defsession && Serve_Data[Serve_Pos].Security_Access[i] == 0)
              _SetSession(exsession);
            testWaitForTimeout(1000);
            {
              _Set_Gears(NRC_22_Gears_Normal);
              testWaitForTimeout(200);
              _Send_Diag(2,ID,Send_Data);
              _TestResult(SendData,ID,"",-1);
              testWaitForTimeout(2000);
              _Send_Diag(2,ID,Send_Data_2);
              _TestResult(SendData,ID,"",NRC7F);
              _Send_And_Check_NowSession(ID,defsession); 
            }
          }
        }
        else
          _WriteEx_and_Report("","无NRC22档位条件");
      }
      else
        _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[i]);
    }
  }
}

void _Serve11_06_Ready(dword ID,byte Session)   /*NRC22_发动机*/
{
  int Serve_Pos,NRC22_Flage;
  int i,j;
  byte Send_Data[2],Send_Data_2[2];
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持11服务,跳过检测");
  else
  {
    Send_Data[0] = 0x11;
    Send_Data_2[0] = 0x27;
    Send_Data_2[1] = RequestSeed_27;
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
      {
        NRC22_Flage = _Set_NRC22(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],2);
        if(NRC22_Flage == -1)
          _WriteEx_and_Report("","无NRC22条件");
        else if((NRC22_Flage &0x20) != 0)
        {
          if(i != 0 && Session != defsession)
            _SetSession(defsession);
          if(Serve_Data[Serve_Pos].Security_Access[i] == 1)
            _unlockECU();
          else
            _SetSession(exsession);
          {
            
            _Set_Ready(Ready_NRC22);
            testWaitForTimeout(1000);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",NRC22);
            testWaitForTimeout(1000);
            _Send_And_Check_NowSession(ID,exsession); 
            _TestDisableMsg(Struct_Ready.Sig_Id);
            testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",-1);
            testWaitForTimeout(2000);
            _TestEnableMsg(Struct_Ready.Sig_Id);
            testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
            
            if(Session!=defsession)
              _SetSession(Session);
            if(Serve_Data[Serve_Pos].Security_Access[i] == 1)
              _unlockECU();
            _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
            testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",-1);
            testWaitForTimeout(2000);
            _Send_And_Check_NowSession(ID,defsession); 
            _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
            testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
            _Set_Ready(0);
            
          }
        }
        else
          _WriteEx_and_Report("","无NRC22发动机条件");
      }
      else
        _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[i]);
    }
  }
}
void _Serve11_06_Fac_Torque(dword ID,byte Session)   /*NRC22_工厂模式_力矩*/
{
  int Serve_Pos,NRC22_Flage;
  int i,j;
  byte Send_Data[2],Send_Key[2];
  char str[300];
  
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
    _WriteEx_and_Report("","当前项目不支持11服务,跳过检测");
  else
  {
    _WriteEx_and_Report("","测试工厂模式NRC22力矩条件");
    Send_Data[0] = 0x11;
    Send_Key[0] = 0x27;
    Send_Key[1] = RequestSeed_27;
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
      {
        NRC22_Flage = _Set_NRC22(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],2);
        if(NRC22_Flage == -1)
          _WriteEx_and_Report("","无NRC22条件");
        else if((NRC22_Flage &0x04) != 0)
        {
          if(NRC22_TasTorque_Fac_Flage == 1)
          {
            if(i==0)
              _Factory_Mode(0);
            for(j=0;j<2;j++)//左右
            {
              _SetSession(Session);
              snprintf(str,elCount(str),"%s","");
              if(i==0)
                snprintf(str,elCount(str),"控制力矩满足工厂模式NRC22条件,大于 %.2f Nm,并保持",NRC22_TasTorque_Fac+0.2);
              else
                snprintf(str,elCount(str),"控制力矩满足工厂模式NRC22条件,大于 %.2f Nm,并保持",(NRC22_TasTorque_Fac+0.2)*(-1));
              testWaitForTesterConfirmation(str,30000);
              _Send_Diag(2,ID,Send_Data);
              _TestResult(SendData,ID,"",NRC22);
              testWaitForTimeout(2000);
              if(Session== exsession && diagGetLastResponseCode(SendData)>0)
              {
                _Send_Diag(2,phyreq_ID,Send_Key);
                _TestResult(SendData,phyreq_ID,"",-1);
              }
              else
              {
                _Send_Diag(2,phyreq_ID,Send_Key);
                _TestResult(SendData,phyreq_ID,"",NRC7F);
              }
              _SetSession(Session);
              snprintf(str,elCount(str),"%s","");
              if(i==0)
                snprintf(str,elCount(str),"控制力矩不满足工厂模式NRC22条件,小于 %.2f Nm,并保持",NRC22_TasTorque_Fac-0.2);
              else
                snprintf(str,elCount(str),"控制力矩不满足工厂模式NRC22条件,小于 %.2f Nm,并保持",(NRC22_TasTorque_Fac-0.2)*(-1));
              testWaitForTesterConfirmation(str,30000);
              _Send_Diag(2,ID,Send_Data);
              _TestResult(SendData,ID,"",-1);
              testWaitForTimeout(2000);
              if(Session== exsession && diagGetLastResponseCode(SendData)>0)
              {
                _Send_Diag(2,phyreq_ID,Send_Key);
                _TestResult(SendData,phyreq_ID,"",-1);
              }
              else
              {
                _Send_Diag(2,phyreq_ID,Send_Key);
                _TestResult(SendData,phyreq_ID,"",NRC7F);
              }
              snprintf(str,elCount(str),"%s","");
              snprintf(str,elCount(str),"松开方向盘");
              testWaitForTesterConfirmation(str,30000);
              testWaitForTimeout(2000);
            }
            _Factory_Mode(1);
          }
          else
            _WriteEx_and_Report("","无工厂模式力矩条件");
        }
        else
          _WriteEx_and_Report("","无NRC22力矩条件");
      }
      else
        _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[i]);
    }
  }
}

