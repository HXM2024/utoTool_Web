_28_Serve_2(dword ID,byte Session)/*  禁收禁发 */
{
  byte Temp_1[3] = {0x28,0x03,0x01};
  byte Temp_2[3] = {0x28,0x00,0x01};
  int Flage_Temp,Support_Flage;
  int Pos_Serve,Pos_Fun,Loop_Para,Loop_Rsp;
  char str[200];
  int j;
  Pos_Serve = _Check_Serve(0x28,0,0);
  Pos_Fun = _Check_Serve(0x28,0x03,4);
  if(Pos_Fun == -1)
    _WriteEx_and_Report("","该项目不支持03子功能,跳过检测");
  else
  {
    _get_28_Case();
    _get_Arry("Read_SigValue");
    Loop_Para = 1;
    Loop_Para = Serve_Data[Pos_Serve].Serve_Para_Count[Pos_Fun];
    Loop_Rsp = 1;
    if(Serve_Data[Pos_Serve].RSP[Pos_Fun] == 1)
      Loop_Rsp = 2;
    for(j=0;j<Loop_Para;j++)
    {
      snprintf(str,elCount(str),"%s","");
      Temp_1[2] = Serve_Data[Pos_Serve].Serve_Para[Pos_Fun][j];
      Temp_2[2] = Serve_Data[Pos_Serve].Serve_Para[Pos_Fun][j];
      for(i=0;i<Loop_Rsp;i++)
      {
        if(i==1)
        {
          Temp_1[1]=0x83; Temp_2[1]=0x80;
        }
        else
        {
          Temp_1[1]=0x03; Temp_2[1]=0x00;
        }
        if(j==0 && i==0)
        {}
        else
          _SetSession(Session);
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_1);
        testWaitForTimeout(500);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        _Check_Return(1);
        _Check_EPS_TX(1,EPS_TxID_1);
        Flage_Temp = _Check_SendData_In_28H(Temp_1);
        _Send_Diag(3,ID,Temp_1);
        if(Flage_Temp>=0)
        {
          if(i==1)
            _TestResult(SendData,ID,"",0);
          else
            _TestResult(SendData,ID,"",-1);
          Support_Flage = 1;
        }
//        else if(Flage_Temp == -2)
//        {
//          Support_Flage = 0;
//          _TestResult(SendData,ID,"",NRC12);
//        }
//        else
//        {
//          Support_Flage = 0;
//          _TestResult(SendData,ID,"",NRC31);
//        }
        testWaitForTimeout(500);
        _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2);
        testWaitForTimeout(500);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        if(Support_Flage == 1)
        {
          _Check_Return(0);
          _Check_EPS_TX(0,EPS_TxID_1);
        }
//        else
//        {
//          _WriteEx_and_Report("","上一次指令未收到正响应");
//          _Check_Return(2);
//          _Check_EPS_TX(1,EPS_TxID_1);
//        }
        Flage_Temp = _Check_SendData_In_28H(Temp_2);
        testWaitForTimeout(500);
        _Send_Diag(3,ID,Temp_2);
        if(Flage_Temp>=0)
        {
          if(i==1)
            _TestResult(SendData,ID,"",0);
          else
            _TestResult(SendData,ID,"",-1);
          Support_Flage = 1;
        }
//        else if(Flage_Temp == -2)
//        {
//          Support_Flage = 0;
//          _TestResult(SendData,ID,"",NRC12);
//        }
//        else
//        {
//          Support_Flage = 0;
//          _TestResult(SendData,ID,"",NRC31);
//        }
        testWaitForTimeout(Wait_28H_Time);
        _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
        _Check_Return(2);
        _Check_EPS_TX(1,EPS_TxID_1);
        _Set_Sig(Sig_28_Set,0);
        _SetSession(defsession);
        snprintf(str,elCount(str),"%s  0x%02X  0x%02X","当前完成测试0x28",Temp_1[1],Temp_1[2]);
        _WriteEx_and_Report("",str);
      }
    }
  }
}
_28_Serve_3(dword ID,byte Session)/*  能收禁发 */
{
  byte Temp_1[3] = {0x28,0x01,0x01};
  byte Temp_2[3] = {0x28,0x00,0x01};
  int j;
  int Pos_Serve,Pos_Fun,Loop_Para,Loop_Rsp;
  char str[200];
  Pos_Serve = _Check_Serve(0x28,0,0);
  Pos_Fun = _Check_Serve(0x28,0x01,4);
  if(Pos_Fun == -1)
    _WriteEx_and_Report("","该项目不支持01子功能,跳过检测");
  else
  {  
    _get_28_Case();
    _get_Arry("Read_SigValue");
    Loop_Para = 1;
    Loop_Para = Serve_Data[Pos_Serve].Serve_Para_Count[Pos_Fun];
    Loop_Rsp = 1;
    if(Serve_Data[Pos_Serve].RSP[Pos_Fun] == 1)
      Loop_Rsp = 2;
    for(j=0;j<Loop_Para;j++)
    {
      snprintf(str,elCount(str),"%s","");
      Temp_1[2] = Serve_Data[Pos_Serve].Serve_Para[Pos_Fun][j];
      Temp_2[2] = Serve_Data[Pos_Serve].Serve_Para[Pos_Fun][j];
      {
        for(i=0;i<Loop_Rsp;i++)
        {
          if(i==1)
          {
            Temp_1[1]=Serve_Data[Pos_Serve].Serve_Fun[Pos_Fun]|0x80;
            Temp_2[1] = 0x80;
          }
          else if(i==0)
          {
            Temp_1[1]=Serve_Data[Pos_Serve].Serve_Fun[Pos_Fun] ;
            Temp_2[1] = 0x00;
          }
          
          if(j==0 && i==0)
          {}
          else
            _SetSession(Session);
          _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_1);
          testWaitForTimeout(500);
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          _Check_Return(1);
          _Check_EPS_TX(1,EPS_TxID_1);
          _Send_Diag(3,ID,Temp_1);
          if(i==1)
            _TestResult(SendData,ID,"",0);
          else
            _TestResult(SendData,ID,"",-1);
          _Set_Sig(Sig_28_Set,DID28_Case_CarSpd_2);
          testWaitForTimeout(500);
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          _Check_Return(2);
          _Check_EPS_TX(0,EPS_TxID_1);
          /*新增28服务恢复相关测试*/
          _Send_Diag(3,ID,Temp_2);
          if(i==1)
            _TestResult(SendData,ID,"",0);
          else
            _TestResult(SendData,ID,"",-1);
          testWaitForTimeout(Wait_28H_Time);
          _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
          _Check_Return(2);
          _Check_EPS_TX(1,EPS_TxID_1);
          
          _Set_Sig(Sig_28_Set,0);
          _SetSession(defsession);
          snprintf(str,elCount(str),"%s  0x%02X  0x%02X","当前完成测试0x28",Temp_1[1],Temp_1[2]);
          _WriteEx_and_Report("",str);
        }
      }
    }
  }
}
