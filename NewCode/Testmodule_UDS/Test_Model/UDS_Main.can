    _WriteEx_and_Report("","当前项目不支持10 02,跳过检测");
  else if(_Check_Fun_IDAndSess(0x10,0x02,ID,exsession) == 1)
  {
    NRC22_Flage = _Set_NRC22(0x10,0x02,2);
    if(NRC22_Flage == -1)
      _WriteEx_and_Report("","无NRC22条件");
    else if(NRC22_Flage &0x01 != 0)
    {
      _Other_1002();
      _WriteEx_and_Report("","设置车速 > NRC22车速");
      _Set_CarSpd(NRC22_CarSpd+1);
      _WriteEx_and_Report("步骤6","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",NRC22);
      _WriteEx_and_Report("步骤7","发送 04 14 FF FF FF 55 55 55");
      _Clear_DTC(phyreq_ID,-1,"");
      _Send_And_Check_NowSession(ID,exsession); 
      if(Serve_Data[Serve_Pos].RSP[Fun_Pos] == 1)
      {
        _WriteEx_and_Report("步骤8","发送 02 10 82 55 55 55 55 55");
        _Send_Diag(2,phyreq_ID,Temp_4);
        _TestResult(SendData,phyreq_ID,"",NRC22);
        _Send_And_Check_NowSession(ID,exsession); 
        _WriteEx_and_Report("步骤9","发送 04 14 FF FF FF 55 55 55");
        _Clear_DTC(phyreq_ID,-1,"");
      }
      else
        _WriteEx_and_Report("","10 02不支持肯定响应抑制位");
      
      _WriteEx_and_Report("步骤10","设置车速 = NRC22车速");
      _Set_CarSpd(NRC22_CarSpd);
      _WriteEx_and_Report("步骤11","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _WriteEx_and_Report("步骤12","发送 02 10 01 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_0);
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,defsession); 
      testWaitForTimeout(2000);
      _WriteEx_and_Report("步骤13","发送 02 10 03 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_3);
      _Check_10_01(6,Temp_3[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,exsession); 
      
      _Set_CarSpd(0);
      _Other_1002();
      _WriteEx_and_Report("步骤17","设置车速 > NRC22车速，再丢失车速");
      _Set_CarSpd(NRC22_CarSpd+1);
      _TestDisableMsg(Struct_CarSpd.Sig_Id);
      testWaitForTimeout(Struct_CarSpd.Lost_Time*1.1);
      _WriteEx_and_Report("步骤18","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _Check_10_01(6,Temp_1[1],P2can_server,P2_can_server);
       // _getnrc78(SendData,ID,"",-1);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
        _WriteEx_and_Report("步骤19","发送 02 10 01 55 55 55 55 55");
        _Send_Diag(2,ID,Temp_0);
        _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,defsession); 
      testWaitForTimeout(2000);
        _WriteEx_and_Report("步骤20","发送 02 10 03 55 55 55 55 55");
        _Send_Diag(2,ID,Temp_3);
        _Check_10_01(6,Temp_3[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,exsession); 
      _TestEnableMsg(Struct_CarSpd.Sig_Id);
      _Set_CarSpd(0);
      testWaitForTimeout(1000);
      _Other_1002();
      _WriteEx_and_Report("步骤24","设置车速 > NRC22车速，再无效车速");
      _Set_CarSpd(NRC22_CarSpd+1);
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
      _WriteEx_and_Report("步骤25","发送 02 10 02 55 55 55 55 55");
      _Send_Diag(2,ID,Temp_1);
      _Check_10_01(6,Temp_1[1],P2can_server,P2_can_server);
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
//        _getnrc78(SendData,ID,"",-1);
      _WriteEx_and_Report("步骤26","发送 02 10 01 55 55 55 55 55");
      testWaitForTimeout(500);
      _Send_Diag(2,ID,Temp_0);
      _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,defsession); 
      _Reset_CarSpd_Invalid();
      _Set_CarSpd(0);
      testWaitForTimeout(2000);
    }
    else
      _WriteEx_and_Report("","无NRC22车速条件");
  }
}

void _10_Phy_Ex_24(dword ID,byte Session)/*S3server*/
{
  byte Temp_0[2]={0x10,0x02};
  byte Temp_1[4]={0x14,0xff,0xff,0xff};
  int Start_time;/*设定起始的会话维持时间*/
  int Count_time=10;/*会话维持时间每次累计加10ms*/
  int SessRes;
  Start_time = 4900;
  if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
  {
    _Send_And_Check_NowSession(ID,Session);
    _Other_1002();
    _Send_Diag(2,ID,Temp_0);
    if(diagGetLastResponseCode(SendData)==-1)
    {
      testStepPass("步骤1","收到肯定响应");
      _WriteEx_and_Report("步骤2","测试10 02的会话维持时间");
      testWaitForTimeout(2000);
      _Send_And_Check_NowSession(ID,2); 
      _Send_Diag(4,phyreq_ID,Temp_1);/*加入一条诊断发送防止前面无读取当前会话导致等待时间超过5S*/
      if(Support_ReadSession == 1 && Read_Now_Session_BT == 1)
      {
        for(Start_time;Start_time<5200;Start_time+=Count_time)
        {
          testWaitForTimeout(Start_time);
          if(Start_time<=4990)
            SessRes = _Send_And_Check_NowSession(ID,2); 
          else
            SessRes = _Send_And_Check_NowSession(ID,0xFF); 
          if(SessRes != 2)
            break;
        }
      }
      else
      {
        for(Start_time;Start_time<5200;Start_time+=Count_time)
        {
          testWaitForTimeout(Start_time);
          _Send_Diag(4,phyreq_ID,Temp_1);
          if(diagGetLastResponseCode(SendData)== -1)
            break;
        }
      }
      _Send_And_Check_NowSession(ID,defsession); 
      _WriteEx_and_Report("","会话维持时间当前约为 %d ms",Start_time);
      if(4900<=Start_time && Start_time<=5100)
        testStepPass("","会话维持时间在5s ± 100ms内，当前约为%d ms",Start_time);
      else
        testStepFail("","会话维持时间不在5s ± 100ms内，当前约为%d ms",Start_time);
      _SetSession(defsession);
      testWaitForTimeout(2000);
    }
    else
      testStepFail("","10 02未收到响应或收到否定应答");
  }
  else
    _WriteEx_and_Report("","当前会话不支持10 02");
}
void _10_Fun_Ex_42(dword ID)
{
  byte Temp_0[2]={0x10,0x1};
  byte Temp_1[2]={0x10,0x2};
  byte Temp_2[2]={0x10,0x3}; 
  int Serve_Pos,Fun_Pos,NRC22_Flage;
  Serve_Pos = _Check_Serve(0x10,0x02,0);
  Fun_Pos = _Check_Serve(0x10,0x02,4);
  if(Fun_Pos != -1)
  {
    if(_Check_Fun_IDAndSess(0x10,0x02,ID,exsession) == 1)
    {
      _Send_Diag(2,ID,Temp_2);
      _Check_10_01(6,Temp_2[1],P2can_server,P2_can_server);
      _Send_Diag(2,ID,Temp_1);
      if(Serve_Data[Serve_Pos].Security_Access[Fun_Pos] == 1)
        _TestResult(SendData,ID,"",NRC33);
      else if(Other_1002 == 1)
        _TestResult(SendData,ID,"",NRC22);
      else
      {
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(2000);
        _SetSession(defsession);
        testWaitForTimeout(1000);
      }
      if(Unlock_1002 == 1)
      {
        _Send_Diag(2,ID,Temp_0);
        _Check_10_01(6,Temp_0[1],P2can_server,P2_can_server);
        _Send_Diag(2,ID,Temp_2);
        _Check_10_01(6,Temp_2[1],P2can_server,P2_can_server);
        if(Other_1002 == 1)
        {
          if(Pre_Programmed_UnlockECU == 1 && Pre_Programmed_1002)
          {
            _WriteEx_and_Report("","预编程需要安全访问,无法测试");
          }
          else
          {
            _Pre_Programmed();
            _Send_Diag(2,ID,Temp_1);
            _TestResult(SendData,ID,"",NRC33);
          }
        }
        else
        {
          _Send_Diag(2,ID,Temp_1);
          _TestResult(SendData,ID,"",-1);
        }
      }
    }
    else
      _WriteEx_and_Report("","当前寻址及会话下不支持该子功能");
  }
}
