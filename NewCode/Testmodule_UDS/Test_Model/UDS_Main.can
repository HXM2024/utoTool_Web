_27_Serve_06(dword ID,byte Session)   /*不正确的报文对错误计数影响测试*/
{
  byte Temp[2]={0x27,0x01};
  byte Temp_1[6]={0x27,0x01,0x11,0x11,0x11,0x11};
  byte i,seed;
  
  Temp[1] = RequestSeed_27+0x02;
  _Send_Diag(1,ID,Temp);
  _TestResult(SendData,ID,"",NRC13);
  Temp_1[1] = Temp[1] + 0x01;
  _Send_Diag(SendKey_Len+1,ID,Temp_1);
  _TestResult(SendData,ID,"",Response_Serve_NRC(0x27,6,0x12,0x13,0));
  
  Temp[1] = RequestSeed_27+0x02;
  if(RequestSeed_27==0x07)
    Temp[1] = 0x01;
  Temp_1[1] = Temp[1] + 0x01;
  _Send_Diag(2,ID,Temp);
  _TestResult(SendData,ID,"",NRC12);
  _Send_Diag(SendKey_Len,ID,Temp_1);
  _TestResult(SendData,ID,"",NRC12);
  
  _Check_Error_Count(ID,Error_Count-1);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  if(diagGetLastResponseCode(SendData)!=-1)
  {
    diagStartTesterPresent(Cdd_Name);
    testWaitForTimeout(Error_Count_Delay*1.1+1000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    if(diagGetLastResponseCode(SendData)==-1)
      testStepPass("","收到正响应");
    else
    {
      testStepFail("","未收到正响应");
      testWaitForTimeout(10000);
    }
  }
}

_27_Serve_07(dword ID,byte Session)  /*连续请求种子*/
{
  dword seed;
  int i;
  diagStartTesterPresent(Cdd_Name);
  if(Request_Error_Count==1)
  {
    for(i=1;i<Error_Count+2;i++)
    {
      _get_seed(ID);
      if(ReqSeed_Count == 1 && i == Error_Count+1)
        _TestResult(SendData,ID,"",NRC36);
      else
        _TestResult(SendData,ID,"",-1);
      Get_Seed_Flage = 1;
    }
    _Check_Repeat(Error_Count+1);
    _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    if(Error_Count_Change==1)
    {
      testWaitForTimeout(Error_Count_Delay+3000);
      for(i=0;i<2;i++)
      {
        _get_seed(ID);
        _TestResult(SendData,ID,"",-1);
      }
      _Check_Repeat(2);
      _get_seed(ID);
      _TestResult(SendData,ID,"",NRC37);
    }
    else if(Error_Count_Change==0)
    {
       for(i=1;i<Error_Count+2;i++)
        {
          _get_seed(ID);
          if(ReqSeed_Count == 1 && i == Error_Count+1)
            _TestResult(SendData,ID,"",NRC36);
          else
            _TestResult(SendData,ID,"",-1);
        }
        _Check_Repeat(Error_Count+1);
        _get_seed(ID);
        _TestResult(SendData,ID,"",NRC37);
    }
    if(strncmp(ECU_project,"Seres",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Seres"))
      testWaitForTimeout(101000);
    else
      testWaitForTimeout(Error_Count_Delay+3000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    if(Error_Count_Change == 1)
      _TestResult(SendData,ID,"",NRC37);
    else
      _TestResult(SendData,ID,"",NRC35);
    if(strncmp(ECU_project,"Seres",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Seres"))
      testWaitForTimeout(1001000);
    else
      testWaitForTimeout(Error_Count_Delay+3000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
  }
  else if(Request_Error_Count==0)
  {
    for(i=0;i<=Error_Count+3;i++)
    {
      _get_seed(ID);
      _TestResult(SendData,ID,"",-1);
      Get_Seed_Flage = 1;
    }
    _Check_Repeat(Error_Count+4);
    _Check_Error_Count(ID,Error_Count);
    testWaitForTimeout(Error_Count_Delay+3000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
  }
}
_27_Serve_07_(dword ID,byte Session)  /*连续请求种子*/
{
  dword seed;
  int i;
  diagStartTesterPresent(Cdd_Name);
  if(Request_Error_Count==1)
  {
    /*连续请求*/
    {
      for(i=0;i<Error_Count;i++)
      {
        seed = _get_seed(ID);
        _TestResult(SendData,ID,"",-1);
        Get_Seed_Flage = 1;
      }
      _Check_Repeat(Error_Count);
      _Send_Key(SendKey_Len,ID,seed,1);
      _TestResult(SendData,ID,"",NRC36);
      _get_seed(ID);
      _TestResult(SendData,ID,"",NRC37);
      testWaitForTimeout(Error_Count_Delay+3000);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
    }
    _SetSession(defsession);
    testWaitForTimeout(100);
    _SetSession(exsession);
    /*不连续请求*/
    {
      for(i=0;i<Error_Count-1;i++)
      {
        seed = _get_seed(ID);
        _TestResult(SendData,ID,"",-1);
        Get_Seed_Flage = 1;
      }
      _Check_Repeat(Error_Count-1);
      _Send_Key(SendKey_Len,ID,seed,1);
      _TestResult(SendData,ID,"",NRC35);
      _get_seed(ID);
      _TestResult(SendData,ID,"",-1);
      _get_seed(ID);
      _TestResult(SendData,ID,"",-1);
      _get_seed(ID);
      _TestResult(SendData,ID,"",NRC37);
      testWaitForTimeout(Error_Count_Delay+3000);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
    }
  }
  else
    _WriteEx_and_Report("","连续请求种子错误计数器不累加，跳过测试");
}
_27_Serve_08(dword ID,byte Session)  /*延时时间*/
{
  double starttime;
  double endtime;
  double Change_Time;
  double CountTime;
  byte Temp[2] = {0x27,0x01};
  message * MSG;
  int i,re;
  i=0;
  Temp[1] = RequestSeed_27;
  do{
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    i++;
  }while((diagGetLastResponseCode(SendData)!=NRC36) && i<=Error_Count+10);
  Get_Seed_Flage = 1;
  starttime=(double)timeNow()/100;
  do
  {
    _get_seed_Send(ID);  /*用于屏蔽NRC78导致的时间错误*/
    re = testWaitForMessage(Response_ID,p2cmax);
    if(re>0)
      testGetWaitEventMsgData(MSG);
    CountTime = (double)timeNow()/100;
  }while(re>0 && MSG.byte(3)!=0x78 && MSG.byte(1)!=0x67 && MSG.byte(2)!=0x67 && (CountTime-starttime)<=Error_Count_Delay*1.5);
  endtime=(double)timeNow()/100;
  Change_Time = endtime-starttime;
  if((CountTime-starttime)>=Error_Count_Delay*1.5)
    _WriteEx_and_Report("","长时间未收到正响应,提前终止防止卡死");
  writeEx(-3,0," 当前从NRC36到正常响应种子时间为 %.2f ms ",Change_Time);
  if(Error_Count_Delay - Error_Count_Delay_Tolerance<=Change_Time && Change_Time<=Error_Count_Delay + Error_Count_Delay_Tolerance)
    testStepPass("","当前从NRC36到正常响应种子时间为 %.2f ms",Change_Time);
  else
    testStepFail("","当前从NRC36到正常响应种子时间为 %.2f ms",Change_Time);
  testWaitForTimeout(Error_Count_Delay+3000);
  _SetSession(exsession);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
}
_27_Serve_09(dword ID,byte Session)   /*延时时间执行规则*/
{
  int i;
  dword seed;
  if(strncmp(ECU_project,"Seres",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Seres"))
  {
    diagStartTesterPresent(Cdd_Name);
    for(i=1;i<=Error_Count;i++)
    {
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    }
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
    testWaitForTimeout(10000*1.1);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",-1);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC36);
    testWaitForTimeout(85000);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
    testWaitForTimeout(20000);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",-1);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC36);
    testWaitForTimeout(850000);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
    testWaitForTimeout(160000);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",-1);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC36);
    testWaitForTimeout(850000);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
    testWaitForTimeout(160000);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",-1);
    _Send_Key(SendKey_Len,ID,seed,0);
    _TestResult(SendData,ID,"",-1);
    _SetSession(exsession);
    for(i=1;i<Error_Count;i++)
    {
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
      _TestResult(SendData,ID,"",NRC35);
    }
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC36);
    testWaitForTimeout(10000*1.1);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
  }
  else
  {
    _WriteEx_and_Report(ECU_project,"当前项目非赛力斯,跳过该条测试");
    testStepPass("","");
  }
}
