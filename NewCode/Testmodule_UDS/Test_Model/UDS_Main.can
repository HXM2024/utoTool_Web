_19_Serve_01(dword ID,byte Session)  /*19 01*/
{
  byte Data_1[3]={0x19,0x01,0x01};
  byte Data_2[3]={0x19,0x01,0x09};
  byte Data_3[3]={0x19,0x02,0x01};
  byte Data_4[3]={0x19,0x02,0x09};
  byte Data_5[3]={0x19,0x01,0x02};
  byte Data_6[3]={0x19,0x02,0x02};
  int i,count;
  count = 0;
  if(ID==funreq_ID && Fun_19==0)
  {
    _WriteEx_and_Report("","19服务不支持功能寻址");
    _Send_Diag(3,ID,Data_3);
    _TestResult(SendData,ID,"",NRC7F);
  }
  else
  {
    int Count_0101;
    diagStartTesterPresent(Cdd_Name);
    StepByGeely3_0(0x19,1);
    _Close_All();
    testWaitForTimeout(5000);
    _Open_All();
    testWaitForTimeout(5000);
    _Close_One_Node(DTC_19[0]);
    _Send_Diag(3,ID,Data_1);
    Count_0101 =_Check_1901(SendData);
    _Send_Diag(3,ID,Data_3);
    _Check_190201(SendData,DTC_19[0][1],DTC_19[0][2],Count_0101);
    
    _Send_Diag(3,ID,Data_2);
    Count_0101 = _Check_1901(SendData);
    _Send_Diag(3,ID,Data_4);
    _Check_1902(SendData,Count_0101);
    
    _Send_Diag(3,ID,Data_5);
    Count_0101 =_Check_1901(SendData);
    _Send_Diag(3,ID,Data_6);
    if(diagGetLastResponseCode(SendData)>0)
      _TestResult(SendData,ID,"",NRC12);
    else
      _Check_1902(SendData,Count_0101);
    _Open_One_Node(DTC_19[0]);
  }
}

_19_Serve_02(dword ID,byte Session)  /*19 02*/
{
  byte Data_1[3]={0x19,0x02,0x01};
  byte Data_2[3]={0x19,0x02,0x08};
  byte Data_3[3]={0x19,0x02,0x09};
  byte Data_4[3]={0x19,0x02,0x02};
  if(ID==funreq_ID && Fun_19==0)
    _WriteEx_and_Report("","19服务不支持功能寻址");
  else
  {
    diagStartTesterPresent(Cdd_Name);
    StepByGeely3_0(0x19,1);
    _Close_All();
    testWaitForTimeout(5000);
    _Open_All();
    testWaitForTimeout(5000);
    _Close_One_Node(DTC_19[1]);
    _Send_Diag(3,ID,Data_1);
    _Check_190201(SendData,DTC_19[1][1],DTC_19[1][2]);
    
    _Send_Diag(3,ID,Data_2);
    _Check_1902(SendData);
    _Send_Diag(3,ID,Data_3);
    _Check_1902(SendData);
    
    _Send_Diag(3,ID,Data_4);
    if(diagGetLastResponseCode(SendData)>0)
      _TestResult(SendData,ID,"",NRC12);
    else
      _Check_1902(SendData);
    _Open_One_Node(DTC_19[1]);
  }
}

