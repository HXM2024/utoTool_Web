  diagStartTesterPresent(Cdd_Name);
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"断开传感器角度信号");
  testWaitForTesterConfirmation(str,30000);
  _get_Arry("Check_Calibration");
  Temp[0] = Arry_Data[0]^0x40;
  for(i=1;i<Arry_Len;i++)
  {
    Temp[i]= Arry_Data[i];
  }
  Temp[Arry_Len] = 0x05;
  _Send_Diag(Arry_Len,ID,Arry_Data);
  _Check_Response(SendData,5,Temp);
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"恢复传感器角度信号");
  _Power_Down();
  testWaitForTimeout(1000);
  _Power_Up();
  testWaitForTesterConfirmation(str,30000);
}
