_31_Serve_22_Chery(dword ID,byte Session) /*角度对中*/
{
  byte Temp[5];
  byte Temp1[3]={0x22,0x32,0x08};
  byte Temp2[5]={0x62,0x32,0x08,0x00,0x00};
  byte Temp3[4]={0x31,0x03,0x33,0x00};
  byte Temp4[5]={0x71,0x03,0x33,0x00,0x01};
  _get_Ang_Chery(ID);
  Temp[0]=Arry_Data[0]^0x40;
  for(i=1;i<Arry_Len;i++)
    Temp[i]= Arry_Data[i];
  Temp[Arry_Len] = 0x01;
  _unlockECU();
  _Send_Diag(7,ID,Arry_Data);
  _Check_Response(SendData,5,Temp);
  testWaitForTimeout(100);
  _Send_Diag(3,ID,Temp1);
  _Check_Response(SendData,5,Temp2);
  testWaitForTimeout(100);
  _Send_Diag(4,ID,Temp3);
  _Check_Response(SendData,5,Temp4);
}
