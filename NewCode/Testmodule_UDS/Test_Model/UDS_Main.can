_27_Serve_16(dword ID,byte Session)   /*重启对错误计数影响测试_安全计数器满*/
{
  dword seed;
  byte Temp[2] ={0x11,0x01};
  int Serve_Pos;
  diagStartTesterPresent(Cdd_Name);
  Serve_Pos = _Check_Serve(0x11,0,0);
  Temp[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  if( Serve_Data[Serve_Pos].Security_Access[0]==1)
    _WriteEx_and_Report("","11复位需要安全访问条件，此条用例不适用");
  else
  {
    _Check_Error_Count(ID,Error_Count);
    testWaitForTimeout(Error_Count_Delay*0.4);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    testWaitForTimeout(100);
    _Send_Diag(2,phyreq_ID,Temp);
    _TestResult(SendData,ID,"",-1);
    testWaitForTimeout(2000);
    _SetSession(exsession);
    testWaitForTimeout(Error_Count_Delay*0.6);
    if(Error_Count_Delay_Reset == 1)
    {
      seed = _get_seed(ID);
      _TestResult(SendData,ID,"",NRC37);
      testWaitForTimeout(Error_Count_Delay*0.3+1000);
    }
    else
    {
      if(Restoration_Error_Count == 1)
      {
        _Check_Error_Count(ID,Error_Count);
        seed = _get_seed(ID);
        _TestResult(SendData,ID,"",NRC37);
      }
      else
      {
        if(Error_Count_Change == 1)
        {
          seed = _get_seed(ID);
          _TestResult(SendData,ID,"",NRC36);
        }
        else
        {
          _Check_Error_Count(ID,Error_Count);
          seed = _get_seed(ID);
          _TestResult(SendData,ID,"",NRC37);
        }
      }
    }
    testWaitForTimeout(Error_Count_Delay+3000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
  }
}
