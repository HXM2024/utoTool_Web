      _WriteEx_and_Report(ECU_project,"序列号错误导致计算的秘钥不可信");
      return -1;
    }
    else
    {
      _WriteEx_and_Report(ECU_project,"安全访问算法选择异常");
      return -1;
    }
  }
  else
  {
    testStep("","获取种子失败");
    return -1;
  }
}

/// <Security Access>
/*
  通过种子计算出密钥并发送
  len 发送长度
  ID 发送ID
  Temp_seed 种子
  type = 0：正确密钥
  type = 1：错误密钥
*/
_Send_Key(byte len, dword ID,qword Temp_seed,dword type)   
{
  byte Key_Data[18];
  dword m=0;
  dword Skey;
  word key_i;
  Key_Data[0] = 0x27;
  Key_Data[1] = SendKey_27;
  if(AES_128 == 0)
  {
    _SecurityAccess(Temp_seed,Skey);
    testStep("密钥","计算出密钥为0x%2X",Skey);
    if(type == 1)
    {
      for(m=2;m<len;m++)
        Key_Data[m] = 0x00;
    }
    else
    {
      for(m=2;m<len;m++)
        Key_Data[m] = (Skey>>(abs(m+1-len)*8))&0xFF;
    }
    _Send_Diag(len,ID,Key_Data);   
  }
  else if(AES_128 == 1)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CMAC算法");
    if(type == 0)
    {
      _Key_Count();
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = corresKey[key_i];
    }
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = 0x00;
    }
    _Send_Diag(len,ID,Key_Data);
  }
  else if(AES_128 == 2)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    if(type == 0)
    {
      for(m=0;m<16;m++)
        RA[m]=Seed_CBC[m];
      /*用密钥KEY解密RA 得到ra`*/
      AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,Iv);
      /*ra`逆向*/
      reverseNum(ra,16);
      testWaitForTimeout(50);
      /*用密钥KEY加密r得到R*/
      AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,Iv);
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = R[key_i];
    }
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = 0x00;
    }
    _Send_Diag(len,ID,Key_Data);
  }
  else
    _WriteEx_and_Report(ECU_project,"安全访问算法选择异常");
}

