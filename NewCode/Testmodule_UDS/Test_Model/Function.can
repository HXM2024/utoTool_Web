      _TestWaitForTesterConfirmation("松开方向盘");
      _Temp_For_1904_Clear(Pos_1904);
      snprintf(comment,elCount(comment),"%s","");
      snprintf(comment,elCount(comment),"向左控制手力矩为 - %.1fNm并保持,直到提示松开方向",mixArray[Possion].Vaule_Set[0]);
      _TestWaitForTesterConfirmation(comment);
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,_Get_Signal(mixArray[Possion].Sig_Name[0]),0);
      _TestWaitForTesterConfirmation("松开方向盘");
      _Temp_For_1904_Clear(Pos_1904);
      _TestWaitForTesterConfirmation("向左控制手力矩为 %.1f",mixArray[Possion].DID_Value_max);
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,_Get_Signal(mixArray[Possion].Sig_Name[0]),0);
      _TestWaitForTesterConfirmation("松开方向盘");
      _Temp_For_1904_Clear(Pos_1904);
      _TestWaitForTesterConfirmation("向右控制手力矩为%.1f",mixArray[Possion].DID_Value_min);
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,_Get_Signal(mixArray[Possion].Sig_Name[0]),0);
      _TestWaitForTesterConfirmation("松开方向盘");
      _Temp_For_1904_Clear(Pos_1904);
      _TestWaitForTesterConfirmation("向左控制手力矩为 %.1f",mixArray[Possion].DID_Value_max+1);
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,_Get_Signal(mixArray[Possion].Sig_Name[0]),0);
      _TestWaitForTesterConfirmation("松开方向盘");
      _Temp_For_1904_Clear(Pos_1904);
      _TestWaitForTesterConfirmation("向右控制手力矩为 %.1f",mixArray[Possion].DID_Value_min-1);
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,_Get_Signal(mixArray[Possion].Sig_Name[0]),0);
      _TestWaitForTesterConfirmation("松开方向盘");
      _Temp_For_1904_Clear(Pos_1904);
      _TestWaitForTesterConfirmation("向右控制手力矩为 -2Nm,并断开传感器");
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,_Get_Signal(mixArray[Possion].Sig_Name[0]),1);
      _TestWaitForTesterConfirmation("松开方向盘,并恢复传感器");
      _Temp_For_1904_Clear(Pos_1904);
      _Power_Down();
      testWaitForTimeout(1000);
      _Power_Up();
      if(Session != defsession)
        _SetSession(Session);
      testWaitForTimeout(CAN_Init_Time);
    }
    }
    else
      _WriteEx_and_Report("","输入值为全0情况下跳过测试");
  }
  else if((strncmp(Check_Str_,"CARSPD",strlen(Check_Str_)) == 0) || (strncmp(Check_Str_,"VEHICLESPEED",strlen(Check_Str_)) == 0))
  {
    if(_Check_mixArray_SetValue(Check_Str,Possion)==1)
    {
    _Set_CarSpd(100);
    _WriteEx_and_Report("","制造故障");
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
    mask = DTC_19[Pos_1904][2];
    _Check_1904(SendData,mask,Check_Str,100,0);
    _WriteEx_and_Report("","故障恢复并清除");
    _Temp_For_1904_Clear(Pos_1904);
    _WriteEx_and_Report("","设置车速为理论最大值");
    _Set_CarSpd(mixArray[Possion].DID_Value_max);
    testWaitForTimeout(3000);
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
    _Check_1904(SendData,mask,Check_Str,mixArray[Possion].DID_Value_max,0);
    _Temp_For_1904_Clear(Pos_1904);
    _WriteEx_and_Report("","设置车速大于理论最大值");
    _Set_CarSpd(mixArray[Possion].DID_Value_max+2);
    testWaitForTimeout(3000);
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
    _Check_1904(SendData,mask,Check_Str,mixArray[Possion].DID_Value_max,0);
    _Temp_For_1904_Clear(Pos_1904);
    _WriteEx_and_Report("","设置车速恢复正常范围");
    _Set_CarSpd(60);
    testWaitForTimeout(3000);
    _TestDisableMsg(mixArray[Possion].Sig_Name_Node);
    testWaitForTimeout(3000);
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
    if(mixArray[Possion].Invalid == -1)
      _Check_1904(SendData,mask,Check_Str,60,0);
    else
      _Check_1904(SendData,mask,Check_Str,60,1);
    _TestEnableMsg(mixArray[Possion].Sig_Name_Node);
    testWaitForTimeout(3000);
    _Temp_For_1904_Clear(Pos_1904);
    _Set_CarSpd(80);
    testWaitForTimeout(2000);
    _K15_OFF();
    _Close_One_Node(DTC_19[Pos_1904]);
    testWaitForTimeout(1000);
    _Open_One_Node(DTC_19[Pos_1904]);
    testWaitForTimeout(1000);
    _K15_ON();
    testWaitForTimeout(CAN_Init_Time);
    _Send_Diag(6,ID,Data_Send);
    _Check_19_NoFreeze(SendData,Check_Str);
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
    _Check_1904(SendData,mask,Check_Str,80,0);
    _Temp_For_1904_Clear(Pos_1904);
    _Set_CarSpd(120);
    testWaitForTimeout(1000);
    _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
    if(mixArray[Possion].Invalid == -1)
      _Check_1904(SendData,mask,Check_Str,120,0);
    else
      _Check_1904(SendData,mask,Check_Str,120,1);
    _Reset_CarSpd_Invalid();
    _Set_CarSpd(0);
    _Temp_For_1904_Clear(Pos_1904);
    }
    else
      _WriteEx_and_Report("","输入值为全0情况下跳过测试");
  }
  else
    _WriteEx_and_Report(Check_Str,"未查询到对应的操作流程,待后续完善");
}
/*
  设置1904步骤中数据操作
    Type < 0x10:取第0-3组数据,用于1904操作,设置对应组数据
    Type = oxFF:使用无效值
    暂不使用 - Type ≥ 0x10:取 Type-0x10组数据,用于功能22DID操作,设置对应组数据
*/
 int _Step_1904(char str[],dword Type) //取第0-3组数据
{
  int n;
  int Sw_temp,Step_Flage;
  int Step_Flage_From;
  char str_T[500];
  char Te[500];
  snprintf(str_T,elCount(str_T),"%s","");
  snprintf(str_T,elCount(str_T),"%s",str);
  snprintf(Te,elCount(Te),"%s","");
  Step_Flage_From = 0;
  if(Type<0x10 || Type == 0xFF)
  {
    Sw_temp = _Check_StrPossion_Res(str,1); //检测字符串是否在预期输入中
    Step_Flage = -1;
    if(Sw_temp!= -1) 
      Step_Flage = _Check_mixArray_SetValue(str,Sw_temp); //判断是否跳过测试
  }
  _Str_Upper(str_T);
  snprintf(Te,elCount(Te),"%s","");
  if(Type == 0xFF)
    Step_Flage = 1;
  if(Sw_temp!= -1 && Step_Flage == 1)
  {
    if(((strncmp(str_T,"BATTERY",strlen(str_T)) == 0) || (strncmp(str_T,"VOLTAGE",strlen(str_T)) == 0)) )
    {
      _Set_Battery(mixArray[Sw_temp].Vaule_Set[Type]);
      mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
      mixArray[Sw_temp].Step_Flage = 1;
      mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
      return 0;
    }
    else if(((strncmp(str_T,"CARSPD",strlen(str_T)) == 0) || (strncmp(str_T,"VEHICLESPEED",strlen(str_T)) == 0)))
    {
      if(Type == 0xFF && Flage_SaveData_Geely == 1)
        _Set_Sig(mixArray[Sw_temp].Sig_Name[0],453.6);
      else
      {
        _Set_Sig(mixArray[Sw_temp].Sig_Name[0],mixArray[Sw_temp].Vaule_Set[Type]);
        mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
        mixArray[Sw_temp].Step_Flage = 1;
        mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
      }
      return 0;
    }
    else if((strncmp(str_T,"READY_STATE",strlen(str_T)) == 0 ) || (strncmp(str_T,"USGMODE",strlen(str_T)) == 0 ))
    {
      if(Type == 0xFF && Flage_SaveData_Geely == 1)
        _Set_Sig(mixArray[Sw_temp].Sig_Name[0],0x0F);
      else
      {
        _Set_Sig(mixArray[Sw_temp].Sig_Name[0],mixArray[Sw_temp].Vaule_Set[Type]);
        mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
        mixArray[Sw_temp].Step_Flage = 1;
        mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
      }
      return 0;
    }
    else if(strncmp(str_T,"ANGLE",strlen(str_T)) == 0 )
    {
      _Get_Ready();
      if(Engine_State == 0)
        _Set_Ready(Struct_Ready.Ready_Active);
      {
        snprintf(Te,elCount(Te),"转动方向盘到 %.1f°",mixArray[Sw_temp].Vaule_Set[Type]);
        _TestWaitForTesterConfirmation(Te);
        mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
        mixArray[Sw_temp].Step_Flage = 1;
        mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
      }
      if(Engine_State == 0)
        _Set_Ready(Engine_State);
      return 0;
    }
    else if(strncmp(str_T,"LOCALTIME",strlen(str_T)) == 0)
    {
      if(Type == 0xFF)
        snprintf(Te,elCount(Te),"100/0/0_24:60:60");
      else
        snprintf(Te,elCount(Te),"%s",mixArray[Sw_temp].LocalTime_Set[Type]);
      _WriteEx_and_Report("   设置LocalTime",Te);
      mixArray[Sw_temp].Step_Flage = 1;
      _Set_Time(Te,1);
      testWaitForTimeout(1000);
      if( Type!= 0xFF) 
        snprintf(mixArray[Sw_temp].LocalTime_Value_2[Type],elCount(mixArray[Sw_temp].LocalTime_Value_2[Type]),"%s",mixArray[Sw_temp].LocalTime_Value);
      return 0;
    }
    if(Step_Flage_From == 0)
    {
      for(n=0;n<mixArray_Len;n++)
      {
        if(strncmp(str,mixArray[n].Str_DID_1904,strlen(str)) == 0 )
        {
          _Check_ID_(mixArray[n].Sig_Name_Node);
          if(Canoe_Node_Flage == 1)
          {
            if(Type == 0xFF && Flage_SaveData_Geely == 1)
            {
              if((strncmp(str_T,"ECU_VOLTAGE",strlen(str_T))==0) || (strncmp(str_T,"MAIN_ECU_VOLTAGE_SUPPLY",strlen(str_T))==0))
                _Set_Sig(mixArray[n].Sig_Name[0],25.5);
              else if((strncmp(str_T,"MILEAGE",strlen(str_T))==0) || (strncmp(str_T,"TOTALDISTANCE",strlen(str_T))==0))
                _Set_Sig(mixArray[n].Sig_Name[0],2000016);
              else if(strncmp(str_T,"GLOBAL_REAL_TIME",strlen(str_T))==0)
                _Set_Sig(mixArray[n].Sig_Name[0],429496729.5);
              else if(strncmp(str_T,"POWER_LEV",strlen(str_T))==0)
              {
                _Set_Sig(PwrLvlElecMai_Sig,0x06);
                _Set_Sig(PwrLvlElecSubtyp_Sig,0x06);
              }
            }
            else
            {
              if(strncmp(str_T,"POWER_LEV",strlen(str_T))==0 && Flage_SaveData_Geely == 1)
              {
                _Set_Sig(PwrLvlElecMai_Sig,((int)mixArray[Sw_temp].Vaule_Set[Type])>>4);
                _Set_Sig(PwrLvlElecSubtyp_Sig,((int)mixArray[Sw_temp].Vaule_Set[Type])&0x0F);
              }
              else
                _Set_Sig(mixArray[n].Sig_Name[0],mixArray[Sw_temp].Vaule_Set[Type]);
              mixArray[Sw_temp].Vaule_Ex = mixArray[Sw_temp].Vaule_Set[Type];
            }
            mixArray[Sw_temp].Step_Flage = 1;
            testWaitForTimeout(100);
            if( Type!= 0xFF) //Group_Count>1 &&
              mixArray[Sw_temp].Vaule_Ex_2[Type] = mixArray[Sw_temp].Vaule_Set[Type];
            return 0;
          }
        }
      }
    }
  }
  else if(Step_Flage == 0)
  {
    mixArray[Sw_temp].Step_Flage = -1;
    _WriteEx_and_Report(str,"输入值为全0,跳过测试");
    return -1;
  }
  {
    mixArray[Sw_temp].Step_Flage = -1;
    _WriteEx_and_Report(str,"未查询到对应的操作流程,待后续完善");
    return -1;
  }
}

int _Step_1904_(char str[],dword Type,dword Tar) //取第0-3组数据(用于多组快照,把指定组数据赋给指定的其他组)
{
  int n;
  int Sw_temp;
  char Te[500];
  char Tem_St[500];
  Sw_temp = _Check_StrPossion_Res(str,1);
  snprintf(Te,elCount(Te),"%s","");
  snprintf(Tem_St,elCount(Tem_St),"%s","");
  snprintf(Tem_St,elCount(Tem_St),"%s",str);
  _Str_Upper(Tem_St);
  if(strncmp(Tem_St,"LOCALTIME",strlen(Tem_St)) == 0 && Sw_temp!= -1)
  {
    // if(Group_Count>1)
    // {
      _Set_Time(mixArray[Sw_temp].LocalTime_Value_Set[Type],0);
      snprintf(mixArray[Sw_temp].LocalTime_Value_2[Tar],elCount(mixArray[Sw_temp].LocalTime_Value_2[Tar]),"%s",mixArray[Sw_temp].LocalTime_Value);
    // }
    return 0;
  }
  else if(Sw_temp!= -1)
  {
    // if(Group_Count>1)
      mixArray[Sw_temp].Vaule_Ex_2[Tar] = mixArray[Sw_temp].Vaule_Set[Type];
    return 0;
  }
  for(n=0;n<mixArray_Len;n++)
  {
    if(strncmp(Tem_St,mixArray[n].Str_DID_1904,strlen(Tem_St)) == 0 && Sw_temp!= -1)
    {
      _Check_ID_(mixArray[n].Sig_Name_Node);
      if(Canoe_Node_Flage == 1)
      {
        // if(Group_Count>1)
          mixArray[Sw_temp].Vaule_Ex_2[Tar] = mixArray[Sw_temp].Vaule_Set[Type];
        return 0;
      }
    }
  }
  return -1;
}
/// <Node>
/*
  Type = 1:设置时间参数
  Type = 0：仅获取转换后的时间值
*/
 _Set_Time(char Str[],byte Type)
{
  char Temp_Str[100];
  char Temp_Str_[100];
  dword Value_Time[6];   //    Year/Month/Day_Hour:Minutes:Second
  int Swhere_0;
  int Cou;
  int i,j;
  int  Possion_Temp;
  int  Possion_Temp_1;
  Swhere_0 = 0; Cou = 0;
  snprintf(Temp_Str,elCount(Temp_Str),"%s","");
  snprintf(Temp_Str_,elCount(Temp_Str_),"%s","");
  snprintf(Time_TempForSave,elCount(Time_TempForSave),"%s","");
  Possion_Temp = _Check_StrPossion_Res("LocalTime",1);
  if(Possion_Temp!= -1)
    snprintf(mixArray[Possion_Temp].LocalTime_Value,elCount(mixArray[Possion_Temp].LocalTime_Value),"%s","");
  for(i=0;i<strlen(Str);i++)
  {
    if(Str[i]==47)//   '/'
    {
      if(Cou==0)
        Value_Time[0] = atol(Temp_Str);
      else 
        Value_Time[1] = atol(Temp_Str);
      Cou++;
      snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    }
    else if(Str[i]==95)//   '_'
    {
      Value_Time[2] = atol(Temp_Str);
      Cou = 0;
      snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    }
    else if(Str[i]==58) //   ':'
    {
      if(Cou==0)
        Value_Time[3] = atol(Temp_Str);
      else 
      {
        Value_Time[4] = atol(Temp_Str);
        for(j=i+1;j<strlen(Str);j++)
          snprintf(Temp_Str_,elCount(Temp_Str_),"%s%c",Temp_Str_,Str[j]);
        Value_Time[5] = atol(Temp_Str_);
        snprintf(Temp_Str_,elCount(Temp_Str_),"%s","");
      }
      Cou++;
      snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    }
    else
      snprintf(Temp_Str,elCount(Temp_Str),"%s%c",Temp_Str,Str[i]);
  }
  for(i=0;i<6;i++)
  {
    snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    if(i==0)
      snprintf(Temp_Str,elCount(Temp_Str),"%s","year");
    else if(i==1)
      snprintf(Temp_Str,elCount(Temp_Str),"%s","month");
    else if(i==2)
      snprintf(Temp_Str,elCount(Temp_Str),"%s","day");
    else if(i==3)
      snprintf(Temp_Str,elCount(Temp_Str),"%s","hour");
    else if(i==4)
      snprintf(Temp_Str,elCount(Temp_Str),"%s","minute");
    else if(i==5)
      snprintf(Temp_Str,elCount(Temp_Str),"%s","second");
    Swhere_0 = _Check_StrPossion(Temp_Str,Possion_Temp,0);
    if(Swhere_0 == -1)
    {
//      _WriteEx_and_Report(Temp_Str,"未查询到该信号");
    }
    else
    {
      if(Type == 1)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"%s","");
        snprintf(Temp_Str,elCount(Temp_Str),"EV_%s",mixArray[Possion_Temp].Sig_Name[Swhere_0]);
        setSignal(mixArray[Possion_Temp].Sig_Name[Swhere_0],Value_Time[i]);
        putValue(Temp_Str,Value_Time[i]);
      }
      snprintf(Temp_Str,elCount(Temp_Str),"%s","");
      snprintf(Temp_Str,elCount(Temp_Str),"%d",Value_Time[i]);
      if(strlen(Temp_Str)<2)
        snprintf(Temp_Str,elCount(Temp_Str),"%c%s",'0',Temp_Str);
      snprintf(mixArray[Possion_Temp].LocalTime_Value,elCount(mixArray[Possion_Temp].LocalTime_Value),"%s%s",mixArray[Possion_Temp].LocalTime_Value,Temp_Str);
      snprintf(Time_TempForSave,elCount(Time_TempForSave),"%s%s",Time_TempForSave,Temp_Str);
    }
  }
}
_ALL_DTC_Add(dword Da)
{
  int n;
  if(Da == 0)
    return;
  for(n=0;n<ALL_DTC_Num;n++)
  {
    if(ALL_DTC[n] == Da)
      break;
  }
  if(n==ALL_DTC_Num)
  {
    ALL_DTC[n] = Da;
    ALL_DTC_Num = ALL_DTC_Num+1;
  }
}

int _Check_Dword_in_Num(qword Da,qword Data[],int Len)//检测数据是否在整形数组中
{
  int flage,n;
  flage = -1;
  for(n=0;n<Len;n++)
  {
    if(Da==Data[n])
    {
      flage = n;
      break;
    }
  }
  return flage;
}
