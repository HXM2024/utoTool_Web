int _Set_Battery(float Value)
{
  char str[100];
  int Return_Time;
  Return_Time = 0;
  diagStartTesterPresent(Cdd_Name);
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"设置电压为 %.2f V",Value);
  if(Value>35)
  {
    testStep("Battery","设置电压值较大,后续测试时间较长会损坏控制器,建议人为测试精确时间");
  }
  else
  {
    if(Set_Battery_RS232==0)
      testWaitForTesterConfirmation(str,30000);
    else if(Set_Battery_RS232==1)
      @sysvar::Prog_power::K30Volt = Value;
    _WriteEx_and_Report("电压",str);
    if(Value > NRC22_Battery_Hight)
    {
      H_Battery_Time = _max(H_Battery_Time,100);
      Return_Time = H_Battery_Time*1.5;
      testWaitForTimeout(H_Battery_Time*1.5);
    }
    else if(Value < NRC22_Battery_Low)
    {
      L_Battery_Time = _max(L_Battery_Time,100);
      Return_Time = L_Battery_Time*1.5;
      testWaitForTimeout(L_Battery_Time*1.5);
    }
    else
    {
      L_Battery_Time = _max(L_Battery_Time,100);
      Return_Time =  L_Battery_Time*1.5;
      testWaitForTimeout(L_Battery_Time*1.5);
    }
  }
  _WriteEx_and_Report("","设置电压为 %.2f V",Value);
  diagStopTesterPresent(Cdd_Name);
  return Return_Time;
}


_Check_Error_Count(dword ID,int Count)
{
  int i;
  dword seed;
  _WriteEx_and_Report("","进行错误密钥计数");
  for(i=1;i<=Count;i++)
  {
    if(i==Error_Count)
    {
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
      _TestResult(SendData,ID,"",0x36);
    }
    else
    {
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
      _TestResult(SendData,ID,"",0x35);
    }
    testWaitForTimeout(50);
    Get_Seed_Flage = 1;
  }
}

/// <Security Access>
_Clear_Seed()
{
  int i,j;
  if(Seed_Count != 0) //2026.7.30加入判断减少运行负载
  {
    for(j=0;j<10000;j++)
      Seed_Count_List[j]=0; //清空之前存储的种子
    for(j=0;j<10000;j++)
    {
      Seed_Count_Rept[j][0]=0; //清空之前存储的种子
      Seed_Count_Rept[j][1]=0; //清空之前存储的种子
    }
    for(i=0;i<10000;i++)
    {
      for(j=0;j<16;j++)
      {
        Seed_Count_List_AES128[i][j]=0;//清空之前存储的种子
        Seed_Count_AES_Rept[i][j] = 0;
      }
      Seed_Count_List_AES128[i][16]=0;
      Seed_Count_AES_Rept[i][16]=0;
    }
  }
  Seed_Count = 0;    //清空种子计数
}

_get_Ang_Chery(dword ID)
{
  word Chery_Ang_Now;
  byte Temp[3]={0x22,0x32,0x07};
  word TempValue;
  _Send_Diag(3,ID,Temp);
  if(diagGetLastResponseCode(SendData) != -1)
    testStepFail("未收到积极响应");
  else
  {
    Chery_Ang_Now = (DiagGetRespPrimitiveByte(SendData,3)<<8)+DiagGetRespPrimitiveByte(SendData,4);
    TempValue = 0-Chery_Ang_Now;
    _get_Arry("Angle_Calibrationn");
    Arry_Data[4] = (TempValue>>8)&0xff;
    Arry_Data[5] = TempValue&0xff;
    Arry_Data[6] = 0;
  }
}
/*
  检测信号是否外发
  type = 0 期望停发
  type = 1 期望不停发
*/
int _Check_EPS_TX(byte Type,dword TxID)
{
  int Fla,Return_Value;
  Return_Value = 0;
  Fla = testWaitForMessage(TxID,1000);
  if(Type == 0)
  {
    writeEx(-3,0,"期望报文0x%03X停发",TxID);
    if(Fla==0)
    {
      testStepPass("","期望报文停发,实际未收到0x%X报文",TxID);
      writeEx(-3,0,"实际报文0x%03X停发",TxID);
    }
    else if(Fla==1)
    {
      Return_Value = -1;
      testStepFail("","期望报文停发,实际仍然存在0x%X报文",TxID);
      writeEx(-3,0,"实际仍然存在0x%03X报文",TxID);
    }
    else
      testStepWarning("","检测错误");
  }
  else
  {
    writeEx(-3,0,"期望报文0x%03X正常外发",TxID);
    if(Fla==0)
    {
      Return_Value = -1;
      testStepFail("","期望报文正常外发,实际未收到0x%X报文",TxID);
      writeEx(-3,0,"实际未收到0x%03X报文",TxID);
    }
    else if(Fla==1)
    {
      testStepPass("","期望报文正常外发,实际收到0x%X报文",TxID);
      writeEx(-3,0,"实际报文0x%03X正常外发",TxID);
    }
    else
      testStepWarning("","检测错误");
  }
  return Return_Value;
}
int _Get_Tx_Len()
{
  int len;
  if(CANFD_Flage==0)
    len = 7;
  else
    len =0x3E;
  return len;
}
/*
  Time：等待响应时间
  Flage = 0 无需安全访问
  Flage = 1 需安全访问
  用于高负载测试
*/
_Set_11_Restoration(dword Time,byte Flage)
{
  byte Temp[2]={0x11,0x01};
  byte flage;
  int k,Fun_Pos,Serve_Pos;
  flage=0;
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
  {
    _WriteEx_and_Report("","未查询到支持11服务");
    return;
  }
  if(Flage == 1)
  {
    if(Serve_Data[Serve_Pos].Security_Access[Fun_Pos]==1)
      _Send_Key(SendKey_Len,phyreq_ID,_get_seed(phyreq_ID,500),0);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,Time);
  }
  Temp[1] = Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos];
  _Send_Diag(2,phyreq_ID,Temp,Time);
  testWaitForTimeout(Wait_Time_11);/*复位时间*/
  /*11复位此处不检测响应时间，高负载情况下时间会被复位时间影响*/
//  _TestResult(SendData,phyreq_ID,"",-1);
  Session_BIN = 1;
}

_Set_11_Restoration()
{
  byte Temp[2]={0x11,0x01};
  byte flage;
  int k,Serve_Pos;
  flage=0;
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Data[Serve_Pos].Serve_NRC22[0]&0x01 == 1)
  {
    _Get_CarSpd();
    if(CarSpd_Now != 0)
    {
      flage = 1;
      _Set_CarSpd(0);
    }
  }
  if(Serve_Data[Serve_Pos].Serve_NRC22[0]&0x01 == 1)
  {
    _Get_Ready();
    if(Engine_State == Ready_NRC22)
    {
      flage = 2;
      if(Ready_NRC22 > 0)
        _Set_Ready(0);
      else
        _Set_Ready(Struct_Ready.Ready_Active);
    }
  }
  
  if(Serve_Pos == -1)
  {
    _WriteEx_and_Report("","未查询到支持11服务");
    return;
  }
  if(Serve_Data[Serve_Pos].Security_Access[0]==1)
    _unlockECU();
  else
  {
    if((Session_BIN != 4) && _Check_Serve_IDAndSess(0x11,phyreq_ID,1) == 0)
      _SetSession(exsession);
  }
  Temp[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  _Send_Diag(2,phyreq_ID,Temp);
  _TestResult(SendData,phyreq_ID,"",-1);
  if(flage == 1)
    _Set_CarSpd(CarSpd_Now);
  else if(flage == 2)
    _Set_Ready(Engine_State);
  
  testWaitForTimeout(Wait_Time_11); /*11复位后增加延时时间防止后续出错*/
  Session_BIN = 1;
}
/*
  Flage = 0 无需安全访问
  Flage = 1 需安全访问
*/
_Set_11_Restoration(byte Flage)
{
  byte Temp[2]={0x11,0x01};
  byte flage;
  int k,Serve_Pos;
  flage=0;
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Data[Serve_Pos].Serve_NRC22[0]&0x01 == 1)
  {
    _Get_CarSpd();
    if(CarSpd_Now != 0)
    {
      flage = 1;
      _Set_CarSpd(0);
    }
  }
  if(Serve_Pos == -1)
  {
    _WriteEx_and_Report("","未查询到支持11服务");
    return;
  }
  if(Flage == 1)
  {
    if(Serve_Data[Serve_Pos].Security_Access[0]==1)
      _unlockECU();
  }
  Temp[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  _Send_Diag(2,phyreq_ID,Temp);
  _TestResult(SendData,phyreq_ID,"",-1);
  if(flage == 1)
    _Set_CarSpd(CarSpd_Now);
  testWaitForTimeout(Wait_Time_11); /*11复位后增加延时时间防止后续出错*/
  Session_BIN = 1;
}
/*****************************************/
/*
    检测字符串在预输入时间中所在位置
    Type == 0:mixArray
    Type == 1:DID_Function
*/
int _Check_StrPossion(char sor[],dword poss,int Type)
{
  int po;
  int m;
  po = -1;
  if(Type == 0)
  {
    for(m=0;m<mixArray[poss].Sig_Name_Count;m++)
    {
      if(strncmp(sor,mixArray[poss].LocalTime_Str[m],strlen(sor)) == 0 && (strlen(sor) == strlen(mixArray[poss].LocalTime_Str[m])))
      {
        po = m;
        break;
      }
    }
  }
  else if(Type == 1)
  {
    for(m=0;m<6;m++)
    {
      if(strncmp(sor,DID_Function[poss].LocalTime_SigDef[m],strlen(sor)) == 0 && (strlen(sor) == strlen(DID_Function[poss].LocalTime_SigDef[m])))
      {
        po = m;
        break;
      }
    }
  }
  return po;
}
/*
    检测字符串在结构体中所在位置
    type ==1: mixArray  
    type ==2: Res1904_Data  
    type ==3: ExDataRecord
    type ==4: DID_Function
*/
int _Check_StrPossion_Res(char sor[],dword type) 
{
  int po;
  int m;
  char Sor[100];
  char _Str_DID_1904[40];
  char _Res1904_Data[40];
  char _Ex_Data_Record_Str[50];
  po = -1;
  toUpper(Sor,sor,elCount(Sor));
  if(type == 1)
  {
    for(m=0;m<mixArray_Len;m++)
    {
      toUpper(_Str_DID_1904,mixArray[m].Str_DID_1904,elCount(_Str_DID_1904));
      if(strncmp(Sor,_Str_DID_1904,strlen(Sor)) == 0 && (strlen(Sor) == strlen(_Str_DID_1904)))
      {
        po = m;break;
      }
    }
  }
  else if(type == 2)
  {
    for(m=0;m<Res1904_Data_Count;m++)
    {
      toUpper(_Res1904_Data,Res1904_Data[m].Str,elCount(_Res1904_Data));
      if(strncmp(Sor,_Res1904_Data,strlen(Sor)) == 0 && (strlen(Sor) == strlen(_Res1904_Data)))
      {
        po = m;break;
      }
    }
  }
  else if(type == 3)
  {
    for(m=0;m<ExDataRecord_Count;m++)
    {
      toUpper(_Ex_Data_Record_Str,ExDataRecord[m].Ex_Data_Record_Str,elCount(_Ex_Data_Record_Str));
      if(strncmp(Sor,_Ex_Data_Record_Str,strlen(Sor)) == 0 && (strlen(Sor) == strlen(_Ex_Data_Record_Str)))
      {
        po = m;break;
      }
    }
  }
  else if(type == 4)
  {
    for(m=0;m<DID_Function_Count;m++)
    {
      toUpper(_Ex_Data_Record_Str,DID_Function[m].Sig_Step,elCount(_Ex_Data_Record_Str));
      if(strncmp(Sor,_Ex_Data_Record_Str,strlen(Sor)) == 0 && (strlen(Sor) == strlen(_Ex_Data_Record_Str)))
      {
        po = m;break;
      }
    }
  }
  return po;
}

/*
  输入数据判断
  Type = 0:数据来源mixArray
  Type = 1:数据来源DID_Function
*/
int _Check_ValueInRange_IsWrite(float now_,float Target,float Tolerance,char str[],int Type,byte WriteFlage)  
{
  int Temp_s,Return_Value;
  Temp_s = 0;
  if(Type == 0)
    Temp_s = _Check_StrPossion_Res(str,1);
  else
    Temp_s = _Check_StrPossion_Res(str,4);
  Return_Value = 1;
  if((Type == 0 && Target == mixArray[Temp_s].Invalid) || (Type == 1 && Target == DID_Function[Temp_s].Invalid))
  {
    dword now_1,Target_1;
    now_1 = now_; Target_1 = Target;
    if(now_ !=  Target)
    {
      testStepFail(str,"当前值与预期不一致,预期为0x%X ,实际为0x%X",Target_1,now_1);
      if(WriteFlage == 1)
        writeEx(-3,0,"当前值与预期不一致,预期为0x%X ,实际为0x%X",Target_1,now_1);
      Return_Value = -1;
    }
    else
    {
      testStepPass(str,"当前值与预期一致,期望值为 0x%X",now_1);
      if(WriteFlage == 1)
        writeEx(-3,0,"当前值与预期一致,期望值为 0x%X",now_1);
    }
  }
  else
  {
    if(DataCheckGreater == 1)
    {
      if(now_>Target )
        testStepPass(str,"当前值大于预期,预期为%.2f ,实际为%.2f",Target,now_);
      else
        testStepFail(str,"当前值不大于预期,预期为%.2f ,实际为%.2f",Target,now_);
    }
    else
    {
      if((now_<(Target-Tolerance)) || (now_>(Target+Tolerance)) )
      {
        testStepFail(str,"当前值不在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
        if(WriteFlage == 1)
          writeEx(-3,0,"当前值不在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
        Return_Value = -1;
      }
      else
      {
        testStepPass(str,"当前值在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
        if(WriteFlage == 1)
          writeEx(-3,0,"当前值在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
      }
    }
  }
  return Return_Value;
}

int _Check_ValueInRange_IsWrite_(qword now_,qword Target,float Tolerance,char str[],int Type,byte WriteFlage)  
{
  int Temp_s,Return_Value;
  Temp_s = 0;
  if(Type == 0)
    Temp_s = _Check_StrPossion_Res(str,1);
  else
    Temp_s = _Check_StrPossion_Res(str,4);
  Return_Value = 1;
  if((Type == 0 && Target == mixArray[Temp_s].Invalid) || (Type == 1 && Target == DID_Function[Temp_s].Invalid))
  {
    char now_1[50],Target_1[50];
    snprintf(now_1,elcount(now_1),"%X",now_);
    snprintf(Target_1,elcount(Target_1),"%X",Target);
    if(strncmp (now_1,Target_1,_max(strlen(now_1),strlen(Target_1))) != 0)
    {
      testStepFail(str,"当前值与预期不一致,预期为0x%s ,实际为0x%s",Target_1,now_1);
      if(WriteFlage == 1)
        writeEx(-3,0,"当前值与预期不一致,预期为0x%s ,实际为0x%s",Target_1,now_1);
      Return_Value = -1;
    }
    else
    {
      testStepPass(str,"当前值与预期一致,期望值为 0x%s",now_1);
      if(WriteFlage == 1)
        writeEx(-3,0,"当前值与预期一致,期望值为 0x%s",now_1);
    }
  }
  else
  {
    if((now_<(Target-Tolerance)) || (now_>(Target+Tolerance)) )
    {
      testStepFail(str,"当前值不在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
      if(WriteFlage == 1)
        writeEx(-3,0,"当前值不在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
      Return_Value = -1;
    }
    else
    {
      testStepPass(str,"当前值在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
      if(WriteFlage == 1)
        writeEx(-3,0,"当前值在预期范围内,预期为%.2f ±%.2f,实际为%.2f",Target,Tolerance,now_);
    }
  }
  return Return_Value;
}
/*
  判断输入数据是否为全0，全0情况下特殊处理用于跳过测试
*/
int _Check_mixArray_SetValue(char _Check_Str[],int Pos)
{
  int Return_Value,n;
  char Temp_Str[200];
  Return_Value = 0;
  toUpper(Temp_Str,_Check_Str,elCount(Temp_Str));
  if(strncmp(Temp_Str,"LOCALTIME",strlen(Temp_Str))==0)
  {
    for(n=0;n<4;n++)
    {
      if(strlen(mixArray[Pos].LocalTime_Set[n])!=0)
      {
        Return_Value = 1;
        break;
      }
    }
  }
  else
  {
    for(n=0;n<4;n++)
    {
      if(mixArray[Pos].Vaule_Set[n]!=0)
      {
        Return_Value = 1;
        break;
      }
    }
  }
  return Return_Value;
}
/*
  判断数组是否在输入1904的预期DID中，在则返回所在位置，不在则返回-1
*/
int Array_Compare_1904(byte Sour[])
{
  int Flage_Compare1904;
  int m;
  Flage_Compare1904 = -1;
  for(m=0;m<mixArray_Len;m++)
  {
    Flage_Compare1904 = Array_Compare(Sour,mixArray[m].DID_1904);
    if(Flage_Compare1904==1)
    {
      Flage_Compare1904 = m;
      break;
    }
  }
  return Flage_Compare1904;
}
/*
  对比两组字符串,第一组在第二组中则返回1
*/
int  Array_Compare(byte Sour[],byte Target[])
{
  int ii;
  int Flage_Compare;
  Flage_Compare = 1;
  for(ii=0;ii<elcount(Sour);ii++)
  {
    if(Sour[ii]!=Target[ii])
    {
      Flage_Compare = -1;
      break;
    }
  }
  return Flage_Compare;
}

/*
  将输入的数组按照输入格式进行转换并输出
  List_Input：输入数组
  Len_Input :输入长度
  List_Output：输出数据
  Type ：转换格式
  Type = 2：ASCII码格式转换
  Type = 3：整体转换至10进制 
  Type = 4：每个Byte分别转换至10进制后拼接
  Type = 5：16进制拼接
  Type = 7：前面为16进制 后面为ASCII码
  Type = 8：前面为16进制 后面为ASCII码 多组
  Type = 9：混合DID
*/
void Array_Change(byte List_Input[],int Len_Input,char List_Output[],char List_Ex[],byte Type)
{
  int Count_Size;
  char Temp_Buffer[20];
  snprintf(List_Output,elCount(List_Output),"%s","");
  snprintf(Temp_Buffer,elCount(Temp_Buffer),"%s","");
  if(Type == 2)
  {
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
      snprintf(List_Output,elCount(List_Output),"%s%c",List_Output,HexToAsc(List_Input[Count_Size])); //ASCII码查表切换
  }
  else if(Type == 3)
  {
    qword Data_Temp ;
    Data_Temp = 0;
    snprintf(List_Output,elCount(List_Output),"0x%s");
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
      snprintf(List_Output,elCount(List_Output),"%s%02X",List_Output,List_Input[Count_Size]);
    strtoull(List_Output,Data_Temp);
    snprintf(List_Output,elCount(List_Output),"%s","");
    snprintf(List_Output,elCount(List_Output),"%s%I64u",List_Output,Data_Temp);
  }
  else if(Type == 4)
  {
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
    {
      ltoa(List_Input[Count_Size],Temp_Buffer,10);
      if(strlen(Temp_Buffer) == 1)
        snprintf(List_Output,300,"%s%s",List_Output,"0");
      snprintf(List_Output,300,"%s%s",List_Output,Temp_Buffer);
    }
  }
  else if(Type == 5)
  {
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
    {
      ltoa(List_Input[Count_Size],Temp_Buffer,16);
      if(strlen(Temp_Buffer) == 1)
        snprintf(List_Output,300,"%s%s",List_Output,"0");
      snprintf(List_Output,300,"%s%s",List_Output,Temp_Buffer);
    }
  }
  else if(Type == 7)
  {
    for(Count_Size=0;Count_Size<Len_Input-3;Count_Size++)
    {
      ltoa(List_Input[Count_Size],Temp_Buffer,16);
      if(strlen(Temp_Buffer) == 1)
        snprintf(List_Output,300,"%s%s",List_Output,"0");
      snprintf(List_Output,300,"%s%s",List_Output,Temp_Buffer);
    }
    for(Count_Size = Len_Input-3; Count_Size<Len_Input;Count_Size++)
      snprintf(List_Output,elCount(List_Output),"%s%c",List_Output,HexToAsc(List_Input[Count_Size])); //ASCII码查表切换
    str_replace(List_Output,"/","  ");
  }
  else if(Type == 8)
  {
    int Group_Temp,i,RxLen_Temp;
    Group_Temp = (Len_Input-1)/List_Input[0];//取分组长度
    for(i=0;i<List_Input[0];i++)
    {
      RxLen_Temp = Group_Temp*(i+1);
      for(Count_Size =1+ Group_Temp*i;Count_Size<RxLen_Temp+1-3;Count_Size++)
      {
        ltoa(List_Input[Count_Size],Temp_Buffer,16);
        if(strlen(Temp_Buffer) == 1)
          snprintf(List_Output,300,"%s%s",List_Output,"0");
        snprintf(List_Output,300,"%s%s",List_Output,Temp_Buffer);
      }
      for(Count_Size =RxLen_Temp+1-3;Count_Size<RxLen_Temp+1;Count_Size++)
        snprintf(List_Output,elCount(List_Output),"%s%c",List_Output,HexToAsc(List_Input[Count_Size])); //ASCII码查表切换
      str_replace(List_Output,"/","  ");
    }
  }
  else if(Type == 9)
  {
    char str[500];
    int i,Len_Rx,j,m;
    char Buffer[500]; // 临时装载数据
    char Buffer_Check[500];//装载转换后的数据
    char DID_Str[20][10]; //装载裁剪区分后的字符串
    char DID_TempStr[20];//装载DID
    byte Did_byte[2];//装载DID
    int Return_Value;
    int Group_Temp;
    int Analysis_Temp,ExLen,Flage;
    char Rx_DataTemp[200];
    char Out[500];

    Group_Temp = CountChar(List_Ex,",")+1;
    Truncate_Str(List_Ex,DID_Str,",");
    for(j=0;j<Group_Temp;j++)
    {
      dword DID_;
      char DID_s[10];
      byte DataGet[50];
      Flage = 0;//该DID是否存在与返回中
      snprintf(DID_TempStr,elCount(DID_TempStr),"DID_%s",DID_Str[j]);
      toUpper(DID_TempStr,DID_TempStr,strlen(DID_TempStr));//大写数据类型防止后续判断时不匹配
      snprintf(DID_s,elCount(DID_s),"0x%s",DID_Str[j]);
      DID_ = atol(DID_s);
      Did_byte[0] = (DID_>>8)&0xFF;
      Did_byte[1] = DID_&0xFF;
      _Get_DID(DID_TempStr);
      Analysis_Temp = Analysis;
      ExLen = DID_len_Ex -3;//减去DID + Serve长度
      snprintf(Rx_DataTemp,elCount(Rx_DataTemp),"%s",DID_Data_str);
      if(Analysis_Temp == 7 || Analysis_Temp == 8)
        str_replace(Rx_DataTemp, "/", "  "); //将'/'替换为'  '
      for(i=0;i<Len_Input-1;i++)
      {
        if((List_Input[i] == Did_byte[0]) && (List_Input[i+1] == Did_byte[1]))
        {
          Flage = 1;
          for(m=i+2;m<ExLen+i+2;m++)
            DataGet[m-i-2] = List_Input[m];
        }
      }
      if(Flage == 0)
      {
        testStepFail(DID_s,"该DID未在返回数据中");
        continue;
      }
      if((Analysis_Temp == 1 && Len_Input == 0) || (strlen(Rx_DataTemp) == 0))
      {
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
        continue;
      }
      /*针对不同解析方式进行数据处理*/
      {
        DataChange_Analysis(Analysis_Temp,DataGet,ExLen,Out,Rx_DataTemp,UnUse_Byte,DID_s);
      }
    }
  }
  else
    _WriteEx_and_Report("","无对应解析,待完善");
}

void DID_Read_Some(dword ID,byte Session,char Str[])
{
  int Return_Va,n,Flage_Error;
  int Len_Rx,Len_Ex,Len_Start,Len_End;
  byte Send_Data[100],Temp_RxData[100],Temp_RxData_2[100];
  char DID[20];
  int i;
  Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
  
  if(DID_22_Support==1)
    _WriteEx_and_Report("","该项目一次性只支持一个DID读取");
  else
  {
    Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
    if(Return_Va == 1)
    {
      Send_Data[0] = 0x22;
      _Get_Read_Plural(Str);
      n = 1;
      for(i=0;i<DID_Read_Count;i++)
      {
        Send_Data[n++] = DID_Read[i].DID_byte[0];
        Send_Data[n++] = DID_Read[i].DID_byte[1];
      }
      _Send_Diag(1+DID_Read_Count*2,ID,Send_Data);
      if(diagGetLastResponseCode(SendData) == 0)
        testWaitForDiagResponse(SendData,2000);
      if(diagGetLastResponseCode(SendData) == -1)
      {
        Len_Ex = 0;
        Len_Rx = DiagGetRespPrimitiveSize(SendData);
        for(i=0;i<DID_Read_Count;i++)
        {
          if(DID_Read[i].LenExResp != 0)
            Len_Ex = Len_Ex + DID_Read[i].LenExResp + 2;
        }
        Len_Ex = Len_Ex + 1;
        if(Len_Rx != Len_Ex)
          testStepFail("读取多组DID","返回长度与预期长度不符,返回长度为 %d, 期望长度为 %d",Len_Rx,Len_Ex);
        else
        {
          /* 分组进行判断 */
          Len_Start = 0;
          Len_End = 0;
          for(i=0;i<DID_Read_Count;i++)
          {
            if( DID_Read[i].LenExResp != 0)
            {
              Flage_Error = 0;
              snprintf(DID,elCount(DID),"%s","");
              snprintf(DID,elCount(DID),"0x%02X 0x%02X",DID_Read[i].DID_byte[0],DID_Read[i].DID_byte[1]);
              Len_Start =  Len_End ;
              if(Len_End == 0)
                Len_Start = Len_Start +1;
              Len_End = Len_Start + DID_Read[i].LenExResp+2;
              for(n = 0; n< DID_Read[i].LenExResp+2 ; n++)
              {
                if((Len_Start+n) > Len_Rx)
                {
                  testStepFail("","出现异常长度导致无法获取到后续字节");
                  return;
                }
                Temp_RxData[n] = DiagGetRespPrimitiveByte(SendData,Len_Start+n);
              }
              if((Temp_RxData[0] != DID_Read[i].DID_byte[0]) || (Temp_RxData[1] != DID_Read[i].DID_byte[1]))
                testStepFail(DID,"DID与预期无法对应,接收到DID为: 0x%02X 0x%02X ,预期DID为: 0x%02X 0x%02X ",Temp_RxData[0],Temp_RxData[1],DID_Read[i].DID_byte[0],DID_Read[i].DID_byte[1]);
              else
                testStepPass(DID,"DID与预期一致");
              if(DID_Read[i].ExRspCheck == 0)
              {
                _WriteEx_and_Report(DID,"未输入预期值，不做内容判断");
                continue;
              }
              for(n=0;n<DID_Read[i].LenExResp;n++)
                Temp_RxData_2[n] = DiagGetRespPrimitiveByte(SendData,Len_Start+2+n); //全数据数组(剔除DID)
              if(DID_Read[i].Analysis_Read == 1)
              {
                char Temp_Rx[200];
                char Temp_Ex[200];
                snprintf(Temp_Rx,elCount(Temp_Rx),"%s","实际接收为: ");
                snprintf(Temp_Ex,elCount(Temp_Ex),"%s","期望接收为: ");
                for(n=0;n<DID_Read[i].LenExResp;n++)
                {
                  snprintf(Temp_Rx,elCount(Temp_Rx),"%s%02X",Temp_Rx,Temp_RxData_2[n]);
                  snprintf(Temp_Ex,elCount(Temp_Ex),"%s%02X",Temp_Ex,DID_Read[i].ExResp_Byte[n]);
                  if(Temp_RxData_2[n] != DID_Read[i].ExResp_Byte[n])
                    Flage_Error = 1;
                }
                if(Flage_Error == 1)
                {
                  _WriteEx_and_Report(DID,Temp_Rx);
                  _WriteEx_and_Report(DID,Temp_Ex);
                  testStepFail(DID,"接收到的数据与预期不符");
                }
                else
                  testStepPass(DID,"接收到的数据与预期一致");
              }
              else
              {
                char Buffer_Check[500];
                Array_Change(Temp_RxData_2,DID_Read[i].LenExResp,Buffer_Check,DID_Read[i].ExResp,DID_Read[i].Analysis_Read);
                if(DID_Read[i].Analysis_Read>=7 && DID_Read[i].Analysis_Read <= 9)
                  str_replace(DID_Read[i].ExResp,"/","  ");
                if(DID_Read[i].Analysis_Read != 9)
                  Check_information_(Buffer_Check,DID_Read[i].ExResp,DID);
              }
            }
          }
        }
      }
      else
        testStepFail("","未收到响应或收到消极应答");
    }
    else if(Return_Va == -1)
      _WriteEx_and_Report("","当前寻址不支持该服务");
    else if(Return_Va == 0)
      _WriteEx_and_Report("","当前会话不支持该服务");
  }
}
