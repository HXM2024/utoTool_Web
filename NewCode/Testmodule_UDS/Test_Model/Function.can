/// <Security Access>
/*
  通过种子计算出密钥并发送
  len 发送长度
  ID 发送ID
  Temp_seed 种子
  type = 0：正确密钥
  type = 1：错误密钥
  type = 2：不进行密钥发送
*/
_Send_Key_NoResponse(byte len, dword ID,qword Temp_seed,dword type)   
{
  byte Key_Data[18];
  dword m=0;
  dword Skey;
  word key_i;
  Key_Data[0] = 0x27;
  Key_Data[1] = SendKey_27;
  if(AES_128 == 0)
  {
    _SecurityAccess(Temp_seed,Skey);
    testStep("密钥","计算出密钥为0x%2X",Skey);
    if(type == 1)
    {
      for(m=2;m<len;m++)
        Key_Data[m] = 0x00;
    }
    else 
    {
      for(m=2;m<len;m++)
        Key_Data[m] = (Skey>>(abs(m+1-len)*8))&0xFF;
    }
    if(type != 2)
      _Send_Diag_NoTime(len,ID,Key_Data);  
    else
    {
      for(m=0;m<len-2;m++)
        Key_Save[m] = Key_Data[m+2];
    }
  }
  else if(AES_128 == 1)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CMAC算法");
    if(type == 0 || type == 2)
    {
      _Key_Count();
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = corresKey[key_i];
    }
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = 0x00;
    }
    if(type != 2)
      _Send_Diag_NoTime(len,ID,Key_Data);
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Save[key_i] = Key_Data[key_i+2];
    }
  }
  else if(AES_128 == 2)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    if(type == 0 || type == 2)
    {
      for(m=0;m<16;m++)
        RA[m]=Seed_CBC[m];
      /*用密钥KEY解密RA 得到ra`*/
      AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,Iv);
      /*ra`逆向*/
      reverseNum(ra,16);
      testWaitForTimeout(50);
      /*用密钥KEY加密r得到R*/
      AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,Iv);
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = R[key_i];
    }
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = 0x00;
    }
    if(type != 2)
      _Send_Diag_NoTime(len,ID,Key_Data);
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Save[key_i] = Key_Data[key_i+2];
    }
  }
  else
    _WriteEx_and_Report(ECU_project,"安全访问算法选择异常");
}
/// <Security Access>
/*
  通过种子计算出密钥并发送,发送多个正确秘钥
  len 发送长度
  ID 发送ID
  Temp_seed 种子
*/
_Send_Key_(byte len, dword ID,qword Temp_seed,int Type)   
{
  byte Key_Data[500];
  dword m=0;
  dword Skey;
  int i;
  word key_i,End_Byte;
  
  Key_Data[0] = 0x27;
  Key_Data[1] = SendKey_27;
  if(AES_128 == 0)
  {
    byte Skey_Temp_Byte[4];
    _SecurityAccess(Temp_seed,Skey);
    testStep("密钥","计算出密钥为0x%2X",Skey);
    Skey_Temp_Byte[3] = Skey&0xFF;
    Skey_Temp_Byte[2] = (Skey>>8)&0xFF;
    Skey_Temp_Byte[1] = (Skey>>16)&0xFF;
    Skey_Temp_Byte[0] = (Skey>>24)&0xFF;
    for(m=2;m<len;m++)
      Key_Data[m] = Skey_Temp_Byte[(m-2)%4];
  }
  else if(AES_128 == 1)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CMAC算法");
    _Key_Count();
    for(key_i = 0; key_i < len; key_i++)
      Key_Data[key_i+2] = corresKey[key_i%16];
  }
  else if(AES_128 == 2)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    for(m=0;m<16;m++)
      RA[m]=Seed_CBC[m];
    /*用密钥KEY解密RA 得到ra`*/
    AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,Iv);
    /*ra`逆向*/
    reverseNum(ra,16);
    testWaitForTimeout(50);
    /*用密钥KEY加密r得到R*/
    AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,Iv);
    for(key_i = 0; key_i < len; key_i++)
      Key_Data[key_i+2] = R[key_i%16];
  }
  if(Type>=0)
    Key_Data[1] = Type;
  _Send_Diag(len,ID,Key_Data);   
}

/// <Security Access>
_Key_Count() // 用于匹配简化输入调用，计算安全秘钥使用
{
  switch(AES_CMAC_27)
  {
    case 0:
      _SecurityAccess_AES(Seed_AES,Mask_GeelyAPP,corresKey);break;
    case 1:
      _SecurityAccess_AES(Seed_AES,Mask_RCAPP,corresKey);break;
    case 2:
      _SecurityAccess_AES(Seed_AES,Mask_Chery_APP,corresKey);break;
    case 3:
      _SecurityAccess_AES(Seed_AES,Mask_DongFeng_APP,corresKey);break;
    case 4:
      _SecurityAccess_AES(Seed_AES,Mask_CCAG_APP,corresKey);break;
    default:
      _WriteEx_and_Report("","未收到正确的配置信息");break;
  }
}

dword _Check_Repeat(dword Len)   
{
  dword Repeat_Count;
  dword Repeat_Count_0,Repeat_Count_;
  dword count;
  dword i,j,k;
  int Same_Flage;
  char comment[500];
  char comment_2[500];
  char comment_3[500];
  Repeat_Count = 0;
  Repeat_Count_0 = 0;
  count = 0;
  {
    if(AES_128==0)
    {      
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][0] = Seed_Count_List[i];
        Same_Flage = _Seed_Repeat( Seed_Count_List[i],i,0);
        if(Same_Flage == 1)
          Repeat_Count++;
      }
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][1]++; //初始值为1,出现次数在原基础上加上本身
        if(Seed_Count_List[i]==0)
          Repeat_Count_0++;
      }
      if(Repeat_Count_0==Len)   //若获取到的全部为0,则未收到种子，无重复
        Repeat_Count =0;
    }
    else
    {
      for(i=0;i<Len;i++)
      {
        Repeat_Count_ = 0;
        for(k=0;k<16;k++)
        {
          Seed_Count_AES_Rept[i][k] = Seed_Count_List_AES128[i][k];
          if(Seed_Count_List_AES128[i][k] == 0)
            Repeat_Count_++;
          if(Repeat_Count_ == 16)
            Repeat_Count_0++;
        }
        Same_Flage = _Seed_Repeat(Seed_Count_List_AES128[i],i);
        if(Same_Flage == 1)
          Repeat_Count++;
        Seed_Count_AES_Rept[i][16]++; //初始值为1,出现次数在原基础上加上本身
        testWaitForTimeout(10);
      }
    }
    
    {
      snprintf(comment,elCount(comment),"验证 %d 次,当前重复次数为 %d 次",Len,Repeat_Count);
      snprintf(comment_2,elCount(comment_2),"验证 %d 次,全0种子出现 %d 次",Len,Repeat_Count_0);
      _WriteEx_and_Report("",comment);
      _WriteEx_and_Report("",comment_2);
      if(AES_128 == 0)
      {
        for(i=0;i<Seed_Count;i++)
        {
          if(Seed_Count_Rept[i][1]>1)
          {
            snprintf(comment_3,elCount(comment_3),"种子 0x%08X ,出现次数 %d ",Seed_Count_Rept[i][0],Seed_Count_Rept[i][1]);
            _WriteEx_and_Report("",comment_3);
          }
        }
      }
      else
      {
        for(i=0;i<Seed_Count;i++)
        {
          if(Seed_Count_AES_Rept[i][16]>1)
          {
            char Temp_Str[200];
            snprintf(comment_3,elCount(comment_3),"");
            snprintf(Temp_Str,elCount(Temp_Str),"种子0x");
            for(k=0;k<16;k++)
              snprintf(Temp_Str,elCount(Temp_Str),"%s%02X",Temp_Str,Seed_Count_AES_Rept[i][k]);
            snprintf(comment_3,elCount(comment_3),"%s,出现次数 %d ",Temp_Str,Seed_Count_AES_Rept[i][16]);
            _WriteEx_and_Report("",comment_3);
          }
        }
      }
      if(Request_Seed_Consistency==1)
      {
        if(Repeat_Count!=Len )
          testStepFail("","重复次数与请求次数不等，重复次数为%d",Repeat_Count);
        else
          testStepPass("","重复次数与请求次数相等");
      }
    }
  }
  _Clear_Seed();
  return Repeat_Count;
}

dword _Check_Repeat(int Len,byte Type)   
{
  dword Repeat_Count;
  dword Repeat_Count_0,Repeat_Count_;
  dword count;
  dword i,j,k;
  char comment[500];
  char comment_2[500];
  char comment_3[500];
  int Same_Flage;
  Repeat_Count = 0;
  Repeat_Count_0 = 0;
  count = 0;
  if(Type==0)
    _Check_Repeat(Len);
  else
  {
    if(AES_128==0)
    {
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][0] = Seed_Count_List[i];
        Same_Flage = _Seed_Repeat( Seed_Count_List[i],i,0);
        if(Same_Flage == 1)
          Repeat_Count++;
      }
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][1]++; //初始值为1,出现次数在原基础上加上本身
        if(Seed_Count_List[i]==0)
          Repeat_Count_0++;
      }
      if(Repeat_Count_0==Len)   //若获取到的全部为0,则未收到种子，无重复
        Repeat_Count =0;
    }
    else
    {
      for(i=0;i<Len;i++)
      {
        Repeat_Count_ = 0;
        for(k=0;k<16;k++)
        {
          Seed_Count_AES_Rept[i][k] = Seed_Count_List_AES128[i][k];
          if(Seed_Count_List_AES128[i][k] == 0)
            Repeat_Count_++;
          if(Repeat_Count_ == 16)
            Repeat_Count_0++;
        }
        Same_Flage = _Seed_Repeat(Seed_Count_List_AES128[i],i);
        if(Same_Flage == 1)
          Repeat_Count++;
        Seed_Count_AES_Rept[i][16]++; //初始值为1,出现次数在原基础上加上本身
        testWaitForTimeout(3);
      }
    }
    snprintf(comment,elCount(comment),"验证 %d 次,当前重复次数为 %d 次",Len,Repeat_Count);
    snprintf(comment_2,elCount(comment_2),"验证 %d 次,全0种子出现 %d 次",Len,Repeat_Count_0);
    _WriteEx_and_Report("",comment);
    _WriteEx_and_Report("",comment_2);
    if(AES_128 == 0)
    {
      for(i=0;i<Seed_Count;i++)
      {
        if(Seed_Count_Rept[i][1]>1)
        {
          snprintf(comment_3,elCount(comment_3),"种子 0x%08X ,出现次数 %d ",Seed_Count_Rept[i][0],Seed_Count_Rept[i][1]);
          _WriteEx_and_Report("",comment_3);
        }
      }
    }
    else
    {
      for(i=0;i<Seed_Count;i++)
      {
        if(Seed_Count_AES_Rept[i][16]>1)
        {
          char Temp_Str[200];
          snprintf(comment_3,elCount(comment_3),"");
          snprintf(Temp_Str,elCount(Temp_Str),"种子0x");
          for(k=0;k<16;k++)
            snprintf(Temp_Str,elCount(Temp_Str),"%s%02X",Temp_Str,Seed_Count_AES_Rept[i][k]);
          snprintf(comment_3,elCount(comment_3),"%s,出现次数 %d ",Temp_Str,Seed_Count_AES_Rept[i][16]);
          _WriteEx_and_Report("",comment_3);
        }
      }
    }
    if(Len>=10000 && Repeat_Count >=5)
      testStepFail("","");
    else
      testStepPass("","");
  }
  testWaitForTimeout(2000);
  _Clear_Seed();
  return Repeat_Count;
}
/*
  检测种子是否已经出现过重复
  Seed_ 待检测种子
  _Repeat_Count:已重复种子列表个数
  Type = 0：非AES128类算法,种子长度在4byte以内
*/
int _Seed_Repeat(qword Seed_,dword _Repeat_Count,byte Type)
{
  int Return_Value;
  int k;
  Return_Value = 0;
  for(k=0;k<_Repeat_Count;k++)
  {
    if(Type == 0)
    {
      if(Seed_ == Seed_Count_Rept[k][0])
      {
        Seed_Count_Rept[k][1]++;
        Return_Value = 1;
        break;
      }
    }
  }
  return  Return_Value;
}
/*
  检测种子是否已经出现过重复
  AES 128型
  Seed_ 待检测种子
  _Repeat_Count:列表个数
*/
int _Seed_Repeat(byte Seed_[],dword _Repeat_Count)
{
  int Return_Value;
  int k,m;
  Return_Value = 0;
  for(k=0;k<_Repeat_Count;k++)
  {
    for(m=0;m<16;m++)
    {
      if(Seed_[m] != Seed_Count_AES_Rept[k][m])
        break;
    }
    if(m == 16)
    {
      Seed_Count_AES_Rept[k][16]++;
      Return_Value = 1;
      break;
    }
  }
  return  Return_Value;
}

/// <Security Access>
//安全算法
_SecurityAccess(dword SaccSeed,dword& SaccKey)
{
  if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
  {
    dword KeyK;
    dword KeyResult;
    KeyK = 0X00000137;
    _WriteEx_and_Report(ECU_project,"当前项目为BYD,采用BYD安全算法");
    KeyResult = ((((SaccSeed >> 1) ^ SaccSeed) <<3) ^ (SaccSeed >>2));
    SaccKey = KeyResult ^ KeyK;
  }
  else if(strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("ChangAn"))
  {
    dword key1;
    dword key2;
    dword getSeed1;
    dword getSeed2;
    dword AppKeyConst;
    int i;
    AppKeyConst  =0x70F77302;
    key1 = 0;key2 = 0;
    getSeed2  = 0;
    getSeed1 = SaccSeed;
    _WriteEx_and_Report(ECU_project,"当前项目为长安,采用长安安全算法");
    key1 = AppKeyConst ^ getSeed1;
    for(i = 32;i > 0;i--)
  	{
  		getSeed2 |=  ((getSeed1 & 0x80000000) >> (i-1));
      getSeed1 = getSeed1<<1;
  	}
  	key2 = AppKeyConst ^ getSeed2;
  	SaccKey = (dword)(key1 + key2);
  }
  else if(strncmp(ECU_project,"SGMW",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("SGMW"))
  {
    word uds_key_mul[32] = 
    {
      0x7678, 0x9130, 0xd753, 0x750f, 0x72cb, 0x55f7, 0x13da, 0x786b, 
      0x372a, 0x4932, 0x0e7c, 0x3687, 0x3261, 0xa82c, 0x8935, 0xd00c, 
      0x1995, 0x4311, 0xb854, 0x0d8d, 0x9863, 0x1a21, 0xf753, 0xd6d3,
      0xb15d, 0x7f3d, 0x6821, 0x791c, 0x26c5, 0x2e37, 0x0e69, 0x64a0 
    };
    dword temp;
  	word index;
  	word mult1;
  	word mult2;
    dword NC_DEFAULT_SEED;
    dword NC_UDS_KEYMASK;
    NC_DEFAULT_SEED=0xA548FD85;
    NC_UDS_KEYMASK=0x5C7D4EF3;
    index = 0x5D39;
  	if(SaccSeed == 0) 
  		SaccSeed = NC_DEFAULT_SEED;
  	for(temp=0x80000000;temp!=0;temp>>=1)
  	{
  		if(temp & SaccSeed) 
      {
  			index = croshortright(index,1);
  			if (temp & NC_UDS_KEYMASK) 
  				index ^= 0x74c9;
  		}
  	}
  	mult1 = (uds_key_mul[(index >> 2) & ((1 << 5) - 1)] ^ index);
  	mult2 = (uds_key_mul[(index >> 8) &((1 << 5) - 1)] ^ index);
  	temp = (((dword) mult1) << 16) | ((dword) mult2);
  	temp = mulu32(SaccSeed,temp);
  	SaccKey = temp;
  }
  else if(strncmp(ECU_project,"Geely1.0",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Geely1.0"))
  {
    byte i;
    byte XorArray[4] = {0xC1,0x1C,0x12,0x81};
    byte calData[4];
    byte skeybyte[4];
    for (i = 0;i < 4;i++)
      calData[i] = 0;
    for (i = 0;i < 4;i++)
      calData[i] = ((SaccSeed>>(24-8*i))&0xFF)^ XorArray[i];/*修改秘钥传入方式为MSB*/
    skeybyte[0] = ((calData[3] & 0x0F) << 4 )|(calData[3]&0xF0);
    skeybyte[1] = ((calData[1] & 0x0F) << 4 )|((calData[0]&0xF0) >> 4 );
    skeybyte[2] = (calData[1] & 0xF0)|((calData[2] & 0xF0) >> 4);
    skeybyte[3] = ((calData[0] & 0x0F) << 4 )|(calData[2] & 0x0F);
    SaccKey=skeybyte[0];
    SaccKey=(SaccKey<<8)|skeybyte[1];
    SaccKey=(SaccKey<<8)|skeybyte[2];
    SaccKey=(SaccKey<<8)|skeybyte[3];
  }
  else if(strncmp(ECU_project,"BaoTeng",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BaoTeng"))
  {
    byte i;
    byte XorArray[4] = {0x53,0x4E,0x22,0xCD};
    byte calData[4];
    byte skeybyte[4];
    for (i = 0;i < 4;i++)
      calData[i] = 0;
    for (i = 0;i < 4;i++)
      calData[i] = ((SaccSeed>>(24-8*i))&0xFF)^ XorArray[i];/*修改秘钥传入方式为MSB*/
    skeybyte[0] = ((calData[3] & 0x0F) << 4 )|(calData[3]&0xF0);
    skeybyte[1] = ((calData[1] & 0x0F) << 4 )|((calData[0]&0xF0) >> 4 );
    skeybyte[2] = (calData[1] & 0xF0)|((calData[2] & 0xF0) >> 4);
    skeybyte[3] = ((calData[0] & 0x0F) << 4 )|(calData[2] & 0x0F);
    SaccKey=skeybyte[0];
    SaccKey=(SaccKey<<8)|skeybyte[1];
    SaccKey=(SaccKey<<8)|skeybyte[2];
    SaccKey=(SaccKey<<8)|skeybyte[3];
  }
  else if((strncmp(ECU_project,"DongFeng",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("DongFeng")) || (strncmp(ECU_project,"Seres",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Seres")))
  {
    byte i;
    byte XorArray[4] = {0xD1,0x31,0x54,0x07};
    byte calData[4];
    byte skeybyte[4];
    for (i = 0;i < 4;i++)
    {
      calData[i] = 0;
      skeybyte[i] = 0;
    }
    for (i = 0;i < 4;i++)
      calData[i] = ((SaccSeed>>(24-8*i))&0xFF)^ XorArray[i];/*修改秘钥传入方式为MSB*/
    skeybyte[0] = ((calData[0] & 0x0F) << 4 )|(calData[1]&0xF0);
    skeybyte[1] = ((calData[1] & 0x0F) << 4 )|((calData[2]&0xF0) >> 4 );
    skeybyte[2] = (calData[2] & 0xF0)|((calData[3] & 0xF0) >> 4);
    skeybyte[3] = ((calData[3] & 0x0F) << 4 )|(calData[0] & 0x0F);
    SaccKey=skeybyte[0];
    SaccKey=(SaccKey<<8)|skeybyte[1];
    SaccKey=(SaccKey<<8)|skeybyte[2];
    SaccKey=(SaccKey<<8)|skeybyte[3];
  }  
  else if((strncmp(ECU_project,"SRM",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("SRM")))
  {
    byte i;
    byte XorArray[4] = {0xA1,0x59,0xD4,0x30};
    byte getKey[4];
    byte getSeed[4];
    byte Cal[4];
    dword _Key;
    _Key = 0;
    for (i = 0;i < 4;i++)
    {
      Cal[i] = 0;
      getKey[i] = 0;
      getSeed[i] = 0;
    }
    getSeed[0] = (SaccSeed>>24)&0xFF;
    getSeed[1] = (SaccSeed>>16)&0xFF;
    getSeed[2] = (SaccSeed>>8)&0xFF;
    getSeed[3] = (SaccSeed)&0xFF;
    for(i=0;i<4;i++)
      Cal[i] = getSeed[i]^XorArray[i];
    
    getKey[0] = ((Cal[3] & 0x0f)<<4) | (Cal[0] & 0xff);
		getKey[1] =	(Cal[1] & 0xd8) | ((Cal[2] & 0xf0)>>4);
		getKey[2] =	(Cal[2] & 0xcf) | (Cal[0] & 0xf0);
		getKey[3] = (Cal[3] & 0xf0) | ((Cal[1] & 0xd0)>>4);
    
    _Key |= getKey[0]<<24;
    _Key |= getKey[1]<<16;
    _Key |= getKey[2]<<8;
    _Key |= getKey[3];
    SaccKey = _Key;
  }
  else if(strncmp(ECU_project,"Chery",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Chery"))
  {
    Byte bSeed[2];
    Word remainder;
    Byte n;
    Byte i;
    bSeed[0] = (Byte)(SaccSeed >> 8); 
    bSeed[1] = (Byte)SaccSeed; 
    remainder =0xFFFE;
    for (n = 0; n < 2; n++)
    {
      remainder ^= ((bSeed[n]) << 8);
      for (i = 0; i < 8; i++)
      {
        if (remainder & 0x8000)
        {
          if(remainder & 0x0080)
            remainder = (remainder << 1) ^ 0x8408;
          else
            remainder = (remainder << 1) ^ 0x8025;
        }
        else
          remainder = (remainder << 1);
      }
    }
    SaccKey = remainder;
  }
  else if(strncmp(ECU_project,"GAC",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("GAC"))
  {
    dword _Key;
    dword APPKeyConst;
    byte Seed[4],Key_[4],AppConst[4];
    int i;
    APPKeyConst = 0x20F77302;
    _Key = 0;
    for(i=0;i<4;i++)
    {
      Seed[i] = (SaccSeed>>(8*(4-i-1)))&0xFF;
      AppConst[i] = (APPKeyConst>>(8*(4-i-1)))&0xFF;
      Key_[i] = Seed[i] ^ AppConst[i];
    }
    for(i=0;i<4;i++)
      _Key = _Key + (Key_[i]<<(8*(4-1-i)));
    SaccKey = _Key;
  }
}
/// <Security Access>
/*数组逆向*/
void reverseNum(byte num[],dword size)
{
  dword startnum;
  dword temp;
  dword endnum;
  
  startnum = 0;
  endnum = size - 1;
  while(startnum < endnum)
  {
    temp = num[startnum];
    num[startnum] = num[endnum];
    num[endnum] = temp;
    startnum++;
    endnum--;
  }
}
/// <Security Access>
/*数组移位*/
void LeftMove(byte Serial_Num[],byte bit)
{
  dword i;
  byte current;
  byte carry;
  byte shif;  
  carry = 0;
  for(i=15;i>=0;i--)
  {
    current = Serial_Num[i];
    shif = current << bit;
    shif |= carry;
    Serial_Num[i] = shif & 0xFF;
    carry = (current>>(8-bit)) & ((1<<bit)-1);
  }
}
/// <Security Access>
//用于五菱安全算法
word croshortright(word c, word b)
{
	word right;
	word left;
	word crorightvalue;
  right = c >> b;
  left = c << (16 - b);
  crorightvalue = left | right;
	return crorightvalue;
}
/// <Security Access>
//用于五菱安全算法
dword croleft(dword c, word b)
{
	dword left;
	dword right;
	dword croleftvalue;
  left = c << b;
  right = c >> (32 - b);
  croleftvalue = left | right;
	return croleftvalue;
}
/// <Security Access>
//用于五菱安全算法
dword mulu32(dword val1, dword val2)
{
	dword x, y, z, p;
  dword NC_UDS_KEYMASK=0x5c7d4ef3;
	x = (val1 & NC_UDS_KEYMASK) | ((~val1) & val2);
	y = ((croleft(val1, 1)) & (croleft(val2, 14)))
	        | ((croleft(NC_UDS_KEYMASK, 21)) & (~(croleft(val1, 30))));
	z = (croleft(val1, 17)) ^ (croleft(val2, 4))
	        ^ (croleft(NC_UDS_KEYMASK, 11));
	p = x ^ y ^ z;
	return p;
}
/// <Security Access>
void _SecurityAccess_AES(dword seed[], word Byte_[],word corresKey[])
{
  char M[16],mic[16];
  int i;
  char fixByte[16];
  word gHandle;
  for(i=0;i<16;i++)
  {
    fixByte[i] = Byte_[i];
  }
  gHandle = registerCAPLDLL();
  for(i = 0; i < 16; i++)
  {
    M[i] = seed[i];
  }
  aes_128_cmac(M,fixByte,mic);
  for(i = 0; i < 16; i++)
  {
    corresKey[i] = mic[i] & 0xFF;
  }
  fileClose(gHandle);
}

/// <Security Access>
/*2702密钥填充：type:0:正确密钥  1:错误密钥*/
void _padding2702(int type)
{
  word key_i;
//  dword Seed_AES_[16] = {0x6b,0xc1,0xbe,0xe2,0x2e,0x40,0x9f,0x96,0xe9,0x3d,0x7e,0x11,0x73,0x93,0x17,0x2a};
  if(type == 0)
  {
    _Key_Count();
    for(key_i = 0; key_i < 16; key_i++)
      DiagSetPrimitiveByte(sendkey,key_i+2,corresKey[key_i]);
  }
  else
  {
    for(key_i = 0; key_i < 16; key_i++)
      DiagSetPrimitiveByte(sendkey,key_i+2,0x00);
  }
}
/**
  将接受到的所有报文装载到responseMsgs中
  且第一帧在50ms，后续帧通过参数time来控制
**/
void _saveMsg(int time)
{
  byte i,j;
  int flag_getMsg;
  flag_getMsg = _getMsg(responseMsgs[0],p2cmax);
  if(flag_getMsg == 1)
  {
    for(i = 1; i < 10; i++)
    {
      _getMsg(responseMsgs[i],N_Cr_Time);
      if(responseMsgs[i].dlc == 0)
        break;
    }
  }
}
/**
  获取报文，判断报文响应时间是否在目标时间time内
**/
int _getMsg(message 0x00 msg,int time)
{
  char comment[50];
  byte i;
  int re;
  int resave;
  int flag_getMsg;//判断有没有获取到报文
  re = testWaitForMessage(Response_ID,time);
  if(re>0)
  {
    testGetWaitEventMsgData(msg);
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    }
    resave++;
    flag_getMsg = 1;
  }
  else
    flag_getMsg = 0;
  
  if(re == 0 && resave == 0)
  {
    if(noFail == 0)
      TestStepFail("报文响应超时");
  }
  return flag_getMsg;
}
//发送请求等待响应，并将请求和响应写进报告。如果响应是多帧不要使用此函数，因为p2cmax时间可能不够
_SendAndWriteReport_NoTime(diagRequest* obj,dword ID)
{
  char comment[70];
  byte primitiveRaw[300];
  long size;
  byte i;
  
  size=DiagGetPrimitiveData(obj,primitiveRaw,elCount(primitiveRaw));
  if(DiagGetPrimitiveByte(obj,0) == 0x10 || DiagGetPrimitiveByte(obj,0) == 0x11 || DiagGetPrimitiveByte(obj,0) == 0x27 || DiagGetPrimitiveByte(obj,0) == 0x3E)
  {
    NRC78_flag = 1;
  }
  if(ID==@sysvar::DID::phyreq_ID)
    snprintf(comment,elCount(comment),"已发送物理寻址请求:[%02X]",size);
  else
    snprintf(comment,elCount(comment),"已发送功能寻址请求:[%02X]",size);
  for(i=0;i<size;i++)
  {
    snprintf(comment,elCount(comment),"%s %02X",comment,primitiveRaw[i]);
  }
  if(ID==@sysvar::DID::phyreq_ID)
    diagSendRequest(obj);
  else if(ID==@sysvar::DID::funreq_ID)
    diagSendFunctional(obj);
  
  diagSetP2Extended(-1);
  testWaitForDiagRequestSent(obj,500);
  testCaseComment(comment);
  writeEx(-3,0,comment);
  testReportWriteDiagObject(obj);
}
int _CheckCode(int passcondition,int checkLength)
{
  int resNum,i,j,allRes_i;
  int checkResult;
  word allRes[100];
  word dlc,allRes_length;
  checkResult = 0;
  dlc = 8;
  for(i = 0; i< 10; i++)//获取当前响应码序列长度
  {
    if(responseMsgs[i].dlc == 0)
      break;
    else if(responseMsgs[i].byte(0) == 0x03 && responseMsgs[i].byte(1) == 0x7f && responseMsgs[i].byte(3) == 0x78 && NRC78_flag == 0)//响应78不存入验证数组
    {
      allRes_i++;
      resNum--;
    }
    else if(responseMsgs[i].byte(0) == 0x30 )  //流控帧不计入数组
    {
      allRes_i++;
      resNum--;
    }
    else
    {
      for(j = 0; j < dlc ; j++)
        allRes[((i-allRes_i)*dlc)+j] = responseMsgs[i].byte(j);
    }  
    resNum++;
  }
  allRes_length = resNum * dlc;
  if(AES_128 == 1 && allRes_length > 0)//将响应的种子存入seed    需注意区分CAN与CANFD
  {
    word inx;
    inx = 4;
    if(Response_CanFD==0)
    {
      for(j = 0; j < 16; j++)
      {
        Seed_AES[j] = allRes[j+inx];
        if(j == 3)
          inx = 5;
        if(j == 10)
          inx = 6;
      }
    }
    else
    {
      for(j = 0; j < 16; j++)
        Seed_AES[j] = allRes[j+inx];
    }
    inx = 4;
  }
  if(passcondition == -1)
    testStepPass("收到肯定响应");
  else if(passcondition == 0)
    testStepfail("无响应");
  else
    testStepfail("收到否定响应");
  resNum = 0;
  allRes_i = 0;
  NRC78_flag = 0;
  for(i = 0; i < 100 ; i++)
    allRes[i] = 0;
  _initMsg(responseMsgs);
  return checkResult;
}
/* 操作完后将responseMsgs重置*/
void _initMsg(message 0x00 msg[])
{
  message 0x00 init_msg;
  word i;
  for(i = 0; i < elCount(msg); i++)
    msg[i] = init_msg;
}

//重置为默认会话或扩展会话
_SetSession(byte Session)
{
  if(Session==defsession)
  {
    _Switch_To_Def();
    Session_BIN = 0x01;
  }
  else if(Session==exsession)
  {
    _Switch_To_Ex();
    Session_BIN = 0x04;
  }
}
//请求重置为默认会话
_Switch_To_Def()
{
  testCaseComment("请求重置为默认会话");
  diagResize(Session_Start,2);
  DiagSetPrimitiveByte(Session_Start,0,0x10);
  DiagSetPrimitiveByte(Session_Start,1,defsession);
  diagSendRequest(Session_Start);
  testWaitForDiagRequestSent(Session_Start,50);
  diagSetP2Extended(-1);
  testWaitForDiagResponse(Session_Start,p2cmax);
  if(diagGetLastResponseCode(Session_Start)==0x78)
  {
    do{
    testWaitForDiagResponse(Session_Start,p2cmax*100);
    }while(diagGetLastResponseCode(Session_Start)==0x78);
  }
  /*判断重置默认会话是否成功并体现在报告里*/
  if(diagGetLastResponseCode(Session_Start)==-1)
    testStepPass("重置默认会话成功");
  else
    testStepFail("重置默认会话失败");
}

//请求重置为扩展会话
_Switch_To_Ex()
{
  testCaseComment("请求重置为扩展会话");
//  diagSetTarget(Cdd_Name); //重新连接Cdd文件会导致前面定义的信息无效化
  diagResize(Session_Start,2);
  DiagSetPrimitiveByte(Session_Start,0,0x10);
  DiagSetPrimitiveByte(Session_Start,1,exsession);
  diagSendRequest(Session_Start);
  testWaitForDiagRequestSent(Session_Start,50);
  diagSetP2Extended(-1);
  testWaitForDiagResponse(Session_Start,p2cmax);
  if(diagGetLastResponseCode(Session_Start)==0x78)
  {
    do{
    testWaitForDiagResponse(Session_Start,p2cmax*100);
    }while(diagGetLastResponseCode(Session_Start)==0x78);
  }
  /*判断重置扩展会话是否成功并体现在报告里*/
  if(diagGetLastResponseCode(Session_Start)==-1)
    testStepPass("重置扩展会话成功");
  else
    testStepFail("重置扩展会话失败");
}
