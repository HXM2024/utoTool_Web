}

/// <DID_22>
/*-------------------------------------22DID遍历----------------------------------------------*/
/*
  遍历输入的DID
  Type = 0：仅读取
  Type = 1：读取后进行异常写入
*/
int _Check_22DID(dword ID,byte DID_Send[],byte Session,byte Type)
{
  int Re,Write_NRC,Check_Return;
  dword Fun;
  Fun = (DID_Send[1]<<8) ^ (DID_Send[2]);
  Check_Return = _Check_Fun_IDAndSess(0x22,Fun,ID,Session);
  testStep("","DID 0x%04X",Fun);
  if(Fun == 0xD01C && Geely3_Flage == 1)
  {
    _WriteEx_and_Report("","该DID单独执行，此处不进行测试");
    return 1;
  }
  if(Support_ReadSession == 1 && DID_Send[1] ==Read_Now_Session[1] && DID_Send[2] ==Read_Now_Session[2])
  {
    Analysis = 1;
    DID_Data[0] = Session;
    Len_Input = 1;
  }
  if(Check_Return == -1)
  {
    Re = Analysis_Select(Analysis,ID,DID_Send,0);
  }
  else if(Check_Return == 1)
  {
    Re = Analysis_Select(Analysis,ID,DID_Send,-1);
    if(Type == 1 && Write_Flage == 0)
    {
      byte Send_Data[1000],Send_Data_2[2],Serve_pos;
      int k;
      _WriteEx_and_Report("","开始测试异常写入");
      Write_NRC = 0;
      Serve_pos = _Check_Serve(0x11,0,0);
      Send_Data[0] = 0x2E;
      Send_Data[1] = DID_Send[1];
      Send_Data[2] = DID_Send[2];
      Send_Data_2[0] = 0x11;
      Send_Data_2[1] = Serve_Data[Serve_pos].Serve_Fun[0];
      for(k=0;k<DID_len_Ex-3;k++)
        Send_Data[3+k] = 0xFF;
      _unlockECU();
      _Send_Diag(DID_len_Ex,phyreq_ID,Send_Data);
      _TestResult(SendData,phyreq_ID,"",0x31);
      if(diagGetLastResponseCode(SendData) != 0x31)
        Write_NRC = -1;
      {
        /*复位前读取*/
        Re = Analysis_Select(Analysis,ID,DID_Send,-1);
      }
      _Send_Diag(2,phyreq_ID,Send_Data_2);
      _TestResult(SendData,phyreq_ID,"",-1);
      testWaitForTimeout(1000);

      if(_Check_Serve(0x22,Fun,5) == 1)
        _unlockECU();

      {
        /*复位后再次读取*/
        Re = Analysis_Select(Analysis,ID,DID_Send,-1);
      }
      if(Write_NRC == -1)
        Re = -1;
    }
  }
  return Re;
}
/// <DID_22>
int Analysis_Select(int Type,dword ID,byte DID_Send[],int Res)
{
  int Return_Value;
  switch(Analysis)
  {
    case 2:
      Return_Value = _Check_22DID_ASCII(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 3:
      Return_Value = _Check_22DID_DecAll(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 4:
      Return_Value = _Check_22DID_DecByte(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 5:
      Return_Value = _Check_22DID_HexSplicing(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 6:
      Return_Value = _Check_22DID_Mixed_DecALL_DecByte(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 7:
      Return_Value = _Check_22DID_Mixed_BCD_ASCII3(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 8:
      Return_Value = _Check_22DID_Mixed_BCD_ASCII3_3(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 9:
      Return_Value = _Check_22DID_Mixed_DIDs(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    default:
      Return_Value = _Check_22DID_Hex(ID,DID_len_Ex,DID_Send,DID_Data,Res);break;
  }
  return Return_Value;
}
/// <DID_22>
int _Check_22DID_Hex(dword msgID,dword LenEx,byte Tx_Data[],byte Rx_Data[],int passcondition)
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int flage_0 = 0;
  int flage = 0;
  int Return_Value,Temp_Return_Flage;
  Return_Value = 0;
  
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,2000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
      Return_Value = -1;
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if(Len_Input<=Len_Rx)
    {
      if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
      {
        testStepFail(str,"前三字符存在异常,实际反馈为 0x%2X  0x%2X  0x%2X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
        Return_Value = -1;
      }
      else
        testStepPass(str,"前三字符与预期一致");
      if(Len_Input==0)
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
      else if(Len_Input>0)
      {
        for(i=0;i<Len_Input;i++)
        {
          if(Rx_Data[i]!= DiagGetRespPrimitiveByte(req1,i+3))
          {
            flage_0 = 1;
            Return_Value = -1;
            testStepFail(str,"反馈值异常，预期为；0x%2X,第%d 位实际反馈值为:0x%2X",Rx_Data[i],i+4,DiagGetRespPrimitiveByte(req1,i+3));
          }
        }
        if(flage_0 == 0)
          testStepPass(str,"反馈与预期一致");
       if(Len_Input<Len_Rx-3)
        {
          _WriteEx_and_Report("","存在未使用的填充位");
          for(i=Len_Input+3;i<Len_Rx;i++)
          {
            if(DiagGetRespPrimitiveByte(req1,i) != UnUse_Byte)
            {
              flage = 1;
              Return_Value = -1;
              testStepFail(str,"未使用位填充值存在非预期情况，默认填充值为；0x%2X,第%d 位实际反馈值为:0x%2X",UnUse_Byte,i+1,DiagGetRespPrimitiveByte(req1,i));
            }
          }
          if(flage == 0)
            testStepPass(str,"未使用填充位为默认值0x%2X",UnUse_Byte);
        } 
      }
    }
    else if(Len_Input>Len_Rx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,收到的长度小于期望长度");
    }
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/// <DID_22>
int _Check_22DID_ASCII(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int flage = 0;
  char Buffer[500];
  int Return_Value,Temp_Return_Flage;
  int InPut_Len;
  Return_Value = 0;
  
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
//  InPut_Len = strlen(Rx_Data);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if(strlen(Rx_Data)<=Len_Rx)
    {      
      if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
      {
        Return_Value = -1;
        testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
      }
      else
        testStepPass(str,"前三字符与预期一致");
      if(strlen(Rx_Data)!=0)
      {
        for(i=3;i<strlen(Rx_Data)+3;i++)
        {
          snprintf(Buffer,elCount(Buffer),"%s%c",Buffer,HexToAsc(DiagGetRespPrimitiveByte(req1,i))); //ASCII码查表切换
        }
        Temp_Return_Flage = Check_information_(Buffer,Rx_Data,str);
        if(Temp_Return_Flage == -1)
          Return_Value = -1;
        if(strlen(Rx_Data)<Len_Rx-3)
        {
          _WriteEx_and_Report("","存在未使用的填充位");
          for(i=strlen(Rx_Data)+3;i<Len_Rx;i++)
          {
            if(DiagGetRespPrimitiveByte(req1,i) != UnUse_Byte)
            {
              flage = 1;
              Return_Value = -1;
              testStepFail(str,"未使用位填充值存在非预期情况，默认填充值为；0x%02X,第%d 位实际反馈值为:0x%2X",UnUse_Byte,i+1,DiagGetRespPrimitiveByte(req1,i));
            }
          }
          if(flage == 0)
            testStepPass(str,"未使用填充位为默认值0x%02X",UnUse_Byte);
        }
      }
      if(strlen(Rx_Data)==0)
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
    }
    else if(strlen(Rx_Data)>Len_Rx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,收到的长度小于期望长度");
      if(strlen(Rx_Data)!=0)
      {
        for(i=3;i<Len_Rx;i++)
        {
          snprintf(Buffer,elCount(Buffer),"%s%c",Buffer,HexToAsc(DiagGetRespPrimitiveByte(req1,i))); //ASCII码查表切换
        }
        Temp_Return_Flage = Check_information_(Buffer,Rx_Data,str);
      }
    }
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/// <DID_22>
int _Check_22DID_DecAll(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*整体转换*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  qword Data_Temp ;
  char Buffer[500];
  char Buffer_Check[500];
  int Return_Value,Temp_Return_Flage;
  Return_Value = 0;
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  Data_Temp = 0;
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
    if(strlen(Rx_Data)!=0)
    {
      for(i=3;i<Len_Rx;i++)
      {
        if(DiagGetRespPrimitiveByte(req1,i)>0x0F)
            snprintf(Buffer,elCount(Buffer),"%s%2X",Buffer,DiagGetRespPrimitiveByte(req1,i));
        else
          {
            snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0");
            snprintf(Buffer,elCount(Buffer),"%s%X",Buffer,DiagGetRespPrimitiveByte(req1,i));
          }
      }
      strtoull(Buffer,Data_Temp);
      snprintf(Buffer_Check,elCount(Buffer_Check),"%s%I64u",Buffer_Check,Data_Temp);
      Temp_Return_Flage = Check_information_(Buffer_Check,Rx_Data,str);
      if(Temp_Return_Flage == -1)
        Return_Value = -1;
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/// <DID_22>
int _Check_22DID_DecByte(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*每个Byte分别转换*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  char Buffer[500];
  char Buffer_Check[500];
  int Return_Value,Temp_Return_Flage;
  Return_Value = 0;
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
    if(strlen(Rx_Data)!=0)
    {
      for(i=3;i<Len_Rx;i++)
      {
        ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,10);
        if(strlen(Buffer) == 1)
        {
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
        }
        snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
      }
      Temp_Return_Flage = Check_information_(Buffer_Check,Rx_Data,str);
      if(Temp_Return_Flage == -1)
        Return_Value = -1;
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/// <DID_22>
int _Check_22DID_HexSplicing(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*16进制拼接*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int flage = 0;
  qword Data_Temp = 0;
  char Buffer[500];
  char Buffer_Check[500];
  int Return_Value,Temp_Return_Flage;
  Return_Value = 0;
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if(strlen(Rx_Data)/2<=Len_Rx)
    {      
      if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
      {
        Return_Value = -1;
        testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
      }
      else
        testStepPass(str,"前三字符与预期一致");
      snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
      if(strlen(Rx_Data)!=0)
      {
        for(i=3;i<strlen(Rx_Data)/2+3;i++)
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,16);
          if(strlen(Buffer) == 1)
          {
            snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
          }
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
        }
        toUpper(Buffer_Check, Buffer_Check, elcount(Buffer_Check));
        Temp_Return_Flage = Check_information_(Buffer_Check,Rx_Data,str);
        if(Temp_Return_Flage == -1)
          Return_Value = -1;
        if(strlen(Rx_Data)/2<Len_Rx-3)
        {
          _WriteEx_and_Report("","存在未使用的填充位");
          for(i=strlen(Rx_Data)/2+3;i<Len_Rx;i++)
          {
            if(DiagGetRespPrimitiveByte(req1,i) != UnUse_Byte)
            {
              flage = 1;
              Return_Value = -1;
              testStepFail(str,"未使用位填充值存在非预期情况，默认填充值为；0x%02X,第%d 位实际反馈值为:0x%02X",UnUse_Byte,i+1,DiagGetRespPrimitiveByte(req1,i));
            }
          }
          if(flage == 0)
            testStepPass(str,"未使用填充位为默认值0x%02X",UnUse_Byte);
        }
      }
      if(strlen(Rx_Data)==0)
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
    }
    else if(strlen(Rx_Data)/2>Len_Rx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常");
    }
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/// <DID_22>
int _Check_22DID_Mixed_DecALL_DecByte(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*混合解析BYD: F1 95*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  qword Data_Temp = 0;
  char Buffer[500];
  char Buffer_1[500];
  char Buffer_Check[500];
  char Buffer_Check_1[500];
  int Return_Value,Temp_Return_Flage;
  Return_Value = 0;
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_1,elCount(Buffer_1),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  snprintf(Buffer_Check_1,elCount(Buffer_Check_1),"%s","");
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
    if(strlen(Rx_Data)!=0)
    {
      for(i=3;i<5;i++)
      {
        if(DiagGetRespPrimitiveByte(req1,i)>0x0F)
            snprintf(Buffer,elCount(Buffer),"%s%2X",Buffer,DiagGetRespPrimitiveByte(req1,i));
        else
          {
            snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0");
            snprintf(Buffer,elCount(Buffer),"%s%X",Buffer,DiagGetRespPrimitiveByte(req1,i));
          }
      }
      strtoull(Buffer,Data_Temp);
      snprintf(Buffer_Check,elCount(Buffer_Check),"%s%I64u",Buffer_Check,Data_Temp);
      if(strstr(Rx_Data,",") != -1)
      { 
        snprintf(Buffer_Check_1,200,"%s%s",Buffer_Check_1,",");
        for(i=5;i<Len_Rx;i++)
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer_1,10);
          if(strlen(Buffer_1) == 1)
          {
           snprintf(Buffer_Check_1,200,"%s%s",Buffer_Check_1,"0");
          }
         snprintf(Buffer_Check_1,200,"%s%s",Buffer_Check_1,Buffer_1);
        }
      }
      else if(strstr(Rx_Data,",") == -1)
      {
        _WriteEx_and_Report("","未填充第二部分，跳过第二部分检测");
      }
      snprintf(Buffer_Check,300,"%s%s",Buffer_Check,Buffer_Check_1);
      Temp_Return_Flage = Check_information_(Buffer_Check,Rx_Data,str);
      if(Temp_Return_Flage == -1)
        Return_Value = -1;
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过所有内容检测");
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/// <DID_22>
/*前面为BCD格式-后3字节为ASCII码*/
int _Check_22DID_Mixed_BCD_ASCII3(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int flage = 0;
  char Buffer[500];
  char Buffer_Check[500];
  int Return_Value,Temp_Return_Flage;
  int InPut_Len;
  Return_Value = 0;
  
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if(strlen(Rx_Data)<=(Len_Rx-6)*2+3)
    {      
      if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
      {
        Return_Value = -1;
        testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
      }
      else
        testStepPass(str,"前三字符与预期一致");
      if(strlen(Rx_Data)!=0)
      {
        for(i=3;i<Len_Rx-3;i++) //前面为BCD拼接
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,16);
          if(strlen(Buffer) == 1)
            snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
          snprintf(Buffer,200,"");
        }
        for(i=Len_Rx-3;i<Len_Rx;i++)  //后三字节为ASCII码
        {
          snprintf(Buffer_Check,elCount(Buffer_Check),"%s%c",Buffer_Check,HexToAsc(DiagGetRespPrimitiveByte(req1,i))); //ASCII码查表切换
        }
        str_replace(Rx_Data, "/", "  "); //将'/'替换为'  '
        Temp_Return_Flage = Check_information_(Buffer_Check,Rx_Data,str);
        if(Temp_Return_Flage == -1)
          Return_Value = -1;
      }
      if(strlen(Rx_Data)==0)
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
    }
    else if(strlen(Rx_Data)>Len_Rx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,收到的长度小于期望长度");
      if(strlen(Rx_Data)!=0)
      {
        for(i=3;i<Len_Rx-3;i++)
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,16);
          if(strlen(Buffer) == 1)
            snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
          snprintf(Buffer,200,"");
        }
        for(i=Len_Rx-3;i<Len_Rx;i++)  //后三字节为ASCII码
        {
          snprintf(Buffer_Check,elCount(Buffer_Check),"%s%c",Buffer_Check,HexToAsc(DiagGetRespPrimitiveByte(req1,i))); //ASCII码查表切换
        }
        str_replace(Rx_Data, "/", "  "); //将'/'替换为'  '
        Temp_Return_Flage = Check_information_(Buffer,Rx_Data,str);
      }
    }
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}
/// <DID_22>
/*前面为BCD格式-后3字节为ASCII码 多组*/
int _Check_22DID_Mixed_BCD_ASCII3_3(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)
{
  diagRequest * req1; 
  char str[500];
  int i, Len_Rx,j;
  int flage;
  char Buffer[500];
  char Buffer_Check[500];
  char Temp_Rx_Data[500];
  int Return_Value,Temp_Return_Flage;
  int InPut_Len;
  int RxLen_Temp,Group_Temp;
  Return_Value = 0;
  flage = 0;
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  snprintf(str,elCount(str),"%s%02X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
      
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    if(DiagGetPrimitiveByte(req1,3) != 3)
      testStepPass(str,"第四字节错误，期望为0x03,实际为0x%02X",DiagGetPrimitiveByte(req1,3));
    
    Group_Temp = (Len_Rx-4)/DiagGetRespPrimitiveByte(req1,3); //分组  
    if(strlen(Rx_Data)!=0)
    {
      for(j=0;j<DiagGetRespPrimitiveByte(req1,3);j++)
      {
        snprintf(Buffer,elCount(Buffer),"%s","");
        snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
        snprintf(Temp_Rx_Data,elCount(Temp_Rx_Data),"%s","");
        RxLen_Temp = Group_Temp*(j+1);
        substr_cpy(Temp_Rx_Data, Rx_Data, (strlen(Rx_Data)/3)*j, strlen(Rx_Data)/3, elcount(Temp_Rx_Data));
        for(i=4+Group_Temp*j;i<RxLen_Temp+4-3;i++) //前面为BCD拼接
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,16);
          if(strlen(Buffer) == 1)
            snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
          snprintf(Buffer,200,"");
        }
        for(i=RxLen_Temp+4-3;i<RxLen_Temp+4;i++)  //后三字节为ASCII码
        {
          snprintf(Buffer_Check,elCount(Buffer_Check),"%s%c",Buffer_Check,HexToAsc(DiagGetRespPrimitiveByte(req1,i))); //ASCII码查表切换
        }
        str_replace(Temp_Rx_Data, "/", "  "); //将'/'替换为'  '
        writeEx(-3,0,"第 %d 组数据",j+1);
        Temp_Return_Flage = Check_information_(Buffer_Check,Temp_Rx_Data,str);
        if(Temp_Return_Flage == -1)
          Return_Value = -1;
      }
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/// <DID_22>
/*多组DID混合，输入口为混合DID组*/
int _Check_22DID_Mixed_DIDs(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)
{
  diagRequest * req1; 
  char str[500];
  int i,Len_Rx,j,m;
  char Buffer[500]; // 临时装载数据
  char Buffer_Check[500];//装载转换后的数据
  char DID_Str[20][10]; //装载裁剪区分后的字符串
  char DID_TempStr[20];//装载DID
  byte Did_byte[2];//装载DID
  int Return_Value;
  int Group_Temp;
  int Analysis_Temp,ExLen,Flage;
  char Rx_DataTemp[200];
  char Out[500];
  Return_Value = 0;
  
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"%s%02X  %02X",str,Tx_Data[1],Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID);
  if((diagGetLastResponseCode(req1) == 0) && (passcondition != 0))
    testWaitForDiagResponse(req1,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (passcondition != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
      
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%02X  0x%02X  0x%02X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    
    if(strlen(Rx_Data)!=0)
    {
      Group_Temp = CountChar(Rx_Data,",")+1;
      Truncate_Str(Rx_Data,DID_Str,",");
      for(j=0;j<Group_Temp;j++)
      {
        dword DID_;
        char DID_s[10];
        byte DataGet[50];
        Flage = 0;//该DID是否存在与返回中
        snprintf(DID_TempStr,elCount(DID_TempStr),"DID_%s",DID_Str[j]);
        toUpper(DID_TempStr,DID_TempStr,strlen(DID_TempStr));//大写数据类型防止后续判断时不匹配
        snprintf(DID_s,elCount(DID_s),"0x%s",DID_Str[j]);
        DID_ = atol(DID_s);
        Did_byte[0] = (DID_>>8)&0xFF;
        Did_byte[1] = DID_&0xFF;
        _Get_DID(DID_TempStr);
        Analysis_Temp = Analysis;
        ExLen = DID_len_Ex -3;//减去DID + Serve长度
        snprintf(Rx_DataTemp,elCount(Rx_DataTemp),"%s",DID_Data_str);
        if(Analysis_Temp == 7 || Analysis_Temp == 8)
          str_replace(Rx_DataTemp, "/", "  "); //将'/'替换为'  '
        for(i=3;i<Len_Rx-1;i++)
        {
          if((DiagGetRespPrimitiveByte(req1,i) == Did_byte[0]) && (DiagGetRespPrimitiveByte(req1,i+1) == Did_byte[1]))
          {
            Flage = 1;
            for(m=i+2;m<ExLen+i+2;m++)
              DataGet[m-i-2] = DiagGetRespPrimitiveByte(req1,m);
          }
        }
        if(Flage == 0)
        {
          testStepFail(DID_s,"该DID未在返回数据中");
          continue;
        }
        if((Analysis_Temp == 1 && Len_Input == 0) || (strlen(Rx_DataTemp) == 0))
        {
          _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
          continue;
        }
        /*针对不同解析方式进行数据处理*/
        {
          DataChange_Analysis(Analysis_Temp,DataGet,ExLen,Out,Rx_DataTemp,UnUse_Byte,DID_s);
        }
      }
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
  }
  else if((diagGetLastResponseCode(req1) == passcondition) && (passcondition == 0))
    testStepPass(str,"与预期一致无响应");
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/*----------------------------------------------------------------------------------------*/

/*
  判断是否为CANFD报文,修改对应的发送长度
  用于NRC13遍历，CANFD报文返回0x3E，CAN报文返回7
*/
dword _Check_CANFD_Flage()
{
  dword data = 0;
  if (CANFD_Flage == 0)
  {
    _WriteEx_and_Report("","当前为CAN报文数据");
    data = 0x07;   
  }
  if (CANFD_Flage == 1)
  {
    _WriteEx_and_Report("","当前为CANFD报文数据");
    data = 0x3E;   
  }
  return data;
}
_Check_DID_2E(dword ID,byte Session)
{
  char str1[2000];
  byte Read_Data[2000];
  int Read_Data_Len;
  int i,m,Flage_Read,Fun_Temp,UnlockFlage;
  snprintf(str1,elCount(str1),"%s","");
  snprintf(str1,elCount(str1),"%s","获取第一次写入数据: ");
  if(Support_Read_2E_DID == 1)
  {
    for(i=0;i<DID_2E_SendData_1_Len;i++)
    {
      snprintf(str1,elCount(str1),"%s%02X",str1,DID_2E_SendData_1[i]);
      snprintf(str1,elCount(str1),"%s%s",str1,"  ");
    }
    _WriteEx_and_Report("",str1);
    Fun_Temp = ((Read_2E_DID[1]<<8)|Read_2E_DID[2]);
    UnlockFlage = _Check_Serve(0x22,Fun_Temp,5);
    if(UnlockFlage == 1)
      _unlockECU();
    _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
    _TestResult(SendData,phyreq_ID,"",-1);
    {
      Flage_Read = 0;
      if(diagGetLastResponseCode(SendData) == -1)
      {
        Read_Data_Len =  DiagGetRespPrimitiveSize(SendData);
        Flage_Read = 1;
        for(m=0;m<Read_Data_Len;m++)
          Read_Data[m] = DiagGetRespPrimitiveByte(SendData,m);
      }
    }
    if(UnlockFlage != 1)
      _unlockECU();
    if(DID_2E_SendData_1_Response == -1)
    {
      _Send_Diag_(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(500);
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
      _WriteEx_and_Report("","第一次写入判断完成");
      _Power_Down();
      testWaitForTimeout(2000);
      _Power_Up();
      testWaitForTimeout(3000);
      _SetSession(exsession);
      testWaitForTimeout(200);
      if(UnlockFlage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
      _WriteEx_and_Report("","正常上下电读取判断完成");
      if(UnlockFlage == 1)
        _Set_11_Restoration(0);
      else
        _Set_11_Restoration();
      if(UnlockFlage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
      _WriteEx_and_Report("","11复位读取判断完成");
      _K30_OFF();
      testWaitForTimeout(2000);
      _K30_ON();
      testWaitForTimeout(3000);
      if(UnlockFlage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
      _WriteEx_and_Report("","异常复位读取判断完成");
    }
    else
    {
      _WriteEx_and_Report("","期望结果不为正响应,验证异常写入后值不被改变");
      _Send_Diag_(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,phyreq_ID,"",DID_2E_SendData_1_Response);
      if(Flage_Read == 0)
        _WriteEx_and_Report("","第一次读取时未获取到正确值,不再测试后续部分");
      else
      {
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
        _Power_Down();
        testWaitForTimeout(2000);
        _Power_Up();
        testWaitForTimeout(3000);
        _SetSession(exsession);
        testWaitForTimeout(200);
        if(UnlockFlage == 1)
          _unlockECU();
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
        _WriteEx_and_Report("","正常上下电读取判断完成");
        if(UnlockFlage == 1)
          _Set_11_Restoration(0);
        else
          _Set_11_Restoration();

        if(UnlockFlage == 1)
          _unlockECU();
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
        _WriteEx_and_Report("","11复位读取判断完成");
        _K30_OFF();
        testWaitForTimeout(2000);
        _K30_ON();
        testWaitForTimeout(3000);
        if(UnlockFlage == 1)
          _unlockECU();
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _Check_Response_2E(SendData,Read_Data_Len,Read_Data);
        _WriteEx_and_Report("","异常复位读取判断完成");
      }
    }
    if(UnlockFlage != 1)
      _unlockECU();
    if(DID_2E_SendData_1_Response == -1 && DID_2E_SendData_2_Response == -1)
    {
      _Clear_Config(DID_2E_SendData_1,Session);
      _Send_Diag_(DID_2E_SendData_2_Len,ID,DID_2E_SendData_2);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(500);
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
      _WriteEx_and_Report("","第二次写入判断完成");
    }
    else if(DID_2E_SendData_1_Response != -1 && DID_2E_SendData_2_Response == -1)
    {
      _WriteEx_and_Report("","第一次写入值未成功,验证第二次写入");
      _Clear_Config(DID_2E_SendData_1,Session);
      _Send_Diag_(DID_2E_SendData_2_Len,ID,DID_2E_SendData_2);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(500);
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
      _WriteEx_and_Report("","第二次写入判断完成");
      _Power_Down();
      testWaitForTimeout(2000);
      _Power_Up();
      testWaitForTimeout(3000);
      if(UnlockFlage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
      _WriteEx_and_Report("","正常上下电读取判断完成");
      if(UnlockFlage == 1)
        _Set_11_Restoration(0);
      else
        _Set_11_Restoration();

      if(UnlockFlage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
      _WriteEx_and_Report("","11复位读取判断完成");
      _K30_OFF();
      testWaitForTimeout(2000);
      _K30_ON();
      testWaitForTimeout(3000);
      if(UnlockFlage == 1)
        _unlockECU();
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
      _WriteEx_and_Report("","异常复位读取判断完成");
    }
    else if(DID_2E_SendData_2_Response != -1)
    {
      _Clear_Config(DID_2E_SendData_1,Session);
      _Send_Diag_(DID_2E_SendData_2_Len,ID,DID_2E_SendData_2);
      _TestResult(SendData,ID,"",DID_2E_SendData_2_Response);
    }
  }
  else
  {
    _WriteEx_and_Report("","不支持读取,仅验证写入后正响应");
    _unlockECU();
    _Send_Diag_(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
    _TestResult(SendData,ID,"",-1);
  }
}

/// <DTC_Diag>
/*
  诊断当前故障
*/
_Send_01_Fault(dword ID)
{
  int size,flage,DTC_Count,i;
  dword Byte_H,Byte_M,Byte_L;
  dword DTC[100];
  diagResize(Diag01,3);
  DiagSetPrimitiveByte(Diag01,0,0x19);
  DiagSetPrimitiveByte(Diag01,1,0x2);
  DiagSetPrimitiveByte(Diag01,2,0x1);
  _SendAndWriteReport(Diag01,ID);
  if(diagGetLastResponseCode(Diag01) == 0)
    testWaitForDiagResponse(Diag01,2000);
  flage = diagGetLastResponseCode(Diag01);
  if(flage==0)
    _WriteEx_and_Report("","响应异常");
  else
  {
    size = DiagGetRespPrimitiveSize(Diag01);
    if(size == 3)
    {}
    else
    {
      DTC_Count = (size-3)/4;
      testStep("DTC","共%d个DTC",DTC_Count);
      for(i = 0;i< DTC_Count ; i ++) 
      {      
         Byte_H = (dword)diagGetRespPrimitiveByte(Diag01,i*4 + 3 + 0);
         Byte_M = (dword)diagGetRespPrimitiveByte(Diag01,i*4 + 3 + 1);
         Byte_L = (dword)diagGetRespPrimitiveByte(Diag01,i*4 + 3 + 2);
         DTC[i] = Byte_H<<16 | Byte_M<<8 | Byte_L ;    
         testStep("DTC","第%d个DTC为 0x%06X",i,DTC[i]);
      }
    }
  }
  _WriteEx_and_Report("","诊断当前故障");
}
/// <DTC_Diag>
/*
  诊断历史故障
*/
_Send_09_Fault(dword ID)
{
  diagResize(Diag09,3);
  DiagSetPrimitiveByte(Diag09,0,0x19);
  DiagSetPrimitiveByte(Diag09,1,0x2);
  DiagSetPrimitiveByte(Diag09,2,0x09);
  _SendAndWriteReport(Diag09,ID);
  
  if(diagGetLastResponseCode(Diag09) == 0)
    testWaitForDiagResponse(Diag09,2000);
  _WriteEx_and_Report("","诊断所有故障");
}

/// <DTC_Diag>
_Clear_DTC(dword ID)
{
  int CarSpd_Flage,Ready_Flage;
  float Car_Now,Ready_Now;
  
  CarSpd_Flage = 0;
  Ready_Flage = 0;
  
  if((_Set_NRC22(0x14,0,2)&0x01) != 0)
  {
    Car_Now = _Get_CarSpd();
    if(Car_Now>NRC22_CarSpd)
    {
      CarSpd_Flage = 1;
      _Set_CarSpd(0);
    }
  }
  if((_Set_NRC22(0x14,0,2)&0x20) != 0)
  {
    Ready_Now = _Get_Ready();
    if(Ready_Now == Ready_NRC22)
    {
      Ready_Flage = 1;
      if(Ready_NRC22 == 0)
        _Set_Ready(Struct_Ready.Ready_Active);
      else
        _Set_Ready(0);
    }
  }
  
  diagResize(ClearDTC,4);
  DiagSetPrimitiveByte(ClearDTC,0,0x14);
  DiagSetPrimitiveByte(ClearDTC,1,0xFF);
  DiagSetPrimitiveByte(ClearDTC,2,0xFF);
  DiagSetPrimitiveByte(ClearDTC,3,0xFF);
  _SendAndWriteReport(ClearDTC,ID);
  _TestResult(ClearDTC,ID,"清除故障",-1);
  
  if(CarSpd_Flage == 1)
    _Set_CarSpd(Car_Now);
  if(Ready_Flage == 1)
    _Set_Ready(Ready_Now);
}

/// <DTC_Diag>
_Clear_DTC(dword ID,int Res,char Step[])
{
  int CarSpd_Flage,Ready_Flage;
  float Car_Now,Ready_Now;
  
  CarSpd_Flage = 0;
  Ready_Flage = 0;
  
  if((_Set_NRC22(0x14,0,2)&0x01) != 0)
  {
    Car_Now = _Get_CarSpd();
    if(Car_Now>NRC22_CarSpd)
    {
      CarSpd_Flage = 1;
      _Set_CarSpd(0);
    }
  }
  if((_Set_NRC22(0x14,0,2)&0x20) != 0)
  {
    Ready_Now = _Get_Ready();
    if(Ready_Now == Ready_NRC22)
    {
      Ready_Flage = 1;
      if(Ready_NRC22 == 0)
        _Set_Ready(Struct_Ready.Ready_Active);
      else
        _Set_Ready(0);
    }
  }
  
  diagResize(ClearDTC,4);
  DiagSetPrimitiveByte(ClearDTC,0,0x14);
  DiagSetPrimitiveByte(ClearDTC,1,0xFF);
  DiagSetPrimitiveByte(ClearDTC,2,0xFF);
  DiagSetPrimitiveByte(ClearDTC,3,0xFF);
  _SendAndWriteReport(ClearDTC,ID);
  _TestResult(ClearDTC,ID,Step,Res);
  
  if(CarSpd_Flage == 1)
    _Set_CarSpd(Car_Now);
  if(Ready_Flage == 1)
    _Set_Ready(Ready_Now);
}

/// <DTC_Diag>
/*
  检测85服务中DTC是否存在DTC问题
  Type = 1：发送19 02 01
  Type = 9：发送19 02 09
  DTC = 0：无期望故障，白名单除外
  DTC = xx：期望该DTC存在
*/
_85_Check_DTC(byte Type,dword DTC)
{
  dword DTC_Ex[10];
  
  StepByGeely3_0(0x19,Active);
  if(Type == 1)
    _Send_01_Fault(phyreq_ID);
  else if(Type == 9)
    _Send_09_Fault(phyreq_ID);
  DTC_Ex[0] = DTC;
  if(Type == 1)
    _Check_Response_DTC(Diag01,DTC_Ex);
  else if(Type == 9)
    _Check_Response_DTC(Diag09,DTC_Ex);
}
/// <DTC_Diag>
_Check_DTC(byte Type,dword DTC[])
{
  if(Type == 1)
    _Send_01_Fault(phyreq_ID);
  else if(Type == 9)
    _Send_09_Fault(phyreq_ID);
  if(Type == 1)
    _Check_Response_DTC(Diag01,DTC);
  else if(Type == 9)
    _Check_Response_DTC(Diag09,DTC);
}

/// <DTC_Diag>
/*
  Mask:当前故障或历史故障
*/
_Check_DTC_Mask(diagRequest *Diag,dword DTC_1,dword Mask)
{
  dword size;
  dword i;
  dword DTCread[200];
  dword Buffer_Receive[300];
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,2000);
  if(DiagGetRespPrimitiveSize(Diag)>3)
  {
    size=DiagGetRespPrimitiveSize(Diag);
    if(DiagGetRespPrimitiveByte(Diag,2) != Mask_19)
      testStepFail("","掩码异常，预期为：0x%2X，实际为：0x%2X",Mask_19,DiagGetRespPrimitiveByte(Diag,2));
    for(i=0;i<(size-3);i++)
      Buffer_Receive[i]=DiagGetRespPrimitiveByte(Diag,i+3);
    size=(size-3)/4;
    for(i=0;i<size;i++)
      DTCread[i]=(Buffer_Receive[i*4]<<16)|(Buffer_Receive[i*4+1]<<8)|Buffer_Receive[i*4+2];
    for(i = 0;i<size;i++)
    {
      if(DTC_1 == DTCread[i])
      {
        testStepPass("","预期故障在反馈故障码中");
        if((Buffer_Receive[4*i+3]& Mask) != Mask)
          testStepFail("","当前故障的掩码异常,预期为：0x%2X，实际为：0x%2X",Mask,(Buffer_Receive[4*i+3]& Mask));
        else
          testStepPass("","故障码掩码与预期一致");
        break;
      }
    }
    if(i==size)
      testStepFail("","未诊断到预期故障码");
  }
  else 
    testStepFail("异常","未诊断到故障");
}

/// <DTC_Diag>
DTC_Check_For_bit(diagRequest* Diag,int Count_Num)
{
  int RxSize,Rx_Count,i,Error_Flage;
  dword DTC_Res[100][2];
  byte Send_Mask;
  byte Count_ForEx;
  dword DTC_Ex[50][2];
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    RxSize = DiagGetRespPrimitiveSize(Diag);
    Rx_Count = (RxSize-3)/4;
    Send_Mask = DiagGetPrimitiveByte(Diag,2);
    Error_Flage = 0; Count_ForEx = 0;
    for(i=0;i<DTC_ResList_Count;i++)  //统计并装载所有已有故障的掩码中匹配对应bit位的故障个数
    {
      if((DTC_ResList[i][1]&Send_Mask) != 0)
      {
        DTC_Ex[Count_ForEx][0] = DTC_ResList[i][0];
        DTC_Ex[Count_ForEx][1] = DTC_ResList[i][1];
        Count_ForEx++;
      }
    }
    for(i=0;i<3;i++)
    {
      if(i == 0)
      {
        if(diagGetRespPrimitiveByte(Diag,i) != 0x59)
          testStepFail("前三字节","第%d字节错误，预期为0x%02X,实测为0x%02X",0,0x59,diagGetRespPrimitiveByte(Diag,i));
      }
      else if(i == 2)
      {
        if(diagGetRespPrimitiveByte(Diag,i) != Mask_19)
          testStepFail("前三字节","第%d字节错误，预期为0x%02X,实测为0x%02X",i,Mask_19,diagGetRespPrimitiveByte(Diag,i));
      }
      else
      {
        if(DiagGetPrimitiveByte(Diag,i) != diagGetRespPrimitiveByte(Diag,i))
          testStepFail("前三字节","第%d字节错误，预期为0x%02X,实测为0x%02X",i,DiagGetPrimitiveByte(Diag,i),diagGetRespPrimitiveByte(Diag,i));
      }
    }
    if(Count_Num != -1)
    {
      if(Rx_Count != Count_Num)
        testStepFail("","当前DTC个数与期望不符,期望为 %d 实际为 %d 个",Count_Num,Rx_Count);
      else
        testStepPass("","当前DTC个数与期望一致均为 %d 个",Count_Num);
    }
    for(i=0;i<Rx_Count;i++)
    {
      DTC_Res[i][0] = (diagGetRespPrimitiveByte(Diag,i*4+3+0)<<16) + (diagGetRespPrimitiveByte(Diag,i*4+3+1)<<8)+ (diagGetRespPrimitiveByte(Diag,i*4+3+2));
      DTC_Res[i][1] = diagGetRespPrimitiveByte(Diag,i*4+3+3);
    }
    for(i=0;i<Rx_Count;i++)
    {
      if((DTC_Res[i][1] & Send_Mask) == 0)
      {
        Error_Flage = 1;
        testStepfail("","当前DTC为0x%06X，掩码为0x%02X，发送数据状态位为 0x%02X",DTC_Res[i][0],DTC_Res[i][1],Send_Mask);
      }
    }
    if(Error_Flage == 0)
      testStepPass("","当前返回DTC掩码均符合请求状态位");
    if(Rx_Count != Count_ForEx)
    {
      testStepfail("","当前请求bit位0x%02X返回故障个数与期望不一致，期望为 %d,实际为 %d",Send_Mask,Count_ForEx,Rx_Count);
      for(i=0;i<Count_ForEx;i++)
      {
        if(_Check_Dword_in_Num(DTC_Ex[i][0],DTC_Res,Rx_Count) == -1)
          testStepfail("","故障码0x%06X,对应掩码0x%02X 在请求bit位为0x%02X时，未正常反馈",DTC_Ex[i][0],DTC_Ex[i][1],Send_Mask);
      }
    }
  }
}

/// <DTC_Diag>
Get_DTC_FromRequest(byte MaskSend)
{
  byte DiagSend[3];
  int ResLen,i;
  DiagSend[0] = 0x19;DiagSend[1] = 0x02;DiagSend[2] = MaskSend;
  DTC_ResList_Count = 0;
  _Send_Diag(3,phyreq_ID,DiagSend);
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,1000);
  if(diagGetLastResponseCode(SendData) == -1)
  {
    ResLen = DiagGetRespPrimitiveSize(SendData);
    DTC_ResList_Count = (ResLen-3)/4;
    for(i=0;i<DTC_ResList_Count;i++)
    {
      DTC_ResList[i][0] = (diagGetRespPrimitiveByte(SendData,i*4+3+0)<<16) + (diagGetRespPrimitiveByte(SendData,i*4+3+1)<<8)+ (diagGetRespPrimitiveByte(SendData,i*4+3+2));
      DTC_ResList[i][1] = diagGetRespPrimitiveByte(SendData,i*4+3+3);
    }
  }
}
