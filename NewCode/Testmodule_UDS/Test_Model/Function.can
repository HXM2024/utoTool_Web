/// <Power>
_Power_Down()
{
  /*修改老化板无法上下电问题*/
  _Get_CarSpd();
  _Get_Ready();
  /*-------------------*/
  _Set_CarSpd(0);
  _Set_Ready(0);
  testWaitForTimeout(1000);
  _K15_OFF();
  Session_BIN = 1;
  testWaitForTimeout(K15_OFF_Time);
}
/// <Power>
_Power_Up()
{
  _K15_ON();
  /*修改老化板无法上下电问题*/
  _Set_CarSpd(CarSpd_Now);
  _Set_Ready(Engine_State);
  testWaitForTimeout(1000);
}
/// <Power>
_Power_Down_()
{
  if(Burn_in_Board==1)
    RelayOFF(2);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x01;
    IGON.byte(2)=0x00;
    output (IGON);
    testWaitForTimeout(5);
  } 
  if(Burn_in_Board==1)
    RelayOFF(1);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x27;
    IGON.byte(2)=0x00;
    output (IGON);
  }   
  _WriteEx_and_Report("","下电");
  Session_BIN = 1;
}
/// <Power>
_Power_Up_()
{
  if(Burn_in_Board==1)
    RelayON(1);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x27;
    IGON.byte(2)=0x01;
    output (IGON);
    testWaitForTimeout(5);
  }  
  if(Burn_in_Board==1)
    RelayON(2);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x01;
    IGON.byte(2)=0x01;
    output (IGON);
  } 
  _WriteEx_and_Report("","上电");
}
