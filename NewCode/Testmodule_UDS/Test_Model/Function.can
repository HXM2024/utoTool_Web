/*
    检测NRC是否在31服务对应的例程中
*/
int _Check_NRC_In_31H(dword Fun,byte Control_Type_Pos,byte NRC)
{
  int Return_Value;
  int k,Fun_Pos;
  Return_Value = -1;
  Fun_Pos = -1;
  for(k=0;k<Serve_31_Hex_Count;k++)
  {
    if((Serve_31_Hex[k].Routine[0] == (Fun>>8)) && (Serve_31_Hex[k].Routine[1] == (Fun&0xFF)))
    {
      Fun_Pos = k;
      break;
    }
  }
  if(Fun_Pos == -1)
    return -2;//未查询到RID 提前终止
  for(k=0;k<Serve_31_Hex[Fun_Pos].Serve_NRC_Special_Count[Control_Type_Pos];k++)
  {
    if(Serve_31_Hex[Fun_Pos].Serve_NRC_Special[Control_Type_Pos][k]==NRC)
    {
      Return_Value = k;
    }
  }
  return Return_Value;
}
/*
    检测服务结构体中对应的数据
    Serve ：服务
    Fun ：子功能
    type = 0:检测服务是否支持(未查询到时表明服务不支持,位置为-1返回到外层)
    type = 1:检测服务所支持的寻址方式  (适用与整个服务所有子功能支持寻址方式均一致)
    type = 2:检测服务所支持的会话      (适用与整个服务所有子功能支持寻址方式均一致)
    type = 3:检测服务是否支持肯定响应抑制位      (适用与整个服务所有子功能支持寻址方式均一致)
    type = 4:检测子功能是否支持        (不支持返回-1,支持则返回所在列表位置)
    type = 5:检测子功能是否需要安全访问      (同时需要服务和子功能)
    type = 6:检测子功能对应的NRC列表      (同时需要服务和子功能)
    type = 7:检测子功能对应的NRC22条件      (同时需要服务和子功能)
    type = 8:检测子功能对应的NRC列表      (较为特殊,指定支持31服务,Serve改为对应的控制类型,子功能改为31H结构体中RID)
    type = 9:检测子功能是否支持肯定响应抑制位   
    type = 10:检测31服务对应的RID的控制类型下NRC22条件
    type = 11:检测31服务对应的RID的控制类型下安全访问条件
    type = 12:检测31服务对应的RID所在结构体位置 (指定支持31服务,Serve改为对应的控制类型,子功能改为31H结构体中RID)
*/
int _Check_Serve(byte Serve ,dword Fun,byte type)
{
  int Return_Value,Possion_Serve,Possion_Fun;
  int Check_Fun;
  int k;
  char Common[30];
  snprintf(Common,elCount(Common),"%s","");
  snprintf(Common,elCount(Common),"0x%02X服务",Serve);
  snprintf(Common,elCount(Common),"%s0x%02X子功能",Common,Fun);
  Possion_Serve = -1;
  Possion_Fun = -1;
  Fun = (word)Fun;
  for(k=0;k<Serve_Data_Count;k++)
  {
    if(Serve_Data[k].Serve==Serve)
    {
      Possion_Serve = k;  //查询服务所在结构体位置
      break;
    }
  }
  if( (type!=0) && (Possion_Serve==-1) && (type != 8) && (type != 10)&& (type != 11)&& (type != 12))
    return -1;//未查询到服务 提前终止
  if(type == 8 || type == 10 || type == 11 || type == 12)
  {
    for(k=0;k<Serve_31_Hex_Count;k++)
    {
      if((Serve_31_Hex[k].Routine[0] == (Fun>>8)) && (Serve_31_Hex[k].Routine[1] == (Fun&0xFF)))
      {
        Possion_Serve = k;
        break;
      }
    }
    if(Possion_Serve == -1)
      return -1;//未查询到RID 提前终止
    for(k=0;k<Serve_31_Hex[Possion_Serve].Control_Type_Count;k++)
    {
      if(Serve == Serve_31_Hex[Possion_Serve].Control_Type[k])
      {
        Possion_Fun = k;
        break;
      }
    }
    if(Possion_Fun == -1)
      return -1;//未查询到控制类型 提前终止
  }
  else if(type == 0)
  {
    /*仅检测服务，不做其他操作*/
  }
  else
  {
    for(k=0;k<Serve_Data[Possion_Serve].Serve_Fun_Count;k++)
    {
      if(Serve_Data[Possion_Serve].Serve_Fun[k]==Fun)
      {
        Possion_Fun = k;  //查询子功能所在列表位置
        break;
      }
    }
  }
  if(Fun == 0 && type != 4)  //未输入子功能默认选择第0个子功能,当检测子功能是否支持情况时除外
    Check_Fun = 0;
  else if(Fun>0)
    Check_Fun = Possion_Fun;
  if(((type>=5 && type< 8) || type == 9 ) && Possion_Fun == -1)
  {
    _WriteEx_and_Report(Common,"子功能不支持");
    return -1;//未查询到子功能 提前终止
  }
  if(type == 8)
  {
    snprintf(Common,elCount(Common),"%s","");
    snprintf(Common,elCount(Common),"31服务 0x%X RID",Fun);
    _WriteEx_and_Report(Common,"NRC列表");
  }
  if(type==0)
    Return_Value = Possion_Serve;  //返回结构体中所在位置
  else if(type==1)
    Return_Value = Serve_Data[Possion_Serve].Serve_Addres[Check_Fun];   //  Return_Value & 检测值 != 0即表示支持该寻址
  else if(type==2)
    Return_Value = Serve_Data[Possion_Serve].Serve_Session[Check_Fun];
  else if(type==3)
    Return_Value = Serve_Data[Possion_Serve].RSP[Check_Fun];
  else if(type==4)
    Return_Value = Possion_Fun;
  else if(type==5)
    Return_Value = Serve_Data[Possion_Serve].Security_Access[Check_Fun];
  else if(type==6)
  {
    for(k=0;k< Serve_Data[Possion_Serve].Serve_NRC_Count[Check_Fun];k++)
      Fun_NRC[k] = Serve_Data[Possion_Serve].Serve_NRC[Check_Fun][k];
    Fun_NRC_Count = Serve_Data[Possion_Serve].Serve_NRC_Count[Check_Fun];
    Return_Value = 1;
  }
  else if(type==7)
  {
    Return_Value = Serve_Data[Possion_Serve].Serve_NRC22[Check_Fun];
  }
  else if(type==8)
  {
    for(k=0;k< Serve_31_Hex[Possion_Serve].Serve_NRC_Count[Possion_Fun];k++)
    {
      Fun_NRC[k] = Serve_31_Hex[Possion_Serve].Serve_NRC[Possion_Fun][k];
    }
    Fun_NRC_Count = Serve_31_Hex[Possion_Serve].Serve_NRC_Count[Possion_Fun];
    Return_Value = 1;
  }
  else if(type==9)
    Return_Value = Serve_Data[Possion_Serve].RSP[Check_Fun];
  else if(type==10)
    Return_Value = Serve_31_Hex[Possion_Serve].Serve_NRC22[Possion_Fun];
  else if(type==11)
    Return_Value = Serve_31_Hex[Possion_Serve].Security_Access[Possion_Fun];
  else if(type==12)
    Return_Value = Possion_Serve;
  
  return Return_Value;
}

/// <NRC22_Loop>
/*
  Serve : 服务
  Fun_Pos : 功能所在位置
  Add : 寻址
  Session : 会话
  Type : 0:自动化测试部分 1:手动测试
*/
_NRC22_Test_Loop(int Serve,dword Fun_Pos,dword ID,byte Session,byte Type)
{
  byte Send_Data[500];
  dword Send_Len;
  byte Tar_NRC22;
  int m,n,Auto_Loop_22,Communication,Communication_Max;
  int Serve_Pos,IsNRC22;
  char Step_Write[50];
  int Special,Loop_RSP,Flage_Rsp_In,Check_Rsp,State_UnLock;
  Special = 0;
  _Clear_SendData(Send_Data);
  Send_Data[0] = Serve;
  Loop_RSP = 1;
  Check_Rsp = 0;
  _Get_NRC_Mapping(Serve);
  snprintf(Step_Write,elCount(Step_Write),"0x%02X",Serve);
  {
    if(Serve != 0x31)
    {
      Serve_Pos = _Check_Serve(Serve,0,0);
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos]; // 装载子功能
      Send_Len = Serve_Data[Serve_Pos].Serve_Fun_Len[Fun_Pos]; // 装载发送长度
      Tar_NRC22 = Serve_Data[Serve_Pos].Serve_NRC22[Fun_Pos]; // 装载NRC22条件
      State_UnLock = Serve_Data[Serve_Pos].Security_Access[Fun_Pos];
      if(Serve_Data[Serve_Pos].RSP[Fun_Pos] == 1)
      {
        Loop_RSP = 2;
        Check_Rsp = 1;
      }
      snprintf(Step_Write,elCount(Step_Write),"%s 0x%02X",Step_Write,Send_Data[1]);
      if(Send_Data[0] == 0x14)
      {
        Send_Data[1] = 0xFF;Send_Data[2] = 0xFF;Send_Data[3] = 0xFF;
      }
      else if(Send_Data[0] == 0x22)
      {
        Send_Data[1] = (Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos]>>8);
        Send_Data[2] = (Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos]&0xFF);
        snprintf(Step_Write,elCount(Step_Write),"0x%02X 0x%02X 0x%02X",Serve,Send_Data[1],Send_Data[2]);
      }
      else if(Send_Data[0] == 0x2E)
      {
        dword Fun;
        int Fun_Pos_Ser;
        _get_2E_DID(Traversal_DID[Fun_Pos]);
        Send_Len = DID_2E_SendData_1_Len;
        Send_Data[1] = DID_2E_SendData_1[1];
        Send_Data[2] = DID_2E_SendData_1[2];
        Fun = ((Send_Data[1]<<8) | Send_Data[2]);
        Fun_Pos_Ser = _Check_Serve(Serve,Fun,4);
        Tar_NRC22 = Serve_Data[Serve_Pos].Serve_NRC22[Fun_Pos_Ser];
        snprintf(Step_Write,elCount(Step_Write),"0x%02X 0x%02X 0x%02X",Serve,Send_Data[1],Send_Data[2]);
        for(m=0;m<Send_Len;m++)
          Send_Data[m] = DID_2E_SendData_1[m];
      }
    }
    else
    {
      Send_Data[1] = Serve_31_Hex[Fun_Pos].Control_Type[0];
      Send_Data[2] = Serve_31_Hex[Fun_Pos].Routine[0];
      Send_Data[3] = Serve_31_Hex[Fun_Pos].Routine[1];
      Send_Len = Serve_31_Hex[Fun_Pos].Routine_Len;
      State_UnLock = Serve_31_Hex[Fun_Pos].Security_Access[0];
      NRC22_Loop_FunPos = Fun_Pos;
      if(Serve_31_Hex[Fun_Pos].Control_Type_RSP[0] == 1)
      {
        Loop_RSP = 2;
        Check_Rsp = 1;
      }
      Serve_31_NewNRC22 = (Serve_31_Hex[Fun_Pos].Serve_NRC_Special_Count[0] != 0)?1:0;
      snprintf(Step_Write,elCount(Step_Write),"%s 0x%02X 0x%02X 0x%02X",Step_Write,Send_Data[1],Send_Data[2],Send_Data[3]);
      if(Serve_31_Hex[Fun_Pos].Control_Option_Count[0]  != 0)
      {
        Send_Data[4] = Serve_31_Hex[Fun_Pos].Control_Option[0][0];
        snprintf(Step_Write,elCount(Step_Write),"%s 0x%02X",Step_Write,Send_Data[4]);
      }
      Tar_NRC22 = Serve_31_Hex[Fun_Pos].Serve_NRC22[0]; 
    }
    
    Flage_Rsp_In = _Check_Dword_in_Num(Serve,NRC22_Loop_Rsp,NRC22_Loop_Rsp_Count);/*判断是否检测肯定响应抑制位*/
    if(Flage_Rsp_In == -1 && NRC22_Loop_Rsp_Count!= 0)
    {
      int Rsp_In;
      Loop_RSP = 1;
      Rsp_In = _Check_Dword_in_Num(Serve,NRC22_Loop_Fun_Pos,NRC22_Loop_Fun_Pos_Count);
      if(Rsp_In!= -1)
      {
        if((NRC22_Loop_Fun_Pos[Rsp_In][2] == 1) && (Check_Rsp == 1))
          Loop_RSP = 2;
        else
          Loop_RSP = 1;
      }
    }
    
    Communication_Max = (Send_Data[0] == 0x28)?Serve_Data[Serve_Pos].Serve_Para_Count[Fun_Pos]:1;// 28服务测试所有通讯类型
    for(n=0;n<Loop_RSP;n++)
    {
      if(n==1)
      {
        Send_Data[1] = Send_Data[1]|0x80;
        _WriteEx_and_Report("","-----------------------");
        _WriteEx_and_Report(Step_Write,"肯定响应抑制位测试");
        _WriteEx_and_Report("","-----------------------");
      }
      if((Send_Data[0] == 0x10) && ((Send_Data[1]&0x0F) == 0x02))
        Special = 1;//10 02特殊处理部分
      else if(Send_Data[0] == 0x11)
        Special = 2;
      else if(Send_Data[0] == 0x28 && (((Send_Data[1]&0x0F)==0x02) || ((Send_Data[1]&0x0F)==0x03)))
        Special = 3;
      else if(Send_Data[0] == 0x85 && (Send_Data[1]&0x0F)==0x02)
        Special = 3;
      else if(Send_Data[0] == 0x31 && NRC22_Loop_Serve_31 == 1)  //遍历全部控制类型
        Special = 4;
      if(Type == 0)
      {
        Auto_Loop_22 = 4;
        if(Set_Battery_RS232 == 1)
          Auto_Loop_22=5;
        for(Communication = 0;Communication < Communication_Max; Communication++)
        {
          if(Send_Data[0] == 0x28)
            Send_Data[2] = Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][Communication];
          for(m=1;m<Auto_Loop_22;m++) 
          {
            if(NRC22_Select_Count != 0 && _Check_Dword_in_Num(m,NRC22_Select,NRC22_Select_Count) == -1)
              continue;
            _SetSession(defsession);
            if(Session != defsession)
              _SetSession(exsession);    /*会话切换防止上一次干扰*/
            if(Serve == 0x31 || Serve == 0x2E)
            {
              _Send_Key(SendKey_Len,phyreq_ID,_get_seed(phyreq_ID),0);
              _TestResult(SendData,phyreq_ID,"",-1);
              Get_Seed_Flage = 1;
              if(Serve == 0x31)
              {
                int Res;
                Res = (n == 1)?0:(-1);
                _Send_Diag(Send_Len,ID,Send_Data);
                _TestResult(SendData,ID,"",Res);
                writeEx(-3,0,"优先发送一次确保正响应，后续发送检测RID结果时能够正常测试到NRC22条件");
                testWaitForTimeout(500);
              }
            }
            testWaitForTimeout(100);
            if(m==0x01)//NRC22_车速
            {
              IsNRC22 = ((Tar_NRC22 & 0x1)!=0)?1:0;
              _NRC22_CarSpd(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special,n,State_UnLock);
            }
            if(m==0x02)//NRC22_档位
            {
              IsNRC22 = ((Tar_NRC22 & 0x8)!=0)?1:0;
              _NRC22_Gears(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special,n,State_UnLock);
            }
            if(m==0x03)//NRC22_发动机
            {
              IsNRC22 = ((Tar_NRC22 & 0x20)!=0)?1:0;
              _NRC22_Ready(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special,n,State_UnLock);
            }
            if(m==0x04)//NRC22_电压
            {
              IsNRC22 = ((Tar_NRC22 & 0x02)!=0)?1:0;
              _NRC22_Battery(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special,n,State_UnLock);
            }
          }
        }
      }
      else if(Type == 1)
      {
        Auto_Loop_22 = 2;
        if(Set_Battery_RS232 == 0)
          Auto_Loop_22=3;
        for(m=0;m<Auto_Loop_22;m++)
        {
          _SetSession(defsession);
          if(Session != defsession)
            _SetSession(exsession);    /*会话切换防止上一次干扰*/
          if(Serve == 0x31)
          {
            _Send_Key(SendKey_Len,phyreq_ID,_get_seed(phyreq_ID),0);
            _TestResult(SendData,phyreq_ID,"",-1);
            Get_Seed_Flage = 1;
          }
          if(m==0)//NRC22_力矩      /*暂时屏蔽无力矩条件导致的NRC22情况下进行力矩相关测试*/
          {
            if((Tar_NRC22 & 0x02)!=0)
              _NRC22_Torque(Send_Data,Send_Len,ID,Session,Step_Write,1,Special,n,State_UnLock);
          }
          else if(m==2)//NRC22_电压    /*暂时屏蔽无电压条件导致的NRC22情况下进行力矩相关测试*/
          {
            if((Tar_NRC22 & 0x04)!=0)
              _NRC22_Battery(Send_Data,Send_Len,ID,Session,Step_Write,1,Special,n,State_UnLock);
          }
        }
      }
    }
  }
}
/// <NRC22_Loop>
/*
    自动化测试NRC22车速条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
    Rsp:是否为肯定响应抑制位
*/
_NRC22_CarSpd(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special,int Rsp,int UnLock_State)
{
  byte Temp_NRC22_HigCar;
  byte Temp_NRC22_InCar;
  int Response;
  dword Fun;
  int Flage_31,i;
  Temp_NRC22_HigCar = CarSpd_NRC;
  Temp_NRC22_InCar = CarSpd_Invalid_NRC;
  Flage_31 = 0;
  _WriteEx_and_Report("","-----------------------");
  _WriteEx_and_Report("","NRC22_车速测试");
  _WriteEx_and_Report("","-----------------------");
  if((Send_Data[0] == 0x31) && (Serve_31_NewNRC22 == 1) && (Tpye == 1))
  {
    Fun = ((Send_Data[2]<<8) | (Send_Data[3]));
    Temp_NRC22_HigCar = (_Check_NRC_In_31H(Fun,0,0x88) != -1)?0x88 : -1;
    Temp_NRC22_InCar = (_Check_NRC_In_31H(Fun,0,0xF2) != -1)?0xF2 : -1;
    Flage_31 = 1;
  }
  Response = (Rsp == 0)? -1:0;
  if(Special == 1)
    _Other_1002();
  if(UnLock_State == 1)
  {
    if((Special != 1) || (Special==1 && Other_1002==1 && ((Unlock_1002 == 1) || ((Unlock_1002==0) && Pre_Programmed_1002==1 && Pre_Programmed_UnlockECU==1))))
      _unlockECU();
  }
  
  if(Flage_31 == 0)
  {
    _WriteEx_and_Report("步骤1","设置车速 > NRC22车速");
    _Set_CarSpd(NRC22_CarSpd+1);
    if(Tpye == 0)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Response);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    }
    else if(Tpye == 1)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Temp_NRC22_HigCar);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    }
    _WriteEx_and_Report("步骤2","设置车速 = NRC22车速");
    _Set_CarSpd(NRC22_CarSpd);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    _WriteEx_and_Report("步骤3","设置车速 > NRC22车速，再丢失车速");
    _Set_CarSpd(NRC22_CarSpd+1);
    testWaitForTimeout(300);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    _Set_CarSpd(0);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.3);
    _WriteEx_and_Report("步骤4","设置车速 > NRC22车速，再无效车速");
    _Set_CarSpd(NRC22_CarSpd+1);
    for(i=0;i<Struct_CarSpd.Invalid_Value_Count;i++) //无效值遍历
    {
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[i]);
      if(Special == 1)
        testWaitForTimeout(200);  /*出现仅在1002会话下车速无效故障报出时间不够问题,故此处延长200ms*/
      _Send_Diag(Send_Len,ID,Send_Data);
      if(Geely3_Flage == 1)
        _TestResult(SendData,ID,Step,Temp_NRC22_InCar);
      else
        _TestResult(SendData,ID,Step,Response);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
      _Reset_CarSpd_Invalid();
      testWaitForTimeout(500);
    }
    _Set_CarSpd(0);
    testWaitForTimeout(500);
  }
  else
  {
    _WriteEx_and_Report("步骤1","设置车速 > NRC22车速");
    _Set_CarSpd(NRC22_CarSpd+1);
    if(Tpye == 0)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Response);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    }
    else if(Tpye == 1)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Temp_NRC22_HigCar);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    }
    _WriteEx_and_Report("步骤2","设置车速 = 0车速，再丢失车速");
    _Set_CarSpd(0);
    testWaitForTimeout(100);
    _TestDisableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.1);
    _Send_Diag(Send_Len,ID,Send_Data);
    if(Tpye == 0)
      _TestResult(SendData,ID,Step,Response);
    else if(Tpye == 1)
      _TestResult(SendData,ID,Step,Temp_NRC22_InCar);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    _WriteEx_and_Report("步骤3","设置车速丢失恢复，再无效车速");
    _TestEnableMsg(Struct_CarSpd.Sig_Id);
    testWaitForTimeout(Struct_CarSpd.Lost_Time*1.1);
    _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
    if(Special == 1)
      testWaitForTimeout(200);  /*出现仅在1002会话下车速无效故障报出时间不够问题,故此处延长200ms*/
    _Send_Diag(Send_Len,ID,Send_Data);
    if(Geely3_Flage == 1)
      _TestResult(SendData,ID,Step,Temp_NRC22_InCar);
    else 
      _TestResult(SendData,ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    _Reset_CarSpd_Invalid();
    _Set_CarSpd(0);
    testWaitForTimeout(500);
  }
}
/// <NRC22_Loop>
/*
    自动化测试NRC22档位条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
    Rsp:是否为肯定响应抑制位
*/
_NRC22_Gears(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special,int Rsp,int UnLock_State)
{
  byte Temp_NRC22;
  byte Temp_14[4] = {0x14,0xFF,0xFF,0xFF};
  byte Temp_27[2] = {0x27,0x01};
  int j;
  int Response;
  Temp_NRC22 = Gear_NRC;
  Temp_27[1] = RequestSeed_27;
  if(Gears_ID != 0 && strncmp(Gears_Signal,"NULL",strlen(Gears_Signal)) != 0)
  {
    _WriteEx_and_Report("","-----------------------");
    _WriteEx_and_Report("","NRC22_档位测试");
    _WriteEx_and_Report("","-----------------------");
    Response = (Rsp == 0)? -1:0;
    if(Special == 1)
      _Other_1002();
    if(UnLock_State == 1)
    {
      if((Special != 1) || (Special==1 && Other_1002==1 && ((Unlock_1002 == 1) || ((Unlock_1002==0) && Pre_Programmed_1002==1 && Pre_Programmed_UnlockECU==1))))
        _unlockECU();
    }
    _WriteEx_and_Report("步骤1","设置档位为非正常档位");
    for(j=NRC_22_Gears_Range[0];j<NRC_22_Gears_Range[1];j++)
    {
      if(j==NRC_22_Gears_Normal)
        continue;
      
      _Set_Gears(j);
      if(Tpye == 0)
      {
        _Send_Diag(Send_Len,ID,Send_Data);
        _TestResult(SendData,phyreq_ID,Step,Response);
       _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
      }
      else if(Tpye == 1)
      {
        _Send_Diag(Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,Step,Temp_NRC22);
        _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
      }
    }
      _WriteEx_and_Report("步骤2","丢失档位");
      _TestDisableMsg(Gears_ID);
      testWaitForTimeout(1000);
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Response);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
      _TestEnableMsg(Gears_ID);
      testWaitForTimeout(1000);
      _WriteEx_and_Report("步骤3","设置档位为正常档位");
      _Set_Gears(NRC_22_Gears_Normal);
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Response);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
      testWaitForTimeout(500);
  }
  else
    writeEx(-3,0,"未输入档位条件,跳过测试");
}
/// <NRC22_Loop>
/*
    自动化测试NRC22发动机条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
    Rsp:是否为肯定响应抑制位
*/
_NRC22_Ready(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special,int Rsp,int UnLock_State)
{
  byte Temp_NRC22;
  byte Temp_14[4] = {0x14,0xFF,0xFF,0xFF};
  byte Temp_27[2] = {0x27,0x01};
  int Response,i;
  Temp_NRC22 = Ready_NRC;
  if((Send_Data[0] == 0x31) && (Serve_31_NewNRC22 == 1) && (Tpye == 1))
    Temp_NRC22 = 0x84;
  Temp_27[1] = RequestSeed_27;
  _WriteEx_and_Report("","-----------------------");
  _WriteEx_and_Report("","NRC22_发动机测试");
  _WriteEx_and_Report("","-----------------------");
  
  Response = (Rsp == 0)? -1:0;
  if(Special == 1)
    _Other_1002();
  if(UnLock_State == 1)
  {
    if((Special != 1) || (Special==1 && Other_1002==1 && ((Unlock_1002 == 1) || ((Unlock_1002==0) && Pre_Programmed_1002==1 && Pre_Programmed_UnlockECU==1))))
      _unlockECU();
  }
  _WriteEx_and_Report("步骤1","设置发动机满足NRC22条件");
  _Set_Ready(Ready_NRC22);
  if(Tpye == 0)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,phyreq_ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  }
  else if(Tpye == 1)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Temp_NRC22);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  }
  
  _WriteEx_and_Report("步骤2","丢失发动机信号");
  _TestDisableMsg(Struct_Ready.Sig_Id);
  testWaitForTimeout(1000);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,Response);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  _TestEnableMsg(Struct_Ready.Sig_Id);
  testWaitForTimeout(1000);
  if(strlen(Struct_Ready.ReadyInvalid_Sig) == 0)
  {
    _WriteEx_and_Report("","无发动机无效相关测试");
    return;
  }
  _WriteEx_and_Report("步骤3","设置发动机无效");
  _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Invalid_Value[0]);
  testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,Response);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
  testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
  _WriteEx_and_Report("步骤4","设置发动机到正常状态");
  for(i=0;i<Struct_Ready.Ready_ValueRange_Count;i++)
  {
    if(Struct_Ready.Ready_ValueRange[i] == Ready_NRC22) //跳过NRC22发动机条件
      continue;
    _Set_Ready(Struct_Ready.Ready_ValueRange[i]);
    _Set_Sig(Struct_Ready.ReadyInvalid_Sig,Struct_Ready.Normal_Value[0]);
    testWaitForTimeout(Struct_Ready.Invalid_Time*1.2);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    testWaitForTimeout(500);
  }
  _Set_Ready(0);
}
/// <NRC22_Loop>
/*
    自动化测试NRC22电压条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
    Rsp:是否为肯定响应抑制位
*/
_NRC22_Battery(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special,int Rsp,int UnLock_State)
{
  byte Temp_NRC22_Hig,Temp_NRC22_Low;
  byte Temp_14[4] = {0x14,0xFF,0xFF,0xFF};
  byte Temp_27[2] = {0x27,0x01};
  int Response;
  Temp_NRC22_Hig = H_Battery_NRC;
  Temp_NRC22_Low = L_Battery_NRC;
  if((Send_Data[0] == 0x31) && (Serve_31_NewNRC22 == 1)&& (Tpye == 1))
  {
    Temp_NRC22_Hig = 0x92;
    Temp_NRC22_Low = 0x93;
  }
  Temp_27[1] = RequestSeed_27;
  _WriteEx_and_Report("","-----------------------");
  _WriteEx_and_Report("","NRC22_电压测试");
  _WriteEx_and_Report("","-----------------------");
  
  Response = (Rsp == 0)? -1:0;
  if(Special == 1)
    _Other_1002();
  if(UnLock_State == 1)
  {
    if((Special != 1) || (Special==1 && Other_1002==1 && ((Unlock_1002 == 1) || ((Unlock_1002==0) && Pre_Programmed_1002==1 && Pre_Programmed_UnlockECU==1))))
      _unlockECU();
  }
  _WriteEx_and_Report("步骤1","设置电压 > NRC22高压");
  _Set_Battery(NRC22_Battery_Hight+0.2);
  if(Tpye == 0)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,phyreq_ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  }
  else if(Tpye == 1)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Temp_NRC22_Hig);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  }
  _WriteEx_and_Report("步骤2","设置电压 < NRC22高压");
  _Set_Battery(NRC22_Battery_Hight-0.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,Response);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  _WriteEx_and_Report("步骤3","设置电压 < NRC22低压");
  _Set_Battery(NRC22_Battery_Low-0.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  if(Tpye == 0)
  {
    _TestResult(SendData,phyreq_ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  }
  else if(Tpye == 1)
  {
    _TestResult(SendData,ID,Step,Temp_NRC22_Low);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  }
  _WriteEx_and_Report("步骤4","设置电压 > NRC22低压");
  _Set_Battery(NRC22_Battery_Low+0.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,Response);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
  testWaitForTimeout(500);
  _Set_Battery(12);
  testWaitForTimeout(500);
}

/// <NRC22_Loop>
/*
    自动化测试NRC22力矩条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
    Rsp:是否为肯定响应抑制位
*/
_NRC22_Torque(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special,int Rsp,int UnLock_State)
{
  byte Temp_NRC22;
  byte Temp_14[4] = {0x14,0xFF,0xFF,0xFF};
  byte Temp_27[2] = {0x27,0x01};
  int Response,LeftAndRight;
  char Str_[200];
  Temp_NRC22 = TasTorque_NRC;
  
  Temp_27[1] = RequestSeed_27;
  _WriteEx_and_Report("","-----------------------");
  _WriteEx_and_Report("","NRC22_力矩测试");
  _WriteEx_and_Report("","-----------------------");
  
  Response = (Rsp == 0)? -1:0;
  if(Special == 1)
    _Other_1002();
  if(UnLock_State == 1)
  {
    if((Special != 1) || (Special==1 && Other_1002==1 && ((Unlock_1002 == 1) || ((Unlock_1002==0) && Pre_Programmed_1002==1 && Pre_Programmed_UnlockECU==1))))
      _unlockECU();
  }
  diagStartTesterPresent(Cdd_Name);
  for(LeftAndRight = 0;LeftAndRight<2;LeftAndRight++) //左右
  {
    _WriteEx_and_Report("步骤1","控制力矩满足NRC22条件,并保持");
    snprintf(Str_,elCount(Str_),"%s","");
    if(LeftAndRight==0)
      snprintf(Str_,elCount(Str_),"左侧，控制力矩满足NRC22条件,大于 %.2f Nm,并保持",NRC22_TasTorque+0.2);
    else
      snprintf(Str_,elCount(Str_),"右侧，控制力矩满足NRC22条件,大于 %.2f Nm,并保持",(NRC22_TasTorque+0.2)*(-1));
    testWaitForTesterConfirmation(Str_,30000);
    if(Tpye == 0)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,phyreq_ID,Step,Response);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    }
    else if(Tpye == 1)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Temp_NRC22);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    }
    _WriteEx_and_Report("步骤2","控制力矩不满足NRC22条件",NRC22_TasTorque);
    if(LeftAndRight==0)
      snprintf(Str_,elCount(Str_),"左侧，控制力矩不满足NRC22条件,小于 %.2f Nm,并保持",NRC22_TasTorque-0.2);
    else
      snprintf(Str_,elCount(Str_),"右侧，控制力矩不满足NRC22条件,小于 %.2f Nm,并保持",(NRC22_TasTorque-0.2)*(-1));
    testWaitForTesterConfirmation(Str_,30000);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Response);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session,Rsp,UnLock_State,ID);
    snprintf(Str_,elCount(Str_),"松开方向盘");
    testWaitForTesterConfirmation(Str_,30000);
    testWaitForTimeout(1000);
  }
  diagStopTesterPresent(Cdd_Name);
}
/// <NRC22_Loop>
/*
    用于统一NRC22时的特殊处理
    Code ：-1：上一次请求响应情况
    Special：特殊情况
    St：打印
    Session： 会话
    ID；发送ID
    Rsp:是否为肯定响应抑制位
*/
void _Special_Step(int Code,byte Special,char St[],byte Session,int Rsp,int UnLock_State,dword ID)
{
  byte Temp_27[2] = {0x27,0x01};
  int Response,Loop;
  Temp_27[1] = RequestSeed_27;
  
  if((Code == -1) || (Code == 0 && Rsp == 1))
  {
    if(Special == 1)
    {
      testWaitForTimeout(1000);
      _Clear_DTC(phyreq_ID,0x11,St);
      _Send_And_Check_NowSession(phyreq_ID,2); 
      _SetSession(defsession);
      testWaitForTimeout(1000);
      if(Session_BIN !=4 && Session==exsession)
        _SetSession(exsession);
      _Other_1002();
    }
    else if(Special == 2)
    {
      testWaitForTimeout(2000);
      _Send_Diag(2,phyreq_ID,Temp_27);
      _TestResult(SendData,phyreq_ID,St,0x7F);
      _Send_And_Check_NowSession(phyreq_ID,defsession); 
      testWaitForTimeout(200);
      if(UnLock_State == 1)
        _unlockECU();
      else
        _SetSession(Session);
    }
    else if(Special == 3)
    {
      testWaitForTimeout(200);
      _SetSession(defsession);
      _SetSession(Session);
      testWaitForTimeout(200);
    }
    else if(Special == 4)
    {
      byte Send_31_Data[10];
      int Send_Len_Last;
      testWaitForTimeout(200);
      Send_Len_Last = DiagGetPrimitiveSize(SendData);
      for(Loop = 0;Loop<Send_Len_Last;Loop++)
        Send_31_Data[Loop] = DiagGetPrimitiveByte(SendData,Loop);
      for(Loop = 1;Loop<Serve_31_Hex[NRC22_Loop_FunPos].Control_Type_Count;Loop++)
      {
        Send_31_Data[1] = Serve_31_Hex[NRC22_Loop_FunPos].Control_Type[Loop];
        if(Rsp == 1)
          Send_31_Data[1]|=0x80;
        _Send_Diag(Send_Len_Last,ID,Send_31_Data);
        _TestResult(SendData,ID,St,Code);
        testWaitForTimeout(200);
      }
    }
  }
  else if(Code > 0)
  {
    if(Special == 1)
    {
      testWaitForTimeout(1000);
      _Clear_DTC(phyreq_ID,-1,St);
      _Send_And_Check_NowSession(phyreq_ID,Session); 
    }
    else if(Special == 2)
    {
      testWaitForTimeout(2000);
      _Send_Diag(2,phyreq_ID,Temp_27);
      if(Session == exsession)
        _TestResult(SendData,phyreq_ID,St,-1);
      else
        _TestResult(SendData,phyreq_ID,St,0x7F);
      _Send_And_Check_NowSession(phyreq_ID,Session); 
      _SetSession(defsession);
      testWaitForTimeout(200);
      if(UnLock_State == 1)
        _unlockECU();
      else
        _SetSession(Session);
      testWaitForTimeout(200);
    }
    else if(Special == 3)
    {
//      _SetSession(defsession); //上一次消极响应情况下可不在进行重新复位
//      _SetSession(Session);
      testWaitForTimeout(200);
    }
    else if(Special == 4)
    {
      byte Send_31_Data[10];
      int Send_Len_Last;
      testWaitForTimeout(200);
      Send_Len_Last = DiagGetPrimitiveSize(SendData);
      for(Loop = 0;Loop<Send_Len_Last;Loop++)
        Send_31_Data[Loop] = DiagGetPrimitiveByte(SendData,Loop);
      for(Loop = 1;Loop<Serve_31_Hex[NRC22_Loop_FunPos].Control_Type_Count;Loop++)
      {
        Send_31_Data[1] = Serve_31_Hex[NRC22_Loop_FunPos].Control_Type[Loop];
        if(Rsp == 1)
          Send_31_Data[1]|=0x80;
        _Send_Diag(Send_Len_Last,ID,Send_31_Data);
        _TestResult(SendData,ID,St,Code);
        testWaitForTimeout(200);
      }
    }
  }
}

int Frame_Loop_Save(int FixDataSave_Pos,int Error_Type_Pos,byte GetData[],int Index_Save,dword AllFrameData[],int FrameCount)
{
  int Count,Temp_Count,i,sig,frame;
  int SigCount;
  const MaxSave = 8;
  Temp_Count = Index_Save;
  SigCount = FixDataSave[FixDataSave_Pos].SigSaveCount[Error_Type_Pos];
  //按信号遍历：同一个信号在所有帧中的值连续装载
  for(sig=0;sig<SigCount;sig++)
  {
    if(FixDataSave[FixDataSave_Pos].OccupancyByte[Error_Type_Pos][sig] == 1) //占用1Byte
    {
      //判断下一个信号是否也为1Byte，若是则两个组合按帧交错装载
      if(sig+1 < SigCount && FixDataSave[FixDataSave_Pos].OccupancyByte[Error_Type_Pos][sig+1] == 1)
      {
        //连续两个1Byte信号，按帧交错：S1_f0,S2_f0,S1_f1,S2_f1,...
        for(frame=0;frame<FrameCount;frame++)
        {
          GetData[Temp_Count] = AllFrameData[frame*SigCount+sig]&0xFF;
          Temp_Count++;
          GetData[Temp_Count] = AllFrameData[frame*SigCount+(sig+1)]&0xFF;
          Temp_Count++;
        }
        sig++;  //下一个信号已在此处理，跳过
      }
      else
      {
        //单个1Byte信号，每帧前补0：0,S_f0,0,S_f1,...
        for(frame=0;frame<FrameCount;frame++)
        {
          GetData[Temp_Count] = 0;
          Temp_Count++;
          GetData[Temp_Count] = AllFrameData[frame*SigCount+sig]&0xFF;
          Temp_Count++;
        }
      }
    }
    else if(FixDataSave[FixDataSave_Pos].OccupancyByte[Error_Type_Pos][sig] == 2) //占用2Byte
    {
      //同一个信号的所有帧值连续装载，每帧高字节在前低字节在后
      for(frame=0;frame<FrameCount;frame++)
      {
        GetData[Temp_Count] = (AllFrameData[frame*SigCount+sig]>>8)&0xFF;
        Temp_Count++;
        GetData[Temp_Count] = AllFrameData[frame*SigCount+sig]&0xFF;
        Temp_Count++;
      }
    }
  }
  return Temp_Count;
}


/*
  根据DTC匹配故障配置，制造故障并装载冻结帧数据(装载逻辑同Frame_Sig_Error/Frame_Loop_Save)
  DTC_Set:   需匹配的DTC
  ErrorFrame: 故障制造帧数(故障成熟帧)
  ErrorBefor: 故障前正常采集帧数
  ErrorAfter:  故障成熟后恢复采集正常帧数
  DataGet:   装载结果(byte型)
  返回值: 装载的总字节数；未匹配到DTC返回0
*/
int DataGet_ByDTC(dword DTC_Set, byte ErrorFrame1, int ErrorBefor, int ErrorAfter, byte DataGet[])
{
  int node,idx,frame,sig,i;
  int SigCount,DbcCycle,allCol,LoadLen,targetLen;
  int NormalBefCount;   //故障前正常采集帧数 = ErrorBefor - ErrorFrame1
  int hasBase;          //是否提前装载了故障前基线帧
  dword baseFrame[6];   //提前装载的故障前基线帧(每信号一个值)
  byte TempData[200];
  dword AllFrameData[200];

  //目标装载总字节数 = Res_FixData_Len - 6
  targetLen = Res_FixData_Len - 6;
  if(targetLen < 0)
    targetLen = 0;

  for(node=0;node<FixDataSave_Count;node++)
  {
    for(idx=0;idx<FixDataSave[node].Error_Type_Count;idx++)
    {
      if(FixDataSave[node].DTC[idx] == DTC_Set)
      {
        /* 命中DTC，开始故障采集与装载 */
        SigCount = FixDataSave[node].SigSaveCount[idx];
        if(SigCount > 6)
          SigCount = 6;   //防止越界，SigSave最多6个
        DbcCycle = _GetCycleFromDBC(FixDataSave[node].Node);
        if(DbcCycle < 1)
          DbcCycle = 1;
        allCol = 0;

        //故障前正常采集帧数 = ErrorBefor - ErrorFrame1，若为负则取0
        NormalBefCount = ErrorBefor - ErrorFrame1;
        if(NormalBefCount < 0)
          NormalBefCount = 0;

        hasBase = 0;
        /* 阶段0: 若故障前无正常帧(NormalBefCount==0)，则提前装载一帧作为故障段基线，
           避免故障一开始就丢节点导致取不到正确数据 */
        if(NormalBefCount == 0)
        {
          testWaitForMessage(FixDataSave[node].Node,1000);
          for(sig=0;sig<SigCount;sig++)
            baseFrame[sig] = GetRawSignal(FixDataSave[node].SigSave[idx][sig]);
          hasBase = 1;
        }
        _WriteEx_and_Report("","/*----------------开始抓取数据----------------*/");
        /* 阶段1: 故障前正常帧，采NormalBefCount帧 */
        for(frame=0;frame<NormalBefCount;frame++)
        {
          testWaitForMessage(FixDataSave[node].Node,1000);
          for(sig=0;sig<SigCount;sig++)
            AllFrameData[allCol*SigCount+sig] = GetRawSignal(FixDataSave[node].SigSave[idx][sig]);
          allCol++;
        }

        /* 阶段2: 制造故障，采集ErrorFrame1帧(故障成熟帧) */
        if(strncmp(FixDataSave[node].Error_Type[idx],"Lost",4)==0)  //Lost故障
        {
          _TestDisableMsg(FixDataSave[node].Node);
          for(frame=0;frame<ErrorFrame1;frame++)
          {
            testWaitForTimeout(DbcCycle);
            for(sig=0;sig<SigCount;sig++)
            {
              if(NormalBefCount > 0)
                AllFrameData[allCol*SigCount+sig] = AllFrameData[(NormalBefCount-1)*SigCount+sig]; //采用阶段1最后值
              else if(hasBase)
                AllFrameData[allCol*SigCount+sig] = baseFrame[sig]; //无阶段1时采用提前装载基线值
              else
                AllFrameData[allCol*SigCount+sig] = 0;
            }
            allCol++;
          }
        }
        else  //Invalid/Cntr等故障：信号置无效值
        {
          _Set_SigNoTime(FixDataSave[node].SigName[idx],FixDataSave[node].Invalid_Value[idx]);
          for(frame=0;frame<ErrorFrame1;frame++)
          {
            testWaitForMessage(FixDataSave[node].Node,1000);
            for(sig=0;sig<SigCount;sig++)
              AllFrameData[allCol*SigCount+sig] = GetRawSignal(FixDataSave[node].SigSave[idx][sig]);
            allCol++;
          }
        }

        _WriteEx_and_Report("","/*----------------故障恢复----------------*/");
        /* 阶段3: 累计帧数达到ErrorBefor后恢复故障 */
        if(strncmp(FixDataSave[node].Error_Type[idx],"Lost",4)==0)
          _TestEnableMsg(FixDataSave[node].Node);
        else
          _Set_SigNoTime(FixDataSave[node].SigName[idx],FixDataSave[node].Normal_Value[idx]);

        /* 阶段4: 恢复后继续采集，直到总帧数达到 ErrorBefor + ErrorAfter */
        for(frame=allCol;frame<ErrorBefor+ErrorAfter;frame++)
        {
          testWaitForMessage(FixDataSave[node].Node,1000);
          for(sig=0;sig<SigCount;sig++)
            AllFrameData[allCol*SigCount+sig] = GetRawSignal(FixDataSave[node].SigSave[idx][sig]);
          allCol++;
        }

        /* 按信号维度装载到TempData */
        LoadLen = Frame_Loop_Save(node,idx,TempData,0,AllFrameData,allCol);
        for(i=0;i<LoadLen;i++)
          writeEx(-3,0,"获取到的纯数据 GetData[%d] = 0x%02X",i,TempData[i]);
        _WriteEx_and_Report("","/*----------------抓取数据完毕----------------*/");
        /* 输出有效字节到DataGet，并补0至targetLen */
        for(i=0;i<LoadLen && i<targetLen;i++)
          DataGet[i] = (byte)(TempData[i] & 0xFF);
        for(i=LoadLen;i<targetLen;i++)
          DataGet[i] = 0;
        return targetLen;
      }
    }
  }
  return 0;
}

/*
    检测输入的参数是否被支持
    Type == 4 :19 04
    Type == 6 :19 06
*/
int _Check_ByteIn19(int Type,byte Byte_Input)
{
  int Serve_Pos,Fun_Pos,i;
  int Return_Value;
  Return_Value = -1;
  Serve_Pos = _Check_Serve(0x19,0,0);
  Fun_Pos = _Check_Serve(0x19,Type,4);
  if(Fun_Pos != -1)
  {
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Para_Count[Fun_Pos];i++)
    {
      if(Byte_Input == Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][i])
      {
        Return_Value = 1;
        break;
      }
    }
  }
  if(Type != 0x04 && Type != 0x06)
  {
    byte Count_Para[100];
    byte Count;
    Count = 0;
    Fun_Pos = _Check_Serve(0x19,0x04,4);
    if(Fun_Pos != -1)
    {
      for(i=0;i<Serve_Data[Serve_Pos].Serve_Para_Count[Fun_Pos];i++)
      {
        Count_Para[Count] = Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][i];
        Count++;
      }
    }
    Fun_Pos = _Check_Serve(0x19,0x06,4);
    if(Fun_Pos != -1)
    {
      for(i=0;i<Serve_Data[Serve_Pos].Serve_Para_Count[Fun_Pos];i++)
      {
        Count_Para[Count] = Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][i];
        Count++;
      }
    }
    for(i=0;i<Count;i++)
    {
      if(Byte_Input==Count_Para[i])
      {
        Return_Value = 1;
        break;
      }
    }
  }
  return Return_Value;
}

int _Check_DID_Pos(dword DID)
{
  int Return_Value;
  int i;
  Return_Value = -1;
  for(i=0;i<DID_Function_Count;i++)
  {
    if(DID_Function[i].DID == DID)
    {
      toUpper(DID_Function[i].Sig_Type,DID_Function[i].Sig_Type,strlen(DID_Function[i].Sig_Type));//大写数据类型防止后续判断时不匹配
      Return_Value = i;
      break;
    }
  }
  return Return_Value;
}

/// <DID_22>
/*
    Send_Data：  发送数据装载
    Fun_DIDPos： 所在结构体位置
    ID：         发送ID
    Step_Flage： 是否存在操作值
    Data_Pos：   预期结果所在位置 / 直接输入判断
    Invalid:     无效值判定 当其为1时，输入为无效值
    ValueGet:    1:正常取预设值  2:仅输出不做判断   其余值均直接判断Data_Pos,无数据转换
*/
int Check_ReadFunDID(byte Send_Data[],int Fun_DIDPos,dword ID,int Step_Flage,float Data_Pos,int Invalid,int ValueGet)
{
  int Return_Value;
  int Res_Len,i,Data_Temp_Write_OutPut_Flage;
  char Data_Res[200];
  char Data_Res_Change[200];
  dword Data_Temp;
  float Data_Temp_Write;
  int Data_Pos_Int;
  byte DataForTime[20];
  
  snprintf(Data_Res,elCount(Data_Res),"%s","");//装载原始数据打印
  snprintf(Data_Res_Change,elCount(Data_Res_Change),"%s","");//装载转换后数据
  Data_Temp = 0;
  Data_Temp_Write = 0;
  Data_Temp_Write_OutPut_Flage = 1;
  Data_Pos_Int = (int)Data_Pos;
  
  if(Fun_DIDPos == -1)
  {
    _WriteEx_and_Report("功能DID","未获取到对应的DID:0x%04X数据",((Send_Data[1]<<8)|(Send_Data[2])));
    return 0;
  }

  _Send_Diag(3,ID,Send_Data);
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,500);
  if(diagGetLastResponseCode(SendData) == -1)
  {
    Res_Len = DiagGetRespPrimitiveSize(SendData);
    if(Res_Len != DID_Function[Fun_DIDPos].ExLen)
      testStepFail(DID_Function[Fun_DIDPos].DID_Index,"DID长度与期望不符，期望长度为%d ，实际长度为%d",DID_Function[Fun_DIDPos].ExLen,Res_Len);
    
    snprintf(Data_Res,elCount(Data_Res),"原始数据:");
    snprintf(Data_Res_Change,elCount(Data_Res_Change),"转换后数据:");
    DID_Function[Fun_DIDPos].ValueNow = 0;
    for(i=3;i<Res_Len;i++)
    {
      snprintf(Data_Res,elCount(Data_Res),"%s 0x%02X",Data_Res,DiagGetRespPrimitiveByte(SendData,i)); //原始数据存储
      DataForTime[i-3] = DiagGetRespPrimitiveByte(SendData,i);
      DID_Function[Fun_DIDPos].ValueNow += (DiagGetRespPrimitiveByte(SendData,i)<<(8*(Res_Len-i-1)));
    }
    /*此处需要对时间参数单独判定*/
    if(DID_Function[Fun_DIDPos].Time_Flage == 0) //非时间数据处理
    {
      if(strncmp(DID_Function[Fun_DIDPos].Sig_Type,"UNSIGNED",strlen(DID_Function[Fun_DIDPos].Sig_Type)) == 0 && strlen(DID_Function[Fun_DIDPos].Sig_Type) == strlen("UNSIGNED"))//无符号型数据
      {
        if(Res_Len>3)
        {
          for(i=3;i<Res_Len;i++)
            Data_Temp = Data_Temp + (DiagGetRespPrimitiveByte(SendData,i)<<(8*(Res_Len-i-1)));
          Data_Temp_Write = Data_Temp*DID_Function[Fun_DIDPos].Factor + DID_Function[Fun_DIDPos].Offset;
          snprintf(Data_Res_Change,elCount(Data_Res_Change),"%s %.2f",Data_Res_Change,Data_Temp_Write);
        }
      }
      else if(strncmp(DID_Function[Fun_DIDPos].Sig_Type,"SIGNED",strlen(DID_Function[Fun_DIDPos].Sig_Type)) == 0 && strlen(DID_Function[Fun_DIDPos].Sig_Type) == strlen("SIGNED"))//有符号型数据
      {
        if((DiagGetRespPrimitiveByte(SendData,3)&0x80)==0x80 )   //负数
        {
          qword Da;
          qword Tem;
          qword Da_1;
          Tem = 0;
          Da_1 = 1;
          if(Res_Len - 3>8)
            Data_Temp_Write_OutPut_Flage = 0;//数据过长不可信,qword类型仅能装载长度为8byte
          for(i=0;i<Res_Len-3;i++)
            Da = (Da<<8)|0xFF;
          for(i=0;i<(Res_Len-3)*8;i++)
            Da_1 = Da_1*2;
          for(i=3;i<Res_Len;i++)
            Tem = Tem + (DiagGetRespPrimitiveByte(SendData,i)<<(8*(Res_Len-i-1)));
          Data_Temp = (Da_1 - Tem) & Da;
          Data_Temp = Data_Temp*(-1);
        }
        else//正数
        {
          for(i=3;i<Res_Len;i++)
            Data_Temp = Data_Temp + (DiagGetRespPrimitiveByte(SendData,i)<<(8*(Res_Len-i-1)));
        }
        Data_Temp_Write = Data_Temp*DID_Function[Fun_DIDPos].Factor + DID_Function[Fun_DIDPos].Offset;
        snprintf(Data_Res_Change,elCount(Data_Res_Change),"%s %.2f",Data_Res_Change,Data_Temp_Write);
      }
      {
        writeEx(-3,0,"/*---------  %s  ---------*/",DID_Function[Fun_DIDPos].DID_Index);
        writeEx(-3,0,"%s",Data_Res);
        if(Data_Temp_Write_OutPut_Flage == 1)
          writeEx(-3,0,"%s",Data_Res_Change);
        writeEx(-3,0,"/*---------------------------------*/");
      }
      if(Step_Flage == 1 && DID_Function[Fun_DIDPos].Value_Set_Flage == 1)
      {
        if(Invalid == 0)
        {
          if(ValueGet == 1) //来源于Fun_DID预设值
            _Check_ValueInRange_IsWrite(Data_Temp_Write,DID_Function[Fun_DIDPos].Value_Ex[Data_Pos_Int],DID_Function[Fun_DIDPos].Tolerance,DID_Function[Fun_DIDPos].Sig_Step,1,1);
          else if(ValueGet == 2) //仅输出，不做判断
          {
            teststep("","/*---------  %s  ---------*/",DID_Function[Fun_DIDPos].DID_Index);
            teststep("","%s",Data_Res);
            if(Data_Temp_Write_OutPut_Flage == 1)
              teststep("","%s",Data_Res_Change);
            teststep("","/*---------------------------------*/");
          }
          else //来源于直接输入
          {
//            if(Data_Pos>=DID_Function[Fun_DIDPos].Max_Value) //大于等于最大值时取最大值
//              _Check_ValueInRange_IsWrite(Data_Temp_Write,DID_Function[Fun_DIDPos].Max_Value,0,DID_Function[Fun_DIDPos].Sig_Step,1,1);
//            else
               _Check_ValueInRange_IsWrite(Data_Temp_Write,Data_Pos,DID_Function[Fun_DIDPos].Tolerance,DID_Function[Fun_DIDPos].Sig_Step,1,1);
          }
        }
        else  //无效值处理
        {
          if(DID_Function[Fun_DIDPos].Invalid_LastValue == 1) //取最后一次输入有效值
            _Check_ValueInRange_IsWrite(Data_Temp_Write,Data_Pos_Int,DID_Function[Fun_DIDPos].Tolerance,DID_Function[Fun_DIDPos].Sig_Step,1,1);
          else
            _Check_ValueInRange_IsWrite_(DID_Function[Fun_DIDPos].ValueNow,DID_Function[Fun_DIDPos].Invalid,DID_Function[Fun_DIDPos].Tolerance,DID_Function[Fun_DIDPos].Sig_Step,1,1);
        }
      }
    } 
    else //时间数据处理
    {
      LocalTime_ChangeAndOutPut(DataForTime,Res_Len-3,DID_Function[Fun_DIDPos].Sig_Type,Invalid,1);
      snprintf(Data_Res_Change,elCount(Data_Res_Change),"%s%s",Data_Res_Change,Time_GetNow);
      {
        writeEx(-3,0,"/*---------  %s  ---------*/",DID_Function[Fun_DIDPos].DID_Index);
        writeEx(-3,0,"%s",Data_Res);
        writeEx(-3,0,"%s",Data_Res_Change);
        writeEx(-3,0,"/*---------------------------------*/");
      }
      if(ValueGet != 2)
      {
        if(strncmp(Time_GetNow,DID_Function[Fun_DIDPos].LocalTime_Ex[Data_Pos_Int],strlen(Time_GetNow)) == 0 && strlen(Time_GetNow) == strlen(DID_Function[Fun_DIDPos].LocalTime_Ex[Data_Pos_Int]))
          testStepPass("","返回数据与预期数据一致");
        else
          testStepFail("","返回数据与预期数据不一致,期望为: %s  ,实际为: %s",DID_Function[Fun_DIDPos].LocalTime_Ex[Data_Pos_Int],Time_GetNow);
      }
      else
      {
        teststep("","/*---------  %s  ---------*/",DID_Function[Fun_DIDPos].DID_Index);
        teststep("","%s",Data_Res);
        teststep("","%s",Data_Res_Change);
        teststep("","/*---------------------------------*/");
      }
    }
  }
  else
    testStepFail("","未收到正响应");
  return Return_Value;
}
/*
  对时间数据进行转换输出(仅当LocalTime确保在数组中可使用)
  Data_Get:     原始数据
  Len：         原始数据长度
  DataSymbol:   数据类型
  Type:         数组来源  Type = 0:mixArray    Type = 1:DID_Function  
  Invalid
*/
void LocalTime_ChangeAndOutPut(byte Data_Get[],int Len_Data,char DataSymbol[],int Invalid,int Type)
{
  int DID_Pos,i;
  int ReadType;
  int Possition_LocalTime[6];
  char LocalTime_Str_Get[40];
  qword Temp_Time;
  
  DID_Pos = -1;
  Temp_Time = 0;
  snprintf(LocalTime_Str_Get,elCount(LocalTime_Str_Get),"");
  snprintf(Time_GetNow,elCount(Time_GetNow),"");
  if(Type == 0)
    ReadType = 1;
  else if(Type == 1)
    ReadType = 4;
  DID_Pos = _Check_StrPossion_Res("LocalTime",ReadType);
  if(DID_Pos != -1)
  {
    if(Type == 0)
      ReadType = 0;
    else if(Type == 1)
      ReadType = 1;
    Possition_LocalTime[0] = _Check_StrPossion("year",DID_Pos,ReadType);
    if(strncmp(DataSymbol,"BCD",strlen(DataSymbol)) == 0 && strlen(DataSymbol) == strlen("BCD"))//BCD格式直接拼接
    {
      if((Type == 0 && mixArray[DID_Pos].LocalTime[Possition_LocalTime[0]][1]>0) || (Type == 1 && DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[0]][1]>0))
      {
        /*  秒/分/时/日/月/年  */
        for(i=Len_Data-1;i>=0;i--)
          snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02X",LocalTime_Str_Get,Data_Get[i]);
      }
      else
      {
        /*  年/月/日/时/分/秒  */
        for(i=0;i<Len_Data;i++)
          snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02X",LocalTime_Str_Get,Data_Get[i]);
      }
    }
    else //无符号类型进行处理 (时间仅涉及无符号类型)
    {
      /*目前无符号类型数据处理中，年份均不涉及占用2Byte情况，暂不处理*/
      dword Time_TempPos;
      int Check_Pos;
      int Count;
      Count = 0;
      Possition_LocalTime[1] = _Check_StrPossion("month",DID_Pos,ReadType);
      Possition_LocalTime[2] = _Check_StrPossion("day",DID_Pos,ReadType);
      Possition_LocalTime[3] = _Check_StrPossion("hour",DID_Pos,ReadType);
      Possition_LocalTime[4] = _Check_StrPossion("minute",DID_Pos,ReadType);
      Possition_LocalTime[5] = _Check_StrPossion("second",DID_Pos,ReadType);
      for(i=0;i<6;i++)
      {
        if(Possition_LocalTime[i]!= -1)
          Count++;
      }
      if(Possition_LocalTime[0] != -1) //year存在与输入中
      {
        if((Type == 0 && mixArray[DID_Pos].LocalTime[Possition_LocalTime[0]][1]>0) || (Type == 1 && DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[0]][1]>0))
        {
  //        testWaitForTesterConfirmation(" 秒/分/时/日/月/年 ",10000);
          for(i=0;i<Len_Data;i++)
          {
            if(Possition_LocalTime[i] == -1)  //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              continue;
            if(Type == 0)
            {
              Time_TempPos = mixArray[DID_Pos].LocalTime[Possition_LocalTime[Count-1-i]][1];
              Time_TempPos = Len_Data - Time_TempPos - 1;
              Temp_Time = Data_Get[Time_TempPos] + mixArray[DID_Pos].LocalTime[Possition_LocalTime[i]][2]; //计算后的值
            }
            else if(Type == 1)
            {
              Time_TempPos = DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[Count-1-i]][1];
              Time_TempPos = Len_Data - Time_TempPos - 1;
              Temp_Time = Data_Get[Time_TempPos] + DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[i]][2]; //计算后的值
            }
            if(Invalid == 1)
              snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02X",LocalTime_Str_Get,Data_Get[Time_TempPos]);
            else
            {
              if(Temp_Time>0xFF)
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%04d",LocalTime_Str_Get,Temp_Time);
              else
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02d",LocalTime_Str_Get,Temp_Time);
            }
          }
        }
        else
        {
  //        testWaitForTesterConfirmation(" 年/月/日/时/分/秒 ",10000);
          for(i=0;i<Len_Data;i++)
          {
            if(Possition_LocalTime[i] == -1)  //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              continue;
            if(Type == 0)
            {
  	          Time_TempPos = mixArray[DID_Pos].LocalTime[Possition_LocalTime[i]][1];    //预期所在位置
  	          Time_TempPos = Len_Data - 1;  //装载后位置反向排序后取正确位置
              Temp_Time = Data_Get[i] ;
              if(Flage_Invalid_GAC == 0) //广汽无效值计算时不考虑偏差
                Temp_Time = Temp_Time + mixArray[DID_Pos].LocalTime[Possition_LocalTime[i]][2]; //计算后的值
            }
            else if(Type == 1)
            {
  	          Time_TempPos = DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[i]][1];    //预期所在位置
  	          Time_TempPos = Len_Data - 1;  //装载后位置反向排序后取正确位置
              Temp_Time = Data_Get[i] ;
              if(Flage_Invalid_GAC == 0) //广汽无效值计算时不考虑偏差
                Temp_Time = Temp_Time + DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[i]][2]; //计算后的值
            }
            if(Invalid == 1)
              snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02X",LocalTime_Str_Get,Data_Get[i]);
            else
            {
              if(Temp_Time>0xFF)
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%04d",LocalTime_Str_Get,Temp_Time);
              else
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02d",LocalTime_Str_Get,Temp_Time);
            }
          }
        }
      }
      else //year不存在，仅包含部分时间如 时/分/秒
      {
        if((Type == 0 && mixArray[DID_Pos].LocalTime[Possition_LocalTime[5]][1]>0) || (Type == 1 && DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[5]][1]>0))
        {
//          writeEx(-3,0," 时/分/秒 ");
          for(i=3;i<Len_Data+3;i++)
          {
            if(Possition_LocalTime[i] == -1)  //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              continue;
            if(Type == 0)
            {
  	          Time_TempPos = mixArray[DID_Pos].LocalTime[Possition_LocalTime[i]][1];    //预期所在位置
              Temp_Time = Data_Get[i-3] + mixArray[DID_Pos].LocalTime[Possition_LocalTime[i]][2]; //计算后的值
            }
            else if(Type == 1)
            {
  	          Time_TempPos = DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[i]][1];    //预期所在位置
              Temp_Time = Data_Get[i-3] + DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[i]][2]; //计算后的值
            }
            if(Invalid == 1)
              snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02X",LocalTime_Str_Get,Data_Get[i-3]);
            else
            {
              if(Temp_Time>0xFF)
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%04d",LocalTime_Str_Get,Temp_Time);
              else
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02d",LocalTime_Str_Get,Temp_Time);
            }
          }
        }
        else
        {
//          writeEx(-3,0," 秒/分/时 ");
          for(i=3;i<Len_Data+3;i++)
          {
            if(Possition_LocalTime[i] == -1)  //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              continue;
            if(Type == 0)
            {
              Time_TempPos = mixArray[DID_Pos].LocalTime[Possition_LocalTime[i]][1];
              Temp_Time = Data_Get[Len_Data-i+2] + mixArray[DID_Pos].LocalTime[Possition_LocalTime[i]][2]; //计算后的值
            }
            else if(Type == 1)
            {
              Time_TempPos = DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[i]][1];
              Temp_Time = Data_Get[Len_Data-i+2] + DID_Function[DID_Pos].LocalTime_Config[Possition_LocalTime[i]][2]; //计算后的值
            }
            if(Invalid == 1)
              snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02X",LocalTime_Str_Get,Data_Get[Len_Data-i+2]);
            else
            {
              if(Temp_Time>0xFF)
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%04d",LocalTime_Str_Get,Temp_Time);
              else
                snprintf(LocalTime_Str_Get,elcount(LocalTime_Str_Get),"%s%02d",LocalTime_Str_Get,Temp_Time);
            }
          }
        }
      }
    }
    //输出接口，传递到外部进行判断
    snprintf(Time_GetNow,elcount(Time_GetNow),"%s",LocalTime_Str_Get);
  }
}
void FunDID_ReadAndSet(dword FunDID,dword ID,byte Session)
{
  int Fun_DIDPos;
  byte Send_Data[3];
  int i,Step_Flage;
  char DIDStr[50];
  Send_Data[0] = 0x22;
  Send_Data[1] = (FunDID>>8)&0xFF;
  Send_Data[2] = FunDID&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  
  Step_Flage = 0;
  snprintf(DIDStr,elCount(DIDStr),"");
  if(Fun_DIDPos == -1)
    _WriteEx_and_Report("功能DID","未获取到对应的DID:0x%04X数据",FunDID);
  else if(Fun_DIDPos >= 0)
  {
    snprintf(DIDStr,elCount(DIDStr),"%s",DID_Function[Fun_DIDPos].Sig_Step);
    _Str_Upper(DIDStr);
    if(DID_Function[Fun_DIDPos].Value_Set_Count == 0)
      Step_Flage = 0;
    else
      Step_Flage = 1;
    if(Step_Flage == 0)
    {
      _WriteEx_and_Report("","DID:0x%04X未查询到对应操作,仅进行数据读取输出",FunDID);
      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,0,0,1);
    }
    else
    {
      for(i=0;i<DID_Function[Fun_DIDPos].Value_Set_Count;i++)
      {
        /*进行相关操作步骤留白*/
        _Step_FunDID(DID_Function[Fun_DIDPos].Sig_Step,i);//设置第i组值
        Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,i,0,1);
      }
    }
    if((strncmp(DIDStr,"CARSPD",strlen(DIDStr)) == 0 && strlen(DIDStr) == strlen("CARSPD")) 
        || (strncmp(DIDStr,"VEHICLESPEED",strlen(DIDStr)) == 0 && strlen(DIDStr) == strlen("VEHICLESPEED")) 
        || strncmp(DIDStr,"READY_STATE",strlen(DIDStr)) == 0 && strlen(DIDStr) == strlen("READY_STATE"))
    {
      _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Max_Value);
      testWaitForTimeout(500);
      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Max_Value,0,0);
      _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Max_Value+2);
      testWaitForTimeout(500);
      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Max_Value+2,0,0);
      _Step_FunDID(DID_Function[Fun_DIDPos].Sig_Step,0);
      testWaitForTimeout(500);
      _TestDisableMsg(DID_Function[Fun_DIDPos].Sig_From);
      testWaitForTimeout(2000);
      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Value_Set[0],1,0);
      _TestEnableMsg(DID_Function[Fun_DIDPos].Sig_From);
      testWaitForTimeout(2000);
      if(strncmp(DIDStr,"READY_STATE",strlen(DIDStr)) == 0 && strlen(Struct_Ready.ReadyInvalid_Sig) == 0)
      {
        _WriteEx_and_Report("","无发动机无效相关测试");
        return;
      }
      _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[1]);
      testWaitForTimeout(500);
      _Invalid_Node(atol(DID_Function[Fun_DIDPos].Sig_From));
      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Value_Set[1],1,0);
      _Recover_Invalid_Node(atol(DID_Function[Fun_DIDPos].Sig_From));
      if((strncmp(DIDStr,"CARSPD",strlen(DIDStr)) == 0) || (strncmp(DIDStr,"VEHICLESPEED",strlen(DIDStr)) == 0))
        _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,0);
    }
  }
}

// 函数功能：计算字符 charToFind 在字符串 sourceStr 中出现的次数
long CountChar(char sourceStr[], char charToFind[])
{
  long count ;       // 计数器，记录出现次数
  long offset;      // 查找的起始偏移量
  long pos;
  pos = 0;count = 0;offset = 0;
  while (1)
  {
    // strstr_off 返回找到的位置索引，如果没找到则返回 -1
    pos = strstr_off(sourceStr, offset, charToFind);
    if (pos == -1)
      break;// 没找到，跳出循环
    // 找到了，计数器加一
    count++;
    // 更新下一次查找的起始位置，从本次找到位置的下一个字符开始
    offset = pos + 1;
  }
  return count;
}

void Truncate_Str(char Sor[],char Output[][],char Flage[])
{
  long startPos;  // 当前截取的起始位置
  long commaPos;  // 逗号的位置
  long len;
  long subLen;
  int i;
  startPos = 0;commaPos = 0;len = strlen(Sor);subLen = 0;i = 0;
  while (startPos < len)
  {
    commaPos = strstr_off(Sor, startPos, Flage);
    if (commaPos == -1) 
      subLen = len - startPos;
    else 
      subLen = commaPos - startPos;
    substr_cpy(Output[i], Sor, startPos, subLen, elCount(Output[i]));
    if (commaPos == -1) 
      break; // 没有更多逗号，退出循环
    startPos = commaPos + 1;
    i++;
  }
}
/*
    将输入的数据按照不同的解析方式进行转换后输出判断
    Analysis    解析方式
    DataRx      原始数据输入
    LenRx       原始数据长度
    Output      转换后字符输出
    Input       期望原始字符串
*/
int DataChange_Analysis(int Analysis,byte DataRx[],int LenRx,char Output[],char Input[],byte Padding ,char Report[])
{
  int i,j,Group_Temp;
  char Buffer_Temp[500];
  char Buffer_Check[500];
  char Temp_Rx_Data[500];
  qword Data_Temp ;
  int LenInput_Get;
  int Return_Value,Temp_Return_Flage;
  int InPut_Len;
  Return_Value = 0;
  snprintf(Buffer_Temp,elCount(Buffer_Temp),"");
  snprintf(Buffer_Check,elCount(Buffer_Check),"");
  LenInput_Get = strlen(Input);
  if(Analysis == 2)
  {
    for(i=0;i<LenInput_Get;i++)
      snprintf(Buffer_Check,elCount(Buffer_Check),"%s%c",Buffer_Check,DataRx[i]); //ASCII码查表切换
    Temp_Return_Flage = Check_information_(Buffer_Check,Input,Report);
    if(LenInput_Get<LenRx)
    {
      _WriteEx_and_Report("","存在未使用填充值");
      for(i=LenInput_Get;i<LenRx;i++)
      {
        if(DataRx[i] != Padding)
        {
          testStepFail(Report,"未使用位填充值存在非预期情况，默认填充值为；0x%02X,第%d 位实际反馈值为:0x%2X",Padding,i+1,DataRx[i]);
          Return_Value = -1;
        }
      }
    }
  }
  else if(Analysis == 3)
  {
    for(i=0;i<LenRx;i++)
      snprintf(Buffer_Temp,elCount(Buffer_Temp),"%s%02X",Buffer_Temp,DataRx[i]);
    strtoull(Buffer_Temp,Data_Temp);
    snprintf(Buffer_Check,elCount(Buffer_Check),"%s%I64u",Buffer_Check,Data_Temp);
    Temp_Return_Flage = Check_information_(Buffer_Check,Input,Report);
    if(Temp_Return_Flage == -1)
      Return_Value = -1;
  }
  else if(Analysis == 4)
  {
    for(i=0;i<LenRx;i++)
    {
      ltoa(DataRx[i],Buffer_Temp,10);
      if(strlen(Buffer_Temp) == 1)
        snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
      snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer_Temp);
    }
    Temp_Return_Flage = Check_information_(Buffer_Check,Input,Report);
    if(Temp_Return_Flage == -1)
      Return_Value = -1;
  }
  else if(Analysis == 5)
  {
    for(i=0;i<strlen(Input)/2;i++)
    {
      ltoa(DataRx[i],Buffer_Temp,16);
      if(strlen(Buffer_Temp) == 1)
      {
        snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
      }
      snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer_Temp);
    }
    toUpper(Buffer_Check, Buffer_Check, elcount(Buffer_Check));
    Temp_Return_Flage = Check_information_(Buffer_Check,Input,Report);
    if(Temp_Return_Flage == -1)
      Return_Value = -1;
    if(LenInput_Get/2 < LenRx)
    {
      _WriteEx_and_Report("","存在未使用的填充位");
      for(i=LenInput_Get/2;i<LenRx;i++)
      {
        if(DataRx[i] != Padding)
        {
          Return_Value = -1;
          testStepFail(Report,"未使用位填充值存在非预期情况，默认填充值为；0x%02X,第%d 位实际反馈值为:0x%02X",Padding,i+1,DataRx[i]);
        }
      }
    }
  }
  else if(Analysis == 7)
  {
    for(i=0;i<LenRx-3;i++) //前面为BCD拼接
    {
      ltoa(DataRx[i],Buffer_Temp,16);
      if(strlen(Buffer_Temp) == 1)
        snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
      snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer_Temp);
      snprintf(Buffer_Temp,200,"");
    }
    for(i=LenRx-3;i<LenRx;i++)  //后三字节为ASCII码
    {
      snprintf(Buffer_Check,elCount(Buffer_Check),"%s%c",Buffer_Check,DataRx[i]); //ASCII码查表切换
    }
    Temp_Return_Flage = Check_information_(Buffer_Check,Input,Report);
    if(Temp_Return_Flage == -1)
      Return_Value = -1;
  }
  else if(Analysis == 8)
  {
    Group_Temp = (LenRx-1)/3;
    for(j=0;j<3;j++)
    {
      int RxLen_Temp;
      snprintf(Buffer_Temp,elCount(Buffer_Temp),"%s","");
      snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
      snprintf(Temp_Rx_Data,elCount(Temp_Rx_Data),"%s","");
      RxLen_Temp = Group_Temp*(j+1);
      substr_cpy(Temp_Rx_Data, Input, (LenInput_Get/3)*j, LenInput_Get/3, elcount(Temp_Rx_Data));
      for(i=1+Group_Temp*j;i<RxLen_Temp+1-3;i++) //前面为BCD拼接
      {
        ltoa(DataRx[i],Buffer_Temp,16);
        if(strlen(Buffer_Temp) == 1)
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
        snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer_Temp);
        snprintf(Buffer_Temp,200,"");
      }
      for(i=RxLen_Temp+1-3;i<RxLen_Temp+1;i++)  //后三字节为ASCII码
      {
        snprintf(Buffer_Check,elCount(Buffer_Check),"%s%c",Buffer_Check,DataRx[i]); //ASCII码查表切换
      }
      writeEx(-3,0,"第 %d 组数据",j+1);
      Temp_Return_Flage = Check_information_(Buffer_Check,Temp_Rx_Data,Report);
      if(Temp_Return_Flage == -1)
        Return_Value = -1;
    }
  }
  else if(Analysis == 1)
  {
    if(Len_Input != 0)
    {
      Temp_Return_Flage = 0;
      for(i=0;i<Len_Input;i++)
      {
        if(DataRx[i] != DID_Data[i])
        {
          testStepFail(Report,"第 %d 位与预期不一致,期望为0x%02X,实际为0x%02X",i+1,DID_Data[i],DataRx[i]);
          Temp_Return_Flage = -1;
        }
      }
      if(Len_Input<LenRx)
      {
        _WriteEx_and_Report(Report,"存在填充值");
        for(i=Len_Input;i<LenRx;i++)
        {
          if(DataRx[i] != Padding)
          {
            testStepFail(Report,"第 %d 位填充值异常,期望为0x%02X,实际为0x%02X",i+1,Padding,DataRx[i]);
            Temp_Return_Flage = -1;
          }
        }
      }
      if(Temp_Return_Flage == 0)
      {
        testStepPass(Report,"返回值与期望一致");
        writeEx(-3,0,"%s  返回值与期望一致",Report);
      }
      else
        Return_Value = -1;
    }
    else
      _WriteEx_and_Report(Report,"未输入数据，跳过检测");
  }
  snprintf(Output,elCount(Output),"%s",Buffer_Check);
  return Return_Value;
}

/// <DTC_Diag>
/*
    发送读取故障
    判断DTC是否存在/不存在
*/
void _Check_DTC_Res(byte mask,dword DTCEx_In,dword DTCEx_Not)
{
  dword DTC_Res[100];
  byte DTC_Res_Count,Get_DTC[3];
  byte Byte_H,Byte_M,Byte_L;
  int i,size,Flage;
  Get_DTC[0] = 0x19;
  Get_DTC[1] = 0x02;
  Get_DTC[2] = mask;
  _Send_Diag(3,phyreq_ID,Get_DTC);
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,2000);
  if(diagGetLastResponseCode(SendData) == -1)
  {
    size = DiagGetRespPrimitiveSize(SendData);
    DTC_Res_Count = (size-3)/4;
    testStep("DTC","共%d个DTC",DTC_Res_Count);
    for(i = 0;i< DTC_Res_Count ; i ++) 
    {      
       Byte_H = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 0);
       Byte_M = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 1);
       Byte_L = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 2);
       DTC_Res[i] = Byte_H<<16 | Byte_M<<8 | Byte_L ;    
       testStep("DTC","第%d个DTC为 0x%06X",i,DTC_Res[i]);
    }
    Flage = 0;
    if(DTCEx_In != 0 )
    {
      Flage = _Check_Dword_in_Num(DTCEx_In,DTC_Res,DTC_Res_Count);
      if(Flage == -1)
        testStepFail("","DTC: 0x%06X ,期望存在,实际不存在",DTCEx_In);
      else
        testStepPass("","DTC: 0x%06X ,已收到",DTCEx_In);
    }
    if(DTCEx_Not != 0)
    {
      Flage = _Check_Dword_in_Num(DTCEx_Not,DTC_Res,DTC_Res_Count);
      if(Flage != -1)
        testStepFail("","DTC: 0x%06X ,期望不存在,实际存在",DTCEx_Not);
      else
        testStepPass("","DTC: 0x%06X ,与期望一致,无该DTC",DTCEx_Not);
    }
  }
  else
    _WriteEx_and_Report("","未收到正响应");
}
/// <DTC_Diag>
void _Check_DTC_Res(byte mask,dword DTCEx_In[],dword DTCEx_Not[])
{
  dword DTC_Res[100];
  byte DTC_Res_Count,Get_DTC[3];
  byte Byte_H,Byte_M,Byte_L;
  int i,size,Flage,ExInCount,ExNotInCount;
  dword DTCEx_In_Change[20],DTCEx_Not_Change[20];
  Get_DTC[0] = 0x19;
  Get_DTC[1] = 0x02;
  Get_DTC[2] = mask;
  ExInCount = 0;ExNotInCount = 0;
  for(i=0;i<elcount(DTCEx_In);i++)
  {
    if(DTCEx_In[i]!=0)
    {
      DTCEx_In_Change[ExInCount] = DTCEx_In[i];
      ExInCount++;
    }
  }
  for(i=0;i<elcount(DTCEx_Not);i++)
  {
    if(DTCEx_Not[i]!=0)
    {
      DTCEx_Not_Change[ExNotInCount] = DTCEx_Not[i];
      ExNotInCount++;
    }
  }
  _Send_Diag(3,phyreq_ID,Get_DTC);
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,2000);
  if(diagGetLastResponseCode(SendData) == -1)
  {
    size = DiagGetRespPrimitiveSize(SendData);
    DTC_Res_Count = (size-3)/4;
    testStep("DTC","共%d个DTC",DTC_Res_Count);
    for(i = 0;i< DTC_Res_Count ; i ++) 
    {      
       Byte_H = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 0);
       Byte_M = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 1);
       Byte_L = (dword)diagGetRespPrimitiveByte(SendData,i*4 + 3 + 2);
       DTC_Res[i] = Byte_H<<16 | Byte_M<<8 | Byte_L ;    
       testStep("DTC","第%d个DTC为 0x%06X",i,DTC_Res[i]);
    }
    Flage = 0;
    if(ExInCount != 0 )
    {
      for(i=0;i<ExInCount;i++)
      {
        Flage = _Check_Dword_in_Num(DTCEx_In_Change[i],DTC_Res,DTC_Res_Count);
        if(Flage == -1)
          testStepFail("","DTC: 0x%06X ,期望存在,实际不存在",DTCEx_In_Change[i]);
        else
          testStepPass("","DTC: 0x%06X ,已收到",DTCEx_In_Change[i]);
      }
    }
    if(ExNotInCount != 0)
    {
      for(i=0;i<ExNotInCount;i++)
      {
        Flage = _Check_Dword_in_Num(DTCEx_Not_Change[i],DTC_Res,DTC_Res_Count);
        if(Flage != -1)
          testStepFail("","DTC: 0x%06X ,期望不存在,实际存在",DTCEx_Not_Change[i]);
        else
          testStepPass("","DTC: 0x%06X ,与期望一致,无该DTC",DTCEx_Not_Change[i]);
      }
    }
  }
  else
    _WriteEx_and_Report("","未收到正响应");
}
/*
    查询输入的服务中是否存在子功能需要安全访问
    若有则输出1 ，否则输出0
*/
int LoopServe_Search_SecurityAccess(byte Serve)
{
  int i,Servepos;
  int Return_Value;
  Return_Value = 0;
  Servepos = _Check_Serve(Serve,0,0);
  if(Serve != 0x31)
  {
    for(i=0;i<Serve_Data[Servepos].Serve_Fun_Count;i++)
    {
      if(Serve_Data[Servepos].Security_Access[i] == 1)
      {
        Return_Value = 1;break;
      }
    }
  }
  else if(Serve == 0x31)
  {
    for(i=0;i<Serve_31_Hex_Count;i++)
    {
      if(Serve_31_Hex[i].Security_Access[0] == 1)
      {
        Return_Value = 1;break;
      }
    }
  }
  return Return_Value;
}
/*
    查询输入的服务中当前子功能是否需要安全访问
*/
int LoopServe_Search_SecurityAccess(byte Serve,byte Fun_Pos)
{
  int i,Servepos;
  int Return_Value;
  Return_Value = 0;
  Servepos = _Check_Serve(Serve,0,0);
  if(Serve != 0x31)
  {
    Return_Value = Serve_Data[Servepos].Security_Access[Fun_Pos];
  }
  else if(Serve == 0x31)
  {
    Return_Value = Serve_31_Hex[Fun_Pos].Security_Access[0];
  }
  return Return_Value;
}
/*
    Geely3.0以及以上平台特殊操作步骤
    Serve：对应服务
    Type：执行操作类型
*/
void StepByGeely3_0(byte Serve,int Type)
{
  int SigValue;
  if(Geely3_Flage == 1)
  {
    if(Serve == 0x85)
    {
      diagStartTesterPresent(Cdd_Name);
      SigValue = getSignal(Struct_Ready.Ready_Sig);
      if(Type == 1 && SigValue != Struct_Ready.Ready_Active)/*85服务相关，测试前需开启发动机才能报出故障*/
      {
        _Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(6000);
      }
      else if(Type == 0 && SigValue != 0) /*85服务受发动机影响会回NRC22故关闭发动机*/
      {
        _Set_Ready(0);
      }
      diagStopTesterPresent(Cdd_Name);
    }
    else if(Serve == 0x19)
    {
      diagStartTesterPresent(Cdd_Name);
      SigValue = getSignal(Struct_Ready.Ready_Sig);
      if(Type == 1 && SigValue != Struct_Ready.Ready_Active)/*需开启发动机才能报出故障*/
      {
        _Set_Ready(Struct_Ready.Ready_Active);
        testWaitForTimeout(6000);
      }
      diagStopTesterPresent(Cdd_Name);
    }
  }
  else if(strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("ChangAn"))
  {
    if(Serve == 0x19) //长安读取故障需要开启发动机
    {
      SigValue = getSignal(Struct_Ready.Ready_Sig);
      if(Type == 1 && SigValue != Struct_Ready.Ready_Active)
        _Set_Ready(Struct_Ready.Ready_Active);
      else if(Type == 0 && SigValue != 0)
        _Set_Ready(0);
    }
  }
}
/*简化吉利3.0 11服务NRC22测试步骤输入*/
void StepForGeelyServe11(byte Session)
{
  testWaitForTimeout(2000);
  if(Session != defsession)
    _SetSession(Session);
  testWaitForTimeout(200);
}

/*
  查找目标字符串chararray在hexarray中的结束位置
  参数hexarray：数据
  参数offset：查找的起始位
  参数chararray：查找的目标字符串
  返回值a：查找到的结束位
*/
long Hexandchar_strstr(byte hexarray[],long offset,char chararray[])
{
  long i,j,a;
  i=0;a=0;
  for(i=offset;i<elcount(hexarray);i++)
  {
    for(j=0;j<strlen(chararray);j++)
    {
      if(hexarray[i+j]!=chararray[j])
        break;
    }
    if(j==strlen(chararray))
    {
      a=i+strlen(chararray);
      for(j=a;j<strlen(chararray);j++)
      {}
      break;
    }
  }
  return a;
}

void FunDID_ReadAndSet_Snapshot(dword FunDID,dword ID,byte Session)
{
  int Fun_DIDPos;
  byte Send_Data[3];
  int i,Step_Flage;
  char DIDStr[50];
  byte mask;
  byte Send_Data_22[3] = {0x22,0x33,0x0C};
  byte Data_Send[6] = {0x19,0x04,0,0,0,0x20};
  Init_For_Snapshot();
  DTC_H = (DTC_19[Node_1904_Pos][1]>>16);
  DTC_M = (DTC_19[Node_1904_Pos][1]>>8);
  DTC_L = (DTC_19[Node_1904_Pos][1]&0xFF);
  Data_Send[2] = DTC_H;
  Data_Send[3] = DTC_M;
  Data_Send[4] = DTC_L;
  Send_Data_22[1] = (FunDID>>8)&0xFF;
  Send_Data_22[2] = (FunDID)&0xFF;
  
  Send_Data[0] = 0x22;
  Send_Data[1] = (FunDID>>8)&0xFF;
  Send_Data[2] = FunDID&0xFF;
  _Get_FunDID_Data();
  Fun_DIDPos = _Check_DID_Pos(FunDID);
  
  Step_Flage = 0;
  snprintf(DIDStr,elCount(DIDStr),"");
  if(Fun_DIDPos == -1)
    _WriteEx_and_Report("功能DID","未获取到对应的DID:0x%04X数据",FunDID);
  else if(Fun_DIDPos >= 0)
  {
    StepByGeely3_0(0x19,1);
    snprintf(DIDStr,elCount(DIDStr),"%s",DID_Function[Fun_DIDPos].Sig_Step);
    _Str_Upper(DIDStr);
    if(DID_Function[Fun_DIDPos].Value_Set_Count == 0)
      Step_Flage = 0;
    else
      Step_Flage = 1;
    if(Step_Flage == 0)
    {
      _WriteEx_and_Report("","DID:0x%04X未查询到对应操作,仅进行数据读取输出",FunDID);
      _Close_One_Node(DTC_19[Node_1904_Pos]);
      mask = DTC_19[Node_1904_Pos][2];
      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,0,0,1);
      _Send_Diag(6,phyreq_ID,Data_Send);
      _Check_1904ForFunDID(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,0,2);
      _Open_One_Node(DTC_19[Node_1904_Pos]);
      _Clear_DTC(phyreq_ID);
      testWaitForTimeout(200);
    }
    else
    {
      for(i=0;i<DID_Function[Fun_DIDPos].Value_Set_Count;i++)
      {
        _Close_One_Node(DTC_19[Node_1904_Pos]);
        mask = DTC_19[Node_1904_Pos][2];
        _Step_FunDID(DID_Function[Fun_DIDPos].Sig_Step,i);//设置第i组值
        Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,i,0,1);
        _Send_Diag(6,phyreq_ID,Data_Send);
        _Check_1904ForFunDID(SendData,mask,DID_Function[Fun_DIDPos].Sig_Step,DID_Function[Fun_DIDPos].Value_Ex[i],0);
        _Open_One_Node(DTC_19[Node_1904_Pos]);
        _Clear_DTC(phyreq_ID);
        testWaitForTimeout(200);
      }
    }
//    if((strncmp(DIDStr,"CARSPD",strlen(DIDStr)) == 0 && strlen(DIDStr) == strlen("CARSPD")) 
//        || (strncmp(DIDStr,"VEHICLESPEED",strlen(DIDStr)) == 0 && strlen(DIDStr) == strlen("VEHICLESPEED")) 
//        || strncmp(DIDStr,"READY_STATE",strlen(DIDStr)) == 0 && strlen(DIDStr) == strlen("READY_STATE"))
//    {
//      _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Max_Value);
//      testWaitForTimeout(500);
//      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Max_Value,0,0);
//      _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Max_Value+2);
//      testWaitForTimeout(500);
//      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Max_Value+2,0,0);
//      _Step_FunDID(DID_Function[Fun_DIDPos].Sig_Step,0);
//      testWaitForTimeout(500);
//      _TestDisableMsg(DID_Function[Fun_DIDPos].Sig_From);
//      testWaitForTimeout(2000);
//      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Value_Set[0],1,0);
//      _TestEnableMsg(DID_Function[Fun_DIDPos].Sig_From);
//      testWaitForTimeout(2000);
//      if(strncmp(DIDStr,"READY_STATE",strlen(DIDStr)) == 0 && strlen(Struct_Ready.ReadyInvalid_Sig) == 0)
//      {
//        _WriteEx_and_Report("","无发动机无效相关测试");
//        return;
//      }
//      _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,DID_Function[Fun_DIDPos].Value_Set[1]);
//      testWaitForTimeout(500);
//      _Invalid_Node(atol(DID_Function[Fun_DIDPos].Sig_From));
//      Check_ReadFunDID(Send_Data,Fun_DIDPos,ID,Step_Flage,DID_Function[Fun_DIDPos].Value_Set[1],1,0);
//      _Recover_Invalid_Node(atol(DID_Function[Fun_DIDPos].Sig_From));
//      if((strncmp(DIDStr,"CARSPD",strlen(DIDStr)) == 0) || (strncmp(DIDStr,"VEHICLESPEED",strlen(DIDStr)) == 0))
//        _Set_Sig(DID_Function[Fun_DIDPos].Sig_Name,0);
//    }
  }
}
/*
  设置功能DID步骤中数据操作
*/
 int _Step_FunDID(char str[],dword Type) //取第Type组数据
{
  int n;
  int Sw_temp,Step_Flage;
  char str_T[500];
  char Te[500];
  snprintf(str_T,elCount(str_T),"%s","");
  snprintf(str_T,elCount(str_T),"%s",str);
  Sw_temp = _Check_StrPossion_Res(str,4); //检测字符串是否在预期输入中
  Step_Flage = 1;
  _Str_Upper(str_T);
  snprintf(Te,elCount(Te),"%s","");
  
  if(Sw_temp!= -1 && Step_Flage == 1)
  {
    if(((strncmp(str_T,"BATTERY",strlen(str_T)) == 0) || (strncmp(str_T,"VOLTAGE",strlen(str_T)) == 0)) )
    {
      _Set_Battery(DID_Function[Sw_temp].Value_Set[Type]);
      DID_Function[Sw_temp].Value_Set_Flage = 1;
      return 0;
    }
    else if(strncmp(str_T,"ANGLE",strlen(str_T)) == 0 )
    {
      _Get_Ready();
      if(Engine_State == 0)
        _Set_Ready(Struct_Ready.Ready_Active);
      snprintf(Te,elCount(Te),"转动方向盘到 %.1f°",DID_Function[Sw_temp].Value_Set[Type]);
      _TestWaitForTesterConfirmation(Te);
      DID_Function[Sw_temp].Value_Set_Flage = 1;
      if(Engine_State == 0)
        _Set_Ready(Engine_State);
      return 0;
    }
    else if(strncmp(str_T,"LOCALTIME",strlen(str_T)) == 0)
    {
      snprintf(Te,elCount(Te),"%s",DID_Function[Sw_temp].LocalTime_Set[Type]);
      _WriteEx_and_Report("   设置LocalTime",Te);
      _Set_Time(Te,1);
      DID_Function[Sw_temp].Value_Set_Flage = 1;
      return 0;
    }
    else
    {
      for(n=0;n<DID_Function_Count;n++)
      {
        if(strncmp(str,DID_Function[n].Sig_Step,strlen(str)) == 0 )
        {
          _Check_ID_(DID_Function[n].Sig_From);
          if(Canoe_Node_Flage == 1)
          {
            _Set_Sig(DID_Function[n].Sig_Name,DID_Function[Sw_temp].Value_Set[Type]);
            DID_Function[Sw_temp].Value_Set_Flage = 1;
            testWaitForTimeout(100);
            return 0;
          }
        }
      }
    }
  }
  {
    Sw_temp = -1;
    _WriteEx_and_Report(str,"未查询到对应的操作流程,待后续完善");
    return -1;
  }
}

_Check_1904ForFunDID(diagRequest* Diag,dword mask,char Check_Str[],float Ex_Value,dword type) //type = 0:有效值   type = 1:无效值  type = 2:仅获取值 
{
  int ii,n;
  char Comment[70];
  dword Rx_Len;
  int swhere;
  int swhere_1;
  int Possition_LocalTime[6];
  byte DID_Tmep[2];
  byte DID_Tmep_1[2];
  byte DID_Tmep_2[2];
  byte Res_Data[100];
  byte Check_Flage_Value;
  char Vaule_Str_Temp[20];
  float Vaule_Temp;
  int Possition;
  Res1904_Data_Count = 0;
  Check_Flage_Value = 0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    Rx_Len = DiagGetRespPrimitiveSize(Diag);
    for(ii=0;ii<5;ii++)
    {
      if(ii==0)
      {
        if((DiagGetPrimitiveByte(Diag,0)^0x40)!=diagGetRespPrimitiveByte(Diag,0))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,0)^0x40,diagGetRespPrimitiveByte(Diag,ii));
      }
      else
      {
        if(DiagGetPrimitiveByte(Diag,ii)!=diagGetRespPrimitiveByte(Diag,ii))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,ii),diagGetRespPrimitiveByte(Diag,ii));     
      }
    }
    {
      if(((mask &0x01) == (diagGetRespPrimitiveByte(Diag,5)&0x01)) && ((mask &0x08) == (diagGetRespPrimitiveByte(Diag,5)&0x08)))
        testStepPass("","当前掩码状态与预期一致");
      else
        testStepFail("","当前掩码状态与预期不一致，预期为 0x%02X ,实际为0x%02X",mask,diagGetRespPrimitiveByte(Diag,5));
    }
    if(diagGetRespPrimitiveByte(Diag,6)!= Freeze_Frame_Number[0])
      testStepFail("快照号","预期结果为0x%02X,实测结果为0x%02X",Freeze_Frame_Number[0],diagGetRespPrimitiveByte(Diag,6)); 
    else
      testStepPass("快照号","预期与实测结果一致为: 0x%02X",diagGetRespPrimitiveByte(Diag,6)); 
    if(diagGetRespPrimitiveByte(Diag,7)!= mixArray_Len)
      testStepFail("快照个数","预期结果为0x%02X,实测结果为0x%02X",mixArray_Len,diagGetRespPrimitiveByte(Diag,7)); 
    else
      testStepPass("快照个数","预期与实测结果一致为: 0x%02X",diagGetRespPrimitiveByte(Diag,7)); 
    for(ii=8;ii<Rx_Len-2;ii++)
    {
      int Flage_DID_Tmep_2;
      
      DID_Tmep[0] = diagGetRespPrimitiveByte(Diag,ii);
      DID_Tmep[1] = diagGetRespPrimitiveByte(Diag,ii+1);
      Possition = Array_Compare_1904(DID_Tmep);     //DID在结构体的位置
      Vaule_Temp = 0;
      if(Possition != -1)
      {
        DID_Tmep_1[0] = diagGetRespPrimitiveByte(Diag,ii-2);
        DID_Tmep_1[1] = diagGetRespPrimitiveByte(Diag,ii-1);
        if(Rx_Len<Rx_Len-4)
        {
          DID_Tmep_2[0] = diagGetRespPrimitiveByte(Diag,ii+2);
          DID_Tmep_2[1] = diagGetRespPrimitiveByte(Diag,ii+3);
          Flage_DID_Tmep_2 =  Array_Compare_1904(DID_Tmep_2);
        }
        else
          Flage_DID_Tmep_2 = 1;
        if(Array_Compare_1904(DID_Tmep_1)!=-1 && Flage_DID_Tmep_2 !=-1) //判断是数据还是DID
        { }
        else
        {
          snprintf(Comment,elCount(Comment),"%s","");
          Res1904_Data[Res1904_Data_Count].Res_DID[0] = DID_Tmep[0];
          Res1904_Data[Res1904_Data_Count].Res_DID[1] = DID_Tmep[1];
          snprintf(Comment,elCount(Comment),"%s %02X",Comment,DID_Tmep[0]);
          snprintf(Comment,elCount(Comment),"%s %02X",Comment,DID_Tmep[1]);
          Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len = mixArray[Possition].DID_1904_Len;
          Res1904_Data[Res1904_Data_Count].Factor = mixArray[Possition].Factor;
          Res1904_Data[Res1904_Data_Count].Offset = mixArray[Possition].Offset;
          Res1904_Data[Res1904_Data_Count].Tolerance = mixArray[Possition].Tolerance;
          Res1904_Data[Res1904_Data_Count].Possition = Possition;
          snprintf( Res1904_Data[Res1904_Data_Count].Str,elcount(mixArray[Possition].Str_DID_1904),"%s",mixArray[Possition].Str_DID_1904);
          snprintf( Res1904_Data[Res1904_Data_Count].Symbol,elcount(mixArray[Possition].Symbol),"%s",mixArray[Possition].Symbol);
          for(n=0;n<mixArray[Possition].DID_1904_Len;n++)
             Res1904_Data[Res1904_Data_Count].Res_DID_Data[n] = diagGetRespPrimitiveByte(Diag,ii+2+n);
          {
            if(strncmp(Res1904_Data[Res1904_Data_Count].Symbol,"signed",strlen(Res1904_Data[Res1904_Data_Count].Symbol)) == 0)
            {
              if((Res1904_Data[Res1904_Data_Count].Res_DID_Data[0]&0x80)==0x80 )   //负数
              {
                qword Da;
                qword Tem;
                Tem = 0;
                for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  Tem = Tem + (Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
                if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 4)
                  Da = 0xFFFFFFFF;
                else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 3)
                  Da = 0xFFFFFF;
                else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 2)
                  Da = 0xFFFF;
                else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 1)
                  Da = 0xFF;
                Vaule_Temp = (0xFFFFFFFF - Tem) & Da;
                Vaule_Temp = Vaule_Temp*(-1);
              }
              else
              {
                for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
              }
            }
            else
            {
              for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));    
            }
            Res1904_Data[Res1904_Data_Count].Vaule_Now = (Vaule_Temp*Res1904_Data[Res1904_Data_Count].Factor) + Res1904_Data[Res1904_Data_Count].Offset;
          }
          Res1904_Data_Count++;
        } //数据DID循环
      }
    }  // for循环结束,获取到全部数据装入结构体Res1904_Data中
    
    if(strncmp(Check_Str,"ALL",strlen(Check_Str))!=0)
      swhere_1 =  _Check_StrPossion_Res(Check_Str,2);  //字符串在返回数据中的位置
    if(strncmp(Check_Str,"LocalTime",strlen(Check_Str))==0 && strlen(Check_Str)!=0)
    {
      swhere = _Check_StrPossion_Res("LocalTime",1); //字符串在预输入数据中的位置
      if(swhere == -1)
        _WriteEx_and_Report("LocalTime","当前预输入中无时间快照信息");
      else         //时间拼接计算 真实时间
      {
        if(strncmp(Res1904_Data[swhere_1].Symbol,"BCD",strlen(Res1904_Data[swhere_1].Symbol))==0)   //BCD格式,全原码拼接
        {
          /*判断是:年/月/日/时/分/秒       还是:秒/分/时/日/月/年*/
          /************************待完善*************************/
          Possition_LocalTime[0] = _Check_StrPossion("year",swhere,0);
          if(mixArray[swhere].LocalTime[Possition_LocalTime[0]][1]>0)
          {
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Res1904_Data[swhere_1].Res_DID_Data[n]);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
          else
          {
            for(n=Res1904_Data[swhere_1].Res_DID_Data_Len;n>=0;n--)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Res1904_Data[swhere_1].Res_DID_Data[n]);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
        }
        else
        {
          qword Temp_Time;
          dword swhere_temp;
          Possition_LocalTime[0] = _Check_StrPossion("year",swhere,0);
          Possition_LocalTime[1] = _Check_StrPossion("month",swhere,0);
          Possition_LocalTime[2] = _Check_StrPossion("day",swhere,0);
          Possition_LocalTime[3] = _Check_StrPossion("hour",swhere,0);
          Possition_LocalTime[4] = _Check_StrPossion("minute",swhere,0);
          Possition_LocalTime[5] = _Check_StrPossion("second",swhere,0);
          Temp_Time =0;
          if(mixArray[swhere].LocalTime[Possition_LocalTime[0]][1]>0)
          {
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              {
                //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
              }
              else
              {
                swhere_temp = mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][1];    //预期所在位置
                swhere_temp = Res1904_Data[swhere_1].Res_DID_Data_Len - swhere_temp - 1;  //装载后位置反向排序后取正确位置
                Temp_Time = Res1904_Data[swhere_1].Res_DID_Data[swhere_temp] + mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Temp_Time);
                if(strlen(Vaule_Str_Temp)<2)
                  snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              }
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
          else
          {
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              {
                //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
              }
              else
              {
                swhere_temp = mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][1];    //预期所在位置
                swhere_temp = Res1904_Data[swhere_1].Res_DID_Data_Len - 1;  //装载后位置反向排序后取正确位置
                Temp_Time = Res1904_Data[swhere_1].Res_DID_Data[swhere_temp] + mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Temp_Time);
                if(strlen(Vaule_Str_Temp)<2)
                  snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              }
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
        }
      }
      _WriteEx_and_Report("","/---------------   LocalTime   ---------------/");
      if(strncmp(Res1904_Data[swhere_1].LocalTime_Value,mixArray[swhere].LocalTime_Value,strlen(Res1904_Data[swhere_1].LocalTime_Value))==0 &&strncmp(mixArray[swhere].LocalTime_Value,Res1904_Data[swhere_1].LocalTime_Value,strlen(mixArray[swhere].LocalTime_Value))==0)
        testStepPass(Check_Str,"预期时间与实际返回时间一致,均为 %s",Res1904_Data[swhere_1].LocalTime_Value);
      else
        testStepFail(Check_Str,"预期时间为 %s  ,实际返回为 %s",mixArray[swhere].LocalTime_Value,Res1904_Data[swhere_1].LocalTime_Value);
    }
    else
    {
      dword Temp_Possion;
      qword Invalid_Value_;
      char Cmment_S[200];
      char Cmment_T[200];
      char Cmment_D[200];
      snprintf(Cmment_S,elCount(Cmment_S),"%s","");
      snprintf(Cmment_D,elCount(Cmment_D),"%s","");
      snprintf(Cmment_T,elCount(Cmment_T),"%s","");
      if(strncmp(Check_Str,"ALL",strlen(Check_Str))==0 && strlen(Check_Str)!=0)
        return;
      Temp_Possion = _Check_StrPossion_Res(Check_Str,1);  //字符串预期输入数据中的位置
      // writeEx(-3,0,"%s  %d  %d",Check_Str,Temp_Possion,swhere_1);
      if(Temp_Possion == -1 || swhere_1 == -1 ) 
      { 
//        if(strncmp(Check_Str,"ALL",strlen(Check_Str))!=0)
          _WriteEx_and_Report(Check_Str,"所输入判断数据不在预期列表中");
      }
      else
      {
        snprintf(Cmment_D,elCount(Cmment_D),"%02X  %02X",Res1904_Data[swhere_1].Res_DID[0],Res1904_Data[swhere_1].Res_DID[1]);
        for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
          snprintf(Cmment_T,elCount(Cmment_T),"%s %02X",Cmment_T,Res1904_Data[swhere_1].Res_DID_Data[n]);
        snprintf(Cmment_S,elCount(Cmment_S),"/---------------   %s   ---------------/",mixArray[Temp_Possion].Str_DID_1904);
        _WriteEx_and_Report("",Cmment_S);
        _WriteEx_and_Report("","DID: ",Cmment_D);
        _WriteEx_and_Report("","接收到的数据为 ",Cmment_T);
        if(type == 0)   //正常有效值
        {
          _WriteEx_and_Report("","预期结果为 %.2f",Ex_Value);
          _WriteEx_and_Report("","实际结果为 %.2f",Res1904_Data[swhere_1].Vaule_Now);
          if(Ex_Value <= mixArray[Temp_Possion].DID_Value_min || Ex_Value >= mixArray[Temp_Possion].DID_Value_max)
            _Check_ValueInRange_IsWrite(Res1904_Data[swhere_1].Vaule_Now,Ex_Value,0,Check_Str,0,0);
          else
            _Check_ValueInRange_IsWrite(Res1904_Data[swhere_1].Vaule_Now,Ex_Value,Res1904_Data[swhere_1].Tolerance,Check_Str,0,0);
        }
        else if(type == 1)    // 无效值
        {
          if(mixArray[Temp_Possion].Invalid_LastValue == 0)
          {
            char Ex_Invalid[30];
            char Now_Invalid[30];
            _WriteEx_and_Report("","使用无效值");
            snprintf(Ex_Invalid,elCount(Ex_Invalid),"%s","");
            snprintf(Now_Invalid,elCount(Now_Invalid),"%s","");
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            {
//              Invalid_Value_ = Invalid_Value_ +  Res1904_Data[swhere_1].Res_DID_Data[n]<<(8*(Res1904_Data[swhere_1].Res_DID_Data_Len - n - 1));
              snprintf(Now_Invalid,elCount(Now_Invalid),"%s%02X",Now_Invalid,Res1904_Data[swhere_1].Res_DID_Data[n]);
            }
            ltoa(mixArray[Temp_Possion].Invalid,Ex_Invalid,16);
            _Str_Upper(Ex_Invalid);
            _WriteEx_and_Report("","预期结果为 ",Ex_Invalid);
            _WriteEx_and_Report("","实际结果为 ",Now_Invalid);
//            if(Invalid_Value_ != mixArray[Temp_Possion].Invalid)
            if((strncmp(Ex_Invalid,Now_Invalid,strlen(Ex_Invalid)) != 0))
              testStepFail(Check_Str,"无效值状态异常,期望无效值为 %s ,实际无效值为 %s",Ex_Invalid,Now_Invalid);
//              testStepFail(Check_Str,"无效值状态异常,期望无效值为0x%X,实际无效值为0x%X",mixArray[Temp_Possion].Invalid,Invalid_Value_);
            else
              testStepPass(Check_Str,"无效值与期望一致,为 %s",Now_Invalid);
//              testStepPass(Check_Str,"无效值与期望一致,为0x%X",Invalid_Value_);
          }
          else   //最后一次有效值
          {
            /************************待完善*************************/
          }
        }
        else if(type == 2)    // 仅获取值并打印到报告中,不判断
        {
          char comment[200];
          snprintf(comment,elCount(comment),"%s","");
          snprintf(comment,elCount(comment),"%s  获取到的数据为",Check_Str);
          _WriteEx_and_Report("","实际结果为 %.2f",Res1904_Data[swhere_1].Vaule_Now);
          _WriteEx_and_Report("","解析后的值为 %.2f",Check_Str,Res1904_Data[swhere_1].Vaule_Now);
          for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            snprintf(comment,elCount(comment),"%s %02X",comment,Res1904_Data[swhere_1].Res_DID_Data[n]);
          testCaseComment(comment);
          writeEx(-3,0,comment);
        }
      }
    }
  }
}

void Init_For_Snapshot()
{
  int i;
  if(State_Loop == 0)
  {
    for(i=0;i<DTC_19_Count;i++)
    {
      if(DTC_19[i][0]==Node_1904)
      {
        Node_1904_Pos = i;
        break;
      }
    }
    State_Loop = 1;
  }
}

_get_NRC11(dword ID)
{
  message 0x00 msg;
  double starttime;
  double endtime1;
  double endtime2;
  byte result;
  byte sid;
  sid=DiagGetPrimitiveByte(SendData,0);
  starttime=(double)timeNow()/100;
  result=testWaitForMessage(Response_ID,p2cmax);
  if(ID==phyreq_ID)
  {
    if(result==1)
    {
      endtime1=(double)timeNow()/100;
      testGetWaitEventMsgData(msg);
      if((msg.byte(0)==0x03)&&(msg.byte(1)==0x7F)&&(msg.byte(2)==sid)&&(msg.byte(3)==0x11))
      {
        testStepPass("","收到否定响应NRC11");
        if((endtime1-starttime)<=p2cmax)
          testStepPass("","NRC11实际响应时间为%fms",endtime1-starttime);
        else
          testStepFail("","NRC11实际响应时间为%fms",endtime1-starttime);
      }
      else
        testStepFail("","收到非NRC11响应");
    }
    else
    {
      testStepFail("","未在规定时间内收到响应");
      return;
    }
  }
  else if(ID == funreq_ID)
  {
    if(result==1)
    {
      endtime1=(double)timeNow()/100;
      testGetWaitEventMsgData(msg);
      if((msg.byte(0)==0x03)&&(msg.byte(1)==0x7F)&&(msg.byte(2)==sid)&&(msg.byte(3)==0x11))
      {
        testStepFail("","收到否定响应NRC11");
        if((endtime1-starttime)<=p2cmax)
          testStepPass("","NRC11实际响应时间为%fms",endtime1-starttime);
        else
          testStepFail("","NRC11实际响应时间为%fms",endtime1-starttime);
      }
      else
        testStepFail("","收到非NRC11响应");
    }
    else
    {
      testStepPass("","功能寻址下NRC11不响应");
      return;
    }
  }
}

void Wait(dword Time)
{
  if(Time <= 0)
    Time = 1;
  _WriteEx_and_Report("","等待 %d ms",Time);
  testWaitForTimeout(Time);
}

void EOL_Serve_22_Send(byte Send_Num[])
{
  char Str_22_Send[30];
