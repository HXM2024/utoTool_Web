void _Ang_Calibration_()
{
  Get_value();
  diagSetTarget(Cdd_Name);
  _get_Arry("Angle_Calibration");
  if(Arry_Len>0)
  {
    _unlockECU();
    _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
  }
}
/*
    清除对中
*/
void _ClearAngle(int Type)
{
  int FunPos;
  dword RID;
  if(Type == 0)
  {
    Get_value();_Init_Struct();
    diagSetTarget(Cdd_Name);
  }
  _get_Arry("Clear_Angle_Calibration");
  if(Arry_Len>0)
  {
    RID = (Arry_Data[2]<<8)|(Arry_Data[3]);
    FunPos = _Check_Serve(0x01,RID,12);
    if(FunPos != -1)
    {
      if(Serve_31_Hex[FunPos].Security_Access[0] == 1)
        _unlockECU();
      _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
      _Check_31Routine_Rx(Arry_Data,1);
    }
  }
}

/// <Node>
/*
  获取节点所在位置
  Node 节点
  Type = 1：DTC丢失数组
*/
int Get_Node_Pos(dword Node,byte Type)
{
  int i,Return_Value;
  Return_Value = -1;
  if(Type == 1)
  {
    for(i=0;i<DTC_19_Count;i++)
    {
      if(DTC_19[i][0]==Node)
        break;
    }
    Return_Value = i;
  }
  if(Return_Value == -1)
  {
    _WriteEx_and_Report("","未查询到节点 0x%03X",Node);
    Return_Value = 0;
  }
  return Return_Value;
}
/*
  验证输入数据是否为特殊数据处理
*/
void _Clear_Config(byte Data[],byte Session)
{  
  if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
  {
    byte Clear_[0xB] = {0x2E,0xF1,0xA1,0,0,0,0,0,0,0,0x55};
    if((Data[1] == 0x21 && Data[2] == 0x00) || (Data[1] == 0xF1 && Data[2] == 0xA1))
    {
      _WriteEx_and_Report("","BYD配置字需先擦除再写入");
      _unlockECU();
      _Send_Diag(0xB,phyreq_ID,Clear_);
      _TestResult(SendData,phyreq_ID,"",-1);
      if(Session != exsession)
        _SetSession(Session);
      _WriteEx_and_Report("","擦除完成");
    }
  }
}

/// <NRC优先级>
/*---------------------------------------------NRC优先级-------------------------------*/
/*
  NRC优先级测试步骤
  Serve：服务
  Pos：子功能
  Type：获取NRC数据方式
*/
_Set_NRC_Step(byte Serve,dword Pos,byte Type,byte Send_Data[]) 
{
  int k;
  int Routine_Pos,Control_Type_Pos;
  NRC31_Count = 0;
  NRC13_Count = 0;
  NRC31_total = 0;
  NRC13_total = 0;
  Serve_31_Len4_5 = 0;
  _Get_NRC_Mapping(Serve);
  if(Serve != 0x31 && Type != 0) 
    _Check_Serve(Serve,Pos,Type); //获取NRC列表装载到Fun_NRC中
  if(Type == 0)  /*对默认会话下的10 02特殊处理*/
  {
    _get_Arry("Def_1002_NRC");
    for(k=0;k<Arry_Len;k++)
      Fun_NRC[k] = Arry_Data[k];
    Fun_NRC_Count = Arry_Len;
  }
  if(Send_Data[0] == 0x31)
  {
    byte Da_1,Da_2;
    Da_1 = (Pos>>8)&0xFF;
    Da_2 = Pos&0xFF;
    Send_Data[0] = 0x31;
    Routine_Pos = -1;
    Control_Type_Pos = -1;
    for(k=0;k<Serve_31_Hex_Count;k++)
    {
      if((Serve_31_Hex[k].Routine[0] == Da_1) && (Serve_31_Hex[k].Routine[1] == Da_2))
      {
        Routine_Pos = k;
        break;
      }
    }
    if(Routine_Pos == -1)
      return;
    for(k=0;k<Serve_31_Hex[Routine_Pos].Control_Type_Count;k++)
    {
      if(Serve_31_Hex[Routine_Pos].Control_Type[k] == Type)
      {
        Control_Type_Pos = k;
        break;
      }
    }
    Len_31H = Serve_31_Hex[Routine_Pos].Routine_Len;
    for(k=0;k< Serve_31_Hex[Routine_Pos].Serve_NRC_Count[Control_Type_Pos];k++)
      Fun_NRC[k] = Serve_31_Hex[Routine_Pos].Serve_NRC[Control_Type_Pos][k];
    Fun_NRC_Count = Serve_31_Hex[Routine_Pos].Serve_NRC_Count[Control_Type_Pos];
    Serve_31_Len4_5 = _Get_31H_Len4AndLen5(); /*检测31服务是否同时存在长度为4和5两种情况*/
  }
  else
    Send_Data[0] = Serve;
  for(k=Fun_NRC_Count-1;k>=0;k--)  //获取共多少个NRC13或NRC31
  {
    if(Fun_NRC[k]==0x13)
      NRC13_total++;
    else if(Fun_NRC[k]==0x31)
      NRC31_total++;
  }
  for(k=Fun_NRC_Count-1;k>=0;k--)
  {
    if(Send_Data[0] == 0x31)
    {
      if(Fun_NRC[k]==0x22) //31服务NRC22
      {
        if(Serve_31_NewNRC22 == 1)
          _Geely_NewNRC22(Fun_NRC[k],1);
        else
          _Set_NRC22(1,Pos,0);
      }
      else if(Fun_NRC[k]==0x31 && NRC31_total==1) //RID无效
      {
        if(Len_31H == 5 && Serve_31_Len4_5 == 1 && NRC13_total == 1)/*当出现31服务中既有长度为4又存在长度为5时,RID无效会导致NRC13*/
        {
          Send_Data[2] = Serve_31_Hex[Routine_Pos].Routine[0];
          Send_Data[3] = Serve_31_Hex[Routine_Pos].Routine[1];
          Send_Data[4] = _Get_Invalid_RID_Control_Option(Serve,Pos,Type,0);
        }
        else
        {
          Send_Data[3] = _Get_Invalid_RID();
          if(Len_31H == 5)
            Send_Data[4] = _Get_Invalid_RID_Control_Option(Serve,Pos,Type,0);
        }
      }
      else if(Fun_NRC[k]==0x31 && NRC31_Count==0 && NRC31_total==2) //RID无效
      {
        Send_Data[3] = _Get_Invalid_RID();
        NRC31_Count++;
      }
      else if(Fun_NRC[k]==0x31 && NRC31_Count==1 && NRC31_total==2) //控制选项无效
      {
        Send_Data[4] = _Get_Invalid_RID_Control_Option(Serve,Pos,Type,0);
        NRC31_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_Count==0 && NRC13_total==2) //total13
      {
        Fun_NRC_Send_Len = _Get_Serve_13_Len(0x31,0,0);
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_Count==1 && NRC13_total==2) //mini13
      {
        Fun_NRC_Send_Len = 3;
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_total==1) //mini13
        Fun_NRC_Send_Len = 3;
      else if(Fun_NRC[k]==0x12) //子功能无效
        Send_Data[1] = _Get_Invalid_RID_Control_Type(Pos);
      else if(Fun_NRC[k]==0x33)
        NRC33_Pos = k; //NRC33所在位置
      else 
      {
        if(Serve_31_NewNRC22 == 1)
          _Geely_NewNRC22(Fun_NRC[k],1);
      }
    }
    else
    {
      if(Fun_NRC[k]==0x13 && NRC13_Count==0 && NRC13_total==2) //total13
      {
        Fun_NRC_Send_Len = _Get_Serve_13_Len(Serve,Pos,0);//遍历该服务下所有支持子功能,并返回最大长度
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_Count==1 && NRC13_total==2) //mini13
      {
        Fun_NRC_Send_Len = _Get_Serve_13_Len(Serve,Pos,1);//遍历该服务下所有支持子功能,并返回最小长度
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_total==1 ) //total13
        Fun_NRC_Send_Len = _Get_Serve_13_Len(Serve,Pos,0);
      else if(Fun_NRC[k]==0x12 ) //子功能无效
        Send_Data[1] = _Get_Invalid_Fun(Serve,0);
      else if(Fun_NRC[k]==0x22 ) //NRC22条件  优先执行前面的0x22条件，不执行后面（若非0x22则执行具体的NRC22操作）
        _Set_NRC22(Serve,Pos,0);
      else if(Fun_NRC[k]==0x31 && NRC31_Count==0 && NRC31_total==2 ) //NRC31条件
      {
        if(Send_Data[0] == 0x23) //子功能无效
          Send_Data[1] = _Get_Invalid_Fun(Serve,0);
        NRC31_Count++;
      }
      else if(Fun_NRC[k]==0x31 && NRC31_Count==1 && NRC31_total==2 ) //NRC31条件
      {
        int i;
        if(Send_Data[0] == 0x23)  //参数地址无效
        {
          for(i=2;i<10;i++)
            Send_Data[i] = 0;
        }
        NRC31_Count++;
      }
      else if(Fun_NRC[k]==0x31 && NRC31_total==1 ) ///NRC31条件
        _Get_Serve_NRC31(Serve,0,Send_Data);
      else
        _NRC22SpecialStep(Fun_NRC[k],0);
    }
  }
  /*清除计数防止后续执行恢复操作时报错*/
  NRC31_Count = 0;
  NRC13_Count = 0;
}
/// <NRC优先级>
/*
  新增,用于特殊NRC22处理，对输入NRC进行匹配
  NRCInput：输入NRC
  Type = 0：制造NRC22条件
  Type = 1：恢复
*/
_NRC22SpecialStep(byte NRCInput,byte Type)
{
  if(Type == 0)
  {
    if(NRCInput == CarSpd_NRC)   //车速过大
      _Set_CarSpd(NRC22_CarSpd+1);
    else if(NRCInput == CarSpd_Invalid_NRC) //车速无效
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
    else if(NRCInput == Ready_NRC)  //发动机
      _Set_Ready(Ready_NRC22);
    else if(NRCInput == Gear_NRC)  //档位
    {
      int i;
      for(i=NRC_22_Gears_Range[0];i<NRC_22_Gears_Range[1];i++)
      {
        if(i != NRC_22_Gears_Normal)
          break;
      }
      _Set_Sig(Gears_Signal,i);
    }
    else if(NRCInput == H_Battery_NRC) //高压
      _Set_Battery(NRC22_Battery_Hight);
    else if(NRCInput == L_Battery_NRC)  //低压
      _Set_Battery(NRC22_Battery_Low);
    else if(NRCInput == TasTorque_NRC)  //力矩
    {
      char Str[200];
      snprintf(Str,elCount(Str),"控制力矩满足NRC22条件,大于 %.2f Nm,并保持",NRC22_TasTorque+0.2);
      testWaitForTesterConfirmation(Str,60000);
    }
    else if(NRCInput == Sensor_NRC)  //传感器
    {
      char Str[200];
      snprintf(Str,elCount(Str),"断开传感器");
      testWaitForTesterConfirmation(Str,60000);
    }
  }
  else if(Type == 1)
  {
    if(NRCInput == CarSpd_NRC)   //车速过大
      _Set_CarSpd(0);
    else if(NRCInput == CarSpd_Invalid_NRC) //车速无效
      _Reset_CarSpd_Invalid();
    else if(NRCInput == Ready_NRC)  //发动机
    {
      if(Ready_NRC22 == Struct_Ready.Ready_Active)
        _Set_Ready(0);
      else
        _Set_Ready(Struct_Ready.Ready_Active);
    }
    else if(NRCInput == Gear_NRC)  //档位
      _Set_Sig(Gears_Signal,NRC_22_Gears_Normal);
    else if(NRCInput == H_Battery_NRC) //高压
      _Set_Battery(12);
    else if(NRCInput == L_Battery_NRC)  //低压
      _Set_Battery(12);
    else if(NRCInput == TasTorque_NRC)  //力矩
    {
      char Str[200];
      snprintf(Str,elCount(Str),"松开方向盘");
      testWaitForTesterConfirmation("松开方向盘",60000);
    }
    else if(NRCInput == Sensor_NRC)  //传感器
    {
      char Str[200];
      snprintf(Str,elCount(Str),"恢复传感器");
      testWaitForTesterConfirmation(Str,60000);
    }
  }
}
/// <NRC优先级>
_Recover_NRC_Step(byte NRC,byte Pos,dword Fun_Pos,byte Send_Data[]) // Pos为所在结构体位置
{
  dword Fun_;
  if(Send_Data[0] != 0x31)
    Fun_ = Serve_Data[Pos].Serve_Fun[Fun_Pos];
  if( NRC == 0x33 )
  {
    NRC22_Recover_Sense = 1;
    _unlockECU();
  }
  /*---------------------------31服务------------------------*/
  else if(NRC != 0x33 && Send_Data[0] == 0x31)
  {
    if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==0)
    {
      Fun_NRC_Send_Len = Len_31H +1;
      NRC13_Count++;
    }
    else if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==1)
    {
      Fun_NRC_Send_Len = Len_31H;
      NRC13_Count++;
    }
    else if( NRC == 0x13 && NRC13_total ==1)
    {
      Fun_NRC_Send_Len = Len_31H;
    }
    else if( NRC == 0x31 && NRC31_total ==1)
    {
      if(Len_31H == 5 && Serve_31_Len4_5 == 1 && NRC13_total == 1)/*当出现31服务中既有长度为4又存在长度为5时,RID无效会导致NRC13*/
        Send_Data[4] = _Get_Invalid_RID_Control_Option(Send_Data[0],Pos,0,1);
      else
      {
        Send_Data[2] = Serve_31_Hex[Pos].Routine[0];
        Send_Data[3] = Serve_31_Hex[Pos].Routine[1];
        Send_Data[4] = _Get_Invalid_RID_Control_Option(Send_Data[0],Pos,0,1);
      }
    }
    else if( NRC == 0x31 && NRC31_Count==0 && NRC31_total == 2)
    {
      Send_Data[2] = Serve_31_Hex[Pos].Routine[0];
      Send_Data[3] = Serve_31_Hex[Pos].Routine[1];
      NRC31_Count++;
    }
    else if( NRC == 0x31 && NRC31_Count==1 && NRC31_total == 2)
    {
      Send_Data[4] = _Get_Invalid_RID_Control_Option(Send_Data[0],Pos,0,1);
      NRC31_Count++;
    }
    else if( NRC == 0x12)
    {
      Send_Data[1] = Serve_31_Hex[Pos].Control_Type[0];
    }
    else if( NRC == 0x22)
    {
      if(Serve_31_NewNRC22 == 1)
        _Geely_NewNRC22(NRC,1);
      else
        _Set_NRC22(Serve_31_Hex[Pos].Control_Type[0],Fun_Pos,1);
    }
    else 
    {
      if(Serve_31_NewNRC22 == 1)
        _Geely_NewNRC22(NRC,0);
    }
  }
  /*---------------------------非31服务------------------------*/
  else if(NRC != 0x33 && Send_Data[0] != 0x31)
  {
    if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==0)
    {
      Fun_NRC_Send_Len =  _Get_Serve_13_Len(Send_Data[0],Fun_,0);
      NRC13_Count++;
    }
    else if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==1)
    {
      Fun_NRC_Send_Len =  _Get_Serve_13_Len(Send_Data[0],Fun_,2);
      NRC13_Count++;
    }
    else if( NRC == 0x13 && NRC13_total ==1)
    {
      Fun_NRC_Send_Len =  _Get_Serve_13_Len(Send_Data[0],Fun_,2);
    }
    else if( NRC == 0x31 && NRC31_total ==1)
    {
      _Get_Serve_NRC31(Send_Data[0],1,Send_Data);
    }
    else if( NRC == 0x31 && NRC31_total ==2 && NRC31_Count==0)
    {
      if(Send_Data[0] == 0x23) //子功能无效
        Send_Data[1] = _Get_Invalid_Fun(0x23,1);
      NRC31_Count++;
    }
    else if( NRC == 0x31 && NRC31_total ==2 && NRC31_Count==1)
    {
      if(Send_Data[0] == 0x23) //子功能无效
      {
        int i;
        for(i=0;i<4;i++) //默认地址占4个长度
          Send_Data[i+2] = (Struct_VBF_Addr[0].StartAddr[0]>>((4-i-1)*8)&0xFF);
        Send_Data[6] = 0;
        Send_Data[7] = 3;
      }
      NRC31_Count++;
    }
    else if( NRC == 0x12)
      Send_Data[1] = Serve_Data[Pos].Serve_Fun[Fun_Pos];
    else if( NRC == 0x24 && Send_Data[0]==0x27 )
      _get_seed(phyreq_ID);
    else if( NRC == 0x22)
      _Set_NRC22(Send_Data[0],Fun_,1);
    else if( NRC == 0x10 && Send_Data[0]==0X2E)
      _Get_Serve_NRC10(Send_Data[0],1,Fun_NRC_Send_Len,10,Send_Data);
    else
      _NRC22SpecialStep(NRC,1);
  }
}

/// <NRC优先级>
/*
  NRC优先级测试步骤
  Serve：服务
  Pos：子功能
  Type：获取NRC数据方式
*/
_Set_NRC_Special_Step(byte Serve,dword Pos,byte Type,byte Send_Data[]) 
{
  int k;
  int Routine_Pos,Control_Type_Pos;
  byte Flage,Step;
  if(Serve != 0x31 && Type != 0) 
    _Check_Serve(Serve,Pos,Type); //获取NRC列表装载到Fun_NRC中
  if(Send_Data[0] == 0x31)
  {
    byte Da_1,Da_2;
    Da_1 = (Pos>>8)&0xFF;
    Da_2 = Pos&0xFF;
    Send_Data[0] = 0x31;
    Routine_Pos = -1;
    Control_Type_Pos = -1;
    for(k=0;k<Serve_31_Hex_Count;k++)
    {
      if((Serve_31_Hex[k].Routine[0] == Da_1) && (Serve_31_Hex[k].Routine[1] == Da_2))
      {
        Routine_Pos = k;
        break;
      }
    }
    if(Routine_Pos == -1)
      return;
    for(k=0;k<Serve_31_Hex[Routine_Pos].Control_Type_Count;k++)
    {
      if(Serve_31_Hex[Routine_Pos].Control_Type[k] == Type)
      {
        Control_Type_Pos = k;
        break;
      }
    }
    Len_31H = Serve_31_Hex[Routine_Pos].Routine_Len;
    
    for(k=0;k< Serve_31_Hex[Routine_Pos].Serve_NRC_Special_Count[Control_Type_Pos];k++)
      Fun_NRC[k] = Serve_31_Hex[Routine_Pos].Serve_NRC_Special[Control_Type_Pos][k];
    Fun_NRC_Count = Serve_31_Hex[Routine_Pos].Serve_NRC_Special_Count[Control_Type_Pos];
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","无特殊优先级输入,跳过测试");
      return;
    }
  }
  else
    Send_Data[0] = Serve;
  Flage = 0;
  Step = 0;
  if((_Check_NRC_In_31H(Pos,0,0X92) != -1) && (_Check_NRC_In_31H(Pos,0,0X93) != -1)) //两个电压同时存在
    Flage = 1;
  for(k=0;k<Fun_NRC_Count;k++)
  {
    if(Send_Data[0] == 0x31)
    {
      if((Fun_NRC[k]==0x92 || Fun_NRC[k]==0x93) && Flage == 1)
      { }
      else
        _Geely_NewNRC22(Fun_NRC[k],1);
    }
    else
    {
      
    }
  }
  /*清除计数防止后续执行恢复操作时报错*/
  NRC31_Count = 0;
  NRC13_Count = 0;
}

/// <NRC优先级>
_Recover_NRC_Special_Step(byte NRC,byte Send_Data[]) // Pos为所在结构体位置
{
  byte Flage,Step;
  dword Pos;
  Pos = ((Send_Data[2]<<8)|(Send_Data[3]));
  Flage = 0;
  Step = 0;
  if((_Check_NRC_In_31H(Pos,0,0X92) != -1) && (_Check_NRC_In_31H(Pos,0,0X93) != -1)) //两个电压同时存在
    Flage = 1;
  if( NRC == 0x33 )
  {
    NRC22_Recover_Sense = 1;
    _unlockECU();
  }
  /*---------------------------31服务------------------------*/
  else if(NRC != 0x33 && Send_Data[0] == 0x31)
  {
    if((NRC==0x92 || NRC==0x93) && Flage == 1)
    {
      if(Step == 0)
      {
        _Geely_NewNRC22(NRC,1);
        Step++;
      }
      else if(Step == 1)
        _Geely_NewNRC22(NRC,0);
    }
    else
      _Geely_NewNRC22(NRC,0);
  }
  /*---------------------------非31服务------------------------*/
  else if(NRC != 0x33 && Send_Data[0] != 0x31)
  {
    
  }
}


/// <NRC优先级>
/*
  NRC10
  Type_ = 0：制造NRC10
  Type_ = 1: 恢复
  Len_Ex 数组长度
  Check_Pos：校验位所在位置
  Data数组,装载修改值
*/

void _Get_Serve_NRC10(byte Serve,byte Type_,byte Len_Ex,byte Check_Pos,byte Data[])
{
  int Serve_Pos_;
  int Fun_;
  Serve_Pos_ = _Check_Serve(Serve,0,0);
  if(Type_ == 0)
  {
    Data[Check_Pos] = 0;
  }
  else if(Type_ == 1)
  {
    if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
    {
      int i;
      dword Temp;
      Temp = 0;
      for(i=3;i<Len_Ex-1;i++)
        Temp = (Temp + Data[i])&0xFF;
      Temp = (Temp^0x55) &0xFF;
      Data[Check_Pos] = Temp;
    }
  }
}
/// <NRC优先级>
/*
  NRC31操作
  Type_ = 0：制造NRC31
  Type_ = 1: 恢复
  Data数组,装载修改值
*/
void _Get_Serve_NRC31(byte Serve,byte Type_,byte Data[])
{
  int Serve_Pos_;
  int Fun_;
  int n;
  Serve_Pos_ = _Check_Serve(Serve,0,0);
  if(Type_ == 0)
  {
    if(Serve == 0x2E)
    {
      do{
        Fun_ = random(0XFFFF);
      }while(_Check_Serve(Serve,Fun_,4)==1);
      Data[1] = (Fun_>>8);
      Data[2] = (Fun_&0xFF);
    }
    else if(Serve == 0x22)
    {
      do{
        Fun_ = random(0XFFFF);
      }while(_Check_Serve(Serve,Fun_,4)==1);
      Data[1] = (Fun_>>8);
      Data[2] = (Fun_&0xFF);
    }
    else if(Serve == 0x28)
    {
      for(Fun_=0;Fun_<0xFF;Fun_++)
      {
        for(n=0;n<Serve_Data[Serve_Pos_].Serve_Para_Count[0];n++)
        {
          if(Fun_ == Serve_Data[Serve_Pos_].Serve_Para[0][n])
            break;
        }
        if(n==Serve_Data[Serve_Pos_].Serve_Para_Count[0])
          break;
      }
      Data[2] = Fun_;
    }
    else if(Serve == 0x19)
    {
      byte DTC_H;
      dword Range;
      DTC_H = (DTC_19[1][1]>>16);
      do{
          Range = random(0xFFFFFE);
      }while(Range<(DTC_H) || ( _Check_Dword_in_Num(Range,ALL_DTC,ALL_DTC_Num)!=-1));
      Data[2] = (Range>>16);
      Data[3] = (Range>>8);
      Data[4] = (Range&0xFF);
      do{
          DTC_H = random(0xFF);
      }while(_Check_ByteIn19(Data[1],DTC_H)!=-1);
      Data[5] = DTC_H;
    }
    else if(Serve == 0x14)
    {
      for(n=1;n<4;n++)
        Data[n] = 0;
    }
  }
  else if(Type_ == 1)
  {
    if(Serve == 0x2E)
    {
      Data[1] = (Serve_Data[Serve_Pos_].Serve_Fun[0]>>8);
      Data[2] = (Serve_Data[Serve_Pos_].Serve_Fun[0]&0xFF);
    }
    else if(Serve == 0x28)
    {
      Data[2] = Serve_Data[Serve_Pos_].Serve_Para[0][0];
    }
    else if(Serve == 0x22)
    {
      Data[1] = (Serve_Data[Serve_Pos_].Serve_Fun[0]>>8);
      Data[2] = (Serve_Data[Serve_Pos_].Serve_Fun[0]&0xFF);
    }
    else if(Serve == 0x19)
    {
      byte DTC_H,DTC_M,DTC_L;
      DTC_H = (DTC_19[1][1]>>16);
      DTC_M = (DTC_19[1][1]>>8);
      DTC_L = (DTC_19[1][1]&0xFF);
      Data[2] = DTC_H;
      Data[3] = DTC_M;
      Data[4] = DTC_L;
    }
    else if(Serve == 0x14)
    {
      for(n=1;n<4;n++)
        Data[n] = 0xFF;
    }
  }
}
/// <NRC优先级>
/*
  Type_ = 0:获取Total 13 长度
  Type_ = 1:获取Mini 13 长度
  Type_ = 2:获取正常 长度
*/
dword _Get_Serve_13_Len(byte Serve,dword Fun,byte Type_)
{
  int Return_Len;
  if(Serve != 0x31)
  {
    int Temp_Len;
    int Loop_Get_Max, Serve_Poss_,Fun_Pos_;
    Serve_Poss_ = _Check_Serve(Serve,0,0);
    Fun_Pos_ = _Check_Serve(Serve,Fun,4);
    for(Loop_Get_Max=0;Loop_Get_Max<Serve_Data[Serve_Poss_].Serve_Fun_Count;Loop_Get_Max++)
    {
      Temp_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Loop_Get_Max];
      if(Loop_Get_Max == 0)
        Return_Len = Temp_Len;
      if(Type_ == 0)
      {
        if(Temp_Len>=Return_Len)
          Return_Len = Temp_Len;
      }
      else if(Type_ == 1)
      {
        if(Temp_Len<=Return_Len)
          Return_Len = Temp_Len;
      }
      else if(Type_ == 2)
      {
        //Return_Len = Temp_Len;
        Return_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Fun_Pos_];
        break;
      }
    }
    if(Type_ == 0)
      Return_Len = Return_Len +1;
    else if(Type_ == 1)
      Return_Len = Return_Len -1;
    if(Type_ == 0 && Serve == 0x22)
    {
      Return_Len = (DID_22_Support+1)*2+1;
    }
    if(Type_ == 1 && Serve == 0x2E)
      Return_Len = 3;
    else if(Type_ == 0 && Serve == 0x2E)
      Return_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Fun_Pos_]+1;
    else if(Type_ == 2 && Serve == 0x2E)
      Return_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Fun_Pos_];
  }
  else
  {
    int Temp_Len;
    int Loop_Get_Max;
    if(Type_ == 0)
    {
      for(Loop_Get_Max = 0;Loop_Get_Max<Serve_31_Hex_Count;Loop_Get_Max++)
      {
        Temp_Len = Serve_31_Hex[Loop_Get_Max].Routine_Len;
        if(Loop_Get_Max == 0)
          Return_Len = Temp_Len;
        else
        {
          if(Temp_Len>Return_Len)
            Return_Len = Temp_Len;
        }
      }
      Return_Len +=1;
    }
  }
  return Return_Len;
}
/// <NRC优先级>
/*
    Type = 1 最大长度
    Type = 0 最小长度
*/
int Get_ServeMaxLen(byte Serve,byte Type)
{
  int Return_Len,Serve_Pos;
  int i,MinLen,MaxLen,TempLen;
  if(Serve != 0x31)
  {
    Serve_Pos = _Check_Serve(Serve,0,0);
    if(Serve_Pos == -1)
      return 0;
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      if(i==0)
      {
        MinLen  = Serve_Data[Serve_Pos].Serve_Fun_Len[i];
        MaxLen  = Serve_Data[Serve_Pos].Serve_Fun_Len[i];
        TempLen = Serve_Data[Serve_Pos].Serve_Fun_Len[i];
      }
      else
      {
        TempLen = Serve_Data[Serve_Pos].Serve_Fun_Len[i];
        MinLen = (TempLen<=MinLen)?TempLen:MinLen;
        MaxLen = (TempLen>=MaxLen)?TempLen:MaxLen;
      }
    }
  }
  else
  {
    for(i=0;i<Serve_31_Hex_Count;i++)
    {
      if(i==0)
      {
        MinLen  = Serve_31_Hex[i].Routine_Len;
        MaxLen  = Serve_31_Hex[i].Routine_Len;
        TempLen = Serve_31_Hex[i].Routine_Len;
      }
      else
      {
        TempLen = Serve_31_Hex[i].Routine_Len;
        MinLen = (TempLen<=MinLen)?TempLen:MinLen;
        MaxLen = (TempLen>=MaxLen)?TempLen:MaxLen;
      }
    }
  }
  Return_Len = (Type == 0)?MinLen:MaxLen;
  return Return_Len;
}
/// <NRC优先级>
/*
  获取子功能
  Type_ = 0:无效子功能
  Type_ = 1:正常子功能
*/
byte _Get_Invalid_Fun(byte Serve,byte Type_)  
{
  int Loop_Get_Max,Fun_Count;
  int Serve_Poss_;
  byte Return_Fun;
  dword hash[0xffff];
  Return_Fun = 0;
  Serve_Poss_ = _Check_Serve(Serve,0,0);
  for(Fun_Count = 0;Fun_Count<Serve_Data[Serve_Poss_].Serve_Fun_Count;Fun_Count++)
  {
    hash[Serve_Data[Serve_Poss_].Serve_Fun[Fun_Count]] = 1;
  }
  
  for(Loop_Get_Max=1;Loop_Get_Max<=0xFF;Loop_Get_Max++)
  {
    if(Type_ == 0 )
    {
      if(hash[Loop_Get_Max] != 1)
      {
        Return_Fun  = Loop_Get_Max;
        break;
      }
    }
    else
    {
      if(hash[Loop_Get_Max] == 1)
      {
        Return_Fun  = Loop_Get_Max;
        break;
      }
    }
  }
  if(Serve == 0x19 && Type_ == 0)
    Return_Fun = 0x05;
  else if(Serve == 0x19 && Type_ == 1)
    Return_Fun = 0x04;
  return Return_Fun;
}
/// <NRC优先级>
/*
  获取无效的RID
*/
byte _Get_Invalid_RID()   
{
  int n,m;
  for(n=0;n<=0xFF;n++)
  {
    for(m=0;m<Serve_31_Hex_Count;m++)
    {
      if( n== Serve_31_Hex[m].Routine[1])
        break;
    }
    if(m >= Serve_31_Hex_Count)
      return n;
  }
   return 0;
}

/// <NRC优先级>
/*
  获取无效的控制类型
*/
byte _Get_Invalid_RID_Control_Type(dword Pos)  
{
  int n,m;
  int i,RID_Pos_;
  byte Data[2];
  Data[0] = (Pos>>8)&0xFF;
  Data[1] = Pos &0xFF;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    if((Serve_31_Hex[i].Routine[0] == Data[0]) && (Serve_31_Hex[i].Routine[1] == Data[1]))
    {
      RID_Pos_ = i;
      break;
    }
  }
  Pos = RID_Pos_;
  for(n=1;n<=0xFF;n++)
  {
    for(m=0;m<Serve_31_Hex[Pos].Control_Type_Count;m++)
    {
      if(n == Serve_31_Hex[Pos].Control_Type[m])
        break;
    }
    if(m >= Serve_31_Hex[Pos].Control_Type_Count)
      return n;
  }
  return 0;
}

/// <NRC优先级>
/*
  获取控制选项
 Type = 0:获取无效的控制选项
 Type = 1:获取正常的控制选项
*/
byte _Get_Invalid_RID_Control_Option(byte Serve,dword Pos,byte Control_Ty,byte Type)  
{
  int n,m;
  int RID_Pos_,Control_Type_Pos;
  byte Data[2];
  Data[0] = (Pos>>8)&0xFF;
  Data[1] = Pos &0xFF;
  for(m=0;m<Serve_31_Hex_Count;m++)
  {
    if((Serve_31_Hex[m].Routine[0] == Data[0]) && (Serve_31_Hex[m].Routine[1] == Data[1]))
    {
      RID_Pos_ = m;
      break;
    }
  }
  for(m=0;m<Serve_31_Hex[RID_Pos_].Control_Type_Count;m++)
  {
    if(Serve_31_Hex[RID_Pos_].Control_Type[m] == Control_Ty)
      break;
  }
  Control_Type_Pos = m;
  if(m>=Serve_31_Hex[RID_Pos_].Control_Type_Count)
    Control_Type_Pos = 0;
  if(Type == 0)
  {
    for(m=0;m<0xFF;m++)
    {
      for(n=0;n<Serve_31_Hex[RID_Pos_].Control_Option_Count[Control_Type_Pos];n++)
      {
        if(m==Serve_31_Hex[RID_Pos_].Control_Option[Control_Type_Pos][n])
          break;
      }
      if(n >= Serve_31_Hex[RID_Pos_].Control_Option_Count[Control_Type_Pos])
        return m;
    }
  }
  else
  {
    return Serve_31_Hex[RID_Pos_].Control_Option[Control_Type_Pos][0];
  }
  return 0;
}
/// <NRC优先级>
/*
    检测31服务中是否同时存在长度为4和长度为5的数据
*/
byte _Get_31H_Len4AndLen5()  
{
  int m,Len_4_Flage,Len_5_Flage;
  Len_4_Flage = 0;
  Len_5_Flage = 0;
  for(m=0;m<Serve_31_Hex_Count;m++)
  {
    if(Serve_31_Hex[m].Routine_Len == 4)
      Len_4_Flage = 1;
    else if(Serve_31_Hex[m].Routine_Len == 5)
      Len_5_Flage = 1;
  }
  if(Len_4_Flage == 1 && Len_5_Flage == 1)
    return 1;
  else
    return 0;
}
/// <NRC优先级>
/*
    吉利新NRC22匹配
    Type = 1：制造NRC条件
    Type = 0：恢复
*/
int _Geely_NewNRC22(byte NRC,byte Type)
{
  int Return_Value;
  Return_Value = NRC;
  if(NRC == 0x88)
  {
    if(Type == 1)
      _Set_CarSpd(NRC22_CarSpd+1);
    else if(Type == 0)
      _Set_CarSpd(0);
  }
  else if(NRC == 0x92)
  {
    if(Type == 1)
      _Set_Battery(NRC22_Battery_Hight+0.2);
    else if(Type == 0)
      _Set_Battery(12);
  }
  else if(NRC == 0x93)
  {
    if(Type == 1)
      _Set_Battery(NRC22_Battery_Low-0.2);
    else if(Type == 0)
      _Set_Battery(12);
  }
  else if(NRC == 0xF2)
  {
    if(Type == 1)
      _Set_CarSpd_Invalid(Struct_CarSpd.Invalid_Value[0]);
    else if(Type == 0)
      _Reset_CarSpd_Invalid();
  }
  else if(NRC == 0x84)
  {
    if(Type == 1)
      _Set_Ready(0);
    else if(Type == 0)
      _Set_Ready(Struct_Ready.Ready_Active);
  }
  else if(NRC == 0x22)
  {
    /*此处暂时屏蔽工厂模式部分*/
    if(Type == 1)
    {
      if(Serve_31_NRC22 == 0)
        _Set_Ready(0);
//      else if(Serve_31_NRC22 == 1)
//        _Factory_Mode(0);
    }
    else if(Type == 0)
    {
      if(Serve_31_NRC22 == 0)
        _Set_Ready(Struct_Ready.Ready_Active);
//      else if(Serve_31_NRC22 == 1)
//        _Factory_Mode(1);
    }
  }
  return Return_Value;
}
/// <NRC优先级>
/*
  获取NRC22条件并进行设置
  Serve: 服务
  Fun：子功能
  Type = 0：满足NRC22条件
  Type = 1：恢复NRC22条件
  Type = 2：查询NRC22条件
*/
int _Set_NRC22(byte Serve, dword Fun,byte Type)
{
  int Serve_Pos_22,Fun_Pos_22,Loop_22,NRC22_Flage;
  int Temp_NRC22;
  char Str_22[50];
  NRC22_Flage = 0;
  snprintf(Str_22,elCount(Str_22),"%s","");
  Fun_Pos_22 = -1;
  Serve_Pos_22 = -1;
  if(Fun<=0xFF)
    snprintf(Str_22,elCount(Str_22),"%s0x%02X 0x%02X",Str_22,Serve,Fun);
  else
    snprintf(Str_22,elCount(Str_22),"%s0x%02X 0x%02X 0x%02X",Str_22,Serve,(Fun>>8),(Fun & 0xFF));
  if((Serve != 0x01) && (Serve != 0x03))
  {
    Serve_Pos_22 = _Check_Serve(Serve,Fun,0);
    Fun_Pos_22 = _Check_Serve(Serve,Fun,4);
    if(Serve == 0x14)
      Fun_Pos_22 = 0;
    if(Fun_Pos_22 == -1)
    {
      _WriteEx_and_Report(Str_22,"未查询到该子功能");
      return -1;
    }
    else
    {
      NRC22_Flage = Serve_Data[Serve_Pos_22].Serve_NRC22[Fun_Pos_22]; //由查询NRC序列列表改为直接获取对应的条件
      if(Type == 2)
      {
        return NRC22_Flage;  //提前结束返回，不进行操作
      }
      if(NRC22_Flage == 0)
      {
        _WriteEx_and_Report(Str_22,"未查询到NRC22条件");
        return -1;
      }
      else
      {
        Temp_NRC22 = Serve_Data[Serve_Pos_22].Serve_NRC22[Fun_Pos_22];
        if(Type == 0)//满足NRC22
        {
          if((Temp_NRC22 & 0x1) != 0)//车速
          {
            _Set_CarSpd(NRC22_CarSpd+1);
            return 1;
          }
          else if((Temp_NRC22 & 0x20) != 0 ) //发动机
          {
            _Set_Ready(Ready_NRC22);
            return 0x20;
          }
          else if((Temp_NRC22 & 0x08) != 0 ) //档位
          {
            _Set_Gears(NRC_22_Gears_Normal+1);
            return 8;
          }
          else if((Temp_NRC22 & 0x02) != 0 ) //电压
          {
            _Set_Battery(NRC22_Battery_Hight+1);
            return 2;
          }        
          else if((Temp_NRC22 & 0x10) != 0 ) //传感器
          {
            diagStartTesterPresent(Cdd_Name);
            _TestWaitForTesterConfirmation("拔掉传感器");
            diagStopTesterPresent(Cdd_Name);
            return 16;
          }
          else if((Temp_NRC22 & 0x04) != 0 ) //手力矩
          {
            diagStartTesterPresent(Cdd_Name);
            _TestWaitForTesterConfirmation("控制手力矩为 %.1f",NRC22_TasTorque+1);
            diagStopTesterPresent(Cdd_Name);
            return 4;
          }
//          else if(Serve==0x10 && Fun==0x02)
//          {
//            /*10 02预编程*/
//            return 0x80;
//          }
          else
            return 0;
        }
        else if(Type == 1)//恢复NRC22
        {
          if((Temp_NRC22 & 0x1) != 0)//车速
          {
            _Set_CarSpd(0);
            return 0;
          }
          else if((Temp_NRC22 & 0x20) != 0 ) //发动机
          {
            if(Ready_NRC22 != 0)
              _Set_Ready(0);
            else
              _Set_Ready(Struct_Ready.Ready_Active);
            return 0;
          }
          else if((Temp_NRC22 & 0x08) != 0 ) //档位
          {
            _Set_Gears(NRC_22_Gears_Normal);
            return 0;
          }
          else if((Temp_NRC22 & 0x02) != 0 )//电压
          {
            _Set_Battery(12);
            return 0;
          }
          else if((Temp_NRC22 & 0x10) != 0 ) //传感器
          {
            diagStartTesterPresent(Cdd_Name);
            _TestWaitForTesterConfirmation("恢复传感器");
            if(testWaitForTesterConfirmation("恢复传感器存在上下电及会话问题,此部分会有风险,建议手动测试,是否上下电",60000)==1)
            {
              _Power_Down();
              testWaitForTimeout(1000);
              _Power_Up();
              if(Session_BIN == 4)
                _SetSession(exsession);
              if(NRC22_Recover_Sense == 1)
              {
                _unlockECU();
                NRC22_Recover_Sense = 0; // 重新过安全访问后立即恢复值防止影响后续
              }
            }
            diagStopTesterPresent(Cdd_Name);
            return 16;
          }
          else if((Temp_NRC22 & 0x04) != 0 )//手力矩
          {
            TestWaitForTesterConfirmation("松开方向盘",10000);
            return 0;
          }
//          else if(Serve==0x10 && Fun==0x02)
//          {
//            /*10 02预编程*/
//            _Pre_Programmed();
//            return 0;
//          }
        }
      }
    }
  }
  else
  {
    byte Da_1,Da_2;
    Da_1 = (Fun>>8)&0xFF;
    Da_2 = Fun&0xFF;
    for(Loop_22=0;Loop_22<Serve_31_Hex_Count;Loop_22++)
    {
      if((Serve_31_Hex[Loop_22].Routine[0] == Da_1) && (Serve_31_Hex[Loop_22].Routine[1] == Da_2))
      {
        Fun_Pos_22 = Loop_22;
        break;
      }
    }
    if(Fun_Pos_22 == -1)
    {
      _WriteEx_and_Report("","未查询到对应RID");
      return -1;
    }
    for(Loop_22=0;Loop_22<Serve_31_Hex[Fun_Pos_22].Control_Type_Count;Loop_22++)
    {
      if(Serve_31_Hex[Fun_Pos_22].Control_Type[Loop_22] == Serve)
      {
        Serve_Pos_22 = Loop_22;
        break;
      }
    }
    if(Serve_Pos_22 == -1)
    {
      _WriteEx_and_Report("","未查询到对应控制类型");
      return -1;
    }
    NRC22_Flage = _Check_Serve(Serve,Fun,10);
    {
      Temp_NRC22 = NRC22_Flage;
      if(Type == 2)
        return Temp_NRC22;  //提前结束返回，不进行操作
      if(Temp_NRC22 == 0)
      {
        _WriteEx_and_Report("","无NRC22条件");
        return -1;
      }
      if(Type == 0)//满足NRC22
      {
        if((Temp_NRC22 & 0x1) != 0)//车速
        {
          _Set_CarSpd(NRC22_CarSpd+1);
          return 1;
        }
        else if((Temp_NRC22 & 0x20) != 0 ) //发动机
        {
          _Set_Ready(Struct_Ready.Ready_Active);
          return 0x20;
        }
        else if((Temp_NRC22 & 0x08) != 0 ) //档位
        {
          _Set_Gears(NRC_22_Gears_Normal+1);
          return 8;
        }
        else if((Temp_NRC22 & 0x02) != 0 ) //电压
        {
          _Set_Battery(NRC22_Battery_Hight+1);
          return 2;
        }
        else if((Temp_NRC22 & 0x04) != 0 ) //手力矩
        {
          diagStartTesterPresent(Cdd_Name);
          _TestWaitForTesterConfirmation("控制手力矩为 %.1f",NRC22_TasTorque+1);
          diagStopTesterPresent(Cdd_Name);
          return 4;
        }
        else if((Temp_NRC22 & 0x10) != 0 ) //传感器
        {
          diagStartTesterPresent(Cdd_Name);
          _TestWaitForTesterConfirmation("拔掉传感器");
          diagStopTesterPresent(Cdd_Name);
          return 16;
        }
      }
      else if(Type == 1)//恢复NRC22
      {
        if((Temp_NRC22 & 0x1) != 0)//车速
        {
          _Set_CarSpd(0);
          return 0;
        }
        else if((Temp_NRC22 & 0x20) != 0 ) //发动机
        {
          _Set_Ready(0);
          return 0;
        }
        else if((Temp_NRC22 & 0x08) != 0 ) //档位
        {
          _Set_Gears(NRC_22_Gears_Normal);
          return 0;
        }
        else if((Temp_NRC22 & 0x02) != 0 )//电压
        {
          _Set_Battery(12);
          return 0;
        }
        else if((Temp_NRC22 & 0x04) != 0 )//手力矩
        {
          diagStartTesterPresent(Cdd_Name);
          TestWaitForTesterConfirmation("松开方向盘",10000);
          diagStopTesterPresent(Cdd_Name);
          return 0;
        }
        else if((Temp_NRC22 & 0x10) != 0 ) //传感器
        {
          diagStartTesterPresent(Cdd_Name);
          _TestWaitForTesterConfirmation("恢复传感器");
          if(testWaitForTesterConfirmation("恢复传感器存在上下电及会话问题,此部分会有风险,建议手动测试,是否上下电",60000)==1)
          {
            _Power_Down();
            testWaitForTimeout(1000);
            _Power_Up();
            if(Session_BIN == 4)
              _SetSession(exsession);
            if(NRC22_Recover_Sense == 1)
            {
              _unlockECU();
              NRC22_Recover_Sense = 0; // 重新过安全访问后立即恢复值防止影响后续
            }
          }
          diagStopTesterPresent(Cdd_Name);
          return 16;
        }
      }
    }
  }
  return 0xFF;
}
/**********************************************************************************/
/*
  肯定响应抑制位测试(根据子功能情况确定响应状态)
*/
_Step_Serve_RSP(byte Serve,dword ID,byte session)
{
  byte Send_Data[100];
  byte ReqSeed[2];
  int i,n,Fun_Poss,len,Serve_Poss;
  byte Size_Para;
  int Count_;
  Count_ = 0;
  Serve_Poss = _Check_Serve(Serve,0,0);
  Send_Data[0] = Serve;
  ReqSeed[0] = 0x27;
  ReqSeed[1] = RequestSeed_27;
  for(i=0;i<=0xFF;i++)
  {
    Fun_Poss = _Check_Serve(Serve,i,4);
    len = 1+1;//服务+子功能
    if(Fun_Poss != -1)
    {
      if((session != defsession) && (Count_ != 0))
        _SetSession(session);
      testWaitForTimeout(1000);
      Size_Para = Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][0];   //子功能对应的第一个参数长度
      if( Size_Para != 0)
      {
        for(n=0;n<Size_Para;n++)
          Send_Data[len+n] = Serve_Data[Serve_Poss].Serve_Para[Fun_Poss][n];
        len = len + Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][0];
      }
      Send_Data[1] = i;
      if(_Check_Serve(Serve,i,9)==1)
      {
        int Resp;
        Resp = _Check_Fun_IDAndSess(Serve,i,ID,session);
        if(Resp == 0) //寻址支持但会话不支持
        {
          if(Serve == 0x10 ) //10服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0x7E);  
            if(Send_Data[1]==0x82 )
            {
              byte Temp_1[4]={0x14,0xff,0xff,0xff};
              _Send_Diag(4,phyreq_ID,Temp_1);
              _TestResult(SendData,phyreq_ID,"",-1);  
            }
            if(Send_Data[1]==0x83)
            {
              _Send_Diag(2,phyreq_ID,ReqSeed);
              _TestResult(SendData,phyreq_ID,"",0x7F); 
            }
            _Send_And_Check_NowSession(ID,session);
          }
          else if(Serve == 0x11 ) //11服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0x7F); 
            _Send_And_Check_NowSession(ID,session); 
          }
          else
          {
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0x7F);
          }
        }
        else if(Resp == 1)
        {
          if(Serve == 0x10 ) //10服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            if((session == exsession) && (i==0x02)) //10 02特殊处理,加载前提条件
            {
              if(Pre_Programmed_1002 == 1)
              {
                _Pre_Programmed();
                if( (Pre_Programmed_UnlockECU == 0) && (_Check_Serve(Serve,i,5)==1))
                  _unlockECU();
              }
              else
              {
                if(_Check_Serve(Serve,i,5)==1)
                  _unlockECU();
              }
              testWaitForTimeout(300);
            }
            
            Send_Data[1] = i|0x80;
            _Send_Diag_NoTime(len,ID,Send_Data);
            {
              diagSetP2Extended(-1);
              testWaitForDiagResponse(SendData,p2cmax);
              if(diagGetLastResponseCode(SendData)==0x78)
              {
                if((_Check_Dword_in_Num(0x10,NotNRC78_Serve,NotNRC78_Serve_Count)!=-1) && (DiagGetPrimitiveByte(SendData,1)==0x82))
                  testStepFail("","0x82收到NRC78反馈,该项目预期0x82不响应NRC78");
                testWaitForDiagResponse(SendData,p2cmax*100);
                testReportWriteDiagResponse(SendData);
                _WriteEx_and_Report("","接收到NRC78响应,后续响应判断是否为正响应");
                _TestResult(SendData,ID,"",-1); 
              }
              else
              {
                if(diagGetLastResponseCode(SendData)==0)
                  testWaitForDiagResponse(SendData,1000);
                testReportWriteDiagResponse(SendData);
                _TestResult(SendData,ID,"",0); 
              }
            }
            if(Send_Data[1] == 0x81 )
            {
              _Send_Diag(2,phyreq_ID,ReqSeed);
              _TestResult(SendData,phyreq_ID,"",0x7F);  
              _Send_And_Check_NowSession(ID,defsession);
            }
            else if(Send_Data[1] == 0x82 )
            {
              byte Temp_1[4]={0x14,0xff,0xff,0xff};
              testWaitForTimeout(1000);
              _Send_Diag(4,phyreq_ID,Temp_1);
              _TestResult(SendData,phyreq_ID,"",0x11); 
              _Send_And_Check_NowSession(ID,2); 
              _SetSession(defsession);//10 01退出编程会话
              testWaitForTimeout(2000);
            }
            else if(Send_Data[1] == 0x83 )
            {
              _Send_Diag(2,phyreq_ID,ReqSeed);
              _TestResult(SendData,phyreq_ID,"",-1);  
              _Send_And_Check_NowSession(ID,exsession);
            }
          }
          else if(Serve == 0x11 ) //11服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            Send_Data[1] = i|0x80;
            if(Serve_Data[Serve_Poss].Security_Access[Fun_Poss]==1)
            {
              _Send_Diag(len,ID,Send_Data);
              _TestResult(SendData,ID,"",0x33);  
              _unlockECU();
            }
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0);  
            testWaitForTimeout(Wait_Time_11);
            _Send_Diag(2,phyreq_ID,ReqSeed);
            _TestResult(SendData,phyreq_ID,"",0x7F);  
            _Send_And_Check_NowSession(ID,defsession);
          }
          else
          {
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0); 
            testWaitForTimeout(2000); 
            _Send_And_Check_NowSession(ID,defsession);
          }
        }
        else if(Resp == -1)
        {
          if(Serve == 0x10 ) //10服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            if((session == exsession) && (i==0x02)) //10 02特殊处理,加载前提条件
            {
              if(Pre_Programmed_1002 == 1)
              {
                _Pre_Programmed();
                if( (Pre_Programmed_UnlockECU == 0) && (_Check_Serve(Serve,i,5)==1))
                  _unlockECU();
              }
              else
              {
                if(_Check_Serve(Serve,i,5)==1)
                  _unlockECU();
              }
              testWaitForTimeout(300);
            }
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0x7E); 
            if(Send_Data[1] == 0x82 )
            {
              byte Temp_1[4]={0x14,0xff,0xff,0xff};
              testWaitForTimeout(1000);
              _Send_Diag(4,phyreq_ID,Temp_1);
              _TestResult(SendData,phyreq_ID,"",-1); 
              _Send_And_Check_NowSession(ID,session); 
            }
          }
          else if(Serve == 0x11 ) //11服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0x7F); 
            _Send_And_Check_NowSession(ID,session); 
            if(session == exsession)
            {
              _Send_Diag(2,phyreq_ID,ReqSeed);
              _TestResult(SendData,phyreq_ID,"",-1);  
            }
          }
        }
        testWaitForTimeout(500);
      }
      else
      {
        _WriteEx_and_Report("","当前子功能不支持肯定响应抑制位");
        Send_Data[1] = i|0x80;
        _Send_Diag(len,ID,Send_Data);
        _TestResult(SendData,ID,"",0x12);  
        testWaitForTimeout(1000);
      }
      Count_++;
    }
  }
}
/*
  min13优先级常高于total13
  Serve ：服务
  Type_NRC ：获取NRC方式
  Type = 0:返回输入NRC中优先级较高的NRC
  Type = 1:返回输入NRC中优先级较高的NRC(用于获取NRC13,需获取前一次的发送长度)
*/
byte Response_Serve_NRC(byte Serve,byte Type_NRC,byte NRC_1,byte NRC_2,byte Type)
{
  byte NRC;
  int Serve_Pos,i,NRC_1_Pos,NRC_2_Pos,k,Len_Send;
  int Min13_Flage,Total13_Flage,Min13_Pos,Total13_Pos;
  int Count;
  NRC31_Count = 0;
  NRC13_Count = 0;
  NRC31_total = 0;
  NRC13_total = 0;
  NRC_1_Pos = -1;NRC_2_Pos = -1;
  Min13_Flage = 0;Total13_Flage = 0;
  Min13_Pos = -1;Total13_Pos = -1;
  Count = 0;
  Serve_Pos = _Check_Serve(Serve,0,0);
  if(Serve_Pos == -1)
    return -1;
  _Check_Serve(Serve,0,Type_NRC); //获取NRC列表装载到Fun_NRC中
  
  for(k=Fun_NRC_Count-1;k>=0;k--)  //获取共多少个NRC13或NRC31
  {
    if(Fun_NRC[k]==0x13)
      NRC13_total++;
    else if(Fun_NRC[k]==0x31)
      NRC31_total++;
  }
  if(Type == 1 && NRC13_total == 2)
  {
    Len_Send = DiagGetPrimitiveSize(SendData);
    if(Len_Send<= 1 + 2 + 1)
      Min13_Flage = 1;
    else
      Total13_Flage = 1;
  }
  for(i=0;i<Serve_Data[Serve_Pos].Serve_NRC_Count[0];i++)
  {
    if(Serve_Data[Serve_Pos].Serve_NRC[0][i] == 0x13 && NRC13_total == 2) //NRC13且存在min13与total13
    {
      if( Count == 0 )//min13
        Min13_Pos = i;
      else   //total13
        Total13_Pos = i;
      Count++;
    }
    if(Serve_Data[Serve_Pos].Serve_NRC[0][i]==NRC_1)
      NRC_1_Pos = i;
    if(Serve_Data[Serve_Pos].Serve_NRC[0][i]==NRC_2)
      NRC_2_Pos = i;
  }
  if(NRC_1 == 0x13)
  {
    if(Min13_Flage == 1)
      NRC_1_Pos = Min13_Pos;
    else if(Total13_Flage == 1)
      NRC_1_Pos = Total13_Flage;
  }
  if(NRC_2 == 0x13)
  {
    if(Min13_Flage == 1)
      NRC_2_Pos = Min13_Pos;
    else if(Total13_Flage == 1)
      NRC_2_Pos = Total13_Flage;
  }
/*******************已获取全部位置**************************/
  if((NRC_1_Pos != -1) && (NRC_2_Pos != -1))
  {
    if(NRC_1_Pos < NRC_2_Pos)
      NRC = NRC_1_Pos;
    else
      NRC = NRC_2_Pos;
  }
  if(NRC_1_Pos == -1)
    NRC = NRC_2_Pos;
  else if(NRC_2_Pos == -1)
    NRC = NRC_1_Pos;
  NRC = Serve_Data[Serve_Pos].Serve_NRC[0][NRC];
  return NRC;
}
/**************************************************************************************************//*
/*
  检测该子功能在当前会话及寻址方式下是否支持
  适用于对子功能进行单独判断
  Serve ： 服务
  Fun ： 子功能
  ID ： 寻址方式
  session ： 会话
*/
int _Check_Fun_IDAndSess(byte Serve,dword Fun,dword ID,byte session)  
{
  int Temp_Serve_Pos,Temp_Fun_Pos;
  byte Add,Sess;
  char Tem_Fun[20];
  Temp_Serve_Pos = _Check_Serve(Serve,Fun,0);
  Temp_Fun_Pos = _Check_Serve(Serve,Fun,4);
  snprintf(Tem_Fun,elCount(Tem_Fun),"%s","");
  if(Fun<=0xFF)
    snprintf(Tem_Fun,elCount(Tem_Fun),"0x%02X 0x%02X",Serve,Fun);
  else
    snprintf(Tem_Fun,elCount(Tem_Fun),"0x%02X 0x%02X 0x%02X",Serve,(Fun>>8),(Fun & 0xFF));
  if((Temp_Serve_Pos == -1) || (Temp_Fun_Pos) == -1)
  {
    _WriteEx_and_Report(Tem_Fun,"当前服务不支持或子功能不支持");
    return -2;
  }
  if(ID == funreq_ID)
    Add = 2;
  else if(ID == phyreq_ID)
    Add = 1;
  if(session == defsession)
    Sess = 1;
  else if(session == exsession)
    Sess = 4;
  if((Serve_Data[Temp_Serve_Pos].Serve_Addres[Temp_Fun_Pos] & Add) != 0)
  {
    if((Serve_Data[Temp_Serve_Pos].Serve_Session[Temp_Fun_Pos] & Sess) != 0)
      return 1;//该会话及寻址方式下支持该子功能
    else
      return 0; //寻址支持但会话不支持   // NRC7E
  }
  else 
  {
    _WriteEx_and_Report(Tem_Fun,"当前寻址不支持该子功能");   // NRC7F
    return -1;
  }
}
/*
  检测输入的NRC是否在预期NRC列表中
  Serve ： 服务
  Fun ： 子功能
  NRC ： 输入NRC
*/
int _Check_NRC_In_List(byte Serve,dword Fun,byte NRC)  
{
  int Temp_Serve_Pos,Temp_Fun_Pos,Return_Value;
  int n;
  Return_Value = -1;
  Temp_Serve_Pos = _Check_Serve(Serve,Fun,0);
  Temp_Fun_Pos = _Check_Serve(Serve,Fun,4);
  if((Temp_Serve_Pos == -1) || (Temp_Fun_Pos) == -1)
  {
    return -2;
  }
  else
  {
    for(n=0;n<Serve_Data[Temp_Serve_Pos].Serve_NRC_Count[Temp_Fun_Pos];n++)
    {
      if(Serve_Data[Temp_Serve_Pos].Serve_NRC[Temp_Fun_Pos][n] == NRC)
      {
        Return_Value = 1;
        break;
      }
    }
  }
  return Return_Value;
}
/*
  检测该服务在当前会话及寻址方式下是否支持
  适用于整个服务支持的寻址及会话一致的情况下
  Serve ： 服务
  ID ： 寻址方式
  session ： 会话
*/
int _Check_Serve_IDAndSess(byte Serve,dword ID,byte session)  
{
  int Temp_Serve_Pos;
  byte Add,Sess;
  char Tem_Fun[20];
  if(Serve != 0x31)
    Temp_Serve_Pos = _Check_Serve(Serve,0,0);
  snprintf(Tem_Fun,elCount(Tem_Fun),"%s","");
  snprintf(Tem_Fun,elCount(Tem_Fun),"%02X服务",Serve);
  if(Temp_Serve_Pos == -1 && Serve !=0x31)
  {
    _WriteEx_and_Report(Tem_Fun,"当前服务不支持");
    return -2;
  }
  if(ID == funreq_ID)
    Add = 2;
  else if(ID == phyreq_ID)
    Add = 1;
  if(session == defsession)
    Sess = 1;
  else if(session == exsession)
    Sess = 4;
    
  if(Serve != 0x31)
  {
    if((Serve_Data[Temp_Serve_Pos].Serve_Addres[0] & Add) != 0)
    {
      if((Serve_Data[Temp_Serve_Pos].Serve_Session[0] & Sess) != 0)
        return 1;//该会话及寻址方式下支持该服务
      else
        return 0; //寻址支持但会话不支持
    }
    else 
    {
      _WriteEx_and_Report(Tem_Fun,"当前寻址不支持该服务");
      return -1;
    }
  }
  else
  {
    if((Serve_31_Hex[0].Serve_Addres[0] & Add) != 0)
    {
      if((Serve_31_Hex[0].Serve_Session[0] & Sess) != 0)
        return 1;//该会话及寻址方式下支持该服务
      else
        return 0; //寻址支持但会话不支持
    }
    else 
    {
      _WriteEx_and_Report(Tem_Fun,"当前寻址不支持该服务");
      return -1;
    }
  }
}

