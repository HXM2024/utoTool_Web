}
/// <Power>
_K30_OFF()
{
  if(Burn_in_Board==1)
    RelayOFF(1);
  else if(Burn_in_Board==2)
    RelayON(1);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x27;
    IGON.byte(2)=0x00;
