/*-----------------------------------------------*/

_Send_Diag(int size,dword ID,byte Send_Data[])
{
  int i;
  dword LenSend;
  i=0;
  LenSend = elCount(Send_Data);
  diagResize(SendData,size);
  if(size<=LenSend)
  {
    for(i=0;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
  }
  else if(size>LenSend)
  {
    for(i=0;i<LenSend;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
    for(i=LenSend;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_filler);
  } 
  _SendAndWriteReport(SendData,ID); 
}

_Send_Diag_(dword size,dword ID,byte Send_Data[])
{
  int i;
  dword LenSend;
  i=0;
  LenSend = elCount(Send_Data);
