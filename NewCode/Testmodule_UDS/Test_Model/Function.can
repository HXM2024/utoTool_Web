/// <Node>
int _Invalid_Node(dword Node) //节点无效操作
{
  int ii,pos_;
  char T_Str[200];
  pos_ = -1;
  for(ii=0;ii<Node_Invalid_Count;ii++)
  {
    if(Node == Node_Invalid[ii].Node  && Node_Invalid[ii].Invalid_Index == 0)
    {
      pos_ = ii;
      break;
    }
  }
  if(pos_ != -1)
  {
    setSignal(Node_Invalid[pos_].Signal_Name,Node_Invalid[pos_].Invalid_Value);
    snprintf(T_Str,elCount(T_Str),"EV_%s",Node_Invalid[pos_].Signal_Name);
    putValue(T_Str,Node_Invalid[pos_].Invalid_Value);
    putValue(Node_Invalid[pos_].Signal_Name,Node_Invalid[pos_].Invalid_Value);
    testWaitForTimeout(Node_Invalid[pos_].Time*1.3);
    testStep(Node_Invalid[pos_].Signal_Name,"设置信号值为%d",Node_Invalid[pos_].Invalid_Value);
    writeEx(-3,0,"设置信号 %s 为 %d",Node_Invalid[pos_].Signal_Name,Node_Invalid[pos_].Invalid_Value);
    Node_Invalid[pos_].Invalid_Index = 1;
    return 1;
  }
  else
  {
    return -1;
    // testStep("","0x%X 未查询到对应的节点",Node);
  }
}
/// <Node>
int _Recover_Invalid_Node(dword Node) //节点无效恢复操作
{
  int ii,pos_;
  char T_Str[200];
  pos_ = -1;
  for(ii=0;ii<Node_Invalid_Count;ii++)
  {
    if(Node == Node_Invalid[ii].Node && Node_Invalid[ii].Invalid_Index == 1)
    {
      setSignal(Node_Invalid[ii].Signal_Name,Node_Invalid[ii].Normal_Value);
      snprintf(T_Str,elCount(T_Str),"EV_%s",Node_Invalid[ii].Signal_Name);
      putValue(T_Str,Node_Invalid[ii].Normal_Value);
      putValue(Node_Invalid[ii].Signal_Name,Node_Invalid[ii].Normal_Value);
      testWaitForTimeout(Node_Invalid[ii].Time*1.3);
      testStep(Node_Invalid[ii].Signal_Name,"设置信号值为%d",Node_Invalid[ii].Normal_Value);
      writeEx(-3,0,"设置信号 %s 为 %d",Node_Invalid[ii].Signal_Name,Node_Invalid[ii].Normal_Value);
      Node_Invalid[ii].Invalid_Index = 0;
      pos_ = 1;
    }
  }
  return pos_;
}
