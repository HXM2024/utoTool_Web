  if((strncmp(str_,"XCP",strlen(str_)) == 0) || (strncmp(str_,"xcp",strlen(str_)) == 0))
  {
    //testStep(str_,"当前为内部XCP变量,无法进行节点操作");
    Canoe_Node_Flage = 0;
  }
  else if(ID_Tmep == 0 && (strncmp(str_,"XCP",strlen(str_)) != 0))
  {
   // testStepFail(str_,"当前输入ID未查询到");
    Canoe_Node_Flage = -2;
  }
  else
  {
    Canoe_Node_Flage = 1;
    if(Canoe_Node_Flage==-1)
    {
      //writeEx(-3,0,"%s  当前输入节点不属于Canoe仿真节点",str_);
    }
  }
}
