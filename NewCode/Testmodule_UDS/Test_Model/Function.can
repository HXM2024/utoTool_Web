}

_Send_Diag_3E80_After_NRC78(byte size,dword ID,byte Send_Data[])
{
  double Start_time,End_time,DiffTime;
  int i,NRC78_Count;
  _Send_Diag_NoTime(size,ID,Send_Data);
  Start_time = (double)timeNow()/100;
  testWaitForDiagResponse(SendData,p2cmax);
  if(diagGetLastResponseCode(SendData)==0x78)
  {
    message *Msg;
    writeEx(-3,0,"/*----------收到NRC78应答，发送3E 80----------*/");
    Msg.id = funreq_ID;  Msg.dlc = 8; Msg.can = 1;
    Msg.byte(0) = 0x02; Msg.byte(1) = 0x3E; Msg.byte(2) = 0x80;
    for(i=3;i<8;i++)
      Msg.byte(i) = 0x55;
    if(Support_CAN == 2)
    {
      Msg.FDF = 1;Msg.BRS = 1;
    }
    output(Msg);
    End_time = (double)timeNow()/100;
    DiffTime = End_time - Start_time;
    NRC78_Count = 0;  Res_NRC78 = 1;
    _WriteEx_and_Report("","第一次收到NRC78响应时间: %.2f ms",DiffTime);
    do{
      NRC78_Count++;
      if(NRC78_Count>1)
      {
        Start_time = (double)timeNow()/100;  
        DiffTime = Start_time - End_time;
        if(DiffTime<0.3*P2_can_server)
          testStepFail("","第 %d 次NRC78响应时间过短,期望大于 %d ms，当前响应时间为 %.2f ms",NRC78_Count,0.3*P2_can_server,DiffTime);
        if(DiffTime>0.8*P2_can_server)
          testStepFail("","第 %d 次NRC78响应时间过长,期望小于 %d ms，当前响应时间为 %.2f ms",NRC78_Count,0.8*P2_can_server,DiffTime);
      }
      testWaitForDiagResponse(SendData,p2cmax*100);
    }while(diagGetLastResponseCode(SendData)==0x78);
  }
  if(diagGetLastResponseCode(SendData)!=0)
    testReportWriteDiagResponse(SendData);
}

_Send_Diag_And_Get_CF(byte size,dword ID,byte Send_Data[])
{
  _Send_Diag(size,ID,Send_Data);
  if(AES_128 != 0)/*多帧存在接收不全问题*/
  {
    if(diagGetLastResponseCode(SendData)==0)
      testWaitForDiagResponse(SendData,200);
  }
}
/*
    发送并判断当前会话
    Session == 0xFF,特殊情况不判断返回值，并返回当前会话
*/
byte _Send_And_Check_NowSession(dword ID,byte Session)
{
  _get_Arry("Read_Now_Session");
  if(Support_ReadSession == 1)
  {
    if(Read_Now_Session_BT == -1 && Session == 2)
      return 0;
    testWaitForTimeout(10);
    _Send_Diag(3,ID,Read_Now_Session);
    if(Session == 2 && Read_Now_Session_BT == 0)
      _TestResult(SendData,ID,"读取当前会话模式",NRC31);
    else
    {
      _TestResult(SendData,ID,"读取当前会话模式",-1);
      if(diagGetLastResponseCode(SendData)==-1)
      {
        byte Session_Now;
        Session_Now = DiagGetRespPrimitiveByte(SendData,3);
        if(Session == 0xFF)
          return Session_Now;
        if(Session_Now == Session)
          testStepPass("","当前会话与预期一致为0x%02X",Session_Now);
        else
          testStepFail("","当前会话为0x%02X，预期会话为0x%02X",Session_Now,Session);
        return Session_Now;
      }
    }
  }
  else
  {
//    _WriteEx_and_Report("","不支持读取当前会话");
  }
  return 0;
}
/*
  检测输入数据是否被28服务所支持
  Send_Data[];输入数组
*/
int _Check_SendData_In_28H(byte Send_Data[])
{
  int Return_Value;
  int m,Serve_Pos,Fun_Pos,Com_Pos;
  Serve_Pos = -1;
  Fun_Pos = -1;
  Com_Pos = -1;
  
  Serve_Pos = _Check_Serve(Send_Data[0],0,0);
  if(Serve_Pos == -1)
  {
//    _WriteEx_and_Report("","当前服务不支持");
    return -3;
  }
  for(m=0;m<Serve_Data[Serve_Pos].Serve_Fun_Count;m++)
  {
    if((Send_Data[1] == Serve_Data[Serve_Pos].Serve_Fun[m]) || ((Serve_Data[Serve_Pos].RSP[m]==1) && (Send_Data[1] == (Serve_Data[Serve_Pos].Serve_Fun[m])|0x80)))
    {
      Fun_Pos = m;
      break;
    }
  }
  if(Fun_Pos == -1)
  {
//    _WriteEx_and_Report("","当前服务子功能不支持");
    return -2;
  }
  for(m=0;m<Serve_Data[Serve_Pos].Serve_Para_Count[Fun_Pos];m++)
  {
    if(Send_Data[2] == Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][m])
    {
      Com_Pos = m;
      break;
    }
  }
  Return_Value = Com_Pos;
  return Return_Value;
}

/*
  获取0x19服务的发送数据
  Fun 子功能
*/
int _Get_19_ServeData(byte Send_Data[],byte Fun)
{
  byte DTC_H,DTC_M,DTC_L;
  int Re;
  _Clear_SendData(Send_Data);
  Send_Data[0] = 0x19;
  Send_Data[1] = Fun;
  if(Fun == 0x01 || Fun == 0x02)
  {
    Re = 3;
    Send_Data[2] = 0x01;
  }
  else if(Fun == 0x03)
  {
    Re = 2;
  }
  else if(Fun == 0x0A)
  {
    Re = 2;
  }
  else if(Fun == 0x04)
  {
    Re = 6;
    DTC_H = (DTC_19[1][1]>>16);
    DTC_M = (DTC_19[1][1]>>8);
    DTC_L = (DTC_19[1][1]&0xFF);
    Send_Data[2] = DTC_H;
    Send_Data[3] = DTC_M;
    Send_Data[4] = DTC_L;
    Send_Data[5] = 0Xff;
  }
  else if(Fun == 0x06)
  {
    Re = 6;
    DTC_H = (DTC_19[1][1]>>16);
    DTC_M = (DTC_19[1][1]>>8);
    DTC_L = (DTC_19[1][1]&0xFF);
    Send_Data[2] = DTC_H;
    Send_Data[3] = DTC_M;
    Send_Data[4] = DTC_L;
    Send_Data[5] = 0X01;
  }
  return Re;
}
/*
  获取0x31服务的发送数据
  Type = 0:正常发送
*/
_Get_31_ServeData(dword Serve_Poss,byte Send_Data[],byte Type)
{
  _Clear_SendData(Send_Data);
  if(Serve_Poss < Serve_31_Hex_Count)
  {
    Send_Data[0] = 0x31;
    Send_Data[1] = Serve_31_Hex[Serve_Poss].Control_Type[0];
    Send_Data[2] = Serve_31_Hex[Serve_Poss].Routine[0];
    Send_Data[3] = Serve_31_Hex[Serve_Poss].Routine[1];
    Len_31H = Serve_31_Hex[Serve_Poss].Routine_Len;
    if(Serve_31_Hex[Serve_Poss].Control_Option_Count[0] != 0)
      Send_Data[4] = Serve_31_Hex[Serve_Poss].Control_Option[0][0];
  }
  else
  {
    Send_Data[0] = 0x31;
    Send_Data[1] = Serve_31_Hex[0].Control_Type[0];
    Send_Data[2] = Serve_31_Hex[0].Routine[0];
    Send_Data[3] = Serve_31_Hex[0].Routine[1];
    Len_31H = Serve_31_Hex[0].Routine_Len;
    if(Serve_31_Hex[0].Control_Option_Count[0] != 0)
      Send_Data[4] = Serve_31_Hex[0].Control_Option[0][0];
  }
  if(Type == 0)
    return;
}
/*
  检测输入数据是否在31结构体中
  Send_Data[];输入数组
*/
int _Check_SendData_In_31H(byte Send_Data[])
{
  int Return_Value;
  int m,Routine_Pos,Type_Pos;
  Routine_Pos = -1;
  Type_Pos = -1;
  for(m=0;m<Serve_31_Hex_Count;m++)
  {
    if((Serve_31_Hex[m].Routine[0] == Send_Data[2]) && (Serve_31_Hex[m].Routine[1] == Send_Data[3]))
    {
      Routine_Pos = m;
      break;
    }
  }
  if(m == Serve_31_Hex_Count)
  {
    return -1;
  }
  for(m=0;m<Serve_31_Hex[Routine_Pos].Control_Type_Count;m++)
  {
    if(Serve_31_Hex[Routine_Pos].Control_Type[m] == Send_Data[1])
    {
      Type_Pos = m;
      break;
    }
  }
  Return_Value = Type_Pos;
  return Return_Value;
}
/*
  检测31服务对应例程的响应结果
  Type = 1 成功响应
  Type = 0 失败响应
  Type = other
*/
int _Check_31Routine_Rx(byte Send_Data[],byte Type)
{
  int Return_Value,Flag;
  int m,n,Routine_Pos,Type_Pos;
  int Rx_Len;
  Routine_Pos = -1;
  Type_Pos = -1;
  Flag = 0;
  for(m=0;m<Serve_31_Hex_Count;m++)
  {
    if((Serve_31_Hex[m].Routine[0] == Send_Data[2]) && (Serve_31_Hex[m].Routine[1] == Send_Data[3]))
    {
      Routine_Pos = m;
      break;
    }
  }
  if(m == Serve_31_Hex_Count)
  {
    _WriteEx_and_Report("","未查询到对应进程");
    return -1;
  }
  for(m=0;m<Serve_31_Hex[Routine_Pos].Control_Type_Count;m++)
  {
    if(Serve_31_Hex[Routine_Pos].Control_Type[m] == Send_Data[1])
    {
      Type_Pos = m;
      break;
    }
  }
  if(m == Serve_31_Hex[Routine_Pos].Control_Type_Count)
  {
    _WriteEx_and_Report("","未查询到对应控制类型");
    return -1;
  }
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,200);
  if(diagGetLastResponseCode(SendData) != -1)
    testStepFail("","未收到正响应");
  else
  {
    Rx_Len = DiagGetRespPrimitiveSize(SendData);
    if(Rx_Len != Serve_31_Hex[Routine_Pos].Control_Type_RxLen[Type_Pos])
      testStepFail("","收到的响应长度与预期不符，期望长度为 %d ,收到长度为 %d",Serve_31_Hex[Routine_Pos].Control_Type_RxLen[Type_Pos],Rx_Len);
    else
    {
      if(DiagGetRespPrimitiveByte(SendData,0) != (Send_Data[0]^0x40))
        testStepFail("","实际反馈服务异常");
      for(n=1;n<4;n++)
      {
        if(DiagGetRespPrimitiveByte(SendData,n) != Send_Data[n])
          Flag = 1;
      }
      if(Flag == 0)
        testStepPass("","反馈结果与期望一致");
      else
        testStepFail("","反馈与预期不一致");
      if(Type == 1)
      {
        if(Rx_Len == 5)
        {
          if(DiagGetRespPrimitiveByte(SendData,4) != Serve_31_Hex[Routine_Pos].Control_Type_Success[Type_Pos])
            testStepFail("","期望成功响应结果为 0x%02X ,实际响应结果为 0x%02X",Serve_31_Hex[Routine_Pos].Control_Type_Success[Type_Pos],DiagGetRespPrimitiveByte(SendData,4));
          else
            testStepPass("","期望成功响应结果与实际一致为 0x%02X",DiagGetRespPrimitiveByte(SendData,4));
        }
        else if(Rx_Len == 6) //返回长度为6，默认为Geely相关项目，第5byte响应固定为0x10;
        {
          if(DiagGetRespPrimitiveByte(SendData,4) != 0x10)
            testStepFail("","期望成功响应结果为 0x10 ,实际响应结果为 0x%02X",DiagGetRespPrimitiveByte(SendData,4));
          if(DiagGetRespPrimitiveByte(SendData,5) != Serve_31_Hex[Routine_Pos].Control_Type_Success[Type_Pos])
            testStepFail("","期望成功响应结果为 0x%02X ,实际响应结果为 0x%02X",Serve_31_Hex[Routine_Pos].Control_Type_Success[Type_Pos],DiagGetRespPrimitiveByte(SendData,5));
          else
            testStepPass("","期望成功响应结果与实际一致为 0x%02X",DiagGetRespPrimitiveByte(SendData,5));
        }
      }
      else if(Type == 0)
      {
        if(Rx_Len == 5)
        {
          if(DiagGetRespPrimitiveByte(SendData,4) != Serve_31_Hex[Routine_Pos].Control_Type_Failed[Type_Pos])
            testStepFail("","期望失败响应结果为 0x%02X ,实际响应结果为 0x%02X",Serve_31_Hex[Routine_Pos].Control_Type_Failed[Type_Pos],DiagGetRespPrimitiveByte(SendData,4));
          else
            testStepPass("","期望失败响应结果与实际一致为 0x%02X",DiagGetRespPrimitiveByte(SendData,4));
        }
        else if(Rx_Len == 6) //返回长度为6，默认为Geely相关项目，第5byte响应固定为0x10;
        {
          if(DiagGetRespPrimitiveByte(SendData,4) != 0x10)
            testStepFail("","期望失败响应结果为 0x10 ,实际响应结果为 0x%02X",DiagGetRespPrimitiveByte(SendData,4));
          if(DiagGetRespPrimitiveByte(SendData,5) != Serve_31_Hex[Routine_Pos].Control_Type_Failed[Type_Pos])
            testStepFail("","期望失败响应结果为 0x%02X ,实际响应结果为 0x%02X",Serve_31_Hex[Routine_Pos].Control_Type_Failed[Type_Pos],DiagGetRespPrimitiveByte(SendData,5));
          else
            testStepPass("","期望失败响应结果与实际一致为 0x%02X",DiagGetRespPrimitiveByte(SendData,5));
        }
      }
      else 
      {
        if(Rx_Len == 5)
        {
          if(DiagGetRespPrimitiveByte(SendData,4) != Type)
            testStepFail("","期望失败响应结果为 0x%02X ,实际响应结果为 0x%02X",Type,DiagGetRespPrimitiveByte(SendData,4));
          else
            testStepPass("","期望失败响应结果与实际一致为 0x%02X",DiagGetRespPrimitiveByte(SendData,4));
        }
        else if(Rx_Len == 6) //返回长度为6，默认为Geely相关项目，第5byte响应固定为0x10;
        {
          if(DiagGetRespPrimitiveByte(SendData,4) != 0x10)
            testStepFail("","期望失败响应结果为 0x10 ,实际响应结果为 0x%02X",DiagGetRespPrimitiveByte(SendData,4));
          if(DiagGetRespPrimitiveByte(SendData,5) != Type)
            testStepFail("","期望失败响应结果为 0x%02X ,实际响应结果为 0x%02X",Type,DiagGetRespPrimitiveByte(SendData,5));
          else
            testStepPass("","期望失败响应结果与实际一致为 0x%02X",DiagGetRespPrimitiveByte(SendData,5));
        }
      }
    }
  }
  return Return_Value;
}
_Clear_SendData(byte Send_Data[])
{
  int k;
  for(k=0;k<elcount(Send_Data);k++)
    Send_Data[k] = Send_filler;
}

/// <Security Access>
/*
  长安工厂模式
  Type = 0 ：进入工厂模式
  Type = 1 ：退出工厂模式
*/
_Factory_Mode(byte Type)
{
  byte Send_Data[6] = {0x2E,0X01,0X00,0X00,0X00,0X00};
  _unlockECU();
  Send_Data[3] = Type;
  _Send_Diag(6,phyreq_ID,Send_Data);
  _TestResult(SendData,phyreq_ID,"",-1);
}

/// <Security Access>
//请求解锁ECU
_unlockECU()
{
  if(AES_128 != 2)
    _SetSession(exsession);
  diagResize(reqseed,2);
  diagResize(sendkey,SendKey_Len);
  DiagSetPrimitiveByte(reqseed,0,0x27);
  DiagSetPrimitiveByte(sendkey,0,0x27);
  DiagSetPrimitiveByte(reqseed,1,RequestSeed_27);
  DiagSetPrimitiveByte(sendkey,1,SendKey_27);
  if(AES_128==0)
  {
    dword seed;
    dword skey;
    testCaseComment("请求解锁ECU");
    diagSendRequest(reqseed);
    diagSetP2Extended(-1);
    testWaitForDiagRequestSent(reqseed,500);
    testWaitForDiagResponse(reqseed,p2cmax);
    if(diagGetLastResponseCode(reqseed)==0x78)
      testWaitForDiagResponse(reqseed,p2cmax*100);
    if(diagGetLastResponseCode(reqseed)==-1)
    {
      int Seed_Pos,Seed_Len,Key_Loop;
      Seed_Len = DiagGetRespPrimitiveSize(reqseed);
      seed = 0;skey = 0;
      for(Seed_Pos = 2 ;Seed_Pos < Seed_Len;Seed_Pos++)
        seed = seed | (DiagGetRespPrimitiveByte(reqseed,Seed_Pos) << ((Seed_Len -3 -(Seed_Pos-2))*8));
      /*安全算法函数*/
      testStep("种子","种子为0x%08X",seed);
      _SecurityAccess(seed,skey);
      testStep("密钥","计算出密钥为0x%08X",skey);
      DiagSetPrimitiveByte(sendkey,0,0x27);
      for(Key_Loop = 2;Key_Loop < SendKey_Len;Key_Loop++)
        DiagSetPrimitiveByte(sendkey,Key_Loop,(skey>>((SendKey_Len-1-Key_Loop)*8))&0xFF);
      diagSendRequest(sendkey);
      testWaitForDiagRequestSent(sendkey,50);
      diagSetP2Extended(-1);
      testWaitForDiagResponse(sendkey,p2cmax);
      if(diagGetLastResponseCode(sendkey)==0x78)
        testWaitForDiagResponse(sendkey,p2cmax*100);
      /*判断是否解锁成功*/
      if(diagGetLastResponseCode(sendkey)==-1)
        testStepPass("ECU解锁成功");
      else
        testStepFail("ECU解锁失败");
    }
    else
      testStepFail("ECU解锁,获取种子失败");
    testWaitForTimeout(500);
  }
  else if(AES_128==1)
  {
    testWaitForTimeout(500);    //排除10 03的反馈干扰,会影响到获取种子
    testCaseComment("请求解锁ECU");
    _SendAndWriteReport_NoTime(reqseed,phyreq_ID);
    _saveMsg(p2cmax);
    _CheckCode(-1,4);
    testWaitForTimeout(200);
    diagResize(sendkey,SendKey_Len);
    DiagSetPrimitiveByte(sendkey,1,SendKey_27);
    _padding2702(0);
    _SendAndWriteReport_NoTime(sendkey,phyreq_ID);
    _saveMsg(p2cmax);
    testWaitForTimeout(150);
  }
  else if(AES_128==2) /*AES_CBC*/
  {
    byte data[3]={0x22,0xF1,0x8C};
    int m;
    testCaseComment("获取序列号");
    _Send_Diag_And_Get_CF(3,phyreq_ID,data);
    if(diagGetLastResponseCode(SendData) == -1)
    {
      if(DiagGetRespPrimitiveSize(SendData) == 22)
      {
        for(m=0;m<16;m++)
          Serial_number[m] = DiagGetRespPrimitiveByte(SendData,m+6);
        /*序列号移位*/
        LeftMove(Serial_number,3);
//        for(m=0;m<16;m++)
//          writeEx(-3,0,"----------移位后序列号-------0x%02X",Serial_number[m]);
        /*用ECU KEY加密移位后的序列号 获取密钥KEY*/
        AES128_CBC_encrypt_buffer(Secret_KEY,Serial_number,KEY_Len,ECU_Key,Iv); 
//        for(m=0;m<16;m++)
//          writeEx(-3,0,"----------移位后密钥KEY-------0x%02X",Secret_KEY[m]);
        
        _SetSession(exsession);
        testWaitForTimeout(150);
        testCaseComment("请求解锁ECU");
        _SendAndWriteReport(reqseed,phyreq_ID,500);
        if(diagGetLastResponseCode(reqseed) == -1)
        {
//          byte Temp_Seed_Check[16] = {0x83,0x88,0x5F,0x19,0x0D,0x55,0xCD,0xB8,0xE9,0x23,0x67,0x4E,0x89,0x45,0x1C,0xA2};
//          RA[m]=Temp_Seed_Check[m];
          for(m=0;m<16;m++)
            RA[m]=DiagGetRespPrimitiveByte(reqseed,m+2);
          /*用密钥KEY解密RA 得到ra`*/
          AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,Iv);
          
          /*ra逆向*/
          reverseNum(ra,16);
          testWaitForTimeout(100);
          /*用密钥KEY加密r得到R*/
          AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,Iv);
          diagResize(sendkey,18);
          DiagSetPrimitiveByte(sendkey,1,SendKey_27);
          for(m=0;m<16;m++)
            DiagSetPrimitiveByte(sendkey,m+2,R[m]);
          _SendAndWriteReport(sendkey,phyreq_ID,p2cmax);
          if(diagGetLastResponseCode(sendkey)==-1)
            testStepPass("ECU解锁成功");
          else
            testStepFail("ECU解锁失败");
        }
        else
          testStepFail("","请求种子失败");
      }
      else
        testStepFail("","返回序列号长度错误,导致秘钥Key不可信");
    }
    else
      testStepFail("","未收到正确序列号,无法进行安全访问");
  }
}
/// <Security Access>
_unlockFactory()
{
  dword seed;
  dword skey;
  byte Tem[2] = {0x10,0x60};
  testCaseComment("请求进入工厂模式");
  _SetSession(3);
  _Send_Diag(2,phyreq_ID,Tem);
  _TestResult(SendData,phyreq_ID,"",-1);
  diagResize(reqseed,2);
  DiagSetPrimitiveByte(reqseed,0,0x27);
  DiagSetPrimitiveByte(reqseed,1,0x61);
  diagSendRequest(reqseed);
  testWaitForDiagResponse(reqseed,p2cmax);
  if(diagGetLastResponseCode(reqseed)==-1)
  {
    dword KeyK;
    dword KeyResult;
    int Seed_Pos,Seed_Len,Key_Loop;
    KeyK=0X00000137;
    Seed_Len = DiagGetRespPrimitiveSize(reqseed);
    for(Seed_Pos = 2 ;Seed_Pos < Seed_Len;Seed_Pos++)
      seed = seed | (DiagGetRespPrimitiveByte(reqseed,Seed_Pos) << ((Seed_Len -3 -(Seed_Pos-2))*8));
      /*安全算法函数*/
    
    KeyResult = ((((seed >> 1) ^ seed) <<3) ^ (seed >>2));
    skey = KeyResult ^ KeyK;
    skey += 0x112233cc;
    diagResize(sendkey,6);
    DiagSetPrimitiveByte(sendkey,0,0x27);
    DiagSetPrimitiveByte(sendkey,1,0x62);
    for(Key_Loop = 2;Key_Loop < 6;Key_Loop++)
      DiagSetPrimitiveByte(sendkey,Key_Loop,(skey>>((5-Key_Loop)*8))&0xFF);
    diagSendRequest(sendkey);
    testWaitForDiagResponse(sendkey,p2cmax+50);
      /*判断是否解锁成功*/
    if(diagGetLastResponseCode(sendkey)==-1)
      testStepPass("进入工厂模式成功");
    else
      testStepFail("进入工厂模式失败");
  }
  else
    testStepFail("进入工厂模式失败");
  testWaitForTimeout(500);
}
/// <Security Access>
/*
  加入时间，用于高负载测试
*/
qword _get_seed(dword ID,dword Time)        //获取种子
{
  byte Temp[2] = {0x27,0x01};
  byte Serial_Num_Req[3] = {0x22,0xF1,0x8C};
  qword seed_Temp;
  byte Len,i,Falge_AES_CBC;
  byte m;
  Len = 0;
  m = 0;
  seed_Temp = 0;
  Falge_AES_CBC = 0;
  Temp[1] = RequestSeed_27;
  if(AES_128==2 && Get_Seed_Flage==0)/*重复请求种子时跳过发送此部分*/
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    _WriteEx_and_Report("","获取序列号");
    _Send_Diag(3,phyreq_ID,Serial_Num_Req);
    if(diagGetLastResponseCode(SendData) == 0)
      testWaitForDiagResponse(SendData,Time);
    if(diagGetLastResponseCode(SendData) == -1)
    {
      if(DiagGetRespPrimitiveSize(SendData) == 22)
      {
        for(m=0;m<16;m++)
          Serial_number[m] = DiagGetRespPrimitiveByte(SendData,m+6);
        /*序列号移位*/
        LeftMove(Serial_number,3);
        /*用ECU KEY加密移位后的序列号 获取密钥KEY*/
        AES128_CBC_encrypt_buffer(Secret_KEY,Serial_number,KEY_Len,ECU_Key,Iv);
      }
      else
      {
        testStepFail("序列号长度错误");
        Falge_AES_CBC =1;
      }
    }
    else
    {
      testStepFail("获取序列号失败");
      Falge_AES_CBC =1;
    }
  }
  Temp[1] = RequestSeed_27;
  _Send_Diag(2,ID,Temp);
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,Time);
  if(diagGetLastResponseCode(SendData)==-1)
  {
    Len = DiagGetRespPrimitiveSize(SendData);
    if(AES_128==0)
    {
      for(i=2;i<Len;i++)
        seed_Temp = seed_Temp | (DiagGetRespPrimitiveByte(SendData,i)<<((Len-i-1)*8));
      testStep("种子","获取到种子为0x%2X",seed_Temp);
      Seed_Count_List[Seed_Count] = seed_Temp;
      Seed_Count++;
      return seed_Temp;
    }
    else if(AES_128==1)
    {
      _WriteEx_and_Report(ECU_project,"当前采用AES-128算法");
      for(i=2;i<Len;i++)
      {
        Seed_AES[i-2] = DiagGetRespPrimitiveByte(SendData,i);
        Seed_Count_List_AES128[Seed_Count][i-2] = DiagGetRespPrimitiveByte(SendData,i);
      }
      Seed_Count++;
      return 0;
    }
    else if(AES_128==2 && Falge_AES_CBC == 0)
    {
      for(i=2;i<Len;i++)
      {
        Seed_CBC[i-2] = DiagGetRespPrimitiveByte(SendData,i);
        Seed_Count_List_AES128[Seed_Count][i-2] = DiagGetRespPrimitiveByte(SendData,i);
      }
      Seed_Count++;
      return 0;
    }
    else if(AES_128==2 && Falge_AES_CBC == 1)
    {
      _WriteEx_and_Report(ECU_project,"序列号错误导致计算的秘钥不可信");
      return -1;
    }
    else
    {
      _WriteEx_and_Report(ECU_project,"安全访问算法选择异常");
      return -1;
    }
  }
  else
  {
    testStep("","获取种子失败");
    return -1;
  }
}
