/// <Node>
_Check_ID(char str_[])
{
  dword ID_Tmep;
  int x_x;
  ID_Tmep = atol(str_);
  if(ID_Tmep == 0 && (strncmp(str_,"XCP",strlen(str_)) == 0))
  {
    testStep(str_,"当前为内部XCP变量,无法进行节点操作");
    Canoe_Node_Flage = 0;
  }
  else if(ID_Tmep == 0 && (strncmp(str_,"XCP",strlen(str_)) != 0))
  {
    testStepFail(str_,"当前输入ID未查询到");
    Canoe_Node_Flage = -2;
  }
  else
  {
    for(x_x = 0;x_x < All_Node_Count;x_x++)
    {
      if(ID_Tmep == All_Node[x_x])
      {
        Canoe_Node_Flage = 1;  //可操作仿真ID
        break;
      }
      Canoe_Node_Flage = -1;
    }
    if(Canoe_Node_Flage==-1)
    {
      testStep(str_,"当前输入节点不属于Canoe仿真节点");
      writeEx(-3,0,"%s  当前输入节点不属于Canoe仿真节点",str_);
    }
  }
}
