_Check_Response_2E(diagRequest *Diag,dword LenInput,byte Tx_Data[])
{
  dword ReSize,i;
  byte Temp_Flage_1;
  i = 0;
  Temp_Flage_1=0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  ReSize = DiagGetRespPrimitiveSize(Diag);
  if(diagGetLastResponseCode(Diag) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(Diag) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(Diag) == -1)
  {
    if(ReSize == LenInput)
      testStepPass("","反馈长度与预期一致");
    else
      testStepFail("","反馈长度与预期不一致,预期为：%d，实际为：%d",LenInput,ReSize);
    if(DiagGetRespPrimitiveByte(SendData,0)!=0x62)
      testStepFail("","反馈值与预期不一致,预期为0x%2X,实际为0x%2X",0x62,DiagGetRespPrimitiveByte(SendData,0));
    if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
    {
      if(Tx_Data[0]==0x2E && Tx_Data[1] == 0xf1 && Tx_Data[2] == 0xa1)
      {
        for(i=3;i<LenInput-1;i++)
        {
          if(Tx_Data[i]!=0x00 && Tx_Data[i]!=0xFF)
            Temp_Flage_1 = 1;
        }
        if(Temp_Flage_1==1)
        {
          for(i=1;i<ReSize-1;i++)
          {
            if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
              testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
            else
              testStepPass("","反馈值与预期一致");
          } 
        }
        else
        {
          if(DiagGetRespPrimitiveByte(SendData,ReSize-1)!=0x00)
            testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%X,实际为0x%X",ReSize,0x00,DiagGetRespPrimitiveByte(SendData,ReSize-1));
          else
            testStepPass("","反馈值与预期一致");
        }
      }
      else
      {
        for(i=1;i<ReSize;i++)
        {
          if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
            testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
          else
            testStepPass("","反馈值与预期一致");
        }
      }
    }
    else
    {
      for(i=1;i<ReSize;i++)
      {
        if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
          testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
        else
          testStepPass("","反馈值与预期一致");
      }
    }
  }
}
_Check_Response_Part_number(diagRequest *Diag,dword LenInput,byte Tx_Data[])
{
  dword ReSize,i;
  byte Temp_Flage_1;
  i = 0;
  Temp_Flage_1=0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  ReSize = DiagGetRespPrimitiveSize(Diag);
  if(diagGetLastResponseCode(Diag) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(Diag) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(Diag) == -1)
  {
    if(DiagGetRespPrimitiveByte(SendData,0)!=0x62)
      testStepFail("","反馈值与预期不一致,预期为0x%2X,实际为0x%2X",0x62,DiagGetRespPrimitiveByte(SendData,0));
    if(Write_Part_number_Special == 0)
    {
      if(ReSize == LenInput)
        testStepPass("","反馈长度与预期一致");
      else
        testStepFail("","反馈长度与预期不一致,预期为：%d，实际为：%d",LenInput,ReSize);
      for(i=1;i<ReSize;i++)
      {
        if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
          testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
        else
          testStepPass("","反馈值与预期一致");
      }
    }
    else if(Write_Part_number_Special == 1)
    {
      // 2E 00 01 11 22 33 44 55 66 77 88 99 AA 11 22 22 33 44
      if(ReSize == LenInput-10)/*减去 11 22 …… AA长度*/
        testStepPass("","反馈长度与预期一致");
      else
        testStepFail("","反馈长度与预期不一致,预期为：%d，实际为：%d", LenInput-10,ReSize);
      for(i=1;i<3;i++)
      {
        if(DiagGetRespPrimitiveByte(SendData,i) != DiagGetPrimitiveByte(SendData,i))
          testStepFail("","反馈值与预期不一致,预期为0x%2X,实际为0x%2X",DiagGetPrimitiveByte(SendData,i),DiagGetRespPrimitiveByte(SendData,0));
      }
      for(i=3;i<ReSize;i++)
      {
        if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i+10])
          testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i+10],DiagGetRespPrimitiveByte(SendData,i));
        else
          testStepPass("","反馈值与预期一致");
      }
    }
  }
}
_Check_Response_(diagRequest *Diag,dword size,byte Ex[],byte Mask)
{
  dword ReSize,i;
  dword LenEx ;
  byte Flage;
  byte Flage_1;
  char Re[200];
  byte ResMask;
  i = 0;
  Flage = 0; Flage_1 = 0;
  LenEx = elCount(Ex);
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,2000);
  ReSize = DiagGetRespPrimitiveSize(Diag);
  if(diagGetLastResponseCode(Diag) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(Diag) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(Diag) == -1)
  {
    if(ReSize == size)
      testStepPass("","反馈长度与预期一致");
    else
      testStepFail("","反馈长度与预期不一致,预期为：%d，实际为：%d",size,ReSize);
    ResMask = DiagGetRespPrimitiveByte(Diag,5);
    for(i=0;i<size;i++)
    {
      if(i==5)
      {
        if(Mask == 0)//故障掩码跳过检测
          continue;
        else if(Mask == 1) //当前故障
        {
          if((ResMask & 0x01) == 1)
            testStepPass("","掩码与预期一致为当前故障");
          else
            testStepFail("","期望为当前故障，实际掩码为0X%02X",ResMask);
        }
        else if(Mask == 8) //历史故障
        {
          if(((ResMask & 0x08) == 8) && ((ResMask & 0x01) == 0))
            testStepPass("","掩码与预期一致为历史故障");
          else
            testStepFail("","期望为历史故障，实际掩码为0X%02X",ResMask);
        }
      }
      if(i == 5)
        continue;
      if(Ex[i] != DiagGetRespPrimitiveByte(Diag,i))
      {
        Flage = 1;
        testStep("","预期反馈结果：0x%2X",Ex[i]);
        testStep("","实际反馈结果：0x%2X",DiagGetRespPrimitiveByte(Diag,i));
        testStepFail("","反馈值存在于预期不符情况");
      }
    }
    if(Flage == 0)
      testStepPass("","反馈与预期一致");
  }
  testWaitForTimeout(100);
}
/// <DTC_Diag>
/*检测返回故障码是否均为预期故障或在白名单中*/
_Check_Response_DTC(diagRequest *Diag,dword Ex[])
{
  dword LenEx,ReSize,Wait_Flage;
  dword DTC_Rx[100],DTC_Rx_Count,DTC_Ex[20],DTC_Ex_Count;
  dword DTC_UnEx[100],DTC_UnEx_Count;
  int i,j,n;
  int Data_Zero_Count,DTC_UnEx_Flage,DTC_Same_Count;
  
  Data_Zero_Count = 0;
  DTC_UnEx_Flage = 0;
  DTC_Same_Count = 0;
  DTC_Ex_Count = 0;
  for(i=0;i<elCount(Ex);i++)
  {
    if(_Check_Dword_in_Num(Ex[i],DTC_Ex,DTC_Ex_Count) == -1)
    {
      DTC_Ex[DTC_Ex_Count] = Ex[i];
      DTC_Ex_Count++;
    }
    if(Ex[i]==0)
      Data_Zero_Count = 1;
  }
  LenEx = (DTC_Ex_Count-Data_Zero_Count)*4+3;/*无预期DTC输入,长度为3*/
  DTC_Ex_Count = DTC_Ex_Count-Data_Zero_Count;/*------*/
  DTC_Rx_Count = 0;
  DTC_UnEx_Count = 0;
  
  if(diagGetLastResponseCode(Diag) == 0)
  {
    Wait_Flage = 1;
    testWaitForDiagResponse(Diag,200);
  }
  ReSize = DiagGetRespPrimitiveSize(Diag);
  
  if(diagGetLastResponseCode(Diag) != -1)
    testStepFail("诊断反馈未收到正响应");
  else
  {
    if(Wait_Flage == 1 && ReSize<=7)
      testStepFail("","收到单帧时出现响应超时现象");
    DTC_Rx_Count = (ReSize-3)/4;
    for(i=0;i<DTC_Rx_Count;i++)
      DTC_Rx[i] = (diagGetRespPrimitiveByte(Diag,i*4 + 3 + 0)<<16) | (diagGetRespPrimitiveByte(Diag,i*4 + 3 + 1)<<8) | (diagGetRespPrimitiveByte(Diag,i*4 + 3 + 2));
    if(LenEx == ReSize)
    {
      testStepPass("","长度与期望一致");
      for(i=0;i<DTC_Ex_Count;i++)
      {
        j = _Check_Dword_in_Num(DTC_Ex[i],DTC_Rx,DTC_Rx_Count);
        if(j==-1)
          testStepFail("","期望 0x%06X DTC ,未报出",DTC_Ex[i]);
        else
          testStep("","DTC：0x%06X 存在",DTC_Ex[n]);
      }
    }
    else if(LenEx > ReSize)
    {
      testStepFail("","有期望DTC未报出");
      for(i=0;i<DTC_Ex_Count;i++)
      {
        j = _Check_Dword_in_Num(DTC_Ex[i],DTC_Rx,DTC_Rx_Count);
        if(j==-1)
          testStepFail("","期望 0x%06X DTC ,未报出",DTC_Ex[i]);
        else
          testStep("","DTC：0x%06X 存在",DTC_Ex[n]);
      }
    }
    else /*LenEx < ReSize 有非预期故障或白名单中故障*/
    {
      /*此处不判断长度，白名单故障不稳定全部出现*/
      for(i=0;i<DTC_Rx_Count;i++)
      {
        j = _Check_Dword_in_Num(DTC_Rx[i],DTC_Ex,DTC_Ex_Count);
        if(j==-1)
        {
          DTC_UnEx[DTC_UnEx_Count] = DTC_Rx[i];
          DTC_UnEx_Count++;
        }
      }
      for(i=0;i<DTC_UnEx_Count;i++)
      {
        j = _Check_Dword_in_Num(DTC_UnEx[i],DTC_Whitelist,DTC_Whitelist_Count);
        if(j==-1)
        {
          DTC_UnEx_Flage = 1;
          testStepFail("","出现非白名单中故障 0x%06X  ",DTC_UnEx[i]);
        }
      }
      if(DTC_UnEx_Flage == 0)
        testStepPass("","所有故障均在预期中");
      for(n=0;n<DTC_Ex_Count;n++)
      {
        if(DTC_Ex[n]==0)
          continue;
        j = _Check_Dword_in_Num(DTC_Ex[n],DTC_Rx,DTC_Rx_Count);
        if(j==-1)
          testStepFail("","期望DTC：0x%06X 存在，实际未报出",DTC_Ex[n]);
        else
          testStep("","DTC：0x%06X 存在",DTC_Ex[n]);
      }
    }
  }
}
_Check_Response(diagRequest *Diag,dword size,byte Ex[])
{
  dword ReSize,i;
  dword LenEx ;
  byte Flage;
  byte Flage_1;
  char Re[200];
  i = 0;
  Flage = 0; Flage_1 = 0;
  LenEx = elCount(Ex);
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,300);
  if(diagGetLastResponseCode(Diag) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(Diag) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(Diag) == -1)
  {
    ReSize = DiagGetRespPrimitiveSize(Diag);
    if(ReSize == size)
      testStepPass("","反馈长度与预期一致");
    else
      testStepFail("","反馈长度与预期不一致,预期为：%d，实际为：%d",size,ReSize);
    for(i=0;i<ReSize;i++)
    {
      if(Ex[i] != DiagGetRespPrimitiveByte(Diag,i))
      {
        Flage = 1; 
        // testStep("","预期反馈结果：0x%02X 实际反馈结果：0x%02X",Ex[i],DiagGetRespPrimitiveByte(Diag,i));
        testStepFail("","反馈值存在于预期不符情况,预期反馈结果：0x%02X 实际反馈结果：0x%02X",Ex[i],DiagGetRespPrimitiveByte(Diag,i));
      }
    }
    if(Flage == 0)
      testStepPass("","反馈与预期一致");
    if( LenEx < size)   //检测未使用填充位
      testStepFail("","返回长度与期望长度不匹配");
  }
}
