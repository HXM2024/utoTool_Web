  }
  else 
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  testWaitForTimeout(300);
}
/*
    除第0位外，其余每一位均和输入数组进行对比判断
    第0位与发送数组第0位^0x40进行判断
*/

void _Check_Response_Config(diagRequest* obj,byte Ex_Res[])
{
  int i,Flag;
  Flag = 0;
  if(diagGetLastResponseCode(obj) == -1)
  {
    if(DiagGetRespPrimitiveByte(obj,0) != (DiagGetPrimitiveByte(obj,0)^0x40))
      testStepFail("","实际反馈值与预期不等,期望为 0x%02X,实际为 0x%02X",(DiagGetPrimitiveByte(obj,0)^0x40),DiagGetRespPrimitiveByte(obj,0));
    if(DiagGetRespPrimitiveSize(obj)> elCount(Ex_Res))
      testStepFail("","收到返回长度与期望不符");
    else
    {
      for(i=1;i<DiagGetRespPrimitiveSize(obj);i++)
      {
        if(DiagGetRespPrimitiveByte(obj,i) != Ex_Res[i])
        {
          Flag = 1;
          testStepFail("","实际反馈值与预期不等,期望为 0x%02X,实际为 0x%02X",Ex_Res[i],DiagGetRespPrimitiveByte(obj,i));
        }
      }
      if(Flag == 0)
        testStepPass("","反馈值与预期一致");
    }
  }
  else
    _WriteEx_and_Report("","未收到正响应");
}

/// <DTC_Diag>
/*
    高级功能DTC变化
    Config_Send：当前写入的配置字
    DTC_Output：输出DTC
*/
void _Advanced_function_DTC(byte Config_Send[],dword DTC_Output[])
{
  int i,DTC_Count;
  byte Check_Byte,Check_Bit;
  DTC_Count = 0;
  for(i=0;i<Advanced_function_Count;i++)
  {
    if(Advanced_function[i].DTC != 0) //当无DTC时,不进行DTC输出
    {
      Check_Byte = Advanced_function[i].Fun_Byte+3;   //加上未计入的2E服务以及DID号
      Check_Bit = Advanced_function[i].Fun_Bit;
      if(((Config_Send[Check_Byte]>>Check_Bit) &0x01) == 1)
      {
        DTC_Output[DTC_Count] = Advanced_function[i].DTC;
        DTC_Count++;
      }
    }
  }
}
/*
  检测28服务返回值是否与期望相符
  Type = 0：取无效值
  Type = 1：第一次返回值
  Type = 2：第二次返回值
  Type = 3：第二次返回值 + 5
*/
_Check_Return(byte Type)
{
  int i,Flage,Size;
  qword Temp_Data;
  float Temp_Vaule;
  Flage = 0;   
  Temp_Data = 0;
  Temp_Vaule = 0;
  if(diagGetLastResponseCode(SendData) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(SendData) > 0)
    testStepFail("收到消极应答");
  else 
  {
    Size = DiagGetRespPrimitiveSize(SendData);
    if(DiagGetRespPrimitiveByte(SendData,0)!=(DiagGetPrimitiveByte(SendData,0)^0x40))
    {
      Flage = 1;
      testStepFail("","反馈值与预期不一致,预期为0x%2X,实际为0x%2X",DiagGetPrimitiveByte(SendData,0)^0x40,DiagGetRespPrimitiveByte(SendData,0));
    }
    for(i=1;i<3;i++)
    {
      if(DiagGetRespPrimitiveByte(SendData,i)!= DiagGetPrimitiveByte(SendData,i))
      {
        Flage = 1;
        testStepFail("","反馈值与预期不一致,预期为0x%2X,实际为0x%2X",DiagGetPrimitiveByte(SendData,i),DiagGetRespPrimitiveByte(SendData,i));
      }
    }
    for(i=3;i<DiagGetRespPrimitiveSize(SendData);i++)
      Temp_Data = Temp_Data + (DiagGetRespPrimitiveByte(SendData,i)<<(8*(Size-(i+1))));
    if(Type != 0)
    {
      Temp_Vaule = Temp_Data*Factor_28 - Offset_28;
      if(Type == 1)
      {
        if((Temp_Vaule>= (DID28_Case_CarSpd_1 - Tolerance_28)) && (Temp_Vaule<= (DID28_Case_CarSpd_1 + Tolerance_28)))
          testStepPass("","期望值与反馈值在误差范围内,实际反馈值为 %.2f",Temp_Vaule);
        else
          testStepFail("","期望结果与实际结果相差较大,期望为 %d ± %.2f,实际为 %.2f ",DID28_Case_CarSpd_1,Tolerance_28,Temp_Vaule);
      }
      else if(Type == 2)
      {
        if((Temp_Vaule>= (DID28_Case_CarSpd_2 - Tolerance_28)) && (Temp_Vaule<= (DID28_Case_CarSpd_2 + Tolerance_28)))
          testStepPass("","期望值与反馈值在误差范围内,实际反馈值为 %.2f",Temp_Vaule);
        else
          testStepFail("","期望结果与实际结果相差较大,期望为 %d ± %.2f,实际为 %.2f ",DID28_Case_CarSpd_2,Tolerance_28,Temp_Vaule);
      }
      else if(Type == 3)
      {
        if((Temp_Vaule>= (DID28_Case_CarSpd_2+5 - Tolerance_28)) && (Temp_Vaule<= (DID28_Case_CarSpd_2+5 + Tolerance_28)))
          testStepPass("","期望值与反馈值在误差范围内,实际反馈值为 %.2f",Temp_Vaule);
        else
          testStepFail("","期望结果与实际结果相差较大,期望为 %d ± %.2f,实际为 %.2f ",DID28_Case_CarSpd_2+5,Tolerance_28,Temp_Vaule);
      }
    }
    else if(Type == 0)
    {
      if(DID28_Sig_Invaild_Value == -1) //上一次有效值
      {
        Temp_Vaule = Temp_Data*Factor_28 - Offset_28;
        _WriteEx_and_Report("","取上一次有效值");
        if((Temp_Vaule>= (DID28_Case_CarSpd_1 - Tolerance_28)) && (Temp_Vaule<= (DID28_Case_CarSpd_1 + Tolerance_28)))
          testStepPass("","期望值与反馈值在误差范围内,实际反馈值为 %.2f",Temp_Vaule);
        else
          testStepFail("","期望结果与实际结果相差较大,期望为 %d ± %.2f,实际为 %.2f ",DID28_Case_CarSpd_1,Tolerance_28,Temp_Vaule);
      }
      else
      {
        if(Temp_Data != DID28_Sig_Invaild_Value)
        {
          testStepFail("","期望无效值与实际无效值不等");
          testStep("","期望无效值为 0x%X",DID28_Sig_Invaild_Value);
          testStep("","实际无效值为 0x%X",Temp_Data);
        }
        else
          testStepPass("","期望无效值与实际无效值一致,实际无效值为 0x%X",Temp_Data);
      }
    }
  }
}
/*
  判断10服务的返回内容
  size：预期返回长度
  Sub_Function：发送子功能
  Time_1：10服务返回的P2can_server
  Time_2：10服务返回的P2_can_server
*/
_Check_10_01(dword size,byte Sub_Function,dword Time_1,dword Time_2)
{
  dword Temp_Time_1;
  dword Temp_Time_2;
  int i=0;
  char Buffer_Temp[100];
  byte result;
  message 0x00 msg;
  Temp_Time_1 = 0;Temp_Time_2 = 0;
  snprintf(Buffer_Temp,elCount(Buffer_Temp),"%s","");
  Buffer_Temp[0] = 0x50;
  Buffer_Temp[1] = Sub_Function;
//  if(Sub_Function ==0x02 && Sub_1002_NRC78==1)
  if(Sub_Function ==0x02 && _Check_Dword_in_Num(0x10,NotNRC78_Serve,NotNRC78_Serve_Count)!=-1)
  {
    result=testWaitForMessage(Response_ID,p2cmax);
    testGetWaitEventMsgData(msg);
    if((msg.byte(0)==0x03)&&(msg.byte(1)==0x7F)&&(msg.byte(3)==0x78))
      testStepFail("","收到否定响应NRC78");
    else
      testStepPass("","未收到否定响应NRC78");
  }
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,p2cmax);
  testReportWriteDiagResponse(SendData);
  if(size==DiagGetRespPrimitiveSize(SendData))
  {
    testStepPass("","反馈长度与预期长度一致");
    writeEx(-3,0,"反馈长度与预期长度一致");
  }
  else
  {
    testStepFail("","预期长度%d，实际长度：%d",size,DiagGetRespPrimitiveSize(SendData));
    writeEx(-3,0,"预期长度%d，实际长度：%d",size,DiagGetRespPrimitiveSize(SendData));
  }
  for(i=0;i<2;i++)
  {
    if(DiagGetRespPrimitiveByte(SendData,i) != Buffer_Temp[i])
      testStepFail("","正响应部分异常，与期望不一致");
    else
      testStepPass("","响应与期望一致");
  }
  if(Sub_Function==0x02 && Sub_1002_Time_Flage==0)
  {
    Temp_Time_1 = DiagGetRespPrimitiveByte(SendData,2)*256+DiagGetRespPrimitiveByte(SendData,3);
    if(Temp_Time_1 == Sub_1002_Time)
      testStepPass("","P2can_server时间与期望一致为%d",Time_1);
    else
      testStepFail("","P2can_server期望为%d,实际为%d",Sub_1002_Time,Temp_Time_1);
  }
  else
  {
    Temp_Time_1 = DiagGetRespPrimitiveByte(SendData,2)*256+DiagGetRespPrimitiveByte(SendData,3);
    Temp_Time_2 = DiagGetRespPrimitiveByte(SendData,4)*256+DiagGetRespPrimitiveByte(SendData,5);
    if(Temp_Time_1 == Time_1)
      testStepPass("","P2can_server时间与期望一致为%d",Time_1);
    else
      testStepFail("","P2can_server期望为%d,实际为%d",Time_1,Temp_Time_1);
    if(Temp_Time_2*10 == Time_2)
      testStepPass("","P2*can_server时间与期望一致为%d",Time_2);
    else
      testStepFail("","P2*can_server期望为%d,实际为%d",Time_2,Temp_Time_2*10);
  }
}
int _Check_1901(diagRequest* Diag)
{
  int Re_count;
  Re_count = 0;
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    if(DiagGetRespPrimitiveSize(Diag)!= 6)
    {
      testStepFail("","长度错误,预期长度为6,实测长度为%d",DiagGetRespPrimitiveSize(Diag));
    }
    else{
    if(DiagGetRespPrimitiveByte(Diag,0)!=0x59)
      testStepFail("","反馈值与预期不一致,预期为0x%02X,实际为0x%02X",DiagGetPrimitiveByte(Diag,0)^0x40,DiagGetRespPrimitiveByte(Diag,0));
    if(DiagGetRespPrimitiveByte(Diag,1)!=DiagGetPrimitiveByte(Diag,1))
      testStepFail("","反馈值与预期不一致,预期为0x%02X,实际为0x%02X",DiagGetPrimitiveByte(Diag,1),DiagGetRespPrimitiveByte(Diag,1));
    if(DiagGetRespPrimitiveByte(Diag,2)!=Mask_19)
      testStepFail("","反馈值与预期不一致,预期为0x%02X,实际为0x%02X",Mask_19,DiagGetRespPrimitiveByte(Diag,2));
    if(DiagGetRespPrimitiveByte(Diag,3)!=DTC_Code)
      testStepFail("","反馈值与预期不一致,预期为0x%02X,实际为0x%02X",DTC_Code,DiagGetRespPrimitiveByte(Diag,3));
    Re_count = (DiagGetRespPrimitiveByte(Diag,4)<<16)+DiagGetRespPrimitiveByte(Diag,5);  /*由于白名单问题,导致此处数据会与预期数据有冲突,导致不可信,此处不检测实际个数*/
//    if(Re_count!= count)
//      testStepFail("","预期DTC个数为%d个,实测响应DTC个数为%d个",count,Re_count);
//    else
//      testStepPass("","预期DTC个数与实际一致");
    testStep("","预期DTC个数%d",Re_count);
    }
  }
  return Re_count;
}

_Check_190201(diagRequest* Diag,dword DTC,dword Mask,int Count_Num)
{
  int ii,j,Rx_Count,DTC_ReFlage;
  dword DTC_Res[100][2];
  dword RxSize;
  byte Temp_59[3] = {0x59,0x02,0x09};
  byte DTC_HisOrNow_Flage;
  Temp_59[2] = Mask_19;
  DTC_ReFlage = 0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    RxSize = DiagGetRespPrimitiveSize(Diag);
    Rx_Count = (RxSize-3)/4;
    //判断为当前故障还是历史故障
    if((Mask & 0x09) == 9)
      DTC_HisOrNow_Flage = 1;//当前故障
    else
      DTC_HisOrNow_Flage = 0;
    for(ii=0;ii<3;ii++)
    {
      if(Temp_59[ii] != diagGetRespPrimitiveByte(Diag,ii))
        testStepFail("前三字节","第%d字节错误，预期为0x%02X,实测为0x%02X",ii,Temp_59[ii],diagGetRespPrimitiveByte(Diag,ii));
    }
    if(RxSize>=7)
    {
      for(ii=0;ii<Rx_Count;ii++)
      {
        DTC_Res[ii][0] = (diagGetRespPrimitiveByte(Diag,ii*4+3+0)<<16) + (diagGetRespPrimitiveByte(Diag,ii*4+3+1)<<8)+ (diagGetRespPrimitiveByte(Diag,ii*4+3+2));
        DTC_Res[ii][1] = diagGetRespPrimitiveByte(Diag,ii*4+3+3);
      }
    }
    if(DTC != 0)
    {
      if(Count_Num != -1) //检测个数及反馈
      {
        if(Rx_Count != Count_Num)
          testStepFail("","实际反馈的故障与预期的故障个数不匹配,期望为%d ,实际为%d",Count_Num,(RxSize-3)/4);
        else
          testStepPass("","19 %02X %02X故障个数与预期一致",DiagGetPrimitiveByte(Diag,1),DiagGetPrimitiveByte(Diag,2));
        if(Rx_Count == Count_Num && Count_Num == 0)
          return;
        if(RxSize<7 && Count_Num>0)
          testStepFail("","长度异常,当前长度无故障");
        else
        {
          for(ii=0;ii<Rx_Count;ii++)
          {
            if(DTC_Res[ii][0] == DTC)
            {
              byte Rx_DTC_HisOrNow_Flage;
              DTC_ReFlage = 1;
              testStepPass("","故障码0x%06X在反馈中",DTC);
              if((DTC_Res[ii][1] & 0x09) == 9)
                Rx_DTC_HisOrNow_Flage = 1;
              else
                Rx_DTC_HisOrNow_Flage = 0;
              if(Rx_DTC_HisOrNow_Flage == DTC_HisOrNow_Flage)
              {
                if(DTC_HisOrNow_Flage == 1)
                  testStepPass("","掩码与预期一致为当前故障,实测掩码为0x%02X",DTC_Res[ii][1]);
                else
                  testStepPass("","掩码与预期一致为历史故障,实测掩码为0x%02X",DTC_Res[ii][1]);
              }
              else
              {
                if(DTC_HisOrNow_Flage == 1)
                  testStepFail("","故障码0x%X对应的掩码与预期不符,预期为当前故障,实测掩码为0x%02X",DTC,DTC_Res[ii][1]);
                else
                  testStepFail("","故障码0x%X对应的掩码与预期不符,预期为历史故障,实测掩码为0x%02X",DTC,DTC_Res[ii][1]);
              }
              break;
            }
          }
          if(RxSize > 7)
          {
            testStep("","存在其他故障");
            for(ii=0;ii<Rx_Count;ii++)
            {
              j= _Check_Dword_in_Num(DTC_Res[ii][0],DTC_Whitelist,DTC_Whitelist_Count);
              if(j==-1 && DTC_Res[ii][0] != DTC)
                testStepFail("","存在非预期故障0x%06X",DTC_Res[ii][0]);
            }
          }
          if(DTC_ReFlage == 0)
            testStepFail("","预期故障码0x%06X未报出",DTC);
        }
      }
      else //仅检测DTC反馈状态
      {
        for(ii=0;ii<Rx_Count;ii++)
        {
          if(DTC_Res[ii][0] == DTC)
          {
            byte Rx_DTC_HisOrNow_Flage;
            DTC_ReFlage = 1;
            testStepPass("","故障码0x%06X在反馈中",DTC);
            if((DTC_Res[ii][1] & 0x09) == 9)
              Rx_DTC_HisOrNow_Flage = 1;
            else
              Rx_DTC_HisOrNow_Flage = 0;
            if(Rx_DTC_HisOrNow_Flage == DTC_HisOrNow_Flage)
            {
              if(DTC_HisOrNow_Flage == 1)
                testStepPass("","掩码与预期一致为当前故障,实测掩码为0x%02X",DTC_Res[ii][1]);
              else
                testStepPass("","掩码与预期一致为历史故障,实测掩码为0x%02X",DTC_Res[ii][1]);
            }
            else
            {
              if(DTC_HisOrNow_Flage == 1)
                testStepFail("","故障码0x%X对应的掩码与预期不符,预期为当前故障,实测掩码为0x%02X",DTC,DTC_Res[ii][1]);
              else
                testStepFail("","故障码0x%X对应的掩码与预期不符,预期为历史故障,实测掩码为0x%02X",DTC,DTC_Res[ii][1]);
            }
            break;
          }
          else 
          {
            if((DTC_Res[ii][1] & DiagGetPrimitiveByte(Diag,2)) == 0)
              testStepFail("","故障码0x%X对应的掩码与预期发送不匹配,实测掩码为0x%02X",DTC,DTC_Res[ii][1]);
          }
        }
        if(DTC_ReFlage == 0 && DTC !=0)
          testStepFail("","故障码0x%06X不在反馈中",DTC);
      }
    }
    else
    {
      if(RxSize>3)
      {
        testStep("","长度异常,当前长度存在其他故障");
        for(ii=0;ii<Rx_Count;ii++)
        {
          j= _Check_Dword_in_Num(DTC_Res[ii][0],DTC_Whitelist,DTC_Whitelist_Count);
          if(j == -1 )
            testStepFail("","存在非预期故障0x%06X",DTC_Res[ii][0]);
        }
      }
    }
  }
}

_Check_190201(diagRequest* Diag,dword DTC,dword Mask)
{
  int ii,j,Rx_Count,DTC_ReFlage;
  dword DTC_Res[100][2];
  dword RxSize;
  byte Temp_59[3] = {0x59,0x02,0x09};
  byte DTC_HisOrNow_Flage;
  Temp_59[2] = Mask_19;
  DTC_ReFlage = 0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    RxSize = DiagGetRespPrimitiveSize(Diag);
    Rx_Count = (RxSize-3)/4;
    //判断为当前故障还是历史故障
    if((Mask & 0x09) == 9)
      DTC_HisOrNow_Flage = 1;//当前故障
    else
      DTC_HisOrNow_Flage = 0;
    for(ii=0;ii<3;ii++)
    {
      if(Temp_59[ii] != diagGetRespPrimitiveByte(Diag,ii))
        testStepFail("前三字节","第%d字节错误，预期为0x%02X,实测为0x%02X",ii,Temp_59[ii],diagGetRespPrimitiveByte(Diag,ii));
    }
    if(RxSize>=7)
    {
      for(ii=0;ii<Rx_Count;ii++)
      {
        DTC_Res[ii][0] = (diagGetRespPrimitiveByte(Diag,ii*4+3+0)<<16) + (diagGetRespPrimitiveByte(Diag,ii*4+3+1)<<8)+ (diagGetRespPrimitiveByte(Diag,ii*4+3+2));
        DTC_Res[ii][1] = diagGetRespPrimitiveByte(Diag,ii*4+3+3);
      }
    }
    if(DTC != 0)
    {
      if(RxSize<7)
        testStepFail("","长度异常,当前长度无故障");
      else
      {
        for(ii=0;ii<Rx_Count;ii++)
        {
          if(DTC_Res[ii][0] == DTC)
          {
            byte Rx_DTC_HisOrNow_Flage;
            DTC_ReFlage = 1;
            testStepPass("","故障码0x%06X在反馈中",DTC);
            if((DTC_Res[ii][1] & 0x09) == 9)
              Rx_DTC_HisOrNow_Flage = 1;
            else
              Rx_DTC_HisOrNow_Flage = 0;
            if(Rx_DTC_HisOrNow_Flage == DTC_HisOrNow_Flage)
            {
              if(DTC_HisOrNow_Flage == 1)
                testStepPass("","掩码与预期一致为当前故障,实测掩码为0x%02X",DTC_Res[ii][1]);
              else
                testStepPass("","掩码与预期一致为历史故障,实测掩码为0x%02X",DTC_Res[ii][1]);
            }
            else
            {
              if(DTC_HisOrNow_Flage == 1)
                testStepFail("","故障码0x%X对应的掩码与预期不符,预期为当前故障,实测掩码为0x%02X",DTC,DTC_Res[ii][1]);
              else
                testStepFail("","故障码0x%X对应的掩码与预期不符,预期为历史故障,实测掩码为0x%02X",DTC,DTC_Res[ii][1]);
            }
            break;
          }
        }
        if(RxSize > 7)
        {
          testStep("","存在其他故障");
          for(ii=0;ii<Rx_Count;ii++)
          {
            j= _Check_Dword_in_Num(DTC_Res[ii][0],DTC_Whitelist,DTC_Whitelist_Count);
            if(j==-1 && DTC_Res[ii][0] != DTC)
              testStepFail("","存在非预期故障0x%06X",DTC_Res[ii][0]);
          }
        }
        if(DTC_ReFlage == 0)
          testStepFail("","预期故障码0x%06X未报出",DTC);
      }
    }
    else
    {
      if(RxSize>3)
      {
        testStep("","长度异常,当前长度存在其他故障");
        for(ii=0;ii<Rx_Count;ii++)
        {
          j= _Check_Dword_in_Num(DTC_Res[ii][0],DTC_Whitelist,DTC_Whitelist_Count);
          if(j == -1 )
            testStepFail("","存在非预期故障0x%06X",DTC_Res[ii][0]);
        }
      }
    }
  }
}


_Check_1902(diagRequest* Diag)
{
  int ii,k,j;
  dword DTC_Temp[100][3];
  byte DTC_Temp_Count;
  dword DTC_Res[100][3];
  byte state,Flage_For;
  dword RxSize;
  dword Byte_H,Byte_M,Byte_L;
  Flage_For = 0;
  state = DiagGetPrimitiveByte(Diag,2);
  DTC_Temp_Count = 0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    if((state & Mask_19) != 0)
    {
      for(ii=0;ii<DTC_19_Count;ii++) //来源于外部DTC输入
      {
        if((DTC_19[ii][2]&state)>0 ) //此时已被制造故障或恢复故障更改
        {
          DTC_Temp[DTC_Temp_Count][0] = DTC_19[ii][1];
          DTC_Temp[DTC_Temp_Count][1] = DTC_19[ii][2];
          if((DTC_Temp[DTC_Temp_Count][1]&0x09) == 9) 
            DTC_Temp[DTC_Temp_Count][2] = 1;  //当前故障
          else
            DTC_Temp[DTC_Temp_Count][2] = 0; //历史故障
          DTC_Temp_Count++;
        }
      }
      RxSize = DiagGetRespPrimitiveSize(Diag);
      DTC_Num_Rx = (RxSize - 3)/4;
      for(ii=0;ii<DTC_Num_Rx;ii++)
      {
        DTC_Res[ii][0] = (diagGetRespPrimitiveByte(Diag,ii*4+3+0)<<16) + (diagGetRespPrimitiveByte(Diag,ii*4+3+1)<<8)+ (diagGetRespPrimitiveByte(Diag,ii*4+3+2));
        DTC_Res[ii][1] = diagGetRespPrimitiveByte(Diag,ii*4+3+3);
        if((DTC_Res[ii][1]&0x09) == 9) 
          DTC_Res[ii][2] = 1;  //当前故障
        else
          DTC_Res[ii][2] = 0; //历史故障
      }
      testStep("","读取0x19 0x02 0x%02X对应的掩码的故障码数量为%d个",state,DTC_Temp_Count);
      for(ii=0;ii<DTC_19_Count;ii++) 
      {
        for(k=0;k<DTC_Num_Rx;k++)
        {
          if(DTC_Temp[ii][0] == DTC_Res[k][0])
          {
            if(DTC_Temp[ii][2] == DTC_Res[k][2])
            {
              testStepPass("","故障码0x%X在反馈DTC中且与预期掩码一致",DTC_Temp[ii][0]);
              testStep("掩码","预期掩码：0x%02X,实际掩码：0x%02X",DTC_Temp[ii][1],DTC_Res[k][1]);
              break;
            }
            else
            {
              for(j=0;j<DTC_Whitelist_Count;j++)
              {
                if(DTC_Res[k][0] == DTC_Whitelist[j])  //白名单中故障码
                {
                  if((DTC_Res[k][1] & 0x09)==0x09)
                  {
                    testStepPass("","故障码0x%X为白名单中故障，其掩码状态为当前：0x%02X",DTC_Res[k][0],DTC_Res[k][1]);
                    break;
                  }
                }
              }
              if (j==DTC_Whitelist_Count)
                  testStepFail("","故障码0x%06X对应的掩码与预期不符,预期为0x%02X,实测为0x%02X",DTC_Temp[ii][0],DTC_Temp[ii][1],DTC_Res[k][1]);
            }
          }
        }
      }
    }
    else
    {
      byte data_0[3] = {0x59,0x02,0x09};
      data_0[2] = Mask_19;
      _Check_Response(Diag,3,data_0);
    }
  }
}
/*
  仅检测DTC个数，不检测其他
*/
_Check_1902(diagRequest* Diag,dword Rx_Num)
{
  byte DTC_Temp_Count;
  dword DTC_Res[100][2];
  dword RxSize;
  dword Byte_H,Byte_M,Byte_L;
  int ii;
  byte state,Flage_For;
  byte State_Count;
  state = DiagGetPrimitiveByte(Diag,2);
  State_Count = 0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    RxSize = DiagGetRespPrimitiveSize(Diag);
    DTC_Temp_Count = (RxSize - 3)/4;
    for(ii=0;ii<DTC_Temp_Count;ii++)
    {
      DTC_Res[ii][0] = (diagGetRespPrimitiveByte(Diag,ii*4+3+0)<<16) + (diagGetRespPrimitiveByte(Diag,ii*4+3+1)<<8)+ (diagGetRespPrimitiveByte(Diag,ii*4+3+2));
      DTC_Res[ii][1] = diagGetRespPrimitiveByte(Diag,ii*4+3+3);
    }
    for(ii=0;ii<DTC_Temp_Count;ii++)
    {
      if((DTC_Res[ii][1] & state) >0)
      {
        State_Count++;
      }
      else
        teststep("","DTC: 0x%06X 掩码为 0x%02X",DTC_Res[ii][0],DTC_Res[ii][1]);
    }
    if(Rx_Num != State_Count)
      testStepFail("","获取到的DTC个数与实际反馈个数不一致，预期个数为%d,实际个数为%d",Rx_Num,State_Count);
    else
      testStepPass("","实际反馈个数与预期个数一致，为%d个",Rx_Num);
  }
}
/*
  仅检测DTC对应掩码
*/
_Check_1902(diagRequest* Diag,dword DTC,byte Mask)
{
  byte DTC_Temp_Count;
  dword DTC_Res[100][2];
  dword RxSize;
  int ii;
  byte state;
  state = DiagGetPrimitiveByte(Diag,2);
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    RxSize = DiagGetRespPrimitiveSize(Diag);
    DTC_Temp_Count = (RxSize - 3)/4;
    for(ii=0;ii<DTC_Temp_Count;ii++)
    {
      DTC_Res[ii][0] = (diagGetRespPrimitiveByte(Diag,ii*4+3+0)<<16) + (diagGetRespPrimitiveByte(Diag,ii*4+3+1)<<8)+ (diagGetRespPrimitiveByte(Diag,ii*4+3+2));
      DTC_Res[ii][1] = diagGetRespPrimitiveByte(Diag,ii*4+3+3);
    }
    for(ii=0;ii<DTC_Temp_Count;ii++)
    {
      if(DTC_Res[ii][0] == DTC)
      {
        if(DTC_Res[ii][1] == Mask)
          testStepPass("","DTC:0x%06X,掩码与期望一致，均为0x%02X",DTC,Mask);
        else
          testStepFail("","DTC:0x%06X,掩码与期望不一致，期望为0x%02X，实际为0x%02X",DTC,Mask,DTC_Res[ii][1]);
        break;
      }
    }
    if(ii == DTC_Temp_Count)
      testStepFail("","DTC:0x%06X,未检测到",DTC);
  }
}
