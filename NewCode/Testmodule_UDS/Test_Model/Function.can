/*
    打印数据到Trace界面以及Report报告中
*/
_WriteEx_and_Report(char str1[],char str2[])
{
  char str[500];
  
  snprintf(str,elCount(str),"%s","");
  
  TestStep(str1,str2);
  strncpy(str,str1,elCount(str));
  strncat(str,"   ",elCount(str));
  strncat(str,str2,elCount(str));
  writeEx(-3,0,str);
}
/*
    打印数据到Trace界面以及Report报告中
*/
