/// <Node>
float _Get_Signal(char str[])
{
  float value;
  if(strncmp(str,"NULL",strlen(str)) == 0 && strlen(str) == strlen("NULL"))
  {
    testStep("","当前信号异常,未获取到对应信号");
    Signal_Flage = 1;
    return -1;
  }
  else
  {
    value = getSignal(str);
    Signal_Flage = 0;
    return value;
  }
}

/// <Node>
_Check_SignalMacth(char SigName[],int Value,long time)
{
  int SignalValue;
  testWaitForTimeout(time);
  SignalValue = _Get_Signal(SigName);
  if(SignalValue != Value)
    testStepFail("","信号值不匹配,期望值:%d,实际值:%d",Value,SignalValue);
  else
    testStepPass("","信号值与期望一致均为:%d",Value);
}

/// <Node>
_Set_CarSpd(float Spd)
{
  char _str[80];
  char DBCName[300];
  char SigBefor[20] = "EV_ ";
  char ChangeStr[2];
  char buffer_ascii[500];
  char SearchStr[100] ;
  int SearchPos;
  int SigType;
  
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",Struct_CarSpd.CarSpd_Sig);
  
  if(CarSpd_Type == -1)
  {
    snprintf(DBCName,elCount(DBCName),".\\CANDBC\\%s",DBC_Name);
    
    GlbHandlefile = OpenFileRead (DBCName,0);
    if(GlbHandlefile != 0)
    {
      snprintf(SearchStr,elCount(SearchStr),"%s%s:",SigBefor,_str);
      while(fileGetStringSZ(buffer_ascii,elcount(buffer_ascii),GlbHandlefile)!=0)  
      {
        if(strstr(buffer_ascii,SearchStr)!=-1)
        {
          SearchPos = strlen(SearchStr) + 2-1; //查询信号在DBC中获取到的位置
          snprintf(ChangeStr,elCount(ChangeStr),"%c",buffer_ascii[SearchPos]);
          SigType = atol(ChangeStr);
          break;
        }
      }
    }
    fileClose(GlbHandlefile);
    CarSpd_Type = SigType;
  }
  setSignal(Struct_CarSpd.CarSpd_Sig,Spd);                   /*信号赋值*/
  if(CarSpd_Type == 0) //整形数据
  {
    putValue(Struct_CarSpd.CarSpd_Sig,(int)Spd);                          /*非系统变量赋值*/
    putValue(_str,(int)Spd);                         /*非系统变量赋值*/
    writeEx(-3,0,"设置车速为 %d",(int)Spd);
    testStep("","设置车速为 %d",(int)Spd);
  }
  else if(CarSpd_Type == 1)
  {
    putValue(Struct_CarSpd.CarSpd_Sig,(float)Spd);                          /*非系统变量赋值*/
    putValue(_str,(float)Spd);                         /*非系统变量赋值*/
    writeEx(-3,0,"设置车速为 %.2f",(float)Spd);
    testStep("","设置车速为 %.2f",(float)Spd);
  }
  testWaitForTimeout(500);
}

