_Check_19_NoFreeze(diagRequest* Diag,char STR[])
{
  int n;
  byte Flage_Check;
  byte Dta_[6]={0x59,0x04,0x00,0x00,0x00,0x00};
  Flage_Check = 0;
  Dta_[1] = DiagGetPrimitiveByte(Diag,1);
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,100);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    for(n=0;n<6;n++)
      Dta_[n] = DiagGetPrimitiveByte(Diag,n);
    Dta_[0] = (DiagGetPrimitiveByte(Diag,0)^0x40);
    Dta_[5] = 0x00;
    for(n=0;n<6;n++)
    {
      if(diagGetRespPrimitiveByte(Diag,n)!= Dta_[n])
      {
        Flage_Check = 1;
        testStepFail(STR,"与预期不一致,期望结果为0x%2x,实测结果为0x%2x",Dta_[n],diagGetRespPrimitiveByte(Diag,n));
      }
    }
    if(Flage_Check == 0)
      testStepPass(STR,"与预期一致");
  }
}

_Check_1904(diagRequest* Diag,dword mask,char Check_Str[],float Ex_Value,dword type) //type = 0:有效值   type = 1:无效值  type = 2:仅获取值 
{
  int ii,n;
  char Comment[70];
  dword Rx_Len;
  int swhere;
  int swhere_1;
  int Possition_LocalTime[6];
  byte DID_Tmep[2];
  byte DID_Tmep_1[2];
  byte DID_Tmep_2[2];
  byte Res_Data[100];
  byte Check_Flage_Value;
  char Vaule_Str_Temp[20];
  float Vaule_Temp;
  int Possition;
  Res1904_Data_Count = 0;
  Check_Flage_Value = 0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    Rx_Len = DiagGetRespPrimitiveSize(Diag);
    for(ii=0;ii<5;ii++)
    {
      if(ii==0)
      {
        if((DiagGetPrimitiveByte(Diag,0)^0x40)!=diagGetRespPrimitiveByte(Diag,0))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,0)^0x40,diagGetRespPrimitiveByte(Diag,ii));
      }
      else
      {
        if(DiagGetPrimitiveByte(Diag,ii)!=diagGetRespPrimitiveByte(Diag,ii))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,ii),diagGetRespPrimitiveByte(Diag,ii));     
      }
    }
    {
      if(mask != 0)
      {
        if(((mask &0x01) == (diagGetRespPrimitiveByte(Diag,5)&0x01)) && ((mask &0x08) == (diagGetRespPrimitiveByte(Diag,5)&0x08)))
          testStepPass("","当前掩码状态与预期一致");
        else
          testStepFail("","当前掩码状态与预期不一致，预期为 0x%02X ,实际为0x%02X",mask,diagGetRespPrimitiveByte(Diag,5));
      }
    }
    if(DiagGetPrimitiveByte(Diag,5) != 0xFF)
    {
      if(diagGetRespPrimitiveByte(Diag,6)!= DiagGetPrimitiveByte(Diag,5))
        testStepFail("快照号","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,5),diagGetRespPrimitiveByte(Diag,6)); 
      else
        testStepPass("快照号","预期与实测结果一致为: 0x%02X",diagGetRespPrimitiveByte(Diag,6)); 
    }
    else
    {
      if(diagGetRespPrimitiveByte(Diag,6)!= Freeze_Frame_Number[0])
        testStepFail("快照号","预期结果为0x%02X,实测结果为0x%02X",Freeze_Frame_Number[0],diagGetRespPrimitiveByte(Diag,6)); 
      else
        testStepPass("快照号","预期与实测结果一致为: 0x%02X",diagGetRespPrimitiveByte(Diag,6)); 
    }
    if(diagGetRespPrimitiveByte(Diag,7)!= mixArray_Len)
      testStepFail("快照个数","预期结果为0x%02X,实测结果为0x%02X",mixArray_Len,diagGetRespPrimitiveByte(Diag,7)); 
    else
      testStepPass("快照个数","预期与实测结果一致为: 0x%02X",diagGetRespPrimitiveByte(Diag,7)); 
    for(ii=8;ii<Rx_Len-2;ii++)
    {
      int Flage_DID_Tmep_2;
      
      DID_Tmep[0] = diagGetRespPrimitiveByte(Diag,ii);
      DID_Tmep[1] = diagGetRespPrimitiveByte(Diag,ii+1);
      Possition = Array_Compare_1904(DID_Tmep);     //DID在结构体的位置
      Vaule_Temp = 0;
      if(Possition != -1)
      {
        DID_Tmep_1[0] = diagGetRespPrimitiveByte(Diag,ii-2);
        DID_Tmep_1[1] = diagGetRespPrimitiveByte(Diag,ii-1);
        if(Rx_Len<Rx_Len-4)
        {
          DID_Tmep_2[0] = diagGetRespPrimitiveByte(Diag,ii+2);
          DID_Tmep_2[1] = diagGetRespPrimitiveByte(Diag,ii+3);
          Flage_DID_Tmep_2 =  Array_Compare_1904(DID_Tmep_2);
        }
        else
          Flage_DID_Tmep_2 = 1;
        if(Array_Compare_1904(DID_Tmep_1)!=-1 && Flage_DID_Tmep_2 !=-1) //判断是数据还是DID
        { }
        else
        {
          snprintf(Comment,elCount(Comment),"%s","");
          Res1904_Data[Res1904_Data_Count].Res_DID[0] = DID_Tmep[0];
          Res1904_Data[Res1904_Data_Count].Res_DID[1] = DID_Tmep[1];
          snprintf(Comment,elCount(Comment),"%s %02X",Comment,DID_Tmep[0]);
          snprintf(Comment,elCount(Comment),"%s %02X",Comment,DID_Tmep[1]);
          Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len = mixArray[Possition].DID_1904_Len;
          Res1904_Data[Res1904_Data_Count].Factor = mixArray[Possition].Factor;
          Res1904_Data[Res1904_Data_Count].Offset = mixArray[Possition].Offset;
          Res1904_Data[Res1904_Data_Count].Tolerance = mixArray[Possition].Tolerance;
          Res1904_Data[Res1904_Data_Count].Possition = Possition;
          snprintf( Res1904_Data[Res1904_Data_Count].Str,elcount(mixArray[Possition].Str_DID_1904),"%s",mixArray[Possition].Str_DID_1904);
          snprintf( Res1904_Data[Res1904_Data_Count].Symbol,elcount(mixArray[Possition].Symbol),"%s",mixArray[Possition].Symbol);
          for(n=0;n<mixArray[Possition].DID_1904_Len;n++)
             Res1904_Data[Res1904_Data_Count].Res_DID_Data[n] = diagGetRespPrimitiveByte(Diag,ii+2+n);
          {
            if(strncmp(Res1904_Data[Res1904_Data_Count].Symbol,"signed",strlen(Res1904_Data[Res1904_Data_Count].Symbol)) == 0)
            {
              if((Res1904_Data[Res1904_Data_Count].Res_DID_Data[0]&0x80)==0x80 )   //负数
              {
                qword Da;
                qword Tem;
                Tem = 0;
                for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  Tem = Tem + (Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
                if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 4)
                  Da = 0xFFFFFFFF;
                else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 3)
                  Da = 0xFFFFFF;
                else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 2)
                  Da = 0xFFFF;
                else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 1)
                  Da = 0xFF;
                Vaule_Temp = (0xFFFFFFFF - Tem) & Da;
                Vaule_Temp = Vaule_Temp*(-1);
              }
              else
              {
                for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
              }
            }
            else
            {
              for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));    
            }
            Res1904_Data[Res1904_Data_Count].Vaule_Now = (Vaule_Temp*Res1904_Data[Res1904_Data_Count].Factor) + Res1904_Data[Res1904_Data_Count].Offset;
          }
          
          if(strncmp(Check_Str,"ALL",strlen(Check_Str))==0 && strlen(Check_Str)!=0)   //19 04整体检测
          {
            if(strncmp(mixArray[Possition].Str_DID_1904,"LocalTime",strlen(mixArray[Possition].Str_DID_1904))==0) //时间单独判断
            {
              char Cmment_T[200];
              snprintf(Cmment_T,elCount(Cmment_T),"%s","");
              for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                snprintf(Cmment_T,elCount(Cmment_T),"%s %02x",Cmment_T,Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]);
              if(strncmp(mixArray[Possition].Symbol,"BCD",strlen(mixArray[Possition].Symbol))==0)   //BCD格式,全原码拼接
              {
                /*判断是:年/月/日/时/分/秒       还是:秒/分/时/日/月/年*/
                /************************待完善*************************/
                Possition_LocalTime[0] = _Check_StrPossion("year",Possition,0);
                if(mixArray[Possition].LocalTime[Possition_LocalTime[0]][1]==0)
                {
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  {
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]);
                    if(strlen(Vaule_Str_Temp)<2)
                      snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value,elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value,Vaule_Str_Temp);
                  }
                }
                else
                {
                  for(n=Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-1;n>=0;n--)
                  {
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]);
                    if(strlen(Vaule_Str_Temp)<2)
                      snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value,elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value,Vaule_Str_Temp);
                  }
                }
              }
              else
              {
                qword Temp_Time;
                dword swhere_temp;
                Possition_LocalTime[0] = _Check_StrPossion("year",Possition,0);
                Possition_LocalTime[1] = _Check_StrPossion("month",Possition,0);
                Possition_LocalTime[2] = _Check_StrPossion("day",Possition,0);
                Possition_LocalTime[3] = _Check_StrPossion("hour",Possition,0);
                Possition_LocalTime[4] = _Check_StrPossion("minute",Possition,0);
                Possition_LocalTime[5] = _Check_StrPossion("second",Possition,0);
                Temp_Time =0;
                if(mixArray[Possition].LocalTime[Possition_LocalTime[0]][1]>0)
                {
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  {
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
                    {
                      //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
                    }
                    else
                    {
                      swhere_temp = mixArray[Possition].LocalTime[Possition_LocalTime[n]][1];    //预期所在位置
                      swhere_temp = Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len - swhere_temp - 1;  //装载后位置反向排序后取正确位置
                      Temp_Time = Res1904_Data[Res1904_Data_Count].Res_DID_Data[swhere_temp] + mixArray[Possition].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                      snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Temp_Time);
                      if(strlen(Vaule_Str_Temp)<2)
                        snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    }
                    snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value,elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value,Vaule_Str_Temp);
                  }
                }
                else
                {
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  {
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
                    {
                      //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
                    }
                    else
                    {
                      swhere_temp = mixArray[Possition].LocalTime[Possition_LocalTime[n]][1];    //预期所在位置
                      swhere_temp = Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len - 1;  //装载后位置反向排序后取正确位置
                      Temp_Time = Res1904_Data[Res1904_Data_Count].Res_DID_Data[swhere_temp] + mixArray[Possition].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                      snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Temp_Time);
                      if(strlen(Vaule_Str_Temp)<2)
                        snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    }
                    snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value,elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value,Vaule_Str_Temp);
                  }
                }
              }
              if(type == 2 ) //&& mixArray[Possition].Step_Flage == 1
              {
                _WriteEx_and_Report("","/---------------   LocalTime   ---------------/");
                testStep(Comment,"接收到的数据为 %s",Cmment_T);
                testStep(Comment,"转换后为 %s",Res1904_Data[Res1904_Data_Count].LocalTime_Value);
                writeEx(-3,0,"%s  转换后为 %s",Comment,Res1904_Data[Res1904_Data_Count].LocalTime_Value);
              }
              else if(type == 0 && mixArray[Possition].Step_Flage == 1)
              {
                _WriteEx_and_Report("","/---------------   LocalTime   ---------------/");
                if(strncmp(Res1904_Data[Res1904_Data_Count].LocalTime_Value,mixArray[Possition].LocalTime_Value,strlen(Res1904_Data[Res1904_Data_Count].LocalTime_Value))==0)
                {
                  testStepFail(Comment,"预期结果与实际设置结果不一致,预期结果为 %s ,实际结果为 %s",mixArray[Possition].LocalTime_Value,Res1904_Data[Res1904_Data_Count].LocalTime_Value);
                  testStep(Comment,"接收到的数据为 %s",Cmment_T);
                  writeEx(-3,0,"%s  预期结果与实际设置结果不一致,预期结果为 %s ,实际结果为 %s",Comment,mixArray[Possition].LocalTime_Value,Res1904_Data[Res1904_Data_Count].LocalTime_Value);
                }
                else
                {
                  testStepPass(Comment,"预期结果与实际结果一致");
                  testStep(Comment,"接收到的数据为 %s",Res1904_Data[Res1904_Data_Count].LocalTime_Value);
                  writeEx(-3,0,"%s  预期结果与实际结果一致,预期结果为 %s ",Comment,mixArray[Possition].LocalTime_Value);
                }
              }
              else
              {
                /*未做其他操作，无效检测*/
              }
            }
            else
            {
              char Cmment_T[200];
              char Cmment_S[200];
              char Cmment_D[200];
              snprintf(Cmment_S,elCount(Cmment_S),"%s","");
              snprintf(Cmment_S,elCount(Cmment_S),"/---------------   %s   ---------------/",Res1904_Data[Res1904_Data_Count].Str);
              snprintf(Cmment_D,elCount(Cmment_D),"%s","");
              snprintf(Cmment_D,elCount(Cmment_D),"%02X  %02X",Res1904_Data[Res1904_Data_Count].Res_DID[0],Res1904_Data[Res1904_Data_Count].Res_DID[1]);
              snprintf(Cmment_T,elCount(Cmment_T),"%s","");
              for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                snprintf(Cmment_T,elCount(Cmment_T),"%s %02X",Cmment_T,Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]);
              if(type == 1 && mixArray[Possition].Step_Flage == 1)
              {
                if(mixArray[Possition].Invalid_LastValue == 0)
                {
                  qword Invalid_Value;
                  Invalid_Value = 0;
                  _WriteEx_and_Report("",Cmment_S);
                  testStep(Comment,"使用无效值,无效值为0x%02X",mixArray[Possition].Invalid);
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                    Invalid_Value = Invalid_Value +  diagGetRespPrimitiveByte(Diag,ii+2+n)<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len - n - 1));
                  if(Invalid_Value != mixArray[Possition].Invalid)
                    Check_Flage_Value = 1;
                  if(Check_Flage_Value == 0)
                    testStepPass(Comment,"当值为无效时,返回数据与无效值状态相匹配");
                  else
                    testStepFail(Comment,"当值无效时,返回数据与无效值不匹配");
                }
                else                    //最后一次有效值
                {
                   testStepWarning(Comment,"使用最后一次有效值");
                  /************************待完善****（仅在1904检测全部快照时使用该部分）*********************/
                }
              }
              else if(type == 2)
              {
                _WriteEx_and_Report("",Cmment_S);
                testStep(Comment,"接收到的数据为 %s",Cmment_T);
                testStep(Comment,"转换后为 %.2f",Res1904_Data[Res1904_Data_Count].Vaule_Now);
                writeEx(-3,0,"%s  转换后为 %.2f",Comment,Res1904_Data[Res1904_Data_Count].Vaule_Now);
              }
              else if(type == 0 && mixArray[Possition].Step_Flage == 1)
              {
                _WriteEx_and_Report("",Cmment_S);
                _WriteEx_and_Report("","DID: ",Cmment_D);
                _WriteEx_and_Report("","接收到的数据为 ",Cmment_T);
                _WriteEx_and_Report("","预期结果为 %.2f",mixArray[Possition].Vaule_Ex);
                _WriteEx_and_Report("","实际结果为 %.2f",Res1904_Data[Res1904_Data_Count].Vaule_Now);
                if(Res1904_Data[Res1904_Data_Count].Vaule_Now > mixArray[Possition].Vaule_Ex + mixArray[Possition].Tolerance || Res1904_Data[Res1904_Data_Count].Vaule_Now < mixArray[Possition].Vaule_Ex - mixArray[Possition].Tolerance)
                {
//                  testStepFail(Comment,"预期结果与实际设置结果不一致,预期结果为 %.2f ,实际结果为 %.2f",mixArray[Possition].Vaule_Ex,Res1904_Data[Res1904_Data_Count].Vaule_Now);
                  testStepFail(Comment,"");
                  testStep(Comment,"接收到的数据为 %s",Cmment_T);
                }
                else
                {
                  testStepPass(Comment,"预期结果与实际结果一致");
                  testStep(Comment,"接收到的数据为 %s",Cmment_T);
                }
              }
              else if(mixArray[Possition].Step_Flage == -1)
              {
                testStep("",Cmment_S);
                _WriteEx_and_Report(mixArray[Possition].Str_DID_1904,"未进行相应操作使其变化,故不检测");
              }
              else
                _WriteEx_and_Report(Check_Str,"格式选择错误");
            }
          }
          Res1904_Data_Count++;
        } //数据DID循环
      }
    }  // for循环结束,获取到全部数据装入结构体Res1904_Data中
    
    if(strncmp(Check_Str,"ALL",strlen(Check_Str))!=0)
      swhere_1 =  _Check_StrPossion_Res(Check_Str,2);  //字符串在返回数据中的位置
    if(strncmp(Check_Str,"LocalTime",strlen(Check_Str))==0 && strlen(Check_Str)!=0)
    {
      swhere = _Check_StrPossion_Res("LocalTime",1); //字符串在预输入数据中的位置
      if(swhere == -1)
        _WriteEx_and_Report("LocalTime","当前预输入中无时间快照信息");
      else         //时间拼接计算 真实时间
      {
        if(strncmp(Res1904_Data[swhere_1].Symbol,"BCD",strlen(Res1904_Data[swhere_1].Symbol))==0)   //BCD格式,全原码拼接
        {
          /*判断是:年/月/日/时/分/秒       还是:秒/分/时/日/月/年*/
          /************************待完善*************************/
          Possition_LocalTime[0] = _Check_StrPossion("year",swhere,0);
          if(mixArray[swhere].LocalTime[Possition_LocalTime[0]][1]>0)
          {
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Res1904_Data[swhere_1].Res_DID_Data[n]);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
          else
          {
            for(n=Res1904_Data[swhere_1].Res_DID_Data_Len;n>=0;n--)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Res1904_Data[swhere_1].Res_DID_Data[n]);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
        }
        else
        {
          qword Temp_Time;
          dword swhere_temp;
          Possition_LocalTime[0] = _Check_StrPossion("year",swhere,0);
          Possition_LocalTime[1] = _Check_StrPossion("month",swhere,0);
          Possition_LocalTime[2] = _Check_StrPossion("day",swhere,0);
          Possition_LocalTime[3] = _Check_StrPossion("hour",swhere,0);
          Possition_LocalTime[4] = _Check_StrPossion("minute",swhere,0);
          Possition_LocalTime[5] = _Check_StrPossion("second",swhere,0);
          Temp_Time =0;
          if(mixArray[swhere].LocalTime[Possition_LocalTime[0]][1]>0)
          {
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              {
                //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
              }
              else
              {
                swhere_temp = mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][1];    //预期所在位置
                swhere_temp = Res1904_Data[swhere_1].Res_DID_Data_Len - swhere_temp - 1;  //装载后位置反向排序后取正确位置
                Temp_Time = Res1904_Data[swhere_1].Res_DID_Data[swhere_temp] + mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Temp_Time);
                if(strlen(Vaule_Str_Temp)<2)
                  snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              }
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
          else
          {
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            {
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
              if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
              {
                //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
              }
              else
              {
                swhere_temp = mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][1];    //预期所在位置
                swhere_temp = Res1904_Data[swhere_1].Res_DID_Data_Len - 1;  //装载后位置反向排序后取正确位置
                Temp_Time = Res1904_Data[swhere_1].Res_DID_Data[swhere_temp] + mixArray[swhere_1].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%X",Vaule_Str_Temp,Temp_Time);
                if(strlen(Vaule_Str_Temp)<2)
                  snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
              }
              snprintf(Res1904_Data[swhere_1].LocalTime_Value,elCount(Res1904_Data[swhere_1].LocalTime_Value),"%s%s",Res1904_Data[swhere_1].LocalTime_Value,Vaule_Str_Temp);
            }
          }
        }
      }
      _WriteEx_and_Report("","/---------------   LocalTime   ---------------/");
      _WriteEx_and_Report("","预期时间为 %s",mixArray[swhere].LocalTime_Value);
      _WriteEx_and_Report("","实际返回为 %s",Res1904_Data[swhere_1].LocalTime_Value);
      if(strncmp(Res1904_Data[swhere_1].LocalTime_Value,mixArray[swhere].LocalTime_Value,strlen(Res1904_Data[swhere_1].LocalTime_Value))==0 &&strncmp(mixArray[swhere].LocalTime_Value,Res1904_Data[swhere_1].LocalTime_Value,strlen(mixArray[swhere].LocalTime_Value))==0)
        testStepPass(Check_Str,"预期时间与实际返回时间一致,均为 %s",Res1904_Data[swhere_1].LocalTime_Value);
      else
        testStepFail(Check_Str,"预期时间为 %s  ,实际返回为 %s",mixArray[swhere].LocalTime_Value,Res1904_Data[swhere_1].LocalTime_Value);
    }
    else
    {
      dword Temp_Possion;
      qword Invalid_Value_;
      char Cmment_S[200];
      char Cmment_T[200];
      char Cmment_D[200];
      snprintf(Cmment_S,elCount(Cmment_S),"%s","");
      snprintf(Cmment_D,elCount(Cmment_D),"%s","");
      snprintf(Cmment_T,elCount(Cmment_T),"%s","");
      if(strncmp(Check_Str,"ALL",strlen(Check_Str))==0 && strlen(Check_Str)!=0)
        return;
      Temp_Possion = _Check_StrPossion_Res(Check_Str,1);  //字符串预期输入数据中的位置
      if(Temp_Possion == -1 || swhere_1 == -1 ) 
        _WriteEx_and_Report(Check_Str,"所输入判断数据不在预期列表中");
      else
      {
        snprintf(Cmment_D,elCount(Cmment_D),"%02X  %02X",Res1904_Data[swhere_1].Res_DID[0],Res1904_Data[swhere_1].Res_DID[1]);
        for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
          snprintf(Cmment_T,elCount(Cmment_T),"%s %02X",Cmment_T,Res1904_Data[swhere_1].Res_DID_Data[n]);
        snprintf(Cmment_S,elCount(Cmment_S),"/---------------   %s   ---------------/",mixArray[Temp_Possion].Str_DID_1904);
        _WriteEx_and_Report("",Cmment_S);
        _WriteEx_and_Report("","DID: ",Cmment_D);
        _WriteEx_and_Report("","接收到的数据为 ",Cmment_T);
        if(type == 0)   //正常有效值
        {
          _WriteEx_and_Report("","预期结果为 %.2f",Ex_Value);
          _WriteEx_and_Report("","实际结果为 %.2f",Res1904_Data[swhere_1].Vaule_Now);
          if(Ex_Value < mixArray[Temp_Possion].DID_Value_min || Ex_Value > mixArray[Temp_Possion].DID_Value_max)
            _Check_ValueInRange_IsWrite(Res1904_Data[swhere_1].Vaule_Now,Ex_Value,0,Check_Str,0,0);
          else
            _Check_ValueInRange_IsWrite(Res1904_Data[swhere_1].Vaule_Now,Ex_Value,Res1904_Data[swhere_1].Tolerance,Check_Str,0,0);
        }
        else if(type == 1)    // 无效值
        {
          if(mixArray[Temp_Possion].Invalid_LastValue == 0)
          {
            char Ex_Invalid[30];
            char Now_Invalid[30];
            _WriteEx_and_Report("","使用无效值");
            snprintf(Ex_Invalid,elCount(Ex_Invalid),"%s","");
            snprintf(Now_Invalid,elCount(Now_Invalid),"%s","");
            for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
              snprintf(Now_Invalid,elCount(Now_Invalid),"%s%02X",Now_Invalid,Res1904_Data[swhere_1].Res_DID_Data[n]);
            ltoa(mixArray[Temp_Possion].Invalid,Ex_Invalid,16);
            _Str_Upper(Ex_Invalid);
            _WriteEx_and_Report("","预期结果为 ",Ex_Invalid);
            _WriteEx_and_Report("","实际结果为 ",Now_Invalid);
            if((strncmp(Ex_Invalid,Now_Invalid,strlen(Ex_Invalid)) != 0))
              testStepFail(Check_Str,"无效值状态异常,期望无效值为 %s ,实际无效值为 %s",Ex_Invalid,Now_Invalid);
            else
              testStepPass(Check_Str,"无效值与期望一致,为 %s",Now_Invalid);
          }
          else   //最后一次有效值
          {
            /************************待完善*************************/
            _WriteEx_and_Report("","无效值为最后一次有效值");
            _WriteEx_and_Report("","预期结果为 %.2f",Ex_Value);
            _WriteEx_and_Report("","实际结果为 %.2f",Res1904_Data[swhere_1].Vaule_Now);
            _Check_ValueInRange_IsWrite(Res1904_Data[swhere_1].Vaule_Now,Ex_Value,Res1904_Data[swhere_1].Tolerance,Check_Str,0,0);
          }
        }
        else if(type == 2)    // 仅获取值并打印到报告中,不判断
        {
          char comment[200];
          snprintf(comment,elCount(comment),"%s","");
          snprintf(comment,elCount(comment),"%s  获取到的数据为",Check_Str);
          _WriteEx_and_Report("","实际结果为 %.2f",Res1904_Data[swhere_1].Vaule_Now);
          _WriteEx_and_Report("","解析后的值为 %.2f",Check_Str,Res1904_Data[swhere_1].Vaule_Now);
          for(n=0;n<Res1904_Data[swhere_1].Res_DID_Data_Len;n++)
            snprintf(comment,elCount(comment),"%s %02X",comment,Res1904_Data[swhere_1].Res_DID_Data[n]);
          testCaseComment(comment);
          writeEx(-3,0,comment);
        }
      }
    }
  }
}

_Check_1904(diagRequest* Diag ,char Check_Str[],float Ex_Value[],char Time_Str[][],dword type) //type = 0:有效值   type = 1:无效值  type = 2:仅获取值 (多组快照号(检测全部时不区分type状态))
{
  int ii,n,k;
  char Comment[70];
  dword Rx_Len;   //接收到的长度
  int swhere;     //字符串在预输入mixArray数据中的位置
  int Possition_LocalTime[6];  //年月日等时间在mixArray数据中的位置
  byte DID_Tmep[2];       //获取到的DID
  byte DID_Tmep_1[2];     //获取到的DID前两个Byte   ---用于判断是数据还是DID
  byte DID_Tmep_2[2];     //获取到的DID后两个Byte   ---用于判断是数据还是DID
  byte Res_Data[100];     //数据装载
  char Vaule_Str_Temp[20];//临时字符串装载
  float Vaule_Temp;       //临时值
  int Possition;          //DID在结构体mixArray的位置
  int Count_Len;          //每组快照长度
  int Group,Group_Start;  //当前循环到第几组快照,及当前快照组起始的位置
  char Comment_2[8][70];  //用于打印原始数据
  int Count_Loop;
  
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    Rx_Len = DiagGetRespPrimitiveSize(Diag);
    for(ii=0;ii<5;ii++)
    {
      if(ii==0)
      {
        if((DiagGetPrimitiveByte(Diag,0)^0x40)!=diagGetRespPrimitiveByte(Diag,0))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,0)^0x40,diagGetRespPrimitiveByte(Diag,ii));
      }
      else
      {
        if(DiagGetPrimitiveByte(Diag,ii)!=diagGetRespPrimitiveByte(Diag,ii))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,ii),diagGetRespPrimitiveByte(Diag,ii));     
      }
    }
    if(DiagGetPrimitiveByte(Diag,5)==0xFF)
      Count_Len = (Rx_Len - 6)/(Freeze_Frame_Number_Count-1); //每组快照长度
    else
      Count_Len = Rx_Len;
    if(Freeze_Frame_Number_Count-1 == 0)
    {
      Group_Start = 6 ;
      Count_Loop = 1;
    }
    for(n=0;n<Freeze_Frame_Number_Count-1;n++) //此处排除0xFF
    {
      if(Freeze_Frame_Number[n] == DiagGetPrimitiveByte(Diag,5))
      {
        Group_Start = 6 ;
        Count_Loop = 1;
        break;
      }
      else
      {
        Group_Start = 6 + (n*Count_Len);
        Count_Loop = Freeze_Frame_Number_Count-1;
      }
    }//前面获取到发送的快照是读取单独快照还是全体快照部分
    for(Group = 0;Group<Count_Loop;Group++)
    {
      Res1904_Data_Count = 0;
      if(DiagGetPrimitiveByte(Diag,5) == 0xFF)
      {
        Group_Start = 6 + (Group*Count_Len);
        if(diagGetRespPrimitiveByte(Diag,Group_Start)!= Freeze_Frame_Number[Group])
          testStepFail("快照号","预期结果为0x%02X,实测结果为0x%02X",Freeze_Frame_Number[Group],diagGetRespPrimitiveByte(Diag,Group_Start)); 
        if(diagGetRespPrimitiveByte(Diag,Group_Start+1)!= mixArray_Len)
          testStepFail("快照个数","预期结果为0x%02X,实测结果为0x%02X",mixArray_Len,diagGetRespPrimitiveByte(Diag,Group_Start+1)); 
      }
      else
      {
        if(diagGetRespPrimitiveByte(Diag,Group_Start)!= Freeze_Frame_Number[n])
          testStepFail("快照号","预期结果为0x%02X,实测结果为0x%02X",Freeze_Frame_Number[n],diagGetRespPrimitiveByte(Diag,Group_Start)); 
        if(diagGetRespPrimitiveByte(Diag,Group_Start+1)!= mixArray_Len)
          testStepFail("快照个数","预期结果为0x%02X,实测结果为0x%02X",mixArray_Len,diagGetRespPrimitiveByte(Diag,Group_Start+1)); 
      }
      for(ii=Group_Start+2;ii<Group_Start + Count_Len -2;ii++)
      {
        DID_Tmep[0] = diagGetRespPrimitiveByte(Diag,ii);
        DID_Tmep[1] = diagGetRespPrimitiveByte(Diag,ii+1);
        Possition = Array_Compare_1904(DID_Tmep);     //DID在结构体的位置
        Vaule_Temp = 0;
        if(Possition != -1)    //获取到的DID在结构体中
        {
          DID_Tmep_1[0] = diagGetRespPrimitiveByte(Diag,ii-2);
          DID_Tmep_1[1] = diagGetRespPrimitiveByte(Diag,ii-1);
          DID_Tmep_2[0] = diagGetRespPrimitiveByte(Diag,ii+2);
          DID_Tmep_2[1] = diagGetRespPrimitiveByte(Diag,ii+3);
          if(Array_Compare_1904(DID_Tmep_1)!=-1 && Array_Compare_1904(DID_Tmep_2)!=-1) //将数据与DID区分，此处实际获取为数据
            continue;
          else //此处为DID
          {
            snprintf(Comment,elCount(Comment),"%s","");
            Res1904_Data[Res1904_Data_Count].Res_DID[0] = DID_Tmep[0];
            Res1904_Data[Res1904_Data_Count].Res_DID[1] = DID_Tmep[1];
            snprintf(Comment,elCount(Comment),"%02X %02X",DID_Tmep[0],DID_Tmep[1]); //获取DID并准备打印
            Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len = mixArray[Possition].DID_1904_Len;
            Res1904_Data[Res1904_Data_Count].Factor = mixArray[Possition].Factor;
            Res1904_Data[Res1904_Data_Count].Offset = mixArray[Possition].Offset;
            Res1904_Data[Res1904_Data_Count].Tolerance = mixArray[Possition].Tolerance;
            Res1904_Data[Res1904_Data_Count].Possition = Possition;
            snprintf(Res1904_Data[Res1904_Data_Count].Str,elcount(Res1904_Data[Res1904_Data_Count].Str),"%s",mixArray[Possition].Str_DID_1904);
            snprintf(Res1904_Data[Res1904_Data_Count].Symbol,elcount(Res1904_Data[Res1904_Data_Count].Symbol),"%s",mixArray[Possition].Symbol);
            for(n=0;n<mixArray[Possition].DID_1904_Len;n++)
              Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n] = diagGetRespPrimitiveByte(Diag,ii+2+n);
            
            {
              if(strncmp(Res1904_Data[Res1904_Data_Count].Symbol,"signed",strlen(Res1904_Data[Res1904_Data_Count].Symbol)) == 0) //有符号
              {
                if((Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][0]&0x80)==0x80 )   //负数(最高位Bit为1)
                {
                  qword Da;
                  qword Tem;
                  Tem = 0;
                  Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][0] = (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][0]&0x7f);
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                    Tem = Tem + (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
                  if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 4)
                    Da = 0xFFFFFFFF;
                  else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 3)
                    Da = 0xFFFFFF;
                  else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 2)
                    Da = 0xFFFF;
                  else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 1)
                    Da = 0xFF;
                  Vaule_Temp = (0xFFFFFFFF - Tem) & Da;
                  Vaule_Temp = Vaule_Temp*(-1);
                }
                else
                {
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                    Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
                }
              }
              else   //无符号
              {
                for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
              }
              Res1904_Data[Res1904_Data_Count].Vaule_Now_2[Group] = (Vaule_Temp*Res1904_Data[Res1904_Data_Count].Factor) + Res1904_Data[Res1904_Data_Count].Offset; //获取非时间数据,分组装载当前返回值
              if(strncmp(Res1904_Data[Res1904_Data_Count].Str,"LocalTime",strlen(Res1904_Data[Res1904_Data_Count].Str))==0)   //获取到的数据为时间
              {
                swhere = _Check_StrPossion("LocalTime",1,0);  //获取时间在预输入mixArray数据中的位置
                snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group]),"%s","");
                if(strncmp(Res1904_Data[Res1904_Data_Count].Symbol,"BCD",strlen(Res1904_Data[Res1904_Data_Count].Symbol))==0)   //BCD格式,全原码拼接
                {
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  {
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n]);
                    if(strlen(Vaule_Str_Temp)<2)
                      snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group]),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],Vaule_Str_Temp);
                  }
                }
                else    //非BCD格式      注意排列顺序
                {
                  qword Temp_Time;
                  dword swhere_temp;
                  Possition_LocalTime[0] = _Check_StrPossion("year",Possition,0);
                  Possition_LocalTime[1] = _Check_StrPossion("month",Possition,0);
                  Possition_LocalTime[2] = _Check_StrPossion("day",Possition,0);
                  Possition_LocalTime[3] = _Check_StrPossion("hour",Possition,0);
                  Possition_LocalTime[4] = _Check_StrPossion("minute",Possition,0);
                  Possition_LocalTime[5] = _Check_StrPossion("second",Possition,0);
                  if(mixArray[Possition].LocalTime[Possition_LocalTime[0]][1]>1) // 秒/分/时/日/月/年   数组逆向
                    reverseNum(Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group],Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len);  //年-月-日-时-分-秒
                  swhere_temp = 0;
                  for(n=0;n<6;n++)
                  {
                    Temp_Time =0;
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
                    {
                      //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
                    }
                    else
                    {
                      for(k=swhere_temp;k<swhere_temp + mixArray[Possition].LocalTime[Possition_LocalTime[n]][0];k++)
                        Temp_Time = Temp_Time + (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][k]<<(8*((mixArray[Possition].LocalTime[Possition_LocalTime[n]][0])-k-1+swhere_temp)));
                      swhere_temp += mixArray[Possition].LocalTime[Possition_LocalTime[n]][0];
                      Temp_Time = Temp_Time + mixArray[Possition].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                      snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%d",Vaule_Str_Temp,Temp_Time);
                      if(strlen(Vaule_Str_Temp)<2)
                        snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    }
                    snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group]),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],Vaule_Str_Temp);                
                  }
                }
              }
            }//获取到转换后的反馈值   时间 + 其余值
            Res1904_Data_Count++;
          }//判断是DID的处理循环
        }//判断获取到的值在预输入结构体中判断循环
      }//获取到完整的一组快照循环
    }//多组快照完全获取
    if((strncmp(Check_Str,"All",strlen(Check_Str))==0) || (strncmp(Check_Str,"ALL",strlen(Check_Str))==0))    //检测"All"时暂不写无效值状态,预期结果由外部传输（涉及到上一次有效值获取）
    {
      for(ii=0;ii<mixArray_Len;ii++)
      {
        snprintf(Comment,elCount(Comment),"%s","");
        snprintf(Comment,elCount(Comment),"%s",mixArray[ii].Str_DID_1904);   //获取对应的释义
        Possition = _Check_StrPossion_Res(Comment,2);  //字符串在Res1904_Data中位置
        swhere =  _Check_StrPossion_Res(Comment,1);    //字符串在mixArray中位置
        if(Possition == -1)
          _WriteEx_and_Report(Check_Str,"未在返回数据中");
        else
        {
          char Temp_DID_S[100];
          snprintf(Temp_DID_S,elCount(Temp_DID_S),"%s","");
          snprintf(Temp_DID_S,elCount(Temp_DID_S),"0x%02X  0x%02X",Res1904_Data[Possition].Res_DID[0],Res1904_Data[Possition].Res_DID[1]);
          if(strncmp(Comment,"LocalTime",strlen(Comment))==0)
          {
            for(n=0;n<Group_Count;n++)
              snprintf(Time_Str[n],elCount(Time_Str[n]),"%s",mixArray[swhere].LocalTime_Value_2[n]);   //获取反馈数据的原始值
          }
          else
          {
            for(n=0;n<Group_Count;n++)
              Ex_Value[n] = mixArray[swhere].Vaule_Ex_2[n];
          }
          for(n=0;n<Group_Count;n++)
          {
            snprintf(Comment_2[n],elCount(Comment_2[n]),"%s","");
            for(k=0;k<Res1904_Data[Possition].Res_DID_Data_Len;k++)
              snprintf(Comment_2[n],elCount(Comment_2[n]),"%s 0x%02X",Comment_2[n],Res1904_Data[Possition].Res_DID_Data_2[n][k]);   //获取反馈数据的原始值
          }
          if(mixArray[swhere].Step_Flage !=1)   //未执行操作,仅获取数据值
          {
            char Temp_Str[100];
            snprintf(Temp_Str,elCount(Temp_Str),"%s","");
            snprintf(Temp_Str,elCount(Temp_Str),"/---------------   %s   ---------------/",Res1904_Data[Possition].Str);
            _WriteEx_and_Report("",Temp_Str);
            _WriteEx_and_Report(Comment,"未执行操作,仅获取数据值");
            if(strncmp(Comment,"LocalTime",strlen(Comment))==0)
            {
              _WriteEx_and_Report("",Temp_DID_S);
              for(n=0;n<Group;n++)
              {
                testStep("","第 %d 组快照,获取到的时间为 %s",n,Res1904_Data[Possition].LocalTime_Value_2[n]);
                writeEx(-3,0,"第 %d 组快照,获取到的时间为 %s",n,Res1904_Data[Possition].LocalTime_Value_2[n]);
              }
            }
            else
            {
              _WriteEx_and_Report("",Temp_DID_S);
              for(n=0;n<Group;n++)
              {
                testStep("","第 %d 组快照,获取到的数据为 %.2f",n,Res1904_Data[Possition].Vaule_Now_2[n]);
                writeEx(-3,0,"第 %d 组快照,获取到的数据为 %.2f",n,Res1904_Data[Possition].Vaule_Now_2[n]);
              }
            }
            for(n=0;n<Group;n++)
            {
              testStep("","第 %d 组快照,获取到的原始数据为 %s",n,Comment_2[n]);
              writeEx(-3,0,"第 %d 组快照,获取到的原始数据为 %s",n,Comment_2[n]);
            }
          }
          else
          {
            char Temp_Str[100];
            char Temp_Fault_str[100];
            snprintf(Temp_Str,elCount(Temp_Str),"%s","");
            snprintf(Temp_Str,elCount(Temp_Str),"/---------------   %s   ---------------/",Res1904_Data[Possition].Str);
            _WriteEx_and_Report("",Temp_Str);
            if(strncmp(Comment,"LocalTime",strlen(Comment))==0)
            {
              _WriteEx_and_Report("",Temp_DID_S);
              for(n=0;n<Group;n++)
              {
                _WriteEx_and_Report("","第 %d 组快照",n);
                snprintf(Temp_Fault_str,elCount(Temp_Fault_str),"%s","原始数据为: ");
                snprintf(Temp_Fault_str,elCount(Temp_Fault_str),"%s%s",Temp_Fault_str,Res1904_Data[Possition].LocalTime_Value_2[n]);
                _WriteEx_and_Report("",Temp_Fault_str);
                if(strncmp(Time_Str[n],Res1904_Data[Possition].LocalTime_Value_2[n],strlen(Res1904_Data[Possition].LocalTime_Value_2[n]))==0)
                  testStepPass(Res1904_Data[Possition].Str,"获取到的数据与预期一致为 %s",Time_Str[n]);
                else
                {
                  testStepFail(Res1904_Data[Possition].Str,"获取到的数据与预期不一致,预期为 %s  ,实际为 %s",Time_Str[n],Res1904_Data[Possition].LocalTime_Value_2[n]);
                  _WriteEx_and_Report("","/*****数据异常*****/");
                }
              }
            }
            else
            {
              int Temp_Ret;
              _WriteEx_and_Report("",Temp_DID_S);
              for(n=0;n<Group;n++)
              {
                testStep("","第 %d 组快照",n);
                snprintf(Temp_Fault_str,elCount(Temp_Fault_str),"%s","原始数据为: ");
                testStep("","第 %d 组快照,当前数据为 %.2f ,期望结果为 %.2f",n,Res1904_Data[Possition].Vaule_Now_2[n],Ex_Value[n]);
                writeEx(-3,0,"第 %d 组快照,当前数据为 %.2f ,期望结果为 %.2f",n,Res1904_Data[Possition].Vaule_Now_2[n],Ex_Value[n]);
                Temp_Ret = _Check_ValueInRange_IsWrite(Res1904_Data[Possition].Vaule_Now_2[n],Ex_Value[n],abs(Res1904_Data[Possition].Tolerance),Comment,0,0);
                if(Temp_Ret == -1)//打印错误数据
                {
                  int m;
                   _WriteEx_and_Report("","/*****数据异常*****/");
                  for(m=0;m<Res1904_Data[Possition].Res_DID_Data_Len;m++)
                    snprintf(Temp_Fault_str,elCount(Temp_Fault_str),"%s 0x%02X",Temp_Fault_str,Res1904_Data[Possition].Res_DID_Data_2[n][m]);
                  _WriteEx_and_Report("",Temp_Fault_str);
                }
              }
            }
          }
        }
      }
    }
    else
    {
      Possition = _Check_StrPossion_Res(Check_Str,2);
      swhere =  _Check_StrPossion_Res(Check_Str,1);
      if(Possition == -1)
      {
        if((strncmp(Check_Str,"All",strlen(Check_Str))!=0) && (strncmp(Check_Str,"ALL",strlen(Check_Str))!=0))
          _WriteEx_and_Report(Check_Str,"未在返回数据中");
      }
      else if(Possition != -1 && mixArray[swhere].Step_Flage==1)
      {
        for(n=0;n<Group;n++)
        {
          snprintf(Comment_2[n],elCount(Comment_2[n]),"%s","");
          for(k=0;k<Res1904_Data[Possition].Res_DID_Data_Len;k++)
            snprintf(Comment_2[n],elCount(Comment_2[n]),"%s 0x%02X",Comment_2[n],Res1904_Data[Possition].Res_DID_Data_2[n][k]);
        }
        if(type == 0) //有效值
        {
          if(strncmp(Check_Str,"LocalTime",strlen(Check_Str))==0)
          {
            for(n=0;n<Group;n++)
            {
              testStep("","第 %d 组快照",n);
              if(strncmp(Time_Str[n],Res1904_Data[Possition].LocalTime_Value_2[n],strlen(Res1904_Data[Possition].LocalTime_Value_2[n]))==0)
                testStepPass(Check_Str,"获取到的数据与预期一致为 %s",Time_Str[n]);
              else
                testStepFail(Check_Str,"获取到的数据与预期不一致,预期为 %s  ,实际为 %s",Time_Str[n],Res1904_Data[Possition].LocalTime_Value_2[n]);
            }
          }
          else
          {
            for(n=0;n<Group;n++)
            {
              testStep("","第 %d 组快照",n);
              _Check_ValueInRange_IsWrite(Res1904_Data[Possition].Vaule_Now_2[n],Ex_Value[n],Res1904_Data[Possition].Tolerance,Check_Str,0,0);
            }
          }
        }
        else if(type == 1)  //无效值
        {
          dword Temp_Invalid;
          if(mixArray[swhere].Invalid_LastValue == 0)
          {
            for(n=0;n<Group;n++)
            {
              testStep("","第 %d 组快照",n);
              Temp_Invalid =0;
              for(k=0;k<Res1904_Data[Possition].Res_DID_Data_Len;k++)
                Temp_Invalid = Temp_Invalid + Res1904_Data[Possition].Res_DID_Data_2[n][k]<<(8*(Res1904_Data[Possition].Res_DID_Data_Len-k-1));
              if(Temp_Invalid != mixArray[swhere].Invalid)
                testStepFail(Check_Str,"获取到的无效值为0x%X ,预期无效值为 0x%X",Temp_Invalid,mixArray[swhere].Invalid);
              else
                testStepPass(Check_Str,"获取到的无效值与预期无效值一致为 0x%X",mixArray[swhere].Invalid);
            }
          }
          else
          {
            /***********************上一次有效值,暂未使用,待完善****************************/
          }
        }
        else if(type == 2)  //仅获取值
        {
          if(strncmp(Check_Str,"LocalTime",strlen(Check_Str))==0)
          {
            for(n=0;n<Group;n++)
            {
              testStep("","第 %d 组快照,获取到的时间为 %s",n,Res1904_Data[Possition].LocalTime_Value_2[n]);
              writeEx(-3,0,"第 %d 组快照,获取到的时间为 %s",n,Res1904_Data[Possition].LocalTime_Value_2[n]);
            }
          }
          else
          {
            for(n=0;n<Group;n++)
            {
              testStep("","第 %d 组快照,获取到的数据为 %.2f",n,Res1904_Data[Possition].Vaule_Now_2[n]);
              writeEx(-3,0,"第 %d 组快照,获取到的数据为 %.2f",n,Res1904_Data[Possition].Vaule_Now_2[n]);
            }
          }
          for(n=0;n<Group;n++)
          {
            testStep("","第 %d 组快照,获取到的原始数据为 %s",n,Comment_2[n]);
            writeEx(-3,0,"第 %d 组快照,获取到的原始数据为 %s",n,Comment_2[n]);
          }
        }
      }
      else
      {
        _WriteEx_and_Report(Check_Str,"未进行对应操作,待完善步骤");
      }
    }
  }
}

_Get_1904_All_Data(diagRequest* Diag)  //获取1904快照写入到结构体中
{
  int ii,n,k;
  char Comment[70];
  dword Rx_Len;  //接收到的长度
  int swhere;     //字符串在预输入mixArray数据中的位置
  int Possition_LocalTime[6];  //年月日等时间在mixArray数据中的位置
  byte DID_Tmep[2];      //获取到的DID
  byte DID_Tmep_1[2];    //获取到的DID前两个Byte   ---用于判断是数据还是DID
  byte DID_Tmep_2[2];    //获取到的DID后两个Byte   ---用于判断是数据还是DID
  byte Res_Data[100];    //数据装载
  char Vaule_Str_Temp[20]; //临时字符串装载
  float Vaule_Temp;       //临时值
  int Possition;          //DID在结构体mixArray的位置
  int Count_Len;          //每组快照长度
  int Group,Group_Start;              //当前循环到第几组快照,及当前快照组起始的位置
  char Comment_2[8][70]; //用于打印原始数据
  int Count_Loop;
  
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1500);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    if(DiagGetPrimitiveByte(Diag,5) != 0xFF)//未获取全部快照
      Group_Count = 1;
    Rx_Len = DiagGetRespPrimitiveSize(Diag);
    for(ii=0;ii<5;ii++) //前5字节判断
    {
      if(ii==0)
      {
        if((DiagGetPrimitiveByte(Diag,0)^0x40)!=diagGetRespPrimitiveByte(Diag,0))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,0)^0x40,diagGetRespPrimitiveByte(Diag,ii));
      }
      else
      {
        if(DiagGetPrimitiveByte(Diag,ii)!=diagGetRespPrimitiveByte(Diag,ii))
          testStepFail("","预期结果为0x%02X,实测结果为0x%02X",DiagGetPrimitiveByte(Diag,ii),diagGetRespPrimitiveByte(Diag,ii));     
      }
    }
    if(DiagGetPrimitiveByte(Diag,5)==0xFF)
      Count_Len = (Rx_Len - 6)/(Freeze_Frame_Number_Count-1); //每组快照长度
    else
      Count_Len = Rx_Len;
    for(n=0;n<Freeze_Frame_Number_Count-1;n++)
    {
      if(DiagGetPrimitiveByte(Diag,5) == Freeze_Frame_Number[n])
      {
        Group_Start = 6 ;
        Count_Loop = 1;
        break;
      }
      else
      {
        Group_Start = 6 + (n*Count_Len);
        Count_Loop = Freeze_Frame_Number_Count-1;
      }
    }
    for(Group = 0;Group<Count_Loop;Group++)
    {
      Res1904_Data_Count = 0;
      if(DiagGetPrimitiveByte(Diag,5) == 0xFF)
      {
        Group_Start = 6 + (Group*Count_Len);
        if(diagGetRespPrimitiveByte(Diag,Group_Start)!= Freeze_Frame_Number[Group])
          testStepFail("快照号","预期结果为0x%02X,实测结果为0x%02X",Freeze_Frame_Number[Group],diagGetRespPrimitiveByte(Diag,Group_Start)); 
        if(diagGetRespPrimitiveByte(Diag,Group_Start+1)!= mixArray_Len)
          testStepFail("快照个数","预期结果为0x%02X,实测结果为0x%02X",mixArray_Len,diagGetRespPrimitiveByte(Diag,Group_Start+1)); 
      }
      else
      {
        if(diagGetRespPrimitiveByte(Diag,Group_Start)!= Freeze_Frame_Number[n])
          testStepFail("快照号","预期结果为0x%02X,实测结果为0x%02X",Freeze_Frame_Number[n],diagGetRespPrimitiveByte(Diag,Group_Start)); 
        if(diagGetRespPrimitiveByte(Diag,Group_Start+1)!= mixArray_Len)
          testStepFail("快照个数","预期结果为0x%02X,实测结果为0x%02X",mixArray_Len,diagGetRespPrimitiveByte(Diag,Group_Start+1)); 
      }
      for(ii=Group_Start+2;ii<Group_Start + Count_Len -2;ii++)
      {
        DID_Tmep[0] = diagGetRespPrimitiveByte(Diag,ii);
        DID_Tmep[1] = diagGetRespPrimitiveByte(Diag,ii+1);
        Possition = Array_Compare_1904(DID_Tmep);     //DID在结构体的位置
        Vaule_Temp = 0;
        if(Possition != -1)    //获取到的DID在结构体中
        {
          DID_Tmep_1[0] = diagGetRespPrimitiveByte(Diag,ii-2);
          DID_Tmep_1[1] = diagGetRespPrimitiveByte(Diag,ii-1);
          DID_Tmep_2[0] = diagGetRespPrimitiveByte(Diag,ii+2);
          DID_Tmep_2[1] = diagGetRespPrimitiveByte(Diag,ii+3);
          if(Array_Compare_1904(DID_Tmep_1)!=-1 && Array_Compare_1904(DID_Tmep_2)!=-1) //获取到的DID实际为数据
          {}
          else
          {
            snprintf(Comment,elCount(Comment),"%s","");
            Res1904_Data[Res1904_Data_Count].Res_DID[0] = DID_Tmep[0];
            Res1904_Data[Res1904_Data_Count].Res_DID[1] = DID_Tmep[1];
            snprintf(Comment,elCount(Comment),"%s %02X",Comment,DID_Tmep[0]);
            snprintf(Comment,elCount(Comment),"%s %02X",Comment,DID_Tmep[1]);
            Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len = mixArray[Possition].DID_1904_Len;
            Res1904_Data[Res1904_Data_Count].Factor = mixArray[Possition].Factor;
            Res1904_Data[Res1904_Data_Count].Offset = mixArray[Possition].Offset;
            Res1904_Data[Res1904_Data_Count].Tolerance = mixArray[Possition].Tolerance;
            Res1904_Data[Res1904_Data_Count].Possition = Possition;
            snprintf( Res1904_Data[Res1904_Data_Count].Str,elcount(Res1904_Data[Res1904_Data_Count].Str),"%s",mixArray[Possition].Str_DID_1904);
            snprintf( Res1904_Data[Res1904_Data_Count].Symbol,elcount(Res1904_Data[Res1904_Data_Count].Symbol),"%s",mixArray[Possition].Symbol);
            for(n=0;n<mixArray[Possition].DID_1904_Len;n++)
              Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n] = diagGetRespPrimitiveByte(Diag,ii+2+n);
            
            {
              if(strncmp(Res1904_Data[Res1904_Data_Count].Symbol,"signed",strlen(Res1904_Data[Res1904_Data_Count].Symbol)) == 0) //有符号
              {
                if((Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][0]&0x80)==0x80 )   //负数(最高位Bit为1)
                {
                  qword Da;
                  qword Tem;
                  Tem = 0;
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                    Tem = Tem + (Res1904_Data[Res1904_Data_Count].Res_DID_Data[n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
                  if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 4)
                    Da = 0xFFFFFFFF;
                  else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 3)
                    Da = 0xFFFFFF;
                  else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 2)
                    Da = 0xFFFF;
                  else if(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len == 1)
                    Da = 0xFF;
                  Vaule_Temp = (0xFFFFFFFF - Tem) & Da;
                  Vaule_Temp = Vaule_Temp*(-1);
                }
                else
                {
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                    Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
                }
              }
              else   //无符号
              {
                for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  Vaule_Temp = Vaule_Temp + (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n]<<(8*(Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len-n-1)));
              }
              Res1904_Data[Res1904_Data_Count].Vaule_Now_2[Group] = (Vaule_Temp*Res1904_Data[Res1904_Data_Count].Factor) + Res1904_Data[Res1904_Data_Count].Offset; //获取非时间数据
              if(strncmp(Res1904_Data[Res1904_Data_Count].Str,"CarSpd",strlen(Res1904_Data[Res1904_Data_Count].Str))==0 && CarSpd_mToKPH == 1 &&  Res1904_Data[Res1904_Data_Count].Vaule_Now_2[Group] != mixArray[Possition].Invalid)
                Res1904_Data[Res1904_Data_Count].Vaule_Now_2[Group] = Res1904_Data[Res1904_Data_Count].Vaule_Now_2[Group]*3.6;
              {
                int DA;
                DA = 0;
                for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                {
                  if((Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n] == 0) || (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n] == 0xFF) || (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n] == 0x7F))
                  {}
                  else
                    DA = 1;
                }
                if(DA == 0)
                {
                  Res1904_Data[Res1904_Data_Count].Vaule_Now_2[Group] = Vaule_Temp;
                }
              }
              if(strncmp(Res1904_Data[Res1904_Data_Count].Str,"LocalTime",strlen(Res1904_Data[Res1904_Data_Count].Str))==0)   //获取到的数据为时间
              {
                swhere = _Check_StrPossion("LocalTime",1,0);  //获取时间在预输入mixArray数据中的位置
                snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group]),"%s","");
                if(strncmp(Res1904_Data[Res1904_Data_Count].Symbol,"BCD",strlen(Res1904_Data[Res1904_Data_Count].Symbol))==0)   //BCD格式,全原码拼接
                {
                  for(n=0;n<Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len;n++)
                  {
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][n]);
                    if(strlen(Vaule_Str_Temp)<2)
                      snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group]),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],Vaule_Str_Temp);
                  }
                }
                else    //非BCD格式      注意排列顺序
                {
                  qword Temp_Time;
                  dword swhere_temp;
                  Possition_LocalTime[0] = _Check_StrPossion("year",Possition,0);
                  Possition_LocalTime[1] = _Check_StrPossion("month",Possition,0);
                  Possition_LocalTime[2] = _Check_StrPossion("day",Possition,0);
                  Possition_LocalTime[3] = _Check_StrPossion("hour",Possition,0);
                  Possition_LocalTime[4] = _Check_StrPossion("minute",Possition,0);
                  Possition_LocalTime[5] = _Check_StrPossion("second",Possition,0);
                  if(mixArray[Possition].LocalTime[Possition_LocalTime[0]][1]>1) // 当前 秒/分/时/日/月/年   
                    reverseNum(Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group],Res1904_Data[Res1904_Data_Count].Res_DID_Data_Len); //年-月-日-时-分-秒
                  swhere_temp = 0;
                  for(n=0;n<6;n++)
                  {
                    Temp_Time =0;
                    snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                    if(Possition_LocalTime[n] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
                    {
                      //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
                    }
                    else
                    {
                      for(k=swhere_temp;k<swhere_temp + mixArray[Possition].LocalTime[Possition_LocalTime[n]][0];k++)
                        Temp_Time = Temp_Time + (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][k]<<(8*((mixArray[Possition].LocalTime[Possition_LocalTime[n]][0])-k-1+swhere_temp)));
                      swhere_temp+=mixArray[Possition].LocalTime[Possition_LocalTime[n]][0];
                      
                      Temp_Time = Temp_Time + mixArray[Possition].LocalTime[Possition_LocalTime[n]][2]; //计算后的值
                      snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%d",Vaule_Str_Temp,Temp_Time);
                      if(strlen(Vaule_Str_Temp)<2)
                        snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
                    }
                    if((Flage_SaveData_Geely == 1 && Flage_Invalid_Geely == 1) || Flage_Invalid_GAC == 1) //Geely时间无效值
                    {
                      Temp_Time = 0;
                      snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
                      for(k=swhere_temp;k<swhere_temp + mixArray[Possition].LocalTime[Possition_LocalTime[n]][0];k++)
                        Temp_Time = Temp_Time | (Res1904_Data[Res1904_Data_Count].Res_DID_Data_2[Group][k]<<(8*((mixArray[Possition].LocalTime[Possition_LocalTime[n]][0])-k-1+swhere_temp)));
                      
                      snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%02X",Vaule_Str_Temp,Temp_Time);
                      snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group]),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],Vaule_Str_Temp);  
                    }
                    else
                      snprintf(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],elCount(Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group]),"%s%s",Res1904_Data[Res1904_Data_Count].LocalTime_Value_2[Group],Vaule_Str_Temp);    
                  }
                }
              }
            }//获取到转换后的反馈值   时间 + 其余值
            Res1904_Data_Count++;
          }//判断是DID的处理循环
        }//判断获取到的值在预输入结构体中判断循环
      }//获取到完整的一组快照循环
    }//多组快照完全获取
  }
}

/*
    内部对多组快照有处理，若仅含一组情况下，直接对比该组快照数据
*/
_Check_1904_Specified(char Check_Str[],float Ex_Value[],dword type) //type = 0:有效值   type = 1:无效值  type = 2:仅获取值 (指定快照数据对比)
{
  int ii,n;
  char Comment[70];
  int swhere;             //字符串在Res1904_Data数据中的位置
  int Possition;          //DID在结构体mixArray的位置
  char Comment_2[8][70];  //用于打印原始数据
  dword Temp_Value;
  
  swhere = _Check_StrPossion_Res(Check_Str,2);
  Possition = _Check_StrPossion_Res(Check_Str,1);
  
  if(swhere != -1 && Possition != -1)
  {
    char Temp_Str[100];
    char Temp_Str_[100];
    snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    snprintf(Temp_Str_,elCount(Temp_Str_),"%s","");
    snprintf(Temp_Str,elCount(Temp_Str),"/---------------   %s   ---------------/",Check_Str);
    _WriteEx_and_Report("",Temp_Str);
    snprintf(Temp_Str_,elCount(Temp_Str_),"0x%02X  0x%02X",mixArray[Possition].DID_1904[0],mixArray[Possition].DID_1904[1]);
    _WriteEx_and_Report("",Temp_Str_);
    for(ii=0;ii<Group_Count;ii++)
    {
      snprintf(Comment_2[ii],elCount(Comment_2[ii]),"%s","");
      for(n=0;n<Res1904_Data[swhere].Res_DID_Data_Len;n++)//此处装载原始数据
        snprintf(Comment_2[ii],elCount(Comment_2[ii]),"%s 0x%02X",Comment_2[ii],Res1904_Data[swhere].Res_DID_Data_2[ii][n]);
    }
    if(type==0)
    {
      for(ii=0;ii<Group_Count;ii++)
      {
        _WriteEx_and_Report("","第 %d 组快照",ii);
        _Check_ValueInRange_IsWrite(Res1904_Data[swhere].Vaule_Now_2[ii],Ex_Value[ii],Res1904_Data[swhere].Tolerance,Check_Str,0,1);
      }
    }
    else if(type==1)
    {
      for(ii=0;ii<Group_Count;ii++)
      {
        _WriteEx_and_Report("","第 %d 组快照",ii);
        Temp_Value = 0;
        if(mixArray[Possition].Invalid_LastValue == 0)
        {
          for(n=0;n<Res1904_Data[swhere].Res_DID_Data_Len;n++)
            Temp_Value = Temp_Value | Res1904_Data[swhere].Res_DID_Data_2[ii][n]<<(8*(Res1904_Data[swhere].Res_DID_Data_Len-n-1));
          if(Temp_Value != mixArray[Possition].Invalid)
          {
            testStepFail(Check_Str,"获取到的值与预期输入不一致,获取到的值为 0x%X ,预期值为 0x%X",Temp_Value,mixArray[Possition].Invalid);
            writeEx(-3,0,"获取到的值与预期输入不一致,获取到的值为 0x%X ,预期值为 0x%X",Temp_Value,mixArray[Possition].Invalid);
          }
          else
          {
            testStepPass(Check_Str,"获取到的值与预期输入一致");
            writeEx(-3,0,"获取到的值与预期输入一致");
          }
        }
        else  //最后一次有效值由外部输入
          _Check_ValueInRange_IsWrite(Res1904_Data[swhere].Vaule_Now_2[ii],Ex_Value[ii],Res1904_Data[swhere].Tolerance,Check_Str,0,0);
      }
    }
    else if(type==2)
    {
      for(ii=0;ii<Group_Count;ii++)
      {
        _WriteEx_and_Report("","第 %d 组快照",ii);
        _WriteEx_and_Report(Check_Str,Comment_2[ii]);
      }
    }
  }
  else
    testStepFail(Check_Str,"未查询到对应的字符串数据");
}
_Check_1904_Specified(char Check_Str[],char Ex_Str[][],dword type) //type = 0:有效值   type = 1:无效值  type = 2:仅获取值 (指定快照数据对比)
{
  int ii,n;
  char Comment[70];
  int swhere;             //字符串在Res1904_Data数据中的位置
  int Possition;          //DID在结构体mixArray的位置
  char Comment_2[8][70];  //用于打印原始数据
  qword Temp_Value;
  
  swhere = _Check_StrPossion_Res(Check_Str,2);
  Possition = _Check_StrPossion_Res(Check_Str,1);
  if(swhere != -1 && Possition != -1)
  {
    char Temp_Str[100];
    char Temp_Str_[100];
    snprintf(Temp_Str,elCount(Temp_Str),"%s","");
    snprintf(Temp_Str_,elCount(Temp_Str_),"%s","");
    snprintf(Temp_Str,elCount(Temp_Str),"/---------------   %s   ---------------/",Check_Str);
    _WriteEx_and_Report("",Temp_Str);
    snprintf(Temp_Str_,elCount(Temp_Str_),"0x%02X  0x%02X",mixArray[Possition].DID_1904[0],mixArray[Possition].DID_1904[1]);
    _WriteEx_and_Report("",Temp_Str_);
    for(ii=0;ii<Group_Count;ii++)
    {
      snprintf(Comment_2[ii],elCount(Comment_2[ii]),"%s","");
      for(n=0;n<Res1904_Data[swhere].Res_DID_Data_Len;n++)
        snprintf(Comment_2[ii],elCount(Comment_2[ii]),"%s 0x%02X",Comment_2[ii],Res1904_Data[swhere].Res_DID_Data_2[ii][n]);
    }
    if(type==0)
    {
      for(ii=0;ii<Group_Count;ii++)
      {
        _WriteEx_and_Report("","第 %d 组快照",ii);
        if(strncmp(Ex_Str[ii],Res1904_Data[swhere].LocalTime_Value_2[ii],strlen(Res1904_Data[swhere].LocalTime_Value_2[ii]))==0)
        {
          testStepPass(Check_Str,"实际值与预期一致为: %s",Ex_Str[ii]);
          writeEx(-3,0,"实际值与预期一致为：%s",Ex_Str[ii]);
        }
        else
        {
          testStepFail(Check_Str,"实际值为 %s ,预期值为 %s",Res1904_Data[swhere].LocalTime_Value_2[ii],Ex_Str[ii]);
          writeEx(-3,0,"实际值为 %s ,预期值为 %s",Res1904_Data[swhere].LocalTime_Value_2[ii],Ex_Str[ii]);
        }
      }
    }
    else if(type==1)
    {
      for(ii=0;ii<Group_Count;ii++)
      {
        _WriteEx_and_Report("","第 %d 组快照",ii);
        Temp_Value = 0;
        if(mixArray[Possition].Invalid_LastValue == 0)
        {
          for(n=0;n<Res1904_Data[swhere].Res_DID_Data_Len;n++)
            Temp_Value = Temp_Value | Res1904_Data[swhere].Res_DID_Data_2[ii][n]<<(8*(Res1904_Data[swhere].Res_DID_Data_Len-n-1));
          if(Temp_Value != mixArray[Possition].Invalid)
          {
            testStepFail(Check_Str,"获取到的值与预期输入不一致,获取到的值为 0x%X ,预期值为 0x%X",Temp_Value,mixArray[Possition].Invalid);
            writeEx(-3,0,"获取到的值与预期输入不一致,获取到的值为 0x%X ,预期值为 0x%X",Temp_Value,mixArray[Possition].Invalid);
          }
          else
          {
            testStepPass(Check_Str,"获取到的值与预期输入一致");
            writeEx(-3,0,"获取到的值与预期输入一致");
          }
        }
        else  //最后一次有效值由外部输入
        {
          if(TimeInvalid_FirstTime == 1)
          {
            for(n=0;n<Res1904_Data[swhere].Res_DID_Data_Len;n++)
              Temp_Value = Temp_Value | Res1904_Data[swhere].Res_DID_Data_2[ii][n]<<(8*(Res1904_Data[swhere].Res_DID_Data_Len-n-1));
            snprintf(Res1904_Data[swhere].LocalTime_Value_2[ii],elCount(Res1904_Data[swhere].LocalTime_Value_2[ii]),"%X",Temp_Value);
          }
          
          {
            if(strncmp(Ex_Str[ii],Res1904_Data[swhere].LocalTime_Value_2[ii],strlen(Res1904_Data[swhere].LocalTime_Value_2[ii]))==0)
            {
              testStepPass(Check_Str,"实际值与预期一致");
              writeEx(-3,0,"实际值与预期一致");
            }
            else
            {
              testStepFail(Check_Str,"预期值为 %s ,实际值为 %s",Ex_Str[ii],Res1904_Data[swhere].LocalTime_Value_2[ii]);
              writeEx(-3,0,"预期值为 %s ,实际值为 %s",Ex_Str[ii],Res1904_Data[swhere].LocalTime_Value_2[ii]);
            }
          }
        }
      }
    }
    else if(type==2)
    {
      for(ii=0;ii<Group_Count;ii++)
      {
        _WriteEx_and_Report("","第 %d 组快照",ii);
        _WriteEx_and_Report(Check_Str,Comment_2[ii]);
      }
    }
  }
  else
    testStepFail(Check_Str,"未查询到对应的字符串数据");
}
_Check_1906(diagRequest* Diag,char Check_Str[],dword ExValue)
{
  int m,Possion_DTCCount,Str_Possion;
  dword ExLen,DTC_Count_Byte,Start_Byte;
  char _Ex_Data_Record_Str[200];
  char _Check_Str[200];
  ExLen =0;
  Possion_DTCCount = -1;
  DTC_Count_Byte = 0;
  Start_Byte = 0;
  Str_Possion = -1;
  snprintf(_Check_Str,elcount(_Check_Str),"");
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    for(m=0;m<ExDataRecord_Count;m++)
    {
      ExLen = ExLen + ExDataRecord[m].Ex_Data_Record_Len;
      if(ExDataRecord[m].Ex_Data_Record_Num_Flage == 1)
        ExLen = ExLen+1;
      toUpper(_Check_Str,"Fault_Occurrence_counter",elCount(_Check_Str));
      toUpper(_Ex_Data_Record_Str,ExDataRecord[m].Ex_Data_Record_Str,elCount(_Ex_Data_Record_Str));
      if(strncmp(_Ex_Data_Record_Str,_Check_Str,strlen(ExDataRecord[m].Ex_Data_Record_Str))==0)
        Possion_DTCCount = m;
    }
    if(ExDataRecord[1].Ex_Data_Record_Num_Flage == 0)
      ExLen = ExLen+1;  //无单独拓展号时+1
    ExLen = ExLen + 6;
    if(DiagGetRespPrimitiveSize(Diag) != ExLen)
      testStepFail("","返回长度与预期长度不一致,实际长度为%d ,期望为%d",DiagGetRespPrimitiveSize(Diag),ExLen);
    else
    {
      testStepPass("","返回长度与预期长度一致");
      for(m=0;m<5;m++)
      {
        if(m==0)
        {
          if((DiagGetPrimitiveByte(Diag,m)^0x40) != DiagGetRespPrimitiveByte(Diag,m))
            testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",(DiagGetPrimitiveByte(Diag,m)^0x40),DiagGetRespPrimitiveByte(Diag,m));
        }
        else
        {
          if(DiagGetPrimitiveByte(Diag,m) != DiagGetRespPrimitiveByte(Diag,m))
            testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",DiagGetPrimitiveByte(Diag,m),DiagGetRespPrimitiveByte(Diag,m)); 
        }
      }
      
      Str_Possion = _Check_StrPossion_Res(Check_Str,3); //获取字符串所在位置
      _Str_Upper(Check_Str);
      if(strncmp(Check_Str,"ALL",strlen(Check_Str))==0)
      {
        if(Possion_DTCCount!= -1) //19 06当检测为ALL时，仅验证故障成熟测试
        {
          if(ExDataRecord[Possion_DTCCount].Ex_Data_Record_Num_Flage==1)
          {
            for(m=0;m<Possion_DTCCount-1;m++)
              DTC_Count_Byte = DTC_Count_Byte + ExDataRecord[m].Ex_Data_Record_Len +1;
            if(Possion_DTCCount == 0)
              DTC_Count_Byte = DTC_Count_Byte+1;
            DTC_Count_Byte = DTC_Count_Byte + 6;  //此时为数据位置
          }
          else
          {
            for(m=0;m<Possion_DTCCount-1;m++)
              DTC_Count_Byte = DTC_Count_Byte + ExDataRecord[m].Ex_Data_Record_Len;
            if(Possion_DTCCount == 0)
              DTC_Count_Byte = DTC_Count_Byte+1;
            DTC_Count_Byte = DTC_Count_Byte + 6;
          }
        }
        if(0x01 != DiagGetRespPrimitiveByte(Diag,6))
          testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",0x01,DiagGetRespPrimitiveByte(Diag,6)); 
        if(0x01 != DiagGetRespPrimitiveByte(Diag,DTC_Count_Byte))
          testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",0x01,DiagGetRespPrimitiveByte(Diag,DTC_Count_Byte)); 
        else
          testStepPass("","故障成熟次数为1次");
      }
      else
      {
        dword Data_Rx;
        Data_Rx = 0;
        Start_Byte = 6-1; //初始位置
        for(m=0;m<Str_Possion;m++)
        {
          Start_Byte = Start_Byte + ExDataRecord[m].Ex_Data_Record_Len;
          if(ExDataRecord[m].Ex_Data_Record_Num_Flage==1)
            Start_Byte = Start_Byte +1;
        }
        // if(Str_Possion==0)
          Start_Byte = Start_Byte +1;  //拓展号所在位置
        if(ExDataRecord[Str_Possion].Ex_Data_Record_Num_Flage==1)
        {
          if(Str_Possion != 0)
            Start_Byte = Start_Byte +1;//加上扩展数据记录号1位
          if(ExDataRecord[Str_Possion].Ex_Data_Record_Num!=DiagGetRespPrimitiveByte(Diag,Start_Byte))
            testStepFail(Check_Str,"拓展数据记录号与期望不一致,预期为%d，实际为%d",ExDataRecord[Str_Possion].Ex_Data_Record_Num,DiagGetRespPrimitiveByte(Diag,Start_Byte));
          else
            testStepPass(Check_Str,"拓展数据记录号与期望一致");
        }
        Start_Byte = Start_Byte +1;  //数据所在位置
        for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          Data_Rx = Data_Rx + (DiagGetRespPrimitiveByte(Diag,Start_Byte+m)<<(8*(ExDataRecord[Str_Possion].Ex_Data_Record_Len-m-1)));
        if(Data_Rx!= ExValue)
          testStepFail(Check_Str,"反馈值与预期不一致,期望结果为0x%02x,实测结果为0x%02x",ExValue,Data_Rx);
        else
          testStepPass(Check_Str,"反馈值与预期一致,");
      }
    }
  }
}

dword _Get_1906_(diagRequest* Diag,char Check_Str[])
{
  int m,Possion_DTCCount,Str_Possion;
  dword ExLen,DTC_Count_Byte,Start_Byte;
  char _Ex_Data_Record_Str[200];
  char _Check_Str[200];
  dword Value;
  ExLen =0;
  Possion_DTCCount = -1;
  DTC_Count_Byte = 0;
  Start_Byte = 0;
  Str_Possion = -1;
  Value = 0;
  snprintf(_Check_Str,elcount(_Check_Str),"");
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {
    for(m=0;m<ExDataRecord_Count;m++)
    {
      ExLen = ExLen + ExDataRecord[m].Ex_Data_Record_Len;
      if(ExDataRecord[m].Ex_Data_Record_Num_Flage == 1)
        ExLen = ExLen+1;
      toUpper(_Check_Str,"Fault_Occurrence_counter",elCount(_Check_Str));
      toUpper(_Ex_Data_Record_Str,ExDataRecord[m].Ex_Data_Record_Str,elCount(_Ex_Data_Record_Str));
      if(strncmp(_Ex_Data_Record_Str,_Check_Str,strlen(ExDataRecord[m].Ex_Data_Record_Str))==0)
        Possion_DTCCount = m;
    }
    if(ExDataRecord[1].Ex_Data_Record_Num_Flage == 0)
      ExLen = ExLen+1;  //无单独拓展号时+1
    ExLen = ExLen + 6;
    if(DiagGetRespPrimitiveSize(Diag) != ExLen)
      testStepFail("","返回长度与预期长度不一致,实际长度为%d ,期望为%d",DiagGetRespPrimitiveSize(Diag),ExLen);
    else
    {
      testStepPass("","返回长度与预期长度一致");
      Str_Possion = _Check_StrPossion_Res(Check_Str,3); //获取字符串所在位置
      _Str_Upper(Check_Str);
      {
        dword Data_Rx;
        Data_Rx = 0;
        Start_Byte = 6-1; //初始位置
        for(m=0;m<Str_Possion;m++)
        {
          Start_Byte = Start_Byte + ExDataRecord[m].Ex_Data_Record_Len;
          if(ExDataRecord[m].Ex_Data_Record_Num_Flage==1)
            Start_Byte = Start_Byte +1;
        }
        if(Str_Possion==0)
          Start_Byte = Start_Byte +1;  //拓展号所在位置
        if(ExDataRecord[Str_Possion].Ex_Data_Record_Num_Flage==1)
        {
          if(Str_Possion != 0)
            Start_Byte = Start_Byte +1;//加上扩展数据记录号1位
        }
        Start_Byte = Start_Byte +1;  //数据所在位置
        for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          Data_Rx = Data_Rx + (DiagGetRespPrimitiveByte(Diag,Start_Byte+m)<<(8*(ExDataRecord[Str_Possion].Ex_Data_Record_Len-m-1)));
        Value = Data_Rx;
      }
    }
  }
  return Value;
}
_Check_1906_Time(diagRequest* Diag,char ExValue_First[],char ExValue_Last[])
{
  int m,Str_Possion,LocalTime_Possion;
  dword ExLen,Start_Byte;
  byte Data_Rx_First[10];
  byte Data_Rx_Last[10];
  char Vaule_Str_Temp[50];
  char Value_First[50];
  char Value_Last[50];
  int Possition_LocalTime[6];
  ExLen =0;
  Start_Byte = 0;
  Str_Possion = -1;
  for(m=0;m<10;m++)
  {
    Data_Rx_First[m] = 0;
    Data_Rx_Last[m] = 0;
  }
  snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
  snprintf(Value_First,elCount(Value_First),"%s","");
  snprintf(Value_Last,elCount(Value_Last),"%s","");
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {    
    for(m=0;m<ExDataRecord_Count;m++)
    {
      ExLen = ExLen + ExDataRecord[m].Ex_Data_Record_Len;
      if(ExDataRecord[m].Ex_Data_Record_Num_Flage == 1)
        ExLen = ExLen+1;
    }
    if(ExDataRecord[1].Ex_Data_Record_Num_Flage == 0)
      ExLen = ExLen+1;  //无单独拓展号时+1
    ExLen = ExLen + 6;
    if(DiagGetRespPrimitiveSize(Diag) != ExLen)
      testStepFail("","返回长度与预期长度不一致,实际长度为%d ,期望为%d",DiagGetRespPrimitiveSize(Diag),ExLen);
    else
    {
      testStepPass("","返回长度与预期长度一致");
      for(m=0;m<6;m++)
      {
        if(m==0)
        {
          if((DiagGetPrimitiveByte(Diag,m)^0x40) != DiagGetRespPrimitiveByte(Diag,m))
            testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",(DiagGetPrimitiveByte(Diag,m)^0x40),DiagGetRespPrimitiveByte(Diag,m));
        }
        else if(m==5)
          continue;
        else
        {
          if(DiagGetPrimitiveByte(Diag,m) != DiagGetRespPrimitiveByte(Diag,m))
            testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",DiagGetPrimitiveByte(Diag,m),DiagGetRespPrimitiveByte(Diag,m)); 
        }
      }
      Str_Possion = _Check_StrPossion_Res("First_Time_Fault_Occurrence_Time",3); //获取字符串所在位置
      LocalTime_Possion = _Check_StrPossion_Res("LocalTime",1); //获取字符串所在位置
      {
        Start_Byte = 6-1; //初始位置
        for(m=0;m<Str_Possion;m++)
        {
          Start_Byte = Start_Byte + ExDataRecord[m].Ex_Data_Record_Len;
          if(ExDataRecord[m].Ex_Data_Record_Num_Flage==1)
            Start_Byte = Start_Byte +1;
        }
        if(Str_Possion==0)
          Start_Byte = Start_Byte +1;  //拓展号所在位置
        if(ExDataRecord[Str_Possion].Ex_Data_Record_Num_Flage==1)
        {
          if(Str_Possion != 0)
            Start_Byte = Start_Byte +1;//加上扩展数据记录号1位
          if(ExDataRecord[Str_Possion].Ex_Data_Record_Num!=DiagGetRespPrimitiveByte(Diag,Start_Byte))
            testStepFail("First_Time_Fault_Occurrence_Time","拓展数据记录号与期望不一致,预期为%d，实际为%d",ExDataRecord[Str_Possion].Ex_Data_Record_Num,DiagGetRespPrimitiveByte(Diag,Start_Byte));
          else
            testStepPass("First_Time_Fault_Occurrence_Time","拓展数据记录号与期望一致");
        }
        Start_Byte = Start_Byte +1;  //数据所在位置
        for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          Data_Rx_First[m] = DiagGetRespPrimitiveByte(Diag,Start_Byte+m);
        snprintf(Value_First,elCount(Value_First),"%s","");
        if(strncmp(mixArray[LocalTime_Possion].Symbol,"BCD",strlen(mixArray[LocalTime_Possion].Symbol))==0)   //BCD格式,全原码拼接
        {
          /*判断是:年/月/日/时/分/秒       还是:秒/分/时/日/月/年*/
          /************************待完善*************************/
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          if(mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[0]][1]>0)
            reverseNum(Data_Rx_First,ExDataRecord[Str_Possion].Ex_Data_Record_Len);   // 秒/分/时/日/月/年 逆向
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Data_Rx_First[m]);
            if(strlen(Vaule_Str_Temp)<2)
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            snprintf(Value_First,elCount(Value_First),"%s%s",Value_First,Vaule_Str_Temp);
          }  //拼接排序
        }
        else
        {
          qword Temp_Time;
          dword swhere_temp;
          Temp_Time = 0;
          swhere_temp = 0;
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          Possition_LocalTime[1] = _Check_StrPossion("month",LocalTime_Possion,0);
          Possition_LocalTime[2] = _Check_StrPossion("day",LocalTime_Possion,0);
          Possition_LocalTime[3] = _Check_StrPossion("hour",LocalTime_Possion,0);
          Possition_LocalTime[4] = _Check_StrPossion("minute",LocalTime_Possion,0);
          Possition_LocalTime[5] = _Check_StrPossion("second",LocalTime_Possion,0);
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            if(Possition_LocalTime[m] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
            {
              //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
            }
            else
            {
              swhere_temp = mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][1];    //预期所在位置
              Temp_Time = Data_Rx_First[swhere_temp] + mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][2]; //计算后的值
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%d",Vaule_Str_Temp,Temp_Time);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            }
            snprintf(Value_First,elCount(Value_First),"%s%s",Value_First,Vaule_Str_Temp);
          }
        }
      }
      {
        Str_Possion = _Check_StrPossion_Res("Latest_Time_Fault_Occurrence_Time",3); //获取字符串所在位置
        Start_Byte = 6-1; //初始位置
        for(m=0;m<Str_Possion;m++)
        {
          Start_Byte = Start_Byte + ExDataRecord[m].Ex_Data_Record_Len;
          if(ExDataRecord[m].Ex_Data_Record_Num_Flage==1)
            Start_Byte = Start_Byte +1;
        }
        if(Str_Possion==0)
          Start_Byte = Start_Byte +1;  //拓展号所在位置
        if(ExDataRecord[Str_Possion].Ex_Data_Record_Num_Flage==1)
        {
          if(Str_Possion != 0)
            Start_Byte = Start_Byte +1;//加上扩展数据记录号1位
          if(ExDataRecord[Str_Possion].Ex_Data_Record_Num!=DiagGetRespPrimitiveByte(Diag,Start_Byte))
            testStepFail("Latest_Time_Fault_Occurrence_Time","拓展数据记录号与期望不一致,预期为%d，实际为%d",ExDataRecord[Str_Possion].Ex_Data_Record_Num,DiagGetRespPrimitiveByte(Diag,Start_Byte));
          else
            testStepPass("Latest_Time_Fault_Occurrence_Time","拓展数据记录号与期望一致");
        }
        Start_Byte = Start_Byte +1;  //数据所在位置
        for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          Data_Rx_Last[m] = DiagGetRespPrimitiveByte(Diag,Start_Byte+m);
        snprintf(Value_Last,elCount(Value_Last),"%s","");
        if(strncmp(mixArray[LocalTime_Possion].Symbol,"BCD",strlen(mixArray[LocalTime_Possion].Symbol))==0)   //BCD格式,全原码拼接
        {
          /*判断是:年/月/日/时/分/秒       还是:秒/分/时/日/月/年*/
          /************************待完善*************************/
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          if(mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[0]][1]>0)
            reverseNum(Data_Rx_First,ExDataRecord[Str_Possion].Ex_Data_Record_Len);   // 秒/分/时/日/月/年 逆向
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Data_Rx_Last[m]);
            if(strlen(Vaule_Str_Temp)<2)
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            snprintf(Value_Last,elCount(Value_Last),"%s%s",Value_Last,Vaule_Str_Temp);
          }  //拼接排序
        }
        else
        {               
          qword Temp_Time;
          dword swhere_temp;
          Temp_Time = 0;
          swhere_temp = 0;
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          Possition_LocalTime[1] = _Check_StrPossion("month",LocalTime_Possion,0);
          Possition_LocalTime[2] = _Check_StrPossion("day",LocalTime_Possion,0);
          Possition_LocalTime[3] = _Check_StrPossion("hour",LocalTime_Possion,0);
          Possition_LocalTime[4] = _Check_StrPossion("minute",LocalTime_Possion,0);
          Possition_LocalTime[5] = _Check_StrPossion("second",LocalTime_Possion,0);
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            if(Possition_LocalTime[m] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
            {
              //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
            }
            else
            {
              swhere_temp = mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][1];    //预期所在位置
              Temp_Time = Data_Rx_Last[swhere_temp] + mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][2]; //计算后的值
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%d",Vaule_Str_Temp,Temp_Time);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            }
            snprintf(Value_Last,elCount(Value_Last),"%s%s",Value_Last,Vaule_Str_Temp);
          }
        }
      }
      if(strncmp(Value_First,ExValue_First,strlen(Value_First))==0)
        testStepPass("First_Time_Fault_Occurrence_Time","第一次发生故障时间与期望一致,为 %s",Value_First);
      else
        testStepFail("First_Time_Fault_Occurrence_Time","第一次发生故障时间与期望不一致,期望为: %s  ,实际为: %s",ExValue_First,Value_First);
      if(strncmp(Value_Last,ExValue_Last,strlen(Value_Last))==0)
        testStepPass("Latest_Time_Fault_Occurrence_Time","最近一次发生故障时间与期望一致,为 %s",Value_Last);
      else
        testStepFail("Latest_Time_Fault_Occurrence_Time","最近一次发生故障时间与期望不一致,期望为: %s  ,实际为: %s",ExValue_Last,Value_Last);
    }
  }
}

_Check_1906_Time_Geely(diagRequest* Diag,char ExValue_First[],char ExValue_Last[])
{
  int m,Str_Possion,LocalTime_Possion;
  dword ExLen,Start_Byte;
  byte Data_Rx_First[10];
  byte Data_Rx_Last[10];
  char Vaule_Str_Temp[50];
  char Value_First[50];
  char Value_Last[50];
  int Possition_LocalTime[6];
  byte Data_Rs[8] = {1,2,3,4,6,0x10,0x11,0x12};
  int Count;
  ExLen =0;
  Start_Byte = 0;
  Str_Possion = -1;
  for(m=0;m<10;m++)
  {
    Data_Rx_First[m] = 0;
    Data_Rx_Last[m] = 0;
  }
  snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
  snprintf(Value_First,elCount(Value_First),"%s","");
  snprintf(Value_Last,elCount(Value_Last),"%s","");
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  if(diagGetLastResponseCode(Diag) == 0)
    testStepFail("未收到响应");
  else if(diagGetLastResponseCode(Diag) > 0)
    testStepFail("收到消极应答");
  else
  {    
    for(m=0;m<ExDataRecord_Count;m++)
    {
      ExLen = ExLen + ExDataRecord[m].Ex_Data_Record_Len;
      if(ExDataRecord[m].Ex_Data_Record_Num_Flage == 1)
        ExLen = ExLen+1;
    }
    if(ExDataRecord[1].Ex_Data_Record_Num_Flage == 0)
      ExLen = ExLen+1;  //无单独拓展号时+1
    ExLen = 0x26;
    if(DiagGetRespPrimitiveSize(Diag) != ExLen)
      testStepFail("","返回长度与预期长度不一致,实际长度为%d ,期望为%d",DiagGetRespPrimitiveSize(Diag),ExLen);
    else
    {
      testStepPass("","返回长度与预期长度一致");
      for(m=0;m<6;m++)
      {
        if(m==0)
        {
          if((DiagGetPrimitiveByte(Diag,m)^0x40) != DiagGetRespPrimitiveByte(Diag,m))
            testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",(DiagGetPrimitiveByte(Diag,m)^0x40),DiagGetRespPrimitiveByte(Diag,m));
        }
        else if(m==5)
          continue;
        else
        {
          if(DiagGetPrimitiveByte(Diag,m) != DiagGetRespPrimitiveByte(Diag,m))
            testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",DiagGetPrimitiveByte(Diag,m),DiagGetRespPrimitiveByte(Diag,m)); 
        }
      }
      Count = 0;
      for(m=6;m<22;m=m+2)
      {
        if(DiagGetRespPrimitiveByte(Diag,m) != Data_Rs[m-6-Count])
          testStepFail("","反馈与预期不一致,预期为 0x%2x ,实测为 0x%2x",Data_Rs[m-6],DiagGetRespPrimitiveByte(Diag,m)); 
        Count++;
      }
      Str_Possion = _Check_StrPossion_Res("First_Time_Fault_Occurrence_Time",3); //获取字符串所在位置
      LocalTime_Possion = _Check_StrPossion_Res("LocalTime",1); //获取字符串所在位置
      {
        if(DiagGetRespPrimitiveByte(Diag,22) != 0x22)
          testStepFail("First_Time_Fault_Occurrence_Time","拓展数据记录号与期望不一致,预期为%d，实际为%d",0x22,DiagGetRespPrimitiveByte(Diag,22));
        Start_Byte = 22 +1;  //数据所在位置
        for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          Data_Rx_First[m] = DiagGetRespPrimitiveByte(Diag,Start_Byte+m);
        snprintf(Value_First,elCount(Value_First),"%s","");
        if(strncmp(mixArray[LocalTime_Possion].Symbol,"BCD",strlen(mixArray[LocalTime_Possion].Symbol))==0)   //BCD格式,全原码拼接
        {
          /*判断是:年/月/日/时/分/秒       还是:秒/分/时/日/月/年*/
          /************************待完善*************************/
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          if(mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[0]][1]>0)
            reverseNum(Data_Rx_First,ExDataRecord[Str_Possion].Ex_Data_Record_Len);   // 秒/分/时/日/月/年 逆向
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Data_Rx_First[m]);
            if(strlen(Vaule_Str_Temp)<2)
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            snprintf(Value_First,elCount(Value_First),"%s%s",Value_First,Vaule_Str_Temp);
          }  //拼接排序
        }
        else
        {
          qword Temp_Time;
          dword swhere_temp;
          Temp_Time = 0;
          swhere_temp = 0;
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          Possition_LocalTime[1] = _Check_StrPossion("month",LocalTime_Possion,0);
          Possition_LocalTime[2] = _Check_StrPossion("day",LocalTime_Possion,0);
          Possition_LocalTime[3] = _Check_StrPossion("hour",LocalTime_Possion,0);
          Possition_LocalTime[4] = _Check_StrPossion("minute",LocalTime_Possion,0);
          Possition_LocalTime[5] = _Check_StrPossion("second",LocalTime_Possion,0);
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            if(Possition_LocalTime[m] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
            {
              //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
            }
            else
            {
              swhere_temp = mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][1];    //预期所在位置
              Temp_Time = Data_Rx_First[swhere_temp] + mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][2]; //计算后的值
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%d",Vaule_Str_Temp,Temp_Time);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            }
            snprintf(Value_First,elCount(Value_First),"%s%s",Value_First,Vaule_Str_Temp);
          }
        }
      }
      {
        Str_Possion = _Check_StrPossion_Res("Latest_Time_Fault_Occurrence_Time",3); //获取字符串所在位置
        if(DiagGetRespPrimitiveByte(Diag,29) != 0x23)
          testStepFail("Latest_Time_Fault_Occurrence_Time","拓展数据记录号与期望不一致,预期为%d，实际为%d",0x23,DiagGetRespPrimitiveByte(Diag,29));
        Start_Byte = 23 + 6 +1;  //数据所在位置
        for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          Data_Rx_Last[m] = DiagGetRespPrimitiveByte(Diag,Start_Byte+m);
        snprintf(Value_Last,elCount(Value_Last),"%s","");
        if(strncmp(mixArray[LocalTime_Possion].Symbol,"BCD",strlen(mixArray[LocalTime_Possion].Symbol))==0)   //BCD格式,全原码拼接
        {
          /*判断是:年/月/日/时/分/秒       还是:秒/分/时/日/月/年*/
          /************************待完善*************************/
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          if(mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[0]][1]>0)
            reverseNum(Data_Rx_First,ExDataRecord[Str_Possion].Ex_Data_Record_Len);   // 秒/分/时/日/月/年 逆向
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%x",Vaule_Str_Temp,Data_Rx_Last[m]);
            if(strlen(Vaule_Str_Temp)<2)
              snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            snprintf(Value_Last,elCount(Value_Last),"%s%s",Value_Last,Vaule_Str_Temp);
          }  //拼接排序
        }
        else
        {               
          qword Temp_Time;
          dword swhere_temp;
          Temp_Time = 0;
          swhere_temp = 0;
          Possition_LocalTime[0] = _Check_StrPossion("year",LocalTime_Possion,0);
          Possition_LocalTime[1] = _Check_StrPossion("month",LocalTime_Possion,0);
          Possition_LocalTime[2] = _Check_StrPossion("day",LocalTime_Possion,0);
          Possition_LocalTime[3] = _Check_StrPossion("hour",LocalTime_Possion,0);
          Possition_LocalTime[4] = _Check_StrPossion("minute",LocalTime_Possion,0);
          Possition_LocalTime[5] = _Check_StrPossion("second",LocalTime_Possion,0);
          for(m=0;m<ExDataRecord[Str_Possion].Ex_Data_Record_Len;m++)
          {
            snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%s","");
            if(Possition_LocalTime[m] == -1)    //仅包含部分时间,不是完整的 年月日时分秒,舍弃未查询到的字符
            {
              //snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'00',Vaule_Str_Temp);
            }
            else
            {
              swhere_temp = mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][1];    //预期所在位置
              Temp_Time = Data_Rx_Last[swhere_temp] + mixArray[LocalTime_Possion].LocalTime[Possition_LocalTime[m]][2]; //计算后的值
              snprintf(Vaule_Str_Temp,elcount(Vaule_Str_Temp),"%s%d",Vaule_Str_Temp,Temp_Time);
              if(strlen(Vaule_Str_Temp)<2)
                snprintf(Vaule_Str_Temp,elCount(Vaule_Str_Temp),"%c%s",'0',Vaule_Str_Temp);
            }
            snprintf(Value_Last,elCount(Value_Last),"%s%s",Value_Last,Vaule_Str_Temp);
          }
        }
      }
      if(strncmp(Value_First,ExValue_First,strlen(Value_First))==0)
        testStepPass("First_Time_Fault_Occurrence_Time","第一次发生故障时间与期望一致,为 %s",Value_First);
      else
        testStepFail("First_Time_Fault_Occurrence_Time","第一次发生故障时间与期望不一致,期望为: %s  ,实际为: %s",ExValue_First,Value_First);
      if(strncmp(Value_Last,ExValue_Last,strlen(Value_Last))==0)
        testStepPass("Latest_Time_Fault_Occurrence_Time","最近一次发生故障时间与期望一致,为 %s",Value_Last);
      else
        testStepFail("Latest_Time_Fault_Occurrence_Time","最近一次发生故障时间与期望不一致,期望为: %s  ,实际为: %s",ExValue_Last,Value_Last);
    }
  }
}

_Check_1903(diagRequest* Diag)
{
  dword DTC_Res[200][2];
  int Count_Res,i,Falge;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,1000);
  if(diagGetLastResponseCode(Diag) != -1)
    testStepFail("","未收到正响应");
  else
  {
    Falge = 0;
    Count_Res = (DiagGetRespPrimitiveSize(Diag)-2)/4;
    for(i=0;i<Count_Res;i++)
    {
      DTC_Res[i][0] = (diagGetRespPrimitiveByte(Diag,i*4+2+0)<<16) + (diagGetRespPrimitiveByte(Diag,i*4+2+1)<<8)+ (diagGetRespPrimitiveByte(Diag,i*4+2+2));
      DTC_Res[i][1] = diagGetRespPrimitiveByte(Diag,i*4+2+3);
    }
    for(i =0;i<Count_Res;i++)
    {
      if((DTC_Res[i][1]!= 0x20 && DTC_Res[i][1] != 0x21) )
      {
        Falge = 1;
        testStepFail("","DTC:0x%06X的快照ID与期望不符,实际结果为:0x%02X",DTC_Res[i][0],DTC_Res[i][1]);
      }
    }
    if(Falge == 0)
      testStepPass("","所有快照ID均与预期一致");
  }
}
//根据测试通过条件，在报告上标记结果，功能寻址不响应NRC11、12、13、31、7E、7F
int _TestResult(diagRequest* obj,dword  msgID,char stepid[],int passcondition)
{
  char comment[50];
  int Return_Va;
  Return_Va = 1;
  if((Res_NRC78 == 1) && (passcondition == 0)) /*收到NRC78且上一次预期为抑制肯定响应且预期结果为不响应情况下，修改预期响应为正响应  && ((DiagGetPrimitiveByte(obj,1)&0x80) != 0)*/
  {
    _WriteEx_and_Report("","由于收到NRC78，故下一次响应为正响应");
    passcondition = -1;
  }
  Res_NRC78 = 0;
  if(passcondition==-1)
    snprintf(comment,elCount(comment),"期望收到肯定响应");
  else if(passcondition==0)
    snprintf(comment,elCount(comment),"期望不响应");
  else
  {
    if(msgID==funreq_ID&&(passcondition==0X11||passcondition==0X12||(passcondition==0X13 && Fun_NRC13==0)||passcondition==0X31||passcondition==0X7E||passcondition==0X7F))
      snprintf(comment,elCount(comment),"期望不响应");
    else
      snprintf(comment,elCount(comment),"期望收到否定响应NRC%02X",passcondition);
  }
  if(diagGetLastResponseCode(obj)==-1)
  {
    byte Serve_Send,LenRx;
    Serve_Send = DiagGetPrimitiveByte(obj,0);
    LenRx = diagGetRespPrimitiveSize(obj);
    if(Serve_Send == 0x14 && LenRx != 1)
      testStepFail("","%02X服务响应长度异常,期望为 1，实际长度为 %d",Serve_Send,LenRx);
    else if((Serve_Send == 0x85 || Serve_Send == 0x11 || Serve_Send == 0x28 || Serve_Send == 0x3E) && LenRx != 2)
      testStepFail("","%02X服务响应长度异常,期望为 2，实际长度为 %d",Serve_Send,LenRx);
    else if((Serve_Send == 0x2E) && LenRx != 3)
      testStepFail("","%02X服务响应长度异常,期望为 3，实际长度为 %d",Serve_Send,LenRx);
    else if((Serve_Send == 0x27 && DiagGetPrimitiveByte(obj,1) == RequestSeed_27) && LenRx != SendKey_Len)
      testStepFail("","%02X服务响应长度异常,期望为 %d，实际长度为 %d",Serve_Send,SendKey_Len,LenRx);
    if(passcondition==-1)
      testStepPass(stepid,"%s，实际收到肯定响应",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到肯定响应",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0)
  { 
    if((passcondition==0)||(msgID==funreq_ID&&(passcondition==0X11||passcondition==0X12||(passcondition==0X13 && Fun_NRC13==0)||passcondition==0X31||passcondition==0X7E||passcondition==0X7F)))
    {
      Return_Va = 1;
      testStepPass(stepid,"%s，实际未收到响应",comment);
      return Return_Va;
    }  
    if(passcondition==-1)
    { 
      if(DiagGetPrimitiveByte(obj,2) == 0x19 && DiagGetPrimitiveByte(obj,1) == 0x0A)
      {
        if(diagGetLastResponseCode(obj)==0 || diagGetLastResponseCode(obj)==0x78)
          testWaitForDiagResponse(obj,2000);
      }
      else
      {
        if(diagGetLastResponseCode(obj)==0)
          testWaitForDiagResponse(obj,200); //等待多帧响应完毕
      }

      if(diagGetLastResponseCode(obj)==0)
      {
        Return_Va = -1;
        testStepFail(stepid,"%s，实际未收到响应",comment);
      }
      else if(diagGetLastResponseCode(obj)==-1)
      {
        int Res_Len;
        Return_Va = 1;
        Res_Len = diagGetRespPrimitiveSize(obj);
        if((Response_CanFD == 0 && Res_Len<=7) || (Response_CanFD == 1 && Res_Len<=62))
          testStepfail(stepid,"%s，单帧响应超时",comment);
        testStepPass(stepid,"%s，实际收到肯定响应",comment);
      }
      else
      {
        if(diagGetLastResponseCode(obj)==0x78)
        {
          testStepFail(stepid,"0x%02X服务NRC78响应超时",DiagGetRespPrimitiveByte(obj,1));
          testWaitForDiagResponse(obj,p2cmax*100); //等待NRC78后续
          if(diagGetLastResponseCode(obj)==-1)
            testStepPass(stepid,"%s，实际收到肯定响应",comment);
          else
          {
            Return_Va = -1;
            testStepFail(stepid,"%s，实际收到否定响应",comment);
          }
        }
        else
        {
          Return_Va = -1;
          testStepFail(stepid,"%s，实际收到否定响应",comment);
        }
      }
    }
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际未收到响应",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X10)
  {
    if((passcondition==0X10)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC10",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC10",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X11)
  {
    if((passcondition==0X11)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC11",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC11",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X12)
  {
    if((passcondition==0X12)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC12",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC12",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X13)
  {
    if((passcondition==0X13)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC13",comment);
    else if((passcondition==0X13)&&(msgID==funreq_ID && Fun_NRC13==1))
      testStepPass(stepid,"%s，实际收到否定响应NRC13",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC13",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X22)
  {
    if(passcondition==0X22)
      testStepPass(stepid,"%s，实际收到否定响应NRC22",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC22",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X24)
  {
    if(passcondition==0X24)
      testStepPass(stepid,"%s，实际收到否定响应NRC24",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC24",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X31)
  {
    if((passcondition==0X31)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC31",comment);
    else
      testStepFail(stepid,"%s，实际收到否定响应NRC31",comment);
  }
  else if(diagGetLastResponseCode(obj)==0X33)
  {
    if(passcondition==0X33)
      testStepPass(stepid,"%s，实际收到否定响应NRC33",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC33",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X7E)
  {
    if((passcondition==0X7E)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC7E",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC7E",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X7F)
  {
    if((passcondition==0X7F)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC7F",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC7F",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X78)
  {
    if((passcondition==0X78))
      testStepPass(stepid,"%s，实际收到否定响应NRC78",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC78",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X35)
  {
    if((passcondition==0X35))
      testStepPass(stepid,"%s，实际收到否定响应NRC35",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC35",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X36)
  {
    if((passcondition==0X36))
      testStepPass(stepid,"%s，实际收到否定响应NRC36",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC36",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X37)
  {
    if((passcondition==0X37))
      testStepPass(stepid,"%s，实际收到否定响应NRC37",comment);
    else
    {
      Return_Va = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC37",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)== passcondition)
    testStepPass(stepid,"%s，实际收到否定响应NRC%02X",comment,diagGetLastResponseCode(obj));
  else
  {
    Return_Va = -1;
    testStepFail(stepid,"%s，实际收到否定响应NRC%02X",comment,diagGetLastResponseCode(obj));
  }
  return Return_Va;
}

_Clear_BYD_Config_(byte type) /*type==0: 全0x00    type==1:全0xFF*/
{
  int m;
  byte size;
  qword checksum_config;
  diagRequest *BYD_Config_;
  byte config_1[3] = {0x2E,0xF1,0xA1};
  checksum_config = 0;
  size = 0x0B;
  _unlockECU();
  Get_Seed_Flage = 1;
  diagResize(BYD_Config_,size);
  for(m=0;m<3;m++)
    DiagSetPrimitiveByte(BYD_Config_,m,config_1[m]);
  if(type==0)
  {
    for(m=3;m<size-1;m++)
      DiagSetPrimitiveByte(BYD_Config_,m,0x00);
    DiagSetPrimitiveByte(BYD_Config_,m,0x55);
  }
  else
  {
    for(m=3;m<size;m++)
      DiagSetPrimitiveByte(BYD_Config_,m,0xff);
  }
  _SendAndWriteReport(BYD_Config_,phyreq_ID);
  _TestResult(BYD_Config_,phyreq_ID,"",-1);
}
void Init_For_14() //用于每次测试14服务时第一个Byte不一致
{
  int k,j,m;
  byte Temp_byte;
  Serve_14_31[0] = (ALL_DTC[0]>>16)&0xFF;
  m = 1;
  for(k=1;k<ALL_DTC_Num;k++)
  {
    Temp_byte = (ALL_DTC[k]>>16)&0xFF;
    for(j=0;j<m;j++)
    {
      if(Temp_byte == Serve_14_31[j])
        break;;
    }
    if(j == m)
    {
      Serve_14_31[m] = Temp_byte;
      m++;
    }
    if(m==4)
      break;
  }
  for(k=1;k<4;k++)
  {
    if(Serve_14_31[k]==0)
      Serve_14_31[k] = Serve_14_31[0];
  }
}

_Other_1002()
{
  if(Other_1002 == 1)
  {
    if(Pre_Programmed_1002 == 1 )
      _Pre_Programmed();
    if((Pre_Programmed_1002 == 0 && Unlock_1002 == 1) || (Pre_Programmed_1002 == 1 && Pre_Programmed_UnlockECU == 0 && Unlock_1002 == 1) )
      _unlockECU();
    if(Pre_Programmed_1002 == 0 && Unlock_1002 == 0 && Session_BIN == 0x01)
    {
      _SetSession(exsession);
      Session_BIN = 0x04;
    }
  }
  else if(Other_1002 == 0)
  {
    _WriteEx_and_Report("","无其余条件，即10 02可直接响应");
    if(Session_BIN == 0x01)
    {
      Session_BIN = 0x04;
    }
  }
}

_Pre_Programmed()
{
  dword Fun;
  int Pro_Pos;
  if(Pre_Programmed_UnlockECU==1)
    _unlockECU();
  _WriteEx_and_Report("","发送预编程报文");
  _get_Arry("Pre_Programmed");
  Fun = ((Arry_Data[2]<<8) | Arry_Data[3]);
  if(Pre_Programmed_UnlockECU == 0)
  {
    Pro_Pos = _Check_Serve(0x01,Fun,12);
    if(Pro_Pos != -1)
    {
      if((Serve_31_Hex[Pro_Pos].Serve_Session[0] & 0x1)==0)
      {
        if(Session_BIN == 1)
          _SetSession(exsession);
      }
    }
  }
  if(Arry_Len == 0)
    _WriteEx_and_Report("","未查询到对应预编程报文");
  else
  {
    _Send_Diag(Arry_Len,phyreq_ID,Arry_Data);
    _TestResult(SendData,phyreq_ID,"",-1);
  }
}

/// <Node>
_Set_Sig(char Sig[],float Vaule)
{
  char _str[120];
  char DBCName[300];
  char SigBefor[20] = "EV_ ";
  char ChangeStr[2];
  char buffer_ascii[500];
  char SearchStr[100] ;
  int SearchPos;
  int SigType;
  float Now_Value1,Now_Value2,Time0;
  
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",Sig);
  snprintf(DBCName,elCount(DBCName),".\\CANDBC\\%s",DBC_Name);
  GlbHandlefile = OpenFileRead (DBCName,0);
  if(GlbHandlefile != 0)
  {
    snprintf(SearchStr,elCount(SearchStr),"%s%s:",SigBefor,_str);
    while(fileGetStringSZ(buffer_ascii,elcount(buffer_ascii),GlbHandlefile)!=0)  
    {
      if(strstr(buffer_ascii,SearchStr)!=-1)
      {
        SearchPos = strlen(SearchStr) + 2-1; //查询信号在DBC中获取到的位置
        snprintf(ChangeStr,elCount(ChangeStr),"%c",buffer_ascii[SearchPos]);
        SigType = atol(ChangeStr);
        break;
      }
    }
  }
  fileClose(GlbHandlefile);
  Now_Value1 = getSignal(Sig); Time0 = 0;
  setSignal(Sig,Vaule);                         /*信号赋值*/
  if(SigType == 0) //整形数据
  {
    putValue(Sig,(int64)Vaule);                          /*非系统变量赋值*/
    putValue(_str,(int64)Vaule);                         /*非系统变量赋值*/
    writeEx(-3,0,"设置信号 %s 值为 %.0f",Sig,Vaule);
    testStep("","设置信号 %s 值为 %.0f",Sig,Vaule);
  }
  else
  {
    putValue(Sig,(float)Vaule);                          /*非系统变量赋值*/
    putValue(_str,(float)Vaule);                         /*非系统变量赋值*/
    writeEx(-3,0,"设置信号 %s 值为 %.2f",Sig,(float)Vaule);
    testStep("","设置信号 %s 值为 %.2f",Sig,(float)Vaule);
  }
  do
  {
    if(Time0 != 0)
      testWaitForTimeout(10);
    Now_Value2 = getSignal(Sig);
    Time0 = Time0+10;
  }while((Now_Value2 == Now_Value1) && Time0<=200);
}

