_Fun_1904(char Check_Str[],dword ID,byte Session)
{
  byte DTC_H,DTC_M,DTC_L;
  byte mask;
  int Pos_1904;
  byte Data_Send[6] = {0x19,0x04,0,0,0,0};
  dword  Possion;
  char comment[100];
  char Check_Str_[100];
  snprintf(comment,elCount(comment),"%s","");
  snprintf(Check_Str_,elCount(Check_Str_),"%s","");
  snprintf(Check_Str_,elCount(Check_Str_),"%s",Check_Str);
  Pos_1904 = Get_Node_Pos(Node_1904,1);
  DTC_H = (DTC_19[Pos_1904][1]>>16);
  DTC_M = (DTC_19[Pos_1904][1]>>8);
  DTC_L = (DTC_19[Pos_1904][1]&0xFF);
  Data_Send[2] = DTC_H;
  Data_Send[3] = DTC_M;
  Data_Send[4] = DTC_L;
  Data_Send[5] = Freeze_Frame_Number[0];
  Possion = _Check_StrPossion_Res(Check_Str,1);
  Signal_Flage = 0;
  _Str_Upper(Check_Str_);
  if((strncmp(Check_Str_,"BATTERY",strlen(Check_Str_)) == 0) || (strncmp(Check_Str_,"VOLTAGE",strlen(Check_Str_)) == 0))
  {
    if(_Check_mixArray_SetValue(Check_Str,Possion)==1)
    {
      /****************制造故障并获取快照****************/
      _WriteEx_and_Report(Check_Str_,"正常范围内设置电压");
      _Set_Battery(mixArray[Possion].Vaule_Set[0]);/*正常范围内设置电压*/
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      mask = DTC_19[Pos_1904][2];
      _Check_1904(SendData,mask,Check_Str,mixArray[Possion].Vaule_Set[0],0);
      /****************故障恢复并清除故障****************/
      _Temp_For_1904_Clear(Pos_1904);
      /****************制造故障并获取快照****************/
      _WriteEx_and_Report(Check_Str_,"设置电压为第二次输入值");
      _Set_Battery(mixArray[Possion].Vaule_Set[1]);/*设置电压为物理最大值*/ /*电压由于最大值会导致诊断无响应，此处使用输入值*/
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,mixArray[Possion].Vaule_Set[1],0);
      /****************故障恢复并清除故障****************/
      _Temp_For_1904_Clear(Pos_1904);
      /****************制造故障并获取快照****************/
      _WriteEx_and_Report(Check_Str_,"设置电压为第三次输入值");
      _Set_Battery(mixArray[Possion].Vaule_Set[2]);/*设置电压为物理最大值+1  mixArray[Possion].DID_Value_max*/
      _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
      _Check_1904(SendData,mask,Check_Str,mixArray[Possion].Vaule_Set[2],0);
      
      _Set_Battery(12);/*正常范围内设置电压*/
    }
    else
      _WriteEx_and_Report("","输入值为全0情况下跳过测试");
  }
  else if(strncmp(Check_Str_,"MOTOR_TEMPERATURE",strlen(Check_Str_)) == 0  || strncmp(Check_Str_,"ECU_TEMPERATURE",strlen(Check_Str_)) == 0)
  {
    _WriteEx_and_Report(Check_Str,"当前测试项次涉及热保护,无法自动化测试");
    testStepWarning("","");
  }
  else if(strncmp(Check_Str_,"ANGLE",strlen(Check_Str_)) == 0)
  {
    if(_Check_mixArray_SetValue(Check_Str,Possion)==1)
    {
    _Get_Signal(mixArray[Possion].Sig_Name[0]);
    if(Signal_Flage == 1)
      _WriteEx_and_Report("","无法获取到准确的角度信号,人为转动方向盘时注意保证角度的误差在范围内");
    _Get_Ready();
    if(Engine_State == 0)
      _Set_Ready(Struct_Ready.Ready_Active);
    snprintf(comment,elCount(comment),"%s","");
    snprintf(comment,elCount(comment),"转动方向盘到  %.1f°",mixArray[Possion].Vaule_Set[0]);
    _TestWaitForTesterConfirmation(comment);
    _WriteEx_and_Report(Check_Str_,"制造故障");
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
    mask = DTC_19[Pos_1904][2];
//    if(Signal_Flage==0)//使用外发信号的具体值,暂时屏蔽
//      _Check_1904(SendData,mask,Check_Str,_Get_Signal(mixArray[Possion].Sig_Name[0]),0);
//    else
      _Check_1904(SendData,mask,Check_Str,mixArray[Possion].Vaule_Set[0],0);
    /****************故障恢复并清除故障****************/
    _WriteEx_and_Report(Check_Str_,"故障恢复并清除故障");
    _Temp_For_1904_Clear(Pos_1904);
    snprintf(comment,elCount(comment),"%s","");
    snprintf(comment,elCount(comment),"转动方向盘到  %.1f°",mixArray[Possion].Vaule_Set[0]*(-1));
    _TestWaitForTesterConfirmation(comment);
    _Temp_For_1904_Set(Pos_1904,ID,Data_Send);
//    if(Signal_Flage==0)  
