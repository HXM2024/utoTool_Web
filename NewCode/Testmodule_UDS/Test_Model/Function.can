  _Get_DID(Str_22_Send);
  Analysis_Select(Analysis,phyreq_ID,Send_Num,-1);
}


 _Str_Upper(char Str[])
{
  char Tem_Str[200];
  toUpper(Tem_Str,Str,elCount(Tem_Str));
  snprintf(Str,elcount(Str),"%s",Tem_Str);
}
/****************************************************************************************************
 * 辅助函数：_HexStrToQword
 * 功能  ：将 "0xHHHH..."(十六进制) 或 "123456"(十进制) 字符串转换为 64位无符号整数 qword
 *        - 十六进制支持 1~16 个字符(即 1~8 字节)，自动补偶数字节
 *        - 十进制支持任意长度(内部使用 qword 逐字符乘10累加，最大到 0xFFFFFFFFFFFFFFFF)
 * 解决问题：
 *        atol()   32位有符号容器 -> 4字节高位为1时符号位错误 / >4字节直接截断丢高位
 *        atodbl() 53位尾数精度  -> >7字节整数丢失低精度位
 ****************************************************************************************************/
qword _HexStrToQword(char s[])
{
  int   i, len, pos_start;
  qword result;
  byte  b, nib_hi, nib_lo;

  result = 0;
  len    = strlen(s);

  /* ---- 十六进制分支（带 0x / 0X 前缀） ---- */
  if (strstr(s,"0x") != -1 || strstr(s,"0X") != -1)
  {
    pos_start = 2;
    /* 奇数个十六进制字符 -> 先处理最高半字节（相当于前补0） */
    if ((len - pos_start) % 2 == 1)
    {
      nib_hi = 0;
      if      (s[pos_start] >= '0' && s[pos_start] <= '9') nib_hi = s[pos_start] - '0';
      else if (s[pos_start] >= 'A' && s[pos_start] <= 'F') nib_hi = s[pos_start] - 'A' + 10;
      else if (s[pos_start] >= 'a' && s[pos_start] <= 'f') nib_hi = s[pos_start] - 'a' + 10;
      result = (result << 4) | nib_hi;
      pos_start++;
    }
    /* 每 2 个十六进制字符拼成 1 字节，从高到低左移拼接到 qword */
    for (i = pos_start; i < len; i += 2)
    {
      nib_hi = 0; nib_lo = 0;
      if      (s[i] >= '0' && s[i] <= '9') nib_hi = s[i] - '0';
      else if (s[i] >= 'A' && s[i] <= 'F') nib_hi = s[i] - 'A' + 10;
      else if (s[i] >= 'a' && s[i] <= 'f') nib_hi = s[i] - 'a' + 10;
      if (i + 1 < len)
      {
        if      (s[i+1] >= '0' && s[i+1] <= '9') nib_lo = s[i+1] - '0';
        else if (s[i+1] >= 'A' && s[i+1] <= 'F') nib_lo = s[i+1] - 'A' + 10;
        else if (s[i+1] >= 'a' && s[i+1] <= 'f') nib_lo = s[i+1] - 'a' + 10;
      }
      b      = (nib_hi << 4) | nib_lo;
      result = (result << 8) | b;
    }
  }
  /* ---- 十进制分支 ---- */
  else
  {
    /* 短十进制(<=15位约<2^53)直接走 atodbl 转 qword */
    if (len <= 15)
      result = (qword)atodbl(s);
    else
    {
      /* 长十进制逐字符 *10 + digit 累加，避免 atodbl 精度丢失 */
      for (i = 0; i < len; i++)
      {
        if (s[i] >= '0' && s[i] <= '9')
          result = result * 10 + (s[i] - '0');
      }
    }
  }
  return result;
}

/* --------------------------------------------------------------------------
   函数：_Init_Shuffle_Seed
   作用：初始化随机数种子（基于系统日期时间 + 测量运行时间，避免每次运行顺序相同）
   说明：CAPL 中 getLocalTime(long tm[9]) 是按 tm[0..8] 写入时分秒/年月日等，无返回值
   -------------------------------------------------------------------------- */
void _Init_Shuffle_Seed()
{
  long tm[9];
  long seed_val;
  dword runtime_ms;

  // 获取本地日期时间：tm[0]=秒, [1]=分, [2]=时, [3]=日, [4]=月, [5]=年, ...
  getLocalTime(tm);

  // 获取当前测量运行时间（毫秒），再叠加一层随机性
  runtime_ms = (dword)timeNow();

  // 组合：年-月-日-时-分-秒 做哈希，再异或运行毫秒
  seed_val = (tm[5] << 25)
           | (tm[4] << 21)
           | (tm[3] << 16)
           | (tm[2] << 11)
           | (tm[1] << 6)
           |  tm[0];
  seed_val = seed_val ^ (long)runtime_ms;

  random(seed_val);
}

/* --------------------------------------------------------------------------
   函数：_Shuffle_And_Load_Msg
   作用：将 ArrySour 的行顺序打乱后复制到 ArryTar
   参数：DataCount_  -> 实际有效的消息条数（<=100）
   返回：1 = 成功，0 = 参数非法
   说明：使用 Fisher-Yates (Knuth) 洗牌算法，保证每条排列等概率
   -------------------------------------------------------------------------- */
byte _Shuffle_And_Load_Msg(dword DataCount_,dword ArrySour[][],dword ArryTar[][])
{
  dword idx_i;
  dword idx_j;
  dword pos_start;
  dword tmp0;
  dword tmp1;
  dword work_arr[100][2];
  // 参数合法性校验
  if (DataCount_ == 0 || DataCount_ > 100)
  {
    write("ERROR:输入数组超过预期范围 [1,100]", DataCount_);
    return 0;
  }
  // 步骤1：先将 Save_All_Msg 拷贝到临时数组 work_arr（保持原始数据不被破坏）
  for (idx_i = 0; idx_i < DataCount_; idx_i++)
  {
    work_arr[idx_i][0] = ArrySour[idx_i][0];
    work_arr[idx_i][1] = ArrySour[idx_i][1];
  }
  // 步骤2：Fisher-Yates 洗牌
  // 从最后一个元素开始，依次与前面随机位置的元素交换
  for (pos_start = DataCount_; pos_start > 1; pos_start--)
  {
    // 生成 [0, pos_start-1] 范围内的随机索引
    idx_j = random(pos_start);
    idx_i = pos_start - 1;
    // 交换 work_arr[idx_i] 和 work_arr[idx_j] 两行
    if (idx_i != idx_j)
    {
      tmp0 = work_arr[idx_i][0];
      tmp1 = work_arr[idx_i][1];
      work_arr[idx_i][0] = work_arr[idx_j][0];
      work_arr[idx_i][1] = work_arr[idx_j][1];
      work_arr[idx_j][0] = tmp0;
      work_arr[idx_j][1] = tmp1;
    }
  }
  // 步骤3：将打乱后的 work_arr 装入 Change_All_Msg
  for (idx_i = 0; idx_i < DataCount_; idx_i++)
  {
    ArryTar[idx_i][0] = work_arr[idx_i][0];
    ArryTar[idx_i][1] = work_arr[idx_i][1];
  }
  // 超出 DataCount_ 的位置用 0 填充，避免残留脏数据
  for (idx_i = DataCount_; idx_i < 100; idx_i++)
  {
    ArryTar[idx_i][0] = 0;
    ArryTar[idx_i][1] = 0;
  }
  return 1;
}


/* --------------------------------------------------------------------------
   函数：_Shuffle_And_Load_Msg
   作用：将 ArrySour 的行顺序打乱后复制到 ArryTar
   参数：DataCount_  -> 实际有效的消息条数（<=100）
   返回：1 = 成功，0 = 参数非法
   说明：使用 Fisher-Yates (Knuth) 洗牌算法，保证每条排列等概率
   -------------------------------------------------------------------------- */
byte _Shuffle_And_Load_Msg(dword DataCount_,byte ArrySour[],byte ArryTar[])
{
  dword idx_i;
  dword idx_j;
  dword pos_start;
  dword tmp0;
  byte work_arr[100];
  // 参数合法性校验
  if (DataCount_ == 0 || DataCount_ > 100)
  {
    write("ERROR:输入数组超过预期范围 [1,100]", DataCount_);
    return 0;
  }
  // 步骤1：先将 Save_All_Msg 拷贝到临时数组 work_arr（保持原始数据不被破坏）
  for (idx_i = 0; idx_i < DataCount_; idx_i++)
    work_arr[idx_i] = ArrySour[idx_i];
  // 步骤2：Fisher-Yates 洗牌
  // 从最后一个元素开始，依次与前面随机位置的元素交换
  for (pos_start = DataCount_; pos_start > 1; pos_start--)
  {
    // 生成 [0, pos_start-1] 范围内的随机索引
    idx_j = random(pos_start);
    idx_i = pos_start - 1;
    // 交换 work_arr[idx_i] 和 work_arr[idx_j] 两行
    if (idx_i != idx_j)
    {
      tmp0 = work_arr[idx_i];
      work_arr[idx_i] = work_arr[idx_j];
      work_arr[idx_j] = tmp0;
    }
  }
  // 步骤3：将打乱后的 work_arr 装入 Change_All_Msg
  for (idx_i = 0; idx_i < DataCount_; idx_i++)
    ArryTar[idx_i] = work_arr[idx_i];
  return 1;
}


/* --------------------------------------------------------------------------
   函数：_Sort_InPut_Arry
   作用  ：按 arr_ptr[i][0] 从小到大排序（升序）
   参数  ：arr_ptr    -> 二维 dword 数组
           elem_cnt   -> 实际有效元素个数（外部输入，例如 40）
           arr_max    -> 数组声明的最大行数（防止越界，例如 100）
   返回  ：1=成功  0=参数非法
   -------------------------------------------------------------------------- */
byte _Sort_InPut_Arry(dword arr_ptr[][], dword elem_cnt, dword arr_max)
{
  dword idx_i;
  dword idx_k;
  dword tmp0;
  dword tmp1;
  byte  swapped;

  // ---- 参数合法性 ----
  if (elem_cnt == 0 || arr_max == 0)
  {
    write("ERROR: _Sort_OutPut_Msg: elem_cnt=%d or arr_max=%d is zero", elem_cnt, arr_max);
    return 0;
  }
  if (elem_cnt > arr_max)
  {
    write("ERROR: _Sort_OutPut_Msg: elem_cnt=%d > arr_max=%d overflow", elem_cnt, arr_max);
    return 0;
  }
  // ---- 冒泡排序：按 [0] 列升序 ----
  // 外层：趟数，每趟把当前最大的"冒"到末尾
  for (idx_i = 0; idx_i < elem_cnt - 1; idx_i++)
  {
    swapped = 0;
    // 内层：相邻两两比较，已冒到末尾的不再参与
    for (idx_k = 0; idx_k < elem_cnt - 1 - idx_i; idx_k++)
    {
      if (arr_ptr[idx_k][0] > arr_ptr[idx_k + 1][0])
      {
        // 交换 [idx_k] 与 [idx_k+1] 两行
        tmp0 = arr_ptr[idx_k][0];tmp1 = arr_ptr[idx_k][1];
        arr_ptr[idx_k][0] = arr_ptr[idx_k + 1][0];arr_ptr[idx_k][1] = arr_ptr[idx_k + 1][1];
        arr_ptr[idx_k + 1][0] = tmp0;arr_ptr[idx_k + 1][1] = tmp1;
        swapped = 1;
      }
    }
    // 本趟没发生任何交换 -> 已全部有序，提前退出
    if (swapped == 0)
      break;
  }
  return 1;
}

// 从 str 的 startPos 位置开始，截取 length 个字符到 dest
void SubString(char str[], char dest[], int startPos, int length)
{
  int i,Len;
  Len = strlen(str);
  if (startPos < 0 || startPos >= Len || length <= 0)
  {
    dest[0] = '\0';
    return;
  }
  for (i = 0; i < length && (startPos + i) < Len; i++)
    dest[i] = str[startPos + i];
  dest[i] = '\0';
}

/* 只保留字符串中的数字字符(0-9) */
void KeepDigitsOnly(char str[])
{
  int len;
  int i, j;
  byte c;
  len = strlen(str);
  j = 0;
  for (i = 0; i < len; i++)
  {
    c = str[i];
    if (c >= '0' && c <= '9')
    {
      str[j] = c; j++;
    }
  }
  str[j] = '\0';  /* 字符串结束符 */
}

/*
    给指定的快照赋值，  SetPos第几组快照
    StrValue:用于时间快照赋值
    type = 1:赋值到无效值
*/
void SetVaule_For_Snapshot(char Str[],dword Value,char StrValue[],byte SetPos,byte type)
{
  int StrPos;
  char str_T[100];
  snprintf(str_T,elCount(str_T),"%s",Str);
  _Str_Upper(str_T);
  StrPos = _Check_StrPossion_Res(Str,1);
  if(type == 1)
  {
    if(strncmp(str_T,"LOCALTIME",strlen(str_T)) == 0)
      mixArray[StrPos].Invalid = _HexStrToQword(StrValue);
    else
      mixArray[StrPos].Invalid = Value;
  }
  else
  {
    if(strncmp(str_T,"LOCALTIME",strlen(str_T)) == 0)
      snprintf(mixArray[StrPos].LocalTime_Value_2[SetPos],elCount(mixArray[StrPos].LocalTime_Value_2[SetPos]),"%s",StrValue);
    else
      mixArray[StrPos].Vaule_Ex_2[SetPos] = Value;
  }
}

/// <Node>
/*
    依据输入的报文ID以及配置的DBC名称查询报文的帧周期
*/
int _GetCycleFromDBC(dword MsgID)
{
  char DBCName[300];
  char SigBefor[200] = "GenMsgCycleTime";
  char buffer_ascii[500];
  char SigSearch[200];
  char ChangeStr[50];
  int SearchPos,SearchPos2,CycleTime,i;
  snprintf(DBCName,elCount(DBCName),".\\CANDBC\\%s",DBC_Name);
  snprintf(SigSearch,elCount(SigSearch),"%d",MsgID);
  snprintf(ChangeStr,elCount(ChangeStr),"");
  GlbHandlefile = OpenFileRead (DBCName,0);
  if(GlbHandlefile != 0)
  {
    while (fileGetString(buffer_ascii, elcount(buffer_ascii), GlbHandlefile) != 0 )
    {
      if(strstr(buffer_ascii,SigBefor)!=-1 && strstr(buffer_ascii,"BA_")!=-1 && strstr(buffer_ascii,"BO_")!=-1 && strstr(buffer_ascii,"BO_")!=-1 && strstr(buffer_ascii,SigSearch)!=-1)
      {
        SearchPos = 26 + strlen(SigSearch)+1;
        SearchPos2 = strstr(buffer_ascii,";");
        for(i=SearchPos;i<SearchPos2+1;i++)
          snprintf(ChangeStr,elCount(ChangeStr),"%s%c",ChangeStr,buffer_ascii[i]);
        CycleTime = atol(ChangeStr);
        fileClose(GlbHandlefile);
        return CycleTime;
      }
    }
  }
  fileClose(GlbHandlefile);
  return 1;
}
