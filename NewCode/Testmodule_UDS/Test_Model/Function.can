{
  char str[500];
  char str_[500];
  
  snprintf(str,elCount(str),"%s","");
  snprintf(str_,elCount(str_),"%s","");
  strncpy(str,str1,elCount(str));
  strncat(str,"   ",elCount(str));
  strncat(str,str2,elCount(str));
  snprintf(str,elCount(str),"%s%s",str,str3);
  writeEx(-3,0,str);
  snprintf(str_,elCount(str_),"%s%s",str2,str3);
  TestStep(str1,str_);
}
