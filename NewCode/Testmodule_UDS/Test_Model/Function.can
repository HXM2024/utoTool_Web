    IGON.byte(2)=0x01;
    output (IGON);
  } 
  _WriteEx_and_Report("上点火","K15->ON");
}
/// <Power>
_K15_OFF()
{
  if(Burn_in_Board==1)
    RelayOFF(2);
  else if(Burn_in_Board==2)
    RelayON(2);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x01;
    IGON.byte(2)=0x00;
    output (IGON);
  } 
  testWaitForTimeout(100);
  _WriteEx_and_Report("下点火","K15->OFF,等待100ms");
}
/// <Power>
_K30_ON()
{
  if(Burn_in_Board==1)
    RelayON(1);
  else if(Burn_in_Board==2)
