on sysvar DID::ECU_platform
{
  sysGetVariableDescriptionForValue(sysvar::DID::ECU_platform,@sysvar::DID::ECU_platform,ECU_platform,elcount(ECU_platform));
  writeProfileString("Version_Information", "ECU_platform", ECU_platform, file_name_0);
  getProfileString(ECU_platform, "Hardware_version","Null",Hardware_version, 1000, file_name_0);
  syssetVariableString(sysvar::DID::Hardware_version,Hardware_version);
