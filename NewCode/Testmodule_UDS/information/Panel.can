/*****************新老化板******************/
//RelayON(端口X) ：端口X 黑色接口-黄色接口
//RelayOFF(端口X)：端口X 黑色接口-绿色接口
void RelayON(byte Ctr_state)
{
  Relaymsg.id=0x101;
  Relaymsg.can = Board_Channel;
  if(Burn_in_Board==2)
    LHB_State = LHB_State_New;
  switch(Ctr_state)
  {//置为0
    case 1:@sysvar::DID::LHB_State &=0xFE;break;
    case 2:@sysvar::DID::LHB_State &=0xFD;break;
    case 3:@sysvar::DID::LHB_State &=0xFB;break;
    case 4:@sysvar::DID::LHB_State &=0xF7;break;
  }
  LHB_State_New = LHB_State;
  Relaymsg.byte(0)= @sysvar::DID::LHB_State ;
  output(Relaymsg);
}
void RelayOFF(byte Ctr_state)
{ 
  Relaymsg.id=0x101;
  Relaymsg.can = Board_Channel;
  if(Burn_in_Board==2)
    LHB_State = LHB_State_New;
  switch(Ctr_state)
  {//置为1
    case 1:@sysvar::DID::LHB_State |=1; break;
    case 2:@sysvar::DID::LHB_State |=2;break;
    case 3:@sysvar::DID::LHB_State |=4;break;
    case 4:@sysvar::DID::LHB_State |=8;break;
  }
  LHB_State_New = LHB_State;
  Relaymsg.byte(0)= @sysvar::DID::LHB_State ;
  output(Relaymsg);
}

on key '1'
{
  if(Burn_in_Board==2)
    RelayOFF(1);
  else
    RelayON(1);
  writeEx(-3,0,"上K30电");
}
on key '2'
{
  if(Burn_in_Board==2)
    RelayOFF(2);
  else
    RelayON(2);
  writeEx(-3,0,"上K15电");
}
on key '3'
{
  if(Burn_in_Board==2)
    RelayON(1);
  else
    RelayOFF(1);
  writeEx(-3,0,"下K30电");
}
on key '4'
{
  if(Burn_in_Board==2)
    RelayON(2);
  else
    RelayOFF(2);
  writeEx(-3,0,"下K15电");
}
on sysvar sysvar::DID::ClearPath
{
  if(@sysvar::DID::ClearPath == 1)
  {
    sysSetVariableString(sysvar::DID::SWP1_Path,"");
    sysSetVariableString(sysvar::DID::SWP2_Path,"");
    writeEx(-3,0,"清除文件输入");
  }
}
