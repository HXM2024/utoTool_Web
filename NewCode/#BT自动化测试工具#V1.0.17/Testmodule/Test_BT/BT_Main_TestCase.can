testcase Alternate_DownLoad()
{
  char comment[70];
  int Download_Time;
  char SoftWare1_Now[400];
  char SoftWareBefor1_Now[400];
  char SoftWareBefor2_Now[400];
  char SoftWareBefor3_Now[400];
  Download_Time = 0;
  
      sysGetVariableString(sysvar::Test::openhex,SoftWareBefor1_Now,elCount(SoftWareBefor1_Now));
      sysGetVariableString(sysvar::Test::openhex1,SoftWareBefor2_Now,elCount(SoftWareBefor2_Now));
      sysGetVariableString(sysvar::Test::openhex2,SoftWareBefor3_Now,elCount(SoftWareBefor3_Now));
  
  while(@Test::Loop_Test_Switch && Download_Time < @sysvar::AUTO::Alternate_Count)
  {
    writeEx(-3,1,"---------------------测试第%d次交替刷写---------------------",++Download_Time);
    snprintf(comment,elCount(comment),"测试第%d次交替刷写",Download_Time);
    testCaseComment(comment);
    Alternate_DownLoad_Flage = 1;
    {
      sysGetVariableString(sysvar::AUTO::SoftWare1_1,SoftWare1_Now,elCount(SoftWare1_Now));
      sysSetVariableString(sysvar::Test::openhex,SoftWare1_Now);
      sysGetVariableString(sysvar::AUTO::SoftWare1_2,SoftWare1_Now,elCount(SoftWare1_Now));
      sysSetVariableString(sysvar::Test::openhex1,SoftWare1_Now);
      sysGetVariableString(sysvar::AUTO::SoftWare1_3,SoftWare1_Now,elCount(SoftWare1_Now));
      sysSetVariableString(sysvar::Test::openhex2,SoftWare1_Now);
    }
    MainInit();
    MainTest_f();
    Deinit();
    
    Alternate_DownLoad_Flage = 2;
    {
      sysGetVariableString(sysvar::AUTO::SoftWare2_1,SoftWare1_Now,elCount(SoftWare1_Now));
      sysSetVariableString(sysvar::Test::openhex,SoftWare1_Now);
      sysGetVariableString(sysvar::AUTO::SoftWare2_2,SoftWare1_Now,elCount(SoftWare1_Now));
      sysSetVariableString(sysvar::Test::openhex1,SoftWare1_Now);
      sysGetVariableString(sysvar::AUTO::SoftWare2_3,SoftWare1_Now,elCount(SoftWare1_Now));
      sysSetVariableString(sysvar::Test::openhex2,SoftWare1_Now);
    }
    MainInit();
    MainTest_f();
    Deinit();
  }
  sysSetVariableString(sysvar::Test::openhex,SoftWareBefor1_Now);
  sysSetVariableString(sysvar::Test::openhex1,SoftWareBefor2_Now);
  sysSetVariableString(sysvar::Test::openhex2,SoftWareBefor3_Now);
}
//正常刷写1000次
testcase Normal_Test_1000()
{
  char comment[70];
  dword hexaddr[3][2];
  dword Save_Change_CompilePro,Save_Change_ReadPro;
  
  Download_Count = 0;
  Save_Change_CompilePro = 0;
  Save_Change_ReadPro = 0;
  while(@Test::Loop_Test_Switch && Download_Count < 1000)
  {
    writeEx(-3,1,"---------------------测试第%d次正常刷写---------------------",++Download_Count);
    snprintf(comment,elCount(comment),"测试第%d次正常刷写",Download_Count);
    testCaseComment(comment);
    MainInit();
    MainTest_f();
    Deinit();
    
    if(@AUTO::Config_Switch==12)
    {
      if(Download_Count>1)
      {
        if(Change_CompilePro - Save_Change_CompilePro != 1)
          testStepFail("","编程尝试次数增量错误，当前增量为%d",Change_CompilePro - Save_Change_CompilePro);
        else
          testStepPass("","编程尝试次数步增值为1");
        if(Change_ReadPro - Save_Change_ReadPro != 1)
          testStepFail("","编程次数增量错误，当前增量为%d",Change_ReadPro - Save_Change_ReadPro);
        else
          testStepPass("","编程次数步增值为1");
      }
      Save_Change_CompilePro = Change_CompilePro;
      Save_Change_ReadPro = Change_ReadPro;
    }
  }
  writeEx(-3,1,"---------------------正常刷写1000次测试完成---------------------");
  
}

testcase Normal_Test_Cycle()
{
  char comment[70];
  dword hexaddr[3][2];
  dword Save_Change_CompilePro,Save_Change_ReadPro;
  
  Download_Count = 0;
  Save_Change_CompilePro = 0;
  Save_Change_ReadPro = 0;
  while(@Test::Loop_Test_Switch)
  {
    writeEx(-3,1,"---------------------测试第%d次正常刷写---------------------",++Download_Count);
    snprintf(comment,elCount(comment),"测试第%d次正常刷写",Download_Count);
    testCaseComment(comment);
    MainInit();
    MainTest_f();
    Deinit();
    
    if(@AUTO::Config_Switch==12)
    {
      if(Download_Count>1)
      {
        if(Change_CompilePro - Save_Change_CompilePro != 1)
          testStepFail("","编程尝试次数增量错误，当前增量为%d",Change_CompilePro - Save_Change_CompilePro);
        else
          testStepPass("","编程尝试次数步增值为1");
        if(Change_ReadPro - Save_Change_ReadPro != 1)
          testStepFail("","编程次数增量错误，当前增量为%d",Change_ReadPro - Save_Change_ReadPro);
        else
          testStepPass("","编程次数步增值为1");
      }
      Save_Change_CompilePro = Change_CompilePro;
      Save_Change_ReadPro = Change_ReadPro;
    }
  }
  writeEx(-3,1,"---------------------停止刷写,共测试%d次刷写---------------------",Download_Count);
}

