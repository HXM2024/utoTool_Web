testcase ID_Check()
{
  message *Msg;
  dword ID;
  Msg.dlc = 8;
  Msg.byte(0) = 0x02;
  Msg.byte(1) = 0x10;
  Msg.byte(2) = 0x01;
  for(ID = 0x700;ID <= 0x7FF;ID++)
  {
    Msg.id = ID;
    output(Msg);
    testWaitForTimeout(70);
  }
}
