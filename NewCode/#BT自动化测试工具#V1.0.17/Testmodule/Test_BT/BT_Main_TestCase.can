  Resp_37_a = 0x7F;
  _Send37(phyID,Resp_37_a);
  Deinit();
}
testcase Case_BT_Manager_04()/*默认会话发送1101复位后有编程请求*/
{
  int i,Response;
  message 0x00 msg;
  message *SendMsg;
  diagRequest ABS_ESP.hardReset_Reset req11;
  
  DiagSetPrimitiveByte(req11,1,0x01); 
  MainInit();
  /*判断当前是否APP有效*/
  if(Check_AppValid() == 0) //无效
  {
    MainTest_f();
    Resp_Init();
    _K15_OFF();
    testWaitForTimeout(2000);
    _K15_ON();
    testWaitForTimeout(2000);
  }
  
  _diagSendMsg(phyID,req11);
  _get_FC(req11,phyID,"",-1);
  i = 0;Response = 0;SendMsg.id = phyID;
  SendMsg.dlc = 8;SendMsg.can = 1;SendMsg.FDF = 0;
  SendMsg.byte(0) = 0x02;SendMsg.byte(1) = 0x10;SendMsg.byte(2) = 0x02;SendMsg.byte(3) = 0x55;
  SendMsg.byte(4) = 0x55;SendMsg.byte(5) = 0x55;SendMsg.byte(6) = 0x55;SendMsg.byte(7) = 0x55;
  do
  {
    output(SendMsg);
    if(testWaitForMessage(revID,10))
    {
      testGetWaitEventMsgData(msg);
      if(msg.byte(1) == 0x50 && msg.byte(2) == 0x02)
      {
        Response = 1;break;
      }
    }
    i++;
  }while( Response == 0 && i<500);
  if(i >= 500)
    testStepFail("","测试次数达到最大前，未收到正响应");
  if(Response == 1)
    testStepPass("","成功进入编程会话");
  testWaitForTimeout(2000);
  Resp_1001 = -1;
  enterDefault(phyID,0,Resp_1001);
  Deinit();
}

