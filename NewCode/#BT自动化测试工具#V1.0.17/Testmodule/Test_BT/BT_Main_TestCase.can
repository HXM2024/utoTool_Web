    _K15_OFF();
    testWaitForTimeout(3000);
    _K15_ON();
    testWaitForTimeout(1000);
    
    app_status = Check_AppValid();
//    if(app_status == 1)
//      snprintf(comment,elCount(comment),"：APP有效");
//    else
//      snprintf(comment,elCount(comment),"：APP无效");
//    writeEx(-3,1,comment);

  }
  writeEx(-3,1,"/*---------------------停止刷写---------------------*/");
  
}
/*验证是否在APP中擦除APP有效位1——进入BT后上下电*/
testcase BT_AppValid1()
{
  char comment[70];
  MainInit();
  Loop_Add_Times = 0;
  Loop_Add_Time =0;
  @Faultinsert::TC_BT_AppValid = 1;
  /*判断当前是否APP有效*/
  curAppValid = Check_AppValid();
  Restart_Time = 1;
  curAppValid = 1;
  Resp_1003 = -1;
  while(@Test::Loop_Test_Switch && ( Loop_Add_Times < @Test::Loop_Power_Times) )
  {
    writeEx(-3,1,"/*---------------------第%d次测试,等待时间为：%dms---------------------*/",++Loop_Add_Times,Loop_Add_Time);
    snprintf(comment,elCount(comment),"第%d次测试,等待时间为：%dms",Loop_Add_Times,Loop_Add_Time);
    testCaseComment(comment);
    
    if(Loop_Add_Times > 0)
      @Faultinsert::TC_Miss_GetFc = 1;
    
    Pre_Programme_For_AppValidTest();
    if(Loop_Add_Time > 0)
    {
      testWaitForTimeout(Loop_Add_Time);
      writeEx(-3,1,"等待：%dms",Loop_Add_Time);
    }
    _K15_OFF();
    testWaitForTimeout(2000);
    _K15_ON();
    testWaitForTimeout(2000);
    writeEx(-3,1,"等待：2s");
    @Faultinsert::TC_Miss_GetFc = 0;
    Check_APPValid2();
    
    Loop_Add_Time +=5; 
    testWaitForTimeout(100);
    if(@AUTO::APP_Invalid == 1)
      break;
  }
  @Faultinsert::TC_Miss_GetFc = 0;
  @Faultinsert::TC_BT_AppValid = 0;
  writeEx(-3,1,"/*---------------------停止测试---------------------*/");
  
}
/*验证是否在BT中擦除APP有效位2——刷写完数据校验后上下电*/
testcase BT_AppValid2()
{
  char comment[70];
  MainInit();
  Loop_Add_Times = 0;
  Loop_Add_Time =0;
  
  while(@Test::Loop_Test_Switch && ( Loop_Add_Times < @Test::Loop_Power_Times) )
  {
    writeEx(-3,1,"/*---------------------第%d次测试,等待时间为：%dms---------------------*/",++Loop_Add_Times,Loop_Add_Time);
    snprintf(comment,elCount(comment),"第%d次测试,等待时间为：%dms",Loop_Add_Times,Loop_Add_Time);
    testCaseComment(comment);
    
//    @Faultinsert::TC_BT_AppValid = 0;
//    MainTest_f();
//    Deinit();
//    MainInit();
    
    @Faultinsert::TC_BT_AppValid = 1;
    MainTest_f();
    Deinit();
    Resp_Init();
   
    Loop_Add_Time +=5; 
    if(@AUTO::APP_Invalid == 1)
      break;
  }
  @Faultinsert::TC_BT_AppValid = 0;
  writeEx(-3,1,"/*---------------------停止测试---------------------*/");
}
/*验证是否在BT中擦除APP有效位3——进入BT后错误密钥后上下电*/
testcase BT_AppValid3()
{
  char comment[70];
  MainInit();
  Loop_Add_Times = 0;
  Loop_Add_Time =0;
  @Faultinsert::TC_BT_AppValid = 1;
  @Faultinsert::TC_Error_27Key = 0;
  @Faultinsert::TC_Error_27 = 0;
  /*判断当前是否APP有效*/
  curAppValid = Check_AppValid();
  while(@Test::Loop_Test_Switch && ( Loop_Add_Times < @Test::Loop_Power_Times) )
  {
    writeEx(-3,1,"/*---------------------第%d次测试,等待时间为：%dms---------------------*/",++Loop_Add_Times,Loop_Add_Time);
    snprintf(comment,elCount(comment),"第%d次测试,等待时间为：%dms",Loop_Add_Times,Loop_Add_Time);
    testCaseComment(comment);
    
    Pre_Programme_For_AppValidTest();
    if(Loop_Add_Times % 2 == 0)
    {
      @Faultinsert::TC_Error_27Key = 1;
      @Faultinsert::TC_Error_27 = 1;
    }
    
    if(@AUTO::Security_Switch == 2)
    {
      Security_access_AES_CMAC();
    }
    else
      Security_access();
    if(Loop_Add_Time > 0)
    {
      testWaitForTimeout(Loop_Add_Time);
      writeEx(-3,1,"等待：%dms",Loop_Add_Time);
    }
    _K15_OFF();
    testWaitForTimeout(2000);
    _K15_ON();
    testWaitForTimeout(2000);
    writeEx(-3,1,"等待：2s");
    
    Check_APPValid2();
    
    @Faultinsert::TC_Miss_GetFc = 0;
    @Faultinsert::TC_Error_27Key = 0;
    @Faultinsert::TC_Error_27 = 0;
    Loop_Add_Time +=5; 
    testWaitForTimeout(100);
    
    if(@AUTO::APP_Invalid == 1)
      break;
  }
  @Faultinsert::TC_Miss_GetFc = 0;
  @Faultinsert::TC_BT_AppValid = 0;
  @Faultinsert::TC_Error_27 = 0;
  @Faultinsert::TC_Error_27Key = 0;
  writeEx(-3,1,"/*---------------------停止测试---------------------*/");
  
}

/*验证是否在BT中擦除APP有效位4——进入BT后11复位上下电*/
testcase BT_AppValid4()
{
  char comment[70];
  MainInit();
  Loop_Add_Times = 0;
  Loop_Add_Time =0;
  Restart_Time = 1;
  @Faultinsert::TC_BT_AppValid = 1;
  /*判断当前是否APP有效*/
  curAppValid = Check_AppValid();
  while(@Test::Loop_Test_Switch && ( Loop_Add_Times < @Test::Loop_Power_Times) )
  {
    writeEx(-3,1,"/*---------------------第%d次测试,等待时间为：%dms---------------------*/",++Loop_Add_Times,Loop_Add_Time);
    snprintf(comment,elCount(comment),"第%d次测试,等待时间为：%dms",Loop_Add_Times,Loop_Add_Time);
    testCaseComment(comment);
    

    Pre_Programme_For_AppValidTest();
    testWaitForTimeout(1000);
    if(Loop_Add_Times > 0)
      @Faultinsert::TC_Miss_GetFc = 1;
    _Startreset(phyID,0x01,-1);
    if(Loop_Add_Time > 0)
    {
      testWaitForTimeout(Loop_Add_Time);
      writeEx(-3,1,"等待：%dms",Loop_Add_Time);
    }
    _K15_OFF();
    testWaitForTimeout(2000);
    _K15_ON();
    testWaitForTimeout(2000);
    writeEx(-3,1,"等待：2s");
    @Faultinsert::TC_Miss_GetFc = 0;
    Check_APPValid2();
    

    Loop_Add_Time +=5; 
    testWaitForTimeout(100);
    if(@AUTO::APP_Invalid == 1)
      break;
  }
  @Faultinsert::TC_Miss_GetFc = 0;
  @Faultinsert::TC_BT_AppValid = 0;
  writeEx(-3,1,"/*---------------------停止测试---------------------*/");
  
}

