/*APP无效-过低压刷写-6V*/
testcase APPInvalid_Volt_1()
{
  MainInit();
  @AUTO::APP_Valid = 1;
  MainTest_f();
  Resp_Init();
  @Faultinsert::TC_ErrorVolt = 1; //低压
  MainTest_f();
  @Faultinsert::TC_ErrorVolt = 0;
  Check_Tx(TxMessage_Fail);
  Resp_Init();
  @Prog_power::K30Volt = Normal_Volt;
  testWaitForTimeout(Volt_Time);
  MainTest_f();
  Deinit();
  Check_Tx(TxMessage_Pass);
}
