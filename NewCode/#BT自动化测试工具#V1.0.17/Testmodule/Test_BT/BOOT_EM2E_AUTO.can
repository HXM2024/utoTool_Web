  Resp_2702_2 = -1;    //第二次请求27 02时的期望响应，默认为-1
  Resp_34_f = -1;      //Flash请求34时的期望响应，默认为-1
  Resp_34_a = -1;      //App请求34时的期望响应，默认为-1
  Resp_36_f = -1;      //Flash请求36时的期望响应，默认为-1
  Resp_36_a = -1;      //App请求36时的期望响应，默认为-1
  Resp_37_f = -1;      //Flash请求37时的期望响应，默认为-1
  Resp_37_a = -1;      //App请求37时的期望响应，默认为-1
  Resp_0301 = -1;      //Geely3.0 激活SBL的期望响应，默认为-1
  Resp_0205 = -1;      //Geely3.0 完全性检测的期望响应，默认为-1
  Resp_0202_f = -1;    //Flash下载驱动请求31 01 02 02时的期望响应，默认为-1
  Resp_0202_a = -1;    //App下载数据请求31 01 02 02时的期望响应，默认为-1
  Resp_ff00 = -1;      //请求31 01 FF 00时的期望响应，默认为-1
  Resp_03ff00 = -1;    //请求31 03 FF 00时的期望响应，默认为-1
  Resp_02ff00 = -1;    //请求31 02 FF 00时的期望响应，默认为-1
  Resp_ff01 = -1;      //请求31 01 FF 01时的期望响应，默认为-1
  Resp_DA04 = -1;      //请求31 01 DA 04时的期望响应，默认为-1
  Resp_11 = -1;        //请求11 01时的期望响应，默认为-1
  
  Geely3_36_Status = -1;       /*用于判断36下载是否完成状态，异常下载为0，正常下载为1*/
  TxMessage_Pass = 1;  //期望收到外发报文
  TxMessage_Fail = 0;  //期望无外发报文
  @AUTO::APP_Valid = 0; 
  PostProg_Recover = 0;   /*是否需要在后编程恢复故障,不需要为0，需要为1*/
  
  @Prog_power::K30 = 1;
  @Prog_power::K30Volt = Normal_Volt;     //电压恢复正常值
  
  diagStopTesterPresent("ABS_ESP_Functional");
  testWaitForTimeout(waittime);
  if(@AUTO::Config_Switch == 4)
    _Startreset(phyID,0x01,Resp_11);
}

