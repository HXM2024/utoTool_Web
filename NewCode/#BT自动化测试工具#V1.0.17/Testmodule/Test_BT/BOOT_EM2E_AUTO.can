      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==2 || @AUTO::Config_Switch==3)//ChangAn || Geely1.0
    {
      @Prog_power::K30Volt = 17;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x92;
      Resp_37_a = 0x22;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==6)//瑞驰
    {
      @Prog_power::K30Volt = 17;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x92;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==5)//鑫源
    {
      @Prog_power::K30Volt = 18;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x92;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==8)//五菱
    {
      @Prog_power::K30Volt = 18;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x92;
      Resp_37_a = 0x22;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    if(@AUTO::EraseMode_Switch==3)//  || @AUTO::Config_Switch == 12
      _Send36_App1(addr,data36,length);
    else
      _Send36_App(addr,data36,length);
  }
  else
  {
    if(@AUTO::EraseMode_Switch==3 ) //广汽刷写段连续 || @AUTO::Config_Switch == 12
      _Send36_App1(addr,data36,length);
    else
      _Send36_App(addr,data36,length);
  }
  
  //故障注入：APP数据传输后功能寻址复位
  if(@Faultinsert::TC_Restart_after_36_A==1)
  {
    _Startreset(funID,0x01,Resp_11);
    Resp_36_a = 0x7F;
    Resp_37_a = 0x7F;
    Exit_37_a = 1;
    if(@AUTO::Config_Switch == 3)
      Resp_36_a = 0x7F;
  }
  //故障注入：APP数据传输后功能寻址切换默认会话
  else if(@Faultinsert::TC_DefaultSession_after_36_A==1)
  {
    enterDefault(funID,0,Resp_1001);
    Resp_36_a = 0x7F;
    Resp_37_a = 0x7F;
    Exit_37_a = 1;
  }
  //故障注入：APP数据传输完后发送 FF 01
  else if(@Faultinsert::TC_FF01_After_36A==1)
  {
    /*FF 01的响应 0:正响应 1:负响应*/
    if(Unnormal_FF01==1)
    {
      Resp_ff01 = 0x22;
    }
    else
    {
      PassState_31[0] = 0x01;
    }
    Exit_36_a = 1;
    _SendFF01(phyID,Resp_ff01);
  }
  /*可靠性测试：数据块传输完切断电源*/
  if(TC_PowerDown_After_36A==1)
  {
    _K30_OFF();
    testWaitForTimeout(10000);
    Exit_36_a = 1;
    _K30_ON();
  }
  /*可靠性测试：数据块传输完下点火*/
  if(TC_K15_After_36A==1)
  {
    _K15_OFF();
    testWaitForTimeout(10000);
    Exit_36_a = 1;
    _K15_ON();
  }
  /*可靠性测试：数据块传输完BusOff*/
  if(TC_BusOff_After_36A==1)
  {
    testWaitForTesterConfirmation("请制造BufOff故障",10000);
    testWaitForTimeout(10000);
    Exit_36_a = 1;
    testWaitForTesterConfirmation("请恢复故障",10000);
    return;
  }
}
/*合并地址段流式36发送:逐段加载+跨段连续块号36发送+CRC增量累积。
  仅MergeAddr_Switch==1时使用;data36仅缓存单段(0x10000)。
  调用前提:首段已由_loadpage装入data36,length34=首段长度,addr=首段地址,
  datanow指向下一条记录(04/05/01)。mergedTotal=eraselength[openhex][eraseadd]*/
void _App_36_merge(dword openhex,dword eraseadd,dword mergedTotal,dword firstSegLen,byte datanow[],dword& addr)
{
  diagRequest ABS_ESP.Download_Transmit req36;
  dword segLen;
  dword relOff;
  dword remain;
  word i;

  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试36服务APP数据传输(合并流式)",stepnum);
  
  stream_blockcnt = 1;                          /*块计数器跨段连续,每个合并块重置*/
  crc16[eraseadd] = 0xFFFF;                     /*本块CRC16初值*/
  calcrc32 = 0xFFFFFFFF;                        /*CRC32累加初值*/
  segLen = firstSegLen;                         /*首段长度(由调用者传入,避免全局length34被局部变量遮蔽)*/

  /*故障注入:缺失步骤App 36数据传输*/
  if(@Faultinsert::TC_Miss_36_A==1)
  {
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5
    || @AUTO::Config_Switch==8 || @AUTO::Config_Switch==10)
    {
      Resp_37_a = 0x24; Resp_0202_a = 0x22; Exit_36_a = 0; Exit_0202_a = 1; Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==2)
    {
      Resp_37_a = 0x22; Exit_36_a = 0; Exit_37_a = 1; Break_Download = 1;
    }
    else
    {
      Resp_37_a = 0x24; Exit_36_a = 0; Exit_37_a = 1; Break_Download = 1;
    }
    return;
  }
  /*故障注入:低压下载APP*/
  else if(@Faultinsert::TC_LowVolt_36_A==1)
  {
    @Prog_power::K30Volt = 8;
    testWaitForTimeout(Volt_Time);
    Resp_36_a = 0x93; Resp_37_a = 0x24; Resp_0202_a = 0x22; Resp_ff01 = 0x22; Exit_ff01 = 1; Break_Download = 1;
  }
  /*故障注入:高压下载APP*/
  else if(@Faultinsert::TC_HighVolt_36_A==1)
  {
    @Prog_power::K30Volt = 17;
    testWaitForTimeout(Volt_Time);
    Resp_36_a = 0x92; Resp_37_a = 0x24; Resp_0202_a = 0x22; Resp_ff01 = 0x22; Exit_ff01 = 1; Break_Download = 1;
  }
  
  /*逐段加载+发送+CRC累积*/
  while(1)
  {
    /*故障注入:APP 36下载的数据错误(按段填充0xFF)*/
    if(@Faultinsert::TC_Error_36_A==1)
    {
      for(i=0;i<segLen;i++)
        data36[i] = 0xFF;
      PassState_31[0] = 0x01;
      Exit_0202_a = 1;
    }
    
    /*本段36数据发送:块号跨段连续,数据偏移段内相对*/
    relOff = 0;
    for(; ; stream_blockcnt++)
    {
      if((@Faultinsert::TC_LowVolt_36_A==1 || @Faultinsert::TC_HighVolt_36_A==1) && stream_blockcnt != 1)
        Resp_36_a = 0x24;
      
      remain = segLen - relOff;
      if(remain < Blocksize_36)
      {
        if(remain != 0)
        {
          _Senddata_merge(req36,remain,stream_blockcnt,data36,relOff,phyID,Resp_36_a);
          stream_blockcnt++;
        }
        break;
      }
      _Senddata_merge(req36,Blocksize_36,stream_blockcnt,data36,relOff,phyID,Resp_36_a);
      relOff += Blocksize_36;
      if(Exit_36_a == 1)
      {
        calcrc32 = calcrc32 ^ 0xFFFFFFFF;
        return;
      }
    }
    
    /*CRC累积(按段增量计算)*/
    crc16[eraseadd] = _caculateCrc16(crc16[eraseadd],data36,segLen);
    calcrc16 = _caculateCrc16(calcrc16,data36,segLen);
    calcrc32 = _caculateCrc32_1(calcrc32,data36,segLen);
    
    /*判断合并块内是否还有连续段*/
    if(datanow[3] != 4 || @AUTO::MergeAddr_Switch != 1)
      break;
    {
      dword nextaddr;
      nextaddr = ((dword)(((word)datanow[4]<<8)|datanow[5]))<<16;
      if(nextaddr >= eraseaddr[openhex][eraseadd] + eraselength[openhex][eraseadd])
        break;
    }

    /*加载下一段:解析04记录地址,读取首条00,重填data36*/
    {
      word addrh;
      addrh = ((word)datanow[4]<<8)|datanow[5];
      addr = (dword)addrh << 16;
    }
    _readhex(datanow);                         /*获取首条00记录*/
    _loadpage(data36,datanow,addr,segLen);      /*重填data36为下一段数据*/
  }
  
  calcrc32 = calcrc32 ^ 0xFFFFFFFF;
  
  /*故障注入:APP数据传输后功能寻址复位*/
  if(@Faultinsert::TC_Restart_after_36_A==1)
  {
    _Startreset(funID,0x01,Resp_11);
    Resp_36_a = 0x7F; Resp_37_a = 0x7F; Exit_37_a = 1;
  }
}
//App数据块下载
//参数addr:驱动内存地址;  data36:数据内容;   length:驱动内存大小;
void _Send36_App(dword addr,byte data36[],dword length)
{ 
  diagRequest ABS_ESP.Download_Transmit req36;
  dword countcnt;
  dword continue_cnt;
  dword remain;
  dword Re_Time;
  byte j=0;
  
  Re_Time = 0;
  for(countcnt=1;countcnt<=0xFFFF;countcnt++)
  {
    if((@Faultinsert::TC_LowVolt_36_A==1 || @Faultinsert::TC_HighVolt_36_A==1) && countcnt != 1)
    {
      Resp_36_a = 0x24;
    }
    remain=length-Blocksize_36*(countcnt-1);
    if(remain<Blocksize_36)
    {
      if(remain!=0)
      {
        _Senddata(req36,remain,countcnt,data36,phyID,Resp_36_a);
        countcnt++;
      }
      //故障注入：36下载完成后继续发送一个数据块
      if(@Faultinsert::TC_Continue_36_A==1)
      {
        END_Pos = 1;
        //奇瑞
        if(@AUTO::Config_Switch==7 || @AUTO::Config_Switch==11)
        {
          Resp_36_a = 0x24;
          Exit_36_a = 1;
        }
        //五菱
        else if(@AUTO::Config_Switch==8)
        {
          Resp_36_a = 0x24;
          Resp_37_a = 0x24;
          Exit_37_a = 1;
        }
        else
        {
          Resp_36_a = 0x31;
          Exit_36_a = 1;
        }

        _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
        return;
      }
      break;
    }
    //故障注入：数据块大小变动
    if(@Faultinsert::TC_BlockSize==1)
    {
      Blocksize_36 = @Test::Block_Size - 2;
      //36数据块大于最大长度
      if(@Test::Block_Size>DataLengthmax_34)
      {
        if(@AUTO::Config_Switch==1)//BYD
        {
          //CAN刷写时不响应
          if(@AUTO::CANFD_Switch==0)
          {
            Resp_36_a = 0;
            Exit_36_a = 1;
          }
        }
        else 
          Exit_36_a = 1;
        _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
        break;
//        return;
      }
      else
        _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
    }
    //故障注入：第一个数据块编号不为1
    else if(@Faultinsert::TC_FirstBlockNum_A==1)
    {
      countcnt = @Test::FirstBlock_Num;
      Resp_36_a = 0x73;
      _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
      Exit_36_a = 1;
      return;
    }
    //故障注入：数据块编号不连贯
    else if(@Faultinsert::TC_ErrorBlockNum_A==1 && countcnt==@Test::Block_Loc)
    {
      //不同主机厂，刷写规范不同
      //BYD
      if(@AUTO::Config_Switch==1)
      {
        countcnt = @Test::Block_Num;
        Resp_36_a = 0x73;
        _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
        Exit_36_a = 1;
        return;
      }
      //CA || Geely 1.0 || 鑫源 || 瑞驰 || 奇瑞 || 五菱 || 赛力斯
      else
      {
        if(@Test::Block_Num==@Test::Block_Loc - 1)
        {
          countcnt = @Test::Block_Num;
          _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
          @Faultinsert::TC_ErrorBlockNum_A = 0;
        }
        else
        {
          countcnt = @Test::Block_Num;
          Resp_36_a = 0x73;
          _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
          Exit_36_a = 1;
          return;
        }
      }
    }
    //故障注入：连续重复发送相同编号数据块
    else if(@Faultinsert::TC_Re_BlockNum_A==1 && countcnt==@Test::Block_Num)
    {
      dword temp_count;
      Re_Time++;
      writeEx(-3,1,"第%d次重复发送36第%d块数据块",Re_Time,@Test::Block_Num);
      //当前重复次数大于最大重复次数
      if(Re_Time > ReBlocknum_max)
      {
        if(@AUTO::Config_Switch != 8)
          Resp_36_a = 0x71;
      }
      temp_count = @Test::Block_Num;
      _Senddata(req36,Blocksize_36,temp_count,data36,phyID,Resp_36_a);
      if(Re_Time < @Test::Re_BlockTime)
        countcnt--;
//        countcnt = @Test::Block_Num;
      //当前重复次数达到预期重复次数
      else if(Re_Time == @Test::Re_BlockTime)
      {
        //预期重复次数大于最大重复次数
        if(@Test::Re_BlockTime > ReBlocknum_max)
        {
          Exit_36_a = 1;
          return;
        }
        //预期重复次数小于最大重复次数
        else
          @Faultinsert::TC_Re_BlockNum_A = 0;
      }
    }
    else
      _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_a);
    
    if(Continueaddr[0][eraseadd] == 1 && @AUTO::Config_Switch == 9)
    {
      ContinueBlocCount = countcnt;
    }
    
    //故障注入：App 36传输数据时，电压故障
    if(@Faultinsert::TC_LowVolt_36_A == 1 || @Faultinsert::TC_HighVolt_36_A == 1)
    {
      @Prog_power::K30Volt = Normal_Volt;
      testWaitForTimeout(Volt_Time);
      @Faultinsert::TC_LowVolt_36_A == 0;
      @Faultinsert::TC_HighVolt_36_A == 0;
    }
    //故障注入：App 36数据传输中直接37退出
    if(@Faultinsert::TC_Exit_in_36_A==1)
    {
      //BYD || 五菱
      if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==8)
      {
        Resp_37_a = 0x24;
        Resp_0202_a = 0x22;
        Exit_0202_a = 1;
      }
      //CA
      else if(@AUTO::Config_Switch==2)
      {
        Resp_37_a = 0x22;
        Resp_ff01 = 0x22;
        Break_Download = 1;
        Exit_0202_a = 1;
      }
      //Geely1.0 || 瑞驰
      else if(@AUTO::Config_Switch==3 || @AUTO::Config_Switch==6)
      {
        Resp_37_a = 0x24;
        Resp_0202_a = 0x22;
        Resp_ff01 = 0x22;
        Break_Download = 1;
        Exit_ff01 = 1;
      }
      //奇瑞
      else if(@AUTO::Config_Switch==7)
      {
        Resp_37_a = 0x24;
        Exit_37_a = 1;
      }
      //东风小康
      else if(@AUTO::Config_Switch==9)
      {
        _SendFF01(phyID,0x22);
        Exit_36_a = 1;
      }
      return;
    }
    //故障注入：App 36数据传输中直接34请求
    if(@Faultinsert::TC_34_in_36_A==1)
    {
      Resp_34_a = 0x22;
      App_34(addr,length34);
      Exit_36_a = 1;
      return;
    }
    //故障注入：App 36数据未传输完发送FF 01
    if(@Faultinsert::TC_FF01_in_36A==1)
    {
      /*FF 01的响应 0:正响应 1:负响应*/
      if(Unnormal_FF01==1)
      {
        Resp_ff01 = 0x22;
      }
      else
      {
        PassState_31[0] = 0x01;
      }
      Exit_36_a = 1;
      _SendFF01(phyID,Resp_ff01);
      return;
    }
    /*可靠性测试：数据块传输中切断电源*/
    if(TC_PowerDown_In_36A==1)
    {
      _K30_OFF();
      testWaitForTimeout(10000);
      Exit_36_a = 1;
      _K30_ON();
      return;
    }
    /*可靠性测试：数据块传输中下点火*/
    if(TC_K15_In_36A==1)
    {
      _K15_OFF();
      testWaitForTimeout(10000);
      Exit_36_a = 1;
      _K15_ON();
      return;
    }
    /*可靠性测试：数据块传输中BusOff*/
    if(TC_BusOff_In_36A==1)
    {
      testWaitForTesterConfirmation("请制造BufOff故障",10000);
      testWaitForTimeout(10000);
      Exit_36_a = 1;
      testWaitForTesterConfirmation("请恢复故障",10000);
      return;
    }
  }
  //传输完成后，恢复电压
  if(@Faultinsert::TC_LowVolt_36_A==1 || @Faultinsert::TC_HighVolt_36_A==1)
  {
    @Prog_power::K30Volt = Normal_Volt;
    testWaitForTimeout(Volt_Time);
    @Faultinsert::TC_LowVolt_36_A == 0;
    @Faultinsert::TC_HighVolt_36_A == 0;
  }
}
//用于擦除方式3中App数据下载,块编号不会重置
//参数addr:驱动内存地址;  data36:数据内容;   length:驱动内存大小;
void _Send36_App1(dword addr,byte data36[],dword length)
{
  diagRequest ABS_ESP.Download_Transmit req36;
  dword remain;
  byte j=0;
  dword Re_Time;
  Re_Time = 0;
  countcnt2 = 1;
  
  for(countcnt1;countcnt1<=0xFFFF;countcnt1++)
  {
    remain=length-Blocksize_36*(countcnt2-1);
    if((@Faultinsert::TC_LowVolt_36_A==1 || @Faultinsert::TC_HighVolt_36_A==1) && countcnt1 != 1)
    {
      Resp_36_a = 0x24;
    }
    if(remain<=Blocksize_36)
    {
      if(remain!=0)
      {
        _Senddata1(req36,remain,countcnt1,data36,phyID,Resp_36_a);
        countcnt1++;
      }
      //故障注入：36下载完成后继续发送一个数据块
      if(@Faultinsert::TC_Continue_36_A==1 && END_Pos == 1)
      {
//        countcnt1++;
        //奇瑞
        if(@AUTO::Config_Switch==7 || @AUTO::Config_Switch==11)
        {
          Resp_36_a = 0x24;
          Exit_36_a = 1;
        }
        //五菱
        else if(@AUTO::Config_Switch==8)
        {
          Resp_36_a = 0x24;
          Resp_37_a = 0x24;
          Exit_37_a = 1;
        }
        else
        {
          Resp_36_a = 0x31;
          Exit_36_a = 1;
        }
        writeEx(-3,1,"36下载完成后继续发送一个数据块, remain = %d",remain);
        _Senddata1(req36,remain,countcnt1,data36,phyID,Resp_36_a);
        return;
      }
      break;
    }
    //故障注入：数据块大小变动
    if(@Faultinsert::TC_BlockSize==1)
    {
      Blocksize_36 = @Test::Block_Size;
      //36数据块大于最大长度
      if(@Test::Block_Size>DataLengthmax_34)
      {
        if(@AUTO::Config_Switch==1)//BYD
        {
          //CAN刷写时不响应
          if(@AUTO::CANFD_Switch==0)
          {
            Resp_36_a = 0;
            Exit_36_a = 1;
          }
        }
        else
        {
          Exit_36_a = 1;
        }
        _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
        return;
      }
      else
        _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
    }
    //故障注入：第一个数据块编号不为1
    else if(@Faultinsert::TC_FirstBlockNum_A==1)
    {
      countcnt1 = @Test::FirstBlock_Num;
      Resp_36_a = 0x73;
      _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
      Exit_36_a = 1;
      return;
    }
    //故障注入：数据块编号不连贯
    else if(@Faultinsert::TC_ErrorBlockNum_A==1 && countcnt1==@Test::Block_Loc)
    {
      //不同主机厂，刷写规范不同
      if(@AUTO::Config_Switch==1)//BYD
      {
        countcnt1 = @Test::Block_Num;
        Resp_36_a = 0x73;
        _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
        Exit_36_a = 1;
        return;
      }
      //CA || Geely 1.0 || 鑫源 || 瑞驰 || 奇瑞 || 五菱 || 奇瑞5.0
      else if(@AUTO::Config_Switch==2 || @AUTO::Config_Switch==3 || @AUTO::Config_Switch==5
           || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==7 || @AUTO::Config_Switch==8
           || @AUTO::Config_Switch==11)
      {
        if(@Test::Block_Num==@Test::Block_Loc - 1)
        {
          countcnt1 = @Test::Block_Num;
          countcnt2 = @Test::Block_Num;
          _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
          @Faultinsert::TC_ErrorBlockNum_A = 0;
        }
        else
        {
          countcnt1 = @Test::Block_Num;
          countcnt2 = @Test::Block_Num;
          Resp_36_a = 0x73;
          if(@AUTO::Config_Switch==11)
            Resp_36_a = 0x71;
          _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
          Exit_36_a = 1;
          return;
        }
      }
    }
    //故障注入：连续发送相同编号数据块
    else if(@Faultinsert::TC_Re_BlockNum_A==1 && countcnt1==@Test::Block_Num)
    {
      Re_Time++;
      //当前重复次数大于最大重复次数
      if(Re_Time > ReBlocknum_max)
      {
        if(@AUTO::Config_Switch != 8)
          Resp_36_a = 0x71;
      }
      countcnt1 = @Test::Block_Num;
      countcnt2 = @Test::Block_Num;
      writeEx(-3,1,"/*----------第%d次重复发送第%d块数据块----------*/",Re_Time,@Test::Block_Num);
      _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
      if(Re_Time < @Test::Re_BlockTime)
      {
        countcnt1--;
        countcnt2--;
      }
      //当前重复次数达到预期重复次数
      else if(Re_Time == @Test::Re_BlockTime)
      {
        //预期重复次数大于最大重复次数
        if(@Test::Re_BlockTime > ReBlocknum_max)
        {
          Exit_36_a = 1;
          return;
        }
        //预期重复次数小于最大重复次数
        else
        {
          @Faultinsert::TC_Re_BlockNum_A = 0;
        }
      }
    }
    else
    {
      _Senddata1(req36,Blocksize_36,countcnt1,data36,phyID,Resp_36_a);
    }
    countcnt2++;
    
    //故障注入：App 36传输数据时，电压故障
    if(@Faultinsert::TC_LowVolt_36_A == 1 || @Faultinsert::TC_HighVolt_36_A == 1)
    {
      break;
    }
    //故障注入：App 36数据传输中直接37退出
    if(@Faultinsert::TC_Exit_in_36_A==1)
    {
      //BYD || 五菱
      if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==8)
      {
        Resp_37_a = 0x24;
        Resp_0202_a = 0x22;
        Exit_0202_a = 1;
      }
      //CA
      else if(@AUTO::Config_Switch==2)
      {
        Resp_37_a = 0x22;
        Resp_ff01 = 0x22;
        Break_Download = 1;
        Exit_0202_a = 1;
      }
      //Geely1.0 || 瑞驰
      else if(@AUTO::Config_Switch==3 || @AUTO::Config_Switch==6)
      {
        Resp_37_a = 0x24;
        Resp_0202_a = 0x22;
        Resp_ff01 = 0x22;
        Break_Download = 1;
        Exit_ff01 = 1;
      }
      //奇瑞
      else if(@AUTO::Config_Switch==7 || @AUTO::Config_Switch==11)
      {
        Resp_37_a = 0x24;
        Exit_37_a = 1;
        Break_Download = 1;
      }
      //东风小康
      else if(@AUTO::Config_Switch==9)
      {
        _SendFF01(phyID,0x22);
        Exit_36_a = 1;
      }
      return;
    }
    //故障注入：App 36数据传输中直接34请求
    if(@Faultinsert::TC_34_in_36_A==1)
    {
      Resp_34_a = 0x22;
      App_34(addr,length34);
      Exit_36_a = 1;
      return;
    }
    //故障注入：App 36数据未传输完发送FF 01
    if(@Faultinsert::TC_FF01_in_36A==1)
    {
      /*FF 01的响应 0:正响应 1:负响应*/
      if(Unnormal_FF01==1)
      {
        Resp_ff01 = 0x22;
      }
      else
      {
        PassState_31[0] = 0x01;
      }
      Exit_36_a = 1;
      _SendFF01(phyID,Resp_ff01);
      return;
    }
    /*可靠性测试：数据块传输中切断电源*/
    if(TC_PowerDown_In_36A==1)
    {
      _K30_OFF();
      testWaitForTimeout(10000);
      Exit_36_a = 1;
      _K30_ON();
      return;
    }
    /*可靠性测试：数据块传输中下点火*/
    if(TC_K15_In_36A==1)
    {
      _K15_OFF();
      testWaitForTimeout(10000);
      Exit_36_a = 1;
      _K15_ON();
      return;
    }
    /*可靠性测试：数据块传输中BusOff*/
    if(TC_BusOff_In_36A==1)
    {
      testWaitForTesterConfirmation("请制造BufOff故障",10000);
      testWaitForTimeout(10000);
      Exit_36_a = 1;
      testWaitForTesterConfirmation("请恢复故障",10000);
      return;
    }
  }
  //传输完成后，恢复电压
  if(@Faultinsert::TC_LowVolt_36_A==1 || @Faultinsert::TC_HighVolt_36_A==1)
  {
    @Prog_power::K30Volt = Normal_Volt;
    testWaitForTimeout(Volt_Time);
  }
}

/// <Geely3.0>
//Geely3.0 36传输App
void _Send36_App(struct Block hexBlock,dword cnt36,byte state)
{
  qword remain,isLastLine;
  byte dataBuffer_error[10];
  dword i;
  
  i = 0;
  cnt36 = countcnt3;
  Geely3_36_Status = 0;
  //故障注入：36数据块大小调整
  if(@Faultinsert::TC_BlockSize==1)
  {
    Blocksize_36 = @Test::Block_Size;
    //数据块大小 > 允许传输最大值
    if(Blocksize_36 > DataLengthmax_34 - 2)
    {
      Exit_36_a = 1;
    }
  }
  if(state==0)
  {
    for(i=0;i<=hexBlock.BlockDataLength;i+=Blocksize_36)
    {
      remain = hexBlock.BlockDataLength - i;
      cnt36 = (cnt36 + 1) & 0xFF;
//      countcnt3 = cnt36;
      //判断是否全部传输完
      if(i > Blocksize_36 && Exit_36_a == 1)
      {
        Break_Download = 1; //发送两次后直接退出，防止后续持续等待1s报文响应而报文数据过大导致异常
        return;
      }
      if(remain <= Blocksize_36)
      {
//        _SendData_app(hexBlock.dataBuffer,hexBlock.BlockDataLength,remain,cnt36,Resp_36_a);
          _SendData_app(hexBlock.dataBuffer,i,remain,cnt36,Resp_36_a);
        //故障注入：APP 36服务传输的数据多传输一块
        if(@Faultinsert::TC_Continue_36_A==1 && AddrNum == HexBlockTotalNumber_app)
        {
          cnt36 = (cnt36 + 1) & 0xFF;
          Resp_36_a = 0x31;
          _SendData_app(hexBlock.dataBuffer,i,remain,cnt36,Resp_36_a);
          Resp_36_a = -1;
        }
        break;
      }
      if(@Faultinsert::TC_LowVolt_36_A==1 && i != 1)
      {
        Resp_36_a = 0x24;
      }
      //故障注入：首次发送36 00
      if(@Faultinsert::TC_FirstBlockNum_A==1)
      {
        cnt36 -= 1;
        Resp_36_a = 0x73;
        _SendData_app(hexBlock.dataBuffer,i,Blocksize_36,cnt36,Resp_36_a);
        Exit_36_a = 1;
        return;
      }
      //故障注入：36数据块编号不连贯
      else if(@Faultinsert::TC_ErrorBlockNum_A==1 && cnt36==@Test::Block_Loc)
      {
        cnt36 = @Test::Block_Num;
        i = @Test::Block_Num - 1;
        if(@Test::Block_Num == @Test::Block_Loc - 1)
        {
          _SendData_app(hexBlock.dataBuffer,i,Blocksize_36,cnt36,Resp_36_a);
          @Faultinsert::TC_ErrorBlockNum_A = 0;
          countcnt3 = countcnt3-1;  //重复发送后内部countcnt3计数会多累加一次，重新进入后会导致前面的负载错误
        }
        else
        {
          Resp_36_a = 0x73;
          _SendData_app(hexBlock.dataBuffer,i,Blocksize_36,cnt36,Resp_36_a);
          Exit_36_a = 1;
          return;
        }
      }
      else
      {
        if(@Faultinsert::TC_Error_36_A==1)
        {
          PassState_31[0] = 0x10;
          PassState_31[1] = 0x04;
          
          if(@AUTO::Geely3_Config == 1) //P162
          {
             PassState_31[0] = 0x10;
             PassState_31[1] = 0;
          }
          _SendData_app(dataBuffer_error,i,Blocksize_36,cnt36,Resp_36_a);
        }
        /*36 01时传输错误数据*/
        else if(@Faultinsert::TC_Error_3601==1 && cnt36==1)
        {
          PassState_31[0] = 0x10;
          PassState_31[1] = 0x04;
          if(@AUTO::Geely3_Config == 1)
          {
            PassState_31[0] = 0x10;
            PassState_31[1] = 0x00;
          }
          _SendData_app(dataBuffer_error,i,Blocksize_36,cnt36,Resp_36_a);
        }
        else
          _SendData_app(hexBlock.dataBuffer,i,Blocksize_36,cnt36,Resp_36_a);
      }
      //故障注入：36传输过程中直接37退出
      if(@Faultinsert::TC_Exit_in_36_A==1)
      {
        Resp_37_a = 0x24;
//        Resp_0202_a = 0x24;
        PassState_31[1] = 0x06;
        Exit_0202_a = 1;
        if(@sysvar::AUTO::Geely3_Config == 1) //P162
          Resp_0202_a = 0x24;
        return;
      }
      isLastLine = i;
    }
  }
  else if(state==1 && Exit_36_a == 0)
  {
    for(i=0;i<=hexBlock.BlockVbtDataLength;i+=Blocksize_36)
    {
      cnt36 = (cnt36 + 1) & 0xFF;
      remain = hexBlock.BlockVbtDataLength - i;
      //判断是否传输完成
      if(remain <= Blocksize_36)
      {
        _SendData_app(hexBlock.dataVbtBuffer,i,remain,cnt36,Resp_36_a);

        //故障注入：APP 36服务传输的数据多传输一块
        if(@Faultinsert::TC_Continue_36_A==1)
        {
          cnt36 = (cnt36 + 1) & 0xFF;
          Resp_36_a = 0x31;
          _SendData_app(hexBlock.dataBuffer,i,remain,cnt36,Resp_36_a);
          Resp_36_a = -1;
        }
        break;
      }
      _SendData_app(hexBlock.dataVbtBuffer,i,Blocksize_36,cnt36,Resp_36_a);
      isLastLine = i;
    }
  }
  Geely3_36_Status = 1;
  remain = 0;
  isLastLine = 0;
}

/*[流式改造-2026-09]_Send36_App 的流式版本:数据按页从 bin 文件读取,不再依赖整段 dataBuffer。
  故障注入逻辑与原 _Send36_App(struct Block,...) 一致;差异:TC_ErrorBlockNum_A 重发时文件不可回退,
  改用当前页 buffer 重发,块编号不连贯的测试目的仍可满足。仅实现 state==0(APP 数据),广汽 bin 无 Vbt。*/
void _Send36_App_stream(dword fileHandle,dword blockDataLength,dword cnt36,byte state)
{
  qword remain,isLastLine;
  byte dataBuffer_error[10];
  dword i,pageSize,readLen,Re_Time;
  int Pass_CRC;
  
  i = 0;
  Re_Time = 0;Pass_CRC = 0;
  cnt36 = countcnt3;
  Geely3_36_Status = 0;
  //故障注入：36数据块大小调整
  if(@Faultinsert::TC_BlockSize==1)
  {
    Blocksize_36 = @Test::Block_Size;
    if(Blocksize_36 > DataLengthmax_34 - 2)
      Exit_36_a = 1;
  }
  if(state==0)
  {
    for(i=0;i<=blockDataLength;i+=Blocksize_36)
    {
      remain = blockDataLength - i;
      cnt36 = (cnt36 + 1) & 0xFF;
      if(i > Blocksize_36 && Exit_36_a == 1)
      {
        Break_Download = 1;
        return;
      }
      if(remain <= Blocksize_36)
      {
        //最后一页:按剩余长度读取并发送
        pageSize = remain;
        readLen = BinFile_ReadPage(fileHandle,hexfile_app[0].dataBuffer,pageSize);
        /*0000开关:Padding_Zero=0关闭填充时,文件实际数据不足,按实际读取长度发送并累加CRC;
          =1开启填充时,数据不足部分自动补0按声明长度发送(原行为)*/
        if(@AUTO::Padding_Zero == 0)
        {
          if(readLen < pageSize)
            pageSize = readLen;
          if(pageSize == 0)
            break;
        }
        _SendData_app(hexfile_app[0].dataBuffer,0,pageSize,cnt36,Resp_36_a);
        if(@Faultinsert::TC_Continue_36_A==1 && AddrNum == HexBlockTotalNumber_app)
        {
          cnt36 = (cnt36 + 1) & 0xFF;
          Resp_36_a = 0x31;
          _SendData_app(hexfile_app[0].dataBuffer,0,pageSize,cnt36,Resp_36_a);
          Resp_36_a = -1;
        }
        calcrc32 = _caculateCrc32_1(calcrc32,hexfile_app[0].dataBuffer,pageSize);
        break;
      }
      if(@Faultinsert::TC_LowVolt_36_A==1 && i != 1)
        Resp_36_a = 0x24;
      //按页从文件流式读取到单页缓冲
      if((@Faultinsert::TC_ErrorBlockNum_A==1 && cnt36==@Test::Block_Loc) || (@Faultinsert::TC_Re_BlockNum_A==1 && cnt36 ==@Test::Block_Num && Re_Time != 0))
      {
        Pass_CRC = 1;
        //跳过读取
        if(GAC_3601_03 == 1)//针对36 01后发送36 03情况，做两次读取进行跳过02数据块
        {
          readLen = BinFile_ReadPage(fileHandle,hexfile_app[0].dataBuffer,Blocksize_36);
          readLen = BinFile_ReadPage(fileHandle,hexfile_app[0].dataBuffer,Blocksize_36);
        }
        if(GAC_3602_01 == 1)//针对36 02后发送36 01情况
        {
          int Temp;
          BinFile_CloseStream(1);
          Temp = BinFile_OpenStream(1);
          readLen = BinFile_ReadPage(fileHandle,hexfile_app[0].dataBuffer,Blocksize_36);
        }
      }
      else
      {
        Pass_CRC = 0;
        readLen = BinFile_ReadPage(fileHandle,hexfile_app[0].dataBuffer,Blocksize_36);
      }
      /*0000开关:Padding_Zero=0关闭填充时,文件实际数据不足,按实际读取长度发送并结束,不再补0*/
      if(@AUTO::Padding_Zero == 0 && readLen < Blocksize_36)
      {
        if(readLen > 0)
        {
          _SendData_app(hexfile_app[0].dataBuffer,0,readLen,cnt36,Resp_36_a);
          calcrc32 = _caculateCrc32_1(calcrc32,hexfile_app[0].dataBuffer,readLen);
        }
        break;
      }
      //故障注入：首次发送36 00
      if(@Faultinsert::TC_FirstBlockNum_A==1)
      {
        cnt36 -= 1;
        Resp_36_a = 0x73;
        _SendData_app(hexfile_app[0].dataBuffer,0,Blocksize_36,cnt36,Resp_36_a);
        Exit_36_a = 1;
        return;
      }
      //故障注入：36数据块编号不连贯
      else if(@Faultinsert::TC_ErrorBlockNum_A==1 && cnt36==@Test::Block_Loc)
      {
        cnt36 = @Test::Block_Num;
        i = @Test::Block_Num - 1;
        if(@Test::Block_Num == @Test::Block_Loc - 1)
        {
          _SendData_app(hexfile_app[0].dataBuffer,0,Blocksize_36,cnt36,Resp_36_a);
          @Faultinsert::TC_ErrorBlockNum_A = 0;
          countcnt3 = countcnt3-1;
        }
        else
        {
          Resp_36_a = 0x73;
          _SendData_app(hexfile_app[0].dataBuffer,0,Blocksize_36,cnt36,Resp_36_a);
          Exit_36_a = 1;
          return;
        }
      }//故障注入：连续重复发送相同编号数据块
      else if(@Faultinsert::TC_Re_BlockNum_A==1 && cnt36 ==@Test::Block_Num)
      {
        dword temp_count;
        i = @Test::Block_Num - 1;
        Re_Time++;
        writeEx(-3,1,"第%d次重复发送36第%d块数据块",Re_Time,@Test::Block_Num);
        //当前重复次数大于最大重复次数
        if(Re_Time > ReBlocknum_max)
          Resp_36_a = 0x71;
        temp_count = @Test::Block_Num;
        _SendData_app(hexfile_app[0].dataBuffer,0,Blocksize_36,temp_count,Resp_36_a);
        
        if(Re_Time < @Test::Re_BlockTime)
          cnt36--;
        //当前重复次数达到预期重复次数
        else if(Re_Time == @Test::Re_BlockTime)
        {
          //预期重复次数大于最大重复次数
          if(@Test::Re_BlockTime > ReBlocknum_max)
          {
            Exit_36_a = 1;
            return;
          }
          //预期重复次数小于最大重复次数
          else
            @Faultinsert::TC_Re_BlockNum_A = 0;
        }
      }
      else
      {
        if(@Faultinsert::TC_Error_36_A==1)
        {
          PassState_31[0] = 0x10;
          PassState_31[1] = 0x04;
          if(@AUTO::Geely3_Config == 1)
          {
            PassState_31[0] = 0x10;
            PassState_31[1] = 0;
          }
          _SendData_app(dataBuffer_error,0,Blocksize_36,cnt36,Resp_36_a);
        }
        else if(@Faultinsert::TC_Error_3601==1 && cnt36==1)
        {
          PassState_31[0] = 0x10;
          PassState_31[1] = 0x04;
          if(@AUTO::Geely3_Config == 1)
          {
            PassState_31[0] = 0x10;
            PassState_31[1] = 0x00;
          }
          _SendData_app(dataBuffer_error,0,Blocksize_36,cnt36,Resp_36_a);
        }
        else
          _SendData_app(hexfile_app[0].dataBuffer,0,Blocksize_36,cnt36,Resp_36_a);
      }
      //逐页累加 CRC32(替代原整段一次性计算)
      if(Pass_CRC == 1)
      {
        //跳过读取时同步跳过校验
      }
      else
        calcrc32 = _caculateCrc32_1(calcrc32,hexfile_app[0].dataBuffer,Blocksize_36);
      //故障注入：36传输过程中直接37退出
      if(@Faultinsert::TC_Exit_in_36_A==1)
      {
        Resp_37_a = 0x24;
        PassState_31[1] = 0x06;
        Exit_0202_a = 1;
        if(@sysvar::AUTO::Geely3_Config == 1)
          Resp_0202_a = 0x24;
        return;
      }
      isLastLine = i;
    }
  }
  Geely3_36_Status = 1;
  remain = 0;
  isLastLine = 0;
}

void _SendData_app(byte dataBuffer[],qword endPos,qword length,dword cnt,int Passcondition)
{
  diagRequest ABS_ESP.Download_Transmit req36;
  qword sendPos;
  diagResize(req36,length+2);
  DiagSetPrimitiveByte(req36,1,cnt & 0xFF);
//  if(AddrNum < HexBlockTotalNumber_app)
//    if(hexfile_app[AddrNum + 1].BlockDataLength > (Blocksize_36 - length))
//    {
//      diagResize(req36,Blocksize_36 + 2);  
//    }
  for(sendPos=endPos;sendPos<endPos+length;sendPos++)
  {
    if(sendPos>=elCount(dataBuffer))
      DiagSetPrimitiveByte(req36,sendPos-endPos+2,0);
    else
      DiagSetPrimitiveByte(req36,sendPos-endPos+2,dataBuffer[sendPos]);
  }
  countcnt3++;
  _diagSendMsg(phyID,req36);
  _get_FC(req36,phyID,stepid,Passcondition);
}

//数据下载
//参数req36:服务请求;
//参数length:下载数据时每个块的数据长度最大值
//参数count:数据块的编号
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Senddata(diagRequest* req36,word length,word count,byte data[],dword msgID,int Passcondition)
{
  word i;
  byte cnt;
  char comment[30];
  cnt=(byte)count;
  
  diagResize(req36,length+2);
  DiagSetPrimitiveByte(req36,1,cnt);
  //故障注入：36传输首个数据块编号不为1
  if(count==0)
    count = 1;
  //故障注入：36下载完成后继续发送一个数据块
  if((@Faultinsert::TC_Continue_36_A==1||@Faultinsert::TC_Continue_36_F==1) && END_Pos == 1)
  {
    count--;
    END_Pos--;
  }
  for(i=0;i<length;i++)
  {
    DiagSetPrimitiveByte(req36,i+2,data[Blocksize_36*(count-1)+i]);
  }
  _diagSendMsg(msgID,req36);
  //故障注入：36下载数据过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_36_A==1 && Down_f_a == 1 && count !=1)
  {
    _handshake(funID);
    Down_f_a = -1;
  }
  _get_FC(req36,phyID,stepid,Passcondition);
}
/*合并地址段流式36发送:_Senddata的合并版,使用显式offset索引data36,
  解耦块号(绝对,跨段连续)与数据偏移(段内相对),使data36仅缓存单段数据*/
void _Senddata_merge(diagRequest* req36,word length,word count,byte data[],dword offset,dword msgID,int Passcondition)
{
  word i;
  byte cnt;
  char comment[30];
  cnt=(byte)count;
  diagResize(req36,length+2);
  DiagSetPrimitiveByte(req36,1,cnt);
  if(count==0)
    count = 1;
  for(i=0;i<length;i++)
  {
    DiagSetPrimitiveByte(req36,i+2,data[offset+i]);
  }
  _diagSendMsg(msgID,req36);
  if(@Faultinsert::TC_Handshake_in_36_A==1 && Down_f_a == 1 && count !=1)
  {
    _handshake(funID);
    Down_f_a = -1;
  }
  _get_FC(req36,phyID,stepid,Passcondition);
}
//参数req36:服务请求;
//参数length:下载数据时每个块的数据长度最大值
//参数count:数据块的编号
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Senddata1(diagRequest* req36,word length,word count,byte data[],dword msgID,int Passcondition)
{
  word i;
  byte cnt;
  char comment[30];
  cnt=(byte)count;
  diagResize(req36,length+2);
  DiagSetPrimitiveByte(req36,1,cnt);
  //故障注入：36传输首个数据块编号不为1
  if(count==0)
  {
    countcnt2 = 1;
  }
  //故障注入：36下载完成后继续发送一个数据块
  if(@Faultinsert::TC_Continue_36_A==1 && END_Pos > 0 && ((length34-Blocksize_36*(countcnt2-1)) <= Blocksize_36))
  {
//    if(END_Pos == 1)
////      countcnt2 = 1;
    END_Pos--;
  }
//  writeEx(-3,0,"Blocksize_36 = %X  countcnt2 = %d  count = %d",Blocksize_36,countcnt2,count);
  for(i=0;i<length;i++)
  {
    DiagSetPrimitiveByte(req36,i+2,data[Blocksize_36*(countcnt2-1)+i]);
  }
  _diagSendMsg(msgID,req36);
  //故障注入：36下载数据过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_36_A==1 && Down_f_a == 1 && count !=1)
  {
    _handshake(funID);
    Down_f_a = -1;
  }
  _get_FC(req36,phyID,stepid,Passcondition);
}
//SBT 36传输数据
//参数dataBuffer:数据数组;
//参数endPos:传输数据的起始地址
//参数length:数据块的长度
//参数cnt:数据块编号
void _SendData_SBT(byte dataBuffer[],qword startPos,qword length,word cnt)
{
  diagRequest ABS_ESP.Download_Transmit req36;
  qword sendPos;
  
  diagResize(req36,length+2);
  DiagSetPrimitiveByte(req36,1,cnt & 0xFF);
  
  for(sendPos=startPos;sendPos<startPos+length;sendPos++)
  {
//    DiagSetPrimitiveByte(req36,sendPos-endPos+2,dataBuffer[sendPos-length]); //原来
    if(sendPos>=elCount(dataBuffer))
      DiagSetPrimitiveByte(req36,sendPos-startPos+2,0);
    else
      DiagSetPrimitiveByte(req36,sendPos-startPos+2,dataBuffer[sendPos]);//修复后
  }
  _diagSendMsg(phyID,req36);
  _get_FC(req36,phyID,stepid,Resp_36_f);
}

//SBT 37退出传输服务
void SBT_37(int State)
{
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d",stepnum);
  testStep(stepid,"开始测试SBT 37退出数据传输");
  
  //故障注入：步骤缺失Flash 37请求
  if(@Faultinsert::TC_Miss_37_F==1 && State == 1)
  {
//    Resp_34_f = 0x70;
//    Exit_34_f = 1;
    return;
  }
  else
    _Send37(phyID,Resp_37_f);
}

//驱动下载完成后退出
void FlashDriver_37()
{
  diagRequest ABS_ESP.Download_Stop req37;
  dword crc32;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试37服务Flash退出下载",stepnum);
 
  //故障注入：步骤缺失Flash 37请求
  if(@Faultinsert::TC_Miss_37_F==1)
  {
    //奇瑞
    if(@AUTO::Config_Switch==7)
    {
      Resp_ff00 = 0x72;
      Exit_37_f = 0;
      Exit_ff00 = 1;
    }
    else
    {
      Resp_0202_f = 0x22;
      Exit_37_f = 0;
      Exit_0202_f = 1;
    }
  }
  //东风小康,CRC32校验值在37发送
  else if(@AUTO::Config_Switch==9)
  {
    diagResize(req37,5);
    crc32=_caculateCrc32(Z65H,elCount(Z65H));
    crc32 = crc32^0xFFFFFFFF;
    //故障注入：Flash 37的CRC校验错误
    if(@Faultinsert::TC_Error_0202_F==1)
    {
      crc32 = crc32^0x00000000;
      PassState_31[0] = 0x01;
      Resp_ff00 = 0x22;
      Exit_ff00 = 1;
    }
    DiagSetPrimitiveByte(req37,1,crc32 >> 24 & 0xFF);
    DiagSetPrimitiveByte(req37,2,crc32 >> 16 & 0xFF);
    DiagSetPrimitiveByte(req37,3,crc32 >> 8 & 0xFF);
    DiagSetPrimitiveByte(req37,4,crc32 & 0xFF);
    
    _diagSendMsg(phyID,req37);
    _get_FC(req37,phyID,stepid,Resp_37_f);
  }
  else
    _Send37(phyID,Resp_37_f);
  //故障注入：小康 不执行Flash 0202和整个APP下载流程
  if(@Faultinsert::TC_37F_FF01==1)
  {
    _SendFF01(phyID,0x22);
    Exit_37_f = 1;
  }
}
//App数据下载完成后退出
void App_37()
{
  diagRequest ABS_ESP.Download_Stop req37;
  dword crc32;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试37服务APP退出下载",stepnum);
  
  //故障注入：步骤缺失App 37请求
  if(@Faultinsert::TC_Miss_37_A==1)
  {
    //Geely3.0
    if(@AUTO::Config_Switch==4)
    {
      PassState_31[1] = 0x06;
      Exit_0202_a = 1;
      Exit_37_a = 0;
      Break_Download = 1;
      if(@AUTO::Geely3_Config == 1)
      {
        Resp_34_a = 0x70;
        Resp_36_a = 0x31;
        Resp_0202_a = 0x24;
      }
    }
    //奇瑞
    else if(@AUTO::Config_Switch==7)
    {
      //34、36、37全部缺失
      if(@Faultinsert::TC_Miss_34_A==1 && @Faultinsert::TC_Miss_36_A==1)
      {
        Resp_ff01 = 0x22;
        Exit_ff01 = 1;
        Exit_37_a = 0;
        Break_Download = 1;
      }
      else
      {
        Resp_34_a = 0x22;
        Exit_34_a = 1;
        Exit_37_a = 0;
      }
    }
    //东风小康
    else if(@AUTO::Config_Switch==9)
    {
      Resp_ff01 = 0x22;
      Resp_14 = 0x11;
      Exit_ff01 = 1;
      Exit_37_a = 0;
      Break_Download = 1;
    }
    //BYD || ChangAn || Geely1.0 || 鑫源 || 瑞驰 || 五菱 || 赛力斯
    else
    {
      Resp_0202_a = 0x22;
      Exit_0202_a = 1;
      Exit_37_a = 0;
      Break_Download = 1;
    }
    return;
  }
  //故障注入：请求37时报文数据过长
  else if(@Faultinsert::TC_ErrorLength_37_A==1)
  {
    diagResize(req37,0x03);
    Resp_37_a = 0x13;
    Exit_37_a = 1;
//    _SendAndWriteReport(req37,phyID);
//    _TestResult(req37,stepid,Resp_37_a);
    _diagSendMsg(phyID,req37);
    _get_FC(req37,phyID,stepid,Resp_37_a);
    Resp_37_a = 0x22;
  }
  
  //东风小康 37发送 CRC校验值
  if(@AUTO::Config_Switch==9)
  {
    diagResize(req37,5);
//    crc32=_caculateCrc32(data36,length34);
//    crc32 = crc32^0xFFFFFFFF;
    crc32 = calcrc32;
//    write("crc32 = %x",crc32);
    DiagSetPrimitiveByte(req37,1,crc32 >> 24 & 0xFF);
    DiagSetPrimitiveByte(req37,2,crc32 >> 16 & 0xFF);
    DiagSetPrimitiveByte(req37,3,crc32 >> 8 & 0xFF);
    DiagSetPrimitiveByte(req37,4,crc32 & 0xFF);
    
    _diagSendMsg(phyID,req37);
    _get_FC(req37,phyID,stepid,Resp_37_f);
  }
  else
    _Send37(phyID,Resp_37_a);
}
//退出下载
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send37(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Download_Stop req37;
  
  _diagSendMsg(msgID,req37);
//  writeEx(-3,1,"检测37响应是否为NRC:%x",Passcondition);
  _get_FC(req37,phyID,stepid,Passcondition);
}
//FlashDriver 数据校验
void FlashDriver_0202()
{
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试31服务Flash完整性校验",stepnum);
  //不同驱动
  if(@AUTO::FlashDriver_Switch==1)//J80J3_F
  {
    _Send0202_f(J80J3_F,elCount(J80J3_F),phyID,Resp_0202_f);
  }
  else if(@AUTO::FlashDriver_Switch==2)//J80J3-A
  {
    _Send0202_f(J80J3_A,elCount(J80J3_A),phyID,Resp_0202_f);
  }
  else if(@AUTO::FlashDriver_Switch==3)//J80J3-B
  {
    _Send0202_f(J80J3_B,elCount(J80J3_B),phyID,Resp_0202_f);
  }
  else if(@AUTO::FlashDriver_Switch==4)//Z65-H
  {
    _Send0202_f(Z65H,elCount(Z65H),phyID,Resp_0202_f);
  }
}

//SBT 31 01 02 12签名校验
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数FileNum:{0:驱动,1:APP1,2:APP2,3:APP3,4:APP4}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send0212_F(dword msgID,int FileNum,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0212;
  word toInt[256];
  dword i;
  i = 0;
  //设置报文属性
  diagResize(req0212,0x104);
  DiagSetPrimitiveByte(req0212,0,0x31);
  DiagSetPrimitiveByte(req0212,1,0x01);
  DiagSetPrimitiveByte(req0212,2,0x02);
  DiagSetPrimitiveByte(req0212,3,0x12);
  digitalSignature(toInt,FileNum);
  
  /*故障注入：SBT 0212错误的签名校验*/
  if(@Faultinsert::TC_Error_0202_F==1)
  {
    PassState_31[1] = 0x01;
    Resp_0301 = 0x22;
    Exit_0301 = 1;
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,i);
    }
  }
  else
  {
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,toInt[i-4]);
    }
  }
  
  /*故障注入：SBT 0212过程中中功能寻址握手*/
  if(@Faultinsert::TC_Handshake_in_0202F==1)
  {
    _diagSendMsg(msgID,req0212);
//    testWaitForMessage(msgID,1000);
    testWaitForDiagRequestSent(req0212,1000);
    _handshake(funID);
    _get_FC(req0212,msgID,stepid,Passcondition);
  }
  /*故障注入：SBT 0212后物理寻址复位11 01*/
  else if(@Faultinsert::TC_Restart_after_0202F==1)
  {
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    _Startreset(phyID,0x01,Resp_11);
    Resp_0301 = 0x31;
    Exit_0301 = 1;
  }
  /*故障注入：SBT 0212后功能寻址切换默认会话10 01*/
  else if(@Faultinsert::TC_DefaultSession_after_0202F==1)
  {
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    Resp_0301 = 0x31;
    Exit_0301 = 1;
  }
  /*故障注入：步骤缺失 SBT 0212签名校验*/
  else if(@Faultinsert::TC_Miss_0202_F==1)
  {
    Resp_0301 = 0x22;
    Exit_0301 = 1;
    return;
  }
  /*故障注入：SBT 0212第一次发送错误签名，第二次发送正确签名*/
  else if(@Faultinsert::TC_FirstError_0202F==1)
  {
    /*第一次发送错误签名*/
    PassState_31[1] = 0x01;
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,i);
    }
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    testWaitForTimeout(100);
    /*第二次发送正确签名*/
    PassState_31[1] = 0x00;
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,toInt[i-4]);
    }
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    Exit_0202_f = 1;
  }
  else
  {
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
  }
}
//APP 31 01 02 12签名校验
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数FileNum:{0:驱动,1:APP1,2:APP2,3:APP3,4:APP4}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send0212_A(dword msgID,int FileNum,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0212;
  word toInt[256];
  dword i;
  i = 0;
  //设置报文属性
  diagResize(req0212,0x104);
  DiagSetPrimitiveByte(req0212,0,0x31);
  DiagSetPrimitiveByte(req0212,1,0x01);
  DiagSetPrimitiveByte(req0212,2,0x02);
  DiagSetPrimitiveByte(req0212,3,0x12);
  digitalSignature(toInt,FileNum);
  
  //故障注入：步骤缺失 APP 02 12签名校验
  if(@Faultinsert::TC_Miss_0202_A==1)
  {
    PassState_31[1] = 0x41;
    Exit_0205 = 1;
    if(@AUTO::Geely3_Config == 1)
    {
      Resp_ff00 = 0x24;
      Resp_34_a = 0x70;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
    }
    return;
  }
  //故障注入：APP 02 12错误校验发送无效签名
  if(@Faultinsert::TC_Error_0202_A==1)
  {
    PassState_31[1] = 0x01;
    Resp_0205 = 0x22;
    Exit_0205 = 1;
    Resp_ff00 = 0x24;
    Resp_34_a = 0x70;
    Resp_36_a = 0x24;
    Resp_37_a = 0x24;
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,i);
    }
  }
  else
  {
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,toInt[i-4]);
    }
  }
  
  //故障注入：APP 02 12校验过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_0202A==1)
  {
    _diagSendMsg(msgID,req0212);
    testWaitForDiagRequestSent(req0212,1000);
    _handshake(funID);
    _get_FC(req0212,msgID,stepid,Passcondition);
    testWaitForTimeout(4000);
  }
  //故障注入：APP 02 12校验后物理寻址复位11 01
  else if(@Faultinsert::TC_Restart_after_0202A==1)
  {
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    _Startreset(phyID,0x01,Resp_11);
    Resp_ff00 = 0x31;//7F;
    Exit_ff00 = 1;
  }
  //故障注入：APP 02 12校验后功能寻址切换默认会话
  else if(@Faultinsert::TC_DefaultSession_after_0202A==1)
  {
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    Resp_ff00 = 0x31; //0x7F
    Exit_ff00 = 1;
  }
  //故障注入：连续请求两次APP 02 12
  else if(@Faultinsert::TC_Re_0202A==1)
  {
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    Passcondition = 0x22;
    if(@AUTO::Config_Switch==4 && @AUTO::Geely3_Config == 1) //P162
    {
      Passcondition = 0x24;
    }
    testWaitForTimeout(100);
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
  }
  //故障注入：第一次发送错误签名，第二次发送正确签名
  else if(@Faultinsert::TC_FirstError_0202A==1)
  {
    /*第一次发送错误签名*/
    PassState_31[1] = 0x01;
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,i);
    }
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    testWaitForTimeout(100);
    /*第二次发送正确签名*/
    PassState_31[1] = 0x00;
    for(i=4;i<0x104;i++)
    {
      DiagSetPrimitiveByte(req0212,i,toInt[i-4]);
    }
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
    Exit_0202_a = 1;
  }
//  else if((@Faultinsert::TC_ErrorDataFormatId_App==1 || @Faultinsert::TC_ErrorAddrAndLenId_App==1 || @Faultinsert::TC_ErrorAddrSize_App == 1 || @Faultinsert::TC_ErrorAddr_App ==1 || Geely3_36_Status == 0) && @AUTO::Config_Switch==4) //同时存在NRC24以及正响应06结果情况下均通过
//  {
//    _diagSendMsg(msgID,req0212);
//    testWaitForDiagResponse(req0212,p2cmax);
//    if(diagGetLastResponseCode(req0212) == 0 || diagGetLastResponseCode(req0212) == 0x78)
//      testWaitForDiagResponse(req0212,1000);
//    if(diagGetLastResponseCode(req0212) == 0)
//      testStepFail("","未收到应答");
//    else if(diagGetLastResponseCode(req0212) == 0x24)
//      testStepPass("","31 01 02 12收到反馈与期望一致");
//    else if(diagGetLastResponseCode(req0212) == -1)
//    {
//      if(DiagGetRespPrimitiveByte(req0212,5) == PassState_31[1])
//        testStepPass("","31 01 02 12收到反馈与期望一致");
//      else
//        testStepFail("","31 01 02 12收到反馈与期望不符");
//    }
//    else
//      testStepFail("","31 01 02 12收到反馈与期望不符");
//  }
  else
  {
    _diagSendMsg(msgID,req0212);
    _get_FC(req0212,msgID,stepid,Passcondition);
  }
}

//下载Flash驱动后校验
//参数data36:下载的数据数组及需要校验的值
//参数length34:下载数据的数组长度
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send0202_f(byte data36[],dword length34,dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0202;
  diagRequest ABS_ESP.hardReset_Reset req1101;
  diagRequest ABS_ESP.DefaultSession_Start req1001;
  dword crc32;
  int i;
  
  //计算CRC32校验值
  crc32=_caculateCrc32(data36,length34);
  crc32 = crc32^0xFFFFFFFF;
  //设置诊断字节
  diagResize(req0202,8);
  DiagSetPrimitiveByte(req0202,0,0x31);
  DiagSetPrimitiveByte(req0202,1,0x01);
  DiagSetPrimitiveByte(req0202,2,0x02);
  DiagSetPrimitiveByte(req0202,3,0x02);
  DiagSetPrimitiveByte(req0202,4,crc32 >> 24);
  DiagSetPrimitiveByte(req0202,5,crc32 >> 16 & 0xFF);
  DiagSetPrimitiveByte(req0202,6,crc32 >> 8 & 0xFF);
  DiagSetPrimitiveByte(req0202,7,crc32 & 0xFF);
  
  //不同主机厂，规范不同
  //CA
  if(@AUTO::Config_Switch==2)
  {
    DiagSetPrimitiveByte(req0202,4,DriverAddr >> 24);
    DiagSetPrimitiveByte(req0202,5,DriverAddr >> 16 & 0xFF);
    DiagSetPrimitiveByte(req0202,6,DriverAddr >> 8 & 0xFF);
    DiagSetPrimitiveByte(req0202,7,DriverAddr & 0xFF);
  }
  //鑫源 31 01 02 01
  if(@AUTO::Config_Switch==5)
  {
    DiagSetPrimitiveByte(req0202,3,0x01);
  }
  //瑞驰 31 01 F0 01
  if(@AUTO::Config_Switch==6)
  {
    DiagSetPrimitiveByte(req0202,2,0xF0);
    DiagSetPrimitiveByte(req0202,3,0x01);
  }
  //五菱 31 01 DF FF
  if(@AUTO::Config_Switch==8)
  {
    DiagSetPrimitiveByte(req0202,2,0xDF);
    DiagSetPrimitiveByte(req0202,3,0xFF);
  }
  //东风小康 / V8  31 01 02 02
  if(@AUTO::Config_Switch==9 || @AUTO::Config_Switch==13)
  {
    diagResize(req0202,4);
  }
  //赛力斯 31 01 DD 02
  if(@AUTO::Config_Switch==10)
  {
    diagResize(req0202,4);
    DiagSetPrimitiveByte(req0202,2,0xDD);
    DiagSetPrimitiveByte(req0202,3,0x02);
  }
  //奇瑞 T1V 31 01 DD 02
  if(@AUTO::Config_Switch==11)
  {
    int i;
    diagResize(req0202,0x184);
    DiagSetPrimitiveByte(req0202,2,0xDD);
    DiagSetPrimitiveByte(req0202,3,0x02);
    for(i=0;i<RSALen;i++)
      DiagSetPrimitiveByte(req0202,i+4,RSAData[i]);
  }
  //故障注入：驱动校验CRC错误
  if(@Faultinsert::TC_Error_0202_F==1)
  {
    DiagSetPrimitiveByte(req0202,4,0xFF);
    DiagSetPrimitiveByte(req0202,5,0xFF);
    DiagSetPrimitiveByte(req0202,6,0xFF);
    DiagSetPrimitiveByte(req0202,7,0xFF);
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==8  )//BYD || 瑞驰 || 五菱 
    {
      PassState_31[0] = 0x01;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==2)//ChangAn
    {
      Passcondition = 0x31;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==3)//Geely1.0
    {
      PassState_31[0] = 0x05;
    }
    else if(@AUTO::Config_Switch==5)//鑫源
    {
      PassState_31[0] = 0x05;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==11)//奇瑞T1V
    {
      for(i=4;i<RSALen;i++)
        DiagSetPrimitiveByte(req0202,i,0);
      PassState_31[0] = 0x06;
      Exit_0202_f = 1;
    }
    else //默认
    {
      PassState_31[0] = 0x01;
      Exit_0202_f = 1;
    }
    _diagSendMsg(msgID,req0202);
    testWaitForDiagRequestSent(req0202,1000);
    testWaitForDiagResponse(req0202,p2cmax);
    _TestResult(req0202,"0202",Passcondition);
  }
  //故障注入：驱动校验过程中功能寻址握手
  else if(@Faultinsert::TC_Handshake_in_0202F)
  {
    _diagSendMsg(msgID,req0202);
    testWaitForDiagRequestSent(req0202,1000);
    _handshake(funID);
    _get_FC(req0202,msgID,"0202",Passcondition);
    testWaitForTimeout(4000);
  }
  //故障注入：驱动校验后功能寻址复位11 01
  else if(@Faultinsert::TC_Restart_after_0202F)
  {
    _diagSendMsg(msgID,req0202);
    testWaitForDiagRequestSent(req0202,1000);
    testWaitForDiagResponse(req0202,p2cmax);
    _TestResult(req0202,"0202",Passcondition);
    if(@AUTO::Config_Switch==1)//BYD
    {
      _Startreset(phyID,0x01,Resp_11);
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
    else if(@AUTO::Config_Switch==2)//ChangAn
    {
      _Startreset(funID,0x03,Resp_11);
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
    else if(@AUTO::Config_Switch==5)//鑫源
    {
      _Startreset(funID,0x01,Resp_11);
      Resp_2E = 0x7F;
      Exit_2E = 1;
    }
    //Geely 1.0 || 瑞驰 || 五菱 || 赛力斯
    else
    {
      _Startreset(funID,0x01,Resp_11);
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
    return;
  }
  //故障注入：驱动校验后功能寻址默认会话10 01
  else if(@Faultinsert::TC_DefaultSession_after_0202F)
  { 
    _diagSendMsg(msgID,req0202);
    testWaitForDiagRequestSent(req0202,1000);
    testWaitForDiagResponse(req0202,p2cmax);
    _TestResult(req0202,"0202",Passcondition);
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    if(@AUTO::Config_Switch==5)//鑫源
    {
      Resp_2E = 0x7F;
      Exit_2E = 1;
    }
    else
    {
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
    return;
  }
  //故障注入：缺失步骤Flash 0202 CRC校验
  else if(@Faultinsert::TC_Miss_0202_F==1)
  {
    Resp_ff00 = 0x22;
    Exit_0202_f = 0;
    Exit_ff00 = 1;
    return;
  }
  else
  {
    _diagSendMsg(msgID,req0202);
    _get_FC(req0202,msgID,"0202",Passcondition);
  }
}

//下载App数据后校验
//参数data36:下载的数据数组及需要校验的值
//参数length34:下载数据的数组长度
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send0202_a(byte data36[],dword length34,dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0202;
  diagRequest ABS_ESP.hardReset_Reset req1101;
  diagRequest ABS_ESP.DefaultSession_Start req1001;
  dword crc32;
  int i;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试31服务APP完整性校验",stepnum);
  
  /*可靠性测试：0202检查前切断电源*/
  if(TC_PowerDown_Before_0202A==1)
  {
    _K30_OFF();
    testWaitForTimeout(10000);
    Exit_0202_a = 1;
    _K30_ON();
    return;
  }
  /*可靠性测试：0202检查前下点火*/
  if(TC_K15_Before_0202A==1)
  {
    _K15_OFF();
    testWaitForTimeout(10000);
    Exit_0202_a = 1;
    _K15_ON();
    return;
  }
  /*可靠性测试：0202检查前BusOff*/
  if(TC_BusOff_Before_0202A==1)
  {
    testWaitForTesterConfirmation("请制造BufOff故障",10000);
    testWaitForTimeout(10000);
    Exit_0202_a = 1;
    testWaitForTesterConfirmation("请恢复故障",10000);
    return;
  }
 
  //计算CRC32校验值、不同擦除方式的0202校验值不同
  if((@AUTO::EraseMode_Switch == 1 || @AUTO::EraseMode_Switch == 4) && @AUTO::MergeAddr_Switch != 1)
  {
    if(@AUTO::Config_Switch != 12)
      crc32 = _caculateCrc32(data36,length34);
    crc32 = crc32^0xFFFFFFFF;
  }
  else
  {
    /*合并块:data36仅缓存单段,使用_App_36_merge中增量累积的calcrc32*/
    crc32 = calcrc32^0xFFFFFFFF;
  }
  //设置诊断字节
  diagResize(req0202,8);
  DiagSetPrimitiveByte(req0202,0,0x31);
  DiagSetPrimitiveByte(req0202,1,0x01);
  DiagSetPrimitiveByte(req0202,2,0x02);
  DiagSetPrimitiveByte(req0202,3,0x02);
  DiagSetPrimitiveByte(req0202,4,crc32 >> 24);
  DiagSetPrimitiveByte(req0202,5,crc32 >> 16 & 0xFF);
  DiagSetPrimitiveByte(req0202,6,crc32 >> 8 & 0xFF);
  DiagSetPrimitiveByte(req0202,7,crc32 & 0xFF);
  
  //不同主机厂，诊断字节不一样
  //鑫源APP数据校验 31 01 02 01
  if(@AUTO::Config_Switch==5)
  {
    DiagSetPrimitiveByte(req0202,3,0x01);
  }
  //瑞驰APP数据校验 31 01 F0 01
  if(@AUTO::Config_Switch==6)
  {
    DiagSetPrimitiveByte(req0202,2,0xF0);
    DiagSetPrimitiveByte(req0202,3,0x01);
  }
  //五菱APP数据校验 31 01 DF FF
  if(@AUTO::Config_Switch==8)
  {
    DiagSetPrimitiveByte(req0202,2,0xDF);
    DiagSetPrimitiveByte(req0202,3,0xFF);
  }
  //东风小康APP数据校验 31 01 02 02
  if(@AUTO::Config_Switch==9 || @AUTO::Config_Switch==13 )
  {
    diagResize(req0202,4);
  }
  //赛力斯APP数据校验 31 01 DD 02
  if(@AUTO::Config_Switch==10)
  {
    diagResize(req0202,4);
    DiagSetPrimitiveByte(req0202,2,0xDD);
    DiagSetPrimitiveByte(req0202,3,0x02);
  }
  //奇瑞T1V APP数据校验 31 01 DD 02
  if(@AUTO::Config_Switch==11)
  {
    diagResize(req0202,0x184);
    DiagSetPrimitiveByte(req0202,2,0xDD);
    DiagSetPrimitiveByte(req0202,3,0x02);
    for(i=0;i<RSALen;i++)
      DiagSetPrimitiveByte(req0202,i+4,RSAData[i]);
    /*-------------------------------------*/
  }
  //故障注入：APP完整性CRC校验值错误
  if(@Faultinsert::TC_Error_0202_A==1)
  {
    DiagSetPrimitiveByte(req0202,4,0x00);
    DiagSetPrimitiveByte(req0202,5,0x00);
    DiagSetPrimitiveByte(req0202,6,0x00);
    DiagSetPrimitiveByte(req0202,7,0x00);
    //Geely 1.0
    if(@AUTO::Config_Switch==3)
    {
      PassState_31[0] = 0x05;
      Exit_0202_a = 1;
    }
    //瑞驰
    else if(@AUTO::Config_Switch==6)
    {
      PassState_31[0] = 0x01;
      Exit_0202_a = 1;
    }
    //鑫源
    else if(@AUTO::Config_Switch==5)
    {
      PassState_31[0] = 0x05;
      Resp_ff00 = 0x22;
      Exit_ff00 = 1;
    }
    //奇瑞T1V
    else if(@AUTO::Config_Switch==11)
    {
      for(i=4;i<RSALen+4;i++)
        DiagSetPrimitiveByte(req0202,i,0);
      PassState_31[0] = 0x05;
      Resp_ff00 = 0x22;
      Exit_ff00 = 1;
    }
    else
    {
      //不同的擦除方式，后续步骤不同
      if(@AUTO::EraseMode_Switch == 1 || @AUTO::EraseMode_Switch == 4)
      {
        Resp_ff00 = 0x22;
        Exit_ff00 = 1;
      }
      else
      {
        Resp_ff01 = 0x22;
        Exit_ff01 = 1;
      }
    }
  }
  //故障注入：数据校验过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_0202A == 1)
  {
    _diagSendMsg(msgID,req0202);
//    testWaitForMessage(msgID,1000);
    testWaitForDiagRequestSent(req0202,1);
    _handshake(funID);
    _get_FC(req0202,msgID,"stepid",Passcondition);
    testWaitForTimeout(4000);
//    @Faultinsert::TC_Handshake_in_0202A = 0;
  }
  //故障注入：数据校验后功能寻址复位11 01
  else if(@Faultinsert::TC_Restart_after_0202A)
  {
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5 
    || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==10)//BYD || 鑫源 || 瑞驰 || 赛力斯
    {
      _diagSendMsg(msgID,req0202);
      testWaitForDiagRequestSent(req0202,1000);
//      testWaitForDiagResponse(req0202,p2cmax);
//      _TestResult(req0202,"stepid",Passcondition);
      _get_FC(req0202,msgID,"stepid",Passcondition);
      _Startreset(phyID,0x01,Resp_11);
      if(@AUTO::EraseMode_Switch==1)
      {
        Resp_ff00 = 0x7F;
        Exit_ff00 = 1;
      }
      /*选择了多个HEX文件*/
      else if(hexFlage[0]+hexFlage[1]+hexFlage[2] != 2)
      {
        Resp_ff00 = 0x7F;
        Exit_ff00 = 1;
      }
      else
      {
        Resp_ff01 = 0x7F;
        Exit_ff01 = 1;
      }
      return;
    }
    //Geely 1.0
    else
    {
      _diagSendMsg(msgID,req0202);
      testWaitForDiagRequestSent(req0202,1000);
//      testWaitForDiagResponse(req0202,p2cmax);
//      _TestResult(req0202,"stepid",Passcondition);
      _get_FC(req0202,msgID,"stepid",Passcondition);
      _Startreset(funID,0x01,Resp_11);
      if(@AUTO::EraseMode_Switch==1)
      {
        Resp_ff00 = 0x7F;
        Exit_ff00 = 1;
      }
      /*选择了多个HEX文件*/
      else if(hexFlage[0]+hexFlage[1]+hexFlage[2] != 2)
      {
        Resp_ff00 = 0x7F;
        Exit_ff00 = 1;
      }
      else
      {
        Resp_ff01 = 0x7F;
        Exit_ff01 = 1;
      }
      return;
    }
  }
  //故障注入：数据校验后功能寻址默认会话10 01
  else if(@Faultinsert::TC_DefaultSession_after_0202A)
  {
    _diagSendMsg(msgID,req0202);
    testWaitForDiagRequestSent(req0202,1000);
//    testWaitForDiagResponse(req0202,p2cmax);
//    _TestResult(req0202,"stepid",Passcondition);
    _get_FC(req0202,msgID,"stepid",Passcondition);
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    if(@AUTO::EraseMode_Switch==1)
    {
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
    /*选择了多个HEX文件*/
    else if(hexFlage[0]+hexFlage[1]+hexFlage[2] != 2)
    {
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
    else
    {
      Resp_ff01 = 0x7F;
      Exit_ff01 = 1;
    }
    return;
  }
  //故障注入：步骤缺失App 0202传输校验
  else if(@Faultinsert::TC_Miss_0202_A)
  {
    if(@AUTO::EraseMode_Switch==1)
    {
      Resp_ff00 = 0x22;
      Exit_ff00 = 1;
    }
    else
    {
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
    }
    return;
  }
  else
  {
    _diagSendMsg(msgID,req0202);
    _get_FC(req0202,msgID,"stepid",Passcondition);
  }
  
}

//Geely3.0 激活SBL
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send0301(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0301;
  dword startAddr;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d",stepnum);
  testStep(stepid,"开始测试激活SBL");
  diagResize(req0301,0x8);
  DiagSetPrimitiveByte(req0301,0,0x31);
  DiagSetPrimitiveByte(req0301,1,0x01);
  DiagSetPrimitiveByte(req0301,2,0x03);
  DiagSetPrimitiveByte(req0301,3,0x01);
  
  //故障注入：31 01 03 01地址错误
  if(@Faultinsert::TC_Error_0301==1)
  {
    startAddr = @AUTO::DriverAddr;
    Passcondition = 0x31;
    Exit_0301 = 1;
  }
  else
    startAddr = hexfile_sbt[0].BlockStartAddr;
  
  DiagSetPrimitiveByte(req0301,4,startAddr >> 24);
  DiagSetPrimitiveByte(req0301,5,(startAddr >> 16) & 0xFF);
  DiagSetPrimitiveByte(req0301,6,(startAddr >> 8) & 0xFF);
  DiagSetPrimitiveByte(req0301,7,startAddr & 0xFF);
  
  //故障注入：03 01过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_0301==1)
  {
    _diagSendMsg(msgID,req0301);
    testWaitForDiagRequestSent(req0301,1000);
    _handshake(funID);
    _get_FC(req0301,msgID,stepid,Passcondition);
  }
  //故障注入：03 01后物理寻址复位11 01
  else if(@Faultinsert::TC_Restart_after_0301==1)
  {
    _diagSendMsg(msgID,req0301);
    _get_FC(req0301,msgID,stepid,Passcondition);
    _Startreset(phyID,0x01,Resp_11);
    Resp_ff00 = 0x31;
    Exit_ff00 = 1;
  }
  //故障注入：03 01后功能寻址切换默认会话10 01
  else if(@Faultinsert::TC_DefaultSession_after_0301==1)
  {
    _diagSendMsg(msgID,req0301);
    _get_FC(req0301,msgID,stepid,Passcondition);
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    Resp_ff00 = 0x31;
    Exit_ff00 = 1;
  }
  //故障注入：步骤缺失 31 01 03 01
  else if(@Faultinsert::TC_Miss_0301==1)
  {
    Resp_ff00 = 0x31;
    Exit_0301 = 0;
    Exit_ff00 = 1;
    return;
  }
  else
  {
    _diagSendMsg(msgID,req0301);
    _get_FC(req0301,msgID,stepid,Passcondition);
  }
  //故障注入：再次请求激活SBL
  if(@Faultinsert::TC_Re_0301==1)
  {
    _diagSendMsg(msgID,req0301);
    _get_FC(req0301,msgID,stepid,Passcondition);
    Exit_0301 = 1;
  }
}
//完全性检测
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send0205(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0205;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d",stepnum);
  testStep(stepid,"开始完全性检测 31 01 02 05");
  
  //故障注入：步骤缺失完全性检测 02 05
  if(@Faultinsert::TC_Miss_0205==1)
  {
    Exit_11 = 1;
    return;
  }
  diagResize(req0205,0x04);
  DiagSetPrimitiveByte(req0205,0,0x31);
  DiagSetPrimitiveByte(req0205,1,0x01);
  DiagSetPrimitiveByte(req0205,2,0x02);
  DiagSetPrimitiveByte(req0205,3,0x05);
  //故障注入：完全性检测02 05过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_0205==1)
  {
    _diagSendMsg(msgID,req0205);
    testWaitForDiagRequestSent(req0205,1000);
    _handshake(funID);
    _get_FC(req0205,msgID,stepid,Passcondition);
  }
  //故障注入：完全性检测02 05后物理寻址复位11 01
  else if(@Faultinsert::TC_Restart_after_0205==1)
  {
    _diagSendMsg(msgID,req0205);
    _get_FC(req0205,msgID,stepid,Passcondition);
    _Startreset(phyID,0x01,Resp_11);
  }
  //故障注入：完全性检测02 05后功能寻址切换默认会话10 01
  else if(@Faultinsert::TC_DefaultSession_after_0205==1)
  {
    _diagSendMsg(msgID,req0205);
    _get_FC(req0205,msgID,stepid,Passcondition);
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
  }
  else
  {
    _diagSendMsg(msgID,req0205);
    _get_FC(req0205,msgID,stepid,Passcondition);
  }
}

//一致性检查
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _SendFF01(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Programming_Dependencies_Start reqff01;
    
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试31服务有效性校验",stepnum);
  testStep(stepid,"开始测试相关性校验");
  
  //设置诊断服务字节
  diagResize(reqff01,0x04);
  DiagSetPrimitiveByte(reqff01,0,0x31);
  DiagSetPrimitiveByte(reqff01,1,0x01);
  DiagSetPrimitiveByte(reqff01,2,0xFF);
  DiagSetPrimitiveByte(reqff01,3,0x01);
  
  /*可靠性测试：FF01应用程序有效性检查前切断电源*/
  if(TC_PowerDown_Before_FF01==1)
  {
    _K30_OFF();
    testWaitForTimeout(10000);
    Exit_ff01 = 1;
    _K30_ON();
    return;
  }
  /*可靠性测试：FF01应用程序有效性检查前下点火*/
  if(TC_K15_Before_FF01==1)
  {
    _K15_OFF();
    testWaitForTimeout(10000);
    Exit_ff01 = 1;
    _K15_ON();
    return;
  }
  /*可靠性测试：FF01应用程序有效性检查前BusOff*/
  if(TC_BusOff_Before_FF01==1)
  {
    testWaitForTesterConfirmation("请制造BufOff故障",10000);
    testWaitForTimeout(10000);
    Exit_ff01 = 1;
    testWaitForTesterConfirmation("请恢复故障",10000);
    return;
  }

  /*奇瑞31 01 FF 01*/
  if(@AUTO::Config_Switch==7)
  {
    //故障注入：FF 01依赖性检查过程中部分地址段未进行检查
    if(@Faultinsert::TC_FF01_Part==1 && @AUTO::EraseMode_Switch == 3)
    {
      EraseAddr = EraseAddr + (EraseLength >> 1) ;
      EraseLength = (EraseLength >> 1) | 1;
      Resp_DA04 = 0x22;
      Exit_DA04 = 1;
      Passcondition = 0x22;
    }
    diagResize(reqff01,0x0E);
    DiagSetPrimitiveByte(reqff01,4,EraseAddr >> 24);
    DiagSetPrimitiveByte(reqff01,5,EraseAddr >> 16 & 0xFF);
    DiagSetPrimitiveByte(reqff01,6,EraseAddr >> 8 & 0xFF);
    DiagSetPrimitiveByte(reqff01,7,EraseAddr & 0xFF);
    DiagSetPrimitiveByte(reqff01,8,EraseLength >> 24);
    DiagSetPrimitiveByte(reqff01,9,EraseLength >> 16 & 0xFF);
    DiagSetPrimitiveByte(reqff01,10,EraseLength >> 8 & 0xFF);
    DiagSetPrimitiveByte(reqff01,11,EraseLength & 0xFF);
    DiagSetPrimitiveByte(reqff01,12,current_crc16 >> 8);
    DiagSetPrimitiveByte(reqff01,13,current_crc16 & 0xFF);
  }
  
  //故障注入：步骤缺失 FF 01检查
  if(@Faultinsert::TC_Miss_FF01==1)
  {
    //奇瑞
    if(@AUTO::Config_Switch==7)
    {
      Resp_ff01 = 0x24;
      Exit_03ff01 = 1;
    }
    //东风小康
    else if(@AUTO::Config_Switch==9)
    {
      Resp_11 = 0x78;
      Exit_11 = 1;
    }
    else
    {
      Exit_11 = 1;
    }
    return;
  }
  //故障注入：FF 01检查后功能寻址握手
  else if(@Faultinsert::TC_Handshake_in_FF01==1)
  {
    _diagSendMsg(msgID,reqff01);
    testWaitForDiagRequestSent(reqff01,1000);
    _handshake(funID);
    _get_FC(reqff01,phyID,stepid,Passcondition);
    if(@AUTO::Config_Switch==11)
      testWaitForTimeout(1000);
  }
  //故障注入：FF 01检查后功能寻址复位
  else if(@Faultinsert::TC_Restart_after_FF01==1)
  {
    _diagSendMsg(msgID,reqff01);
    _get_FC(reqff01,phyID,stepid,Passcondition);
    _Startreset(phyID,0x01,Resp_11);
    Resp_ff01 = 0x7F;
    Resp_DA04 = 0x7F;
    Exit_DA04 = 1;
  }
  //故障注入：FF 01检查后功能寻址切换默认会话
  else if(@Faultinsert::TC_DefaultSession_after_FF01==1)
  {
    _diagSendMsg(msgID,reqff01);
    testWaitForDiagRequestSent(reqff01,1);
    _get_FC(reqff01,phyID,stepid,Passcondition);
    enterDefault(funID,0,Resp_1001);
    //Geely1.0 || 鑫源 || 五菱 
    if(@AUTO::Config_Switch==3 || @AUTO::Config_Switch==5 ) //|| @AUTO::Config_Switch==11  || 奇瑞  T1V
    {
      Resp_11 = 0x7F;
      Exit_11 = 1;
    }
    testWaitForTimeout(Restart_Time);
  }
  //故障注入：CA APP数据校验后功能寻址复位
  else if(@Faultinsert::TC_Restart_after_0202A==1 && @AUTO::Config_Switch==2)
  {
    _diagSendMsg(msgID,reqff01);
    testWaitForDiagRequestSent(reqff01,1);
    _get_FC(reqff01,phyID,stepid,Passcondition);
    _Startreset(funID,0x03,Resp_11);
  }
  //故障注入：CA APP数据校验后功能寻址切换默认会话
  else if(@Faultinsert::TC_DefaultSession_after_0202A==1 && @AUTO::Config_Switch==2)
  {
    _diagSendMsg(msgID,reqff01);
    testWaitForDiagRequestSent(reqff01,1);
    _get_FC(reqff01,phyID,stepid,Passcondition);
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
  }
  //故障注入：31 01 FF 01的CRC校验错误
  else if(@Faultinsert::TC_Error_0202_A==1)
  {
    DiagSetPrimitiveByte(reqff01,12,0);
    DiagSetPrimitiveByte(reqff01,13,0);
    _diagSendMsg(msgID,reqff01);
    _get_FC(reqff01,phyID,stepid,Passcondition);
    PassState_31[0] = 0x02;
    Exit_02ff01 = 1;
  }
  else
  {
    _diagSendMsg(msgID,reqff01);
    testWaitForDiagRequestSent(reqff01,1);
    _get_FC(reqff01,phyID,stepid,Passcondition);
  }
  /*性能测试：验证是否在BT中擦除APP有效位*/
  if(@Faultinsert::TC_BT_AppValid == 1)
  { 
//    if(Loop_Add_Times > 0)
//      @Faultinsert::TC_Miss_GetFc = 1;
    
//    testEnableMsg(0x11);
//    _diagSendMsg(msgID,reqff01);
//    testWaitForDiagRequestSent(reqff01,100);
//    _get_FC(reqff01,msgID,"stepid",Passcondition);

    if(Loop_Add_Time > 0)
    {
      testWaitForTimeout(Loop_Add_Time);
      writeEx(-3,1,"等待：%dms",Loop_Add_Time);
    }
    _K30_OFF();
    Exit_ff01 = 1;
    testWaitForTimeout(2000);
    _K30_ON();
    testWaitForTimeout(2000);
    writeEx(-3,1,"等待：2s");

    Check_APPValid2();
//    testdisableMsg(0x11);
//    @Faultinsert::TC_Miss_GetFc = 0;
    return;
  }
  /*可靠性测试：FF01应用程序有效性检查后切断电源*/
  if(TC_PowerDown_After_FF01==1)
  {
    _K30_OFF();
    testWaitForTimeout(10000);
    Exit_ff01 = 1;
    _K30_ON();
    return;
  }
  /*可靠性测试：FF01应用程序有效性检查后下点火*/
  if(TC_K15_After_FF01==1)
  {
    _K15_OFF();
    testWaitForTimeout(10000);
    Exit_ff01 = 1;
    _K15_ON();
    return;
  }
  /*可靠性测试：FF01应用程序有效性检查后BusOff*/
  if(TC_BusOff_After_FF01==1)
  {
    testWaitForTesterConfirmation("请制造BufOff故障",10000);
    testWaitForTimeout(10000);
    Exit_ff01 = 1;
    testWaitForTesterConfirmation("请恢复故障",10000);
    return;
  }
}
//奇瑞 31 03 FF 01
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send03FF01(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Programming_Dependencies_Start reqff01;
  
  diagResize(reqff01,4);
  DiagSetPrimitiveByte(reqff01,0,0x31);
  DiagSetPrimitiveByte(reqff01,1,0x03);
  DiagSetPrimitiveByte(reqff01,2,0xFF);
  DiagSetPrimitiveByte(reqff01,3,0x01);
  
  //故障注入：步骤缺失 31 03 FF 01
  if(@Faultinsert::TC_Miss_FF01_03==1)
  {
    if(@Faultinsert::TC_Miss_FF01==1)
    {
      Exit_03ff01 = 0;
      Exit_02ff01 = 1;
    }
    return;
  }
  if(@Faultinsert::TC_FF01_Part==1 && @AUTO::EraseMode_Switch == 3)
  {
    Passcondition = 0x24;
  }
  _diagSendMsg(msgID,reqff01);
  _get_FC(reqff01,msgID,stepid,Passcondition);
}
//奇瑞 31 02 FF 01
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send02FF01(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Programming_Dependencies_Start reqff01;
  
  diagResize(reqff01,4);
  DiagSetPrimitiveByte(reqff01,0,0x31);
  DiagSetPrimitiveByte(reqff01,1,0x02);
  DiagSetPrimitiveByte(reqff01,2,0xFF);
  DiagSetPrimitiveByte(reqff01,3,0x01);
  
  //故障注入：步骤缺失 31 02 FF 01
  if(@Faultinsert::TC_Miss_FF01_02==1)
  {
    if(@Faultinsert::TC_Miss_FF01==1 && @Faultinsert::TC_Miss_FF01_03==1)
    {
      Exit_02ff01 = 0;
      Resp_DA04 = 0x22;
      Exit_DA04 = 1;
    }
    else
    {
      Resp_ff01 = 0x24;    
      Exit_ff01 = 1;
    }
    return;
  }
  if(@Faultinsert::TC_FF01_Part==1 && @AUTO::EraseMode_Switch == 3)
  {
    Passcondition = 0x24;
  }
  _diagSendMsg(msgID,reqff01);
  _get_FC(reqff01,msgID,stepid,Passcondition);
}

