//ECU复位
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数ResetSetting:{01:硬件复位，03:软件复位}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Startreset(dword msgID,dword ResetSetting,int Passcondition)
{
  diagRequest ABS_ESP.hardReset_Reset req11;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试11服务复位重启",stepnum);
  
  DiagSetPrimitiveByte(req11,1,ResetSetting); 
  //故障注入：步骤缺失 ECU 11复位
  if(@Faultinsert::TC_Miss_11==1)
  {
    Resp_1003 = 0x7E;
    Exit_1003 = 1;
    return;
  }
  else
  {
    _diagSendMsg(msgID,req11);
    _get_FC(req11,msgID,stepid,Passcondition);
    testWaitForTimeout(Restart_Time);
//    curAppValid = Check_AppValid();
  }
}
/*
  软件有效性检测31 01 DA 04
  msgID:{phyID:物理寻址,funID:功能寻址}
  Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
*/
void _SendDA04(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Erase_Memory_Start req31;
  diagResize(req31,0x06);
  DiagSetPrimitiveByte(req31,0,0x31);
  DiagSetPrimitiveByte(req31,1,0x01);
  DiagSetPrimitiveByte(req31,2,0xDA);
  DiagSetPrimitiveByte(req31,3,0x04);
  DiagSetPrimitiveByte(req31,4,calcrc16 >> 8);
  DiagSetPrimitiveByte(req31,5,calcrc16 & 0xFF);
  
  //故障注入：31 01 DA04的CRC值错误
  if(@Faultinsert::TC_Error_DA04==1)
  {
    DiagSetPrimitiveByte(req31,4,0xFF);
    DiagSetPrimitiveByte(req31,5,0xFF);
    _diagSendMsg(msgID,req31);
    _get_FC(req31,msgID,stepid,Passcondition);
    PassState_31[0] = 0x02;
    Resp_14 = 0;
    Exit_14 = 1;
    return;
  }
  //故障注入：步骤缺失 31 01 DA 04
  if(@Faultinsert::TC_Miss_DA04==1)
  {
    Resp_DA04 = 0x24;
    Exit_03DA04 = 1;
    return;
  }
  _diagSendMsg(msgID,req31);
  //故障注入：DA 04检查过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_DA04==1)
  {
    testWaitForDiagRequestSent(req31,500);
    _handshake(funID);
  }
  _get_FC(req31,msgID,stepid,Passcondition);
  //故障注入：DA 04检查后功能寻址复位
  if(@Faultinsert::TC_Restart_after_DA04==1)
  {
    Resp_DA04 = 0x7F;
    _Startreset(phyID,0x01,Resp_11);
  }
    /*性能测试：验证是否在BT中擦除APP有效位*/
  if(@Faultinsert::TC_BT_AppValid == 1)
  { 

    if(Loop_Add_Time > 0)
    {
      testWaitForTimeout(Loop_Add_Time);
      writeEx(-3,1,"等待：%dms",Loop_Add_Time);
    }
    _K30_OFF();
    Exit_ff01 = 1;
    testWaitForTimeout(2000);
    _K30_ON();
    testWaitForTimeout(2000);
    writeEx(-3,1,"等待：2s");

    Check_APPValid2();
    return;
  }
}
/*
  31 03 DA 04
  msgID:{phyID:物理寻址,funID:功能寻址}
  Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
*/
void _Send03DA04(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Erase_Memory_Start req31;
  diagResize(req31,0x04);
  DiagSetPrimitiveByte(req31,0,0x31);
  DiagSetPrimitiveByte(req31,1,0x03);
  DiagSetPrimitiveByte(req31,2,0xDA);
  DiagSetPrimitiveByte(req31,3,0x04);
  
  //故障注入：步骤缺失 31 03 DA 04
  if(@Faultinsert::TC_Miss_DA04_03==1)
  {
    if(@Faultinsert::TC_Miss_DA04==1)
    {
      Exit_03DA04 = 0;
      Exit_02DA04 = 1;
    }
    return;
  } 
  _diagSendMsg(msgID,req31);
  _get_FC(req31,msgID,stepid,Passcondition);
}
/*
  31 02 DA 04
  msgID:{phyID:物理寻址,funID:功能寻址}
  Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
*/
void _Send02DA04(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Erase_Memory_Start req31;
  diagResize(req31,0x04);
  DiagSetPrimitiveByte(req31,0,0x31);
  DiagSetPrimitiveByte(req31,1,0x02);
  DiagSetPrimitiveByte(req31,2,0xDA);
  DiagSetPrimitiveByte(req31,3,0x04);

  //故障注入：步骤缺失 31 02 DA 04
  if(@Faultinsert::TC_Miss_DA04_02==1)
  {
    if(@Faultinsert::TC_Miss_DA04==1 && @Faultinsert::TC_Miss_DA04_03==1)
    {
      Resp_14 = 0;
      Exit_14 = 1;
    }
    return;
  }
  _diagSendMsg(msgID,req31);
  _get_FC(req31,msgID,stepid,Passcondition);
}
/*
  奇瑞 31 03 FF 00服务
  msgID:{phyID:物理寻址,funID:功能寻址}
  Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
*/
void _Send03FF00(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Erase_Memory_Start reqff00;
  diagResize(reqff00,0x04);
  DiagSetPrimitiveByte(reqff00,0,0x31);
  DiagSetPrimitiveByte(reqff00,1,0x03);
  DiagSetPrimitiveByte(reqff00,2,0xFF);
  DiagSetPrimitiveByte(reqff00,3,0x00);
  
  /*故障注入：步骤缺失 不执行31 01 FF 00 和 31 03 FF 00*/
  if(@Faultinsert::TC_Miss_FF00_03==1)
  {
    if(@Faultinsert::TC_Miss_FF00==1)
    {
      Exit_03ff00 = 0;
      Exit_02ff00 = 1;
    }
    return;
  }
  _diagSendMsg(msgID,reqff00);
  _get_FC(reqff00,msgID,stepid,Passcondition);
}
/*
  奇瑞 31 02 FF 00服务
  msgID:{phyID:物理寻址,funID:功能寻址}
  Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
*/
void _Send02FF00(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Erase_Memory_Start reqff00;
  diagResize(reqff00,0x04);
  DiagSetPrimitiveByte(reqff00,0,0x31);
  DiagSetPrimitiveByte(reqff00,1,0x02);
  DiagSetPrimitiveByte(reqff00,2,0xFF);
  DiagSetPrimitiveByte(reqff00,3,0x00);
  
  /*故障注入：步骤缺失：不执行31 02擦除步骤*/
  if(@Faultinsert::TC_Miss_FF00_02==1)
  {
    if(@Faultinsert::TC_Miss_FF00==1 && @Faultinsert::TC_Miss_FF00_03==1)
    {
      Exit_02ff00 = 0;
      Resp_34_a = 0x70;
      Exit_34_a = 1;
    }
    return;
  }
  _diagSendMsg(msgID,reqff00);
  _get_FC(reqff00,msgID,stepid,Passcondition);
}
//31 01 FF 00擦除内存服务请求，在函数中添加故障注入的情况
//参数addr:起始地址
//参数size:地址大小
//参数msgID:{phyID:物理寻址,funID:功能寻址}
void _SendFF00(dword addr,dword size,dword msgID)
{
  diagRequest ABS_ESP.Erase_Memory_Start reqff00;
  diagRequest ABS_ESP.hardReset_Reset req1101;
  diagRequest ABS_ESP.DefaultSession_Start req1001;
  dword EraseLength;
  
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试31服务FF00擦除内存",stepnum);
  
  /*可靠性测试：内存擦除前切断电源*/
  if(TC_PowerDown_Before_FF00==1)
  {
    _K30_OFF();
    testWaitForTimeout(10000);
    Exit_ff00 = 1;
    _K30_ON();
    return;
  }
  /*可靠性测试：内存擦除前下点火*/
  if(TC_K15_Before_FF00==1)
  {
    _K15_OFF();
    testWaitForTimeout(10000);
    Exit_ff00 = 1;
    _K15_ON();
    return;
  }
  /*可靠性测试：内存擦除前BusOff*/
  if(TC_BusOff_Before_FF00==1)
  {
    testWaitForTesterConfirmation("请制造BufOff故障",10000);
    testWaitForTimeout(10000);
    Exit_ff00 = 1;
    testWaitForTesterConfirmation("请恢复故障",10000);
    return;
  }
  
  //故障注入：鑫源 2E写数据后功能寻址复位
  if(@Faultinsert::TC_Restart_after_2E && @AUTO::Config_Switch==5)
  {
    Resp_ff00 = 0x7F;
    _Startreset(funID,0x01,Resp_11);
    Exit_ff00 = 1;
  }
  //故障注入：鑫源 2E写数据后功能寻址切换默认会话
  else if(@Faultinsert::TC_DefaultSession_after_2E && @AUTO::Config_Switch==5)
  {
    Resp_ff00 = 0x7F;
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    Exit_ff00 = 1;
  }
  //故障注入：内存擦除的内存地址错误
  if(@Faultinsert::TC_Error_FF00_Addr==1)
  {
    if(@Faultinsert::TC_ErrorAddr_FBT==1)
      addr = @AUTO::EraseAddr_FBT;
    else if(@Faultinsert::TC_ErrorAddr_SBT==1)
      addr = @AUTO::EraseAddr_SBT;
    else
      addr = @AUTO::EraseAddr;
    if(@AUTO::Config_Switch==1)//BYD
    {
      if(@Faultinsert::TC_ErrorAddr_FBT==1 || @Faultinsert::TC_ErrorAddr_SBT==1)
      {
        Resp_ff00 = 0x72;
      }
      else
        Resp_ff00 = 0x31;
      Resp_34_a = 0x22;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Exit_0202_a = 1;
    }
    else if(@AUTO::Config_Switch==7)//奇瑞 
    {
      Resp_ff00 = 0x31;
      Exit_ff00 = 1;
    }
    else if(@AUTO::Config_Switch==4)//Geely 3.0
    {
      if(@Faultinsert::TC_ErrorAddr_FBT==1) // || @Faultinsert::TC_ErrorAddr_SBT==1
      {
        Resp_ff00 = 0x72;
        if(@AUTO::Geely3_Config == 1)
          Resp_ff00 = 0x72;
      }
      else if(@Faultinsert::TC_ErrorAddr_SBT==1)
      {
        Resp_ff00 = 0x31;
        if(@AUTO::Geely3_Config == 1)
          Resp_ff00 = 0x31;
      }
      else
        Resp_ff00 = 0x31;
      Exit_ff00 = 1;
    }
    else //Geely 1.0 || 鑫源 || 瑞驰 || 五菱 || 东风小康 || 赛力斯
    {
      Resp_ff00 = 0x31;
      Exit_ff00 = 1;
    }
  }
  //故障注入：内存擦除的内存大小错误
  else if(@Faultinsert::TC_Error_FF00_Size==1)
  {
    size = @AUTO::EraseSize;
    if(@AUTO::Config_Switch==1)//BYD
    {
      Resp_ff00 = 0x31;
      Resp_34_a = 0x22;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Exit_0202_a = 1;
    }
    else //Geely1.0 || Geely3.0 || 鑫源 || 瑞驰 || 奇瑞 || 五菱 || 赛力斯
    {
      Resp_ff00 = 0x31;
      Exit_ff00 = 1;
    }
  }
  /*故障注入：FF 00擦除过程中部分地址未进行擦除*/
  if(@Faultinsert::TC_FF00_Part==1 && @AUTO::EraseMode_Switch == 3)
  {
    addr = addr + (size >> 1);
    size = (size >> 1) | 1;
    Resp_34_a = 0x70;
    Exit_34_a = 1;
    @Faultinsert::TC_FF00_Part==0;
  }
  if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==3 
  || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==11 || @AUTO::Config_Switch==12)//BYD || Geely1.0 || 鑫源 || T1V
  {
    diagResize(reqff00,0x0D);
    DiagSetPrimitiveByte(reqff00,4,App_AddrAndLenId);
    DiagSetPrimitiveByte(reqff00,5,addr>>24);
    DiagSetPrimitiveByte(reqff00,6,(addr>>16)&0xFF);
    DiagSetPrimitiveByte(reqff00,7,(addr>>8)&0xFF);
    DiagSetPrimitiveByte(reqff00,8,addr&0xFF);
    DiagSetPrimitiveByte(reqff00,9,size>>24);
    DiagSetPrimitiveByte(reqff00,10,(size>>16)&0xFF);
    DiagSetPrimitiveByte(reqff00,11,(size>>8)&0xFF);
    DiagSetPrimitiveByte(reqff00,12,size&0xFF);
  }
  //ChangAn || Geely3.0 || 瑞驰 ||奇瑞 || 五菱 || 小康 || 赛力斯
  else 
  {
    diagResize(reqff00,0x0C);
    DiagSetPrimitiveByte(reqff00,4,addr>>24);
    DiagSetPrimitiveByte(reqff00,5,(addr>>16)&0xFF);
    DiagSetPrimitiveByte(reqff00,6,(addr>>8)&0xFF);
    DiagSetPrimitiveByte(reqff00,7,addr&0xFF);
    DiagSetPrimitiveByte(reqff00,8,size>>24);
    DiagSetPrimitiveByte(reqff00,9,(size>>16)&0xFF);
    DiagSetPrimitiveByte(reqff00,10,(size>>8)&0xFF);
    DiagSetPrimitiveByte(reqff00,11,size&0xFF);
  }


  //故障注入：内存擦除的数据长度错误
  if(@Faultinsert::TC_Error_FF00_Length==1)
  {
    EraseLength = @AUTO::EraseLength;
    diagResize(reqff00,EraseLength);
    Resp_ff00 = 0x13;
    Exit_ff00 = 1;
  }
  
  //故障注入:内存擦除过程中功能寻址握手
  if(@Faultinsert::TC_Handshake_in_FF00==1)
  {
    _diagSendMsg(msgID,reqff00);
    testWaitForDiagRequestSent(reqff00,10);
    _handshake(funID);
    _get_FC(reqff00,phyID,stepid,Resp_ff00);
    testWaitForTimeout(4000);
  }
  //故障注入:内存擦除后功能寻址复位11 01
  else if(@Faultinsert::TC_Restart_after_FF00 && @AUTO::Config_Switch!=4)
  {
    _diagSendMsg(msgID,reqff00);
    _get_FC(reqff00,phyID,stepid,Resp_ff00);
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==7)//BYD || 奇瑞
    {
      _Startreset(phyID,0x01,Resp_11);
      Resp_ff00 = 0x7F;
      Resp_34_a = 0x7F;
      Exit_34_a = 1;
    }
    else if(@AUTO::Config_Switch==2)//ChangAn
    {
      _Startreset(funID,0x03,Resp_11);
      Resp_34_a = 0x7F;
      Exit_34_a = 1;
    }
    //Geely 1.0 || 鑫源 || 瑞驰 || 五菱 || 赛力斯
    else
    {
      _Startreset(funID,0x01,Resp_11);
      Resp_34_a = 0x7F;
      Exit_34_a = 1;
    }
    return;
  }
  //故障注入:内存擦除后功能寻址切换默认会话10 01
  else if(@Faultinsert::TC_DefaultSession_after_FF00 && @AUTO::Config_Switch!=4)
  {
    _diagSendMsg(msgID,reqff00);
    testWaitForDiagRequestSent(reqff00,200);
    _get_FC(reqff00,phyID,stepid,Resp_ff00);
//    if(@AUTO::Config_Switch == 8) //五菱不响应
//      Resp_1001 = 0;
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    Resp_34_a = 0x7F;
    Exit_34_a = 1;
    return;
  }
  //故障注入：步骤缺失FF 00擦除请求
  else if(@Faultinsert::TC_Miss_FF00)
  {
    if(@AUTO::Config_Switch==4)//Geely 3.0
    {
      Resp_34_a = 0x70;//0x24;
      Exit_34_a = 1;
    }
    else if(@AUTO::Config_Switch==7)//奇瑞
    {
      Resp_ff00 = 0x24;
      Exit_03ff00 = 1;
    }
    else
    {
      Resp_34_a = 0x22;
      Exit_34_a = 1;
    }
    return;
  }
  //故障注入：FF00擦除过程中断电
  else if(@Faultinsert::TC_FF00_K30_OFF==1)
  {
    //Geely3.0
    if(@AUTO::Config_Switch==4)
    {
      _diagSendMsg(msgID,reqff00);
      _K30_OFF();
      _K30_ON();
      testWaitForTimeout(2500);
      ReadIdentify(phyID,0xF186,-1);
      enterProg(phyID,0,-1);
      Break_Download = 1;
      Exit_ff00 = 1;
    }
    //奇瑞
    else if(@AUTO::Config_Switch==7)
    {
      _diagSendMsg(msgID,reqff00);
      @Prog_power::K30 = 0;
      Resp_ff00 = 0x78;
      Exit_ff00 = 1;
      _get_FC(reqff00,phyID,stepid,Resp_ff00);
    }
  }
  else
  {
    _diagSendMsg(msgID,reqff00);
    /*可靠性测试：内存擦除中切断电源*/
    if(TC_PowerDown_In_FF00==1)
    {
      _K30_OFF();
      testWaitForTimeout(10000);
      Exit_ff00 = 1;
      _K30_ON();
      return;
    }
    _get_FC(reqff00,phyID,stepid,Resp_ff00);
    testWaitForTimeout(100); //20260421：防止11服务被干扰  待验证
  }
  //故障注入：31 01 FF 00后直接DA04依赖性检测
  if(@Faultinsert::TC_FF00_DA04==1)
  {
    Resp_DA04 = 0x22;
    _SendDA04(phyID,Resp_DA04);
    Exit_ff00 = 1;
  }
  //APP无效
  if(@AUTO::APP_Valid == 1)
  {
    Exit_ff00 = 1;
    return;
  }
  /*可靠性测试：内存擦除后切断电源*/
  if(TC_PowerDown_After_FF00==1)
  {
    _K30_OFF();
    testWaitForTimeout(10000);
    Exit_ff00 = 1;
    _K30_ON();
    return;
  }
  /*可靠性测试：内存擦除后下点火*/
  if(TC_K15_After_FF00==1)
  {
    _K15_OFF();
    testWaitForTimeout(10000);
    Exit_ff00 = 1;
    _K15_ON();
    return;
  }
  /*可靠性测试：内存擦除后BusOff*/
  if(TC_BusOff_After_FF00==1)
  {
    testWaitForTesterConfirmation("请制造BufOff故障",10000);
    testWaitForTimeout(10000);
    Exit_ff00 = 1;
    testWaitForTesterConfirmation("请恢复故障",10000);
    return;
  }
}
//发送握手指令
//参数msgID:{phyID:物理寻址,funID:功能寻址}
void _handshake(dword msgID)
{
  byte data[2];
  byte handle;
  byte i;
  i = 0;
  data[0] = 0x3E;data[1] = 0x80;
  handle=CanTpCreateConnection(0);
  CanTpSetTxIdentifier(handle,msgID);
  CanTpSetPadding(handle,0x55);
  for(i=0;i<20;i++)
  {
    CanTpSendData(handle,data,elCount(data));
  }
}
//发送一定次数的握手指令,
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//times:{发送次数}
int _handshake_times(message *Msg,dword msgID,int times)
{
  byte data[2],handle;
  int i,Flage;
  double Start_Time,End_Time,Diff_Time;
  diagStopTesterPresent("ABS_ESP_Functional");
  i = 0;
  data[0] = 0x3E;data[1] = 0x80;
  handle=CanTpCreateConnection(0);
  CanTpSetTxIdentifier(handle,msgID);
  CanTpSetPadding(handle,0x55);
  End_Time = 0;
  Flage = 0;
  Start_Time=(double)timeNow()/100;
  if(testWaitForMessage(revID,@AUTO::Handshake_NRC78_Time))
  {
    End_Time=(double)timeNow()/100;
    testGetWaitEventMsgData(Msg);
    Flage = 1;
  }
  Diff_Time = @AUTO::Handshake_NRC78_Time - (End_Time - Start_Time);
  if(Diff_Time>0.5 && Diff_Time < @AUTO::Handshake_NRC78_Time) //舍弃过短时间
    testWaitForTimeout(_max(1,(int)Diff_Time));
  for(i=0;i<times;i++)
  {
    CanTpSendData(handle,data,elCount(data));
    Start_Time=(double)timeNow()/100;
    if(testWaitForMessage(revID,@AUTO::Handshake_Send_Time))
    {
      End_Time=(double)timeNow()/100;
      testGetWaitEventMsgData(Msg);
      Flage = 1;
    }
    Diff_Time = @AUTO::Handshake_Send_Time - (End_Time - Start_Time);
    if(Diff_Time>0.5 && Diff_Time<@AUTO::Handshake_Send_Time) //舍弃过短时间
      testWaitForTimeout(_max(1,(int)Diff_Time));
  }
  diagStartTesterPresent("ABS_ESP_Functional");
  return Flage;
}

