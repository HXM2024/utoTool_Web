/// <Bin>
/*
    获取二进制数据并装载
    输入：文件路径
    输入：起始装载数据块
    输入：起始装载数据块
    FileNum文件位置：第0个为Flash文件
*/
void BinFile_ReadAndSave(char FileName[],byte Start_Block,int FileNum)
{
  char FileName_Temp[400];
  int fileInx,n,BlockBin_NumTemp;
  dword i;
  int fileHandle_,result;
  qword AddBin,LenBin,IndexBin;
  byte DataTemp[BinDataSave_MaxLen]; 
  snprintf(FileName_Temp,elCount(FileName_Temp),"%s",FileName);
  fileInx = strlen(FileName_Temp);
  if(FileName_Temp[fileInx-3] == 'b' && FileName_Temp[fileInx-2] == 'i' && FileName_Temp[fileInx-1] == 'n')
  {
    fileHandle_ = OpenFileRead(FileName_Temp,1);
    result = fileGetBinaryBlock (DataTemp, elCount(DataTemp),fileHandle_);
    BlockBin_Flage = 1;
    BlockBin_NumTemp =BlockBin_Num + DataTemp[32];
    AddBin = 0;LenBin = 0;IndexBin = 32;
    IndexBin = IndexBin + DataTemp[32]*8 + 1;
    if(FileNum == 0)  //Flash处理，默认Flash仅一段，不存入结构体中，减少结构体占用大小
    {
      BlockBin_Num = 0;//起始时清除块计数
      IndexBin = 1; //Flash装载格式不一致，默认从0开始装载 区块数量 + 地址 + 长度 + 内容
      AddBin = (DataTemp[IndexBin+0]<<24)|(DataTemp[IndexBin+1]<<16)|(DataTemp[IndexBin+2]<<8)|(DataTemp[IndexBin+3]);
      LenBin = (DataTemp[IndexBin+4]<<24)|(DataTemp[IndexBin+5]<<16)|(DataTemp[IndexBin+6]<<8)|(DataTemp[IndexBin+7]);
      DriverAddr = AddBin;
      DriverSize = LenBin;
      IndexBin +=8;
      for(i=IndexBin;i<DriverSize + IndexBin;i++)
        BlockBin_Flash[i-IndexBin] = DataTemp[i];
      hexfile_app[0].FilePos = 0;
    }
    else
    {
      for(n=Start_Block;n<BlockBin_NumTemp;n++)
      {
        AddBin = (DataTemp[33+(n-Start_Block)*8]<<24)|(DataTemp[34+(n-Start_Block)*8]<<16)|(DataTemp[35+(n-Start_Block)*8]<<8)|(DataTemp[36+(n-Start_Block)*8]);
        LenBin = (DataTemp[37+(n-Start_Block)*8]<<24)|(DataTemp[38+(n-Start_Block)*8]<<16)|(DataTemp[39+(n-Start_Block)*8]<<8)|(DataTemp[40+(n-Start_Block)*8]);
        hexfile_app[n].BlockStartAddr = AddBin;
        hexfile_app[n].BlockDataLength = LenBin;
        hexfile_app[n].BlockEndAddr = hexfile_app[n].BlockStartAddr + hexfile_app[n].BlockDataLength - 1;
        hexfile_app[n].FilePos = FileNum; //从1开始，0为Flash部分
        /*[流式改造-2026-09]原将整段数据拷贝到 hexfile_app[n].dataBuffer[0x200000] 导致
          内存峰值4MB(栈DataTemp 2MB + 全局dataBuffer 2MB)。现 dataBuffer 缩为 0x1000 单页缓冲,
          实际数据在 _download_5_stream 中按 Blocksize_36 分页从文件流式读取。原拷贝循环已屏蔽:
          for(i=IndexBin;i<hexfile_app[n].BlockDataLength + IndexBin;i++)
            hexfile_app[n].dataBuffer[i-IndexBin] = DataTemp[i];
          IndexBin = IndexBin + hexfile_app[n].BlockDataLength;*/
      }
      BlockBin_Num = BlockBin_NumTemp;
      /*[流式改造-2026-09]记录该文件栏的流式元数据:数据段起始偏移、block 索引与数量。
        数据段在文件中连续排列,流式读取时按 block 顺序 fileGetBinaryBlock 即可覆盖。*/
      binDataOffset[FileNum]  = IndexBin;
      binBlockIndex[FileNum]  = Start_Block;
      binBlockCount[FileNum]  = BlockBin_NumTemp - Start_Block;
    }
    fileClose(fileHandle_);
  }
}
/// <Bin>
/*
    [流式改造-2026-09]bin 流式读取辅助函数:打开文件并跳过头部到数据段起始。
    输入：FileNum 文件栏编号(1,2,...)
    返回：文件句柄(0表示失败)。句柄存入 binFileHandle[FileNum] 供后续 BinFile_ReadPage 使用。
    说明:CAPL File I/O 无 fileSeek,利用 fileGetBinaryBlock 顺序读取特性,读取 binDataOffset
         字节丢弃以定位到数据段起始。buffer 大小取 0x200 覆盖头部最大值(30块*8+33=273)。
*/
dword BinFile_OpenStream(int FileNum)
{
  char filename[400];
  int fileHandle_;
  byte skipBuf[0x200];
  dword skipLen,readLen;
  /*路径选择与 _getEraseAddrBin 一致:支持 Alternate_DownLoad_Flage 切换文件栏组*/
  if(Alternate_DownLoad_Flage == 0 || Alternate_DownLoad_Flage == 1)
  {
    if(FileNum==1)
      sysGetVariableString(sysvar::AUTO::openFile_Bin1,filename,elCount(filename));
    else if(FileNum==2)
      sysGetVariableString(sysvar::AUTO::openFile_Bin2,filename,elCount(filename));
    else
      sysGetVariableString(sysvar::AUTO::openFile_Bin1,filename,elCount(filename));
  }
  else
  {
    if(FileNum==1)
      sysGetVariableString(sysvar::AUTO::openFile2_Bin1,filename,elCount(filename));
    else if(FileNum==2)
      sysGetVariableString(sysvar::AUTO::openFile2_Bin2,filename,elCount(filename));
    else
      sysGetVariableString(sysvar::AUTO::openFile2_Bin1,filename,elCount(filename));
  }
  fileHandle_ = OpenFileRead(filename,1);
  if(fileHandle_==0)
    return 0;
  skipLen = binDataOffset[FileNum];
  {
    dword remaining, thisSkip;
    remaining = skipLen;
    while(remaining > 0)
    {
      if(remaining > elCount(skipBuf))
        thisSkip = elCount(skipBuf);
      else
        thisSkip = remaining;
      readLen = fileGetBinaryBlock(skipBuf,thisSkip,fileHandle_);
      if((long)readLen != (long)thisSkip)
      {
        writeEx(-3,1,"[流式]跳过头部失败,剩余%d 实际读了%d,文件栏%d",remaining,readLen,FileNum);
        fileClose(fileHandle_);
        return 0;
      }
      remaining -= thisSkip;
    }
  }
  binFileHandle[FileNum] = fileHandle_;
  return fileHandle_;
}

/// <Bin>
/*
    [流式改造-2026-09]从已打开的 bin 文件流式读取一页数据。
    输入：fileHandle 文件句柄(BinFile_OpenStream 返回)
         pageBuf    页缓冲(调用方保证大小>=pageSize)
         pageSize   期望读取的字节数
    返回：实际读取的字节数(文件末尾可能小于pageSize)
    说明:fileGetBinaryBlock 从当前文件位置读取最多 pageSize 字节,顺序前进。
*/
dword BinFile_ReadPage(dword fileHandle,byte pageBuf[],dword pageSize)
{
  return fileGetBinaryBlock(pageBuf,pageSize,fileHandle);
}

/// <Bin>
/*
    [流式改造-2026-09]关闭 bin 流式文件句柄。
*/
void BinFile_CloseStream(int FileNum)
{
  if(binFileHandle[FileNum]!=0)
  {
    fileClose(binFileHandle[FileNum]);
    binFileHandle[FileNum] = 0;
  }
}

/// <Bin>
/*
    获取二进制数据并装载
    输入：文件路径
    输入：起始装载数据块
    输入：起始装载数据块
    FileNum文件位置：第0个为Flash文件
*/
void BinFile_ReadAndSaveOutPut(char FileName[],byte Start_Block,int FileNum)
{
  char FileName_Temp[400];
  int fileInx,i,n,BlockBin_NumTemp;
  int fileHandle_,result;
  qword AddBin,LenBin,IndexBin;
  byte DataTemp[BinDataSave_MaxLen]; 
  snprintf(FileName_Temp,elCount(FileName_Temp),"%s",FileName);
  fileInx = strlen(FileName_Temp);
  if(FileName_Temp[fileInx-3] == 'b' && FileName_Temp[fileInx-2] == 'i' && FileName_Temp[fileInx-1] == 'n')
  {
    BlockBin_Flage = 1;
    fileHandle_ = OpenFileRead(FileName_Temp,1);
    result = fileGetBinaryBlock (DataTemp, elCount(DataTemp),fileHandle_);
    
    BlockBin_NumTemp =BlockBin_Num + DataTemp[32];
    AddBin = 0;LenBin = 0;IndexBin = 0;
    IndexBin = IndexBin + DataTemp[32]*8 + 1;
    if(FileNum == 0)  //Flash处理，默认Flash仅一段，不存入结构体中，减少结构体占用大小
    {
      BlockBin_Num = 0;//起始时清除块计数
      
      IndexBin = 1; //Flash装载格式不一致，默认从0开始装载 区块数量 + 地址 + 长度 + 内容
      AddBin = (DataTemp[IndexBin+0]<<24)|(DataTemp[IndexBin+1]<<16)|(DataTemp[IndexBin+2]<<8)|(DataTemp[IndexBin+3]);
      LenBin = (DataTemp[IndexBin+4]<<24)|(DataTemp[IndexBin+5]<<16)|(DataTemp[IndexBin+6]<<8)|(DataTemp[IndexBin+7]);
//      AddBin = (DataTemp[33+(n-Start_Block)*8]<<24)|(DataTemp[34+(n-Start_Block)*8]<<16)|(DataTemp[35+(n-Start_Block)*8]<<8)|(DataTemp[36+(n-Start_Block)*8]);
//      LenBin = (DataTemp[37+(n-Start_Block)*8]<<24)|(DataTemp[38+(n-Start_Block)*8]<<16)|(DataTemp[39+(n-Start_Block)*8]<<8)|(DataTemp[40+(n-Start_Block)*8]);
      DriverAddr = AddBin;
      DriverSize = LenBin;
      for(i=0;i<50;i++)
        writeEx(-3,0,"DataTemp[%d] = %02X",i,DataTemp[i]);
      writeEx(-3,0,"--------------------------------");
      writeEx(-3,0,"DriverAddr =   0x%X",DriverAddr);
      writeEx(-3,0,"DriverSize =   0x%X",DriverSize);
      writeEx(-3,0,"--------------------------------");
    }
    else
    {
      for(n=Start_Block;n<BlockBin_NumTemp;n++)
      {
        AddBin = (DataTemp[33+(n-Start_Block)*8]<<24)|(DataTemp[34+(n-Start_Block)*8]<<16)|(DataTemp[35+(n-Start_Block)*8]<<8)|(DataTemp[36+(n-Start_Block)*8]);
        LenBin = (DataTemp[37+(n-Start_Block)*8]<<24)|(DataTemp[38+(n-Start_Block)*8]<<16)|(DataTemp[39+(n-Start_Block)*8]<<8)|(DataTemp[40+(n-Start_Block)*8]);
        hexfile_app[n].BlockStartAddr = AddBin;
        hexfile_app[n].BlockDataLength = LenBin;
        hexfile_app[n].BlockEndAddr = hexfile_app[n].BlockStartAddr + hexfile_app[n].BlockDataLength - 1;
        hexfile_app[n].FilePos = FileNum; //从1开始，0为Flash部分
        for(i=0;i<50;i++)
          writeEx(-3,0,"DataTemp[%d] = %02X",i,DataTemp[i]);
        writeEx(-3,0,"--------------------------------");
        writeEx(-3,0,"hexfile_app[%d].BlockStartAddr =    0x%X",n,hexfile_app[n].BlockStartAddr);
        writeEx(-3,0,"hexfile_app[%d].BlockDataLength =   0x%X",n,hexfile_app[n].BlockDataLength);
        writeEx(-3,0,"--------------------------------");
      }
      BlockBin_Num = BlockBin_NumTemp;
    }
    fileClose(fileHandle_);
  }
}

/// <Bin>
void Down_BinFlash()
{
  writeEx(-3,0,"开始下载Flash");
  //驱动下载34
  FlashDriver_34();
  if(Exit_34_f==1)
  {
    Exit_Re_Prog = 1;
    return;
  }
  //驱动下载36
  FlashDriver_36();
  if(Exit_36_f==1)
  {
    Exit_Re_Prog = 1;
    return;
  }
  //驱动下载37  
  FlashDriver_37();
  if(Exit_37_f==1)
  {
    Exit_Re_Prog = 1;
    return;
  }
  if(@AUTO::FlashDriver_Switch == 0xFF)
    _Send0202_f(BlockBin_Flash,DriverSize,phyID,Resp_0202_f);
  else
  {
    if(@AUTO::FlashDriver_Switch==1)//J80J3-F
      _Send0202_f(J80J3_F,DriverSize,phyID,Resp_0202_f);
    else if(@AUTO::FlashDriver_Switch==2)//J80J3-A
      _Send0202_f(J80J3_A,DriverSize,phyID,Resp_0202_f);
    else if(@AUTO::FlashDriver_Switch==3)//J80J3-B
      _Send0202_f(J80J3_B,DriverSize,phyID,Resp_0202_f);
    else if(@AUTO::FlashDriver_Switch==4)//Z65H
      _Send0202_f(Z65H,DriverSize,phyID,Resp_0202_f);
  }
  writeEx(-3,0,"Flash下载完毕");
}

/// <RSA>
/* ============================================================================
   RSA1 签名数据获取函数
   功能：从 sysvar::AUTO::RSA1 装载文件路径，读取文本格式的 0x.. 数据，
   解析为字节数组 RSAData[]，设置 RSALen，输出长度与完整 16 进制。
   对应文件：E:\TRAE_IDE_WorkSpace\BT_Download\CBF与RSA文件\验签1.rsa
   有效数据：384 字节（RSA-3072 签名值）
   ============================================================================ */
/* 十六进制 ASCII 字符转数值（'0'~'9','A'~'F','a'~'f'） */
byte RSA_HexCharToVal(byte c)
{
  if (c <= 0x39) return (byte)(c - 0x30);
  return (byte)((c & 0x0F) + 9);            /* 'A'/'a' 均为 0x?1，低4位+9 */
}
/// <RSA>
/* 0~15 转十六进制 ASCII 字符 */
byte RSA_ValToHexChar(byte v)
{
  return (byte)(v < 10 ? 0x30 + v : 0x37 + v);  /* 0x37+10=0x41='A' */
}
/// <RSA>
/* 扫描 ASCII 缓冲中的 "0x.." 数据，追加到 RSAData */
void RSA_ParseAscii(byte buf[], long n)
{
  long i = 0;

  while (i + 3 < n && RSALen < elCount(RSAData))
  {
    if (buf[i] == 0x30 && (buf[i + 1] | 0x20) == 0x78)   /* 'x'/'X' 统一按小写判断 */
    {
      RSAData[RSALen++] = (byte)((RSA_HexCharToVal(buf[i + 2]) << 4) | RSA_HexCharToVal(buf[i + 3]));
      i += 4;
    }
    else
      i++;
  }
}
/// <RSA>
/* 打印 RSAData 16 进制：spaced=1 每行16字节带偏移空格；spaced=0 每行32字节连续 hex */
void RSA_PrintHex(byte spaced)
{
  char  line[128];
  dword i, j, step, k;

  step = (spaced == 1) ? 16 : 32;
  for (i = 0; i < RSALen; i += step)
  {
    line[0] = 0;
    for (j = 0; j < step && (i + j) < RSALen; j++)
    {
      k = j * ((spaced == 1) ? 3 : 2);
      line[k]     = (char)RSA_ValToHexChar((byte)(RSAData[i + j] >> 4));
      line[k + 1] = (char)RSA_ValToHexChar((byte)(RSAData[i + j] & 0x0F));
      if (spaced == 1) { line[k + 2] = ' '; line[k + 3] = 0; }
      else              { line[k + 2] = 0; }
    }
    if (spaced == 1)
    {
      line[strlen(line) - 1] = 0;   /* 去掉末尾空格 */
      write("RSA1: [%04X] %s", i, line);
    }
    else
      write("RSA1: %s", line);
  }
}
/// <RSA>
void RSA_LoadFromSysvar(char filePath[])
{
  byte  rawBuf[8192];
  dword hFile;
  long  readLen;

  RSALen = 0;
  /* 打开文件（CAPL: openFileRead，mode 0=文本，与工程内 hex/vbf 读取一致） */
  hFile = openFileRead(filePath, 0);
  if (hFile == 0)
  {
    write("RSA1 ERR: 无法打开文件 %s", filePath);
    return;
  }
  /* CAPL: fileGetBinaryBlock 读取原始字节（文本形式 0x.., ...），返回实际读取字节数 */
  readLen = fileGetBinaryBlock(rawBuf, elCount(rawBuf), hFile);
  fileClose(hFile);
  if (readLen <= 0)
  {
    write("RSA1 ERR: 文件读取失败或为空 %s", filePath);
    return;
  }
  
  /* 解析 "0x10, 0xA9, ..." -> RSAData[] */
  RSA_ParseAscii(rawBuf, readLen);

  /* 输出长度与首尾字节 */
  write("RSA1: 文件路径 = %s", filePath);
  write("RSA1: 原始文件读取字节数 = %d 字节", readLen);
  write("RSA1: 解析后有效长度 = %d 字节 (0x%X)", RSALen, RSALen);
  if (RSALen > 0)
    write("RSA1: 首字节 = 0x%02X, 末字节 = 0x%02X", RSAData[0], RSAData[RSALen - 1]);

  /* 16 进制输出：分行带偏移 + 连续串 */
  write("RSA1: 分行 16 进制输出（每行 16 字节）：");
  RSA_PrintHex(1);
  write("RSA1: 连续 16 进制串（长度 %d 字符）：", RSALen * 2);
  RSA_PrintHex(0);
}

/// <CBF>
int CBFFile_ReadAndSave(char FileName[])
{
  int result,i,fileHandle;
  byte DataTemp[4096];
  word inx ;
  fileHandle = OpenFileRead(FileName,1);
  result = fileGetBinaryBlock(DataTemp,elCount(DataTemp),fileHandle);
  fileClose(fileHandle);
  hexfile_app[0].BlockStartAddr = 0;
  hexfile_app[0].BlockDataLength = 0;
  
  inx=Hexandchar_strstr(DataTemp,0,"start_address");
  if(inx>0)
  {
    inx+=5; // start_address":"0x
    for(i=0 ; i < 8; i++)
      hexfile_app[0].BlockStartAddr = hexfile_app[0].BlockStartAddr << 4 | char2byte(DataTemp[inx+i]);
    write("BlockStartAddr = %X",hexfile_app[0].BlockStartAddr);
  }
  inx=Hexandchar_strstr(DataTemp,0,"length");
  if(inx>0)
  {
    inx+=5;//length":"0x
    for(i=0 ; i < 8; i++)
      hexfile_app[0].BlockDataLength = hexfile_app[0].BlockDataLength << 4 | char2byte(DataTemp[inx+i]);
    write("BlockDataLength = %X",hexfile_app[0].BlockDataLength);
  }
  /* 定位 JSON 结束符 "}]}",其返回值指向 "}]}}" 之后;
     随后紧跟 10 字节二进制头(起始地址4B BE + 长度4B BE + 校验2B),再后即为纯刷写数据。
     若未找到 "}]}",回退到原偏移计算方式。 */
  inx=Hexandchar_strstr(DataTemp,0,"\"}]}");
  if(inx>0)
  {
    inx += 8; // 跳过 10 字节二进制头,定位到纯数据起始
  }
  else
    inx += 20; // 兜底 添加 }]} 地址 以及 长度 偏移，算出数据起始位置(8 上方长度起始 +3 后括号+8 地址与长度)
  cbfDataOffset = inx;
  hexfile_app[0].BlockEndAddr = hexfile_app[0].BlockStartAddr + hexfile_app[0].BlockDataLength;

//  writeEx(-3,0,"cbfDataOffset = %X",cbfDataOffset);
//  writeEx(-3,0,"BlockStartAddr = 0x%08X",hexfile_app[0].BlockStartAddr);
//  writeEx(-3,0,"BlockDataLength = 0x%08X",hexfile_app[0].BlockDataLength);
//  writeEx(-3,0,"BlockEndAddr = 0x%08X",hexfile_app[0].BlockEndAddr);
  return inx;
}
/// <CBF>
/*
    [CBF流式]打开 CBF 文件并跳过头部到纯数据段起始。
    路径取 sysvar::AUTO::CBF1,跳过 cbfDataOffset 字节(由 CBFFile_ReadAndSave 计算)。
    返回:文件句柄(0表示失败)。句柄存入全局 cbfFileHandle 供后续读取使用。
    说明:CAPL File I/O 无 fileSeek,利用 fileGetBinaryBlock 顺序丢弃 cbfDataOffset 字节定位。
*/
dword CBFFile_OpenStream()
{
  char filename[400];
  int fileHandle_;
  byte skipBuf[0x400];
  dword skipLen,readLen,remaining,thisSkip;
  sysGetVariableString(sysvar::AUTO::CBF1,filename,elCount(filename));
  fileHandle_ = OpenFileRead(filename,1);
  if(fileHandle_==0)
  {
    writeEx(-3,1,"[CBF流式]打开 CBF 文件失败:%s",filename);
    return 0;
  }
  skipLen = cbfDataOffset;
  remaining = skipLen;
  while(remaining > 0)
  {
    if(remaining > elCount(skipBuf))
      thisSkip = elCount(skipBuf);
    else
      thisSkip = remaining;
    readLen = fileGetBinaryBlock(skipBuf,thisSkip,fileHandle_);
    if((long)readLen != (long)thisSkip)
    {
      writeEx(-3,1,"[CBF流式]跳过头部失败,剩余%d 实际读了%d",remaining,readLen);
      fileClose(fileHandle_);
      return 0;
    }
    remaining -= thisSkip;
  }
  cbfFileHandle = fileHandle_;
  return fileHandle_;
}

/// <CBF>
/*
    [CBF流式]关闭 CBF 流式文件句柄。
*/
void CBFFile_CloseStream()
{
  if(cbfFileHandle!=0)
  {
    fileClose(cbfFileHandle);
    cbfFileHandle = 0;
  }
}


/// <DownLoad>
/*---------------------------------------------函数---------------------------------------------*/
/*不同的主机厂的参数初始化*/
void CarConfig_Init()
{
  if(@AUTO::Config_Switch==1) //BYD
  {
