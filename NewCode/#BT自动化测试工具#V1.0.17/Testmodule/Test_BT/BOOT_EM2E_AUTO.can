  Exit_02DA04 = 0;            //执行到31 01 DA 04时退出流程标志位
  Exit_11 = 0;                //执行到ECU复位 11时退出流程标志位
  Exit_14 = 0;                //执行到14 FF FF FF时退出流程标志位
  
  Break_Download = 0;         //数据下载时退出标志位
  noCheck = 0;                //是否判断诊断响应，0：按预期结果判断，1：不判断响应
  
  TC_PowerDown_Before_FF00 = 0;  /*可靠性测试：内存擦除前切断电源*/
