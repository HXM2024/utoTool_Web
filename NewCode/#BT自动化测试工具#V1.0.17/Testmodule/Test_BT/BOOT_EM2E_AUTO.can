on preStart
{
  @sysvar::Prog_power::K30 = 0;
  testWaitForTimeout(100);
  @sysvar::Prog_power::K30Volt = 12;
  @sysvar::Prog_power::K30Curr = 5;
  @sysvar::Prog_power::K30 = 1;
}

on timer timer_3e80
{
  message 0x7DF msg={dlc=8};
  msg.byte(0)=0x2;
  msg.byte(1)=0x3E;
  msg.byte(2)=0x80;
  output(msg);
  if(funID == 0x7FF)
  {
    message 0x7FF msg={dlc=8};
    msg.byte(0)=0x2;
    msg.byte(1)=0x3E;
    msg.byte(2)=0x80;
    output(msg);
  }
  timer_3e80_index++;
  if(timer_3e80_index==timer_3e80_count)
  {
    cancelTimer(timer_3e80);
    timer_3e80_index=0;
  }
  else
  {
    setTimerCyclic(timer_3e80,@AUTO::Handshake_Send_Time);
  }
  
}


