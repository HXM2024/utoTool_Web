//CRC16校验算法
word _caculateCrc16(word crc16,byte data[],dword size)
{
  dword tmp;
  dword i;
  for(i=0;i<size;i++)
  {
    tmp=(crc16>>8)^data[i];
    crc16=((crc16<<8)^crc16tab[tmp]) & 0xFFFF;
  }
  return crc16;
}
//CRC32校验算法
dword  _caculateCrc32(byte data[],dword size)
{
    dword i;
    dword crc_32;
    crc_32=0xFFFFFFFF;
    for (i = 0; i < size; i++)
    {
      crc_32 = crc32tab[(crc_32 ^ data[i]) & 0xff] ^ (crc_32 >> 8);
    }
    return crc_32;
}
//用于擦除方式2和3中的CRC算法，区别在于crc_32的初始化不同；
dword _caculateCrc32_1(dword crc_32,byte data[],dword size)
{
    dword i;
    for (i = 0; i < size; i++)
    {
      crc_32 = crc32tab[(crc_32 ^ data[i]) & 0xff] ^ ((crc_32 >> 8)&0x00FFFFFF);
    }
    return crc_32;
}
//一行一行读取hex文件，将每2个16进制数组成一个字节，并装填到datahex[]数组中；
void _readhex(byte datahex[])
{
  char buffer[100];
  byte length;
  byte type;
  byte n;
  filehandle=fileGetStringSZ(buffer,elcount(buffer),glbHandle);

  //将字符串转换为可操作的16进制数，buffer[0]是“：”，表示每一行的开始
  for(n=1;n<100;n++)
  {
    if(buffer[n]==0)
      break;
    if(buffer[n]>=0X30&&buffer[n]<=0X39) //数字0~9转换
      buffer[n]=buffer[n]-0X30;
    if(buffer[n]>=0X41&&buffer[n]<=0X46)//字母A~F转换
      buffer[n]=buffer[n]-0X37;
  }
  
  //将转换后的字符串每两个字符组合成一个字节的数
  for(n=0;n<40;n++)
    datahex[n]=(buffer[2*n+1]<<4)|buffer[(n+1)*2];
}

//读取hex文件中每一行数据到datanow[]，并将其装填到data36[]，并返回地址和长度
byte _loadpage(byte data36[],byte datanow[],dword& addr,dword& length34)
{
  word addrh;
  word addrl;
  byte datanext[50];
    
  hextype=datanow[3];
  if(hextype==0)
  {
    byte linelength;
    dword totallength;
    dword addrlnow;
    dword addrlnext;
    word j;
    totallength=0;          
    addrl=((word)datanow[1]<<8)|datanow[2];
    if(addrl%0x20!=0 )//针对开头就没对齐0x20 && @AUTO::Config_Switch != 9
    {
      for(j=0;j<(addrl%0x20);j++)
      {
        data36[j]=padding;
        totallength+=1;
      }
      addrl-=(addrl%0x20);
    }
    addr=addr&0xFFFF0000;
    addr=addr|addrl;
    while(totallength<=0x10000)
    {
      linelength = datanow[0];
      
      addrlnow=((dword)datanow[1]<<8)|datanow[2];//这一行的16位地址
      _readhex(datanext);//获取下一行数据
      addrlnext=((dword)datanext[1]<<8)|datanext[2];//下一行的16位地址
      
      //判断本地址块是否结束，结束之前将这一行的数据装载到data36，并将下一行的数据赋给这一行
      if(_breakpage(addrlnow,addrlnext,datanext))
      {
        for(j=0;j<linelength;j++)
          data36[totallength+j]=datanow[j+4];
        totallength+=linelength;
        
        memcpy(datanow,datanext,elCount(datanext));
        break;
      }
      else
      {
        //根据这一行和下一行的地址差值减去这一行的长度判断是否需要填充，并将数据装载到data36
        if((addrlnext-addrlnow)==linelength)
        {
          for(j=0;j<linelength;j++)
            data36[totallength+j]=datanow[j+4];
          totallength+=linelength;
        }
        else
        {
          for(j=0;j<linelength;j++)
            data36[totallength+j]=datanow[j+4];
          totallength+=linelength;
          
          for(j=0;j<(addrlnext-(addrlnow+linelength));j++)
          {
            data36[totallength]=padding;
            totallength++;
          }
        }
        //将下一行的数据重新装载到这一行
        memcpy(datanow,datanext,elCount(datanext));
      }
      
    }
//    write("totallength = 0x%x",totallength);
    if(Continueaddr[0][eraseadd] == 2)
    {
      length34 += totallength;
    }
    else
      length34 = totallength;
    
    if(((datanow[3] == 1) || (datanow[3] == 5)) && @Faultinsert::TC_Continue_36_A == 1) 
    {
      write("/*--------------- 读取到最后一行 ---------------*/");
      END_Pos = 2; 
    }
    return 1;
  }
  else if(hextype==5)
    return 0;
  else if(hextype==1)
  {
    return 0;
  }
  else
    return 0;
}

//读取hex文件中每一行数据到datanow[]，并将其装填到data36[]，并返回地址和长度
byte _loadpage1(byte data36[],byte datanow[],dword& addr,dword& length34)
{
  word addrh;
  word addrl;
  byte datanext[50];
    
  hextype=datanow[3];
  if(hextype==0)
  {
    byte linelength;
    dword totallength;
    dword addrlnow;
    dword addrlnext;
    word j;
    totallength = length34;          
    addrl=((word)datanow[1]<<8)|datanow[2];
    if(addrl%0x20!=0 )//针对开头就没对齐0x20 && @AUTO::Config_Switch != 9
    {
      for(j=0;j<(addrl%0x20);j++)
      {
        data36[totallength + j]=padding;
        totallength+=1;
      }
      addrl-=(addrl%0x20);
    }
    addr=addr&0xFFFF0000;
    addr=addr|addrl;
    while(totallength<=0x10000)
    {
      linelength = datanow[0];
      
      addrlnow=((dword)datanow[1]<<8)|datanow[2];//这一行的16位地址
      _readhex(datanext);//获取下一行数据
      addrlnext=((dword)datanext[1]<<8)|datanext[2];//下一行的16位地址
      
      //判断本地址块是否结束，结束之前将这一行的数据装载到data36，并将下一行的数据赋给这一行
      if(_breakpage(addrlnow,addrlnext,datanext))
      {
        for(j=0;j<linelength;j++)
          data36[totallength+j]=datanow[j+4];
        totallength+=linelength;
        
        memcpy(datanow,datanext,elCount(datanext));
        break;
      }
      else
      {

        //根据这一行和下一行的地址差值减去这一行的长度判断是否需要填充，并将数据装载到data36
        if((addrlnext-addrlnow)==linelength)
        {
          for(j=0;j<linelength;j++)
          {
            data36[totallength+j]=datanow[j+4];
            write("datanow[%d+4] = %x;",j,datanow[j+4]);
          }
          totallength+=linelength;
        }
        else
        {
          for(j=0;j<linelength;j++)
            data36[totallength+j]=datanow[j+4];
          totallength+=linelength;
          
          for(j=0;j<(addrlnext-(addrlnow+linelength));j++)
          {
            data36[totallength]=padding;
            totallength++;
          }
        }
        //将下一行的数据重新装载到这一行
        memcpy(datanow,datanext,elCount(datanext));
      }
      
    }
//    if(Continueaddr[0][eraseadd] == 2)
//    {
//      length34 += totallength;
//    }
//    else
      length34 = totallength;
    
    if(datanow[3] == 1 && @Faultinsert::TC_Continue_36_A == 1) 
    {
      writeEx(-3,1,"/*--------------- 读取到最后一行 ---------------*/");
      END_Pos = 2; 
    }
    return 1;
  }
  else if(hextype==5)
    return 0;
  else if(hextype==1)
  {
    return 0;
  }
  else
    return 0;
}

//判断是否读取到最后一行
byte _breakpage(word addrlnow,word addrlnext,byte datanext[])
{
  /*word addrh;
  addrh=(word)(addr>>16);*/
  if((addrlnext-addrlnow)>0x80 )
    return 1;
//  if(@AUTO::Config_Switch == 9 &&  (linelength < 0x20)  && ((addrlnext-addrlnow) > linelength))
//    return 1;
  if(datanext[3]==4 || datanext[3]==5 || datanext[3]==1 || datanext[3]==2)
    return 1;
  else
    return 0;
}

//发送请求并等待响应。如果响应是多帧不要使用此函数，因为p2cmax时间可能不够
void _SendAndWriteReport(diagRequest* obj,dword msgID)
{
  char comment[70];
  byte primitiveRaw[30];
  long size;
  byte i;

  _diagSendMsg(msgID,obj);
  testWaitForDiagRequestSent(obj,1000);
//  testWaitForDiagResponse(obj,p2cmax);
}
//判断收到响应的每个字节
//参数obj: 响应报文
//参数req: 诊断请求
//参数passcondition: {-1:期望收到肯定响应,  >0:期望的否定响应}
int _CheckResp_Byte(message* obj,diagRequest* req,int passcondition)
{
  dword ByteCount;
  dword Temp_Value;
    testStep("passcondition"," %d ",passcondition);
  if(passcondition==-1)//期望收到肯定响应
  {
    if(obj.Byte(1)==req.GetPrimitiveByte(0)+0x40)//收到肯定响应
    {
      //不同的服务
      if(req.GetPrimitiveByte(0)==0x10)//10服务
      {
        if(@AUTO::Config_Switch == 7 && (req.GetPrimitiveByte(1) == 0x03 || req.GetPrimitiveByte(1) == 0x01))
        {
//          if(obj.byte(0)== 6)
          if(obj.byte(0)== 2)
            return 1;
        }
        else
        {
          if(obj.byte(0)==6 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)<<8|obj.Byte(4)==p2cmax && obj.Byte(5)<<8|obj.Byte(6)==p2exs)
            return 1;
          else
            return -1;
        }
      }
      else if(req.GetPrimitiveByte(0)==0x14)//14服务
      {
        if(obj.byte(0)==1)
        {
          curAppValid = 1;
          return 1;
        }
        else
          return -1;
      }
      else if(req.GetPrimitiveByte(0)==0x11)//11服务
      {
        if(obj.byte(0)==2 && obj.Byte(2)==req.GetPrimitiveByte(1))
          return 1;
        else
          return -1;
      }
      else if(req.GetPrimitiveByte(0)==0x22)//22服务
      {
        if(obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2))
          return 1;
        else
          return -1;
      }
      else if(req.GetPrimitiveByte(0)==0x2E)//2E服务
      {
        if(obj.byte(0)==3 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2))
          return 1;
        else
          return -1;
      }
      else if(req.GetPrimitiveByte(0)==0x27 && req.GetPrimitiveByte(1)==SeedLevel)//27 01服务
      {
        if(obj.byte(1)==0x67 && obj.Byte(2)==req.GetPrimitiveByte(1))
          return 1;
        else
          return -1;
      }
      else if(req.GetPrimitiveByte(0)==0x27 && req.GetPrimitiveByte(1)==SeedLevel+1)//27 02服务
      {
        if(obj.byte(1)==0x67 && obj.Byte(2)==req.GetPrimitiveByte(1))
          return 1;
        else
          return -1;
      }
      else if(req.GetPrimitiveByte(0)==0x31)//31服务
      {
        if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==3)//BYD || Geely 1.0 
        {
          if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
            return 1;
          else
            return -1;
        }
        else if(@AUTO::Config_Switch==2)//ChangAn
        {
          if(obj.byte(0)==4 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3))
            return 1;
          else
            return -1;
        }
        else if(@AUTO::Config_Switch==4)//Geely3.0
        {
          //31 01 02 12
          if(req.GetPrimitiveByte(2)==0x02 && req.GetPrimitiveByte(3)==0x12)
          {
            testStep("","0x%02X 0x%02X 0x%02X 0x%02X 0x%02X 0x%02X 0x%02X",req.GetPrimitiveByte(0),req.GetPrimitiveByte(1),req.GetPrimitiveByte(2),req.GetPrimitiveByte(03),req.GetPrimitiveByte(4)
            ,req.GetPrimitiveByte(5),req.GetPrimitiveByte(6));
            if(obj.byte(0)==6 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3)
              && obj.Byte(5)==PassState_31[0] && obj.Byte(6)==PassState_31[1])
              return 1;
            else
              return -1;
          }
          //31 01 02 05
          else if(req.GetPrimitiveByte(2)==0x02 && req.GetPrimitiveByte(3)==0x05)
          {
            if(obj.byte(2)==0x71 && obj.Byte(3)==req.GetPrimitiveByte(1) && obj.Byte(4)==req.GetPrimitiveByte(2) && obj.Byte(5)==req.GetPrimitiveByte(3)
              && obj.Byte(6)==PassState_31[0] && obj.Byte(7)==PassState_31[1])
              return 1;
            else
              return -1;
          }
          else
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) 
              && obj.Byte(5)==PassState_31[0])
              return 1;
            else
              return -1;
          }
        }
        else if(@AUTO::Config_Switch==5)//鑫源
        {
          //31 01 FF 00
          if(req.GetPrimitiveByte(2)==0xFF && req.GetPrimitiveByte(3)==0x00)
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3))
              return 1;
            else
              return -1;
          }
          else
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
              return 1;
            else
              return -1;
          }
        }
        else if(@AUTO::Config_Switch==6)//瑞驰
        {
          //31 01 FF 00
          if(req.GetPrimitiveByte(2)==0xFF && req.GetPrimitiveByte(3)==0x00)
          {
            if(obj.byte(0)==4 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3))
              return 1;
            else
              return -1;
          }
          else
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
              return 1;
            else
              return -1;
          }
        }
        else if(@AUTO::Config_Switch==7)//奇瑞
        {
          //31 02 XX XX
          if(req.GetPrimitiveByte(1)==0x02)
          {
            //31 02 FF 00
            if(req.GetPrimitiveByte(2)==0xFF && req.GetPrimitiveByte(3)==0x00)
            {
              if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[2])
                return 1;
              else
                return -1;
            }
            //31 02 FF 01
            if(obj.byte(0)==6 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==0x04 && obj.Byte(6)==PassState_31[0])
              return 1;
            else
              return -1;
          }
          //31 03 XX XX
          else if(req.GetPrimitiveByte(1)==0x03)
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[1])
              return 1;
            else
              return -1;
          }
        }
        else if(@AUTO::Config_Switch==11)//奇瑞T1V
        {
//          writeEx(-3,0,"%02X %02X %02X %02X",req.GetPrimitiveByte(0),req.GetPrimitiveByte(1),req.GetPrimitiveByte(2),req.GetPrimitiveByte(3));
          //31 02 XX XX
          if(req.GetPrimitiveByte(1)==0x02)
          {
            //31 02 FF 00
            if(req.GetPrimitiveByte(2)==0xFF && req.GetPrimitiveByte(3)==0x00)
            {
              if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[2])
                return 1;
              else
                return -1;
            }
            //31 02 FF 01
            if(obj.byte(0)==6 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==0x04 && obj.Byte(6)==PassState_31[0])
              return 1;
            else
              return -1;
          }
          //31 03 XX XX
          else if(req.GetPrimitiveByte(1)==0x03)
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[1])
              return 1;
            else
              return -1;
          }
          else if(req.GetPrimitiveByte(1)==0x01 && req.GetPrimitiveByte(0)==0x31 && req.GetPrimitiveByte(2)==0x02  && req.GetPrimitiveByte(3)==0x03)/*程序BUG新增，待修复后删除*/
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3))
              return 1;
            else
              return -1;
          }
          else
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
              return 1;
            else
              return -1;
          }
        }
        else if(@AUTO::Config_Switch==9)//小康
        {
          //31 01 02 02
          if(req.GetPrimitiveByte(1)==0x01 && req.GetPrimitiveByte(2)==0x02 && req.GetPrimitiveByte(3)==0x02)
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
              return 1;
            else
              return -1;
          }
          //31 01 FF 01
          else if(req.GetPrimitiveByte(1)==0x01 && req.GetPrimitiveByte(2)==0xFF && req.GetPrimitiveByte(3)==0x01)
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
              return 1;
            else
              return -1;
          }
          else
          {
            if(obj.byte(0)==4 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3))
              return 1;
            else
              return -1;
          }
        }
        else if(@AUTO::Config_Switch==12)//广汽
        {
          if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
            return 1;
          else
            return -1;
        }
        else if(@AUTO::Config_Switch==13)//V8
        {
          //31 01 02 02/ 31 01 FF 00/ 31 01 FF 01
          {
            if(obj.byte(0)==4 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3))
              return 1;
            else
              return -1;
          }
        }
        //五菱 || 赛力斯
        else 
        {
          //31 01 FF 00
          if(req.GetPrimitiveByte(2)==0xFF && req.GetPrimitiveByte(3)==0x00)
          {
            if(obj.byte(0)==4 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3))
              return 1;
            else
              return -1;
          }
          else
          {
            if(obj.byte(0)==5 && obj.Byte(2)==req.GetPrimitiveByte(1) && obj.Byte(3)==req.GetPrimitiveByte(2) && obj.Byte(4)==req.GetPrimitiveByte(3) && obj.Byte(5)==PassState_31[0])
              return 1;
            else
              return -1;
          }
        }
      }
      else if(req.GetPrimitiveByte(0)==0x34)//34服务
      {
        if(@AUTO::Config_Switch==11) //奇瑞
        {
          if(obj.byte(0)==6 && obj.byte(2)==0x40 && obj.byte(3)==0 && obj.byte(4)==0 && obj.byte(5)==0x0F && obj.byte(6)==0xFF)
            return 1;
          else
            return -1;
        }
        else
        {
          if(obj.byte(0)==4 && obj.byte(2)==0x20 && obj.byte(3)<<8|obj.byte(4)==DataLengthmax_34)
            return 1;
          else
            return -1;
        }
      }
      else if(req.GetPrimitiveByte(0)==0x36)//36服务
      {
        if(obj.byte(0)==2 && obj.Byte(2)==req.GetPrimitiveByte(1))
          return 1;
        else
          return -1;
      }
      else if(req.GetPrimitiveByte(0)==0x37)//37服务
      {
        if(@AUTO::Config_Switch==2)//ChangAn
        {
          if(obj.byte(0)==3)
            return 1;
          else
            return -1;
        }
        else if(@AUTO::Config_Switch==7)//奇瑞
        {
          if(obj.byte(0)==2)
            return 1;
          else
            return -1;
        }
        else if(@AUTO::Config_Switch==9)//小康
        {
          if(obj.byte(0)==5)
            return 1;
          else
            return -1;
        }
        
        //BYD || Geely 1.0 || 鑫源 || 瑞驰 || 五菱
        else 
        {
          if(obj.byte(0)==1)
            return 1;
          else
            return -1;
        }
      }
      else//其它服务
      {
        if(obj.byte(0)==2 && obj.Byte(2)==req.GetPrimitiveByte(1))
          return 1;
        else
          return -1;
      }
    }
    //收到多帧响应，判断首帧
    else if(obj.Byte(2)==req.GetPrimitiveByte(0)+0x40)
    {
      if(obj.Byte(3)==req.GetPrimitiveByte(1) && obj.Byte(4)==req.GetPrimitiveByte(2))
        return 1;
      else
        return -1;
    }
    //收到否定响应
    else if(obj.Byte(1)==0x7F)
      return -1;
  }
  else if(passcondition > 0)//期望收到否定响应
  {
    if(obj.Byte(1)==0x7F && obj.Byte(2)==req.GetPrimitiveByte(0) && obj.Byte(3)==passcondition)
      return 1;
    else 
      return -1;
  }
  return 0;
}


//根据测试通过条件，在报告上标记结果，判断响应时的各个字节
_TestResult(diagRequest* obj,char stepid[],int passcondition)
{
  char comment[50];
  if(noCheck==1)//不判断响应
  {
    testStepPass(stepid,"不判断诊断的响应");
  }
  else if(passcondition==-1)//期望收到肯定响应
  {
    snprintf(comment,elCount(comment),"期望收到肯定响应");
    //不同的服务
    if(obj.GetPrimitiveByte(0)==0x10)//10服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) 
        && obj.GetRespPrimitiveByte(2)<<8|obj.GetRespPrimitiveByte(3)==0x32 && obj.GetRespPrimitiveByte(4)<<8|obj.GetRespPrimitiveByte(5)==p2exs) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4),obj.GetRespPrimitiveByte(5));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4),obj.GetRespPrimitiveByte(5));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x11)//11服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x22)//22服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),
          obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4),obj.GetRespPrimitiveByte(5),obj.GetRespPrimitiveByte(6));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),
          obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4),obj.GetRespPrimitiveByte(5),obj.GetRespPrimitiveByte(6));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x2E)//2E服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x27 && obj.GetPrimitiveByte(1)==0x01)//27 01服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X %02X",comment,
          obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),
          obj.GetRespPrimitiveByte(4),obj.GetRespPrimitiveByte(5));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X %02X",comment,
          obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),
          obj.GetRespPrimitiveByte(4),obj.GetRespPrimitiveByte(5));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x27 && obj.GetPrimitiveByte(1)==0x02)//27 02服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x28)//28服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x3E)//3E服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x85)//85服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1)) 
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x31)//31服务
    {
      //收到肯定响应
      if(diagGetLastResponseCode(obj)==-1)
      {
        //不同主机厂，响应不同
        if(@AUTO::Config_Switch==1)//BYD
        {
          if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2) 
          && obj.GetRespPrimitiveByte(3)==obj.GetPrimitiveByte(3) && obj.GetRespPrimitiveByte(4)==PassState_31[0])
            testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
          else
            testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
        }
        else if(@AUTO::Config_Switch==2)//ChangAn
        {
          if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2) 
          && obj.GetRespPrimitiveByte(3)==obj.GetPrimitiveByte(3))
            testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3));
          else
            testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3));
        }
        else if(@AUTO::Config_Switch==5)//鑫源
        {
          //31 01 FF 00
          if(obj.GetPrimitiveByte(2)==0xFF && obj.GetPrimitiveByte(3)==0x00)
          {
            if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2) 
            && obj.GetRespPrimitiveByte(3)==obj.GetPrimitiveByte(3))
              testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3));
            else
              testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3));
          }
          else
          {
            if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2) 
            && obj.GetRespPrimitiveByte(3)==obj.GetPrimitiveByte(3) && obj.GetRespPrimitiveByte(4)==PassState_31[0])
              testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
            else
              testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
          }
        }
        else if(@AUTO::Config_Switch==11)//奇瑞T1V
        {
          if(obj.GetPrimitiveByte(0) == 0x31 && obj.GetPrimitiveByte(1) == 0x01 && obj.GetPrimitiveByte(2) == 0x02 && obj.GetPrimitiveByte(3) == 0x03) /*程序BUG新增，修复后删除*/
          {
            if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2) 
            && obj.GetRespPrimitiveByte(3)==obj.GetPrimitiveByte(3) /*&& obj.GetRespPrimitiveByte(4)== PassState_31[0]*/ )
              testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
            else
              testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
          }
          else
          {
            if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1) && obj.GetRespPrimitiveByte(2)==obj.GetPrimitiveByte(2) 
            && obj.GetRespPrimitiveByte(3)==obj.GetPrimitiveByte(3) && obj.GetRespPrimitiveByte(4)== PassState_31[0] )
              testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
            else
              testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3),obj.GetRespPrimitiveByte(4));
          }
        }
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x34)//34服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==0x20 && obj.GetRespPrimitiveByte(2)<<8|obj.GetRespPrimitiveByte(3)==DataLengthmax_34)
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2),obj.GetRespPrimitiveByte(3));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x36)//36服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40 && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(1))
          testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else if(obj.GetPrimitiveByte(0)==0x37)//37服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
      {
        if(obj.GetRespPrimitiveByte(0)==obj.GetPrimitiveByte(0)+0x40)
          testStepPass(stepid,"%s，实际收到肯定响应:%02X",comment,obj.GetRespPrimitiveByte(0));
        else
          testStepFail(stepid,"%s，实际收到肯定响应:%02X",comment,obj.GetRespPrimitiveByte(0));
      }
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
    else //其它服务
    {
      if(diagGetLastResponseCode(obj)==-1)//收到肯定响应
        testStepPass(stepid,"%s，实际收到肯定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      //没有收到肯定响应
      else if(diagGetLastResponseCode(obj)>0)
        testStepFail(stepid,"%s，实际收到否定响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际没收到响应",comment);
    }
  }
  //期望不收到响应
  else if(passcondition==0)
  {
    snprintf(comment,elCount(comment),"期望不响应");
    if(diagGetLastResponseCode(obj)==0)
      testStepPass(stepid,"%s，实际未收到响应",comment);
    else
      testStepFail(stepid,"%s，实际收到响应:%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
  }
  //期望收到否定响应
  else
  {
    snprintf(comment,elCount(comment),"期望收到否定响应NRC%02X",passcondition);
    
    if(diagGetLastResponseCode(obj)>0)//收到否定响应
    {
      if(obj.GetRespPrimitiveByte(0)==Negative_response && obj.GetRespPrimitiveByte(1)==obj.GetPrimitiveByte(0) && obj.GetRespPrimitiveByte(2)==passcondition)
        testStepPass(stepid,"%s，实际收到否定响应%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
      else
        testStepFail(stepid,"%s，实际收到否定响应%02X %02X %02X",comment,obj.GetRespPrimitiveByte(0),obj.GetRespPrimitiveByte(1),obj.GetRespPrimitiveByte(2));
    }
    else//没有收到否定响应
      testStepFail(stepid,"%s，实际没有收到否定响应",comment);
  }
  if(@Test::stoptest==0)
  {
    if(diagGetLastResponseCode(obj)!=passcondition)
    {
      snprintf(comment,elCount(comment),"发生异常中断刷写");
      writeEx(-3,3,comment);
      testStepFail(comment);
      stop();
      testWaitForTimeout(1000);
    }
  }
}
//判断流控帧、NRC78及响应帧;
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void  _get_FC(diagrequest* req,dword msgID,char stepid[],int passcondition)
{
  message 0x00 msg;
  message 0x01 msg1;//用于判断流控帧
  message 0x02 msg2;//用于判断响应帧
  double starttime,starttime1,starttime2;
  double endtime,endtime1,endtime2;
  byte result,result1;
  byte sid;
  dword Count_NRC78;
  char comment[50];
  byte Stop_Pos,PassWait;
  Stop_Pos = 0; Count_NRC78 = 0;PassWait = 0;
  if(@Faultinsert::TC_BT_AppValid == 1 && @Faultinsert::TC_Miss_GetFc == 1)
  {
    return;
  }
  /*功能寻址下 部分NRC不响应，可进行补充*/
  if(msgID==funID && (passcondition==0x12 || passcondition==0x13))
  {
    passcondition = 0;
  }
  testWaitForMessage(msgID,1000);
  testGetWaitEventMsgData(msg);
  if(msg.byte(1) == 0x3E)
  {
    testWaitForMessage(msgID,1000);
    testGetWaitEventMsgData(msg);
  }
  if(msg.byte(0)>>4 == 1)
  {
    starttime = (double)timeNow()/100;
    testWaitForMessage(revID,p2cmax);
    testGetWaitEventMsgData(msg1);
    /*判断是否收到流控帧*/
    if(msg1.byte(0) == 0x30)
    {
      endtime = (double)timeNow()/100;
      if(endtime - starttime <= p2cmax)
      {
        testStepPass(stepid,"收到流控帧，流控帧响应时间为:%fms",endtime-starttime);
      }
      else
      {
        testStepFail(stepid,"响应超时，流控帧响应时间为:%fms",endtime-starttime);
        Stop_Pos = 1;
      }
      /*等待诊断请求数据全部发送完*/
      testWaitForDiagRequestSent(req,3000);
    }
    else if(msg1.byte(0) == 0x32)
    {
      endtime = (double)timeNow()/100;
      if(endtime - starttime <= p2cmax)
      {
        testStepPass(stepid,"收到溢出流控帧，响应时间为:%fms",endtime-starttime);
      }
      else
      {
        testStepFail(stepid,"响应超时，流控帧响应时间为:%fms",endtime-starttime);
        Stop_Pos = 1;
      }
    }
    starttime1 = (double)timeNow()/100;
    /*判断流控帧后续的响应*/
    testWaitForMessage(revID,1000); 
    testGetWaitEventMsgData(msg2);
    /*收到积极响应*/
    if(msg2.byte(1)==req.GetPrimitiveByte(0)+0x40)
    {
      endtime1 = (double)timeNow()/100;
      if(endtime1 - starttime1 <= p2cmax)
      {
        if(_CheckResp_Byte(msg2,req,passcondition)==1)
          testStepPass(stepid,"与预期相符，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
          msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime1-starttime1);
        else
        {
          testStepFail(stepid,"与预期不符，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
          msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime1-starttime1);
          Stop_Pos = 1;
        }
      }
      else
      {
        testStepFail(stepid,"响应超时，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
        msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime1-starttime1);
        Stop_Pos = 1;
      }
    }
    /*收到非NRC78的消极响应*/
    else if(msg2.byte(1)==0x7F && msg2.byte(3)!=0x78)
    {
      endtime1 = (double)timeNow()/100;
      if(endtime1 - starttime1 <= p2cmax)
      {
        if(_CheckResp_Byte(msg2,req,passcondition)==1)
          testStepPass(stepid,"与预期相符，实际收到否定响应:%02X %02X %02X，响应时间为:%fms",msg2.byte(1),msg2.byte(2),msg2.byte(3),endtime1-starttime1);
        else
        {
          testStepFail(stepid,"与预期不符，实际收到否定响应:%02X %02X %02X，响应时间为:%fms",msg2.byte(1),msg2.byte(2),msg2.byte(3),endtime1-starttime1);
          Stop_Pos = 1;
        }
      }
      else
      {
        testStepFail(stepid,"响应超时，收到否定响应:%02X %02X %02X，响应时间为:%fms",msg2.byte(1),msg2.byte(2),msg2.byte(3),endtime1-starttime1);
        Stop_Pos = 1;
      }
    }
    /*收到NRC78*/
    else if(msg2.byte(3)==0x78)
    {
      endtime1 = (double)timeNow()/100;
      do
      {
        Count_NRC78++;
        starttime2 = (double)timeNow()/100;
        /*第一次收到NRC78*/
        if(Count_NRC78 == 1)
        {
          endtime1 = (double)timeNow()/100;
          if(endtime1 - starttime1 <= p2cmax)
            testStepPass(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime1-starttime1);
          else
          {
            testStepFail(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime1-starttime1);
            Stop_Pos = 1;
          }
          if(@Faultinsert::TC_Handshake_after_NRC78 == 1) //ECU响应NRC78后马上发2帧功能寻址的3E80
          {
//            timer_3e80_count=2;
//            setTimer(timer_3e80,0);
//            if(req.GetPrimitiveByte(0) != 0x11) // 20260421：防止11服务被干扰
              PassWait = _handshake_times(msg2,funID,2);
            
          }
        }
        else
        {
          endtime2 = (double)timeNow()/100;
          if(endtime2 - endtime1 >= (0.3*NRC78_Cycle))
            testStepPass(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime2 - endtime1);
          else
          {
            testStepFail(stepid,"第%d次收到NRC78，响应时间为:%fms ,预期时间为 %fms以上",Count_NRC78,endtime2 - endtime1,0.3*NRC78_Cycle);
            Stop_Pos = 1;
          }
          if(endtime2 - endtime1 <= NRC78_Cycle)
            testStepPass(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime2 - endtime1);
          else
          {
            testStepFail(stepid,"第%d次收到NRC78，响应时间为:%fms ,预期时间为 %fms以内",Count_NRC78,endtime2 - endtime1,NRC78_Cycle);
            Stop_Pos = 1;
          }
          endtime1 = (double)timeNow()/100;
        }
        /*判断NRC78后5s内是否收到最终响应*/
        if(PassWait == 0)
        {
          testWaitForMessage(revID,NRC78_RespTime);
          testGetWaitEventMsgData(msg2);
        }
        /*收到肯定响应*/
        if(msg2.byte(1)==req.GetPrimitiveByte(0)+0x40)
        {
          endtime2 = (double)timeNow()/100;
          if(endtime2 - starttime2 <= NRC78_RespTime)
          {
            if(_CheckResp_Byte(msg2,req,passcondition)==1)
              testStepPass(stepid,"与预期相符，最终收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
              msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
            else
            {
              testStepFail(stepid,"与预期不符，最终收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
              msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
              Stop_Pos = 1;
            }
          }
          else
          {
            testStepFail(stepid,"响应超时，最终收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
            msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
            Stop_Pos = 1;
          }
          break;
        }
        /*收到非NRC78的否定响应*/
        else if(msg2.byte(1)==0x7F && msg2.byte(3)!=0x78)
        {
          endtime2 = (double)timeNow()/100;
          if(endtime2 - starttime2 <= NRC78_RespTime)
          {
            if(_CheckResp_Byte(msg2,req,passcondition)==1)
              testStepPass(stepid,"与预期相符，最终收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
              msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
            else
            {
              testStepFail(stepid,"与预期不符，最终收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
              msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
              Stop_Pos = 1;
            }
          }
          else
          {
            testStepFail(stepid,"响应超时，最终收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
            msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
            Stop_Pos = 1;
          }
          break;
        }
      }while(msg2.byte(3)==0x78);
      /*判断NRC78响应次数*/
      if(Count_NRC78 <= NRC78_max)
        testStepPass(stepid,"连续响应%d次NRC78",Count_NRC78);
      else
      {
        testStepFail(stepid,"连续响应%d次NRC78",Count_NRC78);
        Stop_Pos = 1;
      }
      Count_NRC78 = 0;
    }
  }
  else
  {
    starttime1 = (double)timeNow()/100;
    if(SOS_Flage == 1 && passcondition==0)
      result=0;
    else
      result=testWaitForMessage(revID,1000);
    testGetWaitEventMsgData(msg1);
    if(result==0)
    {
      if(passcondition==0)
        testStepPass(stepid,"预期无响应，实际未收到响应");
      else
      {
        testStepFail(stepid,"响应超时，1s内未收到响应");
        Stop_Pos = 1;
      }
    }
    /*收到多帧，判断首帧*/
    else if(msg1.byte(0)>>4 == 1)
    {
      endtime1 = (double)timeNow()/100;
      if(msg1.byte(2)==req.GetPrimitiveByte(0)+0x40)
      {
        if(endtime1 - starttime1 <= p2cmax)
        {
          if(_CheckResp_Byte(msg1,req,passcondition) == 1)
            testStepPass(stepid,"与预期相符，收到多帧积极响应，首帧响应时间为%fms",endtime1 - starttime1);
          else
          {
            testStepFail(stepid,"与预期不符，收到多帧积极响应，首帧响应时间为%fms",endtime1 - starttime1);
            Stop_Pos = 1;
          }
        }
        else
        {
          testStepFail(stepid,"首帧响应超时，响应时间为%fms",endtime1 - starttime1);
          Stop_Pos = 1;
        }
      }
      testWaitForDiagResponse(req,1000);
    }
    /*CANFD格式单帧响应*/
    else if(msg1.byte(0) == 0 && req.GetPrimitiveByte(0)==0x22)
    {
      endtime1 = (double)timeNow()/100;
      if(msg1.byte(2)==req.GetPrimitiveByte(0)+0x40)
      {
        if(endtime1 - starttime1 <= p2cmax)
        {
          if(_CheckResp_Byte(msg1,req,passcondition) == 1)
            testStepPass(stepid,"与预期相符，收到多帧积极响应，首帧响应时间为%fms",endtime1 - starttime1);
          else
          {
            testStepFail(stepid,"与预期不符，收到多帧积极响应，首帧响应时间为%fms",endtime1 - starttime1);
            Stop_Pos = 1;
          }
        }
        else
        {
          testStepFail(stepid,"首帧响应超时，响应时间为%fms",endtime1 - starttime1);
          Stop_Pos = 1;
        }
      }
      testWaitForDiagResponse(req,1000);
    }
    else
    {
      /*收到积极响应*/
      if(msg1.byte(1)==req.GetPrimitiveByte(0)+0x40)
      {
        endtime1 = (double)timeNow()/100;
        if(endtime1 - starttime1 <= p2cmax)
        {
          if(_CheckResp_Byte(msg1,req,passcondition) == 1)
            testStepPass(stepid,"与预期相符，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
            msg1.byte(1),msg1.byte(2),msg1.byte(3),msg1.byte(4),msg1.byte(5),msg1.byte(6),msg1.byte(7),endtime1-starttime1);
          else
          {
            testStepFail(stepid,"与预期不符，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
            msg1.byte(1),msg1.byte(2),msg1.byte(3),msg1.byte(4),msg1.byte(5),msg1.byte(6),msg1.byte(7),endtime1-starttime1);
            Stop_Pos = 1;
          }
        }
        else
        {
          testStepFail(stepid,"响应超时，实际收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
          msg1.byte(1),msg1.byte(2),msg1.byte(3),msg1.byte(4),msg1.byte(5),msg1.byte(6),msg1.byte(7),endtime1-starttime1);
          Stop_Pos = 1;
        }
      }
      /*收到否定响应*/
      else if(msg1.byte(1)==0x7F && msg1.byte(3)!=0x78)
      {
        endtime1 = (double)timeNow()/100;
        if(endtime1 - starttime1 <= p2cmax)
        {
          if(_CheckResp_Byte(msg1,req,passcondition) == 1)
            testStepPass(stepid,"与预期相符，实际收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
            msg1.byte(1),msg1.byte(2),msg1.byte(3),msg1.byte(4),msg1.byte(5),msg1.byte(6),msg1.byte(7),endtime1-starttime1);
          else
          {
            testStepFail(stepid,"与预期不符，实际收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
            msg1.byte(1),msg1.byte(2),msg1.byte(3),msg1.byte(4),msg1.byte(5),msg1.byte(6),msg1.byte(7),endtime1-starttime1);
            Stop_Pos = 1;
          }
        }
        else
        {
          testStepFail(stepid,"响应超时，实际收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
          msg1.byte(1),msg1.byte(2),msg1.byte(3),msg1.byte(4),msg1.byte(5),msg1.byte(6),msg1.byte(7),endtime1-starttime1);
          Stop_Pos = 1;
        }
      }
      /*收到NRC78*/
      else if(msg1.byte(1)==0x7F && msg1.byte(3)==0x78)
      {
        do
        {
          Count_NRC78++;
          starttime2 = (double)timeNow()/100;
          /*第一次收到NRC78*/
          if(Count_NRC78 == 1)
          {
            endtime1 = (double)timeNow()/100;
            if(endtime1 - starttime1 <= p2cmax)
              testStepPass(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime1-starttime1);
            else
            {
              testStepFail(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime1-starttime1);
              Stop_Pos = 1;
            }
            if(@Faultinsert::TC_Handshake_after_NRC78 == 1) //ECU响应NRC78后马上发2帧功能寻址的3E80
            {
  //            timer_3e80_count=2;
  //            setTimer(timer_3e80,0);
//              if(req.GetPrimitiveByte(0) != 0x11) // 20260421：防止11服务被干扰
                PassWait = _handshake_times(msg2,funID,2);
            }
          }
          else
          {
            endtime2 = (double)timeNow()/100;
            if(endtime2 - endtime1 >= (0.3*NRC78_Cycle))
              testStepPass(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime2 - endtime1);
            else
            {
              testStepFail(stepid,"第%d次收到NRC78，响应时间为:%fms ,预期时间为 %fms以上",Count_NRC78,endtime2 - endtime1,0.3*NRC78_Cycle);
              Stop_Pos = 1;
            }
            if(endtime2 - endtime1 <= NRC78_RespTime)
              testStepPass(stepid,"第%d次收到NRC78，响应时间为:%fms",Count_NRC78,endtime2 - endtime1);
            else
            {
              testStepFail(stepid,"第%d次收到NRC78，响应时间为:%fms ,预期时间为 %fms以内",Count_NRC78,endtime2 - endtime1,NRC78_RespTime);
              Stop_Pos = 1;
            }
            endtime1 = (double)timeNow()/100;
          }
          /*判断NRC78后5s内是否收到最终响应*/
          if(PassWait == 0)
          {
            testWaitForMessage(revID,NRC78_RespTime);
            testGetWaitEventMsgData(msg2);
          }
          if(msg2.byte(1)==req.GetPrimitiveByte(0)+0x40)
          {
            endtime2 = (double)timeNow()/100;
            if(endtime2 - starttime2 <= NRC78_RespTime)
            {
              if(_CheckResp_Byte(msg2,req,passcondition)==1)
                testStepPass(stepid,"与预期相符，最终收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
                msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
              else
              {
                testStepFail(stepid,"与预期不符，最终收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
                msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
                Stop_Pos = 1;
              }
            }
            else
            {
              testStepFail(stepid,"响应超时，最终收到肯定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
              msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
              Stop_Pos = 1;
            }
            break;
          }
          else if(msg2.byte(1)==0x7F && msg2.byte(3)!=0x78)
          {
            endtime2 = (double)timeNow()/100;
            if(endtime2 - starttime2 <= NRC78_RespTime)
            {
              if(_CheckResp_Byte(msg2,req,passcondition)==1)
                testStepPass(stepid,"与预期相符，最终收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
                msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
              else
              {
                testStepFail(stepid,"与预期不符，最终收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
                msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2); 
                Stop_Pos = 1;
              }
            }
            else
            {
              testStepFail(stepid,"响应超时，最终收到否定响应:%02X %02X %02X %02X %02X %02X %02X，响应时间为:%fms",
              msg2.byte(1),msg2.byte(2),msg2.byte(3),msg2.byte(4),msg2.byte(5),msg2.byte(6),msg2.byte(7),endtime2-starttime2);
              Stop_Pos = 1;
            }
            break;
          }
        }while(msg2.byte(3)==0x78);
        /*NRC78响应次数*/
        if(Count_NRC78 <= NRC78_max)
          testStepPass(stepid,"连续响应%d次NRC78",Count_NRC78);
        else
        {
          testStepFail(stepid,"连续响应%d次NRC78",Count_NRC78);
          Stop_Pos = 1;
        }
        Count_NRC78 = 0;
      }
    }
  }
  if(@Test::stoptest==0)
  {
    if(Stop_Pos == 1)
    {
      snprintf(comment,elCount(comment),"发生异常中断刷写");
      writeEx(-3,3,comment);
      testStepFail(comment);
      stop();
      testWaitForTimeout(1000);
    }
  }
}

//获取文件栏的BIN文件地址
//参数FileNum：0为第一个文件栏、1为第二个文件栏
void _getEraseAddrBin(int FileNum)
{
  char filename[400];
  if(Alternate_DownLoad_Flage == 0 || Alternate_DownLoad_Flage == 1)
  {
    if(FileNum==0)
      sysGetVariableString(sysvar::AUTO::openFile_Flash,filename,elCount(filename));
    else if(FileNum==1)
      sysGetVariableString(sysvar::AUTO::openFile_Bin1,filename,elCount(filename));
    else if(FileNum==2)
      sysGetVariableString(sysvar::AUTO::openFile_Bin2,filename,elCount(filename));
  }
  else
  {
    if(FileNum==0)
      sysGetVariableString(sysvar::AUTO::openFile2_Flash,filename,elCount(filename));
    else if(FileNum==1)
      sysGetVariableString(sysvar::AUTO::openFile2_Bin1,filename,elCount(filename));
    else if(FileNum==2)
      sysGetVariableString(sysvar::AUTO::openFile2_Bin2,filename,elCount(filename));
  }
  if(filename[0]==0)//未选择Bin文件
    hexFlage[FileNum] = 1;
  else
  {
    hexFileNum++;
    BinFile_ReadAndSave(filename,BlockBin_Num,FileNum);
  }
}
//获取文件栏的CBF文件地址
//参数FileNum：0为第一个文件栏、1为第二个文件栏
void _getEraseAddrCBF(int FileNum)
{
  char filename[400];
  if(Alternate_DownLoad_Flage == 0 || Alternate_DownLoad_Flage == 1)
  {
    if(FileNum==0)
      sysGetVariableString(sysvar::AUTO::RSA1,filename,elCount(filename));
    else if(FileNum==1)
      sysGetVariableString(sysvar::AUTO::CBF1,filename,elCount(filename));
  }
  else
  {
    if(FileNum==0)
      sysGetVariableString(sysvar::AUTO::RSA2,filename,elCount(filename));
    else if(FileNum==1)
      sysGetVariableString(sysvar::AUTO::CBF2,filename,elCount(filename));
  }
  if(filename[0]==0)//未选择文件
    hexFlage[FileNum] = 1;
  else
  {
    hexFlage[FileNum] = 0;
    hexFileNum++;
    CBF_Flage = 1;
    if(FileNum == 1) CBFFile_ReadAndSave(filename);
    else if(FileNum == 0) RSA_LoadFromSysvar(filename);
  }
}
//获取文件栏的HEX文件地址
//参数FileNum：0为第一个文件栏、1为第二个文件栏
void _getEraseAddr(int FileNum)
{
  char filename[400];
  byte datanow[60];
  byte datanext[60];
  word addrh;
  word addrl;
  word addrnexth;
  word addrnextl;
  word addrlnext;
  dword addrstart;
  dword addrend;
  dword addrnextst;
  byte alignment;
  byte now_Len;
  word addrl_jud;
  int i;
  eraseadd=0;

  if(FileNum==0)
    sysGetVariableString(sysvar::Test::openhex,filename,elCount(filename));
  else if(FileNum==1)
    sysGetVariableString(sysvar::Test::openhex1,filename,elCount(filename));
  else if(FileNum==2)
    sysGetVariableString(sysvar::Test::openhex2,filename,elCount(filename));
 
  if(filename[0]==0)//未选择hex文件
  {
    hexFlage[FileNum] = 1;
  }
  else
  {
    hexFlage[FileNum] = 0;
    hexFileNum++;
    glbHandle = OpenFileRead(filename,0);
    _readhex(datanow); //行读取操作
    addrh=((word)datanow[4]<<8)|datanow[5]; //文件首行为基地址
    
    addrstart=(dword)addrh<<(1<<datanow[3]);//先获取地址的高16位
    addrend=(dword)addrh<<(1<<datanow[3]);
    _readhex(datanow);
    alignment = datanow[0];
    addrl=((word)datanow[1]<<8)|datanow[2];
    addrstart=addrstart|addrl;
    while(1)
    {
      hextype=datanow[3];
      if((hextype==4 || hextype==5 || hextype==1 || hextype==2))
      {
        addrend=addrend|addrl;
        write("第%d块地址：0x%08X-0x%08X",eraseadd,addrstart,addrend);
        eraseaddr[FileNum][eraseadd]=addrstart;
        eraselength[FileNum][eraseadd]=addrend-addrstart+1;
        eraseadd++;
        if(hextype==4 || hextype==2)
        {
          _readhex(datanext);
          addrnexth = ((word)datanow[4]<<8)|datanow[5];
          addrnextst=(dword)addrnexth<<(1<<hextype);//先获取地址的高16位
          addrnextst = addrnextst|(((word)datanext[1]<<8)|datanext[2]);
          if(addrnextst - addrend == 2 && @AUTO::Config_Switch == 9)
          {
            eraseadd--;
            addrend = addrnextst;
            memcpy(datanow,datanext,elCount(datanext));
            Continueaddr[FileNum][eraseadd] = 1;
            continue;
          }
          /*合并连续地址段开关：开关打开后地址空间连续的逻辑块视为同一逻辑块*/
          if(addrnextst - addrend == 1 && @AUTO::MergeAddr_Switch == 1)
          {
            eraseadd--;
            addrend = addrnextst;
            memcpy(datanow,datanext,elCount(datanext));
            Continueaddr[FileNum][eraseadd] = 1;
            write("合并连续地址段：第%d块扩展至0x%08X",eraseadd,addrnextst);
            continue;
          }
          addrh=((word)datanow[4]<<8)|datanow[5];
          addrstart=(dword)addrh<<(1<<hextype);//先获取地址的高16位
          addrend=(dword)addrh<<(1<<hextype);
          addrl=((word)datanext[1]<<8)|datanext[2];
          if((addrl % alignment != 0)&& @AUTO::Config_Switch != 9)//针对开头就没对齐0x20
            addrl-=(addrl % alignment);
          addrstart=addrstart|addrl;
          memcpy(datanow,datanext,elCount(datanext));
        }
        else
          break;
      }
      else if(hextype==0)
      {
        addrl=(((word)datanow[1]<<8)|datanow[2])+(datanow[0]-1);
        _readhex(datanext);
        memcpy(datanow,datanext,elCount(datanext)); 
        if(datanext[3] == 0) // && (addrend - addrstart)!=
        {
          addrlnext=((word)datanext[1]<<8)|datanext[2];
          if( (addrlnext-addrl)>0x80 )
          {
            addrend=addrend|addrl;
            write("第%d块地址：0x%08X-0x%08X",eraseadd,addrstart,addrend);
            eraseaddr[FileNum][eraseadd]=addrstart;
            eraselength[FileNum][eraseadd]=addrend-addrstart+1;
            addrend=addrend&0xFFFF0000;
            addrstart=addrstart&0xFFFF0000;
            if((addrlnext % alignment != 0) && @AUTO::Config_Switch != 9)//针对开头就没对齐0x20
              addrlnext-=(addrlnext%alignment);
            addrstart=addrstart|addrlnext;
            eraseadd++;
          }
        }
      }
    }
    if(@AUTO::FlashDriver_Switch == 0xFF ) //外部输入Flash
    {
      dword Data,Siz;
//      @AUTO::DriverSize = eraselength[0][0];
      DriverSize = eraselength[0][0];
      DriverAddr = eraseaddr[0][0];
      if(FileNum == 0) //装载Flash数据
      {
        fileClose(glbHandle);
        glbHandle = OpenFileRead(filename,0);
        _readhex(datanow); //行读取操作
        _readhex(datanow);//先获取一次00数据类型的数据
        _loadpage(BlockBin_Flash,datanow,Data,Siz);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
      }
    }
  }
  eraseadd=0;
  fileClose(glbHandle);
}
void Set_Battery_DownLoad()
{
  if(@Faultinsert::TC_ErrorVolt != 0) //电压相关操作
  {
    if(@Faultinsert::TC_ErrorVolt == 1)
      @Prog_power::K30Volt = 6;
    else if(@Faultinsert::TC_ErrorVolt == 2)
      @Prog_power::K30Volt = Low_Volt - 0.2;
    else if(@Faultinsert::TC_ErrorVolt == 3)
      @Prog_power::K30Volt = High_Volt + 0.2;
    else if(@Faultinsert::TC_ErrorVolt == 4)
      @Prog_power::K30Volt = 18;
    else if(@Faultinsert::TC_ErrorVolt == 5)
      @Prog_power::K30Volt = 6;
    else if(@Faultinsert::TC_ErrorVolt == 12)
      @Prog_power::K30Volt = Low_Volt + 0.2;
    else if(@Faultinsert::TC_ErrorVolt == 13)
      @Prog_power::K30Volt = High_Volt - 0.2;
    testWaitForTimeout(Volt_Time);
  }
  if(@Faultinsert::TC_ErrorHighVolt_App == 1) 
  {
    @Prog_power::K30Volt = High_Volt + 0.2;
    testWaitForTimeout(Volt_Time);
    HighVolt_Resp(curAppValid);
  }
  if( @Faultinsert::TC_ErrorLowVolt_App == 1) 
  {
    @Prog_power::K30Volt = Low_Volt - 0.2;
    testWaitForTimeout(Volt_Time);
    LowVolt_Resp(curAppValid);
  }
}
/// <DownLoad>
//刷写流程函数
byte MainTest_f()
{
  dword hexaddr[3][2];              /*每一行装填一个HEX文件的起始地址、地址大小*/
  word i,j;
  char appname[200];
  int FileNum;
  i = 0;
  j = 0;
  hexFileNum = 0;
  calcrc16 = 0xFFFF;                /*CRC16 校验值初始化*/
  
  if(@AUTO::Config_Switch==4)       /*Geely3.0*/
    readFile_SBT();
  else if(@AUTO::Config_Switch==12) /*广汽*/
  {
    for(i=0;i<3;i++)
      _getEraseAddrBin(i);          /*获取每个文件栏中的地址段*/
    if(BlockBin_Flage == 0)
    {
      for(i=0;i<3;i++)
        _getEraseAddr(i);          /*获取每个HEX文件栏中的地址段*/
    }
    if(hexFlage[0]==1 && hexFlage[1]==1 && hexFlage[2]==1)
    {
      writeEx(-3,1,"--------------刷写失败，未选择Bin文件！！！--------------");
      stop();
      testWaitForTimeout(1000);
    }
    if(@AUTO::FlashDriver_Switch == 0xFF && hexFlage[0]==1)
    {
      writeEx(-3,1,"--------------刷写失败，未输入Flash文件！！！--------------");
      stop();
      testWaitForTimeout(200);
    }
  }
  else if(@AUTO::Config_Switch==11) /*T1V*/
  {
    CBF_Flage = 0;
    for(i=0;i<3;i++)
      _getEraseAddr(i);            /*获取每个HEX文件栏中的地址段*/
    if(hexFlage[0]==1 && hexFlage[1]==1 && hexFlage[2]==1)
    {
      for(i=0;i<2;i++)
        _getEraseAddrCBF(i);
      if(hexFlage[0]==1 && hexFlage[1]==1)
      {
        writeEx(-3,1,"--------------刷写失败，未选择文件！！！--------------");
        stop();
        testWaitForTimeout(1000);
      }
    }
  }
  else                             /*其它主机厂*/
  {
    for(i=0;i<3;i++)
      _getEraseAddr(i);            /*获取每个HEX文件栏中的地址段*/
    if(hexFlage[0]==1 && hexFlage[1]==1 && hexFlage[2]==1)
    {
      writeEx(-3,1,"--------------刷写失败，未选择hex文件！！！--------------");
      stop();
      testWaitForTimeout(1000);
    }
  } 
  testWaitForTimeout(500);
  /*判断当前是否APP有效*/
  curAppValid = Check_AppValid();
  testWaitForTimeout(1000);
  /*预编程阶段*/
  Pre_Programme();
  
  testWaitForTimeout(1000);
  if(Exit_Pre_Prog==1)
    return 0;
  /*重编程阶段*/
  Re_Programme();
  
  testWaitForTimeout(1000);
  if(Exit_Re_Prog==1)
    return 0;
  Down_f_a = 1; // App开始下载
  
  /*Geely3.0*/
  if(@AUTO::Config_Switch==4)
  {
    for(FileNum=1;FileNum<=4;FileNum++)
    {
      writeEx(-3,0,"第 %d 个文件",FileNum);
      if(Alternate_DownLoad_Flage == 0 || Alternate_DownLoad_Flage == 1)
      {
        if(FileNum==1)
          sysGetVariableString(sysvar::AUTO::openFile_VBF1,appname,elcount(appname));
        else if(FileNum==2)
          sysGetVariableString(sysvar::AUTO::openFile_VBF2,appname,elcount(appname));
        else if(FileNum==3)
          sysGetVariableString(sysvar::AUTO::openFile_VBF3,appname,elcount(appname));
        else if(FileNum==4)
          sysGetVariableString(sysvar::AUTO::openFile_VBF4,appname,elcount(appname));
      }
      else
      {
        if(FileNum==1)
          sysGetVariableString(sysvar::AUTO::openFile2_VBF1,appname,elcount(appname));
        else if(FileNum==2)
          sysGetVariableString(sysvar::AUTO::openFile2_VBF2,appname,elcount(appname));
        else if(FileNum==3)
          sysGetVariableString(sysvar::AUTO::openFile2_VBF3,appname,elcount(appname));
        else if(FileNum==4)
          sysGetVariableString(sysvar::AUTO::openFile2_VBF4,appname,elcount(appname));
      }
      if(strlen(appname)>0)
      {
        readFile_APP(FileNum);
        Data_Download(FileNum);
      }
      testwaitfortimeout(100);
      if(Break_Download==1)
        break;
    }
    if(Exit_Download==1)
      return 0;
  }
  else if(@AUTO::Config_Switch==12)
  {
    if(BlockBin_Flage == 1)
    {
      if(@AUTO::FlashDriver_Switch == 0xFF)
        hexFileNum = hexFileNum-1;
      for(i=1;i<=hexFileNum;i++) // 每次刷写文件均需重新写入Flash
      {
        dword AddStatr,AddLen,AddEnd;
        AddStatr = 0;AddLen = 0;AddEnd = 0;
        calcrc32 = 0xFFFFFFFF;     /*CRC32 校验值初始化*/
        for(j=0;j<BlockBin_Num;j++)
        { 
          if(hexfile_app[j].FilePos == i && AddStatr == 0)
          {
            AddStatr = hexfile_app[j].BlockStartAddr;
            AddEnd =  hexfile_app[j].BlockEndAddr;
          }
        }
        AddLen = AddEnd - AddStatr + 1;
        Down_BinFlash();
        _Sendff00(AddStatr,AddLen,phyID); //擦除部分
        /*故障注入：31 01 FF 00后31 01 FF 00*/
        if(@Faultinsert::TC_Re_FF00==1)
        {
          eraseadd++;
          Resp_ff00 = 0x24;
          Exit_ff00 = 1;
          @Faultinsert::TC_Re_FF00=0;
          _Sendff00(AddStatr,AddLen,phyID);
        }
        if(Exit_ff00==1)
          return 0;
        for(j=0;j<BlockBin_Num;j++)
        {
          if(hexfile_app[j].FilePos == i)
          {
            _download_5_stream(i,j); //[流式改造-2026-09]原 _download_5 整文件装载,改 _download_5_stream 分页流式
            testWaitForTimeout(500);
          }
          if(Exit_Download==1)
            return 0;
        }
        /*
          广汽 APP 31 01 02 02数据校验
          [流式改造-2026-09]Config_Switch==12 时 _Send0202_a 内部跳过 data36 的 CRC 计算(用累计 calcrc32),
          故此处传 hexfile_app[0].dataBuffer(单页缓冲)与 BlockDataLength 仅为占位,实际不被访问。
          calcrc32 已在 _Send36_App_stream 中逐页累加完成。
        */
        _Send0202_a(hexfile_app[0].dataBuffer,hexfile_app[0].BlockDataLength,phyID,Resp_0202_a);
        if(Exit_0202_a==1)
        {
          Exit_Download = 1;
          return 0;
        }
      }
    }
    else
    {
      int Start_Pos;
      if(@AUTO::FlashDriver_Switch == 0xFF) // 第1个文件栏装载Flash
        Start_Pos = 1;
      else
        Start_Pos = 0;
      /*遍历文件栏进行刷写，直至空文件栏*/
      for(i=Start_Pos;i<elcount(hexFlage);i++)  
      {
        if(hexFlage[i]==1)
          break;
        writeEx(-3,1,"--------------------------开始刷写第%d个文件栏--------------------------",i+1);
        Down_BinFlash();
        if(Exit_36_f==1)
        {
          Exit_Download = 1;
          return 0;
        }
        for(j=0;j<elcount(eraseaddr[i]);j++)
        {
          if(eraseaddr[i][j]==0 && eraselength[i][j]==0)
            break;
        }
        /*获取第i个HEX文件的地址段*/
        hexaddr[i][0] = _gethexaddr(i,eraseaddr,eraselength);
        hexaddr[i][1] = _gethexlength(i,eraseaddr,eraselength);
        /*整段擦除第i个HEX文件地址段*/
        _Sendff00(hexaddr[i][0],hexaddr[i][1],phyID);
        if(Exit_ff00==1)
          return 0;
        /*下载第i个HEX文件，34、36、37循环至数据下载完成*/
        if(@AUTO::EraseMode_Switch == 2)
          _download_2(i);
        else if(@AUTO::EraseMode_Switch == 3)
          _download_3(i);
        if(Exit_Download==1)
          return 0;
        testWaitForTimeout(500);
      }
    }
  }
  else if(CBF_Flage == 1 && @AUTO::Config_Switch==11)
  {
    _Sendff00(hexfile_app[0].BlockStartAddr,hexfile_app[0].BlockDataLength,phyID);
    /*故障注入：31 01 FF 00后31 01 FF 00*/
    if(@Faultinsert::TC_Re_FF00==1)
    {
      eraseadd++;
      Resp_ff00 = 0x24;
      Exit_ff00 = 1;
      @Faultinsert::TC_Re_FF00=0;
      _Sendff00(hexaddr[i][0],hexaddr[i][1],phyID);
    }

    if(Exit_ff00==1)
      return 0;
    _download_CBF_stream();
  }
  /*其它主机厂*/
  else
  {
    /*----------------------------------------------------------------------------------------------------------------*/
    /*选择擦除方式，1为分段擦除：FF00、34、36、37循环至数据下载完成*/
    if(@AUTO::EraseMode_Switch == 1)
    {
      /*遍历文件栏进行刷写，直至空文件栏*/
      for(i=0;i<elcount(hexFlage);i++)
      {
        if(hexFlage[i] == 1)
          break;
        writeEx(-3,1,"--------------------------开始刷写第%d个文件栏--------------------------",i+1);
        
        /*下载第i个HEX文件，FF00、34、36、37循环至数据下载完成*/
        _download_1(i);
        if(Exit_Download==1)
          return 0;
        testWaitForTimeout(500);
      }
    }
    /*----------------------------------------------------------------------------------------------------------------*/
    /*选择擦除方式，2为整段擦除，然后34、36、37循环至数据下载完成*/
    if(@AUTO::EraseMode_Switch == 2)
    {
      /*遍历文件栏进行刷写，直至空文件栏*/
      for(i=0;i<elcount(hexFlage);i++)
      {
        if(hexFlage[i]==1)
          break;
        writeEx(-3,1,"--------------------------开始刷写第%d个文件栏--------------------------",i+1);
        for(j=0;j<elcount(eraseaddr[i]);j++)
        {
          if(eraseaddr[i][j]==0 && eraselength[i][j]==0)
            break;
//          writeEx(-3,1,"-----第%d个地址和长度------0x%08X-----------0x%08X",j,eraseaddr[i][j],eraselength[i][j]);
        }
        /*获取第i个HEX文件的地址段*/
        hexaddr[i][0] = _gethexaddr(i,eraseaddr,eraselength);
        hexaddr[i][1] = _gethexlength(i,eraseaddr,eraselength);
//        writeEx(-3,1,"-----第%d个文件的地址和长度-------0x%08X-----------0x%08X",i+1,hexaddr[i][0],hexaddr[i][1]);
        /*整段擦除第i个HEX文件地址段*/
        _Sendff00(hexaddr[i][0],hexaddr[i][1],phyID);
        if(Exit_ff00==1)
          return 0;
        /*奇瑞特殊流程*/
        if(@AUTO::Config_Switch==7)
        {
          _Send03FF00(phyID,Resp_ff00);
          if(Exit_03ff00==1)
            return 0;
          _Send02FF00(phyID,Resp_ff00);
          if(Exit_02ff00==1)
            return 0;
        }
        /*下载第i个HEX文件，34、36、37循环至数据下载完成*/
        _download_2(i);
        if(Exit_Download==1)
          return 0;
        testWaitForTimeout(500);
      }
    }
    /*----------------------------------------------------------------------------------------------------------------*/
    /*选择擦除方式，3为整段擦除，然后34请求整个地址段，36循环至数据下载完成，最后37*/
    if(@AUTO::EraseMode_Switch == 3)
    {
      /*遍历文件栏进行刷写，直至空文件栏*/
      for(i=0;i<elcount(hexFlage);i++)
      {
        if(hexFlage[i]==1)
          break;
        writeEx(-3,1,"--------------------------开始刷写第%d个文件栏--------------------------",i+1);
        
        /*获取第i个HEX文件的地址段*/
        hexaddr[i][0] = _gethexaddr(i,eraseaddr,eraselength);
        hexaddr[i][1] = _gethexlength(i,eraseaddr,eraselength);
        /*整段擦除第i个HEX文件地址段*/
        _Sendff00(hexaddr[i][0],hexaddr[i][1],phyID);
        /*故障注入：31 01 FF 00后31 01 FF 00*/
        if(@Faultinsert::TC_Re_FF00==1)
        {
          eraseadd++;
          Resp_ff00 = 0x24;
          Exit_ff00 = 1;
          @Faultinsert::TC_Re_FF00=0;
          _Sendff00(hexaddr[i][0],hexaddr[i][1],phyID);
        }

        if(Exit_ff00==1)
          return 0;
        /*下载第i个HEX文件，34请求整个文件地址段，然后36循环下载，最后37*/
        _download_3(i);
        if(Exit_Download==1)
          return 0;
        testWaitForTimeout(500);
      }
    }
    /*----------------------------------------------------------------------------------------------------------------*/
    /*选择擦除方式，4为分段擦除，先FF00循环,然后34,36,37循环*/
    if(@AUTO::EraseMode_Switch == 4)
    {
      /*遍历文件栏进行刷写，直至空文件栏*/
      for(i=0;i<elcount(hexFlage);i++)
      {
        if(hexFlage[i]==1)
          break;
        writeEx(-3,1,"--------------------------开始刷写第%d个文件栏--------------------------",i+1);
        
        _download_4(i);
        if(Exit_Download==1)
          return 0;
        testWaitForTimeout(500);
      }
    }
  }
  /*----------------------------------------------------------------------------------------------------------------*/
  /*后编程阶段*/
  Post_Programme();
  TestWaitForTimeout(1000);
  if(Exit_Post_Prog==1)
    return 0;
  return 1;
} 

/*
  将填写的256位解析为数组
  type：
      0：驱动
      1：APP1
      2：APP2
      3：APP3
      4：APP4
*/
void digitalSignature(word toInt[],int type)
{
  long bufferSize;
  int i,length;
  char CheckMerroryArray[514]; 
  word left,right,toInt_inx;
  if(type == 0)
  {
    getCheckMerrory_SBT_Fun();
    strncpy(CheckMerroryArray,getCheckMemory_sbt,strlen(getCheckMemory_sbt)+1);
  }
  else
  {
    getCheckMerrory_Fun(type);
    strncpy(CheckMerroryArray,getCheckMemory,strlen(getCheckMemory)+1);
  }
  length = strlen(CheckMerroryArray);
  for(i = 0; i < length; i++)
  {
    if(i % 2 == 0)
    {
      if(CheckMerroryArray[i] >= '0' && CheckMerroryArray[i] <= '9')
      {
        left = (CheckMerroryArray[i] - 48)<<4;
      }
      else
      {
        left = (CheckMerroryArray[i] - 55)<<4;
      }
    }
    else
    {
      if(CheckMerroryArray[i] >= '0' && CheckMerroryArray[i] <= '9')
      {
        right = (CheckMerroryArray[i] - 48);
      }
      else
      {
        right = (CheckMerroryArray[i] - 55);
      }
      toInt[toInt_inx++] = left|right;
    }
  }
  length = 0;
  left = 0;
  right = 0;
  toInt_inx = 0;
  getCheckMemory[0] = '\0';
  getCheckMemory_sbt[0] = '\0';
}
void getCheckMerrory_Fun(byte num)
{
  int flag;
  char filePathOut[4][200]/* ={ "sign1.VBF","sign2.VBF","sign3.VBF","sign4.VBF"}*/;
  char papername[200];
  char filenameCopy[200];
  char buffer_char[1000];
  char CheckMerrory[1000];
  dword i,j;
  i = 0;
  j = 0;

  testWaitForTimeout(1500);
  switch(num)
  {
    case 1:
      sysGetVariableString(sysvar::AUTO::openFile_VBF1,filePathOut[0],elCount(filePathOut[0]));
      for(i=0;i<strlen(filePathOut[0]);i++)
      {
        if(filePathOut[0][i]=='\\')
        {
          j=i;
        }
      }
      substr_cpy(papername,filePathOut[0],j+1,strlen(filePathOut[0])-j,elCount(papername));
      strncpy (filenameCopy,filePathOut[0],j+1);
      setFilePath(filenameCopy,2);
      glbHandle = openFileRead(papername,0);
      break;
    case 2:
      sysGetVariableString(sysvar::AUTO::openFile_VBF2,filePathOut[1],elCount(filePathOut[1]));
      for(i=0;i<strlen(filePathOut[1]);i++)
      {
        if(filePathOut[1][i]=='\\')
        {
          j=i;
        }
      }
      substr_cpy(papername,filePathOut[1],j+1,strlen(filePathOut[1])-j,elCount(papername));
      strncpy (filenameCopy,filePathOut[1],j+1);
      setFilePath(filenameCopy,2);
      glbHandle = openFileRead(papername,0);
      break;
    case 3:
      sysGetVariableString(sysvar::AUTO::openFile_VBF3,filePathOut[2],elCount(filePathOut[2]));
      for(i=0;i<strlen(filePathOut[2]);i++)
      {
        if(filePathOut[2][i]=='\\')
        {
          j=i;
        }
      }
      substr_cpy(papername,filePathOut[2],j+1,strlen(filePathOut[2])-j,elCount(papername));
      strncpy (filenameCopy,filePathOut[2],j+1);
      setFilePath(filenameCopy,2);
      glbHandle = openFileRead(papername,0);
      break;
    case 4:
      sysGetVariableString(sysvar::AUTO::openFile_VBF4,filePathOut[3],elCount(filePathOut[3]));
      for(i=0;i<strlen(filePathOut[3]);i++)
      {
        if(filePathOut[3][i]=='\\')
        {
          j=i;
        }
      }
      substr_cpy(papername,filePathOut[3],j+1,strlen(filePathOut[3])-j,elCount(papername));
      strncpy (filenameCopy,filePathOut[3],j+1);
      setFilePath(filenameCopy,2);
      glbHandle = openFileRead(papername,0);
      break;
  }
  if(glbHandle != 0)
  {
    j = 0;
    while(fileGetStringSZ(buffer_char,elCount(buffer_char),glbHandle) != 0)
    {
      if(strlen(buffer_char) > 500) //某行长度大于500对应 sw_signature_dev，后续可优化识别该变量
      {
        mbsubstr_cpy_off(CheckMerrory,0,buffer_char,22,-1); //从索引第22位开始读取，即0x后
        break;
      }
      j++;
    }
  }
  fileClose(glbHandle);
  strncpy(getCheckMemory,CheckMerrory,513);
}
void getCheckMerrory_SBT_Fun()
{
  int flag;
  char filePathOut[256];
  char buffer_char[1000];
  char CheckMerrory[1000];
  char papername[200];
  char filenameCopy[200];
  dword i,j;
  i = 0;
  j = 0;
  
  sysGetVariableString(sysvar::AUTO::openFile_SBT,filePathOut,elCount(filePathOut));
  for(i=0;i<strlen(filePathOut);i++)
  {
    if(filePathOut[i]=='\\')
    {j=i;}
  }
  substr_cpy(papername,filePathOut,j+1,strlen(filePathOut)-j,elCount(papername));
  strncpy (filenameCopy,filePathOut,j+1);
  setFilePath(filenameCopy,2);
  glbHandle = openFileRead(papername,0);
  if(glbHandle != 0)
  {
    j = 0;
    while(fileGetStringSZ(buffer_char,elCount(buffer_char),glbHandle) != 0)
    {
      if(strlen(buffer_char) > 500)
      {
        mbsubstr_cpy_off(CheckMerrory,0,buffer_char,22,-1);
        break;
      }
      j++;
    }
  }
  fileClose(glbHandle);
  strncpy(getCheckMemory_sbt,CheckMerrory,513);
}

//读取SBT文件栏内容
void readFile_SBT()
{
  char filename[200];
  int fileInx;
  int i;
  //获取打开文件字节，将其复制到filename中
  if(Alternate_DownLoad_Flage == 0 || Alternate_DownLoad_Flage == 1)
    sysGetVariableString(sysvar::AUTO::openFile_SBT,filename,elCount(filename));
  else
    sysGetVariableString(sysvar::AUTO::openFile2_SBT,filename,elCount(filename));
  fileInx = strlen(filename);
  //判断选择文件类型为 hex or vbf
  if(filename[fileInx-3] == 'h' && filename[fileInx-2] == 'e' && filename[fileInx-1] == 'x')
  {
    Read_hexFile(filename,hexfile_sbt,0);
  }
  else
  {
    Flash_DataFormatId = 0x00;
    Read_vbfFile(filename,hexfile_sbt,0);
    vbfToHexFile(hexfile_sbt,HexBlockTotalNumber_sbt,VbtBlockTotalNumber_sbt,loadhexLength,vbtLength,0);
    testWaitForTimeout(1000);
  }
}

//读取APP文件栏内容
void readFile_APP(int File_num)
{
  char filename[200];
  int fileInx;
  //获取打开文件字节，将其复制到filename中
  if(File_num==1)
    sysGetVariableString(sysvar::AUTO::openFile_VBF1,filename,elCount(filename));
  else if(File_num==2)
    sysGetVariableString(sysvar::AUTO::openFile_VBF2,filename,elCount(filename));
  else if(File_num==3)
    sysGetVariableString(sysvar::AUTO::openFile_VBF3,filename,elCount(filename));
  else if(File_num==4)
    sysGetVariableString(sysvar::AUTO::openFile_VBF4,filename,elCount(filename));
  
  fileInx = strlen(filename);
  if(filename[fileInx-3] == 'h' && filename[fileInx-2] == 'e' && filename[fileInx-1] == 'x')
  {
    Read_hexFile(filename,hexfile_app,1);
  }
  else
  {
    App_DataFormatId=0x00;
    Read_vbfFile(filename,hexfile_app,1);
    vbfToHexFile(hexfile_app,HexBlockTotalNumber_app,VbtBlockTotalNumber_app,loadhexLength,vbtLength,1);
    testWaitForTimeout(1000);
  }
}

/*********************************************************************************
  *Function:      //char -> byte
  *Description：  //把单个字符转换为Byte的函数
  *Input:         //ch：ASCII编码字符，取值为0到F
  *Return:        //val，为byte类型
**********************************************************************************/
byte char2byte(char ch)
{
   byte  val;
   val = 0;
   if ( ch >= '0' && ch <= '9')
   {
      val = ch - '0';      
   }
   if ( ch >= 'a' && ch <= 'f')
   {
      val = (ch - 'a') + 10;      
   }
   if ( ch >= 'A' && ch <= 'F')
   {
      val = (ch - 'A') + 10;       
   }
   return val;
}

/*********************************************************************************
  *Function:      //Read_hexFile
  *Description：  //解码HEX文件，只支持0x00，0x04，0x01，0x02，0x05类型
  *Input:         //Filename：需要解码的文件名
  *Output:        //hexfile
  *Return:        //void
**********************************************************************************/
//读取HEXFILE
void Read_hexFile(char Filename[],struct Block hexfile[],int hexType)
{
  
  long file_handle;
  char RowData[128];                        //逐行读取,每行数据缓存，当每行数据大于128时，需要将其调整
	dword   i;
	dword   RowDataByte;											//单块数据块字节数
	qword   OffsetAddress;										//扩展线性地址 	
	qword   ReAddr;												    //上一数据行起始地址 
	dword   Len;													    //HEX每行有效数据字节数
	dword   ReLen;												    //HEX前一次数据长度
	dword   Addr;													    //HEX每行起始地址
	dword   Type;		                          //HEX每行类型，有00，01，04，05四种类型
  dword   isFirstLine;                      //是否为第一行
  dword   HexBlockTotalNumber;
  RowDataByte = 0;i = 0;Len = 0;ReLen = 0;Addr=0;Type = 0;ReAddr = 0;isFirstLine = 0;
  file_handle = OpenFileRead(Filename,0);
  HexBlockTotalNumber = 0;
  if(file_handle!=0)
  { 
    // Read all lines
    while( fileGetStringSZ(RowData,elcount(RowData),file_handle)!=0 )
    {
      //判断首字符是否为:号
      if(RowData[0] == ':')
      {
        Len = (char2byte(RowData[1])*0x10+char2byte(RowData[2]));
        Addr = char2byte(RowData[3])*0x1000+char2byte(RowData[4])*0x100+char2byte(RowData[5])*0x10+char2byte(RowData[6]);
        Addr |= (OffsetAddress << 16);
        Type = char2byte(RowData[7])*0x10+char2byte(RowData[8]);
        switch(Type)
        {
          case 0x00:											  //数据
            if(Addr > ReAddr)
            {  
              //判断为新数据块
              if(RowDataByte == 0)			  //是否为首行数据字节数
              {
                hexfile[HexBlockTotalNumber].BlockStartAddr = Addr;         //记录新数据块的起始地址
              }
              else										    //不是首行
              {
                hexfile[HexBlockTotalNumber].BlockDataLength = RowDataByte; //数据长度
              }
            }
            for(i=0;i<Len;i++)
            {
              //储存buffer，注意没有对crc进行校验。
              hexfile[HexBlockTotalNumber].dataBuffer[RowDataByte++]=(char2byte(RowData[2*i+9])*0x10+char2byte(RowData[2*i+10]));
            }
            ReAddr = Addr;									  //保存当前地址,下一次使用
            //ReLen  = Len;									  //保存当前长度,下一次使用
            break;
          case 0x04:										   	  //扩展线性地址记录
            if(isFirstLine != 0)
            {
              hexfile[HexBlockTotalNumber].BlockDataLength = RowDataByte;        //数据长度
              RowDataByte = 0;
              HexBlockTotalNumber++;
            }
            isFirstLine++;
						OffsetAddress =  char2byte(RowData[9])*0x1000+char2byte(RowData[10])*0x100+char2byte(RowData[11])*0x10+char2byte(RowData[12]);		//偏移地址
            break;
          case 0x02:										   	//扩展段地址记录
            if(isFirstLine != 0)
            {
              hexfile[HexBlockTotalNumber].BlockDataLength = RowDataByte;        //数据长度
              RowDataByte = 0;
              HexBlockTotalNumber++;
            }
            isFirstLine++;
						OffsetAddress =  char2byte(RowData[9])*0x1000+char2byte(RowData[10])*0x100+char2byte(RowData[11])*0x10+char2byte(RowData[12]);		//偏移地址
            break;
          case 0x01:										   	//地址,结束
            hexfile[HexBlockTotalNumber].BlockDataLength = RowDataByte;        //数据长度
            RowDataByte = 0;
            HexBlockTotalNumber++;
            break;
          case 0x05:										   	//地址,结束
            hexfile[HexBlockTotalNumber].BlockDataLength = RowDataByte;        //数据长度
            RowDataByte = 0;
            HexBlockTotalNumber++;
            break; 
        }        
      }
    }
    write("Hex文件读取成功, 数据分块:%d",HexBlockTotalNumber);
    for(i = 0; i < HexBlockTotalNumber; i++)
  	{
      write("起始地址:0x%X",hexfile[i].BlockStartAddr);
      write("结束地址:0x%X",hexfile[i].BlockStartAddr + hexfile[i].BlockDataLength - 1);
      write("数据长度:%6d字节",hexfile[i].BlockDataLength);
      //write("最后一个字节:%x",hexfile[i].dataBuffer[0xFFE0]);
  	}
    if(hexType == 0)//统计hex地址块总数
    {
      HexBlockTotalNumber_sbt = HexBlockTotalNumber;
    }
    else
    {
      HexBlockTotalNumber_app = HexBlockTotalNumber;
    }
    fileClose(file_handle);
  }
  else{
     writeEx(-3,1,"文件打开失败");
  }
}

/*********************************************************************************
  *Function:      //Read_hexFile
  *Description：  //解码HEX文件，只支持0x00，0x04，0x01类型
  *Input:         //Filename：需要解码的文件名
  *Output:        //hexfile
  *Return:        //void
**********************************************************************************/
//读取HEXFILE
void Read_vbfFile(char Filename[],struct Block hexfile[],int hexType)
{
  long file_handle;
  /*[VBF流式改造-2026-09]原 RowData[0x200000] 2MB 整文件读取+拷贝到 ReadData[1MB]。
    现仅用于解析 VBF 文本头部(元数据 + } 标记),取 0x10000(64KB)覆盖大头部,
    数据段由 vbfToHexFile 按 64KB 块从文件流式读入 dataBuffer。栈占用 2MB→64KB。*/
  byte RowData[0x10000];                    //逐行读取,每行数据缓存，当每行数据大于128时，需要将其调整
  dword   i,j;
	dword   RowDataByte;											//单块数据块字节数
	qword   OffsetAddress;										//扩展线性地址 	
	qword   ReAddr;												    //上一数据行起始地址 
	dword   Len;													    //HEX每行有效数据字节数
	dword   ReLen;												    //HEX前一次数据长度
	dword   Addr;												      //HEX每行起始地址
	dword   Type;		                          //HEX每行类型，有00，01，04，05四种类型
  dword   isFirstLine;                      //是否为第一行
  word    flag;                             //第一个7D标识
  dword   HexBlockTotalNumber;
  char papername[200];
  char filenameCopy[200];
  for(i=0;i<strlen(Filename);i++)
  {
    if(Filename[i]=='\\')
    {
      j=i;
    }
  };
  substr_cpy(papername,Filename,j+1,strlen(Filename)-j,elCount(papername));
  strncpy(filenameCopy,Filename,j+1);
  setFilePath(filenameCopy, 2);
  RowDataByte = 0;i = 0;Len = 0;ReLen = 0;Addr=0;Type = 0;ReAddr = 0;isFirstLine = 0;
  file_handle = OpenFileRead(papername,1);
  HexBlockTotalNumber = 0;
  bytesLength = 0;
  if(file_handle!=0)
  {
    // Read all lines
    qword length;
    length = fileGetBinaryBlock(RowData,elCount(RowData),file_handle);
    vbfLength = length;
    {
      word inx,i;
      hexStartAddr=0;
      inx=Hexandchar_strstr(RowData,0,"data_format_identifier = 0x10");
      if(inx>0)
      {
        Flash_DataFormatId=0x10;
      }
      else
      {
        inx=Hexandchar_strstr(RowData,0,"data_format_identifier = 0x00");
        if(inx>0)
        {
          Flash_DataFormatId=0x00;
        }
      }
      inx=Hexandchar_strstr(RowData,0,"call = 0x");
      if(inx>0)
      {
        for(i=0 ; i < 8; i++)
        {
          hexStartAddr = hexStartAddr << 4 | char2byte(RowData[inx+i]);
        }        
        write("hexStartAddr %x",hexStartAddr);
      }
      else
      {
        inx=Hexandchar_strstr(RowData,0,"erase = {{0x");
        for(i=0 ; i < 8; i++)
        {
          hexStartAddr = hexStartAddr << 4 | char2byte(RowData[inx+i]);
        }        
        write("hexStartAddr %x",hexStartAddr);
      }
      vbtStartAddr = 0;
      inx=Hexandchar_strstr(RowData,0,"verification_block_start = 0x");
      if(inx>0)
      {
        for(i=0 ; i < 8; i++)
        {
          vbtStartAddr = vbtStartAddr << 4 | char2byte(RowData[inx+i]);
        }     
        write("vbtStartAddr %x",vbtStartAddr);
      }
      vbtLength = 0;
      inx=Hexandchar_strstr(RowData,0,"verification_block_length = 0x");
      if(inx>0)
      {
        for(i=0 ; i < 8; i++)
        {
          vbtLength = vbtLength << 4 | char2byte(RowData[inx+i]);
        }     
        write("vbtLength %x",vbtLength);
      }
      hexLength = vbtStartAddr-hexStartAddr;
      bytesLength = hexLength+vbtLength;
//      writeEx(-3,1,"inx=%d",inx); 
      inx_7D=Hexandchar_strstr(RowData,inx,"}")-1;
    }
    loadhexLength=0;
    loadhexStartAddr=0;

    /*[VBF流式改造-2026-09]原将整个数据段拷贝到 ReadData[0x100000] 1MB 全局缓冲。
      现仅解析数据段前 8 字节(loadhexStartAddr/loadhexLength),不拷贝整段。
      数据段由 vbfToHexFile 按 64KB 块从文件流式读取。原拷贝循环已屏蔽:
      for(i = 0; i < vbfLength - inx_7D - 9; i++)
        ReadData[i] = RowData[i+inx_7D+9];*/
    for(i = 0; i < 9; i++)
    {
      if(0<i&&i<5)
      loadhexStartAddr = RowData[i+inx_7D]|loadhexStartAddr<<8;
      if(4<i&&i<9)
      loadhexLength = RowData[i+inx_7D]|loadhexLength<<8;
    }
    /*保存当前 VBF 路径与数据段起始偏移(inx_7D+9),供 vbfToHexFile 流式读取
      同时保存裸文件名 g_vbfFileName,配合 Read_vbfFile 已 setFilePath 的目录打开*/
    strncpy(g_vbfFilePath, Filename, elCount(g_vbfFilePath));
    strncpy(g_vbfFileName, papername, elCount(g_vbfFileName));
    g_vbfDataOffset = inx_7D + 9;
    loadvbtLength=0;
    loadvbtStartAddr=0;
//    for(i = 0; i < 4; i++)
//    {
//      loadvbtLength = ReadData[i+loadhexLength+6]|loadvbtLength<<8;
//      loadvbtStartAddr = ReadData[i+loadhexLength+2]|loadvbtStartAddr<<8;
//    }    

    write("vbf文件读取成功, vbf大小为：%d",vbfLength);
    write("=====================================================");
    write("hex域地址:DATAStartAddr:  {0x%X}",hexStartAddr);
    write("hex域长度:DATALength:     {0x%X}",hexLength);
    write("vbt域地址:VBTStartAddr:   {0x%X}",vbtStartAddr);
    write("vbt域长度:VBTLengt:       {0x%X}",vbtLength);
    write("下载地址:DATAStartAddr:   {0x%X}",loadhexStartAddr);
    write("下载地址:DATALength:      {0x%X}",loadhexLength);
    write("下载地址:VBTStartAddr:    {0x%X}",loadvbtStartAddr);
    write("下载地址:VBTLengt:        {0x%X}",loadvbtLength);    
//    writeEx(-3,0,"vbf文件读取成功, vbf大小为：%d",vbfLength);
//    writeEx(-3,0,"=====================================================");
//    writeEx(-3,0,"hex域地址:DATAStartAddr:  {0x%X}",hexStartAddr);
//    writeEx(-3,0,"hex域长度:DATALength:     {0x%X}",hexLength);
//    writeEx(-3,0,"vbt域地址:VBTStartAddr:   {0x%X}",vbtStartAddr);
//    writeEx(-3,0,"vbt域长度:VBTLengt:       {0x%X}",vbtLength);
//    writeEx(-3,0,"下载地址:DATAStartAddr:   {0x%X}",loadhexStartAddr);
//    writeEx(-3,0,"下载地址:DATALength:      {0x%X}",loadhexLength);
//    writeEx(-3,0,"下载地址:VBTStartAddr:    {0x%X}",loadvbtStartAddr);
//    writeEx(-3,0,"下载地址:VBTLengt:        {0x%X}",loadvbtLength);
    flag = 0;
    fileClose(file_handle);
  }
  else
  {
     writeEx(-3,1,"文件打开失败");
  }
}

void vbfToHexFile(struct Block hexfile[],dword HexBlockTotalNumber,dword VbtBlockTotalNumber,qword Hexlen,qword Vbtlen,int hexType)
{
  dword i,j;
  long vbfHandle;
  byte skipBuf[0x200];
  dword skipRead;
  dword hexBytesRead;      /*[VBF流式]累计 hex 数据段已读字节数,用于定位 vbt 段起始*/
  long  vbtSkipLen;        /*[VBF流式]hex 段末到 vbt 段起始需跳过的字节数(Hexlen+10-hexBytesRead)*/
  /*[VBF流式改造-2026-09]打开 VBF 文件并跳过头部到数据段起始,后续按 64KB 块读取
    到 hexfile[i].dataBuffer/dataVbtBuffer。替代原从 ReadData[1MB] 全局拷贝的方式。
    Read_vbfFile 中已 setFilePath 设置目录,此处用裸文件名 g_vbfFileName 打开,
    与 Read_vbfFile 自身打开方式完全一致,避免完整路径与 setFilePath 冲突。*/
  vbfHandle = OpenFileRead(g_vbfFileName,1);
  if(vbfHandle==0)
  {
    writeEx(-3,1,"[VBF流式]打开文件失败: %s (完整路径: %s)",g_vbfFileName,g_vbfFilePath);
    return;
  }
  {
    dword remaining, thisSkip;
    remaining = g_vbfDataOffset;
    while(remaining > 0)
    {
      if(remaining > elCount(skipBuf))
        thisSkip = elCount(skipBuf);
      else
        thisSkip = remaining;
      skipRead = fileGetBinaryBlock(skipBuf,thisSkip,vbfHandle);
      if((long)skipRead != (long)thisSkip)
      {
        writeEx(-3,1,"[VBF流式]跳过头部失败,剩余%d 实际读了%d",remaining,skipRead);
        fileClose(vbfHandle);
        return;
      }
      remaining -= thisSkip;
    }
  }
  if((Hexlen / 65535) < ((float)Hexlen / 65535.0) || Hexlen <= 65535)
  {
    HexBlockTotalNumber = (Hexlen / 65535) + 1;
  }
  else
  {
    HexBlockTotalNumber = (Hexlen / 65535);
  }
  if((Vbtlen / 65535) < ((float)Vbtlen / 65535.0) || Vbtlen <= 65535)
  {
    VbtBlockTotalNumber = (Vbtlen / 65535) + 1;
  }
  else
  {
    VbtBlockTotalNumber = (Vbtlen / 65535);
  }
  //统计hex地址块总数
  if(hexType == 0)
  {
    HexBlockTotalNumber_sbt = HexBlockTotalNumber;
    write("HexBlockTotalNumber_sbt=%X  ",HexBlockTotalNumber_sbt);
    VbtBlockTotalNumber_sbt=VbtBlockTotalNumber;
    write("VbtBlockTotalNumber_sbt=%X  ",VbtBlockTotalNumber_sbt);
    HexLength_sbt = Hexlen;
    VbtLength_sbt=Vbtlen;   
  }
  else
  {
    HexBlockTotalNumber_app = HexBlockTotalNumber;
    write("HexBlockTotalNumber_app=%X  ",HexBlockTotalNumber_app);
    VbtBlockTotalNumber_app=VbtBlockTotalNumber;
    write("VbtBlockTotalNumber_app=%X  ",VbtBlockTotalNumber_app);
    HexLength_app = Hexlen;
    VbtLength_app=Vbtlen;
  }
  hexBytesRead = 0;
  /*[VBF流式改造-2026-09]hex 数据段:按 64KB 块顺序从 VBF 文件读入 dataBuffer。
    CAPL File I/O 无 fileSeek,依赖 fileGetBinaryBlock 顺序前进特性。
    替代原 for 循环逐字节从 ReadData[0x100000] 拷贝的方式。*/
  for(i=0;i<HexBlockTotalNumber;i++)
  {
    hexfile[i].BlockStartAddr = hexStartAddr + (0x10000 * i)  ;
    if(i == HexBlockTotalNumber - 1)
    {
      qword lastLenth;//最后一段数据长度
      word inx;//角标偏移
      inx = 0;
      hexfile[i].BlockDataLength = Hexlen - 0x10000 * i;
      if(Hexlen <= 65535)
      {
        lastLenth = Hexlen;
      }
      else
      {
        lastLenth = Hexlen - 0x10000 * i;
      }
//      write("lastLenth = 0x%X",lastLenth);
      hexBytesRead += fileGetBinaryBlock(hexfile[i].dataBuffer,(long)(lastLenth-inx),vbfHandle);
    }
    else
    {
      hexfile[i].BlockDataLength = 0x10000;
      hexBytesRead += fileGetBinaryBlock(hexfile[i].dataBuffer,0x10000,vbfHandle);
    }
  }
  /*[VBF流式]定位 vbt 数据段起始:原 ReadData 布局为 [hex(Hexlen)][分隔(10)][vbt(Vbtlen)]。
    hex 段已顺序读取 hexBytesRead 字节,需跳过 (Hexlen+10-hexBytesRead) 字节到达 vbt 段。*/
  vbtSkipLen = (long)Hexlen + 10 - (long)hexBytesRead;
  while(vbtSkipLen > 0)
  {
    dword thisSkip;
    if(vbtSkipLen > elCount(skipBuf))
      thisSkip = elCount(skipBuf);
    else
      thisSkip = vbtSkipLen;
    fileGetBinaryBlock(skipBuf,thisSkip,vbfHandle);
    vbtSkipLen -= thisSkip;
  }
  /*[VBF流式改造-2026-09]vbt 数据段:按 64KB 块顺序从 VBF 文件读入 dataVbtBuffer。
    替代原 for 循环逐字节从 ReadData[0x10000*i+j+Hexlen+10] 拷贝的方式。*/
  for(i = 0; i < VbtBlockTotalNumber; i++)
  {
    hexfile[i].BlockVbtStartAddr = vbtStartAddr + (0x10000 * i)  ;
    if(i == VbtBlockTotalNumber - 1)
    {
      qword lastLenth;//最后一段数据长度
      word inx;//角标偏移
      inx = 0;
      hexfile[i].BlockVbtDataLength = Vbtlen - 0x10000 * i;
      if(Vbtlen <= 65535)
      {
        lastLenth = Vbtlen;
      }
      else
      {
        lastLenth = Vbtlen - 0x10000 * i;
      }
      fileGetBinaryBlock(hexfile[i].dataVbtBuffer,(long)lastLenth,vbfHandle);
    }
    else
    {
      hexfile[i].BlockVbtDataLength = 0x10000;
      fileGetBinaryBlock(hexfile[i].dataVbtBuffer,0x10000,vbfHandle);
    }
  }
  fileClose(vbfHandle);
  vbtStartAddr = 0;
  vbtLength = 0;
  hexStartAddr = 0;
  hexLength = 0;
  inx_7D = 0;
  vbfLength = 0;
}

/*
  查找目标字符串chararray在hexarray中的结束位置
  参数hexarray：数据
  参数offset：查找的起始位
  参数chararray：查找的目标字符串
  返回值a：查找到的结束位
*/
long Hexandchar_strstr(byte hexarray[],long offset,char chararray[])
{
  long i,j,a;
  i=0;a=0;
  for(i=offset;i<elcount(hexarray);i++)
  {
    for(j=0;j<strlen(chararray);j++)
    {
      if(hexarray[i+j]!=chararray[j])
      {
        break;
      }
    }
    if(j==strlen(chararray))
    {
      a=i+strlen(chararray);
      for(j=a;j<strlen(chararray);j++)
      {}
      break;
    }
  }
  return a;
}

/*
  获取hex文件的起始地址
  参数Filenum：对应的文件栏序号
*/
dword _gethexaddr(byte Filenum,dword eraseaddr[][],dword eraselength[][])
{
  dword hexaddr,hexaddrend,hexlength;
  
  hexaddr = eraseaddr[Filenum][0];
  /*故障注入：FF 00擦除过程中部分地址未进行擦除*/
  if(@Faultinsert::TC_FF00_Part==1)
  {
    hexaddr = eraseaddr[Filenum][1];
    Resp_34_a = 0x70;
    Exit_34_a = 1;
    @Faultinsert::TC_FF00_Part==0;
  }
  return hexaddr;
}
/*
  获取hex文件的地址大小
  参数Filenum：对应的文件栏序号
*/
dword _gethexlength(byte Filenum,dword eraseaddr[][],dword eraselength[][])
{
  dword hexaddr,hexaddrend,hexlength;
  word i;
  
  hexaddr = eraseaddr[Filenum][0];
  for(i=0;i<elCount(eraseaddr[Filenum]);i++)
  {
    if(eraseaddr[Filenum][i]==0 && eraselength[Filenum][i]==0)
    {
      hexaddrend = eraseaddr[Filenum][i-1] + eraselength[Filenum][i-1] - 1;
      break;
    }
    else
      continue;
  }
  hexlength = hexaddrend - hexaddr + 1;
  return hexlength;
}

/// <DownLoad>
//分段擦除，循环FF00、34、36、37
//参数openhex：0为下载第一个hex文件，1为下载第二个hex文件
void _download_1(dword openhex)
{
  byte datanow[60];
  byte datanext[60];
  char filename[1000];
  dword addrh;
  dword addrl;
  dword addr;
  dword addrlast;
  dword length34;
  dword i;
  byte first_read;
  first_read = 1;
  i = 0;
  eraseadd = 0;
  
  if(openhex==0)
    sysGetVariableString(sysvar::Test::openhex,filename,elCount(filename));
  else if(openhex==1)
    sysGetVariableString(sysvar::Test::openhex1,filename,elCount(filename));
  else
    sysGetVariableString(sysvar::Test::openhex2,filename,elCount(filename));
  
  glbHandle = OpenFileRead(filename,0);
  _readhex(datanow);//第一次获取数据，数据类型应是04
  while(1)
  {
    hextype=datanow[3];
    //判断hex文件这一行的数据类型，00、04继续，05、01表示文件结束
    if(hextype==4 || hextype==2)
    {
      addrh=((word)datanow[4]<<8)|datanow[5];
      addr=(dword)addrh<<16;//先获取地址的高16位
      _readhex(datanow);//先获取一次00数据类型的数据
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
      /*合并连续地址段流式36:仅加载首段,后续段在_App_36_merge中逐段加载发送*/
    }
    else if(hextype==0)
    {
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
      hextype = datanow[3];
      if(hextype == 4 && Continueaddr[openhex][eraseadd] == 1)
      {
        addrlast = addr; 
        Continueaddr[openhex][eraseadd] ++;
        _readhex(datanow);//先获取一次00数据类型的数据
        _loadpage1(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
        addr = addrlast;
      }
    }
    else if(hextype==5)
      break;
    else if(hextype==1)
      break;
    else
      break;
//    write("Continueaddr[%d][%d] = %x",openhex,eraseadd,Continueaddr[openhex][eraseadd]);
//    write("addr = %x, length34 = %x",addr,length34);
    /*故障注入：FF 00擦除过程中部分地址未进行擦除*/
    if(@Faultinsert::TC_FF00_Part==1)
    {
      eraseadd = 1;
      Resp_34_a = 0x70;
      Exit_34_a = 1;
      @Faultinsert::TC_FF00_Part==0;
    }
    /*FF00内存擦除服务*/
      _Sendff00(eraseaddr[openhex][eraseadd],eraselength[openhex][eraseadd],phyID);

    /*故障注入：31 01 FF 00后31 01 FF 00*/
    if(@Faultinsert::TC_Re_FF00==1)
    {
      eraseadd++;
      Resp_ff00 = 0x24;
      Exit_ff00 = 1;
      @Faultinsert::TC_Re_FF00=0;
      continue;
    }
    if(Exit_ff00==1)
    {
      Exit_Download = 1;
      return;
    }
    /*奇瑞特殊流程*/
    if(@AUTO::Config_Switch==7)
    {
      _Send03FF00(phyID,Resp_ff00);
      if(Exit_03ff00==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send02FF00(phyID,Resp_ff00);
      if(Exit_02ff00==1)
      {
        Exit_Download = 1;
        return;
      }
    }
    /*分段请求hex文件地址段*/
    if(@AUTO::MergeAddr_Switch == 1 && Continueaddr[openhex][eraseadd] >= 1)
      App_34(addr,eraselength[openhex][eraseadd]);/*合并块:34请求整段长度*/
    else
      App_34(addr,length34);
    if(Exit_34_a==1)
    {
      Exit_Download = 1;
      return;
    }
    /*合并块:流式36发送(含故障注入+CRC增量累积),非合并块走原流程*/
    if(@AUTO::MergeAddr_Switch == 1 && Continueaddr[openhex][eraseadd] >= 1)
    {
      _App_36_merge(openhex,eraseadd,eraselength[openhex][eraseadd],length34,datanow,addr);
    }
    else
    {
      /*故障注入：APP 36下载的数据错误*/
      if(@Faultinsert::TC_Error_36_A==1)
      {
        for(i=0;i<length34;i++)
        {
          data36[i] = 0xFF;
        }
        PassState_31[0] = 0x01;
        Exit_0202_a = 1;
      }
      
      /*APP36 数据传输服务*/
      App_36(addr,data36,length34);
      crc16[eraseadd] = _caculateCrc16(0xFFFF,data36,length34);
      calcrc16 = _caculateCrc16(calcrc16,data36,length34);
      calcrc32=_caculateCrc32(data36,length34);
      calcrc32 = calcrc32^0xFFFFFFFF;
    }
   
    if(Exit_36_a==1)
    {
      Exit_Download = 1;
      return;
    }

    /*APP37 退出服务*/
    App_37();
    
    eraseadd++;
    if(Exit_37_a==1)
    {
      Exit_Download = 1;
      return;
    }
    /*不同主机厂数据校验不同*/
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==3 || @AUTO::Config_Switch==5
    || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==8 || @AUTO::Config_Switch==13)//BYD || Geely1.0 || 鑫源 || 瑞驰 || 五菱 || V8
    {
      /*APP 31 01 02 02数据校验*/
      _Send0202_a(data36,length34,phyID,Resp_0202_a);
    }
    if(Exit_0202_a==1)
    {
      Exit_Download = 1;
      return;
    }
    if(Break_Download==1)
    {
      break;
    }
  }
  /*奇瑞特殊流程*/
  if(@AUTO::Config_Switch==7)
  {
    for(eraseadd=0;eraseadd<elcount(eraseaddr);eraseadd++)
    {
      if(eraseaddr[openhex][eraseadd]==0 && eraselength[openhex][eraseadd]==0)
        break;
      current_crc16 = crc16[eraseadd];
      EraseAddr = eraseaddr[openhex][eraseadd];
      EraseLength = eraselength[openhex][eraseadd];
      _SendFF01(phyID,Resp_ff01);
      /*故障注入：奇瑞 31 01 FF 01后31 01 FF 01*/
      if(@Faultinsert::TC_Re_FF01==1)
      {
        Resp_ff01 = 0x22;
        Exit_ff01 = 1;
        @Faultinsert::TC_Re_FF01=0;
        continue;
      }
      if(Exit_ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send03FF01(phyID,Resp_ff01);
      if(Exit_03ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send02FF01(phyID,Resp_ff01);
      if(Exit_02ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      /*故障注入：FF 01依赖性检查过程中部分地址段未进行检查*/
      if(@Faultinsert::TC_FF01_Part==1)
      {
        Resp_DA04 = 0x22;
        Exit_DA04 = 1;
        break;
      }
    }
  }
//  else if(@AUTO::Config_Switch==11)
//  {
//    _Send01DD02(phyID,Resp_01DD02);
//    Data_Check_Chery();
//  }
  /*赛力斯特殊流程*/
  if(@AUTO::Config_Switch==10)
  {
    /*APP 31 01 02 02数据校验*/
    _Send0202_a(data36,length34,phyID,Resp_0202_a);
    if(Exit_0202_a==1)
    {
      Exit_Download = 1;
      return;
    }
  }
  if(@AUTO::Config_Switch==13) //v8兼容性校验
  {
    /*APP 31 01 FF 01数据校验*/
    _SendFF01(phyID,Resp_ff01);
  }
  fileClose(glbHandle);
}
/// <DownLoad>
/*
  34、36、37循环下载数据，0为下载第一个hex文件，1为下载第二个hex文件
*/
void _download_2(dword openhex)
{
  byte datanow[60];
  byte datanext[60];
  char filename[1000];
  dword addrh;
  dword addrl;
  dword addr;
  dword length34;
  dword i;
  i = 0;
  eraseadd = 0;
  calcrc32 = 0xFFFFFFFF;
  
  if(openhex==0)
  {
    sysGetVariableString(sysvar::Test::openhex,filename,elCount(filename));
  }
  else if(openhex==1)
  {
    sysGetVariableString(sysvar::Test::openhex1,filename,elCount(filename));
  }
  else
  {
    sysGetVariableString(sysvar::Test::openhex2,filename,elCount(filename));
  }
  glbHandle = OpenFileRead(filename,0);
  _readhex(datanow);//第一次获取数据，数据类型应是04
  /*34、36、37开始循环*/
  while(1)
  {
    hextype=datanow[3];
    //判断hex文件这一行的数据类型，00、04继续，05表示文件结束
    if(hextype==4 || hextype==2)
    {
      addrh=((word)datanow[4]<<8)|datanow[5];
      addr=(dword)addrh<<16;//先获取地址的高16位
      _readhex(datanow);//先获取一次00数据类型的数据
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
    }
    else if(hextype==0)
    {
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
    }
    else if(hextype==5)
      break;
    else if(hextype==1)
      break;
    else
      break;
//    write("addr = %x,length = %x",addr,length34);
    /*APP34 请求下载*/
    App_34(addr,length34);
    if(Exit_34_a==1)
    {
      Exit_Download = 1;
      return;
    }
    /*故障注入：APP 36下载的数据错误*/
    if(@Faultinsert::TC_Error_36_A==1)
    {
      for(i=0;i<length34;i++)
      {
        data36[i] = 0xFF;
      }
      PassState_31[0] = 0x01;
      Exit_0202_a = 1;
    }
    /*APP36 传输数据*/
    
    App_36(addr,data36,length34);
    crc16[eraseadd] = _caculateCrc16(0xFFFF,data36,length34);
    calcrc16 = _caculateCrc16(calcrc16,data36,length34);
    calcrc32 = _caculateCrc32_1(calcrc32,data36,length34);
    eraseadd++;
    if(Exit_36_a==1)
    {
      Exit_Download = 1;
      return;
    }
    /*APP37 请求退出*/
    App_37();
    if(Exit_37_a==1)
    {
      Exit_Download = 1;
      return;
    }
  
    if(Break_Download==1)
    {
      break;
    }
  }
  /*不同主机厂数据校验不同*/
  if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==3 || @AUTO::Config_Switch==5
  || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==8 || @AUTO::Config_Switch==10 
  || @AUTO::Config_Switch==12)//BYD || Geely1.0 || 鑫源 || 瑞驰 || 五菱 || 赛力斯 || 广汽
  {
    /*APP 31 01 02 02数据校验*/
    _Send0202_a(data36,length34,phyID,Resp_0202_a);
  }
  if(Exit_0202_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*奇瑞特殊流程*/
  if(@AUTO::Config_Switch==7)
  {
    for(eraseadd=0;eraseadd<elcount(eraseaddr);eraseadd++)
    {
      if(eraseaddr[openhex][eraseadd]==0 && eraselength[openhex][eraseadd]==0)
        break;
      current_crc16 = crc16[eraseadd];
      EraseAddr = eraseaddr[openhex][eraseadd];
      EraseLength = eraselength[openhex][eraseadd];
      _SendFF01(phyID,Resp_ff01);
      /*故障注入：奇瑞 31 01 FF 01后31 01 FF 01*/
      if(@Faultinsert::TC_Re_FF01==1)
      {
        Resp_ff01 = 0x22;
        Exit_ff01 = 1;
        @Faultinsert::TC_Re_FF01=0;
        continue;
      }
      if(Exit_ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send03FF01(phyID,Resp_ff01);
      if(Exit_03ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send02FF01(phyID,Resp_ff01);
      if(Exit_02ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      //故障注入：FF 01依赖性检查过程中部分地址段未进行检查
      if(@Faultinsert::TC_FF01_Part==1)
      {
        Resp_DA04 = 0x22;
        Exit_DA04 = 1;
        break;
      }
    }
  }
//  else if(@AUTO::Config_Switch==11)
//  {
//    _Send01DD02(phyID,Resp_01DD02);
//    Data_Check_Chery();
//  }
  fileClose(glbHandle);
}

/// <DownLoad>
//34请求整段地址，36循环至数据下载完成,然后37
void _download_3(dword openhex)
{
  byte datanow[60];
  byte datanext[60];
  char filename[1000];
  dword addrh;
  dword addrl;
  dword addr,hexaddr,hexlength;
  dword length34;
  dword i;
  i = 0;
  countcnt1 = 1;             /*每次36循坏下载时，块编号置1*/
  calcrc32 = 0xFFFFFFFF;     /*CRC32 校验值初始化*/
  
  if(openhex==0)
  {
    sysGetVariableString(sysvar::Test::openhex,filename,elCount(filename));
  }
  else if(openhex==1)
  {
    sysGetVariableString(sysvar::Test::openhex1,filename,elCount(filename));
  }
  else
  {
    sysGetVariableString(sysvar::Test::openhex2,filename,elCount(filename));
  }
  glbHandle = OpenFileRead(filename,0);
  _readhex(datanow);//第一次获取数据，数据类型应是04
  
  /*APP34 请求HEX文件整个地址段*/
  /*获取HEX文件起始地址*/
  hexaddr = _gethexaddr(openhex,eraseaddr,eraselength);
  /*获取HEX文件地址长度*/
  hexlength = _gethexlength(openhex,eraseaddr,eraselength);
  App_34(hexaddr,hexlength);

  testWaitForTimeout(100);
  if(Exit_34_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*36循环至数据下载完成*/
  while(1)
  {
    hextype=datanow[3];
    //判断hex文件这一行的数据类型，00、04继续，05表示文件结束
    if(hextype==4 || hextype==2)
    {
      addrh=((word)datanow[4]<<8)|datanow[5];
      addr=(dword)addrh<<16;//先获取地址的高16位
      _readhex(datanow);//先获取一次00数据类型的数据
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
    }
    else if(hextype==0)
    {
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
    }
    else if(hextype==5)
    {
      if(@Faultinsert::TC_Continue_36_A == 1) 
      {
        write("/*--------------- 读取到最后一行 ---------------*/");
        END_Pos = 2; 
      }
      break;
    }
    else if(hextype==1)
    {
      if(@Faultinsert::TC_Continue_36_A == 1) 
      {
        write("/*--------------- 读取到最后一行 ---------------*/");
        END_Pos = 2; 
      }
      break;
    }
    else
      break;
    /*APP36 传输数据*/
//    write("length34 = %x",length34);
    APP_36(addr,data36,length34);
    crc16[eraseadd] = _caculateCrc16(0xFFFF,data36,length34);
    calcrc16 = _caculateCrc16(calcrc16,data36,length34);
    calcrc32 = _caculateCrc32_1(calcrc32,data36,length34);
    if(Exit_36_a==1)
    {
      Exit_Download = 1;
      return;
    }
    if(Break_Download==1)
    {
      break;
    }
  }
  fileClose(glbHandle);
  /*APP37 请求退出*/
//  _Send37(phyID,Resp_37_a);
  App_37();
  if(Exit_37_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*
    不同主机厂数据校验不同
    BYD || Geely1.0 || 鑫源 || 瑞驰 || 五菱 || 赛力斯 || 奇瑞T1V || 广汽
  */
  if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==3 || @AUTO::Config_Switch==5
  || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==8 || @AUTO::Config_Switch==10
  || @AUTO::Config_Switch==11|| @AUTO::Config_Switch==12)
  {
    /*APP 31 01 02 02数据校验*/
    _Send0202_a(data36,length34,phyID,Resp_0202_a);
  }
    /*奇瑞特殊流程2*/
  if(@AUTO::Config_Switch==7)
  {
      EraseLength = hexlength;
      EraseAddr = eraseaddr[openhex][0];
      current_crc16 = calcrc16;
     
      _SendFF01(phyID,Resp_ff01);
      /*故障注入：奇瑞 31 01 FF 01后31 01 FF 01*/
      if(@Faultinsert::TC_Re_FF01==1)
      {
        Resp_ff01 = 0x22;
        Exit_ff01 = 1;
        @Faultinsert::TC_Re_FF01=0;
        _SendFF01(phyID,Resp_ff01);
      }
      if(Exit_ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send03FF01(phyID,Resp_ff01);
      if(Exit_03ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send02FF01(phyID,Resp_ff01);
      if(Exit_02ff01==1)
      {
        Exit_Download = 1;
        return;
      }

  }
  else if(@AUTO::Config_Switch==11)
  {
    Data_Check_Chery();
    if(Exit_ff01==1)
    {
      Exit_Download = 1;
      return;
    }
  }
  if(Exit_0202_a==1)
  {
    Exit_Download = 1;
    return;
  }
  
}

/// <DownLoad>
//分段擦除，先循环FF00，然后34、36、37循环
//参数openhex：0为下载第一个hex文件，1为下载第二个hex文件
void _download_4(dword openhex)
{
  byte datanow[60];
  byte datanext[60];
  byte i;
  char filename[1000];
  dword addrh;
  dword addrl;
  dword addr;
  dword addrlast;
  dword length34;
  i = 0;
  eraseadd = 0;
  
  if(openhex==0)
  {
    sysGetVariableString(sysvar::Test::openhex,filename,elCount(filename));
  }
  else if(openhex==1)
  {
    sysGetVariableString(sysvar::Test::openhex1,filename,elCount(filename));
  }
  else
  {
    sysGetVariableString(sysvar::Test::openhex2,filename,elCount(filename));
  }
  
  /*循环FF00，擦除整个HEX文件地址段*/
  for(eraseadd=0;eraseadd<elcount(eraseaddr);eraseadd++)
  {
    if(eraseaddr[openhex][eraseadd]==0 && eraselength[openhex][eraseadd]==0)
      break;
    _Sendff00(eraseaddr[openhex][eraseadd],eraselength[openhex][eraseadd],phyID);
    //故障注入：FF 01依赖性检查过程中部分地址段未进行检查
    if(@Faultinsert::TC_FF00_Part==1)
    {
      Resp_34_a = 0x70;
      Exit_34_a = 1;
      @Faultinsert::TC_FF00_Part==0;
      break;
    }
    if(Exit_ff00==1)
    {
      Exit_Download = 1;
      return;
    }
  }
  glbHandle = OpenFileRead(filename,0);
  _readhex(datanow);//第一次获取数据，数据类型应是04
  eraseadd = 0;                                 /*重置eraseadd用于数据下载时跟踪逻辑块*/
  while(1)
  {
    hextype=datanow[3];
    //判断hex文件这一行的数据类型，00、04继续，05、01表示文件结束
    if(hextype==4 || hextype==2)
    {
      addrh=((word)datanow[4]<<8)|datanow[5];
      addr=(dword)addrh<<16;//先获取地址的高16位
      /*合并地址段开关打开时，跟踪当前04段所属的逻辑块*/
      if(@AUTO::MergeAddr_Switch == 1)
      {
        while(eraseaddr[openhex][eraseadd]!=0 &&
              addr >= eraseaddr[openhex][eraseadd]+eraselength[openhex][eraseadd])
          eraseadd++;
      }
      _readhex(datanow);//先获取一次00数据类型的数据
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
      /*合并连续地址段流式36:仅加载首段,后续段在_App_36_merge中逐段加载发送*/
    }
    else if(hextype==0)
    {
      _loadpage(data36,datanow,addr,length34);//装载数据到data36，并返回地址、长度和下一段04、05数据类型
    }
    else if(hextype==5)
      break;
    else if(hextype==1)
      break;
    else
      break;
    //分段请求hex文件地址段
    if(@AUTO::MergeAddr_Switch == 1 && Continueaddr[openhex][eraseadd] >= 1)
      App_34(addr,eraselength[openhex][eraseadd]);/*合并块:34请求整段长度*/
    else
      App_34(addr,length34);
    if(Exit_34_a==1)
    {
      Exit_Download = 1;
      break;
    }
    /*合并块:流式36发送(含故障注入+CRC增量累积),非合并块走原流程*/
    if(@AUTO::MergeAddr_Switch == 1 && Continueaddr[openhex][eraseadd] >= 1)
    {
      _App_36_merge(openhex,eraseadd,eraselength[openhex][eraseadd],length34,datanow,addr);
      i++;                                        /*合并块只产生一个crc16条目*/
    }
    else
    {
      //APP36数据传输服务
      App_36(addr,data36,length34);
      crc16[i] = _caculateCrc16(0xFFFF,data36,length34);
      i++;
      calcrc16 = _caculateCrc16(calcrc16,data36,length34);
    }
    if(Exit_36_a==1)
    {
      Exit_Download = 1;
      break;
    }
    if(Continue_36_a==1)
    {
      continue;
    }
    //APP37退出服务
    App_37();
    if(Exit_37_a==1)
    {
      Exit_Download = 1;
      break;
    }
    if(@AUTO::Config_Switch==3)//Geely1.0
    {
      /*APP 31 01 02 02数据校验*/
      _Send0202_a(data36,length34,phyID,Resp_0202_a);
      if(Exit_0202_a==1)
      {
        Exit_Download = 1;
        return;
      }
    }
    if(Break_Download==1)
    {
      break;
    }
  }
  /*奇瑞特殊流程*/
  if(@AUTO::Config_Switch==7)
  {
    for(eraseadd=0;eraseadd<elcount(eraseaddr);eraseadd++)
    {
      if(eraseaddr[openhex][eraseadd]==0 && eraselength[openhex][eraseadd]==0)
        break;
      current_crc16 = crc16[eraseadd];
      EraseAddr = eraseaddr[openhex][eraseadd];
      EraseLength = eraselength[openhex][eraseadd];
      _SendFF01(phyID,Resp_ff01);
      /*故障注入：奇瑞 31 01 FF 01后31 01 FF 01*/
      if(@Faultinsert::TC_Re_FF01==1)
      {
        Resp_ff01 = 0x22;
        Exit_ff01 = 1;
        @Faultinsert::TC_Re_FF01=0;
        continue;
      }
      if(Exit_ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send03FF01(phyID,Resp_ff01);
      if(Exit_03ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      _Send02FF01(phyID,Resp_ff01);
      if(Exit_02ff01==1)
      {
        Exit_Download = 1;
        return;
      }
      //故障注入：FF 01依赖性检查过程中部分地址段未进行检查
      if(@Faultinsert::TC_FF01_Part==1)
      {
        Resp_DA04 = 0x22;
        Exit_DA04 = 1;
        break;
      }
    }
  }
  /*不同主机厂数据校验不同*/
  if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5
  || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==8)//BYD || 鑫源 || 瑞驰 || 五菱
  {
    /*APP 31 01 02 02数据校验*/
    _Send0202_a(data36,length34,phyID,Resp_0202_a);
    if(Exit_0202_a==1)
    {
      Exit_Download = 1;
      return;
    }
  }
  fileClose(glbHandle);
}

/// <DownLoad>
/*[流式改造-2026-09]_download_5 的流式版本:替代原整段 dataBuffer 装载。
  流程:打开 bin 文件流 → App_34 → _Send36_App_stream(按页读取发送+逐页CRC) → App_37 → 关闭流。
  内存占用:仅 hexfile_app[0].dataBuffer[0x1000] 单页缓冲(4KB),不再常驻整文件。*/
void _download_5_stream(dword openhex,int Pos_Struct)
{
  dword fileHandle_;
  countcnt1 = 1;             /*每次36循环下载时，块编号置1*/
  countcnt3 = 0;
  App_34(hexfile_app[Pos_Struct].BlockStartAddr,hexfile_app[Pos_Struct].BlockDataLength);
  testWaitForTimeout(100);
  if(Exit_34_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*打开 bin 文件流,跳过头部到数据段起始*/
  fileHandle_ = BinFile_OpenStream(openhex);
  if(fileHandle_==0)
  {
    writeEx(-3,1,"[流式]打开 bin 文件失败,文件栏%d",openhex);
    Exit_Download = 1;
    return;
  }
  /*APP36 流式传输数据(按页从文件读取)+ 逐页累加 CRC32*/
  _Send36_App_stream(fileHandle_,hexfile_app[Pos_Struct].BlockDataLength,countcnt3,0);
  BinFile_CloseStream(openhex);
  if(Exit_36_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*APP37 请求退出*/
  App_37();
  if(Exit_37_a==1)
  {
    Exit_Download = 1;
    return;
  }
}

/// <DownLoad>
/*
    [CBF流式]奇瑞 T1V(Config_Switch==11) 整段下载(EraseMode_Switch==3)。
    流程:App_34(整段地址) -> 36 流式逐页发送(从 CBF 文件纯数据段读取) -> App_37 -> 0202 校验。
    复用 _Send36_App_stream 分页读取与 CRC32 累加;calcrc32 在本函数内初始化为 0xFFFFFFFF,
    与 _download_3 的 EraseMode==3 分支一致,0202 校验取 calcrc32^0xFFFFFFFF。
    前置:CBFFile_ReadAndSave 已填充 hexfile_app[0].BlockStartAddr/BlockDataLength/BlockEndAddr
         并计算 cbfDataOffset。
*/
void _download_CBF_stream()
{
  dword fileHandle_;
  countcnt1 = 1;             /*每次36循环下载时，块编号置1*/
  countcnt3 = 0;
  calcrc32 = 0xFFFFFFFF;     /*CRC32 校验值初始化(与 _download_3 一致)*/

  /*APP34 请求整个地址段*/
  App_34(hexfile_app[0].BlockStartAddr,hexfile_app[0].BlockDataLength);
  testWaitForTimeout(100);
  if(Exit_34_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*打开 CBF 文件流,跳过头部到纯数据段起始*/
  fileHandle_ = CBFFile_OpenStream();
  if(fileHandle_==0)
  {
    writeEx(-3,1,"[CBF流式]打开 CBF 文件失败");
    Exit_Download = 1;
    return;
  }
  /*APP36 流式传输数据(按页从 CBF 文件读取)+ 逐页累加 CRC32*/
  _Send36_App_stream(fileHandle_,hexfile_app[0].BlockDataLength,countcnt3,0);
  CBFFile_CloseStream();
  if(Exit_36_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*APP37 请求退出*/
  App_37();
  if(Exit_37_a==1)
  {
    Exit_Download = 1;
    return;
  }
  /*APP 31 01 02 02 数据校验(EraseMode==3 走 else 分支,使用累计 calcrc32)*/
  _Send0202_a(hexfile_app[0].dataBuffer,hexfile_app[0].BlockDataLength,phyID,Resp_0202_a);
  Data_Check_Chery();
  if(Exit_ff01==1)
  {
    Exit_Download = 1;
    return;
  }
  if(Exit_0202_a==1)
  {
    Exit_Download = 1;
    return;
  }
}


void Data_Check_Chery()
{
  if(@AUTO::Config_Switch==11)
  {
//    //驱动下载数据校验31 01 DD 0F
//    FlashDriver_0202();
//    if(Exit_0202_f==1)
//    {
//      Exit_Re_Prog = 1;
//      return;
//    }
    if(@Faultinsert::TC_Miss_34_F==1)
      PassState_31[0] = 0x01;
    //软硬件一致性检查 31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    if(Exit_ff01==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    if(@Faultinsert::TC_Re_FF01==1)
      {
        Resp_ff01 = 0x22;
        Exit_ff01 = 1;
        @Faultinsert::TC_Re_FF01=0;
      }
      if(Exit_ff01==1)
      {
        Exit_Download = 1;
        return;
      }
    {
//     //31 01 DD 03
//      _Send01DD03(phyID,-1);
//    //22 F0 F0
//      ReadIdentify(phyID,0xF0F2,Resp_22);
    }
  }
}

/// <Geely3.0>
//Geely3.0 下载APP数据流程:FF00 34 36 37 0212
void Data_Download(int FileNum)
{
  int VbtFlage;
  
  for(VbtFlage=0;VbtFlage<=1;VbtFlage++)
  {
    //31 01 FF 00
    APP_FF00(VbtFlage);
    if(Exit_ff00==1)
    {
      Exit_Download = 1;
      return;
    }
  }
  //故障注入：FF00擦除后 直接0205
  if(@Faultinsert::TC_FF00_0205)
  {
    //擦除swlm
    if(FileNum==1)
    {
      PassState_31[4] = 0x05;
      _Send0205(phyID,Resp_0205);
    }
    //擦除Swp1
    else if(FileNum==2)
    {
      PassState_31[4] = 0x21;
      _Send0205(phyID,Resp_0205);
    }
    //擦除Swp2
    else if(FileNum==3)
    {
      PassState_31[4] = 0x41;
      _Send0205(phyID,Resp_0205);
    }
    Exit_Download = 1;
    return;
  }
  //故障注入：重复请求已擦除的FF00
  if(@Faultinsert::TC_Re_FF00==1)
  {
    APP_FF00(1);
  }
  for(VbtFlage=0;VbtFlage<=1;VbtFlage++)
  {
    //故障注入：步骤缺失 APP 34 36 37
    if(@Faultinsert::TC_Miss_34_A==1 && @Faultinsert::TC_Miss_36_A==1 && @Faultinsert::TC_Miss_37_A==1)
    {
      PassState_31[1] = 0x06;
      Exit_0202_a = 1;
      if(@AUTO::Geely3_Config == 1) //P162
        Resp_0202_a = 0x24;
      break;
    }
    //APP 34请求数据下载
    App_34(VbtFlage);
    if(Exit_34_a==1)
    {
      Exit_Download = 1;
      return;
    }
    //APP 36传输数据
    App_36(VbtFlage);
    if(Exit_36_a==1)
    {
      Exit_Download = 1;
      Break_Download = 1;
      return;
    }
    //APP 37退出传输
    App_37();
    if(Exit_37_a==1)
    {
      Exit_Download = 1;
      return;
    }
    if(@Faultinsert::TC_Exit_in_36_A == 1) //37直接退出后不进行第二部分刷写
    {
      Break_Download = 1;
      break;
    }
  }
  //31 01 02 12签名校验
  _Send0212_A(phyID,FileNum,Resp_0202_a);
  if(Exit_0202_a==1)
  {
    Exit_Download = 1;
    return;
  }
}

/// <Geely3.0>
//Geely3.0 APP FF00擦除数据
void APP_FF00(int type)
{
  dword EraseAddr;
  dword EraseLength;
  dword i;
  i = 0;
  if(type == 0)
  {
    EraseAddr = hexfile_app[0].BlockStartAddr;
    EraseLength = 0;
    for(i=0;i<HexBlockTotalNumber_app;i++)
    {
      EraseLength += hexfile_app[i].BlockDataLength;
    }
  }
  else
  {
    EraseAddr = hexfile_app[0].BlockVbtStartAddr;
    EraseLength = 0;
    for(i=0;i<VbtBlockTotalNumber_app;i++)
    {
      EraseLength += hexfile_app[i].BlockVbtDataLength;
    }
  }
  _Sendff00(EraseAddr,EraseLength,phyID);  
  //故障注入：FF00后 物理寻址复位11 01
  if(@Faultinsert::TC_Restart_after_FF00==1 && type==1)
  {
    _Startreset(phyID,0x01,Resp_11);
    Resp_34_a = 0x33;
    Resp_ff00 = 0x31;
    Exit_34_a = 1;
  }
  //故障注入：FF00后 功能寻址切换默认会话10 01
  else if(@Faultinsert::TC_DefaultSession_after_FF00==1 && type==1)
  {
    enterDefault(funID,0,Resp_1001);
    Resp_34_a = 0x7F;
    Resp_ff00 = 0x31;
    Exit_34_a = 1;
  }
}
/// <Geely3.0>
//Geely3.0 APP 34请求数据
void APP_34(int type)
{
  dword EraseAddr;
  dword EraseLength;
  dword i;
  i = 0;
  
  //故障注入：步骤缺失 APP 34请求下载
  if(@Faultinsert::TC_Miss_34_A==1)
  {
    Resp_36_a = 0x24;
    Resp_37_a = 0x24;
    PassState_31[1] = 0x06;
    Exit_0202_a = 1;
    if(@AUTO::Geely3_Config == 1)
      Resp_0202_a = 0x24;
    return;
  }
  if(type==0)
  {
    EraseAddr = hexfile_app[0].BlockStartAddr;
    EraseLength = 0;
    for(i=0;i<HexBlockTotalNumber_app;i++)
    {
      EraseLength += hexfile_app[i].BlockDataLength;
    }
    if(App_DataFormatId==0x10)
      _Send34_App(vbtStartAddr,vbtLength,phyID,Resp_34_a);
    else
      _Send34_App(EraseAddr,EraseLength,phyID,Resp_34_a);
  }
  else if(type==1)
  {
    EraseAddr = hexfile_app[0].BlockVbtStartAddr;
    EraseLength = 0;
    for(i=0;i<HexBlockTotalNumber_app;i++)
    {
      EraseLength += hexfile_app[i].BlockVbtDataLength;
    }
    if(App_DataFormatId==0x10)
      _Send34_App(vbtStartAddr,vbtLength,phyID,Resp_34_a);
    else
      _Send34_App(EraseAddr,EraseLength,phyID,Resp_34_a);
  }
}

/// <Geely3.0>
//Geely3.0 APP 36传输数据
void APP_36(int type)
{
  dword i;
  i = 0;
  snprintf(stepid,elCount(stepid),"步骤%02d",stepnum);
  testStep(stepid,"开始测试写数据之36");
  countcnt3 = 0;
  AddrNum = 0;
  
  //故障注入：APP 36传输数据时低压
  if(@Faultinsert::TC_LowVolt_36_A==1)
  {
    @Prog_power::K30Volt = 8;
    testWaitForTimeout(Volt_Time);
    Resp_36_a = 0x93;
    Exit_36_a = 1;
  }
  //故障注入：APP 36传输数据时高压
  else if(@Faultinsert::TC_HighVolt_36_A==1)
  {
    @Prog_power::K30Volt = 19;
    testWaitForTimeout(Volt_Time);
    Resp_36_a = 0x93;
    Exit_36_a = 1;
  }
  
  //发送所有地址块
  for(i=0;i<HexBlockTotalNumber_app && type == 0;i++)
  {
    AddrNum++;
    _Send36_App(hexfile_app[i],countcnt3,0);
    //故障注入：36传输过程中直接37退出
    if(Geely3_36_Status == 0)
      break;
  }
  if(Geely3_36_Status == 0) //异常退出
    return;
  for(i=0;i<VbtBlockTotalNumber_app && type == 1;i++)
  {
    AddrNum++;
    if(Geely3_36_Status == 0)
      break;
    _Send36_App(hexfile_app[i],countcnt3,1);
  }
  //故障注入：36传输数据后 发送0205
  if(@Faultinsert::TC_36A_0205==1)
  {
    PassState_31[4] = 0x41;
    _Send0205(phyID,Resp_0205);
  }
}
//判断是否有外发报文
//参数Passcondition:{0:预期无外发报文;1:预期有外发报文}
int Check_Tx(int Passcondition)
{
  int result;
//  result = testWaitForMessage(TxMessage_ID,TxMessage_Time);
  result = Check_APPValid();
  if(Passcondition == 1)
  {
    if(result == Passcondition)
      testStepPass("App有效","");
    else
      testStepFail("App有效","");
  }
  else
  {
    if(result == Passcondition)
      testStepPass("App无效","");
    else
      testStepFail("App无效","");
  }
  return result;
}

void _saveMsg(int time)
{
  byte i,j;
  int flag_getMsg;
  flag_getMsg = _getMsg(responseMsgs[0],p2cmax*4);
  if(flag_getMsg == 1)
  {
    for(i = 1; i < 10; i++)
    {
      _getMsg(responseMsgs[i],200);
      if(responseMsgs[i].dlc == 0)
        break;
    }
  }
}

/**
  获取报文，判断报文响应时间是否在目标时间time内
**/
int _getMsg(message 0x00 msg,int time)
{
  char comment[50];
  byte i;
  int re;
  int resave;
  int flag_getMsg;//判断有没有获取到报文
  TestJoinMessageEvent(revID);
  re = testWaitForMessage(revID,time);
  if(re)
  {
    testGetWaitEventMsgData(msg);
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    }
    resave++;
    flag_getMsg = 1;
  }
  else
  {
    flag_getMsg = 0;
  }
  if(re == 0 && resave == 0)
  {
    TestStepFail("报文响应超时");
  }
  return flag_getMsg;
}

/// <Unlock>
int _CheckCode(int passcondition,int checkLength)
{
  int resNum,i,j,allRes_i;
  int checkResult,StartLen;
  word allRes[100];
  word dlc,allRes_length;
  dlc = (@sysvar::AUTO::CANFD_Switch==0)?8:16;
  StartLen = (@sysvar::AUTO::CANFD_Switch==0)?0:4;
  checkResult = 0;
  for(i = 0; i< 10; i++)//获取当前响应码序列长度
  {
    if(responseMsgs[i].dlc == 0)
    {
      break;
    }
    else if(responseMsgs[i].byte(0) == 0x03 && responseMsgs[i].byte(1) == 0x7f && responseMsgs[i].byte(3) == 0x78 && NRC78_flag == 0)//响应78不存入验证数组
    {
      allRes_i++;
      resNum--;
    }
    else if(responseMsgs[i].byte(0) == 0x30)  //流控帧不计入数组
    {
      allRes_i++;
      resNum--;
    }
    else
    {
      for(j = 0; j < dlc+StartLen ; j++)
      {
        allRes[((i-allRes_i)*dlc)+j] = responseMsgs[i].byte(j);
      }
    }  
    resNum++;
  }
  allRes_length = resNum * dlc;
  if(@sysvar::AUTO::Security_Switch == 2 && allRes_length > 0)//Geely 3.0 将响应的种子存入seed    需注意区分CAN与CANFD
  {
    word inx;
    inx = 4;
    if(@sysvar::AUTO::CANFD_Switch==0)
    {
      for(j = 0; j < 16; j++)
      {
        Seed_AES[j] = allRes[j+inx];
        if(j == 3)
          inx = 5;
        if(j == 10)
          inx = 6;
      }
    }
    else
    {
      for(j = 0; j < 16; j++)
        Seed_AES[j] = allRes[j+inx];
    }
    inx = 4;
  }
  if(passcondition == -1)
    testStepPass("收到肯定响应");
  else if(passcondition == 0)
    testStepfail("无响应");
  else
    testStepfail("收到否定响应");
  resNum = 0;
  allRes_i = 0;
  NRC78_flag = 0;
  for(i = 0; i < 100 ; i++)
    allRes[i] = 0;
  _initMsg(responseMsgs);
  return checkResult;
}

/* 操作完后将responseMsgs重置*/
void _initMsg(message 0x00 msg[])
{
  message 0x00 init_msg;
  word i,j;
  for(i = 0; i < elCount(msg); i++)
    msg[i] = init_msg;
}
/// <Unlock>
/*2702密钥填充：type:0:正确密钥  1:错误密钥*/
void _padding2702(int type,diagRequest* sendkey)
{
  word corresKey[16];
  word key_i;
//  byte Seed_Test[16] = {0x66,0xb0,0xcf,0x31,0xf5,0x6a,0xc1,0x6a,0xbf,0x46,0x10,0xdf,0x87,0xa1,0xae,0x20};
  if(type == 0)
  {
    if(@AUTO::Config_Switch == 4)
      if(curAppValid == 1)
        _SecurityAccess_AES(Seed_AES,fixByte_,corresKey);
      else
        _SecurityAccess_AES(Seed_AES,fixByte_Bt,corresKey);
    else if(@AUTO::Config_Switch == 6)
      _SecurityAccess_AES(Seed_AES,fixByte_2,corresKey);
    else if(@AUTO::Config_Switch == 2)
      _SecurityAccess_AES(Seed_AES,fixByte_CCAG_APP,corresKey);
    else if(@AUTO::Config_Switch == 11)
    {
//      if(curAppValid == 1)
//        _SecurityAccess_AES(Seed_AES,fixByte_Chery_APP,corresKey);
//      else
        _SecurityAccess_AES(Seed_AES,fixByte_Chery_BT,corresKey);
    }
    else if(@AUTO::Config_Switch == 13)
      _SecurityAccess_AES(Seed_AES,fixByte_V8,corresKey);
    for(key_i = 0; key_i < 16; key_i++)
    {
      DiagSetPrimitiveByte(sendkey,key_i+2,corresKey[key_i]);
//      writeEx(-3,0,"Key[%d] = 0x%02X",key_i,corresKey[key_i]);
    }
  }
  else
  {
    for(key_i = 0; key_i < 16; key_i++)
      DiagSetPrimitiveByte(sendkey,key_i+2,0x00);
  }
}
/// <Unlock>
void _SecurityAccess_AES(byte seed[], word Byte_[],word corresKey[])
{
  char M[16],mic[16];
  int i;
  char fixByte[16];
  word gHandle;
  for(i=0;i<16;i++)
  {
    fixByte[i] = Byte_[i];
  }
  gHandle = registerCAPLDLL();
  for(i = 0; i < 16; i++)
  {
    M[i] = seed[i];
  }
  aes_128_cmac(M,fixByte,mic);
  for(i = 0; i < 16; i++)
  {
    corresKey[i] = mic[i] & 0xFF;
  }
  fileClose(gHandle);
}
/*低电压刷写预期结果*/
void LowVolt_Resp(byte AppValid)
{
  /*APP有效情况下*/
  if(AppValid==1)
  {
    /*Geely 1.0*/
    if(@AUTO::Config_Switch==3)
    {
      Resp_1002 = 0x22;
      Exit_1002 = 1;
    }
    else
    {
      Resp_36_f = 0x93;
      Exit_36_f = 1;
    }
  }
  /*APP无效情况下*/
  else
  {
    Resp_36_f = 0x93;
    Exit_36_f = 1;
  }
}
/*高电压刷写预期结果*/
void HighVolt_Resp(byte AppValid)
{
  /*APP有效情况下*/
  if(AppValid==1)
  {
    /*Geely 1.0*/
    if(@AUTO::Config_Switch==3)
    {
      Resp_1002 = 0x22;
      Exit_1002 = 1;
    }
    else
    {
      Resp_36_f = 0x92;
      Exit_36_f = 1;
    }
  }
  /*APP无效情况下*/
  else
  {
    Resp_36_f = 0x92;
    Exit_36_f = 1;
  }
}


