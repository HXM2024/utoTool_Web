/// <Power>
/*****************新老化板******************/
//RelayON(端口X) ：端口X 黑色接口-黄色接口
//RelayOFF(端口X)：端口X 黑色接口-绿色接口
void RelayON(byte Ctr_state)
{
  Relaymsg.id=0x101;
  if(@Test::Burn_Board_Type==2)
    LHB_State = LHB_State_New;
  switch(Ctr_state)
  {//置为0
    case 1:LHB_State &= 0xFE;break;
    case 2:LHB_State &= 0xFD;break;
    case 3:LHB_State &= 0xFB;break;
    case 4:LHB_State &= 0xF7;break;
  }
  LHB_State_New = LHB_State;
  Relaymsg.byte(0) = LHB_State;
  output(Relaymsg);
}
/// <Power>
void RelayOFF(byte Ctr_state)
{ 
  Relaymsg.id=0x101;
  if(@Test::Burn_Board_Type==2)
    LHB_State = LHB_State_New;
  switch(Ctr_state)
  {//置为1
    case 1:LHB_State |= 1;break;
    case 2:LHB_State |= 2;break;
    case 3:LHB_State |= 4;break;
    case 4:LHB_State |= 8;break;
  }
  LHB_State_New = LHB_State;
  Relaymsg.byte(0) = LHB_State;
  output(Relaymsg);
}
/// <Power>
/*上点火*/
void _K15_ON()
{
  if(@Test::Burn_Board_Type==1)
    RelayON(2);
  else if(@Test::Burn_Board_Type==2)
    RelayOFF(2);
  else 
  {
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x01;
    IGON.byte(2)=0x01;
    output(IGON);
  } 
  writeEx(-3,1,"/*---------- KL15 上电 ----------*/");
  testWaitForTimeout(200);
}
/// <Power>
/*下点火*/
void _K15_OFF()
{
  if(@Test::Burn_Board_Type==1)
    RelayOFF(2);
  else if(@Test::Burn_Board_Type==2)
    RelayON(2);
  else
  {
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x01;
    IGON.byte(2)=0x00;
    output(IGON);
  }
  writeEx(-3,1,"/*---------- KL15 下电 ----------*/");
  testWaitForTimeout(200);
}
/// <Power>
/*上总电*/
void _K30_ON()
{
  if(@Test::Burn_Board_Type==1)
    RelayON(1);
  else if(@Test::Burn_Board_Type==2)
    RelayOFF(1);
  else 
  {
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x27;
    IGON.byte(2)=0x01;
    output(IGON);
  }
  writeEx(-3,1,"/*---------- KL30 上电 ----------*/");
  testWaitForTimeout(200);
}

/// <Power>
/*下总电*/
void _K30_OFF()
{
  if(@Test::Burn_Board_Type==1)
    RelayOFF(1);
  else if(@Test::Burn_Board_Type==2)
    RelayON(1);
  else
  {
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x27;
    IGON.byte(2)=0x00;
    output (IGON);
  } 
  writeEx(-3,1,"/*---------- KL30 下电 ----------*/");
  testWaitForTimeout(200);
}

/// <DownLoad>
void MainInit()
{
  _start_log();
  _Init_();
  testWaitForTimeout(100);
  writeclear(-1);
  stepnum=0;
}
/// <DownLoad>
void Deinit()
{
  _end_log();
  _Init_();
  testWaitForTimeout(Volt_Time);
}

//19
byte Check_APPValid()
{
  char comment[50];
  diagRequest ABS_ESP.FaultMemory_ReadAllIdentified req19;
  
  diagResize(req19,3);
  DiagSetPrimitiveByte(req19,0,0x19);
  DiagSetPrimitiveByte(req19,1,0x02);
  DiagSetPrimitiveByte(req19,2,0x01);
  _diagSendMsg(phyID,req19);
  
  testWaitForDiagRequestSent(req19,500);
  testWaitForDiagResponse(req19,1000);
  if(diagGetLastResponseCode(req19) == -1)
  {
    snprintf(comment,elCount(comment),"/*----------当前APP有效---------*/");
    writeEx(-3,1,comment);
    testCaseComment(comment);
    return 1;
  }
  else
  {
    snprintf(comment,elCount(comment),"/*----------当前APP无效---------*/");
    writeEx(-3,1,comment);
    testCaseComment(comment);
    return 0;
  }
}
byte Check_APPValid2()
{
  char comment[50];
  diagRequest ABS_ESP.FaultMemory_ReadAllIdentified req19;
  
  diagResize(req19,3);
  DiagSetPrimitiveByte(req19,0,0x19);
  DiagSetPrimitiveByte(req19,1,0x02);
  DiagSetPrimitiveByte(req19,2,0x01);
  _diagSendMsg(phyID,req19);
  
  testWaitForDiagResponse(req19,1000);
  if(diagGetLastResponseCode(req19) == -1)
  {
    snprintf(comment,elCount(comment),"/*----------当前APP有效---------*/");
    writeEx(-3,1,comment);
    testCaseComment(comment);
    @AUTO::APP_Invalid = 0;
    return 1;
  }
  else
  {
    snprintf(comment,elCount(comment),"/*----------当前APP无效---------*/");
    writeEx(-3,1,comment);
    testCaseComment(comment);
    if(@Faultinsert::TC_BT_AppValid == 1)
      @AUTO::APP_Invalid = 1;
    return 0;
  }
}
/// <DownLoad>
/*异常流程后初始化*/
void Resp_Init()
{
  //配置初始化
  @AUTO::APP_Valid = 0;               //APP有效标志位
  CarConfig_Init();
  Flash_DataFormatId=0x00;            //FlashDriver的指定数据格式标识
  App_DataFormatId=0x00;              //App的指定数据格式标识
  Flash_AddrAndLenId=0x44;            //FlashDriver的指定地址和长度格式标识
  App_AddrAndLenId=0x44;              //App的指定地址和长度格式标识
  
  //用于故障注入后中断刷写流程
  Exit_Pre_Prog = 0;          //预编程阶段 时退出流程标志位
  Exit_Re_Prog = 0;           //主编程阶段 时退出流程标志位
  Exit_Post_Prog = 0;         //后编程阶段 时退出流程标志位
  Exit_Download = 0;          //数据下载阶段 时退出流程标志位
  
  Exit_1002 = 0;              //执行到10 02时退出流程标志位
  Exit_1003 = 0;              //执行到10 03时退出流程标志位
  Exit_22 = 0;                //执行到22 时退出流程标志位
  Exit_27 = 0;                //执行到27 时退出流程标志位
  Exit_2E = 0;                //执行到2E 时退出流程标志位
  Exit_34_f = 0;              //执行到Flash 34时退出流程标志位
  Exit_36_f = 0;              //执行到Flash 36时退出流程标志位   
  Exit_37_f = 0;              //执行到Flash 37时退出流程标志位
  Exit_0202_f = 0;            //执行到Flash 02 02时退出流程标志位
  Exit_0301 = 0;              //执行到31 01 03 01时退出流程标志位
  Exit_ff00 = 0;              //执行到31 01 FF 00时退出流程标志位
  Exit_03ff00 = 0;            //执行到31 03 FF 00时退出流程标志位
  Exit_02ff00 = 0;            //执行到31 02 FF 00时退出流程标志位
  Exit_34_a = 0;              //执行到APP 34时退出流程标志位
  Exit_36_a = 0;              //执行到APP 36时退出流程标志位   
  Exit_37_a = 0;              //执行到APP 37时退出流程标志位
