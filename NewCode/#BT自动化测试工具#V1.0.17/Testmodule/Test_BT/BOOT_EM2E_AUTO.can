//用于创建Log,根据TestCase标题命名
void creat_log(char function[])
{
  //用于创造Log
  char log_name[200] = "./Logging";
  char testCaseTitle[200];
  char order[200];  
  long Time[9];
  char timeBuffer[200];
  word i;
  i = 0;
  
  snprintf(timeBuffer,elCount(timeBuffer),"%s","");
  getLocalTime(Time);
  snprintf(timeBuffer,200,"%s%s",timeBuffer,"___");
  snprintf(timeBuffer,200,"%s%d",timeBuffer,Time[5]+1900);
  snprintf(timeBuffer,200,"%s%s",timeBuffer,"-");
  snprintf(timeBuffer,200,"%s%d",timeBuffer,Time[4]+1);
  snprintf(timeBuffer,200,"%s%s",timeBuffer,"-");
  snprintf(timeBuffer,200,"%s%d",timeBuffer,Time[3]);
  snprintf(timeBuffer,200,"%s%s",timeBuffer,"_");
  if(Time[2]<10)
  {
    snprintf(timeBuffer,200,"%s%02X",timeBuffer,Time[2]);
  }
  if(Time[2]>=10)
  {
    snprintf(timeBuffer,200,"%s%d",timeBuffer,Time[2]);
  }
  snprintf(timeBuffer,200,"%s%s",timeBuffer,"-");
  if(Time[1]<10)
  {
    snprintf(timeBuffer,200,"%s%02X",timeBuffer,Time[1]);
  }
  if(Time[1]>=10)
  {
    snprintf(timeBuffer,200,"%s%d",timeBuffer,Time[1]);
  }
  snprintf(timeBuffer,200,"%s%s",timeBuffer,"-");
  if(Time[0]<10)
  {
    snprintf(timeBuffer,200,"%s%02X",timeBuffer,Time[0]);
  }
  if(Time[0]>=10)
  {
    snprintf(timeBuffer,200,"%s%d",timeBuffer,Time[0]);
  }
  LogNum++;
  if(LogNum < 10)
  {
    order[0] = LogNum+48;
    order[1] = '.';
  }
  else if(LogNum < 100)
  {
    order[0] = (LogNum/10)+48;
    order[1] = (LogNum%10)+48;
    order[2] = '.';
  }
  else if(LogNum < 1000)
  {
    order[0] = (LogNum/100)+48;
    order[1] = (LogNum/10%10)+48;
    order[2] = (LogNum%10)+48;
    order[3] = '.';
  }
  else if(LogNum < 10000)
  {
    order[0] = (LogNum/1000)+48;
    order[1] = (LogNum/100%10)+48;
    order[2] = (LogNum/10%10)+48;
    order[3] = (LogNum%10)+48;
    order[4] = '.';
  }
  testGetCurrentTestCaseTitle(testCaseTitle,200);
  log_name[0] = 92;
//  log_name[8] = 92;
  strncat(log_name,function,199-strlen(log_name));
  strncat(log_name,order,199-strlen(log_name));
  strncat(log_name,testCaseTitle,199-strlen(log_name));
  strncat(log_name,timeBuffer,199-strlen(log_name));
  strncat(log_name,".asc",199-strlen(log_name));
  setLogFileName(log_name);
  for(i = 9; log_name[i] !='\0'; i++ )
    log_name[i] = '\0';
}

void _start_log()
{
  creat_log("//BT_Logging//");
  startLogging();
}

void _end_log()
{
  stopLogging();
}

//APP有效状态：1为进入APP无效，0为APP有效
void APP_Valid(int Valid)
{
  @AUTO::APP_Valid = Valid;
  MainTest_f();
}

/*-------------------------------------------------------预编程过程-------------------------------------------------------*/
void Pre_Programme_For_AppValidTest()
{
//  writeEx(-3,0,"开始预编程阶段");
  /*----------------------BYD预编程阶段-------------------------------*/
  if(@AUTO::Config_Switch==1)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //安全访问
    Security_access();
    //31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //10 02
    enterProg(phyID,0,Resp_1002);
    
  }
  /*----------------------ChangAn预编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==2)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //27 01 & 27 02
    Security_access();
    //31 01 02 03
    UpdateCheck(phyID,Resp_0203); 
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*----------------------Geely 1.0预编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==3)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*----------------------Geely 3.0预编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==4)
  {
    enterExtend(phyID,0,Resp_1003);
    //10 02 / 10 82
    enterProg(phyID,0,-1);
  }
  /*-----------------------------鑫源 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==5)
  {
    //10 83
    enterExtend(phyID,0,-1);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*-----------------------------瑞驰 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==6)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    testWaitForTimeout(100);
    //31 01 F0 02
    UpdateCheck(phyID,Resp_0203);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*-----------------------------奇瑞 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==7)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*-----------------------------奇瑞T1V 5.0预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==11) 
  {
    //10 83
    enterExtend(phyID,0,Resp_1003);
    //31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*-----------------------------五菱 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==8)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*-----------------------------东风小康 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==9)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //安全访问 APP有效时27 01 无效时27 09
    if(curAppValid==1)
      SeedLevel=0x01;
    else
      SeedLevel=0x09;
    Security_access();
    //更新条件查询 31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*-----------------------------赛力斯 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==10)
  {
    //10 83
    enterExtend(phyID,1,Resp_1003);
    testWaitForTimeout(200);
    //更新条件查询 31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
  /*-----------------------------广汽 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==12)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    testWaitForTimeout(200);
    //更新条件查询 31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //10 02
    enterProg(phyID,0,Resp_1002);
  }
//  writeEx(-3,0,"预编程完成");
}
/// <DownLoad>
/*-------------------------------------------------------预编程过程-------------------------------------------------------*/
void Pre_Programme()
{
  writeEx(-3,0,"开始预编程阶段");
  if(SOS_Flage == 1)
  {
    diagRequest ABS_ESP.ExtendedDiagnosticSession_Start req1003;
    @sysvar::Prog_power::K30 = 0;
    testWaitForTimeout(2000);
    @sysvar::Prog_power::K30 = 1;
    do{
      _diagSendMsg(phyID,req1003);
      testWaitForDiagRequestSent(req1003,50);
      testWaitForDiagResponse(req1003,50);
    }while(diagGetLastResponseCode(req1003) == 0);
  }
  /*----------------------BYD预编程阶段-------------------------------*/
  if(@AUTO::Config_Switch==1)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //10 83
    enterExtend(funID,1,Resp_1003);
    diagStartTesterPresent("ABS_ESP_Functional");
    //85 82
    DTC_Control(funID,1,0x02,Resp_85);
    //28 81 01
    Com_Control(funID,1,0x01,0x01,Resp_28);
  }
  /*----------------------ChangAn预编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==2)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //10 83
    enterExtend(funID,1,Resp_1003);
    //27 01 & 27 02
    Security_access();
    diagStartTesterPresent("ABS_ESP_Functional");
    //22 F1 8A
    ReadIdentify(phyID,0xF18A,Resp_22);
    //22 F0 89
    ReadIdentify(phyID,0xF089,Resp_22);
    //22 F1 89
    ReadIdentify(phyID,0xF189,Resp_22);
    //31 01 02 03
    UpdateCheck(phyID,Resp_0203); 
    //85 82
    DTC_Control(funID,1,0x02,Resp_85);
    //28 83 03
    Com_Control(funID,1,0x03,0x03,Resp_28);
  }
  /*----------------------Geely 1.0预编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==3)
  {
    //故障注入：缺失整个预编程步骤
    if(@Faultinsert::TC_Miss_Pre==1)
    {
      Resp_1002 = 0x7E;
      Exit_1002 = 1;
    }
    else
    {
      //22 F1 93
      ReadIdentify(phyID,0xF193,Resp_22);
      //22 F1 80
      ReadIdentify(phyID,0xF180,Resp_22);
      //22 F1 87
      ReadIdentify(phyID,0xF187,Resp_22);
      //10 03
      enterExtend(funID,0,Resp_1003);
      diagStartTesterPresent("ABS_ESP_Functional");
      //85 02
      DTC_Control(funID,0,0x02,Resp_85);
      testWaitForTimeout(10);
      //28 03 01
      Com_Control(funID,0,0x03,0x01,Resp_28);
      testWaitForTimeout(10);
    }
  }
  /*----------------------Geely 3.0预编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==4)
  {
    //故障注入：电压异常测试---此部分测试更改位置到重编程部分，该部分暂时屏蔽
//    if(@Faultinsert::TC_ErrorVolt!=0)
//    {
//      Resp_1002 = 0x22;
//      Exit_1002 = 1;
//    }
    //10 02 / 10 82
    enterProg(phyID,0,Resp_1002);
    testWaitForTimeout(1000);
    
    curAppValid = Check_AppValid();
    
    testWaitForTimeout(1000);
    diagStartTesterPresent("ABS_ESP_Functional");
    if(Exit_1002==1)
    {
      Exit_Pre_Prog = 1;
      return;
    }
    //22 F1 86
    ReadIdentify(phyID,0xF186,Resp_22);
    //27 01 & 27 02通过安全访问
    Security_access_AES_CMAC();
    if(Exit_27==1)
    {
      Exit_Pre_Prog = 1;
      return;
    }
  }
  /*-----------------------------鑫源 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==5)
  {
    //故障注入：缺失整个预编程步骤
    if(@Faultinsert::TC_Miss_Pre==1)
    {
      Resp_1002 = 0x7E;
      Exit_1002 = 1;
    }
    else
    {
      //10 83
      enterExtend(funID,1,Resp_1003);
      diagStartTesterPresent("ABS_ESP_Functional");    
      //85 82
      DTC_Control(funID,1,0x02,Resp_85);
      //28 83 01
      Com_Control(funID,1,0x03,0x01,Resp_28);
      //22 F1 80
      ReadIdentify(phyID,0xF180,Resp_22);
    }
  }
  /*-----------------------------瑞驰 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==6)
  {
    //故障注入：缺失整个预编程步骤
    if(@Faultinsert::TC_Miss_Pre==1)
    {
      Resp_1002 = 0x7E;
      Exit_1002 = 1;
    }
    else
    {
      //10 03
      enterExtend(funID,0,Resp_1003);
      testWaitForTimeout(100);
      diagStartTesterPresent("ABS_ESP_Functional");
      //31 01 F0 02
      UpdateCheck(phyID,Resp_0203);
      //85 02
      DTC_Control(funID,0,0x02,Resp_85);
      testWaitForTimeout(1000);
      //28 03 01
      Com_Control(funID,0,0x03,0x01,Resp_28);
      testWaitForTimeout(1000);
      //22 F1 80
      ReadIdentify(phyID,0xF180,Resp_22);
    }
  }
  /*-----------------------------奇瑞 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==7)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    diagStartTesterPresent("ABS_ESP_Functional");
    //85 02 
    DTC_Control(funID,0,0x02,Resp_85);
    //28 03 03
    Com_Control(funID,0,0x03,0x03,Resp_28);
    //进入10 02后 需要在25ms内响应首帧
    p2cmax = 25;
  }
  /*-----------------------------奇瑞T1V 5.0预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==11) 
  {
    //10 83
    enterExtend(funID,1,Resp_1003);
    diagStartTesterPresent("ABS_ESP_Functional");
    
    //故障注入：缺失整个预编程步骤
    if(@Faultinsert::TC_Miss_Pre==1)
    {
      return;
    }
    //31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //85 82 
    DTC_Control(funID,1,0x02,Resp_85);
    //28 83 03
    Com_Control(funID,1,0x03,0x03,Resp_28);
  }
  /*-----------------------------五菱 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==8)
  {
    //故障注入：缺失整个预编程步骤
    if(@Faultinsert::TC_Miss_Pre==1)
    {
      return;
    }
//    //故障注入：电压异常测试  ---此部分更改位置到重编程部分故暂屏蔽
//    if(@Faultinsert::TC_ErrorVolt!=0)
//    {
//      Resp_22 = 0x31;
//    }
//    //22 F1 84
    if(@sysvar::AUTO::Config_SGMW_F184 == 1)
      ReadIdentify(phyID,0xF184,Resp_22);
    //22 F1 86
    if(@sysvar::AUTO::Config_SGMW_F186 == 1)
      ReadIdentify(phyID,0xF186,Resp_22);
//    //22 F1 8A
    if(@sysvar::AUTO::Config_SGMW_F18A == 1)
      ReadIdentify(phyID,0xF18A,Resp_22);
//    //22 F1 8B
    if(@sysvar::AUTO::Config_SGMW_F18B == 1)
      ReadIdentify(phyID,0xF18B,Resp_22);
//    //22 F1 8C
    if(@sysvar::AUTO::Config_SGMW_F18C == 1)
      ReadIdentify(phyID,0xF18C,Resp_22);
     //22 F1 7A
    if(@sysvar::AUTO::Config_SGMW_F17A == 1)
      ReadIdentify(phyID,0xF17A,Resp_22);
    //22 F1 90
    if(@sysvar::AUTO::Config_SGMW_F190 == 1)
      ReadIdentify(phyID,0xF190,Resp_22);
//    //22 F1 92
    if(@sysvar::AUTO::Config_SGMW_F192 == 1)
      ReadIdentify(phyID,0xF192,Resp_22);
//    //22 F1 93
    if(@sysvar::AUTO::Config_SGMW_F193 == 1)
      ReadIdentify(phyID,0xF193,Resp_22);
    //22 F1 94
    if(@sysvar::AUTO::Config_SGMW_F194 == 1)
      ReadIdentify(phyID,0xF194,Resp_22);
//    //22 F1 95
    if(@sysvar::AUTO::Config_SGMW_F195 == 1)
      ReadIdentify(phyID,0xF195,Resp_22);
//    //22 F1 B2
    if(@sysvar::AUTO::Config_SGMW_F1B2 == 1)
      ReadIdentify(phyID,0xF1B2,Resp_22);
//    //22 F1 B9
    if(@sysvar::AUTO::Config_SGMW_F1B9 == 1)
      ReadIdentify(phyID,0xF1B9,Resp_22);
    //22 F1 CB
    if(@sysvar::AUTO::Config_SGMW_F1CB == 1)
      ReadIdentify(phyID,0xF1CB,Resp_22);
//    //22 F1 91
    if(@sysvar::AUTO::Config_SGMW_F191 == 1)
      ReadIdentify(phyID,0xF191,Resp_22);
//    //22 F1 88
    if(@sysvar::AUTO::Config_SGMW_F188 == 1)
      ReadIdentify(phyID,0xF188,Resp_22);
    //22 F1 C1
    if(@sysvar::AUTO::Config_SGMW_F1C1 == 1)
      ReadIdentify(phyID,0xF1C1,Resp_22);
    //10 03
    enterExtend(funID,0,Resp_1003);
    diagStartTesterPresent("ABS_ESP_Functional");
    //85 02
    DTC_Control(funID,0,0x02,Resp_85);
    //28 03 03
    Com_Control(funID,0,0x03,0x03,Resp_28);
  }
  /*-----------------------------东风小康 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==9)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);

    //22 F1 89
    ReadIdentify(phyID,0xF189,Resp_22);
    //22 F1 87
    ReadIdentify(phyID,0xF187,Resp_22);
    //10 83
    enterExtend(funID,1,Resp_1003);
    //安全访问 APP有效时27 01 无效时27 09
    if(curAppValid==1)
      SeedLevel=0x01;
    else
      SeedLevel=0x09;
    Security_access();
    diagStartTesterPresent("ABS_ESP_Functional");
    //更新条件查询 31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //85 82
    DTC_Control(funID,1,0x02,Resp_85);
    //28 83 01
    Com_Control(funID,1,0x03,0x01,Resp_28);
    //28 83 03
    Com_Control(funID,1,0x03,0x03,Resp_28);
  }
  /*-----------------------------赛力斯 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==10)
  {
    //故障注入：缺失整个预编程步骤
    if(@Faultinsert::TC_Miss_Pre==1)
    {
      Resp_1002 = 0x22;
      Exit_1002 = 1;
      return;
    }
    //10 01
    enterDefault(phyID,0,Resp_1001);
    //22 F1 87
    ReadIdentify(phyID,0xF187,Resp_22);
    //10 83
    enterExtend(funID,1,Resp_1003);
    testWaitForTimeout(1000);
    //更新条件查询 31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //85 82
    DTC_Control(funID,1,0x02,Resp_85);
    testWaitForTimeout(1000);
    //28 83 03
    Com_Control(funID,1,0x03,0x03,Resp_28);
    testWaitForTimeout(1000);
  }
  /*-----------------------------广汽 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==12)
  {
    //22 F1 87
//    ReadIdentify(phyID,0xF187,Resp_22);
    //10 03
    enterExtend(funID,0,Resp_1003);
    testWaitForTimeout(1000);
    //故障注入：缺失整个预编程步骤
    if(@Faultinsert::TC_Miss_Pre==1)
    {
      Resp_1002 = 0x22;
      Exit_1002 = 1;
      return;
    }
    //更新条件查询 31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //85 02
    DTC_Control(funID,0,0x02,Resp_85);
    testWaitForTimeout(1000);
    //28 03 03
    Com_Control(funID,1,0x03,0x03,Resp_28);
    testWaitForTimeout(1000);
  }
  /*-----------------------------V8 预编程阶段----------------------------*/
  else if(@AUTO::Config_Switch==13)
  {
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //更新条件查询 31 01 02 03
    UpdateCheck(phyID,Resp_0203);
    //10 83
    enterExtend(funID,1,Resp_1003);
    
    diagStartTesterPresent("ABS_ESP_Functional");
    //85 82
    DTC_Control(funID,1,0x02,Resp_85);
    //28 83 03
    Com_Control(funID,1,0x03,0x03,Resp_28);
  }
  writeEx(-3,0,"预编程完成");
}
/// <DownLoad>
/*-------------------------------------------------------重编程过程-------------------------------------------------------*/
void Re_Programme()
{ 
  writeEx(-3,0,"开始重编程阶段");
  Down_f_a = 0;
  /*----------------------BYD重编程阶段-------------------------------*/
  if(@AUTO::Config_Switch==1)
  {
    if(SOS_Flage == 1)
    {
      SOS_Flage = 0;
      //安全访问
      Security_access();
      //10 02
      enterProg(phyID,0,Resp_1002);
      SOS_Flage = 1;
      Security_access();
    }
    else
    {
      Security_access();
      //10 02
      enterProg(phyID,0,Resp_1002);
    }
    if(Exit_1002==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //第二次安全访问
    if(Resp_2702_2 != Resp_2702)//第二次过安全访问的预期结果
      Resp_2702 = Resp_2702_2;
    //故障注入：进入编程会话后 不执行27 01/27 02安全访问
    if(@Faultinsert::TC_Miss_27_2==1)
    {
      Resp_34_f = 0x33;
      Exit_34_f = 1;
    }
    else
      Security_access();
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    //驱动下载31 01 02 02
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*----------------------ChangAn重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==2)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    //27 安全访问
    if(Resp_2702_2 != Resp_2702)//第二次过安全访问的预期结果
      Resp_2702 = Resp_2702_2;
    //故障注入：进入编程会话后 不执行27 01/27 02安全访问
    if(@Faultinsert::TC_Miss_27_2==1)
    {
      Resp_2E = 0x33;
      Exit_2E = 1;
    }
    else
      Security_access();
    //22 F1 70
    ReadIdentify(phyID,0xF170,Resp_22);
    //22 F1 71
    ReadIdentify(phyID,0xF171,Resp_22);
    //2E F1 84
    WriteIdentify(phyID,0xF184,Resp_2E);
    if(Exit_2E==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载31 01 02 02
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*------------------------------Geely 1.0重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==3)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    testWaitForTimeout(1000);
    if(Exit_1002==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //27 11 & 27 12安全访问
    if(@Faultinsert::TC_Miss_27_1==1)
    {
      Resp_2E = 0x33;
      Exit_2E = 1;
    }
    else
      Security_access();
    if(Exit_27==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    testWaitForTimeout(500);
    //2E F1 98
    WriteIdentify(phyID,0xF198,Resp_2E);
    //2E F1 99
    WriteIdentify(phyID,0xF199,Resp_2E);
    if(Exit_2E==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    //驱动下载31 01 02 02
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*----------------------------Geely 3.0重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==4)
  {
    dword VbtFlage;
    for(VbtFlage=0;VbtFlage<=1;VbtFlage++)
    {
      if(@Faultinsert::TC_Miss_34_F==1 && @Faultinsert::TC_Miss_36_F && @Faultinsert::TC_Miss_37_F)
      {
        PassState_31[0] = 0x10;
        PassState_31[1] = 0x06;
        Exit_0202_f = 1;
        break;
      }
    
      Set_Battery_DownLoad();
      //SBT 34请求下载
      SBT_34(VbtFlage);
      if(Exit_34_f==1)
      {
        Exit_Re_Prog = 1;
        return;
      }
      //SBT 36数据传输
      SBT_36(VbtFlage);
      if(Exit_36_f==1)
      {
        Exit_Re_Prog = 1;
        return;
      }
      //故障注入：步骤缺失Flash 37请求
      if(@Faultinsert::TC_Miss_37_F==1)
      {
        if(VbtFlage == 1)
        {
          Resp_34_a = 0x70;
          Resp_36_a = 0x31;
          Exit_34_a = 1;
          PassState_31[1] = 0x06;
          Resp_0301 = 0x22;
          Resp_ff00 = 0x31;
          
          break;
        }
      }
      //SBT 37退出传输
      SBT_37(VbtFlage);
      if(Exit_37_f==1)
      {
        Exit_Re_Prog = 1;
        return;
      }
    }
    //故障注入：下载完SBT后 直接请求完整性兼容校验
    if(@Faultinsert::TC_SBT37_0205==1)
    {
      _Send0205(phyID,Resp_0205);
      Exit_Re_Prog = 1;
      return;
    }
    //故障注入：下载完SBT后 增加请求完整性兼容校验
    if(@Faultinsert::TC_SBT37_0205==2)
    {
      _Send0205(phyID,Resp_0205);
      testWaitForTimeout(200);
    }
    //SBT 31 01 02 12签名校验
    _Send0212_F(phyID,0,Resp_0202_f);
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //故障注入：SBT 0212后新增22读取服务
    if(@Faultinsert::TC_ReadAfter_0202F==1)
    {
      if(@AUTO::ReadIdentify == 0xF1A2)
        Resp_22 = 0x31;
      ReadIdentify(phyID,@AUTO::ReadIdentify,Resp_22);
    }
    //激活SBT 31 01 03 01
    _Send0301(phyID,Resp_0301);
    if(Exit_0301==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*--------------------------------鑫源 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==5)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    if(Exit_1002==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //27 11 & 27 12安全访问
    Security_access();
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载数据校验31 01 02 01
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //2E F1 98
    WriteIdentify(phyID,0xF198,Resp_2E);
    if(Exit_2E==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //2E F1 99
    WriteIdentify(phyID,0xF199,Resp_2E);
  }
  /*--------------------------------瑞驰 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==6)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    if(Exit_1002==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //故障注入：步骤缺失 安全访问
    if(@Faultinsert::TC_Miss_27_1==1)
    {
      Resp_34_f = 0x33;
      Exit_34_f = 1;
    }
    //安全访问
    else
    {
      if(@AUTO::Security_Switch == 2)
        Security_access_AES_CMAC();
      else
        Security_access();
    }    
      
    if(Exit_27==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载数据校验31 01 F0 01
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*--------------------------------奇瑞 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==7)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    p2cmax = 50;
    //安全访问27 03 & 27 04
    /*故障注入：步骤缺失 安全访问*/
    if(@Faultinsert::TC_Miss_27_1==1)
    {
      Resp_34_f = 0x33;
      Exit_34_f = 1;
    }
    else
    {
      Security_access();
    }
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*--------------------------------奇瑞T1V 5.0 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==11) 
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    testWaitForTimeout(1000);
    /*故障注入：步骤缺失 安全访问*/
    if(@Faultinsert::TC_Miss_27_1==1)
    {
      Resp_34_f = 0x33;
      Exit_34_f = 1;
    }
    else
      Security_access_AES_CMAC();
    
    //22 F0 F0
//    ReadIdentify(phyID,0xF0F0,Resp_22);
    //2E F1 84
    WriteIdentify(phyID,0xF184,Resp_2E);
    
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载数据校验31 01 DD 02
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*--------------------------------五菱 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==8)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    //故障注入：步骤缺失 安全访问
    if(@Faultinsert::TC_Miss_27_1==1)
    {
      Resp_34_f = 0x33;
      Exit_34_f = 1;
    }
    else
    {
      //安全访问 27 05 & 27 06
      Security_access();
    }
    testWaitForTimeout(100);
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载数据校验31 01 DF FF
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*--------------------------------东风小康 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==9)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    //安全访问 进入BT后 安全访问等级变为27 09
    SeedLevel = 0x09;
    Security_access();
//    _Send2705B18E();
    //2E F1 84
    WriteIdentify(phyID,0xF184,Resp_2E);
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载数据校验31 01 02 02
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*--------------------------------赛力斯 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==10)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //故障注入：步骤缺失 安全访问
    if(@Faultinsert::TC_Miss_27_1==1)
    {
      Resp_2E = 0x33;
      Exit_2E = 1;
    }
    else
    {
      //安全访问 27 09 & 27 0A
      Security_access();
      if(Exit_27==1)
      {
        Exit_Re_Prog = 1;
        return;
      }
    }
    //2E F1 84
    WriteIdentify(phyID,0xF184,Resp_2E);
    
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载数据校验31 01 DD 02
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  /*--------------------------------广汽 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==12)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    testWaitForTimeout(600);
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //故障注入：步骤缺失 安全访问
    if(@Faultinsert::TC_Miss_27_1==1)
    {
      Resp_2E = 0x33;
      Exit_2E = 1;
    }
    else
    {
      //安全访问 27 11 & 27 12
      Security_access();
      if(Exit_27==1)
      {
        Exit_Re_Prog = 1;
        return;
      }
    }
    //2E F1 84
    WriteIdentify(phyID,0xF184,Resp_2E);
    if(@Test::Loop_Test_Switch)
    {
      //22 02 01
      Change_CompilePro = ReadIdentify_GetData(phyID,0x0201);
    }
    Set_Battery_DownLoad();
    /*由于存在多个Logical blocks时需要重新进行Flash刷写,故Flash放到下载部分*/  
  }
  /*--------------------------------V8 重编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==13)
  {
    //10 02
    enterProg(phyID,0,Resp_1002);
    //安全访问 
    Security_access();
    //2E F1 84
    WriteIdentify(phyID,0xF184,Resp_2E);
    Set_Battery_DownLoad();
    //驱动下载34
    FlashDriver_34();
    if(Exit_34_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载36
    FlashDriver_36();
    if(Exit_36_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载37
    FlashDriver_37();
    if(Exit_37_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
    //驱动下载数据校验31 01 02 02
    FlashDriver_0202();
    if(Exit_0202_f==1)
    {
      Exit_Re_Prog = 1;
      return;
    }
  }
  writeEx(-3,0,"重编程完成");
}
/// <DownLoad>
/*-------------------------------------------------------后编程过程-------------------------------------------------------*/
void Post_Programme()
{
  writeEx(-3,0,"开始后编程阶段");
  /*----------------------BYD后编程阶段-------------------------------*/
  if(@AUTO::Config_Switch==1)
  {
    //软硬件一致性检查 31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    if(Exit_ff01==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //ECU复位 11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //恢复报文发送 28 80 01
    Com_Control(funID,1,0x00,0x01,Resp_28);
    //打开DTC设置 85 81
    DTC_Control(funID,1,0x01,Resp_85);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*----------------------ChangAn后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==2)
  {
    //软硬件一致性检查 31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    //ECU复位11 03
    _Startreset(phyID,0x03,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //扩展会话模式10 03
    enterExtend(phyID,0,Resp_1003);
    //恢复报文发送28 80 03
    Com_Control(funID,1,0x00,0x03,Resp_28);
    //打开DTC设置 85 81
    DTC_Control(funID,1,0x01,Resp_85);
    //默认会话模式10 81
    enterDefault(funID,1,Resp_1001);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*----------------------Geely 1.0后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==3)
  {
    //软硬件一致性检查 31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    if(Exit_ff01==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //ECU复位11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //扩展会话模式10 03
    enterExtend(funID,0,Resp_1003);
    //恢复报文发送 28 00 01
    Com_Control(funID,0,0x00,0x01,Resp_28);
    //打开DTC设置 85 01
    DTC_Control(funID,0,0x01,Resp_85);
    //默认会话模式10 01
    enterDefault(funID,0,Resp_1001);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*----------------------Geely 3.0后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==4)
  {
    //31 01 02 05
    _Send0205(phyID,Resp_0205);
    //ECU复位 11 01
    _Startreset(phyID,0x01,Resp_11);
  }
  /*---------------------------鑫源 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==5)
  {
    //依赖性检测31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    if(Exit_ff01==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //ECU复位11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //扩展会话模式10 83
    enterExtend(funID,1,Resp_1003);
    //恢复报文发送28 80 01
    Com_Control(funID,1,0x00,0x01,Resp_28);
    //打开DTC设置85 81
    DTC_Control(funID,1,0x01,Resp_85);
    //默认会话模式10 81
    enterDefault(funID,1,Resp_1001);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*---------------------------瑞驰 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==6)
  {
    if(PostProg_Recover == 1)
    {
      if(@Faultinsert::TC_Pro_0203==1) //故障恢复：更新条件检测后进入编程会话
      {
        Resp_85 = -1;
        Resp_28 = -1;
      }
    }
    //依赖性检测31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    if(Exit_ff01==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //ECU复位11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //扩展会话模式10 03
    enterExtend(phyID,0,Resp_1003);
    testWaitForTimeout(500);
    //恢复报文发送28 00 03
    Com_Control(funID,0,0x00,0x03,Resp_28);
    //打开DTC设置85 81
    DTC_Control(funID,1,0x01,Resp_85);
    //默认会话模式10 01
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(500);
    //清楚故障码 14 FF FF FF
    ClearDTC(phyID,Resp_14);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*---------------------------奇瑞 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==7)
  {
    word p2cmax_temp;
    p2cmax_temp = p2cmax;
    p2cmax = 100;
    //软件有效性检测31 01 DA 04
    _SendDA04(phyID,Resp_DA04);
    p2cmax = p2cmax_temp;
    if(Exit_DA04==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //31 03 DA 04
    _Send03DA04(phyID,Resp_DA04);
    if(Exit_03DA04==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //31 02 DA 04
    _Send02DA04(phyID,Resp_DA04);
    if(Exit_02DA04==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    p2cmax = 50;
    //10 03
    enterExtend(funID,0,Resp_1003);
    //28 00 03
    Com_Control(funID,0,0x00,0x03,Resp_28);
    //85 01
    DTC_Control(funID,0,0x01,Resp_85);
    //14 FF FF FF
    ClearDTC(funID,Resp_14);
    if(Exit_14==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //10 01
    enterDefault(funID,0,Resp_1001);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*---------------------------奇瑞T1V 5.0  后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==11)
  {
    word p2cmax_temp;
    p2cmax_temp = p2cmax;
    p2cmax = 100;
    
    //28 80 03
    Com_Control(funID,1,0x00,0x03,Resp_28);
    //11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //22 F0 F2
//    ReadIdentify(phyID,0xF0F2,Resp_22);
    
    p2cmax = 50;
    //10 03
    enterExtend(phyID,0,Resp_1003);
    //14 FF FF FF
    ClearDTC(phyID,Resp_14);
    if(Exit_14==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //85 81
    DTC_Control(funID,1,0x01,Resp_85);
    //10 81
    enterDefault(funID,1,Resp_1001);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*---------------------------五菱 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==8)
  {
    //软件有效性检测31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    if(Exit_ff01==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //ECU复位 11 01
    _Startreset(funID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //清除故障 14 FF FF FF
    ClearDTC(funID,Resp_14);
    //10 03
    enterExtend(phyID,0,Resp_1003);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*---------------------------东风小康 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==9)
  {
    //软件有效性检测31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
//    diagStartTesterPresent("ABS_ESP_Functional");
    //28 80 01
    Com_Control(funID,1,0x00,0x01,Resp_28);
    //28 80 03
    Com_Control(funID,1,0x00,0x03,Resp_28);
    testWaitForTimeout(1000);
    //ECU复位 11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //清除故障 14 FF FF FF
    ClearDTC(phyID,Resp_14);
     //85 81
    DTC_Control(funID,1,0x01,Resp_85);
    //10 81
    enterDefault(funID,1,Resp_1001);
    diagStopTesterPresent("ABS_ESP_Functional");
  }
  /*---------------------------赛力斯 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==10)
  {
    //安全签名检查31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    //28 80 03
    Com_Control(funID,1,0x00,0x03,Resp_28);
    //ECU复位 11 01
    _Startreset(funID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //清除故障 14 FF FF FF
    ClearDTC(phyID,Resp_14);
    //85 81
    DTC_Control(funID,1,0x01,Resp_85);
    //10 81
    enterDefault(funID,1,Resp_1001);
    //22 F1 87
    ReadIdentify(phyID,0xF187,Resp_22);
  }
  /*---------------------------广汽 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==12)
  {
    //安全签名检查31 01 FF 01
    _SendFF01(phyID,Resp_ff01);
    
    if(@Test::Loop_Test_Switch)
    {
      //22 02 00
      Change_ReadPro = ReadIdentify_GetData(phyID,0x0200);
    }
    //2E F1 99
    WriteIdentify(phyID,0xF199,Resp_2E);
    //ECU复位 11 01
    _Startreset(funID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
  }
  /*---------------------------V8 后编程阶段-------------------------------*/
  else if(@AUTO::Config_Switch==13)
  {
    //ECU复位 11 01
    _Startreset(phyID,0x01,Resp_11);
    if(Exit_11==1)
    {
      Exit_Post_Prog = 1;
      return;
    }
    //10 81
    enterDefault(funID,1,Resp_1001);
    //清除故障 14 FF FF FF
    ClearDTC(funID,Resp_14);
  }
  testWaitForTimeout(3000);
  writeEx(-3,0,"后编程完成");
}

//使用物理寻址或功能寻址发送请求
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数obj:诊断请求
void _diagSendMsg(dword msgID,diagRequest* obj)
{
  char comment[70];
  byte primitiveRaw[30];
  long size;
  byte i;
  
  size=DiagGetPrimitiveData(obj,primitiveRaw,elCount(primitiveRaw));
  
  if(msgID==phyID)
    snprintf(comment,elCount(comment),"已发送物理寻址请求:[%02X]",size);
  else
    snprintf(comment,elCount(comment),"已发送功能寻址请求:[%02X]",size);
  if(@Test::Loop_Test_Switch == 1 && primitiveRaw[0] == 0x36)
  {
    for(i=0;i<2;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,primitiveRaw[i]);
    }
  }
  else
  {
    for(i=0;i<size;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,primitiveRaw[i]);
    }
  }
  
  if(msgID==phyID)
    diagSendRequest(obj);
  else if(msgID==funID)
    diagSendFunctional(obj);
  testCaseComment(comment);
}

//默认会话模式
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Inhibitory_response:{1:抑制响应,0:非抑制响应}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void enterDefault(dword msgID,int Inhibitory_response,int Passcondition)
{
  diagRequest ABS_ESP.DefaultSession_Start req1001;
  word Temp_p2cmax;
  Temp_p2cmax = p2cmax;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试10服务默认会话",stepnum);
  if(Inhibitory_response == 1)
  {
    DiagSetPrimitiveByte(req1001,1,0x80|DiagGetPrimitiveByte(req1001,1));
    Passcondition = 0;
  }
  else if(Inhibitory_response == 0)
  {
    DiagSetPrimitiveByte(req1001,1,0x01);
    Passcondition = Resp_1001;
  }
  if(@AUTO::Config_Switch == 4)
  {
    p2cmax = 50;
  }
  _diagSendMsg(msgID,req1001);
//  testWaitForDiagRequestSent(req1001,200);
//  testWaitForDiagResponse(req1001,p2cmax);
//  _TestResult(req1001,stepid,Passcondition);
  _get_FC(req1001,msgID,stepid,Passcondition);
  
  p2cmax = Temp_p2cmax;
}

//编程会话模式
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Inhibitory_response:{1:抑制响应,0:非抑制响应}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void enterProg(dword msgID,int Inhibitory_response,int Passcondition)
{
  diagRequest ABS_ESP.ProgrammingSession_Start req1002;
  char comment[70];
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试10服务编程会话",stepnum);
  if(Inhibitory_response == 1)
  {
    DiagSetPrimitiveByte(req1002,1,0x80|DiagGetPrimitiveByte(req1002,1));
    if(Passcondition == -1)
      Passcondition = 0;
  }
//  //奇瑞 APP无效时 10 02响应的p2cmax值为 50ms
//  if(@AUTO::Config_Switch==7 && curAppValid==0)
//  {
//    p2cmax = 50;
//  }
  //故障注入：步骤缺失10 02进入编程会话
  if(@Faultinsert::TC_Miss_1002 == 1)
  {
    if(@AUTO::Config_Switch==2)//ChangAn
    {
      Resp_2702_2 = 0x24;
      Resp_2E = 0x31;
      Exit_2E = 1;
    }
    else if(@AUTO::Config_Switch==3)//Geely 1.0 
    {
      Resp_2701 = 0x7E;
      Resp_2702 = 0x7E;
      Exit_27 = 1;
    }
    else if(@AUTO::Config_Switch==10)//赛力斯
    {
      Resp_2701 = 0x12;
      Resp_2702 = 0x12;
      Exit_27 = 1;
    }
    else if(@AUTO::Config_Switch==4)//Geely 3.0
    {
//      Resp_22 = 0x31;
//      Exit_22 = 1;
      Resp_2702 = 0x7F;
      Exit_27 = 1;
    }
    
    return;
  }
  else
  {
    _diagSendMsg(msgID,req1002);
    testWaitForDiagRequestSent(req1002,200);
    _get_FC(req1002,phyID,stepid,Passcondition);
  }
//  //故障注入：电压异常测试  ---此部分更改位置到重编程部分故暂屏蔽
//  if(@Faultinsert::TC_ErrorHighVolt_App == 1)
//  {
//    if(@Prog_power::K30Volt > High_Volt)
//    {
//      HighVolt_Resp(curAppValid);
//    }
//  }
//  if(@Faultinsert::TC_ErrorLowVolt_App == 1)
//  {
//    if(@Prog_power::K30Volt < Low_Volt)
//    {
//      LowVolt_Resp(curAppValid);
//    }
//  }
}
//扩展会话模式
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Inhibitory_response:{1:抑制响应,0:非抑制响应}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void enterExtend(dword msgID,int Inhibitory_response,int Passcondition)
{
  diagRequest ABS_ESP.ExtendedDiagnosticSession_Start req1003;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试10服务扩展会话",stepnum);
  
  if(Inhibitory_response == 1)
  {
    DiagSetPrimitiveByte(req1003,1,0x80|DiagGetPrimitiveByte(req1003,1));
    if(Passcondition == -1)
      Passcondition = 0;
  }
  else if(Inhibitory_response == 0)
  {
    if(BT_1003 == 1 && curAppValid==0)
    {
      Passcondition = 0x12;
    }
    else
    {
      DiagSetPrimitiveByte(req1003,1,0x03);
      Passcondition = Resp_1003;
    }
  }
  //故障注入：步骤缺失10 03扩展会话
  if(@Faultinsert::TC_Miss_1003 == 1)
  {
    if(@AUTO::Config_Switch==3)//Geely1.0
    {
      Resp_85 = 0;
      Resp_28 = 0;
    }
    else if(@AUTO::Config_Switch==6 || @AUTO::Config_Switch==10)//瑞驰 || 赛力斯
    {
      Resp_85 = 0;
      Resp_28 = 0;
      Resp_0203 = 0x7F;
    }
    Resp_1002 = 0x7E;
    Exit_1002 = 1;
    return;
  }
  else
  {
    _diagSendMsg(msgID,req1003);
    _get_FC(req1003,msgID,stepid,Passcondition);
  }
  //故障注入：进入扩展会话后超过5S
  if(@Faultinsert::TC_Wait_1003==1)
  {
    Resp_1002 = 0x7E;
    Exit_1002 = 1;
    testWaitForTimeout(6000);
  }
}
//14清除故障码
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void ClearDTC(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.FaultMemory_Clear req14;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试14服务清除故障码",stepnum);
  
  diagResize(req14,4);
  DiagSetPrimitiveByte(req14,0,0x14);
  DiagSetPrimitiveByte(req14,1,0xFF);
  DiagSetPrimitiveByte(req14,2,0xFF);
  DiagSetPrimitiveByte(req14,3,0xFF);
  
  _diagSendMsg(msgID,req14);
  _get_FC(req14,msgID,stepid,Passcondition);
}
//22读取数据服务
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Identifier:数据标识符DID
//用于获取对应的返回值
dword ReadIdentify_GetData(dword msgID,word Identifier)
{
  diagRequest ABS_ESP.Primary_Bootloader_Software_Version_Number_Read req22;
  dword ResValue;
  int i,ResLen;
  DiagSetPrimitiveByte(req22,1,Identifier >> 8);
  DiagSetPrimitiveByte(req22,2,Identifier & 0xFF);
  
  _diagSendMsg(msgID,req22);
  testWaitForDiagRequestSent(req22,200);
  testReportWriteDiagObject(req22);
  diagSetP2Extended(-1);
  testWaitForDiagResponse(req22,p2cmax);
  do
  {
    if(diagGetLastResponseCode(req22)==0x78)
      testWaitForDiagResponse(req22,p2cmax*100);
  }while(diagGetLastResponseCode(req22)==0x78);
  testReportWriteDiagResponse(req22);
  if(diagGetLastResponseCode(req22) == -1)
  {
    ResValue = 0;
    ResLen = DiagGetRespPrimitiveSize(req22) - 3;
    for(i=0;i<ResLen;i++)
      ResValue = ResValue + (DiagGetRespPrimitiveByte(req22,i+3)<<((ResLen-1-i)*8));
  }
  return ResValue;
}

//22读取数据服务
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Identifier:数据标识符DID
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void ReadIdentify(dword msgID,word Identifier,int Passcondition)
{
  diagRequest ABS_ESP.Primary_Bootloader_Software_Version_Number_Read req22;
  byte result;
  result = 0;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试22服务读数据",stepnum);
  
  DiagSetPrimitiveByte(req22,1,Identifier >> 8);
  DiagSetPrimitiveByte(req22,2,Identifier & 0xFF);
  
  //故障注入:步骤缺失22读取数据服务
  if(@Faultinsert::TC_Miss_22==1)
  {
    return;
  }
  _diagSendMsg(msgID,req22);
  _get_FC(req22,msgID,stepid,Passcondition);
  testWaitForTimeout(1000);
  //故障注入：刷写过程中读取不支持的DID
  if(@Faultinsert::TC_Error_22_DID==1)
  {
    @Faultinsert::TC_Error_22_DID = 0;//Add 
    ReadIdentify(msgID,UnsupportDID,0x31);
  }
}
//2E写入数据服务
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Identifier:数据标识符DID
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void WriteIdentify(dword msgID,dword Identifier,int Passcondition)
{
  diagRequest ABS_ESP.Primary_Bootloader_Software_Version_Number_Write req2E;
  long DateTime[9],DateYear,DateMonth,DateDay,Byte_High,Byte_Low;
  char comment[30];
  byte i;
  i = 0;
  
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试2E服务写数据",stepnum);
  
  DiagSetPrimitiveByte(req2E,1,Identifier>>8);
  DiagSetPrimitiveByte(req2E,2,Identifier&0xFF);
  
  //2E F1 84
  if(Identifier == 0xF184)
  {
    getLocalTime(DateTime);
    DateYear = (DateTime[5]+1900-2000) & 0xFF;   //本地时间年
    DateMonth = DateTime[4]+1;                   //本地时间月
    DateDay = DateTime[3];                       //本地时间日
    if(@AUTO::Config_Switch==2)//ChangAn
    {
      diagResize(req2E,0x0A);
      DiagSetPrimitiveByte(req2E,3,DateYear);
      DiagSetPrimitiveByte(req2E,4,DateMonth);
      DiagSetPrimitiveByte(req2E,5,DateDay);
      //故障注入：2E F1 84写入无效的数据
      if(@Faultinsert::TC_ErrorData_2E==1)
      {
        DiagSetPrimitiveByte(req2E,3,0xFF);
        DiagSetPrimitiveByte(req2E,4,0x0D);
        DiagSetPrimitiveByte(req2E,5,0x1F);
        Passcondition = 0x31;
        Resp_34_f = 0x22;
        Exit_34_f = 1;
      }
    }
    else if(@AUTO::Config_Switch==9)//东风小康
    {
      diagResize(req2E,0x0D);
      DiagSetPrimitiveByte(req2E,4,DateYear);
      DiagSetPrimitiveByte(req2E,5,DateMonth);
      DiagSetPrimitiveByte(req2E,6,DateDay);
    }
    else if(@AUTO::Config_Switch==11)//奇瑞T1V
    {
      diagResize(req2E,0x16);
      DiagSetPrimitiveByte(req2E,3,DateYear);
      DiagSetPrimitiveByte(req2E,4,DateMonth);
      DiagSetPrimitiveByte(req2E,5,DateDay);
      for(i=6;i<0x16;i++)
        DiagSetPrimitiveByte(req2E,i,0x20);
    }
    else if(@AUTO::Config_Switch==12)//广汽
    {
      char Year[20],Month[20],Day[20];
      snprintf(Year,elCount(Year),"0x%d",DateYear);
      snprintf(Month,elCount(Month),"0x%d",DateMonth);
      snprintf(Day,elCount(Day),"0x%d",DateDay);
      diagResize(req2E,0x0D);
      DiagSetPrimitiveByte(req2E,4,atol(Year));
      DiagSetPrimitiveByte(req2E,5,atol(Month));
      DiagSetPrimitiveByte(req2E,6,atol(Day));
    }
    else if(@AUTO::Config_Switch==13)//V8
    {
      diagResize(req2E,0x0C);
      DiagSetPrimitiveByte(req2E,3,DateYear);
      DiagSetPrimitiveByte(req2E,4,DateMonth);
      DiagSetPrimitiveByte(req2E,5,DateDay);
    }
  }
  //2E F1 99
  else if(Identifier == 0xF199)
  {
    diagResize(req2E,0x07);
    getLocalTime(DateTime);
    DateYear = (DateTime[5]+1900);      //本地时间年
    DateMonth = DateTime[4]+1;          //本地时间月
    DateDay = DateTime[3];
    Byte_High = ((DateYear/1000)<<4) | ((DateYear/100)%10);
    Byte_Low = (((DateYear/10)%10)<<4) | (DateYear%10);
    DateMonth = ((DateMonth/10)<<4) | (DateMonth % 10);
    DateDay = ((DateDay/10)<<4) | (DateDay % 10);
    DiagSetPrimitiveByte(req2E,3,Byte_High);
    DiagSetPrimitiveByte(req2E,4,Byte_Low);
    DiagSetPrimitiveByte(req2E,5,DateMonth);
    DiagSetPrimitiveByte(req2E,6,DateDay);
  }
  //2E F1 98
  else if(Identifier == 0xF198)
  {
    if(@AUTO::Config_Switch==3)//Geely 1.0
    {
      diagResize(req2E,0x13);
      for(i=3;i<0x13;i++)
        DiagSetPrimitiveByte(req2E,i,0x00);
    }
    else if(@AUTO::Config_Switch==5)//鑫源
    {
      diagResize(req2E,0x13);
      for(i=3;i<0x13;i++)
        DiagSetPrimitiveByte(req2E,i,0x00);
    }
  }
  
  //故障注入：步骤缺失2E写数据
  if(@Faultinsert::TC_Miss_2E==1)
  {
    if(@AUTO::Config_Switch==5)//鑫源
    {
//      PassState_31[0] = 0x04;
      Resp_ff00 = 0x22;
      Exit_ff00 = 1;
    }
    //ChangAn || 东风小康 || 赛力斯
    else if(@AUTO::Config_Switch==2 || @AUTO::Config_Switch==9 || @AUTO::Config_Switch==10)
    {
      Resp_34_f = 0x22;
      Exit_34_f = 1;
    }
    return;
  }
  //故障注入：2E写数据中功能寻址握手
  else if(@Faultinsert::TC_Handshake_in_2E==1)
  {
    _diagSendMsg(msgID,req2E);
    if(Identifier == 0xF199)
      testWaitForDiagRequestSent(req2E,10);
    else
      testWaitForMessage(msgID,1000);
    _handshake(funID);
    _get_FC(req2E,phyID,stepid,Passcondition);
  }
  else if(@Faultinsert::TC_Restart_after_2E == 1)
  {
    if(@AUTO::Config_Switch == 12)
    {
      _diagSendMsg(msgID,req2E);
      _get_FC(req2E,phyID,stepid,Passcondition);
      _Startreset(phyID,0x01,Resp_11);
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
  }
  else if(@Faultinsert::TC_DefaultSession_after_2E == 1)
  {
    if(@AUTO::Config_Switch == 12)
    {
      _diagSendMsg(msgID,req2E);
      _get_FC(req2E,phyID,stepid,Passcondition);
      enterDefault(funID,0,Resp_1001);
      testWaitForTimeout(Restart_Time);
      Resp_ff00 = 0x7F;
      Exit_ff00 = 1;
    }
  }
  else
  {
    _diagSendMsg(msgID,req2E);
    _get_FC(req2E,phyID,stepid,Passcondition);
  }
}
//更新条件查询31 01 02 03
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void UpdateCheck(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0203;
  if(SOS_Flage == 1)
    return;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试31服务更新条件查询",stepnum);

  //瑞驰
  if(@AUTO::Config_Switch==6)
  {
    diagResize(req0203,0x04);
    DiagSetPrimitiveByte(req0203,0,0x31);
    DiagSetPrimitiveByte(req0203,1,0x01);
    DiagSetPrimitiveByte(req0203,2,0xF0);
    DiagSetPrimitiveByte(req0203,3,0x02);
  }
  else
  {
    diagResize(req0203,0x04);
    DiagSetPrimitiveByte(req0203,0,0x31);
    DiagSetPrimitiveByte(req0203,1,0x01);
    DiagSetPrimitiveByte(req0203,2,0x02);
    DiagSetPrimitiveByte(req0203,3,0x03);
  }
  //故障注入：缺失步骤更新条件查询
  if(@Faultinsert::TC_Miss_0203==1)
  {
    Resp_1002 = 0x22;
    Exit_1002 = 1;
    return;
  }
  else
  {
    _diagSendMsg(msgID,req0203);
    testWaitForDiagRequestSent(req0203,1000);
    testWaitForDiagResponse(req0203,p2cmax);
    _TestResult(req0203,stepid,Passcondition);
//    _get_FC(req0203,msgID,stepid,Passcondition);
  }
  //故障注入：更新条件检测后进入编程会话
  if(@Faultinsert::TC_Pro_0203==1)
  {
    enterProg(phyID,0,-1);
    testWaitForTimeout(500);
    Resp_85 = 0;
    Resp_28 = 0;
    PostProg_Recover = 1;
  }
  //故障注入：更新条件检测后ECU 11复位
  if(@Faultinsert::TC_Restart_after_0203==1)
  {
    _Startreset(phyID,0x01,-1);
    testWaitForTimeout(Restart_Time);
    Resp_85 = 0;
    Resp_28 = 0;
    Resp_1002 = 0x7E;
    Exit_1002 = 1;
  }
  //故障注入：进入扩展会话后超过5S
  if(@Faultinsert::TC_Wait_0203==1)
  {
    diagStopTesterPresent("ABS_ESP_Functional");
    Resp_1002 = 0x7E;
    Resp_85 = 0;
    Resp_28 = 0;
    Exit_1002 = 1;
    testWaitForTimeout(6000);
  }
}
//控制DTC设置
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Inhibitory_response:{1:抑制响应,0:非抑制响应}
//参数DTC_Setting:{0x01:使能故障码设置,0x02:禁止故障码设置}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void DTC_Control(dword msgID,int Inhibitory_response,dword DTC_Setting,int Passcondition)
{
  diagRequest ABS_ESP.DTC_Setting_Mode_On_Send req85;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试85服务控制DTC设置",stepnum);
  
  DiagSetPrimitiveByte(req85,1,DTC_Setting);
  if(Inhibitory_response == 1)
  {
    DiagSetPrimitiveByte(req85,1,0x80|DiagGetPrimitiveByte(req85,1));
    Passcondition = 0;
  } 
  //APP无效时 不支持 85
  else if(BT_85==1 && curAppValid==0)
    Passcondition = 0x12;
  else
    Passcondition = Resp_85;
  
  if(msgID==funID && (Passcondition==0x12 || Passcondition==0x13))
  {
    Passcondition = 0;
  }
  else if((@AUTO::Config_Switch == 7 ||@AUTO::Config_Switch == 8) && msgID==funID)
    Passcondition = -1;
    
   _diagSendMsg(msgID,req85);
  _get_FC(req85,msgID,stepid,Passcondition);
}
//通讯控制设置
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Inhibitory_response:{1:抑制响应,0:非抑制响应}
//参数Com_Setting:{0x00:使能接收和发送,0x01:使能接收&禁止发送,0x03:禁止接收和发送}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void Com_Control(dword msgID,int Inhibitory_response,dword Com_Setting,dword Type_Setting,int Passcondition)
{
  diagRequest ABS_ESP.EnableRxAndDisableTx_Control req28;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试28服务控制通讯",stepnum);

  DiagSetPrimitiveByte(req28,1,Com_Setting);
  DiagSetPrimitiveByte(req28,2,Type_Setting);
  if(Inhibitory_response == 1)
  {
    DiagSetPrimitiveByte(req28,1,0X80|DiagGetPrimitiveByte(req28,1));
    Passcondition = 0;
  } 
  //APP无效时 不响应
  else if(BT_28==1 && curAppValid==0)
    Passcondition = 0x12;
  else
    Passcondition = Resp_28;
  
  if(msgID==funID && (Passcondition==0x12 || Passcondition==0x13))
  {
    if(@AUTO::Config_Switch == 7)
      Passcondition = -1;
    else
      Passcondition = 0;
  }
  else if((@AUTO::Config_Switch == 7 || @AUTO::Config_Switch == 8) && msgID==funID)
    Passcondition = -1;
  _diagSendMsg(msgID,req28);
  _get_FC(req28,msgID,stepid,Passcondition);
}
/// <Unlock>
/*发送22 F1 8C请求序列号*/
void _SendF18C(byte Serial_Num[])
{
//  diagRequest *req22;
  diagRequest ABS_ESP.Primary_Bootloader_Software_Version_Number_Read req22;
  byte i;
  i = 0;
  diagResize(req22,3);
  DiagSetPrimitiveByte(req22,0,0x22);
  DiagSetPrimitiveByte(req22,1,0xF1);
  DiagSetPrimitiveByte(req22,2,0x8C);
  diagSendRequest(req22);
  testWaitForDiagRequestSent(req22,1000);
  testWaitForDiagResponse(req22,1000);
  /*获取序列号后16位*/
  for(i=0; i<16; i++)
  {
    Serial_Num[i] = DiagGetRespPrimitiveByte(req22,i+6);
  }
}

/// <Unlock>
//安全访问27服务
void Security_access()
{
  diagRequest ABS_ESP.SeedLevel1_Request reqseed;
  diagRequest ABS_ESP.KeyLevel1_Send sendkey;
  dword seed;
  dword skey; 
  byte TempSeed[16],Size;
  /*ECU KEY固定*/
  byte ECU_KEY[16] = {0x64,0x1D,0xA0,0x0D,0x7F,0xB1,0x4B,0x51,0x8D,0xA4,0x2B,0xF4,0xEF,0x0C,0x24,0xF4};
  byte ECU_Key2[16] ={0x7d,0x0b,0xa5,0xb6,0xb5,0x7c,0x49,0x05,0x8d,0xf3,0xf9,0xad,0x2f,0x31,0x92,0xfb}; //BYD新
  /*iv初始向量固定*/
  byte iv[16] = {0x11,0x22,0x33,0x44,0x55,0x66,0x77,0x88,0x99,0x00,0x66,0x55,0x44,0x33,0x22,0x11};
  /*序列号*/
  byte Serial_Num[16];
  /*密钥KEY*/
  byte Secret_KEY[16];
  byte RA[16],R[16],r[16],ra[16];
  dword KEY_Len;
  double starttime;
  double endtime;
  byte i;
  if(@AUTO::Config_Switch == 1)
    memcpy(ECU_KEY,ECU_Key2,elCount(ECU_Key2));
  i = 0;
  starttime = 0;
  endtime = 0;
  KEY_Len = 16;
  seed = 0;
  
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试进入安全访问",stepnum);
  if(SOS_Flage == 1)
  {
    diagResize(reqseed,4);
    DiagSetPrimitiveByte(reqseed,1,0x05);
    DiagSetPrimitiveByte(reqseed,2,0xB1);
    DiagSetPrimitiveByte(reqseed,3,0x8E);
    _diagSendMsg(phyID,reqseed);
    testWaitForDiagRequestSent(reqseed,1000);
    testWaitForDiagResponse(reqseed,1000);
    return;
  }
    
  diagResize(reqseed,2);
  DiagSetPrimitiveByte(reqseed,1,SeedLevel);
  DiagSetPrimitiveByte(sendkey,1,SeedLevel+1);
  testWaitForTimeout(100);
  /*各主机厂通用算法*/
  if(@AUTO::Security_Switch==0)
  {
    diagRequest * req2701;
    diagSetTarget("ABS_ESP");
    diagResize(req2701,2);
    DiagSetPrimitiveByte(req2701,0,0x27);
    DiagSetPrimitiveByte(req2701,1,SeedLevel);
    /*发送27服务请求种子*/
    _diagSendMsg(phyID,req2701);
    diagSetP2Extended(-1);
    testWaitForDiagRequestSent(req2701,200);
    
    starttime = (double)timeNow()/100;
    testWaitForDiagResponse(req2701,p2cmax);
    if(diagGetLastResponseCode(req2701) == -1 || diagGetLastResponseCode(req2701) == 0x78 )
    {
      endtime = (double)timeNow()/100;
      if(diagGetLastResponseCode(req2701)==0x78)
      {
        if(endtime - starttime < p2cmax)
          testStepPass("","收到NRC78响应，响应时间为%fms",endtime - starttime);
        else
          testStepFail("","响应NRC78超时，响应时间为%fms",endtime - starttime);
        starttime = (double)timeNow()/100;
        testWaitForDiagResponse(req2701,p2cmax*100);
        endtime = (double)timeNow()/100;
      }
      if(endtime - starttime < p2cmax*100)
        testStepPass("","收到响应，响应时间为%fms",endtime - starttime);
      else
        testStepFail("","响应超时，响应时间为%fms",endtime - starttime);
    }
    else
    {
      testStepFail("","请求种子响应超时");
    }
    _TestResult(req2701,stepid,Resp_2701);
    /*获取响应种子大小*/
    Size = DiagGetRespPrimitiveSize(req2701);
//    writeEx(-3,1,"diagGetLastResponseCode(reqseed) = %d", diagGetLastResponseCode(reqseed));
    /*获取种子*/
    if(diagGetLastResponseCode(req2701)==-1)
    {
      for(i=2;i<Size;i++)
      {
        TempSeed[i-2] = DiagGetRespPrimitiveByte(req2701,i);
        seed |=  TempSeed[i-2] << ((Size-i-1)*8);
      }
    }
    else
       writeEx(-3,1,"/*-------------请求种子失败-------------*/");

    /*计算密钥*/
    _SecurityAccess(seed,skey);
    diagResize(sendkey,Size);
    for(i=2;i<Size;i++)
    {
      DiagSetPrimitiveByte(sendkey,i,skey>>((Size-i-1)*8) & 0xFF);
    }
  }
  /*AES_CBC安全算法*/
  else if(@AUTO::Security_Switch==1)
  {
    writeEx(-3,1,"采用AES_CBC安全算法");
    _SendF18C(Serial_Num);
    /*序列号移位*/
    LeftMove(Serial_Num);
    /*用ECU KEY加密移位后的序列号 获取密钥KEY*/
    AES128_CBC_encrypt_buffer(Secret_KEY,Serial_Num,KEY_Len,ECU_KEY,iv);
    testWaitForTimeout(100);
    //发送27服务请求种子
    diagSendRequest(reqseed);
    testWaitForDiagRequestSent(reqseed,1000);
    testWaitForDiagResponse(reqseed,1000);
    Size = DiagGetRespPrimitiveSize(reqseed);
    /*获取种子*/
    for(i=2;i<Size;i++)
    {
      RA[i-2] = DiagGetRespPrimitiveByte(reqseed,i);
    }
    /*用密钥KEY解密RA 得到ra`*/
    AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,iv);
    /*ra逆向*/
    reverseNum(ra,16);
    /*用密钥KEY加密ra得到R*/
    AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,iv);
    diagResize(sendkey,Size);
    for(i=2;i<Size;i++)
      DiagSetPrimitiveByte(sendkey,i,R[i-2]);
  }
  else if(@AUTO::Security_Switch==2)
  {
    Security_access_AES_CMAC();
    testWaitForTimeout(100);
    return;
  }
  testWaitForTimeout(100);
  /*发送密钥*/
  if(@Faultinsert::TC_BT_AppValid == 1 && @Faultinsert::TC_Error_27Key == 1)
  {
//    Size = 6;
//    diagResize(sendkey,Size);
    for(i=2;i<Size;i++)
    {
      DiagSetPrimitiveByte(sendkey,i,0);
    }
    if(Loop_Add_Times > 0)
      @Faultinsert::TC_Miss_GetFc = 1;
  }
  _diagSendMsg(phyID,sendkey);
  testWaitForDiagRequestSent(sendkey,100);
  _get_FC(sendkey,phyID,stepid,Resp_2702);
}
/// <Unlock>
// Geely 3.0/瑞驰 AES_cmac 安全访问27服务,种子和密钥为16个字节
void Security_access_AES_CMAC()
{
  diagRequest ABS_ESP.SeedLevel1_Request reqseed;
  diagRequest ABS_ESP.KeyLevel1_Send sendkey;
  dword seed;
  dword skey; 
   
  DiagSetPrimitiveByte(reqseed,1,SeedLevel);
  DiagSetPrimitiveByte(sendkey,1,SeedLevel+1);
  
  if(@Faultinsert::TC_Miss_27_1 == 1)
  {
    Resp_34_f = 0x33;
    Exit_34_f = 1;
  }
  else if(@Faultinsert::TC_Error_27 == 1 || (@Faultinsert::TC_BT_AppValid == 1 && @Faultinsert::TC_Error_27Key == 1))
  {
    _diagSendMsg(phyID,reqseed);
    _saveMsg(p2cmax);
    _CheckCode(-1,4);
    testWaitForTimeout(200);
    diagResize(sendkey,18);
    _padding2702(1,sendkey);
    _diagSendMsg(phyID,sendkey);
    if(Loop_Add_Times > 0 && @Faultinsert::TC_BT_AppValid == 1 && @Faultinsert::TC_Error_27Key == 1)
      @Faultinsert::TC_Miss_GetFc = 1;
    _get_FC(sendkey,phyID,stepid,0x35);
    Resp_34_f = 0x33;
    Exit_34_f = 1;
  }
  else
  {
    testWaitForTimeout(500);  
    _diagSendMsg(phyID,reqseed);
    _saveMsg(p2cmax);
    _CheckCode(-1,4);
    testWaitForTimeout(200);
    diagResize(sendkey,18);
    _padding2702(0,sendkey);
    _diagSendMsg(phyID,sendkey);
//    _saveMsg(p2cmax);
    testWaitForDiagRequestSent(sendkey,1000);
//    testWaitForDiagResponse(sendkey,p2cmax*2);
    _get_FC(sendkey,phyID,stepid,Resp_2702);
    testWaitForTimeout(500);
  }
  testWaitForTimeout(150);
}
/// <Unlock>
/*数组逆向*/
void reverseNum(byte num[],dword size)
{
  dword startnum;
  dword temp;
  dword endnum;
  
  startnum = 0;
  endnum = size - 1;
  while(startnum < endnum)
  {
    temp = num[startnum];
    num[startnum] = num[endnum];
    num[endnum] = temp;
    startnum++;
    endnum--;
  }
}
/// <Unlock>
/*数组左移*/
void LeftMove(byte Serial_Num[])
{
  dword i;
  byte bit;
  byte carry;
  byte nextcarry;
  byte current;
  byte shif;  
  carry = 0;
  nextcarry = 0;
  bit = 3;
  for(i=15;i>=0;i--)
  {
    current = Serial_Num[i];
    shif = current << bit;
    shif |= carry;
    Serial_Num[i] = shif & 0xFF;
    carry = (current>>(8-bit)) & ((1<<bit)-1);
  }
}
/// <Unlock>
//用于五菱安全算法
word croshortright(word c, word b)
{
	word right;
	word left;
	word crorightvalue;
  right = c >> b;
  left = c << (16 - b);
  crorightvalue = left | right;
	return crorightvalue;
}
/// <Unlock>
//用于五菱安全算法
dword croleft(dword c, word b)
{
	dword left;
	dword right;
	dword croleftvalue;
  left = c << b;
  right = c >> (32 - b);
  croleftvalue = left | right;
	return croleftvalue;
}
/// <Unlock>
//用于五菱安全算法
dword mulu32(dword val1, dword val2)
{
	dword x, y, z, p;
  dword NC_UDS_KEYMASK=0x5c7d4ef3;
	x = (val1 & NC_UDS_KEYMASK) | ((~val1) & val2);
	y = ((croleft(val1, 1)) & (croleft(val2, 14)))
	        | ((croleft(NC_UDS_KEYMASK, 21)) & (~(croleft(val1, 30))));
	z = (croleft(val1, 17)) ^ (croleft(val2, 4))
	        ^ (croleft(NC_UDS_KEYMASK, 11));
	p = x ^ y ^ z;
	return p;
}
/// <Unlock>
//安全算法函数
//参数SaccSeed：请求种子
//参数SaccKey：安全访问密钥
void _SecurityAccess(dword SaccSeed,dword& SaccKey)
{
  byte i;
  i = 0;
  if(@AUTO::Config_Switch==1)//BYD
  {
    dword KeyK;
    dword KeyResult;
    KeyK=0X00000137;
    KeyResult = ((((SaccSeed >> 1) ^ SaccSeed) <<3) ^ (SaccSeed >>2));
    SaccKey = KeyResult ^ KeyK;
  }
  else if(@AUTO::Config_Switch==2)//CA
  {
    dword seed;
    dword key1;
    dword key2;
    seed = 0;
    for(i=0;i<16;i++)
      seed=seed|(SaccSeed>>(31-i*2)&(1<<i));
    for(i=0;i<16;i++)
      seed=seed|(SaccSeed<<(31-i*2)&(0X80000000>>i));
    key1=SaccSeed^0X70F77302;
    key2=seed^0X70F77302;
    SaccKey=key1+key2;
  }
  else if(@AUTO::Config_Switch==3)//Geely 1.0
  {
    byte i;
    byte XorArray[4];
    byte calData[4];
    byte skeybyte[4];
    
    //Geely 1.0
    XorArray[0]=0xC1;
    XorArray[1]=0x1C;
    XorArray[2]=0x12;
    XorArray[3]=0x81;
    
    //宝腾Z65M 924B
//    XorArray[0]=0x53;
//    XorArray[1]=0x4E;
//    XorArray[2]=0x22;
//    XorArray[3]=0xCD;
    
    calData[0]=0;
    calData[1]=0;
    calData[2]=0;
    calData[3]=0;
    for (i = 0;i < 4;i++)
    {
      calData[i] = ((SaccSeed>>(24-8*i))&0xFF)^ XorArray[i];/*修改秘钥传入方式为MSB*/
    }
    skeybyte[0] = ((calData[2] & 0x03) << 6)|((calData[3]&0xFC)>>2);
    skeybyte[1] = ((calData[3] & 0x03) << 6 )|(calData[0]&0x3F);
    skeybyte[2] = (calData[0] & 0xFC)|((calData[1] & 0xC0) >> 6);
    skeybyte[3] = (calData[1] & 0xFC)|(calData[2] & 0x03);
    SaccKey=skeybyte[0];
    SaccKey=(SaccKey<<8)|skeybyte[1];
    SaccKey=(SaccKey<<8)|skeybyte[2];
    SaccKey=(SaccKey<<8)|skeybyte[3];
    /*故障注入：发送错误密钥*/
    if(@Faultinsert::TC_Error_27==1)
    {
      SaccKey = SaccKey ^ 0xFFFFFFFF;
      Resp_2702 = 0x35;
      Resp_2E = 0x33;
      Exit_2E = 1;
    }
  }
  else if(@AUTO::Config_Switch==5)//鑫源
  {
    byte Seed[4];
    byte Skey[4];
    byte Xor[4]={0xA1,0x59,0xD4,0x30};
    byte Cal[4];
    byte i;
    Seed[0]=SaccSeed>>24;
    Seed[1]=SaccSeed>>16;
    Seed[2]=SaccSeed>>8;
    Seed[3]=SaccSeed; 
    for(i=0;i<4;i++)
    {
      Cal[i]=Seed[i]^Xor[i];
    }
    Skey[0]=((Cal[3]&0xF5)>>2) | ((Cal[0]&0x0F)<<6);
    Skey[1]=((Cal[2]&0x0F)<<4) | ((Cal[3]&0xC0)>>6);
    Skey[2]=((Cal[1]&0xFC)) | ((Cal[0]&0x3D));
    Skey[3]=((Cal[3]&0xE0)) | ((Cal[1]&0xF0)>>4);
    SaccKey=Skey[0];
    SaccKey=(SaccKey<<8)|Skey[1];
    SaccKey=(SaccKey<<8)|Skey[2];
    SaccKey=(SaccKey<<8)|Skey[3];
  }
  else if(@AUTO::Config_Switch==6)//瑞驰
  {
    byte i;
    dword tmpSaccSeed;
    dword mask = 0x5FD62190;//掩码5FD62190
    tmpSaccSeed = SaccSeed;
		for(i=0; i<32; i++)
		{
			if(tmpSaccSeed & 0x80000000)
			{
				tmpSaccSeed = tmpSaccSeed << 1;
				tmpSaccSeed = tmpSaccSeed ^ mask;
			}
			else
			{
				tmpSaccSeed = tmpSaccSeed << 1;
			}
		}
    SaccKey = tmpSaccSeed;
  }
  else if(@AUTO::Config_Switch==7)//奇瑞
  {
    byte Seed[2];
    dword remainder;
    byte n;
    byte i;
    Seed[0] = SaccSeed >> 8;
    Seed[1] = SaccSeed & 0xFF; 
    remainder =0xFFFE;
    for (n = 0; n < 2; n++)
    {
      remainder ^= ((Seed[n]) << 8);
      for (i = 0; i < 8; i++)
      {
        if (remainder & 0x8000)
        {
          if(remainder & 0x0080)
          {
            remainder = (remainder << 1) ^ 0x8408;
          }
          else
          {
            remainder = (remainder << 1) ^ 0x8025;
          }
        }
        else
        {
          remainder = (remainder << 1);
        }
      }
    }
    remainder = remainder & 0xFFFF;
    /*故障注入：安全访问密钥错误*/
    if(@Faultinsert::TC_Error_27==1)
    {
      Resp_2702 = 0x35;
      Resp_34_f = 0x33;
      Exit_34_f = 1;
      SaccKey = SaccSeed;
    }
    else
      SaccKey = remainder;
  }
  else if(@AUTO::Config_Switch==8)//五菱
  {
    word uds_key_mul[32] = 
    {
      0x7678, 0x9130, 0xd753, 0x750f, 0x72cb, 0x55f7, 0x13da, 0x786b, 
      0x372a, 0x4932, 0x0e7c, 0x3687, 0x3261, 0xa82c, 0x8935, 0xd00c, 
      0x1995, 0x4311, 0xb854, 0x0d8d, 0x9863, 0x1a21, 0xf753, 0xd6d3,
      0xb15d, 0x7f3d, 0x6821, 0x791c, 0x26c5, 0x2e37, 0x0e69, 0x64a0 
    };
    dword temp;
  	word index;
  	word mult1;
  	word mult2;
    dword NC_DEFAULT_SEED;
    dword NC_UDS_KEYMASK;
    NC_DEFAULT_SEED=0xA548FD85;
    NC_UDS_KEYMASK=0x5C7D4EF3;
    index = 0x5D39;
  	if(SaccSeed == 0) 
    {
  		SaccSeed = NC_DEFAULT_SEED;
  	}
  	for(temp=0x80000000;temp!=0;temp>>=1)
  	{
  		if(temp & SaccSeed) 
      {
  			index = croshortright(index,1);
  			if (temp & NC_UDS_KEYMASK) 
        {
  				index ^= 0x74c9;
  			}
  		}
  	}
  	mult1 = (uds_key_mul[(index >> 2) & ((1 << 5) - 1)] ^ index);
  	mult2 = (uds_key_mul[(index >> 8) &((1 << 5) - 1)] ^ index);
  	temp = (((dword) mult1) << 16) | ((dword) mult2);
  	temp = mulu32(SaccSeed,temp);
  	SaccKey = temp;
  }
  else if(@AUTO::Config_Switch==9 || @AUTO::Config_Switch==10)//东风小康 || 赛力斯
  {
    byte Seed[4];
    byte Skey[4];
    byte Xor[4]={0xD1,0x31,0x54,0x07};
    byte Cal[4];
    byte i;
    Seed[0]=(SaccSeed>>24)&0xFF;
    Seed[1]=(SaccSeed>>16)&0xFF;
    Seed[2]=(SaccSeed>>8)&0xFF;
    Seed[3]=SaccSeed&0xFF;
    
    for(i=0;i<4;i++)
      Cal[i]=Seed[i]^Xor[i];
    
    if(SeedLevel==0x01)
    {
      Skey[0]=((Cal[0]&0x0F)<<4)|(Cal[1]&0xF0);
      Skey[1]=((Cal[1]&0x0F)<<4)|((Cal[2]&0xF0)>>4);
      Skey[2]=(Cal[2]&0xF0)|((Cal[3]&0xF0)>>4);
      Skey[3]=((Cal[3]&0x0F)<<4)|(Cal[0]&0x0F);
    }
    else
    {
      Skey[0]=((Cal[0]&0x0f)<<4)|(Cal[1]&0x0f);
      Skey[1]=((Cal[1]&0xf0)>>4)|((Cal[2]&0x0f)<<4);
      Skey[2]=((Cal[2]&0xf0)>>4)|(Cal[3]&0xf0);
      Skey[3]=(Cal[3]&0x0f)|((Cal[0]&0xf0)>>4);
    }
    SaccKey=Skey[0];
    SaccKey=(SaccKey<<8)|Skey[1];
    SaccKey=(SaccKey<<8)|Skey[2];
    SaccKey=(SaccKey<<8)|Skey[3];
    /*故障注入：安全访问密钥错误*/
    if(@Faultinsert::TC_Error_27==1)
    {
      Resp_2702 = 0x35;
      Resp_2E = 0x33;
      Exit_2E = 1;
      SaccKey = SaccSeed;
    }
  }
  else if(@AUTO::Config_Switch== 12)
  {
    dword AppKeyConst = 0x19870413;
    SaccKey = ((SaccSeed + 0x19870424)|AppKeyConst)&0xFFFFFFFF;
  }
}

/// <Geely3.0>
//Geely3.0 SBT，34请求下载服务
void SBT_34(dword BlockVbtFlage)
{
  qword eraseAddr,eraseLength;
  byte i;
  i = 0;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d",stepnum);
  testStep(stepid,"开始测试SBT 34请求服务");
  eraseLength = 0;
  //故障注入：步骤缺失SBT 34请求下载
  if(@Faultinsert::TC_Miss_34_F==1)
  {
    Resp_36_f = 0x24;
    Exit_36_f = 1;
  }
  else
  {
    if(BlockVbtFlage == 0)
    {
      eraseAddr = hexfile_sbt[0].BlockStartAddr;
      for(i=0;i<HexBlockTotalNumber_sbt;i++)
      {
        eraseLength+=hexfile_sbt[i].BlockDataLength;
      }
      if(Flash_DataFormatId==0x10)
      {
        _Send34_SBT(loadhexStartAddr,loadhexLength,phyID,Resp_34_f);
      }
      else
      {
        _Send34_SBT(eraseAddr,eraseLength,phyID,Resp_34_f);
      }
    }
    else if(BlockVbtFlage == 1)
    {
      eraseAddr = hexfile_sbt[0].BlockVbtStartAddr;
      for(i=0;i<VbtBlockTotalNumber_sbt;i++)
      {
        eraseLength+=hexfile_sbt[i].BlockVbtDataLength;
      }
      eraseLength = eraseLength;
//      write("eraseLength = %x",eraseLength);
      if(Flash_DataFormatId==0x10)
      {
        _Send34_SBT(vbtStartAddr,vbtLength,phyID,Resp_34_f);
      }
      else
      {
        _Send34_SBT(eraseAddr,eraseLength,phyID,Resp_34_f);
      }
    }
  }
  
}
//Flash 34请求下载服务
void FlashDriver_34()
{
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试34服务请求Flash下载",stepnum);
  
  //故障注入：Geely 2E写数据后功能寻址复位
  if(@Faultinsert::TC_Restart_after_2E==1 && @AUTO::Config_Switch==3)
  {
    Resp_34_f=0x11;
    _Startreset(funID,0x01,Resp_11);
    Exit_34_f = 1;
  }
  //故障注入：Geely 2E写数据后功能寻址切换默认会话
  else if(@Faultinsert::TC_DefaultSession_after_2E==1 && @AUTO::Config_Switch==3)
  {
//    Resp_34_f=0x7F;
    Resp_34_f=0x11;
    enterDefault(funID,0,Resp_1001);
    testWaitForTimeout(Restart_Time);
    Exit_34_f = 1;
  }
  //故障注入：请求下载Flash的起始地址错误
  if(@Faultinsert::TC_ErrorAddr_Flash==1)
  {
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==3
    || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)//BYD || Geely1.0 || 鑫源 || 五菱
    {
      Resp_34_f=0x31;
      Resp_36_f=0x24;
      Resp_37_f=0x24;
      Resp_0202_f=0x22;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==2)//ChangAn
    {
      Resp_34_f=0x31;
      Resp_36_f=0x22;
      Resp_37_f=0x22;
      Resp_0202_f=0x22;
      Exit_0202_f = 1;
    }
    //瑞驰 || 奇瑞 || 东风小康 || 赛力斯
    else
    {
      Resp_34_f=0x31;
      Exit_34_f = 1;
    }
    DriverAddr=@AUTO::DriverAddr;
    _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
    return;
  }
  //故障注入：缺失步骤Flash 34请求
  else if(@Faultinsert::TC_Miss_34_F==1)
  {
    //不同主机厂，规范需求不同
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5 
    || @AUTO::Config_Switch==8 || @AUTO::Config_Switch==10)//BYD || 鑫源 || 五菱 || 赛力斯
    {
      Resp_36_f=0x24;
      Resp_37_f=0x24;
      Resp_0202_f=0x22;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==2)//ChangAn
    {
      Resp_36_f = 0x22;
      Exit_36_f = 1;
    }
    else if(@AUTO::Config_Switch==3 || @AUTO::Config_Switch==6 || @AUTO::Config_Switch==7)//Geely1.0 || 瑞驰 ||奇瑞
    {
      Resp_36_f = 0x24;
      Exit_36_f = 1;
    }
    else if(@AUTO::Config_Switch==11)//奇瑞T1V
    {
      Resp_36_f = 0x24;
      Resp_37_f = 0x24;
      PassState_31[0] = 0x06;
      Exit_0202_f = 1;
    }
    return;
  }
  //故障注入：请求下载Flash的数据内存大小错误
  else if(@Faultinsert::TC_ErrorAddrSize_Flash==1)
  {
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==3 
    || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)//BYD || Geely1.0 || 鑫源 || 五菱
    {
      Resp_34_f=0x31;
      Resp_36_f=0x24;
      Resp_37_f=0x24;
      Resp_0202_f=0x22;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==2)//CA
    {
      Resp_34_f=0x31;
      Resp_36_f=0x22;
      Resp_37_f=0x22;
      Resp_0202_f=0x22;
      Exit_0202_f = 1;
    }
    //瑞驰 || 奇瑞 || 东风小康 || 赛力斯
    else
    {
      Resp_34_f=0x31;
      Exit_34_f = 1;
    }
    _Send34_Flash(DriverAddr,@AUTO::DriverSize,phyID,Resp_34_f);
    return;
  }
  //故障注入：请求下载Flash的数据格式标识错误
  else if(@Faultinsert::TC_ErrorDataFormatId_Flash==1)
  {
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)//BYD || 鑫源 || 五菱
    {
      Flash_DataFormatId = 0x01;
      Resp_34_f = 0x31;
      Resp_36_f = 0x24;
      Resp_37_f = 0x24;
      Resp_0202_f = 0x22;
      _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==11) //奇瑞T1V
    {
      Flash_DataFormatId = 0x01;
      Resp_34_f = 0x31;
      Resp_36_f = 0x24;
      Resp_37_f = 0x24;
      _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
    }
    else //ChangAn || Geely1.0 || 瑞驰 || 奇瑞 || 赛力斯 
    {
      Flash_DataFormatId = 0x01;
      Resp_34_f = 0x31;
      _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
      Exit_34_f = 1;
    }
    return;
  }
  //故障注入：请求下载Flash的地址和长度格式标识错误
  else if(@Faultinsert::TC_ErrorAddrAndLenId_Flash==1)
  {
    //不同主机厂，规范需求不同
    if(@AUTO::Config_Switch==1)//BYD
    {
      Flash_AddrAndLenId=0x45;
      Resp_34_f=0x13;
      Resp_36_f=0x24;
      Resp_37_f=0x24;
      Resp_0202_f=0x22;
      _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
      Exit_0202_f = 1;
      return;
    }
    else if(@AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)//鑫源 || 五菱
    {
      Flash_AddrAndLenId=0x43;
      Resp_34_f=0x31;
      Resp_36_f=0x24;
      Resp_37_f=0x24;
      Resp_0202_f=0x22;
      _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
      Exit_0202_f = 1;
      return;
    }
    else if(@AUTO::Config_Switch==11 )//奇瑞T1V
    {
      Flash_AddrAndLenId=0x43;
      Resp_34_f=0x31;
      Resp_36_f=0x24;
      Resp_37_f=0x24;
      _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
      Exit_0202_f = 1;
      return;
    }
    else //ChangAn || Geely1.0 || 瑞驰 || 奇瑞 || 赛力斯
    {
      Flash_AddrAndLenId=0x43;
      Resp_34_f=0x31;
      _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
      Exit_34_f = 1;
      return;
    }
  }
  else
  {
    _Send34_Flash(DriverAddr,DriverSize,phyID,Resp_34_f);
  }
  
  /*故障注入：Flash 34请求下载后 执行31 01 FF 00*/
  if(@Faultinsert::TC_34F_FF00==1)
  {
    Resp_ff00 = 0x72;
    Exit_34_f = 1;
    _Sendff00(eraseaddr[0][eraseadd],eraselength[0][eraseadd],phyID);
  }
}
//APP 34请求下载服务
//参数addr：请求下载的起始地址；
//参数length34：请求下载的地址大小；
void App_34(dword addr,dword length34)
{
  char casetitle[40];
  byte change1=0;
  byte change2=0;
  
  //故障注入：34 App请求起始地址错误
  if(@Faultinsert::TC_ErrorAddr_App==1)
  {
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)//BYD || 鑫源 || 五菱
    {
      addr = @AUTO::AppAddr;
      Resp_34_a = 0x31;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Break_Download = 1;
      Exit_0202_a = 1;
    }
    //ChangAn || Geely1.0 || 瑞驰 || 奇瑞 || 东风小康 || 赛力斯
    else
    {
      addr = @AUTO::AppAddr;
      Resp_34_a = 0x31;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Exit_34_a = 1;
    }
    return;
  }
  //故障注入：34 App请求地址大小错误
  else if(@Faultinsert::TC_ErrorAddrSize_App==1)
  {
    //BYD || 鑫源 || 五菱
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)
    {
      length34 = @AUTO::AppSize;
      Resp_34_a = 0x31;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Break_Download = 1;
      Exit_0202_a = 1;
    }
    //ChangAn || Geely1.0 || 瑞驰 || 奇瑞 || 东风小康 || 赛力斯
    else
    {
      length34 = @AUTO::AppSize;
      Resp_34_a = 0x31;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Exit_34_a = 1;
    }
    return;
  }
  //故障注入：34 App指定数据格式标识错误
  else if(@Faultinsert::TC_ErrorDataFormatId_App==1)
  {
    //BYD || 鑫源 || 五菱
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)
    {
      App_DataFormatId=0x01;
      Resp_34_a = 0x31;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Break_Download = 1;
      Exit_0202_a = 1;
    }
    //ChangAn || Geely1.0 || 瑞驰 || 奇瑞 || 赛力斯
    else
    {
      App_DataFormatId=0x01;
      Resp_34_a = 0x31;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Exit_34_a = 1;
    }
    return;
  }
  //故障注入：34 App指定地址和长度格式标识错误
  else if(@Faultinsert::TC_ErrorAddrAndLenId_App==1)
  {
    if(@AUTO::Config_Switch==1)//BYD
    {
      App_AddrAndLenId=0x45;
      Resp_34_a = 0x31;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Break_Download = 1;
      Exit_0202_a = 1;
    }
    else if(@AUTO::Config_Switch==5 || @AUTO::Config_Switch==8)//鑫源 || 五菱
    {
      App_AddrAndLenId=0x43;
      Resp_34_a = 0x31;
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Break_Download = 1;
      Exit_0202_a = 1;
    }
    //ChangAn || Geely1.0 || 瑞驰 || 奇瑞 || 赛力斯
    else 
    {
      App_AddrAndLenId=0x43;
      Resp_34_a = 0x31;
      _Send34_App(addr,length34,phyID,Resp_34_a);
      Exit_34_a = 1;
    }
    return;
  }
  //故障注入：APP 34请求数据重复
  else if(@Faultinsert::TC_Re_34_A==1)
  {
    _Send34_App(addr,length34,phyID,Resp_34_a);
    Resp_34_a = 0x22;
    _Send34_App(addr,length34,phyID,Resp_34_a);
    Exit_34_a = 1;
    return;
  }
  //故障注入：步骤缺失App 34请求
  else if(@Faultinsert::TC_Miss_34_A==1)
  {
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5 || @AUTO::Config_Switch==10)//BYD || 鑫源 || 赛力斯
    {
      Resp_36_a = 0x24;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Exit_0202_a = 1;
    }
    else if(@AUTO::Config_Switch==2)//ChangAn
    {
      Resp_36_a = 0x22;
      Exit_34_a = 0;
      Exit_36_a = 1;
    }
    //Geely 1.0 || 瑞驰 || 奇瑞 || 小康
    else
    {
      Resp_36_a = 0x24;
      Exit_34_a = 0;
      Exit_36_a = 1;
    }
    return;
  }
  else
  {
    //Geely 3.0
    if(@AUTO::Config_Switch==4)
    {
      
    }
    else
      _Send34_App(addr,length34,phyID,Resp_34_a);
  }
  testWaitForTimeout(200); //增加延时防止报错
}
//SBT 34请求下载
//参数Addr:驱动内存地址；Size:驱动内存大小；
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send34_SBT(dword Addr,dword Size,dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Download_Request req34;
  
  //故障注入：SBT 34服务地址错误
  if(@Faultinsert::TC_ErrorLength_Flash==1)
  {
    Addr = @AUTO::DriverAddr;
    Passcondition = 0x31;
  }
  //故障注入：SBT 34服务内存大小错误
  if(@Faultinsert::TC_ErrorLength_Flash==1)
  {
    Size = @AUTO::DriverSize;
    Passcondition = 0x31;
  }
  
  DiagSetPrimitiveByte(req34,1,Flash_DataFormatId);
  DiagSetPrimitiveByte(req34,2,Flash_AddrAndLenId);
  DiagSetPrimitiveByte(req34,3,Addr>>24);
  DiagSetPrimitiveByte(req34,4,Addr>>16 & 0xFF);
  DiagSetPrimitiveByte(req34,5,Addr>>8 & 0xFF);
  DiagSetPrimitiveByte(req34,6,Addr & 0xFF);
  DiagSetPrimitiveByte(req34,7,Size>>24);
  DiagSetPrimitiveByte(req34,8,Size>>16 & 0xFF);
  DiagSetPrimitiveByte(req34,9,Size>>8 & 0xFF);
  DiagSetPrimitiveByte(req34,10,Size & 0xFF);
  
  //故障注入：SBT 34服务数据格式标识错误
  if(@Faultinsert::TC_ErrorDataFormatId_Flash==1)
  {
    DiagSetPrimitiveByte(req34,1,0x01);
    Passcondition = 0x31;
    Exit_34_f = 1;
  }
  //故障注入：SBT 34服务地址和长度格式标识错误
  else if(@Faultinsert::TC_ErrorAddrAndLenId_Flash==1)
  {
    DiagSetPrimitiveByte(req34,2,0x45);
    Passcondition = 0x13;
    if(@AUTO::Geely3_Config == 1) //P162
      Passcondition = 0x31;
    Exit_34_f = 1;
  }
  
  _SendAndWriteReport(req34,msgID);
  _get_FC(req34,msgID,stepid,Passcondition);

}
//Flash请求下载
//参数Addr:驱动内存地址；Length:驱动内存大小；
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send34_Flash(dword Addr,dword Length,dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Download_Request req34;
  
  diagResize(req34,0x0B);
  DiagSetPrimitiveByte(req34,1,Flash_DataFormatId);
  DiagSetPrimitiveByte(req34,2,Flash_AddrAndLenId);
  DiagSetPrimitiveByte(req34,3,Addr>>24);
  DiagSetPrimitiveByte(req34,4,Addr>>16 & 0xFF);
  DiagSetPrimitiveByte(req34,5,Addr>>8 & 0xFF);
  DiagSetPrimitiveByte(req34,6,Addr & 0xFF);
  DiagSetPrimitiveByte(req34,7,Length>>24);
  DiagSetPrimitiveByte(req34,8,Length>>16 & 0xFF);
  DiagSetPrimitiveByte(req34,9,Length>>8 & 0xFF);
  DiagSetPrimitiveByte(req34,10,Length & 0xFF);
  
  /*奇瑞测试Flash 34 数据长度和长度格式标识同时错误*/
  if(@AUTO::Config_Switch==7 && @Faultinsert::TC_ErrorAddrAndLenId_Flash==1)
  {
    diagResize(req34,5);
    DiagSetPrimitiveByte(req34,1,Flash_DataFormatId);
    DiagSetPrimitiveByte(req34,2,Flash_AddrAndLenId);
    DiagSetPrimitiveByte(req34,3,Length>>8 & 0xFF);
    DiagSetPrimitiveByte(req34,4,Length & 0xFF);
    Passcondition = 0x31;
    Exit_34_f = 1;
  }
  /*小康 Flash 34请求服务的报文长度错误*/
  else if(@Faultinsert::TC_ErrorLength_Flash==1)
  {
    diagResize(req34,0x0C);
    Passcondition = 0x13;
    Exit_34_f = 1;
  }
  _diagSendMsg(msgID,req34);
  _get_FC(req34,msgID,stepid,Passcondition);
}
//APP请求下载
//参数addr:驱动内存地址；length:驱动内存大小；
//参数msgID:{phyID:物理寻址,funID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void _Send34_App(dword addr,dword length,dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Download_Request req34;
  
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试34服务请求APP下载",stepnum);
  
  diagResize(req34,0x0B);
  
  //故障注入：APP 34服务地址错误
  if(@Faultinsert::TC_ErrorAddr_App==1 && @AUTO::Config_Switch==4)
  {
    addr = @AUTO::AppAddr;
    Passcondition = 0x31;
    Resp_36_a = 0x24;
    Resp_37_a = 0x24;
//    Resp_0202_a = 0x24;
    PassState_31[1] = 0x06;
    Exit_0202_a = 1;
    if(@AUTO::Geely3_Config == 1)
    {
      Resp_0202_a = 0x24;
    }
  }
  //故障注入：APP 34服务地址大小错误
  if(@Faultinsert::TC_ErrorAddrSize_App==1 && @AUTO::Config_Switch==4)
  {
    length = @AUTO::AppSize;
    Passcondition = 0x31;
    Resp_36_a = 0x24;
    Resp_37_a = 0x24;
//    Resp_0202_a = 0x24;
    PassState_31[1] = 0x06;
    Exit_0202_a = 1;
    if(@AUTO::Geely3_Config == 1)
    {
      Resp_0202_a = 0x24;
    }
  }
  //故障注入：奇瑞APP 34数据长度和长度格式标识错误
  if(@Faultinsert::TC_ErrorAddrAndLenId_App==1 && @AUTO::Config_Switch==7)
  {
    diagResize(req34,0x05); 
  }
  
  DiagSetPrimitiveByte(req34,1,App_DataFormatId);
  DiagSetPrimitiveByte(req34,2,App_AddrAndLenId);
  DiagSetPrimitiveByte(req34,3,addr>>24);
  DiagSetPrimitiveByte(req34,4,addr>>16 & 0xFF);
  DiagSetPrimitiveByte(req34,5,addr>>8 & 0xFF);
  DiagSetPrimitiveByte(req34,6,addr & 0xFF);
  DiagSetPrimitiveByte(req34,7,length>>24);
  DiagSetPrimitiveByte(req34,8,length>>16 & 0xFF);
  DiagSetPrimitiveByte(req34,9,length>>8 & 0xFF);
  DiagSetPrimitiveByte(req34,10,length & 0xFF);
  
  //故障注入：APP 34服务报文长度错误
  if(@Faultinsert::TC_ErrorLength_App==1)
  {
    diagResize(req34,0x0C);
    Passcondition = 0x13;
    Exit_34_a = 1;
  }
  //故障注入：APP 34服务数据格式标识错误
  if(@Faultinsert::TC_ErrorDataFormatId_App==1 && @AUTO::Config_Switch==4)
  {
    DiagSetPrimitiveByte(req34,1,0x01);
    Passcondition = 0x31;
    Resp_36_a = 0x24;
    Resp_37_a = 0x24;
//    Resp_0202_a = 0x24;
    PassState_31[1] = 0x06;
    Exit_0202_a = 1;
    if(@AUTO::Geely3_Config == 1) //P162
    {
      Resp_0202_a = 0x24;
    }
  }
  //故障注入：APP 34服务地址和长度格式标识错误
  if(@Faultinsert::TC_ErrorAddrAndLenId_App==1 && @AUTO::Config_Switch==4)
  {
    DiagSetPrimitiveByte(req34,2,0x45);
    Passcondition = 0x31;//0x13;
    Resp_36_a = 0x24;
    Resp_37_a = 0x24;
    PassState_31[1] = 0x06;
    Exit_0202_a = 1;
    if(@AUTO::Geely3_Config == 1) //P162
    {
      Resp_0202_a = 0x24;
    }
  }
  _diagSendMsg(msgID,req34);
  _get_FC(req34,msgID,stepid,Passcondition);
}

//SBT 36数据下载
void SBT_36(dword VbtBlockFlage)
{
  byte i;
  i = 0;
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d",stepnum);
  testStep(stepid,"开始测试SBT 36数据下载服务");
  
  //故障注入：步骤缺失SBT 36数据传输
  if(@Faultinsert::TC_Miss_36_F==1)
  {
    Resp_37_f = 0x24;
    Exit_37_f = 1;
  }
  else
  {
    if(VbtBlockFlage == 0)
    {
      //发送所有sbt地址块
      for(i=0;i<HexBlockTotalNumber_sbt;i++)
      {
        _Send36_SBT(hexfile_sbt[i],0);
      }
    }
    else if(VbtBlockFlage == 1)
    {
      //发送所有sbt地址块
      for(i=0;i<VbtBlockTotalNumber_sbt;i++)
      {
        _Send36_SBT(hexfile_sbt[i],1);
      }
    }
  }
}

void _Send36_SBT(struct Block hexBlock,byte state)
{
  diagRequest ABS_ESP.Download_Transmit req36;
  dword countcnt;
  qword remain,isLastLine;
  byte dataBuffer_error[0x10000];
  dword i;
  i = 0;
  
  countcnt = 0;
  isLastLine = 0;
  
  if(state==0)
  {
//    writeEx(-3,1,"hexBlock.BlockDataLength = 0x%X",hexBlock.BlockDataLength);
//    writeEx(-3,1,"Blocksize_36 = 0x%X",Blocksize_36);
//    for(i=Blocksize_36;i<= hexBlock.BlockDataLength;i+=Blocksize_36)
    if(hexBlock.BlockDataLength >= Blocksize_36 )
    {
      for(i = 0; i<= hexBlock.BlockDataLength; i += Blocksize_36)
      {
        countcnt = (countcnt + 1) & 0xFF;
        remain = hexBlock.BlockDataLength - i;
//        writeEx(-3,1,"remain = 0x%X",remain);
        if(remain < Blocksize_36)
        {
          if(@Faultinsert::TC_Error_36_F==1 )
          {
            _SendData_SBT(dataBuffer_error,i,Blocksize_36,countcnt);
            Resp_0301 = 0x22;
            Resp_37_f = 0x24;
            Resp_34_f = 0x70;
            Resp_36_f = 0x31;
            Exit_0301 = 1;
          }
          else
            _Senddata_SBT(hexBlock.dataBuffer,i,remain,countcnt);
          //故障注入: 36服务多传输一块
          if(@Faultinsert::TC_Continue_36_F==1)
          {
            countcnt = (countcnt + 1) & 0xFF;
             Resp_36_f = 0x31;
             Exit_36_f = 1;
            _Senddata_SBT(hexBlock.dataBuffer,i,remain,countcnt);
          }
          break;
        }
        //故障注入:SBT 36传输中直接37退出
        if(@Faultinsert::TC_Exit_in_36_F==1 && countcnt==2)
        {
          Resp_37_f = 0x24;
          Exit_37_f = 1;
          return;
        }
        //故障注入:SBT 36传输的数据错误
        else if(@Faultinsert::TC_Error_36_F==1 ) //&& countcnt == 1
        {
          _SendData_SBT(dataBuffer_error,i,Blocksize_36,countcnt);
          PassState_31[0] = 0x10;
          PassState_31[1] = 0x04;
          if(@AUTO::Geely3_Config == 1)
            PassState_31[1] = 0x06;
          Resp_0301 = 0x22;
          Exit_0301 = 1;
          Break_Download = 1; //仅刷写一个文件，后续文件占用时间过长
        }
        else
          _SendData_SBT(hexBlock.dataBuffer,i,Blocksize_36,countcnt);
        isLastLine = i;
      }
    }
    //判断是否全部传输完成
//    if(hexBlock.BlockDataLength - isLastLine > 0)
    else 
    {
      remain = hexBlock.BlockDataLength;
      countcnt = (countcnt + 1) & 0xFF;
      _Senddata_SBT(hexBlock.dataBuffer,0,remain,countcnt);
      //故障注入: 36服务多传输一块
      if(@Faultinsert::TC_Continue_36_F==1)
      {
        countcnt = (countcnt + 1) & 0xFF;
        Resp_36_f = 0x31;
        Exit_36_f = 1;
        _Senddata_SBT(hexBlock.dataBuffer,0 ,remain,countcnt);
      }
    }
  }
  else if(state==1)
  {
    for(i=0;i<=hexBlock.BlockVbtDataLength;i+=Blocksize_36)
    { 
      countcnt = (countcnt + 1) & 0xFF;
      remain = hexBlock.BlockVbtDataLength - i;
//      writeEx(-3,1,"remain = 0x%X",remain);
      if(remain < Blocksize_36)
      {
        //故障注入:sbt 36传输的数据错误
        if(@Faultinsert::TC_Error_36_F==1 ) //&& countcnt == 1
        {
          _SendData_SBT(dataBuffer_error,i,Blocksize_36,countcnt);
          break;
        }
        _Senddata_SBT(hexBlock.dataVbtBuffer,i,remain,countcnt);
        break;
      }
//      //故障注入:sbt 36传输中直接37退出
//      if(@Faultinsert::TC_Exit_in_36_F==1 && countcnt==2)
//      {
//        Resp_37_f = 0x24;
//        Exit_37_f = 1;
//        return;
//      }
      _SendData_SBT(hexBlock.dataVbtBuffer,i,Blocksize_36,countcnt);
//      isLastLine = i;
    }
//    //判断是否全部传输完成
//    if(hexBlock.BlockVbtDataLength - isLastLine > 0)
//    {
//      remain = hexBlock.BlockVbtDataLength - isLastLine;
//      countcnt = (countcnt + 1) & 0xFF;
////      _Senddata_SBT(hexBlock.dataVbtBuffer,hexBlock.BlockVbtDataLength,remain,countcnt);
//      _Senddata_SBT(hexBlock.dataVbtBuffer,isLastLine,remain,countcnt);
//    }
  }
  remain = 0;
  isLastLine = 0;
}

void FlashDriver_36()
{
  byte Error_J80J3_F[0x292];
  byte Error_J3_A[0x300];
  byte Error_J3_B[0x308];
  byte Error_Z65H[0x1BC];
  byte Error_BinFlash[0x500];
  
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试36服务Flash数据传输",stepnum);
  
  //故障注入：缺失步骤Flash 36请求
  if(@Faultinsert::TC_Miss_36_F==1)
  {
    //不同主机厂，需求规范不同
    if(@AUTO::Config_Switch==2)//ChangAn
    {
      Resp_37_f = 0x22;
      Resp_0202_f = 0x22;
      Exit_36_f = 0;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==7)//奇瑞
    {
      Resp_37_f = 0x24;
      Exit_36_f = 0;
      Exit_37_f = 1;
    }
    else if(@AUTO::Config_Switch==11)//奇瑞T1V
    {
      Resp_37_f = 0x24;
      Exit_36_f = 0;
      Exit_37_f = 1;
      PassState_31[0] = 0x06;
    }
    //BYD || Geely1.0 || 鑫源 || 瑞驰 || 五菱 || 赛力斯
    else
    {
      Resp_37_f = 0x24;
      Resp_0202_f = 0x22;
      Exit_36_f = 0;
      Exit_0202_f = 1;
    }
    return;
  }
  //故障注入：Flash 36传输数据错误
  else if(@Faultinsert::TC_Error_36_F==1)
  {
    //不同主机厂，需求规范不同
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==6 
    || @AUTO::Config_Switch==8 || @AUTO::Config_Switch==9)//BYD || 瑞驰 || 五菱 || 东风小康
    {
      PassState_31[0] = 0x01;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==2)//ChangAn
    {
      Resp_0202_f = 0x22;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==3 || @AUTO::Config_Switch==5)//Geely1.0 || 鑫源
    {
      PassState_31[0] = 0x05;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==11 )//T1V
    {
      PassState_31[0] = 0x01;
      Exit_0202_f = 1;
    }
    else if(@AUTO::Config_Switch==7)//奇瑞
    {
      Resp_ff00 = 0x72;
      Exit_ff00 = 1;
    }
    //不同驱动
//    if(BlockBin_Flage == 1)
//      _Send36_Flash(DriverAddr,Error_BinFlash,DriverSize);
//    else 
    if(@AUTO::FlashDriver_Switch == 0xFF)
      _Send36_Flash(DriverAddr,Error_BinFlash,DriverSize);
    else
    {
      if(@AUTO::FlashDriver_Switch==1)//J80J3-F
        _Send36_Flash(DriverAddr,Error_J80J3_F,DriverSize);
      else if(@AUTO::FlashDriver_Switch==2)//J80J3-A
        _Send36_Flash(DriverAddr,Error_J3_A,DriverSize);
      else if(@AUTO::FlashDriver_Switch==3)//J80J3-B
        _Send36_Flash(DriverAddr,Error_J3_B,DriverSize);
      else if(@AUTO::FlashDriver_Switch==4)//Z65H
        _Send36_Flash(DriverAddr,Error_Z65H,DriverSize);
      return;
    }
  }
  else
  {
//    if(BlockBin_Flage == 1)
//      _Send36_Flash(DriverAddr,BlockBin_Flash,DriverSize);
//    else 
    if(@AUTO::FlashDriver_Switch == 0xFF)
      _Send36_Flash(DriverAddr,BlockBin_Flash,DriverSize);
    else
    {
      //不同驱动
      if(@AUTO::FlashDriver_Switch==1)//J80J3-F
        _Send36_Flash(DriverAddr,J80J3_F,DriverSize);
      else if(@AUTO::FlashDriver_Switch==2)//J80J3-A
        _Send36_Flash(DriverAddr,J80J3_A,DriverSize);
      else if(@AUTO::FlashDriver_Switch==3)//J80J3-B
        _Send36_Flash(DriverAddr,J80J3_B,DriverSize);
      else if(@AUTO::FlashDriver_Switch==4)//Z65H
        _Send36_Flash(DriverAddr,Z65H,DriverSize);
    }
  }
  //故障注入：Flash 36传输完发送 FF 01
  if(@Faultinsert::TC_FF01_After_36F==1)
  {
    /*FF 01的响应 0:正响应 1:负响应*/
    if(Unnormal_FF01==1)
    {
      Resp_ff01 = 0x22;
    }
    else
    {
      PassState_31[0] = 0x01;
    }
    Exit_36_f = 1;
    _SendFF01(phyID,Resp_ff01);
  }
}

//Flash数据下载
//参数addr:驱动内存地址;  data36:数据内容;   length:驱动内存大小;
void _Send36_Flash(dword addr,byte data36[],dword length)
{
  diagRequest ABS_ESP.Download_Transmit req36;
  dword countcnt;
  dword remain;
  dword Re_Time;
  dword Blocksize_temp;
  byte j=0;
  Re_Time = 0;
  Blocksize_temp = Blocksize_36;
  
  //故障注入：Flash 36驱动下载连续重复发送同一个数据块时需要减小每个块的大小
  if(@Faultinsert::TC_Re_BlockNum_F==1 || @Faultinsert::TC_Exit_in_36_F==1)
    Blocksize_36 = 0x40;
   
  for(countcnt=1;countcnt<=0xFFFF;countcnt++)
  {
    //故障注入：Flash 36驱动下载数据未传输完直接37退出
    if(@Faultinsert::TC_Exit_in_36_F==1)
    {
      Blocksize_36 = 0x80;
      _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
      countcnt++;
      //BYD || 鑫源
      if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5)
      {
        Resp_37_f = 0x24;
        Resp_0202_f = 0x22;
        Exit_0202_f = 1;
        break;
      }
      //奇瑞
      else if(@AUTO::Config_Switch==7)
      {
        Resp_37_f = 0x24;
        Exit_37_f = 1;
        break;
      }
    }
    //故障注入：电压异常测试
    if(@Faultinsert::TC_ErrorVolt!=0 || @Faultinsert::TC_ErrorLowVolt_App == 1 || @Faultinsert::TC_ErrorHighVolt_App == 1)
    {
      if(countcnt == 1)
      {
        //低压刷写
        if(@Prog_power::K30Volt < Low_Volt)
        {
          LowVolt_Resp(curAppValid);
        }
        //高压刷写
        else if(@Prog_power::K30Volt > High_Volt)
        {
          HighVolt_Resp(curAppValid);
        }
      }
      else
      {
        /*APP有效情况下*/
        if(curAppValid==1)
        {
          /*Geely 1.0*/
          if(@AUTO::Config_Switch==3)
          {
            Resp_1002 = 0x22;
            Exit_1002 = 1;
          }
          else
          {
            Resp_36_f = 0x24;
            Exit_36_f = 1;
          }
        }
        /*APP无效情况下*/
        else
        {
          Resp_36_f = 0x24;
          Exit_36_f = 1;
        } 
      }
    }
    remain=length-Blocksize_36*(countcnt-1);
    if(remain<Blocksize_36)
    {
      if(remain==0)
        break;
      _Senddata(req36,remain,countcnt,data36,phyID,Resp_36_f);
      //故障注入：36下载完成后继续发送一个数据块
      if(@Faultinsert::TC_Continue_36_F==1)
      {
        countcnt++;
        END_Pos = 1;
        //奇瑞
        if(@AUTO::Config_Switch==7 || @AUTO::Config_Switch==11)
        {
          Resp_36_f = 0x24;
          Exit_36_f = 1;
        }
        else if(@AUTO::Config_Switch==12)
        {
          Resp_36_f = 0x72;
          Exit_36_f = 1;
        }
        else
        {
          Resp_36_f = 0x31;
          Exit_36_f = 1;
        }
        _Senddata(req36,remain,countcnt,data36,phyID,Resp_36_f);
        return;
      }
      break;
    }
    //故障注入：Flash 36驱动下载连续重复发送同一个数据块
    if(@Faultinsert::TC_Re_BlockNum_F==1 && countcnt==@Test::Block_Num)
    {
      Re_Time++;
      //需求不同：重复多次依旧积极响应
      if(ReBlocknum_Flage==1)
      {
        Resp_36_f = -1;
      }
      //当前重复次数大于最大重复次数
      else if(Re_Time > ReBlocknum_max)
      {
        Resp_36_f = 0x71;
      }
      countcnt = @Test::Block_Num;
      _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
      if(Re_Time < @Test::Re_BlockTime)
        countcnt--;
      //当前重复次数达到预期重复次数
      else if(Re_Time == @Test::Re_BlockTime)
      {
        //需求不同：重复多次依旧积极响应
        if(ReBlocknum_Flage==1)
        {
          @Faultinsert::TC_Re_BlockNum_F = 0;
        }
        //预期重复次数大于最大重复次数
        else if(@Test::Re_BlockTime > ReBlocknum_max)
        {
          Exit_36_f = 1;
          return;
        }
        //预期重复次数小于最大重复次数
        else
        {
          @Faultinsert::TC_Re_BlockNum_F = 0;
        }
      }
    }
    //故障注入：第一个数据块编号不为1
    else if(@Faultinsert::TC_FirstBlockNum_F==1)
    {
      countcnt = @Test::FirstBlock_Num;
      Resp_36_f = 0x73;
      _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
      //鑫源需求规范
      if(@AUTO::Config_Switch==5)
      {
        countcnt = 1;
        Resp_36_f = 0x24;
        _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
      }
      Exit_36_f = 1;
      return;
    }
    //故障注入：数据块编号不连贯
    else if(@Faultinsert::TC_ErrorBlockNum_F==1 && countcnt==@Test::Block_Loc)
    {
      //不同主机厂，刷写规范不同
      if(@AUTO::Config_Switch==1)//BYD
      {
        countcnt = @Test::Block_Num;
        Resp_36_f = 0x73;
        _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
        Exit_36_f = 1;
        return;
      }
      //CA || Geely1.0 || 鑫源 || 瑞驰 || 赛力斯
      else
      {
        if(@Test::Block_Num==@Test::Block_Loc - 1)
        {
          countcnt = @Test::Block_Num;
          _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
          @Faultinsert::TC_ErrorBlockNum_F = 0;
        }
        else
        {
          countcnt = @Test::Block_Num;
          Resp_36_f = 0x73;
          _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
          Exit_36_f = 1;
          return;
        }
      }
    }
    else
      _Senddata(req36,Blocksize_36,countcnt,data36,phyID,Resp_36_f);
    
    if(Break_Download==1)
    {
      break;
    }
  }
  Blocksize_36 = Blocksize_temp;
}
//参数addr:数据下载地址;  data36:数据内容;   length:数据内存大小;
void App_36(dword addr,byte data36[],dword length)
{
  stepnum++;
  snprintf(stepid,elCount(stepid),"步骤%02d：测试36服务APP数据传输",stepnum);
  
  //故障注入：缺失步骤App 36数据传输
  if(@Faultinsert::TC_Miss_36_A==1)
  {
    //BYD || 鑫源 || 五菱  || 赛力斯
    if(@AUTO::Config_Switch==1 || @AUTO::Config_Switch==5
    || @AUTO::Config_Switch==8 || @AUTO::Config_Switch==10)
    {
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Exit_36_a = 0;
      Exit_0202_a = 1;
      Break_Download = 1;
    }
    //ChangAn
    else if(@AUTO::Config_Switch==2)
    {
      Resp_37_a = 0x22;
      Exit_36_a = 0;
      Exit_37_a = 1;
      Break_Download = 1;
    }
    //Geely1.0 || 瑞驰 || 奇瑞 || 小康
    else
    {
      Resp_37_a = 0x24;
      Exit_36_a = 0;
      Exit_37_a = 1;
      Break_Download = 1;
    }
    return;
  }
  //故障注入：低压下载APP
  else if(@Faultinsert::TC_LowVolt_36_A==1)
  {
    if(@AUTO::Config_Switch==1)//BYD
    {
      @Prog_power::K30Volt = 8;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x93;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==2 || @AUTO::Config_Switch==3)//ChangAn || Geely1.0 
    {
      @Prog_power::K30Volt = 8;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x93;
      Resp_37_a = 0x22;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==6)//瑞驰
    {
      @Prog_power::K30Volt = 8;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x93;
      Resp_37_a = 0x24;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else if(@AUTO::Config_Switch==5 || @AUTO::Config_Switch == 8)//鑫源 || 五菱
    {
      @Prog_power::K30Volt = 6;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x93;
      Resp_37_a = 0x22;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    else
    {
      @Prog_power::K30Volt = 8;
      testWaitForTimeout(Volt_Time);
      Resp_36_a = 0x93;
      Resp_37_a = 0x22;
      Resp_0202_a = 0x22;
      Resp_ff01 = 0x22;
      Exit_ff01 = 1;
      Break_Download = 1;
    }
    if(@AUTO::EraseMode_Switch==3 ) //|| @AUTO::Config_Switch ==12
      _Send36_App1(addr,data36,length);
    else
      _Send36_App(addr,data36,length);
  }
  //故障注入：高压下载APP
  else if(@Faultinsert::TC_HighVolt_36_A==1)
  {
