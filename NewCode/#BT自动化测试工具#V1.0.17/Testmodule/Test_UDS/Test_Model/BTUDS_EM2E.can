void Other_GAC_13() /*1002响应后时间测试*/
{
  byte Send_Data_27[2] = {0x27,0x11};
  byte Send_Data_10[2] = {0x10,0x02};
  double Start_Time,End_Time,Change_Time,Count_Time;
  int Response;
  message *Msg;
  message *SendMsg;
  Response = 0;
  SendMsg.dlc = 8;SendMsg.can = 1;
  SendMsg.FDF = 0;SendMsg.id = phyreq_ID;
  SendMsg.byte(0) = 0x02;SendMsg.byte(1) = 0x27;SendMsg.byte(2) = RequestSeed_27;SendMsg.byte(3) = 0x55;
  SendMsg.byte(4) = 0x55;SendMsg.byte(5) = 0x55;SendMsg.byte(6) = 0x55;SendMsg.byte(7) = 0x55;
  
  BUS_loader_H = 80;
  BUS_loader_L = 70;
  count_Bus = 600;
  setTimer(CAN_BUS_loader_L,8);
  testWaitForTimeout(10000);
  _SetSession(exsession);
  testWaitForTimeout(1000);
  _Send_Diag(2,phyreq_ID,Send_Data_10);
  _TestResult(SendData,phyreq_ID,"",-1);
  Start_Time=(double)timeNow()/100;
  do
  {
    output(SendMsg);
    if(testWaitForMessage(Response_ID,p2cmax))
    {
      Response  = 1;testGetWaitEventMsgData(Msg);
    }
    Count_Time = (double)timeNow()/100;
  }while(Response == 0 && (Count_Time-Start_Time<=5000));
  End_Time = (double)timeNow()/100;
  Change_Time = End_Time - Start_Time;
  if(Change_Time > 500)
    testStepFail("","测试时间已超过最大值500ms，当前为 %.2f ms",Change_Time);
  else
    testStepPass("","当前响应时间为 %.2f ms",Change_Time);
  
  if(Response == 1 && Msg.byte(1) == 0x67)
    testStepPass("","收到正响应");
  else
    testStepFail("","诊断命令未收到正响应");
  
  cancelTimer(CAN_BUS_loader_L);
  BUS_loader_H = 95;
  BUS_loader_L = 90;
  count_Bus = 0;
}



