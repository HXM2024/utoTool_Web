_27_Serve_24(dword ID,byte Session)  /*长度不正确的正确秘钥*/
{
  int ServePos,i;
  dword Seed;
  if(_Check_Fun_IDAndSess(0x27,RequestSeed_27,ID,Session) == 1)
  {
    for(i=3;i<=SendKey_Len+1;i++)
    {
      if(i == SendKey_Len)
        continue;
      _Send_Key_(i,ID,_get_seed(ID),-1);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(100);
    }
    
    for(i=2;i<=4;i++)
    {
      _SetSession(exsession);
      _Send_Key_(i*(SendKey_Len-2)+2,ID,_get_seed(ID),-1);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","当前会话下不支持相关子功能,跳过测试(支持的子功能测试中已验证子功能返回情况)");
}
_27_Serve_25(dword ID,byte Session)  /*子功能错误的正确秘钥*/
{
  int ServePos,i,j;
  dword Seed;
  if(_Check_Fun_IDAndSess(0x27,RequestSeed_27,ID,Session) == 1)
  {
    ServePos = _Check_Serve(0x27,0,0);
    for(i=0;i<=0xFF;i++)
    {
      if(_Check_Serve(0x27,i,4) != -1)
        continue;
      _Send_Key_(SendKey_Len,ID,_get_seed(ID),i);
      _TestResult(SendData,ID,"",NRC12);
      testWaitForTimeout(20);
    }
  }
  else
    _WriteEx_and_Report("","当前会话下不支持相关子功能,跳过测试(支持的子功能测试中已验证子功能返回情况)");
}



on timer CAN_BUS_loader_H
{
  int k;
  message * mg1;
  qword ID;
  if((phyreq_ID-0x100)<0)
    ID = 0x001;
  else
    ID = (phyreq_ID-0x100);
  mg1.id  = ID;
  mg1.dlc = 8;
  for(k=0;k<count_Bus;k++)
    output(mg1);
  testWaitForTimeout(100);
  if(canGetBusLoad(1)>BUS_loader_H)
    count_Bus--;
  else if(canGetBusLoad(1)<BUS_loader_L)
    count_Bus++;
  setTimer(CAN_BUS_loader_H,200);
}
on timer CAN_BUS_loader_L
{
  int k;
  message * mg2;
  qword ID;
  if((phyreq_ID+0x100)>0x7FF)
    ID = 0X7FF;
  else
    ID = phyreq_ID+0x100;
  mg2.id  = ID;
  mg2.dlc = 8;
  for(k=0;k<count_Bus;k++)
    output(mg2);
  testWaitForTimeout(100);
  if(canGetBusLoad(1)>BUS_loader_H)
    count_Bus--;
  else if(canGetBusLoad(1)<BUS_loader_L)
    count_Bus++;
  setTimer(CAN_BUS_loader_L,200);
}

on timer Def_TimeCount
{
  Time_Count_Time++;
  setTimer(Def_TimeCount,2000);
}

void Other_GAC_01() /*在引导程序的默认会话下休眠验证-300s内无诊断报文请求*/
{
