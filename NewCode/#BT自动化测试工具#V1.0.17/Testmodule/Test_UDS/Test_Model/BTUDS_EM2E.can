void _27_Serve_08(dword ID,byte session)/*不正确报文对错误计数影响测试*/
{
  byte Temp[2]={0x27,0x01};
  byte Temp_1[6]={0x27,0x01,0x11,0x11,0x11,0x11};
  byte i;
  
  
  _WriteEx_and_Report("","/*----------测试前，错误计数清0--------*/");
  testWaitForTimeout(10000);
  _SetSession(session);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(session);
  testWaitForTimeout(1000);
  
  Temp[1] = RequestSeed_27;
  _Send_Diag(1,ID,Temp);
  _TestResult(SendData,ID,"",NRC13);
  Temp_1[1] = Temp[1] + 0x01;
  _Send_Diag(SendKey_Len+1,ID,Temp_1);
  _TestResult(SendData,ID,"",NRC13);
  
  Temp[1] = RequestSeed_27+0x02;
  if(RequestSeed_27==0x07)
    Temp[1] = 0x01;
  Temp_1[1] = Temp[1] + 0x01;
  _Send_Diag(2,ID,Temp);
  _TestResult(SendData,ID,"",NRC12);
  _Send_Diag(SendKey_Len,ID,Temp_1);
  _TestResult(SendData,ID,"",NRC12);
  
  for(i=1;i<Error_Count;i++)
  {
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    Get_Seed_Flage = 1;
  }
  diagStartTesterPresent(Cdd_Name);
  testWaitForTimeout(Error_Count_Delay*1.1+1000);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  if(diagGetLastResponseCode(SendData)==-1)
    testStepPass("","收到正响应");
  else
  {
    testStepFail("","未收到正响应");
    testWaitForTimeout(10000);
  }
}
void _27_Serve_09(dword ID,byte session)/*解锁情况下再次请求种子*/
{ 
  byte Temp[2] = {0x27,0x01};
  int i,flage;
  qword seed;
  flage = 0;
  
  if(_Check_Serve_IDAndSess(0x27,ID,session)!= -1)
  {
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
    seed = _get_seed(ID);
    for(i=2;i<DiagGetRespPrimitiveSize(SendData);i++)
    {
      if(DiagGetRespPrimitiveByte(SendData,i) != 0)
        flage = 1;
    }
    if(flage == 0)
      testStepPass("","通过安全访问后，再次请求种子则种子返回全0");
    else
      testStepFail("","通过安全访问后，再次请求种子存在非0值");
    _Send_Key(SendKey_Len,ID,seed,0);
    _TestResult(SendData,ID,"",NRC24);
    
    testWaitForTimeout(Error_Count_Delay*1.1);
    _SetSession(session);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
  }
}
void _27_Serve_10(dword ID,byte session)/*满延时错误计数器变化测试*/
{
  int i;
  dword seed;
  diagStartTesterPresent(Cdd_Name);
  
  _WriteEx_and_Report("","/*----------测试前，错误计数清0--------*/");
  testWaitForTimeout(10000);
  _SetSession(session);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(session);
  testWaitForTimeout(1000);
    
  _Check_Error_Count(ID,0);
  seed = _get_seed(ID);
  _TestResult(SendData,ID,"",NRC37);
  testWaitForTimeout(Error_Count_Delay+3000);
  if(Error_Count_Change==1)
  {
    _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
    _TestResult(SendData,ID,"",NRC36);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
  }
  else if(Error_Count_Change==0)
  {
    _Check_Error_Count(ID,0);
    seed = _get_seed(ID);
    _TestResult(SendData,ID,"",NRC37);
    _Send_Key(SendKey_Len,ID,seed,1);
    _TestResult(SendData,ID,"",NRC24);
  }
  if((strncmp(ECU_project,"Seres",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Seres"))|| @AUTO::Config_Switch == 10)
  {
    testWaitForTimeout(100000);
  }
  testWaitForTimeout(Error_Count_Delay+3000);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
}
