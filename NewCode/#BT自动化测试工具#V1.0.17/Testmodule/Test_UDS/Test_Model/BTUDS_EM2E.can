    _Set_NRC_Step(0x85,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
      
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x85 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[0]);
}

void _28_Serve_01(dword ID,byte session)/*NRC7F>13*/
{
  byte Send_Data[3] = {0x28,0x00,0x03};
  int i,Serve_Pos,j;
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess_(0x28,ID,session) != -1)
  {
    for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[i];
      for(j=0;j<Serve_Data[Serve_Pos].Serve_Para_Count[i];j++)
      {
        Send_Data[2] = Serve_Data[Serve_Pos].Serve_Para[i][j];
        _Send_Diag(4,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC7F);
      }
    }
  }
  else
    _WriteEx_and_Report("","当前会话下支持相关子功能,跳过测试");
}
void _28_Serve_02(dword ID,byte session)/*子功能及肯定响应抑制位*/
{
  byte Send_Data[20];
  int i,n,flage,len,Poss;
  byte Size_Para;
  if(_Check_Serve_IDAndSess(0X28,ID,session) == 1)
  {
    _Step_Serve_Fun(0X28,ID,session);
  }
}
void _28_Serve_03(dword ID,byte session)/*NRC13*/
{
  byte Send_Data[3] = {0x28,0x03,0x03};
  int Len;
  int i;
  Len = _Check_CANFD_Flage();
  if(_Check_Serve_IDAndSess(0x28,ID,session) == 1)
  {
    for(i=1;i<=Len;i++)
    {
      if(i==0x03)
        continue;
      _Send_Diag(i,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC13);
      testwaitfortimeout(200);
    }
  }
}
void _28_Serve_04(dword ID,byte session)/*NRC12*/
{
  byte Send_Data[3] = {0x28,0x03,0x03};
  int i,Fun_Poss,Serve_Poss;
  if(_Check_Serve_IDAndSess(0x28,ID,session) == 1)
  {
    Serve_Poss = _Check_Serve(0x28,0,0);
    Send_Data[2] = Serve_Data[Serve_Poss].Serve_Para[0][0];
    for(i=0;i<=0xff;i++)
    {
      Send_Data[1] = i;
      if((_Check_Serve(0x28,i,4)!= -1) || (_Check_Serve(0x28,i&0x7F,4)!= -1))
        continue;
      _Send_Diag(3,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC12);
      testwaitfortimeout(200);
    }
  }
}
void _28_Serve_05(dword ID,byte session)/*NRC31*/
{
  byte Send_Data[3] = {0x28,0x03,0x03};
  int i,Serve_Poss;
  if(_Check_Serve_IDAndSess(0x28,ID,session) == 1)
  {
    Serve_Poss = _Check_Serve(0x28,0,0);
    Send_Data[1] = Serve_Data[Serve_Poss].Serve_Fun[0];
    for(i=0;i<=0xff;i++)
    {
      Send_Data[2] = i;
      if(_Check_Para(Serve_Poss,0,Send_Data,3)!= -1)
        continue;
      _Send_Diag(3,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC31);
      testwaitfortimeout(200);
    }
  }
}

void _28_Serve_NRC(dword ID,byte session)/*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[50];
  
  Serve_Pos = _Check_Serve(0x28,0,0);
  if(_Check_Serve_IDAndSess(0x28,ID,session) == 1)
  {
    Send_Data[0] = 0x28;
    _Set_NRC_Step(0x28,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
      
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x28 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[0]);
}

void _34_Serve_01(dword ID,byte session)/*NRC7F*/
{
  byte Send_Data[10] = {0x34,0x00,0x44,0x80,0x03,0x00,0x00,0x00,0x01,0x00};
  _Send_Diag(0x0A,ID,Send_Data);
  _TestResult(SendData,ID,"",NRC7F);  //默认会话
}
void _34_Serve_02(dword ID,byte session)/*NRC22/24*/
{
  int Serve_Poss;
  byte Send_Data[20];
  if(_Check_Serve_IDAndSess(0x34,ID,session) != -1)
  {
    Serve_Poss = _Check_Serve(0x34,0,0);
    if(@AUTO::Config_Switch == 12)
      _Get_Serve_INI(Send_Data,0x34,Serve_Poss,4);
    else
      _Get_Serve_INI(Send_Data,0x34,Serve_Poss,0);
    if(Serve_Data[Serve_Poss].Security_Access[0] == 1)
      _unlockECU();
    _Send_Diag(BT_34_Len,ID,Send_Data);
//    _TestResult(SendData,ID,"",Serve_Data[Serve_Poss].Serve_NRC[0][Serve_Data[Serve_Poss].Serve_NRC_Count[0]-1]);
    if(@AUTO::Config_Switch == 4)
      _TestResult(SendData,ID,"",NRC24);
    else
      _TestResult(SendData,ID,"",NRC22);
  }
}
void _34_Serve_03(dword ID,byte session)/*NRC13*/
{
  int Serve_Poss;
  byte Send_Data[20];
  if(_Check_Serve_IDAndSess(0x34,ID,session) != -1)
  {
    Serve_Poss = _Check_Serve(0x34,0,0);
    Send_Data[0] = 0X34;
    _Get_Serve_INI(Send_Data,0x34,Serve_Poss,0);
    if(Serve_Data[Serve_Poss].Security_Access[0] == 1)
      _unlockECU();
    for(i=1;i<=64;i++)
    {
      if(i==BT_34_Len)
        continue;
      _Send_Diag(i,ID,Send_Data);
      if(i<=3)
        _TestResult(SendData,ID,"",_Get_NRC_Input(0x31,0x13,0x34,0));
      else
        _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(200);
    }
  }
}
void _34_Serve_04(dword ID,byte session)/*NRC33*/
{
  int Serve_Poss;
  byte Send_Data[20];
  if(_Check_Serve_IDAndSess(0x34,ID,session) != -1)
  {
    Serve_Poss = _Check_Serve(0x34,0,0);
    if(Serve_Data[Serve_Poss].Security_Access[0] == 0)
    {
      _WriteEx_and_Report("","无需安全访问");
      return;
    }
    Send_Data[0] = 0X34;
    _Get_Serve_INI(Send_Data,0x34,Serve_Poss,0);
    _Send_Diag(BT_34_Len,ID,Send_Data);
    _TestResult(SendData,ID,"",NRC33);
  }
}
void _34_Serve_05(dword ID,byte session)/*NRC31*/
{
  int Serve_Poss;
  byte Send_Data[50];
  if(_Check_Serve_IDAndSess(0x34,ID,session) != -1)
  {
    Serve_Poss = _Check_Serve(0x34,0,0);
    Send_Data[0] = 0X34;
    _Get_Serve_INI(Send_Data,0x34,Serve_Poss,0);
    testWaitForTimeout(1000);
    if(Serve_Data[Serve_Poss].Security_Access[0] == 1)
      _unlockECU();
    _Send_Diag(BT_34_Len,ID,Send_Data);
    _TestResult(SendData,ID,"",NRC22);
//    _Get_Serve_INI(Send_Data,0x34,Serve_Poss,0);
    if(Serve_Data[Serve_Poss].Serve_Para_Len[0][0]>=1)
    {
      Send_Data[1] = Serve_Data[Serve_Poss].Serve_Para[0][0]+1;
      _Send_Diag(BT_34_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC31);
      
      Send_Data[1] = Serve_Data[Serve_Poss].Serve_Para[0][0];
      Send_Data[2] = Serve_Data[Serve_Poss].Serve_Para[0][1]-1;
      _Send_Diag(BT_34_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC31);

      Send_Data[2] = Serve_Data[Serve_Poss].Serve_Para[0][1];
      _Get_Serve_INI(Send_Data,0x34,Serve_Poss,1);
      _Send_Diag(BT_34_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC31);

      _Get_Serve_INI(Send_Data,0x34,Serve_Poss,2);
      _Send_Diag(BT_34_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC31);
      
    }
  }
}
void _34_Serve_06(dword ID,byte session)/*驱动地址NRC优先级*/
{
  int Serve_Pos,i,j;
  byte Send_Data[50];
  Send_Data[0] = 0x34;
  NRC_For34_FlashDrv = 1;
  Serve_Pos = _Check_Serve(0x34,0,0);
  Send_Data[1] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  Send_Data[2] = Serve_Data[Serve_Pos].Serve_Para[0][1];
  _Get_Serve_INI(Send_Data,0x34,Serve_Pos,7);
  if(_Check_Serve_IDAndSess(0x34,ID,session) == 1)
  {
    _Set_NRC_Step(0x34,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
        if(Fun_NRC[i-1] == 0x31 && NRC31_total ==1)
          _Get_Serve_INI(Send_Data,0x34,Serve_Pos,4);
      }

      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x34 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Para[0][0]);
  
  NRC_For34_FlashDrv = 0;
}

void _34_Serve_07(dword ID,byte session)/*APP地址NRC优先级*/
{
  int Serve_Pos,i,j;
  byte Send_Data[50];
  int Skip_Recover = 0;
  Send_Data[0] = 0x34;

  Serve_Pos = _Check_Serve(0x34,0,0);
  Send_Data[1] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  Send_Data[2] = Serve_Data[Serve_Pos].Serve_Para[0][1];
//  _Get_Serve_INI(Send_Data,0x34,Serve_Pos,3);
  if(_Check_Serve_IDAndSess(0x34,ID,session) == 1)
  {
    _Set_NRC_Step(0x34,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      if(i>0 && Skip_Recover == 0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);      
      }
      Skip_Recover = 0;
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      if(i > 0 && Fun_NRC[i] == 0x31 && NRC31_total ==1 && NRC34_31Count < 2)
      { 
        _Recover_NRC_Step(Fun_NRC[i],Serve_Pos,0,Send_Data);
        Skip_Recover = 1;
        i--;
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x34 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Para[0][0]);
}

void _34_Serve_06_GAC(dword ID,byte session)/*驱动地址NRC优先级*/
{
  int Serve_Pos,i,j;
  byte Send_Data[50];
  Send_Data[0] = 0x34;
  NRC_For34_FlashDrv = 1;
  Serve_Pos = _Check_Serve(0x34,0,0);
  Send_Data[1] = Serve_Data[Serve_Pos].Serve_Para[0][0];
  Send_Data[2] = Serve_Data[Serve_Pos].Serve_Para[0][1];
  _Get_Serve_INI(Send_Data,0x34,Serve_Pos,7);
  if(_Check_Serve_IDAndSess(0x34,ID,session) == 1)
  {
    Send_Data[0] = 0x34;Send_Data[1] = 0x01;Send_Data[2] = 0x44;
    for(i=3;i<=0x0C;i++)
      Send_Data[i] = 0xFF;
    _Send_Diag(2,ID,Send_Data);
    _TestResult(SendData,ID,"",0x33);
    _unlockECU();
    Send_Data[2] = 0x43;
    _Send_Diag(0x0A,ID,Send_Data);
    _TestResult(SendData,ID,"",0x13);
    _Send_Diag(0x0C,ID,Send_Data);
    _TestResult(SendData,ID,"",0x31);
    Send_Data[1] = 0;
    Send_Data[2] = 0x44;
    _Send_Diag(0x0C,ID,Send_Data);
    _TestResult(SendData,ID,"",0x13);
    _Get_Serve_INI(Send_Data,0x34,Serve_Pos,5);
    _Send_Diag(0x0B,ID,Send_Data);
    _TestResult(SendData,ID,"",0x31);
    _Get_Serve_INI(Send_Data,0x34,Serve_Pos,6);
    _Send_Diag(0x0B,ID,Send_Data);
    _TestResult(SendData,ID,"",0x31);
    _Get_Serve_NRC31(Send_Data[0],1,Send_Data);
    _Send_Diag(0x0B,ID,Send_Data);
    _TestResult(SendData,ID,"",0x22);
  }
  else
    _WriteEx_and_Report("","0x34 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Para[0][0]);
  
  NRC_For34_FlashDrv = 0;
}



void _36_Serve_01(dword ID,byte session)/*NRC7F*/
{
  byte Send_Data[100];
  int Serve_Poss;
  Send_Data[0] = 0X36;
  if(_Check_Serve_IDAndSess(0x36,ID,session)!= 1)
  {
    Serve_Poss = _Check_Serve(0x36,0,0);
    testWaitForTimeout(500);
    _Send_Diag(Serve_Data[Serve_Poss].Serve_Fun_Len[0],ID,Send_Data);
    _TestResult(SendData,ID,"",NRC7F);  //功能寻址不支持流控帧,可能存在无流控帧现象
  }
}
void _36_Serve_03(dword ID,byte session)/*NRC13*/
{
  byte Send_Data[100];
  int Serve_Poss,i;
  _Clear_SendData(Send_Data);
  Send_Data[0] = 0X36;
  if(_Check_Serve_IDAndSess(0x36,ID,session)!= -1)
  {
    Serve_Poss = _Check_Serve(0x36,0,0);
    if(Serve_Data[Serve_Poss].Security_Access[0] == 1)
      _unlockECU();
    for(i=1;i<=2;i++)
    {
      if(i==Serve_Data[Serve_Poss].Serve_Fun_Len[0])
        continue;
      _Send_Diag(i,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC13);
    }
  }
}
void _36_Serve_NRC(dword ID,byte session)/*NRC优先级*/
{
  int Serve_Pos,i,j;
  byte Send_Data[50];
  Send_Data[0] = 0x36;
  Send_Data[1] = 0x01;
  for(i=1;i<0x0C;i++)
  {
    j = i%10;
    if(i >= 5) j = (i+1)%10;
      Send_Data[i+1] = j*16 + j;
  }
  Send_Data[0x0C] = 0;
  Serve_Pos = _Check_Serve(0x36,0,0);
  if(_Check_Serve_IDAndSess(0x36,ID,session) == 1)
  {

    _Set_NRC_Step(0x36,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(Fun_NRC[i] == 0x22 || Fun_NRC[i] == 0x24) Fun_NRC_Send_Len = 0x0c;
      if( i > 0 && (Fun_NRC[i - 1] == 0x22 || Fun_NRC[i - 1] == 0x24)) break;
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x36 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[0]);
}

