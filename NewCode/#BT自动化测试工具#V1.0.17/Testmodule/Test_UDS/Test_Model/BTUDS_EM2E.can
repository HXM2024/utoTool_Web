void _27_Serve_13(dword ID,byte session)/*检测安全访问解锁状态*/
{
  byte Send_Data[50],Pro[2] = {0x10,0x02};
  qword Seed,Seed1;
  int i,n,len,flage;
  flage = 0;
  if(_Check_Serve_IDAndSess(0x27,ID,session)!= -1)
  {
    if(session == exsession)
      len=4;
    else 
      len = 3;
    for(n=1;n<len;n++)
    {
      if(n != 1)
        _SetSession(session);
      Seed = _get_seed(ID);
      _Send_Key(SendKey_Len,ID,Seed,0);
      _TestResult(SendData,ID,"",-1);
      if(n==2 && session ==exsession)
      {
        if(Pre_Programmed_1002 == 1)
          UpdateCheck(phyreq_ID,-1);
        _Send_Diag(2,phyreq_ID,Pro);
      }
      else
      {
        if(n==1)
          _SetSession(defsession);
        _SetSession(session);
      }
      Seed1 = _get_seed(ID);
      _Send_Key(SendKey_Len,ID,Seed1,0);
      _TestResult(SendData,ID,"",-1);
      if(AES_128 == 0)
      {
        if(Seed == Seed1)
          testStepFail("","两次请求返回的种子一致");
        else
          testStepPass("","两次请求返回的种子不同");
      }
      else
      {
        for(i=0;i<16;i++)
        {
          if(Seed_Count_List_AES128[0][i] != Seed_Count_List_AES128[1][i])
          {
            flage = 1;
            break;
          }
        }
        if(flage == 0)
          testStepFail("","两次请求返回的种子一致");
        else
          testStepPass("","两次请求返回的种子不同");
      }
      _Clear_Seed();
    }
  }
}
void _27_Serve_14(dword ID,byte session)/*连续请求种子*/
{
  word seed;
  int Count;
  diagStartTesterPresent(Cdd_Name);
  if(Request_Error_Count==1)
  {
    if(ReqSeed_Count == 1)
    {
      for(i=1;i<Error_Count;i++)
      {
        _get_seed(ID);
        _TestResult(SendData,ID,"",-1);
        Get_Seed_Flage = 1;
      }
      _Check_Repeat(Error_Count);
      _get_seed(ID);
      _TestResult(SendData,ID,"",NRC36);
      _get_seed(ID);
      _TestResult(SendData,ID,"",NRC37);
      testWaitForTimeout(Error_Count_Delay*1.1);
      for(i=1;i<Error_Count;i++)
      {
        _get_seed(ID);
        _TestResult(SendData,ID,"",-1);
        Get_Seed_Flage = 1;
      }
      _Check_Repeat(Error_Count);
      _get_seed(ID);
      _TestResult(SendData,ID,"",NRC36);
      testWaitForTimeout(Error_Count_Delay*1.1);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
    }
    else
    {
      for(i=1;i<Error_Count+2;i++)
      {
        _get_seed(ID);
        _TestResult(SendData,ID,"",-1);
        Get_Seed_Flage = 1;
      }
      _Check_Repeat(Error_Count);
      _get_seed(ID);
      _TestResult(SendData,ID,"",NRC37);
      if(Error_Count_Change==1)
      {
        testWaitForTimeout(Error_Count_Delay+3000);
        for(i=0;i<2;i++)
        {
          _get_seed(ID);
          _TestResult(SendData,ID,"",-1);
        }
        _get_seed(ID);
        _TestResult(SendData,ID,"",NRC37);
      }
      else if(Error_Count_Change==0)
      {
       for(i=1;i<Error_Count+2;i++)
        {
          _get_seed(ID);
          _TestResult(SendData,ID,"",-1);
        }
        _Check_Repeat(Count-1);
        _get_seed(ID);
        _TestResult(SendData,ID,"",NRC37);
      }
      testWaitForTimeout(Error_Count_Delay+3000);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
    }
  }
  else if(Request_Error_Count==0)
  {
    for(i=0;i<=Error_Count+3;i++)
    {
      _get_seed(ID);
      _TestResult(SendData,ID,"",-1);
      Get_Seed_Flage = 1;
    }
    _Check_Error_Count(ID,0);
    testWaitForTimeout(Error_Count_Delay+3000);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
  }
}
void _27_Serve_15(dword ID,byte session)/*10s延时时间测试*/
{
  byte Send_Data[50];
  if(_Check_Serve_IDAndSess(0x27,ID,session)!= -1)
  {
    double starttime;
    double endtime;
    double Change_Time;
    double CountTime;
    int i;
    i=0;
 
    _WriteEx_and_Report("","/*----------测试前，错误计数清0--------*/");
    testWaitForTimeout(10000);
    _SetSession(session);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
    testWaitForTimeout(1000);
    _SetSession(session);
    testWaitForTimeout(1000);
    
    do{
      _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
      i++;
    }while((diagGetLastResponseCode(SendData)!=NRC36) && i<=Error_Count+10);
    Get_Seed_Flage = 1;
    starttime=(double)timeNow()/100;
    
    do
    {
      _get_seed(ID);
      CountTime = (double)timeNow()/100;
    }while((diagGetLastResponseCode(SendData)!=-1) && (CountTime - starttime)<=15000); 
    endtime=(double)timeNow()/100;
    Change_Time = endtime-starttime;
    if((CountTime - starttime)>=15000)
      _WriteEx_and_Report("","长时间未收到正响应,提前终止防止卡死");
    writeEx(-3,0," 当前从NRC36到正常响应种子时间为 %.2f ms ",Change_Time);
    if(Error_Count_Delay - Error_Count_Delay_Tolerance<=Change_Time && Change_Time<=Error_Count_Delay + Error_Count_Delay_Tolerance)
      testStepPass("","当前从NRC36到正常响应种子时间为 %.2f ms",Change_Time);
    else
      testStepFail("","当前从NRC36到正常响应种子时间为 %.2f ms",Change_Time);
    testWaitForTimeout(Error_Count_Delay+3000);
    _SetSession(exsession);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  }
}
_27_Serve_16(dword ID,byte Session)  /*连续重复请求种子验证重复率*/
{
  qword i;
  diagStartTesterPresent(Cdd_Name);
  _Set_Ready(0);
  testWaitForTimeout(2000);
  if(Request_Error_Count == 0 && Request_Seed_Consistency == 0)
  {
    if(AES_128 != 0)      //AES-128算法要求请求种子具备随机性
    {
      for(i=0;i<Request_Seed_Count;i++)
      {
        _get_seed(ID);
        Get_Seed_Flage = 1;
        testWaitForTimeout(200);
        writeEx(-3,0,"当前测试次数 %d 次",i+1);
        if(i%100==0 && i!=0)
        {
          _K15_OFF();
          testWaitForTimeout(1000);
          _K15_ON();
          _SetSession(Session);
        }
        testWaitForTimeout(200);
      }
    }
    else
    {
      for(i=0;i<Request_Seed_Count;i++)
      {
        writeEx(-3,0,"当前测试次数 %d 次",i+1);
        _get_seed(ID);
        Get_Seed_Flage = 1;
        if(i==(word)random(Request_Seed_Count))
        {
          _K15_OFF();
          testWaitForTimeout(1000);
          _K15_ON();
          _SetSession(exsession);
        }
        testWaitForTimeout(200);
      }
    }
    testWaitForTimeout(2000);
    _Check_Repeat(Request_Seed_Count,1);
  }
  else
    _WriteEx_and_Report("","连续请求种子错误计数器累加或种子一致,跳过测试");
}

_27_Serve_17(dword ID,byte Session)  /*支持的子功能测试*/
{
  int ServePos,i,Flage_Add;
  byte Send_Data[20];
  
  ServePos = _Check_Serve(0x27,0,0);
  Send_Data[0] = 0x27;
  diagStartTesterPresent(Cdd_Name);
  for(i=0;i<Serve_Data[ServePos].Serve_Fun_Count;i++)
  {
    Send_Data[1] = Serve_Data[ServePos].Serve_Fun[i];
    Flage_Add = _Check_Fun_IDAndSess(0x27,Send_Data[1],ID,Session);
    _Send_Diag(Serve_Data[ServePos].Serve_Fun_Len[i],ID,Send_Data);
    if(Flage_Add == 1)
    {
      if(Serve_Data[ServePos].Serve_Fun_Len[i] == 2)  //使用长度进行判断,仅当长度为2时确认发送为请求种子
        _TestResult(SendData,ID,"",-1);
      else
        _TestResult(SendData,ID,"",0x35);
    }
    else
      _TestResult(SendData,ID,"",0x7E);
    
    _WriteEx_and_Report("","此处对肯定响应抑制位进行测试");
    if(Serve_Data[ServePos].RSP[i] == 1)
    {
      _Send_Diag(Serve_Data[ServePos].Serve_Fun_Len[i],ID,Send_Data);
      if(Serve_Data[ServePos].Serve_Fun_Len[i] == 2)  //使用长度进行判断,仅当长度为2时确认发送为请求种子
        _TestResult(SendData,ID,"",-1);
      else
        _TestResult(SendData,ID,"",0x35);
    }
    else
      _TestResult(SendData,ID,"",0x12);
  }
  
  _WriteEx_and_Report("","/*----------测试后，错误计数清0--------*/");
  testWaitForTimeout(Error_Count_Delay*1.1);
  _SetSession(prosession);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
}

_27_Serve_18(dword ID,byte Session)  /*解锁后计数器清零*/
{
  int i;
  dword seed;
  
  diagStartTesterPresent(Cdd_Name);
  if(_Check_Fun_IDAndSess(0x27,RequestSeed_27,ID,Session) == 1)
  {
    for(i=1;i<5;i++)
    {
      if(i == 1)
        _WriteEx_and_Report("","错误计数器累加,正常解锁");
      else if(i == 2)
      {
        _WriteEx_and_Report("","会话切换");
        _SetSession(defsession);
        testWaitForTimeout(1000);
        _SetSession(Session);
        testWaitForTimeout(1000);
      }
      else if(i == 3)
      {
        _WriteEx_and_Report("","11复位");
        _Set_11_Restoration(0);
        _SetSession(Session);
        testWaitForTimeout(1000);
      }
      else if(i == 4)
      {
        _WriteEx_and_Report("","正常上下电");
        _K15_OFF();
        _K30_OFF();
        testWaitForTimeout(2000);
        _K30_ON();
        _K15_ON();
        testWaitForTimeout(2000);
        _SetSession(Session);
        testWaitForTimeout(1000);
      }
      _Check_Error_Count(ID,1);
      if(i<4)
        _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      else
      {
        _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
        _TestResult(SendData,ID,"",NRC36);
        seed = _get_seed(ID);
        _TestResult(SendData,ID,"",NRC37);
        _Send_Key(SendKey_Len,ID,seed,1);
        _TestResult(SendData,ID,"",NRC24);
        testWaitForTimeout(Error_Count_Delay*1.1);
        _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      }
      testWaitForTimeout(500);
    }
  }
  else
    _WriteEx_and_Report("","当前会话下不支持相关子功能,跳过测试(支持的子功能测试中已验证子功能返回情况)");
}
_27_Serve_19(dword ID,byte Session)  /*已解锁状态-上下电/11复位*/
{
  int i;
  
  if(_Check_Fun_IDAndSess(0x27,RequestSeed_27,ID,Session) == 1)
  {
    for(i=0;i<Serve_11_Unlock_Count;i++)
    {
      _WriteEx_and_Report("","当前测试次数 %d",i+1);
      _SetSession(Session);
      testWaitForTimeout(1000);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
      {
        _K15_OFF();
        _K30_OFF();
        testWaitForTimeout(2000);
        _K30_ON();
        _K15_ON();
        testWaitForTimeout(2000);
      }
      _SetSession(Session);
      testWaitForTimeout(1000);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
      _Set_11_Restoration(0);
      _SetSession(Session);
      testWaitForTimeout(1000);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
      _TestResult(SendData,ID,"",-1);
    }
    _Check_Repeat(Serve_11_Unlock_Count,1);
  }
  else
    _WriteEx_and_Report("","当前会话下不支持相关子功能,跳过测试(支持的子功能测试中已验证子功能返回情况)");
}

_27_Serve_20(dword ID,byte Session)  /*已解锁状态-会话切换*/
{
  byte Send_Data[2] = {0x10,0x02};
  if(_Check_Fun_IDAndSess(0x27,RequestSeed_27,ID,Session) == 1)
  {
    _Check_Error_Count(ID,1);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
    _SetSession(defsession);
    _SetSession(Session);
    _Check_Error_Count(ID,1);
    _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    _TestResult(SendData,ID,"",-1);
    if(Session == prosession)
    {
      _Send_Diag(2,ID,Send_Data);
      _TestResult(SendData,ID,"",-1);
      testWaitForTimeout(1000);
      _Check_Error_Count(ID,1);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    }
    _SetSession(defsession);
  }
  else
    _WriteEx_and_Report("","当前会话下不支持相关子功能,跳过测试(支持的子功能测试中已验证子功能返回情况)");
}
_27_Serve_21(dword ID,byte Session)  /*未解锁状态-11复位*/
{
  byte Send_Data[2] = {0x10,0x02};
  int ServePos,i,j,Max_Count,Res11;
  dword Seed;
  byte Send_11[2];
  if(_Check_Fun_IDAndSess(0x27,RequestSeed_27,ID,Session) == 1)
  {
    if(((_Check_Serve(0x10,0x02,5)==1) || ( (Pre_Programmed_UnlockECU==1) && (Pre_Programmed_1002==1))) && Session == prosession)
      _WriteEx_and_Report("","进入编程会话需要安全访问,与用例需求不符，跳过测试");
    else
    {
      ServePos = _Check_Serve(0x11,0,0);
      if(Serve_Data[ServePos].Security_Access[0] != 1)
      {
        Max_Count = 1;
        if(Serve_Data[ServePos].RSP[0]==1)
          Max_Count = 2;
        Send_11[0] = 0x11;
        Send_11[1] = Serve_Data[ServePos].Serve_Fun[0];
        diagStartTesterPresent(Cdd_Name);
        for(j=0;j<Max_Count;j++)
        {
          if(j==0)
          {
            Res11 = -1;
            Send_11[1] = Serve_Data[ServePos].Serve_Fun[0];
          }
          else
          {
            _SetSession(Session);
            Res11 = 0;
            Send_11[1] = (Serve_Data[ServePos].Serve_Fun[0]|0x80);
            _WriteEx_and_Report("","测试11复位肯定响应抑制位");
          }
          if(Restoration_Error_Count == 1)//复位或重启会重置计数器
            _Check_Error_Count(ID,0);
          else
          {
            for(i=0;i<Error_Count-1;i++)
            {
              _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
              _TestResult(SendData,ID,"",0x35);
      			  _Send_Diag(2,phyreq_ID,Send_11);
      			  _TestResult(SendData,phyreq_ID,"",Res11);
      			  testWaitForTimeout(2000); /*11复位后增加延时时间防止后续出错*/
              _SetSession(Session);
              testWaitForTimeout(2000);
            }
            _Send_Key(SendKey_Len,ID,_get_seed(ID),1);
            _TestResult(SendData,ID,"",0x36);
          }
          Seed = _get_seed(ID);
          _TestResult(SendData,ID,"",0x37);
          testWaitForTimeout(Error_Count_Delay*0.5);
          _Send_Diag(2,phyreq_ID,Send_11);
          _TestResult(SendData,phyreq_ID,"",Res11);
          testWaitForTimeout(2000);
          _SetSession(Session);
          testWaitForTimeout(1000);
          Seed = _get_seed(ID);
          _TestResult(SendData,ID,"",0x37);
          _Send_Key(SendKey_Len,ID,Seed,1);
          _TestResult(SendData,ID,"",0x24);
          testWaitForTimeout(Error_Count_Delay*0.6-1000);
          if(Error_Count_Delay_Reset == 1) //复位需要重新启动延时时间 
          {
            Seed = _get_seed(ID);
            _TestResult(SendData,ID,"",0x37);
            _Send_Key(SendKey_Len,ID,Seed,1);
            _TestResult(SendData,ID,"",0x24);
            testWaitForTimeout(Error_Count_Delay*0.5);
          }
          Seed = _get_seed(ID);
          _TestResult(SendData,ID,"",-1);
          _Send_Key(SendKey_Len,ID,Seed,0);
          _TestResult(SendData,ID,"",-1);
        }
      }
      else
        _WriteEx_and_Report("","11服务需要安全访问与用例需求不符,跳过测试");
    }
  }
  else
    _WriteEx_and_Report("","当前会话下不支持相关子功能,跳过测试(支持的子功能测试中已验证子功能返回情况)");
}
_27_Serve_22(dword ID,byte Session)  /*未解锁状态-上下电*/
{
