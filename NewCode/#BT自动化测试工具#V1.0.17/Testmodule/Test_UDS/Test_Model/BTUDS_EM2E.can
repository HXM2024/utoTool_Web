includes
{
  #include "..\Library\Function.can"
  #include "..\Library\TP_Function.cin"
  
}

variables
{
  mstimer CAN_BUS_loader_H;
  mstimer CAN_BUS_loader_L;
  mstimer Time_Count;
  mstimer Def_TimeCount;
  qword count_Bus;
  int Time_Flage =0;
  int Time_Count_Time;
  
  byte NRC13 = 0x13;
  byte NRC31 = 0x31;
  byte NRC22 = 0x22;
  byte NRC7E = 0x7E;
  byte NRC7F = 0x7F;
  byte NRC11 = 0x11;
  byte NRC12 = 0x12;
  byte NRC78 = 0x78;
  byte NRC33 = 0x33;
  byte NRC24 = 0x24;
  byte NRC35 = 0x35;
  byte NRC36 = 0x36;
  byte NRC37 = 0x37;
  byte NRC72 = 0x72;
  char Temp_Log_Name[200];
}
on timer Time_Count
{
  testWaitForTimeout(Time_Count_Time);
  Time_Flage =1;
}

_High_BUS_loader_H_2(byte type,dword Time)/*写DID*//*0:干扰报文优先级高于发送ID，1:干扰报文优先级低于发送ID*/
{
  diagSetTarget(Cdd_Name);
  _get_Str_Traversal("DID_2E_Traversal");
  _get_2E_DID(Traversal_DID[0]);
  Time_Count_Time = 20*60*1000;
  setTimer(Time_Count,Time_Count_Time);  
  if(type==0 )
    setTimer(CAN_BUS_loader_H,8);
  else 
    setTimer(CAN_BUS_loader_L,8);
  testWaitForTimeout(10000);
  do{
    _SetSession(exsession);
    _unlockECU();
    Get_Seed_Flage = 1;
    _Send_Diag(DID_2E_SendData_1_Len,phyreq_ID,DID_2E_SendData_1,Time);
    _TestResult(SendData,phyreq_ID,"",DID_2E_SendData_1_Response);
    if(DID_2E_SendData_1_Response == -1 && Support_Read_2E_DID == 1)
    {
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID,Time);
      _Check_Response_2E(SendData,DID_2E_SendData_1_Len,DID_2E_SendData_1);
    }
    else
      _WriteEx_and_Report("","期望结果为非正响应,不检测写入数据");
    testWaitForTimeout(100);
    
    _Send_Diag(DID_2E_SendData_2_Len,phyreq_ID,DID_2E_SendData_2,Time);
    _TestResult(SendData,phyreq_ID,"",DID_2E_SendData_2_Response);
    
    if(DID_2E_SendData_2_Response == -1 && Support_Read_2E_DID == 1)
    {
      _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID,Time);
      _Check_Response_2E(SendData,DID_2E_SendData_2_Len,DID_2E_SendData_2);
    }
    else
      _WriteEx_and_Report("","期望结果为非正响应,不检测写入数据");
    testWaitForTimeout(100);
  }while(Time_Flage==0);
  if(type==0 )
    cancelTimer(CAN_BUS_loader_H);
  else 
    cancelTimer(CAN_BUS_loader_L);
  cancelTimer(Time_Count);
}
void _10_Phy_01(dword ID,byte Session)
{
  byte Temp_0[2]={0x10,0x01};
  _Send_Diag(2,ID,Temp_0);
  if((strncmp(ECU_project,"Chery",strlen("Chery")) == 0 )|| @AUTO::Config_Switch == 7)
    _TestResult(SendData,ID,"",-1);
  else
    _Check_10_01(Resp_10_len[0],Temp_0[1],P2can_server,P2_can_server);
  _Send_And_Check_NowSession(ID,defsession);
}

void _10_Phy_Def_02(dword ID,byte Session)
{
  byte Temp_0[2]={0x10,0x2};
  int Fun_Pos;
  Fun_Pos = _Check_Serve(0x10,0x02,4);
  if(Fun_Pos != -1)
  {
    if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session) == 1)
    {
      _Send_Diag_NoTime(2,ID,Temp_0);
      _Check_10_01(Resp_10_len[1],Temp_0[1],P2can_server,P2_can_server);
      _Send_And_Check_NowSession(ID,prosession);
    }
    else
    {
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",NRC7E);
      _Send_And_Check_NowSession(ID,Session);
    }
  }
  else
    _WriteEx_and_Report("","02子功能不支持");
}

void _10_Phy_03(dword ID,byte Session) // S3server
{
  byte Temp_0[2]={0x10,0x3};
  int Start_time;/*设定起始的会话维持时间*/
  int End_time;/*设定结束的会话维持时间*/
  int Count_time=50;/*会话维持时间每次累计加50ms*/
  
  byte SedReq[4];
//  byte send_size = 3;
  byte send_size = 2;
  int S3server = 5000;
  
  Start_time = S3server - 200;
  End_time = S3server + 200;
//  SedReq[0] = 0x28;
//  SedReq[1] = 0x00;
//  SedReq[2] = 0x03;
  SedReq[0] = 0x27;
  SedReq[1] = RequestSeed_27;
  
  if(@AUTO::Config_Switch == 6 || (strncmp(ECU_project,"RC",strlen("RC")) == 0 )) // 瑞驰不用28测试
  {
    int serve_pos;
    send_size = 4;
    SedReq[0] = 0x31;
    SedReq[1] = (Serve31_NRC_Case >> 16) & 0xFF;
    SedReq[2] = (Serve31_NRC_Case >> 8) & 0xFF;
    SedReq[3] = Serve31_NRC_Case & 0xFF;
  }
  _Send_Diag(2,ID,Temp_0);
//  if((strncmp(ECU_project,"Chery",strlen("Chery")) == 0 )|| @AUTO::Config_Switch == 7)
//    _TestResult(SendData,ID,"",-1);
//  else
  _Check_10_01(Resp_10_len[2],Temp_0[1],P2can_server,P2_can_server);
  if(diagGetLastResponseCode(SendData)==-1)
  {
    testStepPass("","收到肯定响应");
    _Send_And_Check_NowSession(ID,exsession);
    _WriteEx_and_Report("","测试10 03的会话维持时间");
    for(Start_time;Start_time<End_time;Start_time+=Count_time)
    {
      writeEx(-3,1,"当前测试时间：%dms",Start_time);
      testWaitForTimeout(Start_time);
      _Send_Diag(send_size,phyreq_ID,SedReq);
      if(diagGetLastResponseCode(SendData)== 0x7f)
        break;
    }
    if((S3server - 60 <= Start_time)  &&(Start_time <= S3server + 60))
      testStepPass("","03会话维持时间在 5s ± 50ms 内，当前约为%d ms",Start_time);
    else
      testStepFail("","03会话维持时间不在 5s ± 50ms 内，当前约为%d ms",Start_time);
    _Send_And_Check_NowSession(ID,defsession);
  }
  else
    testStepFail("","10 03未收到响应或收到否定应答");
}

