}

void _10_Phy_08(dword ID,byte Session)/*NRC13*/
{
  byte Temp_0[2]={0x10,0x01};
  dword Len;
  Len = _Check_CANFD_Flage();
  _WriteEx_and_Report("遍历","10 01服务长度");
  for(i=1;i<=Len;i++)
  {
    if(i==2)
    {
      _WriteEx_and_Report("","当前长度已测试，跳过");
      continue;
    }
    _Send_Diag(i,ID,Temp_0);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(50);
  }
  _Send_And_Check_NowSession(ID,Session);
}

void _10_Phy_09(dword ID,byte Session)/*NRC12*/
{
  byte Temp_0[2]={0x10,0x01};
  dword i=0;
  _WriteEx_and_Report("遍历","10服务子功能");
  for(i=0;i<=0xff;i++)
  {
    if( (_Check_Serve(0x10,i,4)!= -1) )
      continue;
    if(i==0x60 && Factory_1060 == 1)
    {
      _WriteEx_and_Report("","工厂模式子功能，跳过");
      continue;  
    }
    Temp_0[1] = i;
    
    if(_Check_Serve(0X10,i&0x7F,4)!= -1 && i >= 0x80 && _Check_Serve(0X10,i&0x7F,3) == 1)
    {
      continue;
    }
    else
    {
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",NRC12);
    }
    testWaitForTimeout(50);
  }
  _Send_And_Check_NowSession(ID,Session);
}

void  _10_Phy_Ex_02(dword ID,byte Session)/*10 02*/
{
  byte Temp_1[2]={0x10,0x2};
  if(Pre_Programmed_1002 == 1)
    _Pre_Programmed();
  if((Pre_Programmed_1002 == 1) && (Pre_Programmed_UnlockECU == 0) && (_Check_Serve(0x10,0x02,5)==1))
    _unlockECU();
  else if((_Check_Serve(0x10,0x02,5)==1) && (Pre_Programmed_1002 == 0))
    _unlockECU();
  if(_Check_Fun_IDAndSess(0x10,0x02,ID,Session)==1)
  {
    _Send_Diag_NoTime(2,ID,Temp_1);
    {
      diagSetP2Extended(-1);
      testWaitForDiagResponse(SendData,p2cmax);
      if(diagGetLastResponseCode(SendData)==0x78)
      {
        if((Sub_1002_NRC78 == 1) && (DiagGetPrimitiveByte(SendData,1)==0x02))
          testStepFail("","10 02收到NRC78反馈,该项目预期10 02不响应NRC78");
        testWaitForDiagResponse(SendData,p2cmax*100);
        testReportWriteDiagResponse(SendData);
        _WriteEx_and_Report("","接收到NRC78响应,后续响应判断是否为正响应");
        _TestResult(SendData,ID,"",-1); 
        testWaitForTimeout(1000);
        _Send_And_Check_NowSession(ID,prosession);
      }
    }
  }
  else
  {
    _Send_Diag(2,ID,Temp_1);
    _TestResult(SendData,ID,"",NRC7E);
    _Send_And_Check_NowSession(ID,Session);
  }
}

void _10_Phy_Ex_03_GAC(dword ID,byte Session)/*NRC22*/
{
  byte Session_01[2] = {0x10,0x01};
  byte Session_02[2] = {0x10,0x02};
  byte Session_03[2] = {0x10,0x03};
  
  _Send_Diag(2,ID,Session_03);
  _Check_10_01(Resp_10_len[2],Session_03[1],P2can_server,P2_can_server);
  _Send_Diag(2,ID,Session_02);
  _TestResult(SendData,ID,"",NRC22);
  testWaitForTimeout(1000);
  
  _Send_Diag(2,ID,Session_03);
  _Check_10_01(Resp_10_len[2],Session_03[1],P2can_server,P2_can_server);
  _Pre_Programmed();
  _Send_Diag(2,ID,Session_01);
  _Check_10_01(Resp_10_len[0],Session_01[1],P2can_server,P2_can_server);
  _Send_Diag(2,ID,Session_03);
  _Check_10_01(Resp_10_len[2],Session_03[1],P2can_server,P2_can_server);
  _Send_Diag(2,ID,Session_02);
  _TestResult(SendData,ID,"",NRC22);
  testWaitForTimeout(1000);
  
  _Send_Diag(2,ID,Session_03);
  _Check_10_01(Resp_10_len[2],Session_03[1],P2can_server,P2_can_server);
  _Pre_Programmed();
  testWaitForTimeout(6000);
  _Send_Diag(2,ID,Session_03);
  _Check_10_01(Resp_10_len[2],Session_03[1],P2can_server,P2_can_server);
  _Send_Diag(2,ID,Session_02);
  _TestResult(SendData,ID,"",NRC22);
  testWaitForTimeout(1000);
  
  _Send_Diag(2,ID,Session_03);
  _Check_10_01(Resp_10_len[2],Session_03[1],P2can_server,P2_can_server);
  _Pre_Programmed();
  _Set_11_Restoration();
  _Send_Diag(2,ID,Session_03);
  _Check_10_01(Resp_10_len[2],Session_03[1],P2can_server,P2_can_server);
  _Send_Diag(2,ID,Session_02);
  _TestResult(SendData,ID,"",NRC22);
  testWaitForTimeout(1000);
}

void _10_Phy_Pro_02(dword ID,byte Session)/*10 02*/
{
  byte Temp_0[2]={0x10,0x02};
  int Flage;
  
  if(_Check_Serve(0x10,0x02,4)!= -1)
  {
    Flage = _Check_Fun_IDAndSess(0X10,0X02,ID,Session);
    if(Flage==0)
    {
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",NRC7E);
      _Send_And_Check_NowSession(ID,Session);
    }
    else if(Flage==1)
    {
      _Send_Diag_NoTime(2,ID,Temp_0);
      {
        diagSetP2Extended(-1);
        testWaitForDiagResponse(SendData,p2cmax);
        if(diagGetLastResponseCode(SendData)==0x78)
          {
            if((Sub_1002_NRC78 == 1) && (DiagGetPrimitiveByte(SendData,1)==0x02))
              testStepFail("","10 02收到NRC78反馈,该项目预期10 02不响应NRC78");
            testWaitForDiagResponse(SendData,p2cmax*100);
            testReportWriteDiagResponse(SendData);
            _WriteEx_and_Report("","接收到NRC78响应,后续响应判断是否为正响应");
            _TestResult(SendData,ID,"",-1); 
            testWaitForTimeout(1000);
            _Send_And_Check_NowSession(ID,prosession);
          }
       }
    }
    else if(Flage==-1)
    {
      _Send_Diag(2,ID,Temp_0);
      _TestResult(SendData,ID,"",0);
      _Send_And_Check_NowSession(ID,Session);
    }
  }
}
