void _37_Serve_NRC(dword ID,byte session)/*NRC优先级*/
{
  int Serve_Pos,i,j;
  byte Send_Data[50];
  int NRC33_Flage;
  Send_Data[0] = 0x37;
  NRC33_Flage = 0;
  Serve_Pos = _Check_Serve(0x37,0,0);
  if(_Check_Serve_IDAndSess(0x37,ID,session) == 1)
  {
    _Set_NRC_Step(0x37,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    for(i=0;i<Fun_NRC_Count;i++)
    {
      if(Fun_NRC[i] == 0x33)
      {
        NRC33_Flage = 1;
        break;
      }
    }
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    if(NRC33_Flage == 0)
      _unlockECU();
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      
      if( i > 0 && (Fun_NRC[i - 1] == 0x22 || Fun_NRC[i - 1] == 0x24)) break;
      
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x37 当前会话或寻址不支持");
}

void _31_Serve_01(dword ID,byte session)/*NRC7F*/
{
  byte Send_Data[50];
  int i,j;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    for(j=0;j<Serve_31_Hex[i].Control_Type_Count;j++)
    {
      _Get_31_ServeData(i,Send_Data,2,j);
      _Send_Diag(Len_31H,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC7F);
    }
  }
}
void _31_Serve_02(dword ID,byte session)/*Response*/
{
  byte Send_Data[50];
  int i,j,RxLen;
  int Sup_,Count;
  Count = 0;
  if(_Check_Serve_IDAndSess_(0x27,ID,session) == 1)
    
  testWaitForTimeout(1000);
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    for(j=0;j<Serve_31_Hex[i].Control_Type_Count;j++)
    {
      Sup_ = _Check_31Serve_IDAndSess(i,j,ID,session);
      if(Sup_ == 1) // 寻址和会话都支持
      {
        if(Count == 0)
        {
          if(Serve_31_Hex[i].Security_Access[j] == 1)
            _unlockECU();
        }
        Count++;
        if(session == 2) //编程会话
        {
          _Get_31_ServeData(i,Send_Data,2,j);
          _Send_Diag(Len_31H,ID,Send_Data);
          if((strncmp(ECU_project,"Chery",strlen("Chery")) == 0 )|| @AUTO::Config_Switch == 7)
          {
            if(Send_Data[1] != 0x01)
              _TestResult(SendData,ID,"",NRC24);
            else
              _TestResult(SendData,ID,"",NRC22);
          }
          else
            _TestResult(SendData,ID,"",NRC22);
        }
        else if(session == 3) //扩展会话
        {
          _Get_31_ServeData(i,Send_Data,2,j);
          _Send_Diag(Len_31H,ID,Send_Data);
          _TestResult(SendData,ID,"",-1);
          if(diagGetLastResponseCode(SendData)==-1)
          {
            RxLen = DiagGetRespPrimitiveSize(SendData);
            if(RxLen != Serve_31_Hex[i].Control_Type_RxLen[j])
              testStepFail("","31 %02X %02X %02X 当前响应长度异常，期望为 %d，实际为 %d",Serve_31_Hex[i].Control_Type[j],Serve_31_Hex[i].Routine[0],
                                                                                          Serve_31_Hex[i].Routine[1],Serve_31_Hex[i].Control_Type_RxLen[j],RxLen);
          }
        }
      }
      else if(Sup_ == 0) //寻址支持，但会话不支持
      {
        _Get_31_ServeData(i,Send_Data,2,j);
        _Send_Diag(Len_31H,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC7F);
      }
    }
  }
}
void _31_Serve_03(dword ID,byte session)/*NRC13*/
{
  byte Send_Data[50];
  int i,j,k;
  int Count;
  Count = 0;
  
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    for(j=0;j<Serve_31_Hex[i].Control_Type_Count;j++)
    {
      _Get_31_ServeData(i,Send_Data,2,j);
      for(k=1;k<=64;k++)
      {
        if((Serve_31_Hex[i].Serve_Session[j] & Session_BIN )!= 0)
        {
          if(Count == 0)
          {
            if(Serve_31_Hex[i].Security_Access[j] == 1)
              _unlockECU();
          }
          Count++;
          if(k==Len_31H)
            continue;
//          if((Send_Data[1] == 0x01 && Send_Data[2] == 0xFF && Send_Data[3] == 0x00) && (k>=4 && k<=9))
//            continue;
          _Send_Diag(k,ID,Send_Data);
          if((Send_Data[1] == 0x01 && Send_Data[2] == 0xFF && Send_Data[3] == 0x00) && (k>=4 && k<=9))
          {
            if((Send_Data[1] == 0x01 && Send_Data[2] == 0xFF && Send_Data[3] == 0x00) && (k==4 || k==8))
              continue;
            else
            {
              if(@AUTO::Config_Switch == 12)
                _TestResult(SendData,ID,"",NRC13);
              else
                _Check_ResCode(SendData,ID,NRC13,NRC31);
            }
          }
          else
            _TestResult(SendData,ID,"",NRC13);//NRC31优先级常高于total_13
          testWaitForTimeout(100);
        }
        else
        {
          _WriteEx_and_Report("","该例程不支持该会话");
          break;
        }
      }
    }
  }
}
void _31_Serve_04(dword ID,byte session)/*NRC12*/
{
  byte Send_Data[50];
  int i,j,k,Flage;
  int Count;
  Count = 0;
  for(k=0;k<Serve_31_Hex_Count;k++)
  {
    _Get_31_ServeData(k,Send_Data,2,0);
    for(i=0;i<=0XFF;i++)
    {
      if((Serve_31_Hex[k].Serve_Session[0] & Session_BIN) != 0)
      {
        if(Count == 0)
        {
          if(Serve_31_Hex[k].Security_Access[0] == 1)
            _unlockECU();
        }
        Count++;
        Flage = 0;
        for(j=0;j<Serve_31_Hex[k].Control_Type_Count;j++)
        {
          if(i==Serve_31_Hex[k].Control_Type[j])
            Flage = 1;
        }
        if(Flage == 1)
          continue;
        Send_Data[1] = i;
        _Send_Diag(Len_31H,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC12);
        testWaitForTimeout(200);
      }
      else
      {
        _WriteEx_and_Report("","该例程不支持该会话");
        break;
      }
    }
  }   
}
void _31_Serve_05(dword ID,byte session)/*NRC33*/
{
  byte Send_Data[50];
  int i,j;
  word Temp_RID;
  int Sup_;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    for(j=0;j<Serve_31_Hex[i].Control_Type_Count;j++)
    {
      Temp_RID = Serve_31_Hex[i].Routine[0] << 8 | Serve_31_Hex[i].Routine[1];
      Sup_ = _Check_31Serve_IDAndSess(i,j,ID,session);
      if(Sup_ != 1)
        continue;
      if(_Check_Serve(Serve_31_Hex[i].Control_Type[j],Temp_RID,11) == 1)
      {
        writeEx(-3,1,"测试NRC33: 31 %02X %02X %02X ",Serve_31_Hex[i].Control_Type[j],Serve_31_Hex[i].Routine[0],Serve_31_Hex[i].Routine[1]);
        _Get_31_ServeData(i,Send_Data,2,j);
        _Send_Diag(Len_31H,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC33);
      }
      else
      {
        writeEx(-3,1,"31 %02X %02X %02X 不支持NRC33 ",Serve_31_Hex[i].Control_Type[j],Serve_31_Hex[i].Routine[0],Serve_31_Hex[i].Routine[1]);
      }
    }
  }
}
void _31_Serve_06(dword ID,byte session)/*NRC优先级*/
{
  byte Send_Data[50];
  word NRC_RID;
  char comment[100];
  int i,j,Serve_Pos;
  dword Serve31_NRC_Case_Pro = 0x01FF00;
  dword NRC_Case;
  if( session == prosession)
    NRC_Case = Serve31_NRC_Case_Pro;
  else
    NRC_Case = Serve31_NRC_Case;
  snprintf(comment,elCount(comment),"未在Struct中查询到31服务 NRC 检测例程：31");
  snprintf(comment,elCount(comment),"%s %02X",comment,(NRC_Case >> 16) & 0xFF);
  snprintf(comment,elCount(comment),"%s %02X",comment,(NRC_Case >> 8) & 0xFF);
  snprintf(comment,elCount(comment),"%s %02X",comment,NRC_Case & 0xFF);
  writeEx(-3,1,"NRC_Case = 31%06X", NRC_Case);
   
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    _Get_31_ServeData(i,Send_Data,2,0);
    if((Send_Data[1] == ((NRC_Case >> 16) & 0xFF)) && (Send_Data[2] == ((NRC_Case >> 8) & 0xFF)) && (Send_Data[3] == (NRC_Case & 0xFF)))
    {
      Serve_Pos = i;
      break;
    }
  }
  if(i == Serve_31_Hex_Count)
  {
    writeEx(-3,1,comment);
    testStepFail("",comment);
    return;
  }
  if(_Check_31Serve_IDAndSess(Serve_Pos,0,ID,session) != 1)
  {
     _WriteEx_and_Report("","/*-------------- 该例程在当前会话不支持，不测试NRC优先级 --------------*/");
    return;
  }
  NRC_RID = NRC_Case & 0xFFFF;
  _Set_NRC_Step(Send_Data[1],NRC_RID,8,Send_Data);
  for(i=0;i<Fun_NRC_Count;i++)
  {
    if(i<Fun_NRC_Count)
      _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
    else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
//    if(Fun_NRC[i] == 0x31 && NRC31_Count == 1)
//    {
//      _Get_31_ServeData(Serve_Pos,Send_Data,2,0);
//      Send_Data[Serve_31_Hex[Serve_Pos].Control_Type_TxLen] = 0xFF;
//      Send_Data[Serve_31_Hex[Serve_Pos].Control_Type_TxLen + 1] = 0xFF;
//      Send_Data[Serve_31_Hex[Serve_Pos].Control_Type_TxLen + 2] = 0xFF;
//      Send_Data[Serve_31_Hex[Serve_Pos].Control_Type_TxLen + 3] = 0xFF;
//    }
    if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
    {
      _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
    }

    if(i == Fun_NRC_Count)
    {
      _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",-1);
    }
    else
    {
      if(Fun_NRC[i] == 0x31 && NRC31_total == 2 && NRC31_Count == 1 && NRC_Case == Serve31_NRC_Case_Pro)
      {
        byte TempSave[50];
        int Da;
        for(Da = 0; Da<elcount(Send_Data);Da++)
          TempSave[Da] = Send_Data[Da];
        _Get_Invalid_Data(Serve_Pos,TempSave,3);
        _Send_Diag(Fun_NRC_Send_Len,ID,TempSave);
        _TestResult(SendData,ID,"",0x31);
        _Get_Invalid_Data(Serve_Pos,TempSave,4);
        _Send_Diag(Fun_NRC_Send_Len,ID,TempSave);
        _TestResult(SendData,ID,"",0x31);
      }
      _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,"",Fun_NRC[i]);
    }
    testWaitForTimeout(100);
  }
}
void _31_Serve_06_01(dword ID,byte session)/*GAC-NRC优先级*/
{
  byte Send_31Data[100];
  int i;
  Send_31Data[0] = 0x31;Send_31Data[1] = 0x02;Send_31Data[2] = 0xFF;
  _Send_Diag(3,ID,Send_31Data);
  _TestResult(SendData,ID,"",0x33);
  _unlockECU();
  _Send_Diag(3,ID,Send_31Data);
  _TestResult(SendData,ID,"",0x13);
  Send_31Data[0] = 0x31;Send_31Data[1] = 0x00;Send_31Data[2] = 0x02;Send_31Data[3] = 0x03;Send_31Data[4] = 0x55;
  _Send_Diag(5,ID,Send_31Data);
  _TestResult(SendData,ID,"",0x31);
  Send_31Data[0] = 0x31;Send_31Data[1] = 0x00;Send_31Data[2] = 0xFF;Send_31Data[3] = 0x00;
  Send_31Data[4] = 0x44;
  for(i=5;i<=0xD;i++)
    Send_31Data[i] = 0xFF;
  _Send_Diag(0xB,ID,Send_31Data);
  _TestResult(SendData,ID,"",0x12);
  Send_31Data[1] = 0x01;
  _Send_Diag(0xB,ID,Send_31Data);
  _TestResult(SendData,ID,"",0x13);
  _Send_Diag(0xD,ID,Send_31Data);
  _TestResult(SendData,ID,"",0x31);
}

void _31_Serve_08(dword ID,byte Session)/*NRC31*/
{
  byte Tem[4] = {0x31,0x01,0X00,0X00};
  byte Tem1[5] = {0x31,0x01,0XFE,0XE0,0X00};
  word byte1,byte2;
  int Flage_Save,RID_Pos;
  diagStartTesterPresent(Cdd_Name);
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历31服务NRC31时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  if(_Check_Serve31H_(ID,Session) == 0)
  {
    _WriteEx_and_Report("","当前会话不支持");
    return;
  }
  _unlockECU();
  if((strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("ChangAn"))|| @AUTO::Config_Switch == 2)
  {
    for(byte1=0;byte1<=0XFF;byte1++)
    {
      Tem1[4] =byte1;
      if(byte1 == 0X01 || byte1 ==0X02)
        continue;
      else
      {
        _Send_Diag(5,ID,Tem1);
        Flage_Save = _TestResult(SendData,ID,"",NRC31);
        if(Flage_Save == -1)
        {
          char Str[50];
          snprintf(Str,elCount(Str),"[0x31 0x01 0x%02X 0x%02X ] \n",byte1,byte2);
          File_Write(Error_File,Error_FileName,Str,2);
        }
      }
    }
  }
  else
  {
    for(byte1=0;byte1<=0XFF;byte1++)
    {
      Tem[2] =byte1;
      for(byte2=0;byte2<=0XFF;byte2++)
      {
        Tem[3] =byte2;
        RID_Pos = _Check_SendData_In_31H(Tem);
        if(@AUTO::Config_Switch != 12)
        {
          if( RID_Pos !=-1)
            continue;
          else
          {
            _Send_Diag(4,ID,Tem);
            Flage_Save = _TestResult(SendData,ID,"",NRC31);
            if(Flage_Save == -1)
            {
              char Str[50];
              snprintf(Str,elCount(Str),"[0x31 0x01 0x%02X 0x%02X ] \n",byte1,byte2);
              File_Write(Error_File,Error_FileName,Str,2);
            }
          }
        }
        else
        {
          if(RID_Pos != -1 && _Check_31Serve_IDAndSess(RID_Pos,0,ID,Session) == 1)
            continue;
          _Send_Diag(4,ID,Tem);
          Flage_Save = _TestResult(SendData,ID,"",NRC31);
          if(Flage_Save == -1)
          {
            char Str[50];
            snprintf(Str,elCount(Str),"[0x31 0x01 0x%02X 0x%02X ] \n",byte1,byte2);
            File_Write(Error_File,Error_FileName,Str,2);
          }
        }
      }
    }
  }
  _WriteEx_and_Report("",Fault_Data_Report);
  write(Fault_Data_Write);
}
void _27_Serve_01(dword ID,byte session)/*NRC7F*/
{
  byte Send_Data[50];
  int Serve_Poss,i,n;
  Send_Data[0] = 0X27;
  if(_Check_Serve_IDAndSess(0x27,ID,session)!= 1)
  {
    Serve_Poss = _Check_Serve(0x27,0,0);
    for(i=0;i<Serve_Data[Serve_Poss].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Poss].Serve_Fun[i];
      _Send_Diag(Serve_Data[Serve_Poss].Serve_Fun_Len[i],ID,Send_Data);
      _TestResult(SendData,ID,"",NRC7F);  
      testWaitForTimeout(500);
    }
  }
}

void _27_Serve_02(dword ID,byte session)/*NRC13*/
{
  byte Send_Data[50];
  int Serve_Poss,i,n;
  Send_Data[0] = 0X27;
  if(_Check_Serve_IDAndSess(0x27,ID,session)!= -1)
  {
    Serve_Poss = _Check_Serve(0x27,0,0);
    for(i=0;i<Serve_Data[Serve_Poss].Serve_Fun_Count;i++)
    {
      Send_Data[1] = Serve_Data[Serve_Poss].Serve_Fun[i];
      if(i==1)
        _get_seed(ID);
      testWaitForTimeout(100);
      for(n=1;n<=64;n++)
      {
        if(n==Serve_Data[Serve_Poss].Serve_Fun_Len[i])
          continue;
        _Send_Diag(n,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC13);  
        testWaitForTimeout(200);
      } 
    }
  }
}
void _27_Serve_03(dword ID,byte session)/*NRC12*/
{
  byte Send_Data[50];
  int Serve_Poss,i,n;
  Send_Data[0] = 0X27;
  if(_Check_Serve_IDAndSess(0x27,ID,session)!= -1)
  {
    Serve_Poss = _Check_Serve(0x27,0,0);
    for(i=0;i<=0xFF;i++)
    {
      Send_Data[1] = i;
      for(n=0;n<Serve_Data[Serve_Poss].Serve_Fun_Count;n++)
      {
        if(i==Serve_Data[Serve_Poss].Serve_Fun[n])
          break;
      } 
      if(n>=Serve_Data[Serve_Poss].Serve_Fun_Count)
      {
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC12);  
        testWaitForTimeout(200);
      }
    }
  }
}
void _27_Serve_04(dword ID,byte session)/*NRC24*/
{
  byte Send_Data[50];
  int Serve_Poss,i,n;
  Send_Data[0] = 0X27;
  if(_Check_Serve_IDAndSess(0x27,ID,session)!= -1)
  {
    Serve_Poss = _Check_Serve(0x27,0,0);
    Send_Data[1] = Serve_Data[Serve_Poss].Serve_Fun[1];
    _Send_Diag(Serve_Data[Serve_Poss].Serve_Fun_Len[1],ID,Send_Data);
    _TestResult(SendData,ID,"",NRC24);  
  }
}
void _27_Serve_05(dword ID,byte session)/*NRC优先级*/
{
   byte Send_Data[100];
  int Serve_Pos;
  
  Serve_Pos = _Check_Serve(0x27,0,0);
  
  _WriteEx_and_Report("","/*----------测试前，错误计数清0--------*/");
  testWaitForTimeout(10000);
  _SetSession(session);
  _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
  _TestResult(SendData,ID,"",-1);
  testWaitForTimeout(1000);
  _SetSession(session);
  testWaitForTimeout(1000);
  
  if(_Check_Serve_IDAndSess(0x27,ID,session) == 1)
  {
    Send_Data[0] = 0x27;
    if(Request_Error_Count == 1)
    {
      _WriteEx_and_Report("","连续请求种子会导致错误计数器累加，故验证请求种子优先级");
      _Set_NRC_Step(0x27,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
      if(Fun_NRC_Count == 0)
      {
        _WriteEx_and_Report("","未输入NRC，跳过测试");
        return;
      }
      for(i=0;i<=Fun_NRC_Count;i++)
      {
       
        if(i<Fun_NRC_Count)
          _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
        if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        {
          _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
        }
        if(session == exsession && @AUTO::Config_Switch == 2 && NRC13_Count == 1 && Fun_NRC[i] == 0x13)
          continue;
        if(i == Fun_NRC_Count)
        {
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",-1);
        }
        else
        {
          _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
          _TestResult(SendData,ID,"",Fun_NRC[i]);
        }
        testWaitForTimeout(100);
      }
      _SetSession(session);
      _Send_Key(SendKey_Len,ID,0,0);
      _TestResult(SendData,ID,"",NRC24);
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    }
    else
    {
      _WriteEx_and_Report("","连续请求种子无影响，故验证发送秘钥优先级");
      _Set_NRC_Step(0x27,Serve_Data[Serve_Pos].Serve_Fun[1],6,Send_Data);
      if(Fun_NRC_Count == 0)
      {
        _WriteEx_and_Report("","未输入NRC，跳过测试");
        return;
      }
      for(i=0;i<Fun_NRC_Count;i++)
      {
        
        if(i<Fun_NRC_Count)
          _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
        if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
        {
          _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,1,Send_Data);
          if(Fun_NRC[i-1] == 0x24)
            _get_seed(ID);
        }
        if(session == exsession && @AUTO::Config_Switch == 2 && NRC13_Count == 1 && Fun_NRC[i] == NRC13)
          continue;
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
        testWaitForTimeout(100);
      }
      _Send_Key(SendKey_Len,ID,_get_seed(ID),0);
    }
  }
}
