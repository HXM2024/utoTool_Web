  }
}
void _10_Serve_NRC(dword ID,byte session)/*NRC优先级*/
{
  int Serve_Pos,i,Fun_Pos;  //变量初始化
  byte Send_Data[50];
  
  Serve_Pos = _Check_Serve(0x10,0,0); //查询服务所在结构体的位置
  Send_Data[0] = 0x10;
  Send_Data[1] = session;  // 获取当前的诊断会话模式
  Fun_Pos = _Check_Serve(0x10,Send_Data[1],4); //查询子功能所在服务结构的位置
  if(_Check_Fun_IDAndSess(0x10,session,ID,session) == 1)  //检查子功能是否支持当前的寻址方式和会话模式
  {

    _Set_NRC_Step(0x10,Send_Data[1],6,Send_Data);  //获取NRC列表，并根据优先级设置发送的数据Send_Data及其长度Fun_NRC_Send_Len
    if(Fun_NRC_Count == 0)  //无NRC输入时，直接跳出函数结束当前测试
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++) //根据NRC列表逐步发送诊断请求数据
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,Fun_Pos,Send_Data);  //对上一步测试的NRC发送诊断请求数据进行恢复
      }
      if(i == Fun_NRC_Count) //当NRC测试完成后，发送一次正常诊断请求数据，验证是否正响应
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data); //发送诊断请求数据
        _TestResult(SendData,ID,"",-1); //检查响应
      }
      
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);//发送诊断请求数据
        _TestResult(SendData,ID,"",Fun_NRC[i]);//检查响应
      }
      testWaitForTimeout(200); //每一次发送和检查数据后等待200ms
    }
  }
  else
    _WriteEx_and_Report("","0x10 0x%02X当前会话或寻址不支持",session); //打印不支持时的消息到Trace面板及Report报告中
}

void _11_Phy_Def_01(dword ID,byte Session)/*遍历子功能*/ 
{
  int i,Flage;
  byte Send_Data[2];
  Send_Data[0] = 0x11;
  for(i=1;i<=0xFF;i++)
  {
    if(_Check_Serve(0x11,i,4)!= -1)  //查询所有支持的子功能并遍历
    {
      Send_Data[1] = i;
//      writeEx(-3,1,"Send_Data = 0x11 %02x",Send_Data[1]);
      Flage = _Check_Fun_IDAndSess(0x11,i,ID,Session);
      if(Flage == -1) //寻址不支持
      {
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",0);
        _Send_And_Check_NowSession(ID,Session);
      }
      else if(Flage == 0)//会话不支持
      {
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",NRC7F);
        _Send_And_Check_NowSession(ID,Session);
      }
      else if(Flage == 1)//均支持
      {
        if(_Check_Serve(0x11,i,5) == 1)
        {
          _Send_Diag(2,ID,Send_Data);
          _TestResult(SendData,ID,"",NRC33);
          testWaitForTimeout(500);
          _WriteEx_and_Report("","通过安全访问");
          _SetSession(exsession);
          _unlockECU();
        }
        _Send_Diag(2,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
        testWaitForTimeout(2000);
        _Send_And_Check_NowSession(ID,defsession);
        _SetSession(Session);
        testWaitForTimeout(1000);
      }
    }
  }  
}

void _11_Phy_Def_02(dword ID,byte Session)/*肯定响应抑制位*/ 
{
  int i,Flage;
  byte Send_Data[2];
  Send_Data[0] = 0x11;
  for(i=1;i<=0xFF;i++)
  {
    if(_Check_Serve(0x11,i,4)!= -1)  //查询所有支持的子功能并遍历
    {
      Send_Data[1] = i|0x80;
      Flage = _Check_Fun_IDAndSess(0x11,i,ID,Session);
      if(Flage == 1)//均支持
      {
        if(_Check_Serve(0x11,i,3)==1)
        {
          if(_Check_Serve(0x11,i,5) == 1)
          {
            _Send_Diag(2,ID,Send_Data);
            _TestResult(SendData,ID,"",NRC33);
            testWaitForTimeout(500);
            _WriteEx_and_Report("","通过安全访问");
            _SetSession(exsession);
            _unlockECU();
          }
          _Send_Diag(2,ID,Send_Data);
          _TestResult(SendData,ID,"",0);
          testWaitForTimeout(2000);
          _Send_And_Check_NowSession(ID,defsession);
          _SetSession(Session);
          testWaitForTimeout(1000);
        }
        else
          _WriteEx_and_Report("","0x%02X该子功能不支持肯定响应抑制位",i);
      }
      else
        _WriteEx_and_Report("","0x%02X该子功能在该会话或寻址方式下不支持",i);
    }
  } 
}

void _11_Phy_Def_04(dword ID,byte Session)/*NRC13*/ 
{
  byte Send_Data[2],i;
  byte Len;
  int Serve_Pos,flage;
  Serve_Pos = _Check_Serve(0X11,0,0);
  Send_Data[0] = 0x11;
  Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  Len = _Check_CANFD_Flage();
  flage = -1;
  for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
  {
    if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1) //当前寻址及会话下支持
    {
      flage = i;
      break;
    }
  }
  if(flage != -1) 
  {
    if(Serve_Data[Serve_Pos].Security_Access[flage]==1) //是否需要安全访问
      _unlockECU();
    for(i=1;i<=Len;i++)
    {
      if(i==Serve_Data[Serve_Pos].Serve_Fun_Len[flage])
        continue;
      _Send_Diag(i,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
  else
  {
    _WriteEx_and_Report("","当前寻址及会话下无支持的子功能");
    for(i=1;i<=Len;i++)
    {
      _Send_Diag(i,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC7F);
      testWaitForTimeout(50);
    }
  }
}

void _11_Phy_Def_05(dword ID,byte Session)/*NRC12*/ 
{
  byte Send_Data[2];
  int Serve_Pos,flage,i;
  Serve_Pos = _Check_Serve(0X11,0,0);
  Send_Data[0] = 0x11;
  flage = -1;
  for(i=0;i<Serve_Data[Serve_Pos].Serve_Fun_Count;i++)
  {
    if(_Check_Fun_IDAndSess(0x11,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1) //当前寻址及会话下支持
    {
      flage = i;
      break;
    }
  }
  if(flage != -1)//存在子功能在当前服务及会话下支持
  {
    if(Serve_Data[Serve_Pos].Security_Access[flage] == 1)
      _unlockECU();
    /*遍历11服务所有不支持的子功能*/
    for(i=0;i<=0xFF;i++)
    {
      if((_Check_Serve(0x11,i,4) != -1) || (_Check_Serve(0x11,i&0x7F,4) != -1))
        continue;
      Send_Data[1] = i;
      _Send_Diag(Serve_Data[Serve_Pos].Serve_Fun_Len[flage],ID,Send_Data);
      _TestResult(SendData,ID,"",NRC12);
      testWaitForTimeout(50);
      writeEx(-3,0,"--");
    }
  }
  else
    _WriteEx_and_Report("","当前寻址及会话下无支持的子功能");
}

void _11_Serve_NRC(dword ID,byte session)/*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[50];
  
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(_Check_Serve_IDAndSess(0x11,ID,session) == 1)
  {
    Send_Data[0] = 0x11;
    _Set_NRC_Step(0x11,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
      
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x11 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[0]);
}

void _22_Serve_01(dword ID,dword Session) /*22 XX XX*/
{
  byte Temp_0[3];
  byte K,N;
  int Serv_Pos,Addres;
  char Tem_Str[300];
  int Flage_Save ;
  K = 0;
  Temp_0[0] = 0x22;
  Serv_Pos = _Check_Serve(0x22,0,0);
  if(ID == phyreq_ID)
    Addres = 1;
  else if(ID == funreq_ID)
    Addres = 2 ;
  if((Serve_Data[Serv_Pos].Serve_Addres[0] & Addres) != 0)  //寻址支持
  {
    if((Serve_Data[Serv_Pos].Serve_Session[0] & Session_BIN) != 0) //会话支持
    {
      snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
      testGetCurrentTestCaseTitle(Fault_Data_Write,400);
      snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历22DID数据时,异常响应: \n",Fault_Data_Write);
      File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
      _get_Str_Traversal("DID_22_Traversal");
      for(K=0;K<Traversal_Count;K++)
      {
        _get_DID(Traversal_DID[K]);
        snprintf(Tem_Str,elCount(Tem_Str),"预期结果: ");
        Temp_0[1] = DID_byte1;
        Temp_0[2] = DID_byte2;
        if(Analysis == 1)
        {
          snprintf(Tem_Str,elCount(Tem_Str),"%s 62 %02X %02X",Tem_Str,DID_byte1,DID_byte2);
          if(Len_Input == DID_len_Ex)
          {
            for(N=0;N<DID_len_Ex-3;N++)
              snprintf(Tem_Str,elCount(Tem_Str),"%s %02X",Tem_Str,DID_Data[N]);
          }
          else //存在未使用字节填充位
          {
            for(N=0;N<Len_Input;N++)
              snprintf(Tem_Str,elCount(Tem_Str),"%s %02X",Tem_Str,DID_Data[N]);
            for(N=Len_Input;N<DID_len_Ex - 3;N++)
              snprintf(Tem_Str,elCount(Tem_Str),"%s %02X",Tem_Str,filler );
          }
          _WriteEx_and_Report(Traversal_DID[K],Tem_Str);    
        }
        else
        {
          snprintf(Tem_Str,elCount(Tem_Str),"预期结果 %s",DID_Data_str);
          _WriteEx_and_Report(Traversal_DID[K],Tem_Str);
        }
        Flage_Save = _Check_22DID(ID,Temp_0,Session);
        if(Flage_Save == -1)
        {
          char Str[50];
          snprintf(Str,elCount(Str),"[  %s  ] \n",Traversal_DID[K]);
          File_Write(Error_File,Error_FileName,Str,2);
        }
      }
    }
    else
       _WriteEx_and_Report("","当前服务会话不支持");
  }
  else
    _WriteEx_and_Report("","当前服务寻址不支持");
}

void _22_Serve_02(dword ID,dword Session) /*NRC13*/
{
  byte Temp_0[3]={0x22,0xF1,0x89}; 
  byte i;
  int Len;
  int Return_Va,Serve_Pos;
  Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
  if(Return_Va == 1)
  {
    _get_Str_Traversal("DID_22_Traversal");
    _get_DID(Traversal_DID[0]);
    Temp_0[1] = DID_byte1;
    Temp_0[2] = DID_byte2;
    Len = _Check_CANFD_Flage();
    for(i=1;i<=Len;i++)
    {
      writeEx(-3,1,"当前长度为: %d",i);
      if((i%2==1)&&(i!=1)&&i<=(DID_22_Support*2+1))
      {
        _WriteEx_and_Report("","当前长度支持，跳过检测");
        testWaitForTimeout(200);
        continue;
      }
      _Send_Diag(i,ID,Temp_0);
      if(Session != 2 && (i >= 3) && @AUTO::Config_Switch == 2)
        _TestResult(SendData,ID,"",NRC31);
      else
        _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(200);
    }
  }
  else if(Return_Va == -1)
    _WriteEx_and_Report("","当前寻址不支持该服务");
  else if(Return_Va == 0)
    _WriteEx_and_Report("","当前会话不支持该服务");
}

void _22_Serve_03(dword ID,dword Session) /*NRC31*/
{
  byte Send_Data[3]={0x22,0xF1,0x80}; 
  dword byte1,byte2,Fun_Send;
  int Return_Va,Flage_Save;
  
  Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历22服务NRC31时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  if(Return_Va == 1)
  {
    if(Ergodic_22H==0)
    {
      for(byte1=0;byte1<=0xFF;byte1++)
      {
        Send_Data[1]=byte1;
        for(byte2=0;byte2<=0xFF;byte2++)
        {
          Send_Data[2]=byte2;
          Fun_Send = (byte1 << 8) ^ byte2;
          if(_Check_Serve(0x22,Fun_Send,4) != -1 ) 
          {
            _WriteEx_and_Report("","该子功能支持，跳过检测");
            continue;
          }
          else
          {
            _Send_Diag(3,ID,Send_Data);
            Flage_Save = _TestResult(SendData,ID,"",NRC31);
            testWaitForTimeout(50);
            if(Flage_Save == -1)
            {
              char Str[30];
              snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
              File_Write(Error_File,Error_FileName,Str,2);
            }
          }
        }
      } 
    }
    if(Ergodic_22H != 0)
    {
      Send_Data[1] = Ergodic_22H;
      for(byte2=0;byte2<=0xff;byte2++)
      {
        Send_Data[2]=byte2;
        Fun_Send = (Ergodic_22H << 8) ^ byte2;
        if(_Check_Serve(0x22,Fun_Send,4) != -1 || (byte2 >= 0xF0 && byte2 <=0xF6))
        {
          _WriteEx_and_Report("","该子功能支持，跳过检测");
          testWaitForTimeout(100);
          continue;
        }
        else
        {
          _Send_Diag(3,ID,Send_Data);
          Flage_Save = _TestResult(SendData,ID,"",NRC31);
          testWaitForTimeout(50);
          if(Flage_Save == -1)
          {
            char Str[30];
            snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
            File_Write(Error_File,Error_FileName,Str,2);
          }
        }
      }
    }
  }
  else if(Return_Va == -1)
    _WriteEx_and_Report("","当前寻址不支持该服务");
  else if(Return_Va == 0)
    _WriteEx_and_Report("","当前会话不支持该服务");
}

void _22_Serve_NRC(dword ID,dword Session)/*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[50];
  
  Serve_Pos = _Check_Serve(0x22,0,0);
  if(_Check_Serve_IDAndSess(0x22,ID,Session) == 1)
  {
    Send_Data[0] = 0x22;
    Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[0] >> 8;
    Send_Data[2] = Serve_Data[Serve_Pos].Serve_Fun[0] & 0xFF;
    _Set_NRC_Step(0x22,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<=Fun_NRC_Count;i++)
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
      
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count)
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        if(Session != 2 && (Fun_NRC_Send_Len > Serve_Data[Serve_Pos].Serve_Fun_Len[0]) && NRC13_total == 2 && @AUTO::Config_Switch == 2)
        {
          _WriteEx_and_Report("","该会话不支持Totoal 13");
          _TestResult(SendData,ID,"",NRC31);
        }
        else
          _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
}

