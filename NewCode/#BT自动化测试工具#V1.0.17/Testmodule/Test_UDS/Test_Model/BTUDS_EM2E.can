void Other_GAC_05() /*在引导程序的默认会话下休眠验证-300s内有诊断报文请求*/
{
  message *Msg;
  byte Send_Data_3E[2] = {0x3E,0x00};
  
  Msg.dlc = 8;
  Msg.id = phyreq_ID;
  Msg.byte(0) = 0x02;Msg.byte(1) = 0x3E;Msg.byte(2) = 0x00;
  for(i=3;i<8;i++)
    Msg.byte(i) = 0x55;
  
  _K15_OFF();
  testWaitForTimeout(2000);
  _K15_ON();
  
  Time_Count_Time = 0;
  setTimer(Def_TimeCount,2000);
  do
  {
    output(Msg);
    testWaitForTimeout(1000);
  }while(Time_Count_Time<150);
  cancelTimer(Def_TimeCount);
  _Send_Diag(2,phyreq_ID,Send_Data_3E);
  _TestResult(SendData,phyreq_ID,"",0);
}
