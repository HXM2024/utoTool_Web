void _2E_Serve_01(dword ID,dword Session)/*NRC7F>NRC13*/
{
  int Serve_Pos,Addres;
  byte Send_Data[10];
  Send_Data[0] = 0x2E;
  Serve_Pos = _Check_Serve(0x2E,0,0);
  if(ID == phyreq_ID)
    Addres = 1;
  else if(ID == funreq_ID)
    Addres = 2 ;
  if(Serve_Pos >= 0)
  {
    if((Serve_Data[Serve_Pos].Serve_Addres[0] & Addres) != 0)  //寻址支持
    {
      if((Serve_Data[Serve_Pos].Serve_Session[0] & Session_BIN) != 0) //会话支持
      {
        _get_2E_DID("DID2E_Rx_NRC33");
        _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
        _TestResult(SendData,ID,"",NRC33);
      }
      else
      {
        _get_2E_DID("DID2E_Rx_NRC33");
        _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
        _TestResult(SendData,ID,"",NRC7F);
      }
    }
    else
    {
      _get_2E_DID("DID2E_Rx_NRC33");
      _WriteEx_and_Report("","该寻址方式当前不支持该服务");
      _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,ID,"",0);
    }
  }
  else
  {
    _WriteEx_and_Report("","该项目当前不支持该服务");
    _Send_Diag(3,ID,Send_Data);
    _TestResult(SendData,ID,"",NRC11);
  }
}

void _2E_Serve_02(dword ID,dword Session)/*遍历 2E XX XX*/
{
  int m;
  int Flage_1,Pass_Flage;
  byte DID[2];
  int App_Status;
  
  App_Status = -1;
  _get_Str_Traversal("DID_2E_Traversal");
  for(m=0;m<Traversal_Count;m++)
  {
    if(m>0)
    {
      _SetSession(defsession);
      testWaitForTimeout(500);
      _SetSession(Session);
      testWaitForTimeout(200);
      if(Session == prosession)
        testWaitForTimeout(800);
    }
    Pass_Flage = 0;
    _get_2E_DID(Traversal_DID[m]);
    DID[0] =  DID_2E_SendData_1[1];
    DID[1] =  DID_2E_SendData_1[2];
    if(Session == prosession)
    {
      if(@AUTO::Config_Switch == 5 || (strncmp(ECU_project,"SRM",strlen("SRM")) == 0 ))//鑫源特殊情况
      {
        if(App_Status ==  -1)
          App_Status = Check_APPValid();
        if(DID[0] == 0xF1 && (DID[1] == 0x98 || DID[1] == 0x99) && App_Status == 0)
        {
          writeEx(-3,1," /*-------- 鑫源F198和F199需要回APP测试，需手动刷写正常流程后测试该用例! --------*/");
          writeEx(-3,1," /*-------- 纯BT下仅验证写入后正响应 --------*/");
          Pass_Flage = 1;
          Flage_1 = _Check_2EH_Support(DID,ID,Session,1);
          if(Flage_1 ==1)
          {
            _unlockECU();
            testWaitForTimeout(500);
            _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
            _TestResult(SendData,ID,"",DID_2E_SendData_1_Response);
          }
          else if(Flage_1 == 0)
          {
            _WriteEx_and_Report(Traversal_DID[i],"当前会话下不支持该DID");
      //      _unlockECU();
            _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
            _TestResult(SendData,ID,"",0x7F); 
          }
          else
          { 
            _WriteEx_and_Report(Traversal_DID[i],"当前寻址下不支持该DID");
          }
          testWaitForTimeout(100);
        }
      }
    }
    if(Pass_Flage == 0)
    {
      Flage_1 = _Check_2EH_Support(DID,ID,Session,1);
      if(Flage_1 ==1)
      {
        _Check_DID_2E(ID,Session,m);
      }
      else if(Flage_1 == 0)
      {
        _WriteEx_and_Report(Traversal_DID[i],"当前会话下不支持该DID");
  //      _unlockECU();
        _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
        _TestResult(SendData,ID,"",0x7F); 
      }
      else
      { 
        _WriteEx_and_Report(Traversal_DID[i],"当前寻址下不支持该DID");
      }
      testWaitForTimeout(100);
    }
  }
}

void _2E_Serve_03(dword ID,byte Session)/*NRC31*/
{
  byte Temp_0[3];
  byte Temp_1[2];
  int byte1;           /*2E服务的第一个字节*/
  int byte2;           /*2E服务的第二个字节*/
  int Serv_Pos,Addres;
  int Pass_Flage,Flage_Save;
  Temp_0[0] = 0x2E;
  Serv_Pos = _Check_Serve(0x2E,0,0);
  if(ID == phyreq_ID)
    Addres = 1;
  else if(ID == funreq_ID)
    Addres = 2 ;
  
  Pass_Flage = _Check_Serve_IDAndSess(0x2E,ID,Session);
  if(Pass_Flage != 1)
  {
    _WriteEx_and_Report("","当前服务在会话或寻址方式下不支持,跳过测试");
    return;
  }
  
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"%s","");
  testGetCurrentTestCaseTitle(Fault_Data_Write,400);
  snprintf(Fault_Data_Write,elCount(Fault_Data_Write),"\n %s: \n    遍历2E服务NRC31时,异常响应: \n",Fault_Data_Write);
  File_Write(Error_File,Error_FileName,Fault_Data_Write,2);
  
  if((Serve_Data[Serv_Pos].Serve_Addres[0] & Addres) != 0)  //寻址支持
  {
    Temp_0[0] = 0x2E;
    _get_2E_DID("DID2E_Rx_NRC33");
    Len = DID_2E_SendData_1_Len;
    _unlockECU();
    /*遍历所有不支持的DID*/
    if(Ergodic_2EH == 0)
    {
      for(byte1 = 0xF0; byte1 <= 0xF1; byte1++)
      {
        Temp_0[1] = byte1;
        Temp_1[0] = byte1;
        for(byte2 = 0; byte2 <= 0xFF; byte2++)
        {
          Temp_0[2] = byte2;
          Temp_1[1] = byte2;
          if(_Check_2EH_Support(Temp_1,ID,Session,0)==1 || (byte1 == 0xF1 &&(byte2 >= 0xF0 && byte2 <=0xFA)))
            _WriteEx_and_Report("","该DID支持,跳过");
          else
          {
            _Send_Diag(Len,ID,Temp_0);
            Flage_Save = _TestResult(SendData,ID,"",NRC31);
            if(Flage_Save == -1)
            {
              char Str[30];
              snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
              File_Write(Error_File,Error_FileName,Str,2);
            }
          }
          testWaitForTimeout(50);
        }
      }
    }
    else
    {
      Temp_0[1] = Ergodic_2EH;
      Temp_1[0] = Ergodic_2EH;
      for(byte2=0;byte2<=0xFF;byte2++)
      {
        Temp_0[2] = byte2;
        Temp_1[1] = byte2;
        if(_Check_2EH_Support(Temp_1,ID,Session,0)==1 || (byte2 >= 0xF0 && byte2 <=0xFA))
          _WriteEx_and_Report("","该DID支持,跳过");
        else
        {
          _Send_Diag(Len,ID,Temp_0);
          Flage_Save = _TestResult(SendData,ID,"",NRC31);
          if(Flage_Save == -1)
          {
            char Str[30];
            snprintf(Str,elCount(Str),"[  0x%02X 0x%02X  ] \n",byte1,byte2);
            File_Write(Error_File,Error_FileName,Str,2);
          }
        }
        testWaitForTimeout(50);
      }
    }
  }
  else
    _WriteEx_and_Report("","当前服务寻址不支持");
}

void _2E_Serve_04(dword ID,dword Session)/*NRC13*/
{
  byte Data[400];
  int Len;
  int Pass_Flage;
  
  Pass_Flage = _Check_Serve_IDAndSess(0x2E,ID,Session);
  if(Pass_Flage != 1)
  {
    _WriteEx_and_Report("","当前服务在会话或寻址方式下不支持,跳过测试");
    return;
  }
  _get_2E_DID("DID2E_Rx_NRC33");
  _unlockECU();
  for(i=0;i<DID_2E_SendData_1_Len;i++)
    Data[i] = DID_2E_SendData_1[i];
  if(DID_2E_SendData_1_Len<=7)
    Len = 7;
  else
    Len = DID_2E_SendData_1_Len+1;
  for(i=1;i<=Len;i++)
  {
    if(i==DID_2E_SendData_1_Len) 
      continue;
    _Send_Diag(i,ID,Data);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(50);
  }
}

void _2E_Serve_05(dword ID,dword Session)/*NRC33*/
{
   byte Data[500];
  byte Data2[500];
  int i=0,j=0,Len=0,Len2=0,flage;
  int Pass_Flage;
  
  Pass_Flage = _Check_Serve_IDAndSess(0x2E,ID,Session);
  if(Pass_Flage != 1)
  {
    _WriteEx_and_Report("","当前服务在会话或寻址方式下不支持,跳过测试");
    return;
  }
  
  flage=0;
  _get_Str_Traversal("DID_2E_Traversal");
  if(Session == 2 &&((_Check_Serve(0x10,0x02,5)==1) || (Pre_Programmed_1002==1)))
  {
    _WriteEx_and_Report("","该项目进入10 02时Ecu已解锁，无法测试2E服务编程模式NRC33");
    return;
  }

  for(i=0;i<Traversal_Count;i++)
  {
    _get_2E_DID(Traversal_DID[i]);
    if(i>0)
      _SetSession(Session);
    if(Support_Read_2E_DID == 1)
    {
      _Send_Diag(Read_2E_DID_Len,ID,Read_2E_DID);
      _TestResult(SendData,ID,"",-1);
      if(diagGetLastResponseCode(SendData)==-1)
      {
        Len = DiagGetRespPrimitiveSize(SendData);
        for(j=0;j<Len;j++)
          Data[j] = DiagGetRespPrimitiveByte(SendData,j);
      }
      else
        testStepFail("22读取数据","未收到正响应");
      _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,ID,"",NRC33);
      _Send_Diag(Read_2E_DID_Len,ID,Read_2E_DID);
      _TestResult(SendData,ID,"",-1);
      if(diagGetLastResponseCode(SendData)==-1)
      {
        Len2 = DiagGetRespPrimitiveSize(SendData);
        for(j=0;j<Len2;j++)
          Data2[j] = DiagGetRespPrimitiveByte(SendData,j);
      }
      else
        testStepFail("22读取数据","未收到正响应");
      if(Len!=Len2 )
        testStepFail(Traversal_DID[i],"两次接收到的数据长度不一致,第一次长度为%d,第二次长度为%d",Len,Len2);
      else
      {
        for(j=0;j<Len;j++)
        {
          if(Data[j]!=Data2[j])
            flage=1;
        }
        if(flage==1)
          testStepFail(Traversal_DID[i],"两次返回的数据不一致");
        else
          testStepPass(Traversal_DID[i],"两次返回的数据一致");
      }
    }
    else
    {
      _WriteEx_and_Report(Traversal_DID[i],"不支持读取,仅验证返回NRC33");
      _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
      _TestResult(SendData,ID,"",NRC33);
    }
  }
}

void _2E_Serve_06(dword ID,byte Session)/*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[50];
  int Pass_Flage;
  
  Pass_Flage = _Check_Serve_IDAndSess(0x2E,ID,Session);
  if(Pass_Flage != 1)
  {
    _WriteEx_and_Report("","当前服务在会话或寻址方式下不支持,跳过测试");
    return;
  }
  _get_2E_DID("DID2E_Rx_NRC33");
  Serve_Pos = _Check_Serve(0x2E,0,0);
  if(_Check_Serve_IDAndSess(0x2E,ID,Session) == 1)
  {
    Send_Data[0] = 0x2E;
    _Set_NRC_Step(0x2E,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<Fun_NRC_Count;i++) 
    {
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
      
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);

      if(i == Fun_NRC_Count)
        _TestResult(SendData,ID,"",-1);
      if(Session != 2 && (Fun_NRC_Send_Len > Serve_Data[Serve_Pos].Serve_Fun_Len[0]) && NRC13_total == 2 && @AUTO::Config_Switch == 2)
      {
        _WriteEx_and_Report("","该会话不支持Totoal 13");
        _TestResult(SendData,ID,"",NRC31);
      }
      else
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      testWaitForTimeout(100);
    }
  }
}

void _3E_Serve_01(dword ID)/*3E 00*/
{
  byte Temp[2] = {0x3E,0x00};
  byte Temp_ID;
  if(ID == phyreq_ID)
    Temp_ID = 1;
  else if(ID == funreq_ID)
    Temp_ID = 2;
  _Send_Diag(2,ID,Temp);
  /*寻址方式不支持*/
  if(_Check_Serve(0x2E,0,1) & Temp_ID == 0)
    _TestResult(SendData,ID,"",NRC12);
  else
    _TestResult(SendData,ID,"",-1);
}

void _3E_Serve_02(dword ID)/*3E 80*/
{
  byte Temp[2] = {0x3E,0x80};
  byte Temp_ID;
  
  /*bit0表示物理寻址、bit1表示功能寻址*/
  if(ID == phyreq_ID)
    Temp_ID = 1;
  else if(ID == funreq_ID)
    Temp_ID = 2;
  _Send_Diag(2,ID,Temp);
  /*寻址方式不支持*/
  if(_Check_Serve(0x2E,0,1) & Temp_ID == 0)
    _TestResult(SendData,ID,"",NRC12);
  else
    _TestResult(SendData,ID,"",0);
}

void _3E_Serve_04(dword ID)/*NRC13*/
{
  byte Tem[2] = {0x3E,0x00};
  int Len;
  Len = _Check_CANFD_Flage();
  for(i=1;i<=Len;i++)
  {
    if(i==0x02)
    {
      _WriteEx_and_Report("","报文长度正确，跳过测试");
      continue;
    }
    _Send_Diag(i,ID,Tem);
    _TestResult(SendData,ID,"",NRC13);
    testWaitForTimeout(50);
  }
}
void _3E_Serve_05(dword ID)/*NRC12*/
{
  byte Tem[2] = {0x3E,0x00};
  int i,Serve_Pos,Fun_Pos;
  Serve_Pos = _Check_Serve(0x3E,0,0);
  for(i=1;i<=0xFF;i++)
  {
    if(i == 0x80) continue;
    Tem[1]=i;
    Fun_Pos = _Check_Serve(0x3E,0,4);
    if(i==Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos])
    if((Fun_Pos == 1) || (Serve_Data[Serve_Pos].RSP[Fun_Pos] == 1))
    {
      _WriteEx_and_Report("","子功能正确，跳过测试");
      continue;
    }
    _Send_Diag(2,ID,Tem);
    _TestResult(SendData,ID,"",NRC12);
    testWaitForTimeout(50);
  }
}
void _3E_Serve_NRC(dword ID,byte session)/*NRC优先级*/
{
  int Serve_Pos,i;
  byte Send_Data[50];
  
  Serve_Pos = _Check_Serve(0x3E,0,0);
  if(_Check_Serve_IDAndSess(0x3E,ID,session) == 1)
  {
    Send_Data[0] = 0x3E;
    _Set_NRC_Step(0x3E,Serve_Data[Serve_Pos].Serve_Fun[0],6,Send_Data);
    if(Fun_NRC_Count == 0)
    {
      _WriteEx_and_Report("","未输入NRC，跳过测试");
      return;
    }
    for(i=0;i<Fun_NRC_Count;i++)
    {
      if(Fun_NRC[i] == NRC12 && session == 2 )
        continue;
      if(i<Fun_NRC_Count)
        _WriteEx_and_Report("","/*-------------- 测试NRC = 0x%X --------------*/",Fun_NRC[i]);
      else _WriteEx_and_Report("","/*---------------- 测试无NRC -----------------*/",Fun_NRC[i]);
      
      if(i>0) //第一次反馈最高优先级不做处理,其余依次恢复
      {
        _Recover_NRC_Step(Fun_NRC[i-1],Serve_Pos,0,Send_Data);
      }
      if(i == Fun_NRC_Count )
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",-1);
      }
      else
      {
        _Send_Diag(Fun_NRC_Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,"",Fun_NRC[i]);
      }
      testWaitForTimeout(100);
    }
  }
  else
    _WriteEx_and_Report("","0x3E 0x%02X当前会话或寻址不支持",Serve_Data[Serve_Pos].Serve_Fun[0]);
}
_Not_Support_Fun(dword ID,dword session)  //不支持的服务
{
  int i;
  byte data_[1]={0x01};
  if((strncmp(ECU_project,"BYD",strlen("BYD")) == 0 || @AUTO::Config_Switch == 1)) //BYD存在双备份问题，无法停留在BT
  {
    for(i=0;i<=0xFF;i++)
    {
      if(i==0x10 || i==0x11 || i==0x22 || i==0x27 || i==0x2E || i==0x31 || i==0x34 || i==0x36 || i==0x37 || i==0x3e || i==0x28 ||  i==0x85  ||  i==0x14 ||  i==0x19)
        if(_Check_Serve(i,0,0)!=-1) 
          continue;
      data_[0] = i;
      _Send_Diag_NoTime(1,ID,data_);
      _get_NRC11(ID);
      testWaitForTimeout(200);
    }
  }
  else
  {
    for(i=0;i<=0xFF;i++)
    {
      if(i==0x10 || i==0x11 || i==0x22 || i==0x27 || i==0x2E || i==0x31 || i==0x34 || i==0x36 || i==0x37 || i==0x3e || i==0x28 ||  i==0x85)
      {
        if(_Check_Serve(i,0,0) != -1) 
          continue;
        if(i == 0x31)
          continue;
      }
      data_[0] = i;
      _Send_Diag_NoTime(1,ID,data_);
      _get_NRC11(ID);
      testWaitForTimeout(200);
    }
  }
}

void _NRC22_Test(dword ID,byte Session,byte Serv_,byte Type)/*遍历NRC22条件*/
{
  int Serve_Pos,i;
  int Fun_Count;
  char Temp_Str[200];
  char Temp_Str_[200];
  int Clear_Config_Flage,SWhere;
  if(Serv_ != 0x31)
    Serve_Pos = _Check_Serve(Serv_,0,0);
  snprintf(Temp_Str,elCount(Temp_Str),"");
  snprintf(Temp_Str_,elCount(Temp_Str_),"");
  snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务",Serv_);
  if(Serv_ != 0x31)
  {
    if(Serve_Pos != -1)
    {
      Fun_Count = Serve_Data[Serve_Pos].Serve_Fun_Count;
      Clear_Config_Flage = 0;
      if(Serv_ == 0x22)  //22服务特殊处理,仅验证一个
        Fun_Count = 1;
      else if(Serv_ == 0x2E)
      {
        _get_Str_Traversal("DID_2E_Traversal");
        Fun_Count = Traversal_Count;
        if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
        {
          for(i=0;i<Traversal_Count;i++)
          {
            if((strncmp(Traversal_DID[i],"DID2E_F1A1",strlen(Traversal_DID[i])) == 0 && strlen(Traversal_DID[i]) == strlen("DID2E_F1A1")) || (strncmp(Traversal_DID[i],"DID2E_2100",strlen(Traversal_DID[i])) == 0 && strlen(Traversal_DID[i]) == strlen("DID2E_2100")))
            {
              SWhere = i;
              Clear_Config_Flage = 1;
              break;
            }
          }
          if(Clear_Config_Flage == 1)
          {
            byte Data_Send[11] = {0x2E,0xF1,0xA1,0,0,0,0,0,0,0,0x55};
            _unlockECU();
            _Send_Diag(11,phyreq_ID,Data_Send);
            _TestResult(SendData,ID,"",-1);
            _SetSession(Session);
          }
        }  
      }
      for(i=0;i<Fun_Count;i++)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务%02X子功能,NRC22条件",Serv_,Serve_Data[Serve_Pos].Serve_Fun[i]);
        if(Serv_ == 0x14)
          snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务,NRC22条件",Serv_);
        if(_Check_Fun_IDAndSess(Serv_,Serve_Data[Serve_Pos].Serve_Fun[i],ID,Session) == 1)
        {
          _WriteEx_and_Report("","------------------------------------------------------");
          _WriteEx_and_Report("",Temp_Str);
          _WriteEx_and_Report("","------------------------------------------------------");
          _NRC22_Test_Loop(Serv_,i,ID,Session,Type);
        }
        else
        {
          snprintf(Temp_Str_,elCount(Temp_Str_),"0x%02X 0x%02X",Serv_,Serve_Data[Serve_Pos].Serve_Fun[i]);
          _WriteEx_and_Report(Temp_Str_,"当前寻址或会话下不支持该子功能");
        }
      }
      if(Clear_Config_Flage == 1)
      {
        _unlockECU();
        _get_2E_DID(Traversal_DID[SWhere]);
        _Send_Diag(DID_2E_SendData_1_Len,phyreq_ID,DID_2E_SendData_1);
        _TestResult(SendData,ID,"",-1);
      }
    }
  }
  else if(Serv_ == 0x31)
  {
    byte Send_Data[50];
    char comment[50];
    snprintf(comment,elCount(comment),"未在Struct中查询到31服务 NRC 检测例程：31");
    snprintf(comment,elCount(comment),"%s %02X",comment,(Serve31_NRC_Case >> 16) & 0xFF);
    snprintf(comment,elCount(comment),"%s %02X",comment,(Serve31_NRC_Case >> 8) & 0xFF);
    snprintf(comment,elCount(comment),"%s %02X",comment,Serve31_NRC_Case & 0xFF);
    for(i=0;i<Serve_31_Hex_Count;i++)
    {
      _Get_31_ServeData(i,Send_Data,2,0);
      
      if((Send_Data[2] == ((Serve31_NRC_Case >> 8) & 0xFF)) && (Send_Data[3] == (Serve31_NRC_Case & 0xFF)))
      {
          Serve_Pos = i;
          break;
      }
    }
    if(i == Serve_31_Hex_Count)
    {
      writeEx(-3,1,comment);
      testStepFail("",comment);
      return;
    }
    snprintf(Temp_Str,elCount(Temp_Str),"     开始测试%02X服务%02X%02X例程,NRC22条件",Serv_,Serve_31_Hex[i].Routine[0],Serve_31_Hex[i].Routine[1]);
    {
      _WriteEx_and_Report("","------------------------------------------------------");
      _WriteEx_and_Report("",Temp_Str);
      _WriteEx_and_Report("","------------------------------------------------------");
      _NRC22_Test_Loop(Serv_,i,ID,Session,Type);
    }
  }
}
void _85_Serve_01(dword ID,byte session)/*NRC7F*/
{
  byte Send_Data[2] = {0x85,0x03};
  if(_Check_Serve_IDAndSess_(0X85,ID,session) != -1)
  {
    if(session == defsession)
    {
      _Send_Diag(7,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC7F);
    }
    else
      _WriteEx_and_Report("","当前测试为默认会话");
  }
}
void _85_Serve_02(dword ID,byte session)/*85 01/02*/
{
  byte Send_Data[2] = {0x85,0x01};
  int Status = -1;
  Status = _Check_Serve_IDAndSess(0X85,ID,session);
  if( Status != -1)
  {
    Send_Data[1] = 0x01;
    _Send_Diag(2,ID,Send_Data);
    if(Status == 1)
      _TestResult(SendData,ID,"",-1);
    else
      _TestResult(SendData,ID,"",NRC7F);
    
    Send_Data[1] = 0x02;
    _Send_Diag(2,ID,Send_Data);
    if(Status == 1)
      _TestResult(SendData,ID,"",-1);
    else
      _TestResult(SendData,ID,"",NRC7F);
  }
}
void _85_Serve_03(dword ID,byte session)/*85 81/82*/
{
  byte Send_Data[2] = {0x85,0x01};
  byte Addres;
  int Status = -1;
  Status = _Check_Serve_IDAndSess(0X85,ID,session);
  if(Status != -1)
  {
    if(_Check_Serve(0x85,0,3)==0)
      _WriteEx_and_Report("","当前服务不支持肯定响应抑制位");
    else
    {
      Send_Data[1] = 0x81;
      _Send_Diag(2,ID,Send_Data);
      if(Status == 0 && ID != funreq_ID)
        _TestResult(SendData,ID,"",NRC7F);
      else
       _TestResult(SendData,ID,"",0);
      Send_Data[1] = 0x82;
      _Send_Diag(2,ID,Send_Data);
      if(Status == 0 && ID != funreq_ID)
        _TestResult(SendData,ID,"",NRC7F);
      else
       _TestResult(SendData,ID,"",0);
    }
  }
}

void _85_Serve_05(dword ID,byte session)/*NRC13*/
{
  byte Send_Data[2];
  int Len,Serve_Pos;
  int i;
  int Status = -1;
  Status = _Check_Serve_IDAndSess(0X85,ID,session);
  Send_Data[0]= 0x85;
  Serve_Pos = _Check_Serve(0x85,0,0);
  Send_Data[1]= Serve_Data[Serve_Pos].Serve_Fun[0];
  Len = _Check_CANFD_Flage();
  if(Status== 1)
  {
    for(i=1;i<=Len;i++)
    {
      if(i==Serve_Data[Serve_Pos].Serve_Fun_Len[0])
        continue;
      _Send_Diag(i,ID,Send_Data);
      _TestResult(SendData,ID,"",NRC13);
      testWaitForTimeout(50);
    }
  }
}

void _85_Serve_06(dword ID,byte session)/*NRC12*/
{
  byte Send_Data[2] = {0x85,0x03};
  int i;
  int Status = -1;
  Status = _Check_Serve_IDAndSess(0X85,ID,session);
  if(Status != -1)
  {
    for(i=0;i<=0xff;i++)
    {
      Send_Data[1] = i;
//      if((_Check_Serve(0x85,i,4)!= -1) || (_Check_Serve(0x85,i&0x7F,4)!= -1))
      if(_Check_Serve(0x85,i,4)!= -1)
        continue;
      _Send_Diag(2,ID,Send_Data);
      if(Status == 0)
        _TestResult(SendData,ID,"",NRC7F);
      else if(ID == funreq_ID || (_Check_Serve(0x85,i&0x7F,4)!= -1))
        _TestResult(SendData,ID,"",0);
      else
        _TestResult(SendData,ID,"",NRC12);
    }
  }
}

void _85_Serve_NRC(dword ID,byte session)/*NRC优先级*/
