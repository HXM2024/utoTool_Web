  }
  testCaseComment(comment);
}

_TPgetFC(byte passcondition)   //流控帧--------仅当为0时期望不收到流控帧,当为0x30或0x32时判断当前Byte0相匹配
{
  message 0x00 msg;
  char comment[50];
  byte i;
  if(testWaitForMessage(@DID::Response_ID,1000))
  {
    testGetWaitEventMsgData(msg);
    
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    }
    testCaseComment(comment);
    
    if((msg.byte(0)&0xF0)==0x30)
    {
      getFS=msg.byte(0)&0x0F;
      
      if(passcondition==0)
        testStepFail("收到流控帧");
      else if(passcondition == 0x30)
      {
        if((msg.byte(0)==0x30)&&(msg.byte(1)==BS)&&(msg.byte(2)==STmin)&&(msg.byte(3)==TP_filler)&&(msg.byte(4)==TP_filler)&&(msg.byte(5)==TP_filler)&&(msg.byte(6)==TP_filler)&&(msg.byte(7)==TP_filler))
        {
          testStepPass("收到流控帧,格式正确");
        }
        else
          testStepFail("收到流控帧，但格式不正确");
      }
      else if(passcondition == 0x32)
      {
        if((msg.byte(0)==0x32)&&(msg.byte(1)==BS)&&(msg.byte(2)==STmin)&&(msg.byte(3)==TP_filler)&&(msg.byte(4)==TP_filler)&&(msg.byte(5)==TP_filler)&&(msg.byte(6)==TP_filler)&&(msg.byte(7)==TP_filler))
        {
          testStepPass("收到流控帧,格式正确");
        }
        else
          testStepFail("收到流控帧，但格式不正确");
      }
      else
      {
        if((msg.byte(0)==0x30)&&(msg.byte(1)==BS)&&(msg.byte(2)==STmin)&&(msg.byte(3)==TP_filler)&&(msg.byte(4)==TP_filler)&&(msg.byte(5)==TP_filler)&&(msg.byte(6)==TP_filler)&&(msg.byte(7)==TP_filler))
        {
          testStepPass("收到流控帧,格式正确");
        }
       else if ((msg.byte(0)==0x32)&&(msg.byte(1)==BS)&&(msg.byte(2)==STmin)&&(msg.byte(3)==TP_filler)&&(msg.byte(4)==TP_filler)&&(msg.byte(5)==TP_filler)&&(msg.byte(6)==TP_filler)&&(msg.byte(7)==TP_filler))
        {
          testStepPass("收到流控帧,格式正确");
        }
        else
          testStepFail("收到流控帧，但格式不正确");
      }
    }
    else
      testStepFail("收到非流控帧");
  }
  else
  {
    if(passcondition==0)
      testStepPass("未收到流控帧或数据帧");
    else
      testStepFail("未收到流控帧或数据帧");
  }
}
_Check_TPgetFC_FS(byte FS)   //流控帧--------仅当为0时期望不收到流控帧
{
  message 0x00 msg;
  char comment[50];
  byte i;
  byte byte_0;
  if(testWaitForMessage(@DID::Response_ID,1000))
  {
    testGetWaitEventMsgData(msg);
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    }
    testCaseComment(comment);
    
    if((msg.byte(0)&0xF0)==0x30)
    {
      byte_0 = (0x30|FS);
      if((msg.byte(0)==byte_0)&&(msg.byte(1)==BS)&&(msg.byte(2)==STmin)&&(msg.byte(3)==TP_filler)&&(msg.byte(4)==TP_filler)&&(msg.byte(5)==TP_filler)&&(msg.byte(6)==TP_filler)&&(msg.byte(7)==TP_filler))
      {
        testStepPass("收到流控帧,格式正确,FS正确");
      }
      else
        testStepFail("收到流控帧，但格式不正确");
    }
    else
      testStepFail("收到流控帧或FS错误");
  }
  else
  {
    testStepFail("未收到流控帧或数据帧");
  }
}

int _TPgetFF(byte passcondition)//首帧--------仅当为0时期望不收到首帧
{
  message 0x00 msg;
  char comment[50];
  int Len;
  byte i;
  Len = 0;
  if(testWaitForMessage(@DID::Response_ID,1000))
  {
    testGetWaitEventMsgData(msg);
    
    snprintf(comment,elCount(comment),"已收到报文");
    for(i=0;i<8;i++)
    {
      snprintf(comment,elCount(comment),"%s %02X",comment,msg.byte(i));
    }
    testCaseComment(comment);
    
    if((msg.byte(0)&0xF0)==0x10)
    {
      if(passcondition==0)
        testStepFail("收到首帧");
      else
      {
        testStepPass("收到首帧");
        Len = (msg.byte(0)&0x0F);
        Len = (int)(Len*256 + msg.byte(1));
      }
    }
    else
      testStepFail("收到非首帧");
  }
  else
  {
    if(passcondition==0)
      testStepPass("未收到首帧或数据帧");
    else
      testStepFail("未收到首帧或数据帧");
  }
  return Len;
}

