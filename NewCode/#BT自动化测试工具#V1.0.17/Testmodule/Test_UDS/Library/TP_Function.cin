_CANFD_TP_FC_8() /*控制器收到的BlockSize测试*/
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte BlockSize[5] = {0x00,0x01,0x02,0x08,0xFF};
  int i,j,FF_DL,Temp_SN,Fal;
  
  if(DID_22_Support>=3)
  {
    Data_Send_1[0] = 0x07;
    Data_Send_1[4] = 0x35;
    Data_Send_1[5] = 0x70;
    Data_Send_1[6] = 0x35;
    Data_Send_1[7] = 0x70;
  }
  for(j=0;j<elcount(BlockSize);j++)
  {
    Data_Send_2[1] = BlockSize[j];
    _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
    FF_DL = _TPgetFF(1);
    _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
    Temp_SN = _Get_CF_SN(FF_DL);
    if(BlockSize[j] != 0)
    {
      for(i=1;i<=BlockSize[j];i++)
      {
        if(i>Temp_SN)
          break;
        _Check_TPgetCF(1,FF_DL,i);
      }
      Fal = _Check_NoResponse_(500);
      if(Fal == -1)
        testStepFail("","0x%02X BlockSize块收到超过预期的流控帧数量",BlockSize[j]);
      else
        testStepPass("","0x%02X BlockSize块收到符合预期的流控帧数量",BlockSize[j]);
    }
    else
    {
      for(i=1;i<=Temp_SN;i++)
        _Check_TPgetCF(1,FF_DL,i);
      Fal = _Check_NoResponse_(500);
      if(Fal == -1)
        testStepFail("","0x%02X BlockSize块收到超过预期的流控帧数量",BlockSize[j]);
      else
        testStepPass("","0x%02X BlockSize块收到符合预期的流控帧数量",BlockSize[j]);
    
    }
    testWaitForTimeout(3000);
  }
}

_CANFD_TP_FC_10() /*无效流控制帧-FS无效值*/
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Da[3] = {0x33,0x39,0x3F};
  int i;
  
  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  _TPgetFF(1);
  for(i=0;i<elcount(Da);i++)
  {
    _Check_NoResponse(20);
    Data_Send_2[0] = Da[i];
    _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
  }
  _Check_NoResponse(500);
}

_CANFD_TP_FC_11() /*等待流控制帧*/
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x31,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Data_Send_3[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  int i,FF_DL,Temp_SN;
  
  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  _TPgetFF(1);
  _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
  _Check_NoResponse(N_Bs_Time+5);
  _TPsendmsg_Phy(Data_Send_3,elcount(Data_Send_3),1);
  _Check_NoResponse(500);
  testWaitForTimeout(2000);
  
  _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),1);
  FF_DL = _TPgetFF(1);
  Temp_SN = _Get_CF_SN(FF_DL);
  _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),1);
  _Check_NoResponse(N_Bs_Time-5);
  _TPsendmsg_Phy(Data_Send_3,elcount(Data_Send_3),1);
  for(i=1;i<=Temp_SN;i++)
    _Check_TPgetCF(1,FF_DL,i);
  
  testWaitForTimeout(2000);
}

