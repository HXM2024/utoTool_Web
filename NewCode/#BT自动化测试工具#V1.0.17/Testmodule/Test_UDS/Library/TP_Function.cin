_CANFD_TP_CF_6() /*连续帧SN值测试*/
{
  byte Data[64] = {0x12,0xB4,0x22,0x80,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11};
  byte Data_1[64] = {0x21,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11,0x11};
  int i,j,flage,m,Start_Byte;
  int Wait_Time;
  m=1;
  Start_Byte = 0x20;
  _Get_DID_TP(Data,3);
  _TPsendmsg_Phy(Data,elcount(Data),1);
  _TPgetFC(1);
  for(i=Start_Byte;i<=0x29;i++)
  {
    Data_1[0] = i;
    _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
    _Check_NoResponse(STmin+5);
  }
  _Check_NoResponse(N_Cr_Time);
  testWaitForTimeout(2000);
  
  Wait_Time = N_Cr_Time - STmin -10;
  if(Wait_Time<=0)
    Wait_Time = STmin;
  Data[0] = 0x14;
  Data[1] = 0xEB;
  /*SN>15从1开始*/
  flage = 0;
  m=1;
  Start_Byte = 0x21;
  _Get_DID_TP(Data,3);
  _TPsendmsg_Phy(Data,elcount(Data),1);
  _TPgetFC(1);
  for(j=0;j<2;j++)
  {
    if(flage == 0)
    {
      for(i=Start_Byte;i<=0x2F;i++)
      {
        if(j==1 && i ==0x24)
        {
          flage = 1;
          break;
        }
        Data_1[0] = i;
        testWaitForTimeout(STmin+5);
        _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
        m++;
        if(BS == 0)
          _Check_NoResponse(Wait_Time);
        else
        {
          if(j==0 && m==BS+1)
            _TPgetFC(1);
          else if( m==BS+1)
            _Check_NoResponse(Wait_Time);
          if(m==BS+1)
            m=1;
        }
      }
    }
  }
  _TPgetCF(0);
  testWaitForTimeout(2000);
  
  /*SN>15从0开始*/
  Data[0] = 0x14;
  Data[1] = 0xEB;
  flage = 0;
  m=1;
  Start_Byte = 0x21;
  _TPsendmsg_Phy(Data,elcount(Data),1);
  _TPgetFC(1);
  for(j=0;j<2;j++)
  {
    if(flage == 0)
    {
      for(i=Start_Byte;i<=0x2F;i++)
      {
        if(j==0 && i==0x2F)
          Start_Byte = 0x20;
        Data_1[0] = i;
        testWaitForTimeout(STmin+5);
        _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
        if(j==1 && i ==0x23)
        {
          flage = 1;
          break;
        }
        m++;
        if(BS == 0)
          _Check_NoResponse(Wait_Time);
        else
        {
          if( m==BS+1)
          {
            _TPgetFC(1);
            m=1;
          }
        }
      }
    }
  }
  _Check_NRC(0);
  testWaitForTimeout(1000);
}
