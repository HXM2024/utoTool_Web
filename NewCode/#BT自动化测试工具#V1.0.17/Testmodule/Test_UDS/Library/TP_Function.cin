      _TPsendmsg_Fun(Data_3,elCount(Data_3),1);
      _TPgetFF(1);
      _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),1);
      _TPsendmsg_Fun(Data_3,elCount(Data_3),1);
      _TPgetCF(1);
      
      testWaitForTimeout(1000);
    }
  }
  testWaitForTimeout(1000);
  
  {
    byte Data_Send[8] = {0x07,0x22,0x35,0x70,0x35,0x70,0x35,0x70};
    byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
    byte Data_Send_2[8] = {0x30,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
    int i,Len,Temp_SN;
    if(DID_22_Support>=3)
    {
      _TPsendmsg_Phy(Data_Send,elCount(Data_Send),1);
      Len = _TPgetFF(1);
      _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),1);
      _TPgetCF_21(1);
      _TPsendmsg_Phy(Data_3,elCount(Data_3),1);
      if(MF_Phy_SF_TxDisturb==0)
      {
        Temp_SN = _Get_CF_SN(Len);
        for(i=2;i<=Temp_SN;i++)
          _Check_TPgetCF(1,Len,i);
      }
      else
        _Check_NoResponse(p2cmax);
    }
    else
    {
      _TPsendmsg_Phy(Data_Send_1,elCount(Data_Send_1),1);
      Len = _TPgetFF(1);
      _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),1);
      _TPsendmsg_Phy(Data_3,elCount(Data_3),1);
      if(MF_Phy_SF_TxDisturb==0)
      {
        Temp_SN = _Get_CF_SN(Len);
        for(i=1;i<=Temp_SN;i++)
          _Check_TPgetCF(1,Len,i);
      }
      else
        _Check_NoResponse(p2cmax);
    }
  }
}
