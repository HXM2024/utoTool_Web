_CANFD_TP_Time_1()/* N_Bs时间测试 */
{
  byte Data[64] = {0x10,0xBC,0x22,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x30,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_2[8] = {0x03,0x22,0x22,0x00,0x00,0x00,0x00,0x00};
  double start_time;
  double end_time;
  int i,Temp_SN,Len;
  
  _Get_DID_TP(Data,3);
  _Get_DID_TP(Data_2,2);
  _TPsendmsg_Phy(Data,elCount(Data),1);
  start_time=(double)timeNow()/100;
  _TPgetFC(1);
  end_time=(double)timeNow()/100;
  if(end_time - start_time <= N_Bs_Time)
    testStepPass("","N_Bs响应时间在规定范围内");
  else
    testStepFail("","N_Bs响应时间不在规定范围内%.2f ms",(end_time - start_time));
  testWaitForTimeout(1000);
  {
    _TPsendmsg_Phy(Data_2,elCount(Data_2),1);
    _TPgetFF(1);
    _Check_NoResponse(N_Bs_Time + N_Bs_Time_Tolerance);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
    _TPgetFC(0);
  }
  testWaitForTimeout(1000);
  {
    _TPsendmsg_Phy(Data_2,elCount(Data_2),1);
    Len = _TPgetFF(1);
    _Check_NoResponse(N_Bs_Time - N_Bs_Time_Tolerance);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
    Temp_SN = _Get_CF_SN(Len);
    for(i=1;i<=Temp_SN;i++)
      _Check_TPgetCF(1,Len,i); 
  }
}
