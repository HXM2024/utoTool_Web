_CANFD_TP_FC_1()/* EPS应答流控帧BS值测试 */
{
  byte Data[64] = {0x1F,0xFF,0x2e,0x3a,0x19,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_1[64] = {0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_03[8] = {0x02,0x10,0x03,0x00,0x00,0x00,0x00,0x00};
  
  int i;
  int Max_Count,CF_Byte,BS_Count;
  
  Data[0] = ((FF_DL_Max>>8) | 0x10);
  Data[1] = (FF_DL_Max & 0xFF);

  Max_Count = _ceil(((((Data[0]&0xF)<<8) | Data[1])-62)/63.0);
  _TPsendmsg_Phy(Data,elCount(Data),1);
  _TPgetFC(1);
  BS_Count = 1;
  CF_Byte = 0x20;
  for(i=0;i<Max_Count;i++)
  {
    if(CF_Byte>=0x30)
      CF_Byte = 0x20;
    if(i==0 & CF_Byte==0x20)
      CF_Byte=0x21;
    Data_1[0] = CF_Byte;
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
    BS_Count++;
    if(BS!=0 && BS_Count == BS+1)
    {
      _TPgetFC(1);
      BS_Count = 1;
    }
    else if(BS==0 && BS_Count == BS+1)
    {
      _Check_NoResponse(p2cmax);
      BS_Count = 1;
    }
    CF_Byte++;
  }
  _Check_NRC(3);
  
  
  testWaitForTimeout(2000);
  _TPsendmsg_Phy(Data_03,elCount(Data_03),1);
  _TPgetSF(1);
  testWaitForTimeout(100);
  _TPsendmsg_Phy(Data,elCount(Data),1);
  _TPgetFC(1);
  BS_Count = 1;
  CF_Byte = 0x20;
  for(i=0;i<Max_Count;i++)
  {
    if(CF_Byte>=0x30)
      CF_Byte = 0x20;
    if(i==0 & CF_Byte==0x20)
      CF_Byte=0x21;
    Data_1[0] = CF_Byte;
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
    BS_Count++;
    if(BS!=0 && BS_Count == BS+1)
    {
      _TPgetFC(1);
      BS_Count = 1;
    }
    else if(BS==0 && BS_Count == BS+1)
    {
      _Check_NoResponse(p2cmax);
      BS_Count = 1;
    }
    CF_Byte++;
  }
  _Check_NRC(3);
  
}

_CANFD_TP_Stmin_1()/* Stmin值测试 */
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Stmin[3] = {0x01,0x0A,0x1E};
  int i,j;
  int FF_DL,Temp_SN;
  double start_time,end_time,Min_Time,DiffTime;
  char Temp_Str[50];
  int Time_Send;
  
  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  for(j=0;j<elcount(Stmin);j++)
  {
    Min_Time = 2000;
    Data_Send_2[2] = Stmin[j];
    
    _TPsendmsg_Phy(Data_Send_1,elCount(Data_Send_1),1);
    FF_DL = _TPgetFF(1);
    Temp_SN = _Get_CF_SN(FF_DL);
    _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),1);
    
    _Check_TPgetCF(1,FF_DL,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,FF_DL,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime<=Min_Time)
        Min_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    Time_Send = _min(Stmin[j],N_Cs_Time);
    if(Time_Send != N_Cs_Time)
    {
      if(Min_Time<Time_Send)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"");
        for(i=0;i<3;i++)
          snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
        testStepFail(Temp_Str,"最小间隔时间小于 %d ms",Time_Send);
      }
      else
        testStepPass("","最小间隔时间符合需求不小于 %d ms",Stmin[j]);
    }
    else
    {
      if(Min_Time<=N_Cs_Time - N_Cs_Time_Tolerance)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"");
        for(i=0;i<3;i++)
          snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
        testStepFail(Temp_Str,"最小间隔时间小于 %d ± %dms",N_Cs_Time,N_Cs_Time_Tolerance);
      }
      else if(Min_Time>=N_Cs_Time + N_Cs_Time_Tolerance)
      {
        snprintf(Temp_Str,elCount(Temp_Str),"");
        for(i=0;i<3;i++)
          snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
        testStepFail(Temp_Str,"最小间隔时间大于 %d ± %dms",N_Cs_Time,N_Cs_Time_Tolerance);
      }
      else
        testStepPass("","最小间隔时间符合需求不小于 %d ms",Stmin[j]);
    }
    testWaitForTimeout(3000);
  }
}

_CANFD_TP_Stmin_1_()/* Stmin值测试_边界值 */
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Stmin[5] = {0x01,0x0A,0x1E,0x41,0x7F};
  int i,j,End_;
  int FF_DL,Temp_SN;
  double start_time,end_time,Min_Time,Max_Time,DiffTime;
  char Temp_Str[50];
  
  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  Stmin[0] = N_Cs_Time-10;
  Stmin[1] = N_Cs_Time;
  Stmin[2] = N_Cs_Time+10;
  if(N_Cs_Time<0x7F)
  {
    Stmin[3] = (N_Cs_Time + 127)/2;
    End_ = 5;
  }
  else
  {
    End_ = 4;
    Stmin[3] = 0x7F;
  }
    
  for(j=0;j<End_;j++)
  {
    Min_Time = 2000;
    Max_Time = 0;
    Data_Send_2[2] = Stmin[j];
    
    _TPsendmsg_Phy(Data_Send_1,elCount(Data_Send_1),1);
    FF_DL = _TPgetFF(1);
    Temp_SN = _Get_CF_SN(FF_DL);
    _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),1);
    
    _Check_TPgetCF(1,FF_DL,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,FF_DL,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime<=Min_Time)
        Min_Time  = DiffTime;
      if(DiffTime>=Max_Time)
        Max_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    if(j==0)
    {
      if(Min_Time<=Stmin[j])
      {
        snprintf(Temp_Str,elCount(Temp_Str),"");
        for(i=0;i<3;i++)
          snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
        testStepFail(Temp_Str,"最小间隔时间小于 %d ms",Stmin[j]);
      }
      else
        testStepPass("","最小间隔时间符合需求不小于 %d ms",Stmin[j]);
    }
    else if(j==1)
    {
      if(Min_Time<(Stmin[j] - N_Cs_Time_Tolerance) || Max_Time>(Stmin[j] + N_Cs_Time_Tolerance))
      {
        snprintf(Temp_Str,elCount(Temp_Str),"");
        for(i=0;i<3;i++)
          snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
        testStepFail(Temp_Str,"间隔时间不符合 %d ±%dms",Stmin[j],N_Cs_Time_Tolerance);
      }
      else
        testStepPass("","间隔时间符合需求 %d ±%dms",Stmin[j],N_Cs_Time_Tolerance);
    }
    else
    {
      if(Max_Time>(N_Cs_Time + N_Cs_Time_Tolerance))
      {
        snprintf(Temp_Str,elCount(Temp_Str),"");
        for(i=0;i<3;i++)
          snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
        testStepFail(Temp_Str,"最大间隔时间大于 %d +%dms",N_Cs_Time,N_Cs_Time_Tolerance);
      }
      else
        testStepPass("","最大间隔时间符合需求不大于 %d +%dms",N_Cs_Time,N_Cs_Time_Tolerance);
    }
    testWaitForTimeout(3000);
  }
}
_CANFD_TP_Stmin_2()/* Stmin无效测试-us级值 */
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Stmin[3] = {0xF1,0xF5,0xF9};
  int i,j;
  int FF_DL,Temp_SN;
  double start_time,end_time,Min_Time,DiffTime,Max_Time;
  char Temp_Str[50];
  float _us;
  
  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  for(j=0;j<elcount(Stmin);j++)
  {
    Min_Time = 2000;
    Max_Time = 0;
    _us = (Stmin[j]&0x0F)*0.1;
    Data_Send_2[2] = Stmin[j];
    
    _TPsendmsg_Phy(Data_Send_1,elCount(Data_Send_1),1);
    FF_DL = _TPgetFF(1);
    Temp_SN = _Get_CF_SN(FF_DL);
    _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),1);
    
    _Check_TPgetCF(1,FF_DL,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,FF_DL,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime <= Min_Time)
        Min_Time  = DiffTime;
      if(DiffTime >= Max_Time)
        Max_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    if(Min_Time<=_us)
    {
      snprintf(Temp_Str,elCount(Temp_Str),"");
      for(i=0;i<3;i++)
        snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
      testStepFail(Temp_Str,"最小间隔时间小于 %.2f ms",_us);
    }
    else
      testStepPass("","最小间隔时间符合需求不小于 %.2f ms",_us);
    if(Max_Time>=N_Cr_Time)
    {
      snprintf(Temp_Str,elCount(Temp_Str),"");
      for(i=0;i<3;i++)
        snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
      testStepFail(Temp_Str,"最大间隔时间大于 %d ms",N_Cr_Time);
    }
    else
      testStepPass("","最大间隔时间符合需求不大于 %d ms",N_Cr_Time);
    
    testWaitForTimeout(3000);
  }
}

_CANFD_TP_Stmin_3()/* Stmin无效测试-保留值 */
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Stmin[5] = {0x80,0xB0,0xF0,0xFA,0xFF};
  int i,j;
  int FF_DL,Temp_SN;
  double start_time,end_time,Min_Time,DiffTime;
  char Temp_Str[50];
  
  _Get_DID_TP(Data_Send_1,2);
  Data_Send_1[0] = 1 + _TP_CAN_DID_Input;
  for(j=0;j<elcount(Stmin);j++)
  {
    Min_Time = 2000;
    Data_Send_2[2] = Stmin[j];
    
    _TPsendmsg_Phy(Data_Send_1,elCount(Data_Send_1),1);
    FF_DL = _TPgetFF(1);
    Temp_SN = _Get_CF_SN(FF_DL);
    _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),1);
    
    _Check_TPgetCF(1,FF_DL,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,FF_DL,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime<=Min_Time)
        Min_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    if(Min_Time>(N_Cs_Time + N_Cs_Time_Tolerance) || Min_Time<(N_Cs_Time - N_Cs_Time_Tolerance))
    {
      snprintf(Temp_Str,elCount(Temp_Str),"");
      for(i=0;i<3;i++)
        snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
      testStepFail(Temp_Str,"最小间隔时间小于 %d ±%dms",N_Cs_Time,N_Cs_Time_Tolerance);
    }
    else
      testStepPass("","最小间隔时间符合需求不小于 %d ms",N_Cs_Time);
    
    testWaitForTimeout(3000);
  }
}

_CANFD_TP_FC_2() /*确认控制器发送的流控帧中的BS和STmin*/
{
