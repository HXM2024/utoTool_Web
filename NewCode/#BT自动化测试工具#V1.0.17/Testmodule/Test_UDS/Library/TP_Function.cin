  byte Data_4[64] = {0x22,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00};

  int i,j;
  int FF_DL,Temp_SN;
  double start_time,end_time,Min_Time,Max_Time,DiffTime;
  
  _Get_DID_TP(Data,2);
  Data[0] = 1 + _TP_CAN_DID_Input;
  _Init_Struct();
  {
    Min_Time = 1000;
    Max_Time = 1;
    _TPsendmsg_Phy(Data,elCount(Data),1);
    FF_DL = _TPgetFF(1);
    Temp_SN = _Get_CF_SN(FF_DL);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
    _Check_TPgetCF(1,FF_DL,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,FF_DL,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime<=Min_Time)
        Min_Time  = DiffTime;
      if(DiffTime>=Max_Time)
        Max_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    if(Max_Time<N_Cr_Time)
      testStepPass("","N_Cr时间符合需求，最大间隔时间为 %d ms",Max_Time);
    else
      testStepFail("","最大间隔时间为 %d ms ,大于预期时间 %d ms",Max_Time,N_Cr_Time);
  }
  testWaitForTimeout(3000);
  
  if(_Check_Serve_IDAndSess(0x22,@DID::funreq_ID,defsession) == 1)
  {
    Min_Time = 1000;
    Max_Time = 1;
    _TPsendmsg(Data,elCount(Data),@DID::funreq_ID,1);
    FF_DL = _TPgetFF(1);
    Temp_SN = _Get_CF_SN(FF_DL);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
    
    _Check_TPgetCF(1,FF_DL,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,FF_DL,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime<=Min_Time)
        Min_Time  = DiffTime;
      if(DiffTime>=Max_Time)
        Max_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    if(Max_Time<N_Cr_Time)
      testStepPass("","N_Cr时间符合需求，最大间隔时间为 %d ms",Max_Time);
    else
      testStepFail("","最大间隔时间为 %d ms ,大于预期时间 %d ms",Max_Time,N_Cr_Time);
  }
  testWaitForTimeout(3000);
  
  {
    _TPsendmsg_Phy(Data_2,elCount(Data_2),1);
    _TPgetFC(1);
    testWaitForTimeout(N_Cr_Time + N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_3,elCount(Data_3),1);
    _TPgetCF_21(0);
  }
  testWaitForTimeout(1000);
  {
    _TPsendmsg_Phy(Data_2,elCount(Data_2),1);
    _TPgetFC(1);
    testWaitForTimeout(N_Cr_Time - N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_3,elCount(Data_3),1);
    _Check_NRC(0);
  }
  testWaitForTimeout(3000);
  
  Data_2[1] = 0xBC;
  {
    _TPsendmsg_Phy(Data_2,elCount(Data_2),1);
    _TPgetFC(1);
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_3,elCount(Data_3),1);
    testWaitForTimeout(N_Cr_Time + N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_4,elCount(Data_4),1);
    _TPgetCF_21(0);
  }
  testWaitForTimeout(1000);
  {
    _TPsendmsg_Phy(Data_2,elCount(Data_2),1);
    _TPgetFC(1);
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_3,elCount(Data_3),1);
    testWaitForTimeout(N_Cr_Time - N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_4,elCount(Data_4),1);
    _Check_NRC(0);
  }
}


_CANFD_TP_Time_4()/* N_Cs时间测试 */
{
  byte Data[8] = {0x03,0x22,0x35,0x70,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x30,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  double start_time,start_time2,start_time3;
  int i,Temp_SN;
  _Get_DID_TP(Data,2);
  Data[0] = 1 + _TP_CAN_DID_Input;
  //待修改判断，当某个项目不支持多个DID读取时测试间隔时间改为发送流控帧时间到接收到第一帧后续帧时间
  _TPsendmsg_Phy(Data,elCount(Data),1);
  _TPgetFF(1);
  start_time=(double)timeNow()/100;
  _TPsendmsg_Phy(Data_1,elCount(Data_1),1);
  _TPgetCF(1);
  start_time2=(double)timeNow()/100;
  _TPgetCF(1);
  start_time3=(double)timeNow()/100;
  testWaitForTimeout(1000);
  if(start_time2 - start_time <= N_Cs_Time + N_Cs_Time_Tolerance)
    testStepPass("","连续帧1：N_Cs响应时间在规定范围内");
  else
    testStepFail("","连续帧1：N_Cs响应时间不在规定范围内%.2f ms",(start_time2 - start_time));
  if(start_time3 - start_time2 <= N_Cs_Time + N_Cs_Time_Tolerance)
    testStepPass("","连续帧2：N_Cs响应时间在规定范围内");
  else
    testStepFail("","连续帧2：N_Cs响应时间不在规定范围内%.2f ms",(start_time3 - start_time2));
}
