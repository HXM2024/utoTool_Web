_CAN_TP_CF_13()/*重复发送流控制帧*/
{
  byte Data[8] = {0x03,0x22,0x22,0x00,0x55,0x55,0x55,0x55};
  byte Data_1[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte Data_2[8] = {0x30,0x00,0x28,0x55,0x55,0x55,0x55,0x55};
  int i,Temp_SN,FF_DL;
  double start_time,end_time,Min_Time,DiffTime;
  char Temp_Str[50];
  _Get_DID_TP(Data,2);
  Data_1[2] = N_Cs_Time;
  Data_2[2] = 0x01;
  Data[0] = 1 + _TP_CAN_DID_Input;
  Min_Time = 2000;
  _TPsendmsg_Phy(Data,elCount(Data),0);
  FF_DL = _TPgetFF(1);
  _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
  _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
  Temp_SN=(FF_DL-6)/7;
  if((FF_DL-6)%7 != 0)
    Temp_SN+=1;
  _Check_TPgetCF(1,FF_DL,1);
  for(i=2;i<=Temp_SN;i++)
  {
    start_time = (double)timeNow()/100;
    _Check_TPgetCF(1,FF_DL,i);
    end_time=(double)timeNow()/100;
    DiffTime = (double)(end_time - start_time);
    if(DiffTime<=Min_Time)
      Min_Time  = DiffTime;
    writeEx(-3,0,"%.2f ms",DiffTime);
  }
  _TPgetCF(0);
  if(Min_Time<=N_Cs_Time - N_Cs_Time_Tolerance)
  {
    snprintf(Temp_Str,elCount(Temp_Str),"");
    for(i=0;i<3;i++)
      snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_1[i]);
    testStepFail(Temp_Str,"最小间隔时间小于 %d ms",N_Cs_Time);
  }
}
