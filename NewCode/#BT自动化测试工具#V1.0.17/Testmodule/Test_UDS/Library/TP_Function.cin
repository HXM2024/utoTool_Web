_CAN_TP_Disturb_6() /*控制器多帧接收被新的单帧请求报文干扰*/
{
  byte Data[8] = {0x10,0x11,0x22,0x00,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_2[8] = {0x22,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  
  byte Data_3[8] = {0x02,0x10,0x01,0x55,0x55,0x55,0x55,0x55};
  dword ID;
  _Get_TP_DID("TP_CAN_DID");
  {
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_3,elCount(Data_3),0);
    if(MF_Phy_SF_RxDisturb==1)
    {
      _Check_10_01(1);
      _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
      _TPgetFF(0);
    }
    else
    {
      _Check_NoResponse(p2cmax);
      _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
      _Check_NRC(0);
    }
  } 
  testWaitForTimeout(1000);
  {
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Fun(Data_3,elCount(Data_3),0);
    if(MF_Fun_SF_RxDisturb==1)
    {
      _Check_10_01(1);
      _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
      _TPgetFF(0);
    }
    else
    {
      _Check_NoResponse(p2cmax);
      _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
      _Check_NRC(0);
    }
  } 
  testWaitForTimeout(1000);
  {
    if(phyreq_ID == 0x783)
      ID = 0x785;
    else
      ID = 0x783;
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    testWaitForTimeout(STmin+5);
    _TPsendmsg(Data_3,elCount(Data_3),ID,0);
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
    _Check_NRC(0);
  }
  testWaitForTimeout(1000);
  {
    Data_3[0] = 0x03;
    Data_3[1] = 0x22;
    Data_3[2] = _TP_CAN_DID[0];
    Data_3[3] = _TP_CAN_DID[1];
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_3,elCount(Data_3),0);
    if(MF_Phy_SF_RxDisturb == 1)
    {
      _TPgetFF(1);
      _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
      _TPgetCF(0);
    }
    else
    {
      _Check_NoResponse(p2cmax);
      _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
      _Check_NRC(0);
    }
  }
}
