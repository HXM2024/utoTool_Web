    _TPsendmsg_Phy(Data_Send_2,elCount(Data_Send_2),0);
    if((FF_DL-6)%7 != 0)
      Temp_SN+=1;
    
    _Check_TPgetCF(1,FF_DL,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,FF_DL,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime<=Min_Time)
        Min_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    if(Min_Time>(N_Cs_Time+N_Cs_Time_Tolerance))
    {
      snprintf(Temp_Str,elCount(Temp_Str),"");
      for(i=0;i<3;i++)
        snprintf(Temp_Str,elCount(Temp_Str),"%s 0x%02X",Temp_Str,Data_Send_2[i]);
      testStepFail(Temp_Str,"最小间隔时间小于 %d ±%dms",N_Cs_Time,N_Cs_Time_Tolerance);
    }
    else
      testStepPass("","最小间隔时间符合需求不小于 %d ms",N_Cs_Time);
    
    testWaitForTimeout(3000);
  }
}

_CAN_TP_FC_8() /*控制器收到的BlockSize测试*/
{
  byte Data_Send_1[8] = {0x03,0x22,0x35,0x70,0x55,0x55,0x55,0x55};
  byte Data_Send_2[8] = {0x30,0x00,0x00,0x55,0x55,0x55,0x55,0x55};
  byte BlockSize[5] = {0x00,0x01,0x02,0x08,0xFF};
  int i,j,FF_DL,Temp_SN,Fal;
  if(DID_22_Support>=3)
  {
    Data_Send_1[0] = 0x07;
    Data_Send_1[4] = 0x35;
    Data_Send_1[5] = 0x70;
    Data_Send_1[6] = 0x35;
    Data_Send_1[7] = 0x70;
  }
  for(j=0;j<elcount(BlockSize);j++)
  {
    Data_Send_2[1] = BlockSize[j];
    _TPsendmsg_Phy(Data_Send_1,elcount(Data_Send_1),0);
    FF_DL = _TPgetFF(1);
    _TPsendmsg_Phy(Data_Send_2,elcount(Data_Send_2),0);
    Temp_SN=(FF_DL-6)/7;
    if((FF_DL-6)%7 != 0)
      Temp_SN+=1;
    if(BlockSize[j] != 0)
    {
      for(i=1;i<=BlockSize[j];i++)
      {
        if(i>Temp_SN)
          break;
        _Check_TPgetCF(1,FF_DL,i);
      }
      Fal = _Check_NoResponse_(500);
      if(Fal == -1)
        testStepFail("","0x%02X BlockSize块收到超过预期的流控帧数量",BlockSize[j]);
      else
        testStepPass("","0x%02X BlockSize块收到符合预期的流控帧数量",BlockSize[j]);
    }
    else
    {
      for(i=1;i<=Temp_SN;i++)
        _Check_TPgetCF(1,FF_DL,i);
      Fal = _Check_NoResponse_(500);
      if(Fal == -1)
        testStepFail("","0x%02X BlockSize块收到超过预期的流控帧数量",BlockSize[j]);
      else
        testStepPass("","0x%02X BlockSize块收到符合预期的流控帧数量",BlockSize[j]);
    
    }
    testWaitForTimeout(3000);
  }
}




_Get_DID_TP(byte data[],byte _Start)
{
  int i;
  byte Temp;
  Temp = _Start;
  _Get_TP_DID("TP_CAN_DID");
  data[_Start-1] = 0x22;
  if(elcount(data)<=8)
  {
    if((_TP_CAN_DID_Input + _Start) > 8)
    {
      for(i=0;i<8-Temp;i++)
      {
        data[_Start] = _TP_CAN_DID[i];
        _Start++;
      }
    }
    else
    {
      for(i=0;i<_TP_CAN_DID_Input;i++)
      {
        data[_Start] = _TP_CAN_DID[i];
        _Start++;
      }
    }
  }
  else
  {
    for(i=0;i<_TP_CAN_DID_Input;i++)
    {
      data[_Start] = _TP_CAN_DID[i];
      _Start++;
    }
  }
}
int _Get_CF_SN(int Len)
{
  int Return_Va;
  if(Response_CanFD == 0)
  {
    Return_Va = (Len-6)/7;
    if((Len-6)%7 != 0)
      Return_Va+=1;
  }
  else
  {
    Return_Va = (Len-(64-2))/63;
    if((Len-(64-2))%7 != 0)
      Return_Va+=1;
  }
  return Return_Va;
}


_CANFD_TP_SF_1() /*单帧请求报文（CAN_DL≤8）SF_DL测试*/
{
  byte Data[8] = {0x00,0x22,0xf1,0x80,0x55,0x55,0x55,0x55};
  byte Len[4] = {0x00,0x01,0x08,0x09};
  int i;
  _Get_DID_TP(Data,2);
  for(i=0;i<4;i++)
  {
    Data[0] = Len[i];
    _TPsendmsg_Phy(Data,elCount(Data),1);
    if(Len[i] == 0x01)
      _Check_ResponseRx_(1,300);
    else
      _TPgetSF(0);
    testWaitForTimeout(1000);
  }
}
_CANFD_TP_SF_2() /*单帧请求报文（CAN_DL=12）SF_DL测试*/
{
  byte Data[12] = {0x00,0x22,0xf1,0x80,0x11,0x11,0x11,0x11,0x11,0x11,0x00,0x00};
  byte Len[4] = {0x07,0x08,0x0A,0x0B};
  byte Len_[4] = {0x01,0x08,0x09,0x0A};
  int i;
  _Get_DID_TP(Data,3);
  for(i=0;i<4;i++)
  {
    Data[1] = Len[i];
    _TPsendmsg_Phy(Data,elCount(Data),1);
    if(Len[i] == 0x08 || Len[i] == 0x0A)
      _Check_ResponseRx_(1,300);
    else
      _TPgetSF(0);
    testWaitForTimeout(1000);
  }
  testWaitForTimeout(3000);
  for(i=0;i<4;i++)
  {
    if(i==0)
    {
      _Get_DID_TP(Data,3);
      Data[0] = Len_[i];
      Data[1] = 0x0A;
    }
    else
    {
      Data[0] = Len_[i];
      _Get_DID_TP(Data,2);
    }
    _TPsendmsg_Phy(Data,elCount(Data),1);
    _TPgetSF(0);
    testWaitForTimeout(1000);
  }
}
