_CAN_TP_Time_1()/* N_Bs时间测试 */
{
  byte Data[8] = {0x10,0x0D,0x22,0x00,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x30,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  double start_time;
  double end_time;
  int i,Temp_SN;
  
  _TPsendmsg_Phy(Data,elCount(Data),0);
  start_time=(double)timeNow()/100;
  _TPgetFC(1);
  end_time=(double)timeNow()/100;
  if(end_time - start_time <= N_Bs_Time)
    testStepPass("","N_Bs响应时间在规定范围内");
  else
    testStepFail("","N_Bs响应时间不在规定范围内%.2f ms",(end_time - start_time));
  testWaitForTimeout(1000);
  {
    _Get_DID_TP(Data,2);
    Data[0] = 1 + _TP_CAN_DID_Input;
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFF(1);
    testWaitForTimeout(N_Bs_Time + N_Bs_Time_Tolerance);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    _TPgetFC(0);
  }
  testWaitForTimeout(1000);
  {
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFF(1);
    testWaitForTimeout(N_Bs_Time - N_Bs_Time_Tolerance);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    Temp_SN=(_TP_CAN_DID_Len-6)/7;
    if((_TP_CAN_DID_Len-6)%7 != 0)
      Temp_SN+=1;
    for(i=1;i<=Temp_SN;i++)
      _Check_TPgetCF(1,_TP_CAN_DID_Len,i); 
  }
}
_CAN_TP_Time_2()/* N_Cr时间测试 */
{
  byte Data[8] = {0x10,0x0D,0x22,0x00,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x30,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_2[8] = {0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  byte Data_3[8] = {0x03,0x22,0x00,0x00,0x55,0x55,0x55,0x55};
  byte Da_T[8] = {0x10,0x14,0x22,0x00,0x00,0x00,0x00,0x00};
  byte Data_4[8] = {0x22,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  double start_time;
  double end_time;
  double DiffTime,Min_Time,Max_Time;
  int i,Temp_SN,Loop_Count,len,j;
  Loop_Count = 2;
  _Get_TP_DID("TP_CAN_DID");
  
  Data_3[2] = 0x35;
  Data_3[3] = 0x70;
  _Init_Struct();
  if(_Check_Serve_IDAndSess(0x22,funreq_ID,defsession) != 1)
  {
    Loop_Count = 1;
    _WriteEx_and_Report("","22服务不支持功能寻址读取");
  }
  for(j=0;j<Loop_Count;j++)
  {
    Min_Time = 1000;
    Max_Time = 1;
    if(j==0)
      _TPsendmsg_Phy(Data_3,elCount(Data_3),0);
    else
      _TPsendmsg_Fun(Data_3,elCount(Data_3),0);
    len = _TPgetFF(1);
    Temp_SN=(len-6)/7;
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    if((len-6)%7 != 0)
      Temp_SN+=1;
    _Check_TPgetCF(1,len,1);
    for(i=2;i<=Temp_SN;i++)
    {
      start_time = (double)timeNow()/100;
      _Check_TPgetCF(1,len,i);
      end_time=(double)timeNow()/100; 
      DiffTime = (double)(end_time - start_time);
      if(DiffTime<=Min_Time)
        Min_Time  = DiffTime;
      if(DiffTime>=Max_Time)
        Max_Time  = DiffTime;
      writeEx(-3,0,"%.2f ms",DiffTime);
    }
    if(Max_Time<N_Cr_Time)
      testStepPass("","N_Cr时间符合需求，最大间隔时间为 %d ms",Max_Time);
    else
      testStepFail("","最大间隔时间为 %d ms ,大于预期时间 %d ms",Max_Time,N_Cr_Time);
  
    testWaitForTimeout(3000);
  }
  
  {
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    testWaitForTimeout(N_Cr_Time+N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
    _TPgetCF_21(0);
  }
  testWaitForTimeout(1000);
  {
    _TPsendmsg_Phy(Data,elCount(Data),0);
    _TPgetFC(1);
    testWaitForTimeout(N_Cr_Time-N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
    _Check_NRC(0);
  }
  
  {
    _TPsendmsg_Phy(Da_T,elCount(Da_T),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
    testWaitForTimeout(N_Cr_Time+N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_4,elCount(Data_4),0);
    _Check_NoResponse_(500);
  }
  {
    _TPsendmsg_Phy(Da_T,elCount(Da_T),0);
    _TPgetFC(1);
    _TPsendmsg_Phy(Data_2,elCount(Data_2),0);
    testWaitForTimeout(N_Cr_Time-N_Cr_Time_Tolerance);
    _TPsendmsg_Phy(Data_4,elCount(Data_4),0);
    _Check_NRC(0);
  }
}
_CAN_TP_Time_3()/* BS值测试 */
{
  byte Data[8] = {0x1F,0xFF,0x2E,0x35,0x70,0x00,0x00,0x00};
  byte Data_03[8] = {0x02,0x10,0x03,0x00,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x21,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  int i;
  int Max_Count,CF_Byte,BS_Count;
  
  Data[0] = ((FF_DL_Max>>8) | 0x10);
  Data[1] = (FF_DL_Max & 0xFF);
  Max_Count = _ceil(((((Data[0]&0xF)<<8) | Data[1])-6)/7.0);
  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFC(1);
  BS_Count = 1;
  CF_Byte = 0x20;
  for(i=0;i<Max_Count;i++)
  {
    if(CF_Byte>=0x30)
      CF_Byte = 0x20;
    if(i==0 & CF_Byte==0x20)
      CF_Byte=0x21;
    Data_1[0] = CF_Byte;
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    BS_Count++;
    if(BS!=0 && BS_Count == BS+1)
    {
      _TPgetFC(1);
      BS_Count = 1;
    }
    if(BS==0 && BS_Count == BS+1)
    {
      _Check_NoResponse(p2cmax);
      BS_Count = 1;
    }
    CF_Byte++;
  }
  _Check_NRC(3);
  
  testWaitForTimeout(2000);
  _TPsendmsg_Phy(Data_03,elCount(Data_03),0);
  _TPgetSF(1);
  testWaitForTimeout(100);
  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFC(1);
  BS_Count = 1;
  CF_Byte = 0x20;
  for(i=0;i<Max_Count;i++)
  {
    if(CF_Byte>=0x30)
      CF_Byte = 0x20;
    if(i==0 & CF_Byte==0x20)
      CF_Byte=0x21;
    Data_1[0] = CF_Byte;
    testWaitForTimeout(STmin+5);
    _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
    BS_Count++;
    if(BS!=0 && BS_Count == BS+1)
    {
      _TPgetFC(1);
      BS_Count = 1;
    }
    if(BS==0 && BS_Count == BS+1)
    {
      _Check_NoResponse(p2cmax);
      BS_Count = 1;
    }
    CF_Byte++;
  }
  _Check_NRC(3);
}

_CAN_TP_Time_4()/* N_Cs时间测试 */
{
  byte Data[8] = {0x03,0x22,0x35,0x70,0x00,0x00,0x00,0x00};
  byte Data_1[8] = {0x30,0x00,0x00,0x00,0x00,0x00,0x00,0x00};
  double start_time,start_time2,start_time3;
  int i,Temp_SN;
  _Get_DID_TP(Data,2);
  _TPsendmsg_Phy(Data,elCount(Data),0);
  _TPgetFF(1);
  start_time=(double)timeNow()/100;
  _TPsendmsg_Phy(Data_1,elCount(Data_1),0);
  _TPgetCF(1);
  start_time2=(double)timeNow()/100;
  _TPgetCF(1);
  start_time3=(double)timeNow()/100;
  testWaitForTimeout(1000);
  if(start_time2 - start_time <= N_Cs_Time + N_Cs_Time_Tolerance)
    testStepPass("","连续帧1：N_Cs响应时间在规定范围内");
  else
    testStepFail("","连续帧1：N_Cs响应时间不在规定范围内%.2f ms",(start_time2 - start_time));
  if(start_time3 - start_time2 <= N_Cs_Time + N_Cs_Time_Tolerance)
    testStepPass("","连续帧2：N_Cs响应时间在规定范围内");
  else
    testStepFail("","连续帧2：N_Cs响应时间不在规定范围内%.2f ms",(start_time3 - start_time2));
}
