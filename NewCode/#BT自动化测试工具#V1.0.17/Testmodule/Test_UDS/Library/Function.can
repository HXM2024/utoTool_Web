        if(Seed_Count_AES_Rept[i][16]>1)
        {
          char Temp_Str[200];
          snprintf(comment_3,elCount(comment_3),"");
          snprintf(Temp_Str,elCount(Temp_Str),"种子0x");
          for(k=0;k<16;k++)
            snprintf(Temp_Str,elCount(Temp_Str),"%s%02X",Temp_Str,Seed_Count_AES_Rept[i][k]);
          snprintf(comment_3,elCount(comment_3),"%s,出现次数 %d ",Temp_Str,Seed_Count_AES_Rept[i][16]);
          _WriteEx_and_Report("",comment_3);
        }
      }
    }
    if(Len>=10000 && Repeat_Count >=5)
      testStepFail("","");
    else
      testStepPass("","");
  }
  testWaitForTimeout(2000);
  _Clear_Seed();
  return Repeat_Count;
}
/*
  检测种子是否已经出现过重复
  Seed_ 待检测种子
  _Repeat_Count:已重复种子列表个数
  Type = 0：非AES128类算法,种子长度在4byte以内
*/
int _Seed_Repeat(qword Seed_,dword _Repeat_Count,byte Type)
{
  int Return_Value;
  int k;
  Return_Value = 0;
  for(k=0;k<_Repeat_Count;k++)
  {
    if(Type == 0)
    {
      if(Seed_ == Seed_Count_Rept[k][0])
      {
        Seed_Count_Rept[k][1]++;
        Return_Value = 1;
        break;
      }
    }
  }
  return  Return_Value;
}
/*
  检测种子是否已经出现过重复
  AES 128型
  Seed_ 待检测种子
  _Repeat_Count:列表个数
*/
int _Seed_Repeat(byte Seed_[],dword _Repeat_Count)
{
  int Return_Value;
  int k,m;
  Return_Value = 0;
  for(k=0;k<_Repeat_Count;k++)
  {
    for(m=0;m<16;m++)
    {
      if(Seed_[m] != Seed_Count_AES_Rept[k][m])
        break;
    }
    if(m == 16)
    {
      Seed_Count_AES_Rept[k][16]++;
      Return_Value = 1;
      break;
    }
  }
  return  Return_Value;
}

int _Get_Read_Plural(char str[])
{
  char Temp_Value_0[1000];
  char Temp_Value_1[100];
  int i,j,k,Count,Count_Group,Flage;
  
  snprintf(Temp_Value_0,elCount(Temp_Value_0),"%s","");
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  DID_Read_Count = 0;
  Count_Group = 0;
  glbHandle1 = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,str,"Null",Temp_Value_0, 1000, file_name_1);
  fileClose(glbHandle1);
  if(strlen(Temp_Value_0)<= 5)
    return -1;
  else
  {
    for(i=0;i<strlen(Temp_Value_0);i++)
    {
      if(Temp_Value_0[i] == 91)
      {
        Count = 0;
        for(j=i+1;j<strlen(Temp_Value_0);j++)
        {
          if(Temp_Value_0[j] == 44 || Temp_Value_0[j] == 93)
          {
            DID_Read[DID_Read_Count].DID_byte[Count] = atol(Temp_Value_1);
            Count++;
            snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
            if(Temp_Value_0[j] == 93)
            {
              i = j;
              DID_Read_Count++;
              Count_Group++;
              break;
            }
          }
          else
            snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_0[j]);
        }
      }
    }
    for(i=0;i<DID_Read_Count;i++)
      DID_Read[i].DID = ((DID_Read[i].DID_byte[0]<<8) + (DID_Read[i].DID_byte[1]));
    _get_Str_Traversal("DID_22_Traversal");
    
    for(i=0;i<DID_Read_Count;i++)
    {
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"DID_%04X",DID_Read[i].DID);
      Flage = 0;
      for(j=0;j<Traversal_Count;j++)
      {
        if(strncmp(Traversal_DID[j],Temp_Value_1,strlen(Traversal_DID[j])) == 0 && strlen(Traversal_DID[j]) == strlen(Temp_Value_1))
        {
          Flage = 1;
          _Get_DID(Traversal_DID[j]);
          DID_Read[i].LenExResp = DID_len_Ex - 3; 
          DID_Read[i].Analysis_Read = Analysis;
          DID_Read[i].Padding = UnUse_Byte;
          if(Analysis == 1)
          {
            for(k=0;k<Len_Input;k++)
              DID_Read[i].ExResp_byte[k] = DID_Data[k];
            if(Len_Input < DID_len_Ex)
            {
              for(k=Len_Input;k<DID_len_Ex-3;k++)  /*减去 22 + DID长度*/
                DID_Read[i].ExResp_byte[k] = DID_Read[i].Padding;
            }
          }
          else
          {
            snprintf(DID_Read[i].ExResp,elCount(DID_Read[i].ExResp),"%s",DID_Data_str);
            if(Analysis == 2 && Len_Input < DID_len_Ex)
            {
              Len_Input = strlen(DID_Read[i].ExResp);
              for(k=Len_Input;k<DID_len_Ex-3;k++)   /*减去 22 + DID长度*/
                snprintf(DID_Read[i].ExResp,elCount(DID_Read[i].ExResp),"%s%c",DID_Read[i].ExResp,UnUse_Byte);
            }
          }
          break;
        }
      }
      if(Flage == 0)
      {
        DID_Read[i].LenExResp = 0;
        snprintf(DID_Read[i].ExResp,elCount(DID_Read[i].ExResp),"");
      }
    }
    return 1;
  }
}
_Get_ReadPlural()
{
  char Temp_Value_0[1000];
  char Temp_Value_1[500];
  int i,j;
  glbHandle1 = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,"Other_Plural_DID","Null",Temp_Value_0, 1000, file_name_1);
  fileClose(glbHandle1);
  Plural_DID_Count = 0;
  for(i=0;i<strlen(Temp_Value_0);i++)
  {
    if(Temp_Value_0[i]==91)
    {
      for(j=i+1;j<strlen(Temp_Value_0);j++)
      {
        if(Temp_Value_0[j]==44 || Temp_Value_0[j]==93)
        {
          snprintf(Plural_DID[Plural_DID_Count],elCount(Plural_DID[Plural_DID_Count]),"%s",Temp_Value_1);
          Plural_DID_Count++;
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"");
          if(Temp_Value_0[j]==93)
          {
            i = j; break;
          }
        }
        else
          snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_0[j]);
      }
    }
  }
  if(Plural_DID_Count == 1 && strlen(Plural_DID[0])==0)
    Plural_DID_Count = 0;
}

/*
  将输入的数组按照输入格式进行转换并输出
  List_Input：输入数组
  Len_Input :输入长度
  List_Output：输出数据
  Type ：转换格式
  Type = 2：ASCII码格式转换
  Type = 3：整体转换至10进制 
  Type = 4：每个Byte分别转换至10进制后拼接
  Type = 5：16进制拼接
*/
void Array_Change(byte List_Input[],int Len_Input,char List_Output[],byte Type)
{
  int Count_Size;
  char Temp_Buffer[20];
  snprintf(List_Output,elCount(List_Output),"%s","");
  snprintf(Temp_Buffer,elCount(Temp_Buffer),"%s","");
  if(Type == 2)
  {
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
      snprintf(List_Output,elCount(List_Output),"%s%c",List_Output,HexToAsc(List_Input[Count_Size])); //ASCII码查表切换
  }
  else if(Type == 3)
  {
    qword Data_Temp ;
    Data_Temp = 0;
    snprintf(List_Output,elCount(List_Output),"0x%s");
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
      snprintf(List_Output,elCount(List_Output),"%s%02X",List_Output,List_Input[Count_Size]);
    strtoull(List_Output,Data_Temp);
    snprintf(List_Output,elCount(List_Output),"%s","");
    snprintf(List_Output,elCount(List_Output),"%s%I64u",List_Output,Data_Temp);
  }
  else if(Type == 4)
  {
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
    {
      ltoa(List_Input[Count_Size],Temp_Buffer,10);
      if(strlen(Temp_Buffer) == 1)
        snprintf(List_Output,300,"%s%s",List_Output,"0");
      snprintf(List_Output,300,"%s%s",List_Output,Temp_Buffer);
    }
  }
  else if(Type == 5)
  {
    for(Count_Size=0;Count_Size<Len_Input;Count_Size++)
    {
      ltoa(List_Input[Count_Size],Temp_Buffer,16);
      if(strlen(Temp_Buffer) == 1)
        snprintf(List_Output,300,"%s%s",List_Output,"0");
      snprintf(List_Output,300,"%s%s",List_Output,Temp_Buffer);
    }
  }
  else
    _WriteEx_and_Report("","无对应解析,待完善");
}

void DID_Read_Some(dword ID,byte Session,char Str[])
{
  int Return_Va,n,Flage_Error;
  int Len_Rx,Len_Ex,Len_Start,Len_End;
  byte Send_Data[100],Temp_RxData[100],Temp_RxData_2[100];
  char DID[20];
  int i;
  Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
  
  if(DID_22_Support==1)
    _WriteEx_and_Report("","该项目一次性只支持一个DID读取");
  else
  {
    Return_Va = _Check_Serve_IDAndSess(0x22,ID,Session);
    if(Return_Va == 1)
    {
      Send_Data[0] = 0x22;
      _Get_Read_Plural(Str);
      n = 1;
      for(i=0;i<DID_Read_Count;i++)
      {
        Send_Data[n++] = DID_Read[i].DID_byte[0];
        Send_Data[n++] = DID_Read[i].DID_byte[1];
      }
      _Send_Diag(1+DID_Read_Count*2,ID,Send_Data);
      if(diagGetLastResponseCode(SendData) == 0)
        testWaitForDiagResponse(SendData,2000);
      if(diagGetLastResponseCode(SendData) == -1)
      {
        Len_Ex = 0;
        Len_Rx = DiagGetRespPrimitiveSize(SendData);
        for(i=0;i<DID_Read_Count;i++)
        {
          if(DID_Read[i].LenExResp != 0)
            Len_Ex = Len_Ex + DID_Read[i].LenExResp + 2;
        }
        Len_Ex = Len_Ex + 1;
        if(Len_Rx != Len_Ex)
          testStepFail("读取多组DID","返回长度与预期长度不符,返回长度为 %d, 期望长度为 %d",Len_Rx,Len_Ex);
        else
        {
          /* 分组进行判断 */
          Len_Start = 0;
          Len_End = 0;
          for(i=0;i<DID_Read_Count;i++)
          {
            if( DID_Read[i].LenExResp != 0)
            {
              Flage_Error = 0;
              snprintf(DID,elCount(DID),"%s","");
              snprintf(DID,elCount(DID),"0x%02X 0x%02X",DID_Read[i].DID_byte[0],DID_Read[i].DID_byte[1]);
              Len_Start =  Len_End ;
              if(Len_End == 0)
                Len_Start = Len_Start +1;
              Len_End = Len_Start + DID_Read[i].LenExResp+2;
              for(n = 0; n< DID_Read[i].LenExResp+2 ; n++)
              {
                if((Len_Start+n) > Len_Rx)
                {
                  testStepFail("","出现异常长度导致无法获取到后续字节");
                  return;
                }
                Temp_RxData[n] = DiagGetRespPrimitiveByte(SendData,Len_Start+n);
              }
              if((Temp_RxData[0] != DID_Read[i].DID_byte[0]) || (Temp_RxData[1] != DID_Read[i].DID_byte[1]))
                testStepFail(DID,"DID与预期无法对应,接收到DID为: 0x%02X 0x%02X ,预期DID为: 0x%02X 0x%02X ",Temp_RxData[0],Temp_RxData[1],DID_Read[i].DID_byte[0],DID_Read[i].DID_byte[1]);
              else
                testStepPass(DID,"DID与预期一致");
              for(n=0;n<DID_Read[i].LenExResp;n++)
                Temp_RxData_2[n] = DiagGetRespPrimitiveByte(SendData,Len_Start+2+n); //全数据数组(剔除DID)
              if(DID_Read[i].Analysis_Read == 1)
              {
                char Temp_Rx[200];
                char Temp_Ex[200];
                snprintf(Temp_Rx,elCount(Temp_Rx),"%s","实际接收为: ");
                snprintf(Temp_Ex,elCount(Temp_Ex),"%s","期望接收为: ");
                for(n=0;n<DID_Read[i].LenExResp;n++)
                {
                  snprintf(Temp_Rx,elCount(Temp_Rx),"%s%02X",Temp_Rx,Temp_RxData_2[n]);
                  snprintf(Temp_Ex,elCount(Temp_Ex),"%s%02X",Temp_Ex,DID_Read[i].ExResp_Byte[n]);
                  if(Temp_RxData_2[n] != DID_Read[i].ExResp_Byte[n])
                    Flage_Error = 1;
                }
                if(Flage_Error == 1)
                {
                  _WriteEx_and_Report(DID,Temp_Rx);
                  _WriteEx_and_Report(DID,Temp_Ex);
                  testStepFail(DID,"接收到的数据与预期不符");
                }
                else
                  testStepPass(DID,"接收到的数据与预期一致");
              }
              else
              {
                char Buffer_Check[500];
                Array_Change(Temp_RxData_2,DID_Read[i].LenExResp,Buffer_Check,DID_Read[i].Analysis_Read);
                Check_information_(Buffer_Check,DID_Read[i].ExResp,DID);
              }
            }
          }
        }
      }
      else
        testStepFail("","未收到响应或收到消极应答");
    }
    else if(Return_Va == -1)
      _WriteEx_and_Report("","当前寻址不支持该服务");
    else if(Return_Va == 0)
      _WriteEx_and_Report("","当前会话不支持该服务");
  }
}
int _Check_22DID(dword ID,byte Temp_0[],byte Session)
{
  int Flage_;
  Flage_ = _Check_BT_Double_Backup(ID,Temp_0,Session);
  if( Flage_ == -1)
  {
    _WriteEx_and_Report("","特殊处理");
    return 0;
  }
  else
  {
    Flage_ = 0;
    if(ID == funreq_ID && Fun_DID22 == 0)
    {
      Flage_ = Analysis_Select(Analysis,ID,Temp_0,0);
    }
    else
    {
      Flage_ = Analysis_Select(Analysis,ID,Temp_0,-1);
    }
    return Flage_;
  }
}

int Analysis_Select(int Type,dword ID,byte DID_Send[],int Res)
{
  int Return_Value;
  switch(Analysis)
  {
    case 2:
      Return_Value = _Check_22DID_ASCII(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 3:
      Return_Value = _Check_22DID_DecAll(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 4:
      Return_Value = _Check_22DID_DecByte(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 5:
      Return_Value = _Check_22DID_HexSplicing(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    case 6:
      Return_Value = _Check_22DID_Mixed_DecALL_DecByte(ID,DID_len_Ex,DID_Send,DID_Data_str,Res);break;
    default:
      Return_Value = _Check_22DID_Hex(ID,DID_len_Ex,DID_Send,DID_Data,Res);break;
  }
  return Return_Value;
}

/*
  解析方式：输入16进制直接进行对比
  msgID：寻址方式{phyreq_ID:物理寻址，funreq_ID:功能寻址}
  LenEx：预期响应长度
  Tx_Data：发送的数据
  Rx_Data：接收的数据
  passcondition：预期响应{-1:正响应,0:无响应,>0:消极响应码}
*/
int _Check_22DID_Hex(dword msgID,dword LenEx,byte Tx_Data[],byte Rx_Data[],int passcondition)
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int Return_Value;
  int flage_0 = 0;
  int flage = 0;
  Return_Value = 0;
  snprintf(str,elCount(str),"%s","");
  if(Tx_Data[1]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  if(Tx_Data[2]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) == 0))
    testStepPass(str,"与期望一致无应答"); 
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if(Len_Input<=Len_Rx)
    {
      if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
      {
        Return_Value = -1;
        testStepFail(str,"前三字符存在异常,实际反馈为 0x%2X  0x%2X  0x%2X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
      }
      else
        testStepPass(str,"前三字符与预期一致");
      if(Len_Input==0)
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
      else if(Len_Input>0)
      {
        for(i=0;i<Len_Input;i++)
        {
          if(Rx_Data[i]!= DiagGetRespPrimitiveByte(req1,i+3))
          {
            flage_0 = 1;Return_Value = -1;
            testStepFail(str,"反馈值异常，预期为；0x%2X,第%d 位实际反馈值为:0x%2X",Rx_Data[i],i+4,DiagGetRespPrimitiveByte(req1,i+3));
          }
        }
        if(flage_0 == 0)
          testStepPass(str,"反馈与预期一致");
       if(Len_Input<Len_Rx-3)
        {
          _WriteEx_and_Report("","存在未使用的填充位");
          for(i=Len_Input+3;i<Len_Rx;i++)
          {
            if(DiagGetRespPrimitiveByte(req1,i) != UnUse_Byte)
            {
              flage = 1;Return_Value = -1;
              testStepFail(str,"未使用位填充值存在非预期情况，默认填充值为；0x%2X,第%d 位实际反馈值为:0x%2X",UnUse_Byte,i+1,DiagGetRespPrimitiveByte(req1,i));
            }
          }
          if(flage == 0)
            testStepPass(str,"未使用填充位为默认值0x%2X",UnUse_Byte);
        } 
      }
    }
    else if(Len_Input>Len_Rx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,收到的长度小于期望长度");
    }
  }
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}
/*
  解析方式：ASCII码
  msgID：寻址方式{phyreq_ID:物理寻址，funreq_ID:功能寻址}
  LenEx：预期响应长度
  Tx_Data：发送的数据
  Rx_Data：接收的数据
  passcondition：预期响应{-1:正响应,0:无响应,>0:消极响应码}
*/
int _Check_22DID_ASCII(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)
{
  diagRequest * req1; 
  int Return_Value;
  char str[500];
  int i = 0, Len_Rx = 0;
  int flage = 0;
  char Buffer[500];
  Return_Value = 0;
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(str,elCount(str),"%s","");
  if(Tx_Data[1]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  if(Tx_Data[2]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) == 0))
    testStepPass(str,"与期望一致无应答"); 
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if(strlen(Rx_Data)<=Len_Rx)
    {      
      if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
      {
        Return_Value = -1;
        testStepFail(str,"前三字符存在异常,实际反馈为 0x%2X  0x%2X  0x%2X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
      }
      else
        testStepPass(str,"前三字符与预期一致");
      if(strlen(Rx_Data)!=0)
      {
        for(i=3;i<strlen(Rx_Data)+3;i++)
        {
          snprintf(Buffer,elCount(Buffer),"%s%c",Buffer,HexToAsc(DiagGetRespPrimitiveByte(req1,i))); //ASCII码查表切换
        }
        Check_information_(Buffer,Rx_Data,str);
        if(strlen(Rx_Data)<Len_Rx-3)
        {
          _WriteEx_and_Report("","存在未使用的填充位");
          for(i=strlen(Rx_Data)+3;i<Len_Rx;i++)
          {
            if(DiagGetRespPrimitiveByte(req1,i) != UnUse_Byte)
            {
              flage = 1;
              Return_Value = -1;
              testStepFail(str,"未使用位填充值存在非预期情况，默认填充值为；0x%2X,第%d 位实际反馈值为:0x%2X",UnUse_Byte,i+1,DiagGetRespPrimitiveByte(req1,i));
            }
          }
          if(flage == 0)
            testStepPass(str,"未使用填充位为默认值0x%2X",UnUse_Byte);
        }
      }
      if(strlen(Rx_Data)==0)
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
    }
    else if(strlen(Rx_Data)>Len_Rx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,收到的长度小于期望长度");
    }
  }
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/*
  解析方式：将16进制整体转换为10进制
  msgID：寻址方式{phyreq_ID:物理寻址，funreq_ID:功能寻址}
  LenEx：预期响应长度
  Tx_Data：发送的数据
  Rx_Data：接收的数据
  passcondition：预期响应{-1:正响应,0:无响应,>0:消极响应码}
*/
int _Check_22DID_DecAll(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*整体转换*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int Return_Value,Temp_Return_Value;
  qword Data_Temp = 0;
  char Buffer[500];
  char Buffer_Check[500];
  Return_Value = 0;
  snprintf(str,elCount(str),"%s","");
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  if(Tx_Data[1]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  if(Tx_Data[2]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) == 0))
    testStepPass(str,"与期望一致无应答"); 
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%2X  0x%2X  0x%2X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
    if(strlen(Rx_Data)!=0)
    {
      for(i=3;i<Len_Rx;i++)
      {
        if(DiagGetRespPrimitiveByte(req1,i)>0x0F)
          snprintf(Buffer,elCount(Buffer),"%s%2X",Buffer,DiagGetRespPrimitiveByte(req1,i));
        else
        {
          snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0");
          snprintf(Buffer,elCount(Buffer),"%s%X",Buffer,DiagGetRespPrimitiveByte(req1,i));
        }
      }
      strtoull(Buffer,Data_Temp);
      snprintf(Buffer_Check,elCount(Buffer_Check),"%s%I64u",Buffer_Check,Data_Temp);
      Temp_Return_Value = Check_information_(Buffer_Check,Rx_Data,str);
      if(Temp_Return_Value == -1)
        Return_Value = -1;
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
  }
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}

/*
  解析方式：将16进制每个字节转换为10进制
  msgID：寻址方式{phyreq_ID:物理寻址，funreq_ID:功能寻址}
  LenEx：预期响应长度
  Tx_Data：发送的数据
  Rx_Data：接收的数据
  passcondition：预期响应{-1:正响应,0:无响应,>0:消极响应码}
*/

int _Check_22DID_DecByte(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*每个Byte分别转换*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int Return_Value,Temp_Return_Value;
  char Buffer[500];
  char Buffer_Check[500];
  Return_Value = 0;
  snprintf(str,elCount(str),"%s","");
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  if(Tx_Data[1]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  if(Tx_Data[2]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) == 0))
    testStepPass(str,"与期望一致无应答"); 
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%2X  0x%2X  0x%2X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
    if(strlen(Rx_Data)!=0)
    {
      for(i=3;i<Len_Rx;i++)
      {
        ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,10);
        if(strlen(Buffer) == 1)
        {
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
        }
        snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
      }
      Temp_Return_Value = Check_information_(Buffer_Check,Rx_Data,str);
      if(Temp_Return_Value == -1)
        Return_Value = -1;
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
  }
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}
/*
  解析方式：将16进制整体转换为10进制
  msgID：寻址方式{phyreq_ID:物理寻址，funreq_ID:功能寻址}
  LenEx：预期响应长度
  Tx_Data：发送的数据
  Rx_Data：接收的数据
  passcondition：预期响应{-1:正响应,0:无响应,>0:消极响应码}
*/
int _Check_22DID_HexSplicing(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*16进制拼接*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  int flage = 0;
  qword Data_Temp = 0;
  int Return_Value,Temp_Return_Value;
  char Buffer[500];
  char Buffer_Check[500];
  Return_Value = 0;
  snprintf(str,elCount(str),"%s","");
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  if(Tx_Data[1]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  if(Tx_Data[2]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) == 0))
    testStepPass(str,"与期望一致无应答"); 
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if(strlen(Rx_Data)/2<=Len_Rx)
    {      
      if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
      {
        Return_Value = -1;
        testStepFail(str,"前三字符存在异常,实际反馈为 0x%2X  0x%2X  0x%2X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
      }
      else
        testStepPass(str,"前三字符与预期一致");
      snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
      if(strlen(Rx_Data)!=0)
      {
        for(i=3;i<strlen(Rx_Data)/2+3;i++)
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer,16);
          if(strlen(Buffer) == 1)
          {
            snprintf(Buffer_Check,200,"%s%s",Buffer_Check,"0");
          }
          snprintf(Buffer_Check,200,"%s%s",Buffer_Check,Buffer);
        }
        toUpper(Buffer_Check, Buffer_Check, elcount(Buffer_Check));
        Temp_Return_Value = Check_information_(Buffer_Check,Rx_Data,str);
        if(Temp_Return_Value == -1)
          Return_Value = -1;
        if(strlen(Rx_Data)/2<Len_Rx-3)
        {
          _WriteEx_and_Report("","存在未使用的填充位");
          for(i=strlen(Rx_Data)/2+3;i<Len_Rx;i++)
          {
            if(DiagGetRespPrimitiveByte(req1,i) != UnUse_Byte)
            {
              flage = 1;Return_Value = -1;
              testStepFail(str,"未使用位填充值存在非预期情况，默认填充值为；0x%2X,第%d 位实际反馈值为:0x%2X",UnUse_Byte,i+1,DiagGetRespPrimitiveByte(req1,i));
            }
          }
          if(flage == 0)
            testStepPass(str,"未使用填充位为默认值0x%2X",UnUse_Byte);
        }
      }
      if(strlen(Rx_Data)==0)
        _WriteEx_and_Report(str,"未输入预期值，跳过内容检测");
    }
    else if(strlen(Rx_Data)/2>Len_Rx)
    {
      testStepFail(str,"长度异常");
      Return_Value = -1;
    }
  }
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}
/*
  解析方式：前两字节为整体转换为10进制，后面为每个Byte分别转换为10进制
  msgID：寻址方式{phyreq_ID:物理寻址，funreq_ID:功能寻址}
  LenEx：预期响应长度
  Tx_Data：发送的数据
  Rx_Data：接收的数据
  passcondition：预期响应{-1:正响应,0:无响应,>0:消极响应码}
*/
int _Check_22DID_Mixed_DecALL_DecByte(dword msgID,dword LenEx,byte Tx_Data[],char Rx_Data[],int passcondition)/*混合解析BYD: F1 95*/
{
  diagRequest * req1; 
  char str[500];
  int i = 0, Len_Rx = 0;
  qword Data_Temp = 0;
  int Return_Value,Temp_Return_Value;
  char Buffer[500];
  char Buffer_1[500];
  char Buffer_Check[500];
  char Buffer_Check_1[500];
  Return_Value = 0;
  snprintf(str,elCount(str),"%s","");
  snprintf(Buffer,elCount(Buffer),"%s","");
  snprintf(Buffer_1,elCount(Buffer_1),"%s","");
  snprintf(Buffer_Check,elCount(Buffer_Check),"%s","");
  snprintf(Buffer_Check_1,elCount(Buffer_Check_1),"%s","");
  if(Tx_Data[1]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[1]);
  snprintf(str,elCount(str),"%s%s",str,"  ");
  if(Tx_Data[2]<=0xF)
    snprintf(str,elCount(str),"%s%s",str,"0");
  snprintf(str,elCount(str),"%s%X",str,Tx_Data[2]);
  diagResize(req1,3);
  for(i=0;i<3;i++)
    DiagSetPrimitiveByte(req1,i,Tx_Data[i]);
  _SendAndWriteReport(req1,msgID,1000);
  Len_Rx = diagGetRespPrimitiveSize(req1);
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) == 0))
    testStepPass(str,"与期望一致无应答"); 
  if((diagGetLastResponseCode(req1) == passcondition) && (diagGetLastResponseCode(req1) != 0))
  {
    if(Len_Rx != LenEx)
    {
      Return_Value = -1;
      testStepFail(str,"长度异常,预期长度为%d，实际长度为%d",LenEx,Len_Rx);
    }
    else if((Len_Rx == LenEx))
      testStepPass(str,"长度与预期一致"); 
    if((DiagGetRespPrimitiveByte(req1,0) != (DiagGetPrimitiveByte(req1,0)^0x40)) ||DiagGetRespPrimitiveByte(req1,1)!=Tx_Data[1] ||DiagGetRespPrimitiveByte(req1,2)!=Tx_Data[2] )
    {
      Return_Value = -1;
      testStepFail(str,"前三字符存在异常,实际反馈为 0x%2X  0x%2X  0x%2X ",DiagGetRespPrimitiveByte(req1,0),DiagGetRespPrimitiveByte(req1,1),DiagGetRespPrimitiveByte(req1,2));
    }
    else
      testStepPass(str,"前三字符与预期一致");
    snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0x");
    if(strlen(Rx_Data)!=0)
    {
      for(i=3;i<5;i++)
      {
        if(DiagGetRespPrimitiveByte(req1,i)>0x0F)
          snprintf(Buffer,elCount(Buffer),"%s%2X",Buffer,DiagGetRespPrimitiveByte(req1,i));
        else
        {
          snprintf(Buffer,elCount(Buffer),"%s%s",Buffer,"0");
          snprintf(Buffer,elCount(Buffer),"%s%X",Buffer,DiagGetRespPrimitiveByte(req1,i));
        }
      }
      strtoull(Buffer,Data_Temp);
      snprintf(Buffer_Check,elCount(Buffer_Check),"%s%I64u",Buffer_Check,Data_Temp);
      if(strstr(Rx_Data,",") != -1)
      { 
        snprintf(Buffer_Check_1,200,"%s%s",Buffer_Check_1,",");
        for(i=5;i<Len_Rx;i++)
        {
          ltoa(DiagGetRespPrimitiveByte(req1,i),Buffer_1,10);
          if(strlen(Buffer_1) == 1)
          {
           snprintf(Buffer_Check_1,200,"%s%s",Buffer_Check_1,"0");
          }
         snprintf(Buffer_Check_1,200,"%s%s",Buffer_Check_1,Buffer_1);
        }
      }
      else if(strstr(Rx_Data,",") == -1)
      {
        _WriteEx_and_Report("","未填充第二部分，跳过第二部分检测");
      }
      snprintf(Buffer_Check,300,"%s%s",Buffer_Check,Buffer_Check_1);
      Temp_Return_Value = Check_information_(Buffer_Check,Rx_Data,str);
      if(Temp_Return_Value == -1)
        Return_Value = -1;
    }
    if(strlen(Rx_Data)==0)
      _WriteEx_and_Report(str,"未输入预期值，跳过所有内容检测");
  }
  else if(diagGetLastResponseCode(req1) != passcondition)
  {
    Return_Value = -1;
    testStepFail(str,"收到响应异常");
  }
  return Return_Value;
}
/*
  是否需要进行特殊处理
  特殊处理返回 -1
  正常处理返回 1
*/
int _Check_BT_Double_Backup(dword ID,byte Temp_0[],byte Session)
{
  int Return_Value;
  int Len_Rx,Flage;
  char Temp_Str_0[300];
  
  Flage = 0;
  snprintf(Temp_Str_0,elCount(Temp_Str_0),"收到反馈值%s","");
  Return_Value = 1;
  
  if((strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0) || @AUTO::Config_Switch == 1)
  {
    if(ID == phyreq_ID)
    {
      if( ((Session == prosession) && (BT_Double_Backup == 1)) && ((Temp_0[1]==0xF1 ) && Temp_0[2] == 0x95)) // BT下 F1/F2 95返回全0xFF
      {
        Return_Value = -1;
        _Send_Diag(3,ID,Temp_0,1000);
        Len_Rx = diagGetRespPrimitiveSize(SendData);
        _TestResult(SendData,ID,"",-1);
        for(i=0;i<Len_Rx;i++)
          snprintf(Temp_Str_0,elCount(Temp_Str_0),"%s %02X",Temp_Str_0,DiagGetRespPrimitiveByte(SendData,i));
        for(i=3;i<Len_Rx;i++)
        {
          if(DiagGetRespPrimitiveByte(SendData,i) != 0xFF)
          {
            Flage = 1;
            break;
          }
        }
        _WriteEx_and_Report("",Temp_Str_0);
        if(Flage==0)
          testStepPass("","反馈与预期一致为全0xFF");
        else
          testStepFail("","反馈与预期不一致存在非0xFF值");
      }
      if( ((Session == prosession) && (BT_Double_Backup == 1)) && ((Temp_0[2]==0x94 || Temp_0[2] == 0x95) && Temp_0[1] == 0xF2)) // BT下 F2 94/95存在不支持现象
      {
        Return_Value = -1;
        _Send_Diag(3,ID,Temp_0,1000);
        _TestResult(SendData,ID,"",0x31);
      }
    }
  }
  
  return Return_Value;
}
void _Check_DID_2E(dword ID,dword Session,dword Count)
{
  char str1[200];
  int n,flage;
  byte Temp_Data[100];
  word Read_DID;
  byte suprt_Read_DID;
  
  Read_DID = Read_2E_DID[1] <<8 | Read_2E_DID[2];
//  suprt_Read_DID = _Check_Fun_IDAndSess(0x22,Read_DID,ID,Session); //判断该DID是否在该会话可读
  
  flage = 0;
  snprintf(str1,elCount(str1),"%s","");
  snprintf(str1,elCount(str1),"%s","获取第一次发送数据: ");
  if(Count != 0)
    _SetSession(Session);
  for(n=0;n<DID_2E_SendData_1_Len;n++)
  {
    snprintf(str1,elCount(str1),"%s 0x%02X",str1,DID_2E_SendData_1[n]);
    Temp_Data[n] = DID_2E_SendData_1[n];
  }
  _WriteEx_and_Report("",str1);
  
  _unlockECU();
  
  testWaitForTimeout(500);
  _Send_Diag(DID_2E_SendData_1_Len,ID,DID_2E_SendData_1);
  _TestResult(SendData,ID,"",DID_2E_SendData_1_Response);
  if(DID_2E_SendData_1_Response == -1)
  {
    if(diagGetLastResponseCode(SendData) == -1)
    {
      if(Support_Read_2E_DID == 1)
      {
        if(@AUTO::Config_Switch == 5 || (strncmp(ECU_project,"SRM",strlen("SRM")) == 0 ))
        {
          _SetSession(defsession);
          testWaitForTimeout(200);
        }
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _TestResult(SendData,ID,"",-1);
        for(n=1 ; n< DiagGetRespPrimitiveSize(SendData); n++)
        {
          if(DiagGetRespPrimitiveByte(SendData,n) != Temp_Data[n])
          {
            testStepFail("","第 %d 位,预期为 0x%02X , 实际为 0x%02X",n,Temp_Data[n],DiagGetRespPrimitiveByte(SendData,n));
            flage = 1;
          }
        }
        if(flage == 0)
          testStepPass("","反馈值与写入值一致");
      }
    }
    else
      _WriteEx_and_Report("","未收到正响应");
    
  }
  flage = 0;
  snprintf(str1,elCount(str1),"%s","");
  snprintf(str1,elCount(str1),"%s","获取第二次发送数据: ");
  
  _SetSession(Session);
  _unlockECU();
  
  for(n=0;n<DID_2E_SendData_2_Len;n++)
  {
    snprintf(str1,elCount(str1),"%s 0x%02X",str1,DID_2E_SendData_2[n]);
    Temp_Data[n] = DID_2E_SendData_2[n];
  }
  _WriteEx_and_Report("",str1);
  _Send_Diag(DID_2E_SendData_2_Len,ID,DID_2E_SendData_2);
  _TestResult(SendData,ID,"",DID_2E_SendData_2_Response);
  if(DID_2E_SendData_2_Response == -1)
  {
    if(diagGetLastResponseCode(SendData) == -1)
    {
      if(Support_Read_2E_DID == 1)
      {
        if(@AUTO::Config_Switch == 5 || (strncmp(ECU_project,"SRM",strlen("SRM")) == 0 ))
        {
          _SetSession(defsession);
          testWaitForTimeout(200);
        }
        _Send_Diag(Read_2E_DID_Len,phyreq_ID,Read_2E_DID);
        _TestResult(SendData,ID,"",-1);
        for(n=1 ; n< DiagGetRespPrimitiveSize(SendData); n++)
        {
          if(DiagGetRespPrimitiveByte(SendData,n) != Temp_Data[n])
          {
            testStepFail("","第 %d 位,预期为 0x%02X , 实际为 0x%02X",n,Temp_Data[n],DiagGetRespPrimitiveByte(SendData,n));
            flage = 1;
          }
        }
        if(flage == 0)
          testStepPass("","反馈值与写入值一致");
        _SetSession(Session);
      }
    }
    else
      _WriteEx_and_Report("","未收到正响应");
  }
}

_Check_Response_2E(diagRequest *Diag,dword LenInput,byte Tx_Data[])
{
  dword ReSize,i;
  byte Temp_Flage_1;
  i = 0;
  Temp_Flage_1=0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,200);
  ReSize = DiagGetRespPrimitiveSize(Diag);
  if(diagGetLastResponseCode(Diag) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(Diag) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(Diag) == -1)
  {
    if(ReSize == LenInput)
      testStepPass("","反馈长度与预期一致");
    else
      testStepFail("","反馈长度与预期不一致,预期为：%d，实际为：%d",LenInput,ReSize);
    if(DiagGetRespPrimitiveByte(SendData,0)!=0x62)
      testStepFail("","反馈值与预期不一致,预期为0x%2X,实际为0x%2X",0x62,DiagGetRespPrimitiveByte(SendData,0));
    if((strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD")) || @AUTO::Config_Switch == 1)
    {
      if(Tx_Data[0]==0x2E && Tx_Data[1] == 0xf1 && Tx_Data[2] == 0xa1)
      {
        for(i=3;i<LenInput-1;i++)
        {
          if(Tx_Data[i]!=0x00 && Tx_Data[i]!=0xFF)
            Temp_Flage_1 = 1;
        }
        if(Temp_Flage_1==1)
        {
          for(i=1;i<ReSize-1;i++)
          {
            if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
              testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
            else
              testStepPass("","反馈值与预期一致");
          } 
        }
        else
        {
          if(DiagGetRespPrimitiveByte(SendData,ReSize-1)!=0x00)
            testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%X,实际为0x%X",ReSize,0x00,DiagGetRespPrimitiveByte(SendData,ReSize-1));
          else
            testStepPass("","反馈值与预期一致");
        }
      }
      else
      {
        for(i=1;i<ReSize;i++)
        {
          if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
            testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
          else
            testStepPass("","反馈值与预期一致");
        }
      }
    }
    else
    {
      for(i=1;i<ReSize;i++)
      {
        if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
          testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
        else
          testStepPass("","反馈值与预期一致");
      }
    }
  }
}
