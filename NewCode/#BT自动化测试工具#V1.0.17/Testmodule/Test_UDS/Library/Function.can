/*
    根据输入的Testcase Title来修改寻址以及会话
*/
void GetInformationFromTitle()
{
  char Title[400];
  char TempForTitle[200];
  char Sevre_Str[10];
  int Title_Index,Count;
  long Offset;
  Count = 0;
  Offset = 0;
  getProfileString("Project_Information", "ECU_project","Null",ECU_project, 200, file_name_1);  
  @sysvar::DID::funreq_ID=getProfileInt(ECU_project, "funreq_ID",0,file_name_1);
  funreq_ID = @sysvar::DID::funreq_ID;
  @sysvar::DID::phyreq_ID=getProfileInt (ECU_project, "phyreq_ID",0,file_name_1);
  phyreq_ID = @sysvar::DID::phyreq_ID;
  @sysvar::DID::Response_ID=getProfileInt (ECU_project, "Response_ID",0,file_name_1);
  Response_ID = @sysvar::DID::Response_ID;
  
  testGetCurrentTestCaseTitle(Title,400);
  snprintf(TempForTitle,elcount(TempForTitle),"");
  snprintf(Sevre_Str,elcount(Sevre_Str),"0x");
  Offset = strstr_off(Title,3,"_");
  snprintf(TempForTitle,Offset+6,"%s",Title); //汉字占用两字节
//  writeEx(-3,0,"%s",TempForTitle);
  if(strstr(TempForTitle,"物理")!= -1)
    ID_From_Title = phyreq_ID;
  else
    ID_From_Title = funreq_ID;
  if(strstr(TempForTitle,"默认")!= -1)
    Session_From_Title = defsession;
  else if(strstr(TempForTitle,"编程")!= -1)
    Session_From_Title = prosession;
  else
    Session_From_Title = exsession;
  for(Count=6;Count<8;Count++)
    snprintf(Sevre_Str,elcount(Sevre_Str),"%s%c",Sevre_Str,TempForTitle[Count]);
  Serve_Form_Title = atol(Sevre_Str);
//  writeEx(-3,0,"%X , %d , %X",ID_From_Title,Session_From_Title,Serve_Form_Title);
}

/*
    发送并判断当前会话
    Session == 0xFF,特殊情况不判断返回值，并返回当前会话
*/
byte _Send_And_Check_NowSession(dword ID,byte Session)
{
  _get_Arry("Read_Now_Session");
  if(Support_ReadSession == 1)
  {
    testWaitForTimeout(10);
    _Send_Diag(3,ID,Read_Now_Session);
    _TestResult(SendData,ID,"读取当前会话模式",-1);
    if(diagGetLastResponseCode(SendData)==-1)
    {
      byte Session_Now;
      Session_Now = DiagGetRespPrimitiveByte(SendData,3);
      if(Session == 0xFF)
        return Session_Now;
      if(Session_Now == Session)
        testStepPass("","当前会话与预期一致为0x%02X",Session_Now);
      else
        testStepFail("","当前会话为0x%02X，预期会话为0x%02X",Session_Now,Session);
      return Session_Now;
    }
  }
  else
  {
//    _WriteEx_and_Report("","不支持读取当前会话");
  }
  return 0;
}

_get_Arry(char srt[])
{
  char Temp_Value_0[500];
  char Temp_Value_2[50];
  int i,j,m;
  m = 0;
  snprintf(Temp_Value_0,elCount(Temp_Value_0),"%s","");
  glbHandle1 = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,srt,"Null",Temp_Value_0, 1000, file_name_1);
  fileClose(glbHandle1);
  if(strncmp(Temp_Value_0,"Null",strlen(Temp_Value_0)) == 0 && strlen(Temp_Value_0) == strlen("Null"))
  {
    Arry_Len = 0;
    // _WriteEx_and_Report(srt,"未获取到输入数据");
  }
  else
  {
    Arry_Len = (strlen(Temp_Value_0)-1)/5;
    for(i = 0;i<strlen(Temp_Value_0);i++)                  
    {
      snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
      if(Temp_Value_0[i] == 48 && (Temp_Value_0[i+1] == 120 ||Temp_Value_0[i+1] == 88 ))
      {
        for(j=0;j<8;j++)
        {
          if(Temp_Value_0[i+j]==44 || i+j==strlen(Temp_Value_0)-1) 
          {
            m++; break;
          }
          else
            snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s%c",Temp_Value_2,HexToAsc(Temp_Value_0[i+j]));
        }
        Arry_Data[m-1] = atol(Temp_Value_2);
      }
    }
    if(strncmp(srt,"Read_Now_Session",strlen(srt)) == 0 && strlen(srt) == strlen("Read_Now_Session"))
    {
      if(Arry_Len>1)
      {
        Support_ReadSession = 1;
        Read_Now_Session[0] = 0x22;
        Read_Now_Session[1] = Arry_Data[0];
        Read_Now_Session[2] = Arry_Data[1];
      }
    }
  }
}

File_Write(char file_path[],char file_name[],char StrValue[],int state)
{
  char buffer_write[20000];
  long ret;

  setFilePath(file_path, 2);//不可以直接设置C根目录，2表明可以对这个目录下的文件可读可写
  glbHandle1 = openFileWrite (file_name,state); //以ASCII打开，并且覆盖文件原有内容
  if ( glbHandle1!=0 )
  {
    ret = filePutString(StrValue, strlen(StrValue), glbHandle1);    
    if(ret)
      fileClose (glbHandle1);
  } 
}

_Check_ResCode(diagRequest* obj,dword msgID,int Ex1,int Ex2)
{
  int Res_Now;
  Res_Now = diagGetLastResponseCode(obj);
  if(Res_Now !=Ex1 && Res_Now != Ex2)
  {
    testStepFail("","当前返回与期望不符");
  }
  else
  {
    testStepPass("","当前返回与期望一致");
  }
}

/*
  Flage = 0 无需安全访问
  Flage = 1 需安全访问
*/
_Set_11_Restoration(byte Flage)
{
  byte Temp[2]={0x11,0x01};
  int k,Serve_Pos;
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
  {
    _WriteEx_and_Report("","未查询到支持11服务");
    return;
  }
  if(Flage == 1)
  {
    if(Serve_Data[Serve_Pos].Security_Access[0]==1)
      _unlockECU();
  }
  Temp[1] = Serve_Data[Serve_Pos].Serve_Fun[0];
  _Send_Diag(2,phyreq_ID,Temp);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000); /*11复位后增加延时时间防止后续出错*/
  Session_BIN = 1;
}

/*
  通过种子计算出密钥并发送,发送多个正确秘钥
  len 发送长度
  ID 发送ID
  Temp_seed 种子
*/
_Send_Key_(byte len, dword ID,qword Temp_seed,int Type)   
{
  byte Key_Data[500];
  dword m=0;
  dword Skey;
  int i;
  word key_i,End_Byte;
  
  Key_Data[0] = 0x27;
  Key_Data[1] = SendKey_27;
  if(AES_128 == 0)
  {
    byte Skey_Temp_Byte[4];
    SecurityAccess(Temp_seed,Skey);
    testStep("密钥","计算出密钥为0x%2X",Skey);
    Skey_Temp_Byte[3] = Skey&0xFF;
    Skey_Temp_Byte[2] = (Skey>>8)&0xFF;
    Skey_Temp_Byte[1] = (Skey>>16)&0xFF;
    Skey_Temp_Byte[0] = (Skey>>24)&0xFF;
    for(m=2;m<len;m++)
      Key_Data[m] = Skey_Temp_Byte[(m-2)%4];
  }
  else if(AES_128 == 1)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CMAC算法");
    _Key_Count();
    for(key_i = 0; key_i < len; key_i++)
      Key_Data[key_i+2] = corresKey[key_i%16];
  }
  else if(AES_128 == 2)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    for(m=0;m<16;m++)
      RA[m]=Seed_CBC[m];
    /*用密钥KEY解密RA 得到ra`*/
    AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,Iv);
    /*ra`逆向*/
    reverseNum(ra,16);
    testWaitForTimeout(50);
    /*用密钥KEY加密r得到R*/
    AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,Iv);
    for(key_i = 0; key_i < len; key_i++)
      Key_Data[key_i+2] = R[key_i%16];
  }
  if(Type>=0)
    Key_Data[1] = Type;
  _Send_Diag(len,ID,Key_Data);   
}

_Key_Count() // 用于匹配简化输入调用，计算安全秘钥使用
{
  switch(@AUTO::Config_Switch)
  {
    case 2://长安掩码
      _SecurityAccess_AES(Seed_AES,fixByte_CCAG_APP,corresKey);break;
    case 4:
       if(Session_BIN == 2)
        _SecurityAccess_AES(Seed_AES,fixByte_Geely_Bt,corresKey);
       else
        _SecurityAccess_AES(Seed_AES,fixByte_Geely_APP,corresKey);
       break;
    case 6://瑞驰掩码
      _SecurityAccess_AES(Seed_AES,fixByte_RC_BT,corresKey);break;
    case 11:
      _SecurityAccess_AES(Seed_AES,fixByte_Chery_BT,corresKey);break;
    default:
      _WriteEx_and_Report("","未收到正确的配置信息");break;
  }
}

int _Check_Dword_in_Num(byte Da,byte Data[],int Len)//检测数据是否在整形数组中
{
  int flage,n;
  flage = -1;
  for(n=0;n<Len;n++)
  {
    if(Da==Data[n])
    {
      flage = n;
      break;
    }
  }
  return flage;
}
/*
    检测31H中当前寻址以及会话是否有支持的RID
*/
int _Check_Serve31H_(dword ID,byte Session)
{
  int i,Return_Value;
  byte Add,Sess;
  if(ID == funreq_ID)
    Add = 2;
  else if(ID == phyreq_ID)
    Add = 1;
  if(Session == defsession)
    Sess = 1;
  else if(Session == prosession)
    Sess = 2;
  else if(Session == exsession)
    Sess = 4;
  Return_Value = 0;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    if((Serve_31_Hex[i].Serve_Addres[0]& Add) != 0)
    {
      if((Serve_31_Hex[i].Serve_Session[0]& Sess) != 0)
      {
        Return_Value = 1;
        break;
      }
    }
  }
  return Return_Value;
}