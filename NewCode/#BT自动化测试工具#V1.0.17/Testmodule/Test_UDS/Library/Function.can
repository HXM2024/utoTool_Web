/*****************新老化板******************/
//RelayON(端口X) ：端口X 黑色接口-黄色接口
//RelayOFF(端口X)：端口X 黑色接口-绿色接口
void RelayON(byte Ctr_state)
{
  Relaymsg.can = Board_Channel;
  Relaymsg.id=0x101;
  if(Burn_in_Board==2)
    LHB_State = LHB_State_New;
  switch(Ctr_state)
  {//置为0
    case 1:LHB_State &=0xFE;break;
    case 2:LHB_State &=0xFD;break;
    case 3:LHB_State &=0xFB;break;
    case 4:LHB_State &=0xF7;break;
  }
  LHB_State_New = LHB_State;
  Relaymsg.byte(0) = LHB_State;
  output(Relaymsg);
}
void RelayOFF(byte Ctr_state)
{ 
  Relaymsg.can = Board_Channel;
  Relaymsg.id=0x101;
  if(Burn_in_Board==2)
    LHB_State = LHB_State_New;
  switch(Ctr_state)
  {//置为1
    case 1:LHB_State |=1;break;
    case 2:LHB_State |=2;break;
    case 3:LHB_State |=4;break;
    case 4:LHB_State |=8;break;
  }
  LHB_State_New = LHB_State;
  Relaymsg.byte(0) = LHB_State;
  output(Relaymsg);
}
void _K15_ON()
{
  if(Burn_in_Board==2)
    RelayOFF(2);
  else if(Burn_in_Board==1 || @Test::Burn_Board_Type == 1)
    RelayON(2);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x01;
    IGON.byte(2)=0x01;
    output (IGON);
  } 
  testWaitForTimeout(200);
  _WriteEx_and_Report("上点火","K15->ON,维持200ms");
}
void _K15_OFF()
{
  if(Burn_in_Board==2)
    RelayON(2);
  else if(Burn_in_Board==1 || @Test::Burn_Board_Type == 1)
    RelayOFF(2);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x01;
    IGON.byte(2)=0x00;
    output (IGON);
  } 
  testWaitForTimeout(200);
  _WriteEx_and_Report("下点火","K15->OFF,维持200ms");
}
void _K30_ON()
{
  if(Burn_in_Board==2)
    RelayOFF(1);
  else if(Burn_in_Board==1 || @Test::Burn_Board_Type == 1)
    RelayON(1);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x27;
    IGON.byte(2)=0x01;
    output (IGON);
  } 
  testWaitForTimeout(200);
  _WriteEx_and_Report("上总电","K30->ON,维持200ms");
}
void _K30_OFF()
{
  if(Burn_in_Board==2)
    RelayON(1);
  else if(Burn_in_Board==1 || @Test::Burn_Board_Type == 1)
    RelayOFF(1);
  else 
  {
    IGON.can = Board_Channel;
    IGON.byte(0)=0x02;
    IGON.byte(1)=0x27;
    IGON.byte(2)=0x00;
    output (IGON);
  } 
  testWaitForTimeout(200);
  _WriteEx_and_Report("下总电","K30->OFF,维持200ms");
}

/*从ini文件中初始化变量*/
void Get_value()
{
  char id_string[5000] = ""; 
  char Temp_Value[500];
  char Temp_2[500];
  byte Temp_data[5];
  snprintf(id_string,elCount(id_string),"%s","");
  snprintf(Temp_Value,elCount(Temp_Value),"%s","");
  glbHandle1 = OpenFileRead(file_name_1,0);
  getProfileString("Project_Information", "ECU_project","Null",ECU_project, 1000, file_name_1); 
  
  p2cmax = getProfileInt(ECU_project,"p2cmax",p2cmax,file_name_1);
  Send_filler = getProfileInt(ECU_project,"Send_filler",Send_filler,file_name_1);
  filler = getProfileInt(ECU_project,"filler",filler,file_name_1);
  Fun_NRC13 = getProfileInt(ECU_project,"Fun_NRC13",Fun_NRC13,file_name_1);
  P2can_server = getProfileInt(ECU_project,"P2can_server",P2can_server,file_name_1);
  P2_can_server = getProfileInt(ECU_project,"P2_can_server",P2_can_server,file_name_1);
  
  /*10服务*/
  Sub_1002_Time_Flage = getProfileInt(ECU_project,"Sub_1002_Time_Flage",Sub_1002_Time_Flage,file_name_1);
  Sub_1002_Time = getProfileInt(ECU_project,"Sub_1002_Time",Sub_1002_Time,file_name_1);
  Pre_Programmed_UnlockECU =  getProfileInt(ECU_project,"Pre_Programmed_UnlockECU",Pre_Programmed_UnlockECU,file_name_1);
  Pre_Programmed_1002 = getProfileInt(ECU_project,"Pre_Programmed_1002",Pre_Programmed_1002,file_name_1);
  Sub_1002_NRC78 = getProfileInt(ECU_project,"Sub_1002_NRC78",Sub_1002_NRC78,file_name_1);
  Sub_1082_NRC78 = getProfileInt(ECU_project,"Sub_1082_NRC78",Sub_1082_NRC78,file_name_1);
  Factory_1060 = getProfileInt(ECU_project,"Factory_1060",Factory_1060,file_name_1);
  sts_resp10 = getProfileArray(ECU_project,"Resp_10_len",Resp_10_len,elcount(Resp_10_len),file_name_1);

  /*其他*/
  BT_Double_Backup = getProfileInt(ECU_project,"BT_Double_Backup",BT_Double_Backup,file_name_1);
  Set_Battery_RS232 = getProfileInt(ECU_project,"Set_Battery_RS232",Set_Battery_RS232,file_name_1);
  Burn_in_Board = getProfileInt(ECU_project,"Burn_in_Board",Burn_in_Board,file_name_1);
  Board_Channel = getProfileInt(ECU_project,"Board_Channel",Board_Channel,file_name_1);
  
  Car_Spd_ID = getProfileInt(ECU_project,"Car_Spd_ID",Car_Spd_ID,file_name_1);
  getProfileString(ECU_project, "CarSpd_Sig","Null",CarSpd_Sig, 50, file_name_1);
  getProfileString(ECU_project, "CarSpdInvalid_Sig","Null",CarSpdInvalid_Sig, 50, file_name_1);
  Car_Spd_Invalid =  getProfileInt(ECU_project,"Car_Spd_Invalid",Car_Spd_Invalid,file_name_1);
  Lost_CarSpd_Time =  getProfileInt(ECU_project,"Lost_CarSpd_Time",Lost_CarSpd_Time,file_name_1);
  
  Ready_ID = getProfileInt(ECU_project,"Ready_ID",Ready_ID,file_name_1);
  getProfileString(ECU_project, "Ready_Sig","Null",Ready_Sig, 50, file_name_1);
  Ready_Active = getProfileInt(ECU_project,"Ready_Active",Ready_Active,file_name_1);
  getProfileString(ECU_project, "ReadyInvalid_Sig","Null",ReadyInvalid_Sig, 50, file_name_1);
  Ready_Invalid =  getProfileInt(ECU_project,"Ready_Invalid",Ready_Invalid,file_name_1);
  ReadyInvalid_Time =  getProfileInt(ECU_project,"ReadyInvalid_Time",ReadyInvalid_Time,file_name_1);
  
  /*-----------------------------------NRC22--------------------------*/
  NRC22_CarSpd = getProfileInt(ECU_project,"NRC22_CarSpd",NRC22_CarSpd,file_name_1);
  NRC22_Battery_Hight =  getProfileFloat(ECU_project,"NRC22_Battery_Hight",NRC22_Battery_Hight,file_name_1);
  NRC22_Battery_Low =  getProfileFloat(ECU_project,"NRC22_Battery_Low",NRC22_Battery_Low,file_name_1);
  H_Battery_Time = getProfileInt(ECU_project,"H_Battery_Time",H_Battery_Time,file_name_1);
  L_Battery_Time = getProfileInt(ECU_project,"L_Battery_Time",L_Battery_Time,file_name_1);
  NRC22_TasTorque =  getProfileFloat(ECU_project,"NRC22_TasTorque",NRC22_TasTorque,file_name_1);
  NRC_22_Gears_Normal = getProfileInt(ECU_project,"NRC_22_Gears_Normal",NRC_22_Gears_Normal,file_name_1);
  Gears_ID = getProfileInt(ECU_project,"Gears_ID",Gears_ID,file_name_1);
  getProfileString(ECU_project, "Gears_Signal","Null",Gears_Signal, 50, file_name_1);
  /*-----------------------------------------------------------------*/
  
  /*27服务*/
  AES_128 = getProfileInt(ECU_project,"AES_128",AES_128,file_name_1);
  Error_Count = getProfileInt(ECU_project,"Error_Count",Error_Count,file_name_1);
  RequestSeed_27 = getProfileInt(ECU_project,"RequestSeed_27",RequestSeed_27,file_name_1);
  SendKey_27 = getProfileInt(ECU_project,"SendKey_27",SendKey_27,file_name_1);
  DiagSetPrimitiveByte(reqseed,1,RequestSeed_27);
  DiagSetPrimitiveByte(sendkey,1,SendKey_27);
  SendKey_Len = getProfileInt(ECU_project,"SendKey_Len",SendKey_Len,file_name_1);
  Error_Count_Delay = getProfileInt(ECU_project,"Error_Count_Delay",Error_Count_Delay,file_name_1);
  Error_Count_Change = getProfileInt(ECU_project,"Error_Count_Change",Error_Count_Change,file_name_1);
  Restoration_Error_Count = getProfileInt(ECU_project,"Restoration_Error_Count",Restoration_Error_Count,file_name_1);
  Request_Seed_Consistency = getProfileInt(ECU_project,"Request_Seed_Consistency",Request_Seed_Consistency,file_name_1);
  Error_Count_Delay_Tolerance = getProfileInt(ECU_project,"Error_Count_Delay_Tolerance",Error_Count_Delay_Tolerance,file_name_1);
  Error_Count_Delay_Reset = getProfileInt(ECU_project,"Error_Count_Delay_Reset",Error_Count_Delay_Reset,file_name_1);
  Request_Error_Count = getProfileInt(ECU_project,"Request_Error_Count",Request_Error_Count,file_name_1);
  Request_Seed_Count = getProfileInt(ECU_project,"Request_Seed_Count",Request_Seed_Count,file_name_1);
  Serve_11_Unlock_Count = getProfileInt(ECU_project,"Serve_11_Unlock_Count",Serve_11_Unlock_Count,file_name_1);
  ReqSeed_Count = getProfileInt(ECU_project,"ReqSeed_Count",ReqSeed_Count,file_name_1);
  
  /*31服务*/
  BT_0203_Pro = getProfileInt(ECU_project,"BT_0203_Pro",BT_0203_Pro,file_name_1);
  Serve31_NRC_Case = getProfileInt(ECU_project,"Serve31_NRC_Case",Serve31_NRC_Case,file_name_1);
  /*34服务*/
  Len_34_Addr = getProfileInt(ECU_project,"Len_34_Addr",Len_34_Addr,file_name_1);
  Len_34_Length = getProfileInt(ECU_project,"Len_34_Length",Len_34_Length,file_name_1);
  /*22服务*/
  Ergodic_22H = getProfileInt(ECU_project,"Ergodic_22H",Ergodic_22H,file_name_1);
  Fun_DID22 = getProfileInt(ECU_project,"Fun_DID22",Fun_DID22,file_name_1);
  DID_22_Support = getProfileInt(ECU_project,"DID_22_Support",DID_22_Support,file_name_1);
  /*2E服务*/
  Ergodic_2EH = getProfileInt(ECU_project,"Ergodic_2EH",Ergodic_2EH,file_name_1);
  
  /*TP层*/
  TP_filler = getProfileInt(ECU_project,"TP_filler",TP_filler,file_name_1);
  BS = getProfileInt(ECU_project,"BS",BS,file_name_1);
  STmin = getProfileInt(ECU_project,"STmin",STmin,file_name_1);
  N_Bs_Time = getProfileInt(ECU_project,"N_Bs_Time",N_Bs_Time,file_name_1);
  N_Bs_Time_Tolerance = getProfileInt(ECU_project,"N_Bs_Time_Tolerance",N_Bs_Time_Tolerance,file_name_1);
  N_Cr_Time = getProfileInt(ECU_project,"N_Cr_Time",N_Cr_Time,file_name_1);
  N_Cr_Time_Tolerance = getProfileInt(ECU_project,"N_Cr_Time_Tolerance",N_Cr_Time_Tolerance,file_name_1);
  N_Cs_Time = getProfileInt(ECU_project,"N_Cs_Time",N_Cs_Time,file_name_1);
  N_Cs_Time_Tolerance = getProfileInt(ECU_project,"N_Cs_Time_Tolerance",N_Cs_Time_Tolerance,file_name_1);
  
  MF_Phy_SF_RxDisturb = getProfileInt(ECU_project,"MF_Phy_SF_RxDisturb",MF_Phy_SF_RxDisturb,file_name_1);
  MF_Fun_SF_RxDisturb = getProfileInt(ECU_project,"MF_Fun_SF_RxDisturb",MF_Fun_SF_RxDisturb,file_name_1);
  MF_Phy_MF_RxDisturb = getProfileInt(ECU_project,"MF_Phy_MF_RxDisturb",MF_Phy_MF_RxDisturb,file_name_1);
  MF_Fun_MF_RxDisturb = getProfileInt(ECU_project,"MF_Fun_MF_RxDisturb",MF_Fun_MF_RxDisturb,file_name_1);
  MF_Phy_SF_TxDisturb = getProfileInt(ECU_project,"MF_Phy_SF_TxDisturb",MF_Phy_SF_TxDisturb,file_name_1);
  MF_Fun_SF_TxDisturb = getProfileInt(ECU_project,"MF_Fun_SF_TxDisturb",MF_Fun_SF_TxDisturb,file_name_1);
  MF_Phy_MF_TxDisturb = getProfileInt(ECU_project,"MF_Phy_MF_TxDisturb",MF_Phy_MF_TxDisturb,file_name_1);
  MF_Fun_MF_TxDisturb = getProfileInt(ECU_project,"MF_Fun_MF_TxDisturb",MF_Fun_MF_TxDisturb,file_name_1);
  H_Disturb = getProfileInt(ECU_project,"H_Disturb",H_Disturb,file_name_1);
  Response_CanFD = getProfileInt(ECU_project,"Response_CanFD",Response_CanFD,file_name_1);
  TP_LastCFLen = getProfileInt(ECU_project,"TP_LastCFLen",TP_LastCFLen,file_name_1);
  FF_DL_Max = getProfileInt(ECU_project,"FF_DL_Max",FF_DL_Max,file_name_1);
  N_Br_Time = getProfileInt(ECU_project,"N_Br_Time",N_Br_Time,file_name_1);
  N_Br_Time_Tolerance = getProfileInt(ECU_project,"N_Br_Time_Tolerance",N_Br_Time_Tolerance,file_name_1);

  funreq_ID = getProfileInt(ECU_project,"funreq_ID",funreq_ID,file_name_1);
  phyreq_ID = getProfileInt(ECU_project,"phyreq_ID",phyreq_ID,file_name_1);
  Response_ID = getProfileInt(ECU_project,"Response_ID",Response_ID,file_name_1);
  
  @sysvar::DID::funreq_ID=getProfileInt (ECU_project, "funreq_ID",0,file_name_1);
  funreq_ID = @sysvar::DID::funreq_ID;
  @sysvar::DID::phyreq_ID=getProfileInt (ECU_project, "phyreq_ID",0,file_name_1);
  phyreq_ID = @sysvar::DID::phyreq_ID;
  @sysvar::DID::Response_ID=getProfileInt (ECU_project, "Response_ID",0,file_name_1);
  Response_ID = @sysvar::DID::Response_ID;
  if(InitConfig == 0)
  {
    InitConfig = 1;//标志位置位，取消下一次初始化过程
    if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
      @AUTO::Config_Switch = 1;
    else if(strncmp(ECU_project,"ChangAn",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("ChangAn"))
      @AUTO::Config_Switch = 2;
    else if(strncmp(ECU_project,"Geely1.0",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Geely1.0"))
      @AUTO::Config_Switch = 3;
    else if(strncmp(ECU_project,"Geely3.0",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Geely3.0"))
      @AUTO::Config_Switch = 4;
    else if(strncmp(ECU_project,"SRM",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("SRM"))
      @AUTO::Config_Switch = 5;
    else if(strncmp(ECU_project,"RC",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("RC"))
      @AUTO::Config_Switch = 6;
    else if(strncmp(ECU_project,"Chery",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Chery"))
      @AUTO::Config_Switch = 7;
    else if(strncmp(ECU_project,"SGMW",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("SGMW"))
      @AUTO::Config_Switch = 8;
    else if(strncmp(ECU_project,"Seres",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Seres"))
      @AUTO::Config_Switch = 10;
    else if(strncmp(ECU_project,"Chery5.0",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("Chery5.0"))
      @AUTO::Config_Switch = 11;
    else if(strncmp(ECU_project,"GAC",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("GAC"))
      @AUTO::Config_Switch = 12;
    
    if(AES_128 == 0)
      @AUTO::Security_Switch=0;
    else if(AES_128 == 1)
      @AUTO::Security_Switch=2;
    else if(AES_128 == 2)
      @AUTO::Security_Switch=1;
  }
  fileClose(glbHandle1);
  testWaitForTimeout(200);
  
}
_Set_Sig(char Sig[],int Vaule)
{
  char _str[80];
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",Sig);
  
  setSignal(Sig,Vaule);                   /*信号赋值*/
  putValue(Sig,Vaule);                          /*非系统变量赋值*/
  putValue(_str,Vaule);                          /*非系统变量赋值*/
  writeEx(-3,0,"设置信号 %s 值为 %d",Sig,Vaule);
  testStep("","设置信号 %s 值为 %d",Sig,Vaule);
  testWaitForTimeout(200);
}
_Set_CarSpd(dword Spd)
{
  char _str[80];
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",CarSpd_Sig);
  
  setSignal(CarSpd_Sig,Spd);                   /*信号赋值*/
  putValue(_str,Spd);                          /*非系统变量赋值*/
  _WriteEx_and_Report("","设置车速为 %d",Spd);
  testWaitForTimeout(500);
}
_Set_CarSpd_Invalid(byte State)
{
  char _str[80];
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",CarSpdInvalid_Sig);
  setSignal(CarSpdInvalid_Sig,State);
  putValue(_str,State);
  _WriteEx_and_Report("","设置车速有效位状态为 %d",State);
//  testWaitForTimeout(Invalid_CarSpd_Time*1.2);
  testWaitForTimeout(Lost_CarSpd_Time*1.2);
}
_Reset_CarSpd_Invalid()
{
  char _str[80];
  byte State;
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",CarSpdInvalid_Sig);
  if(strncmp(ECU_project,"Geely3.0",strlen("Geely3.0")) == 0 || @AUTO::Config_Switch == 4)
    State=3;
  else
    State=0;
  setSignal(CarSpdInvalid_Sig,State);
  putValue(_str,State);
  _WriteEx_and_Report("","恢复车速有效位状态为 %d",State);
  testWaitForTimeout(500);
}
_Set_Ready(byte Ready)
{
  char _str[80];
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",Ready_Sig);
  setSignal(Ready_Sig,Ready);
  putValue(_str,Ready);
  _WriteEx_and_Report("","设置发动机状态为 %d",Ready);
  testWaitForTimeout(500);
}
_Set_Battery(double Value)
{
  char str[100];
  diagStartTesterPresent(Cdd_Name);
//  diagStartTesterPresent(Cdd_Name);
  snprintf(str,elCount(str),"%s","");
  snprintf(str,elCount(str),"设置电压为 %.2f V",Value);
  if(Value>35)
  {
    testStep("Battery","设置电压值较大,后续测试时间较长会损坏控制器,建议人为测试精确时间");
  }
  else
  {
    if(Set_Battery_RS232==0)
      testWaitForTesterConfirmation(str,30000);
    else if(Set_Battery_RS232==1)
    {
      @sysvar::Prog_power::K30Volt = Value;
      _WriteEx_and_Report("电压",str);
    }
    if(Value > NRC22_Battery_Hight)
      testWaitForTimeout(H_Battery_Time*1.1);
    else if(Value < NRC22_Battery_Low)
      testWaitForTimeout(L_Battery_Time*1.1);
    else
      testWaitForTimeout(1000);
  }
  diagStopTesterPresent(Cdd_Name);
}
_Set_Gears(byte Value)
{
  char _str[80];
  snprintf(_str,elCount(_str),"%s","");
  snprintf(_str,elCount(_str),"EV_%s",Gears_Signal);
  setSignal(Gears_Signal,Value);
  putValue(_str,Value);
  _WriteEx_and_Report("","设置档位状态为 %d",Value);
  testWaitForTimeout(500);
}
void _Get_0x34(char Add[], char Len[])
{
  char Temp_Value_1[500];
  char Temp_Value_2[500];
  char Temp_Value_3[500];
  qword BT_34_Address[2];
  qword BT_34_Length[2];
  int i,j,k;

  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
  snprintf(Temp_Value_3,elCount(Temp_Value_3),"%s","");
  glbHandle1 = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,Add,"Null",Temp_Value_2, 500, file_name_1);
  getProfileString(ECU_project,Len,"Null",Temp_Value_3, 500, file_name_1);
  fileClose(glbHandle1);
  /***************************获取地址范围*************************/
  j=0;
  for(i=1;i<50;i++)
  {
    if(Temp_Value_2[i]== 44 || Temp_Value_2[i]==125)
    {
//      BT_34_Address[j] = atol(Temp_Value_1);
      strtoull(Temp_Value_1,BT_34_Address[j]);
//      writeEx(-3,1,"BT_34_Add_End[%d] = %x",j,BT_34_Address[j]);
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      j++;
      if(Temp_Value_2[i]==125)
        break;
    }
    else
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_2[i]);
  }
  /****************************************************************/
  /***************************获取长度范围*************************/
  j=0;
 for(i=1;i<50;i++)
  {
    if(Temp_Value_3[i]== 44 || Temp_Value_3[i]==125)
    {
//      BT_34_Address[j] = atol(Temp_Value_1);
      strtoull(Temp_Value_1,BT_34_Length[j]);
//      writeEx(-3,1,"BT_34_Length[%d] = %x",j,BT_34_Length[j]);
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
      j++;
      if(Temp_Value_3[i]==125)
        break;
    }
    else
      snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s%c",Temp_Value_1,Temp_Value_3[i]);
  }
  @Test::BT_34_Add_Start = BT_34_Address[0];
  @Test::BT_34_Add_End = BT_34_Address[1];
  @Test::BT_34_Len_Start = BT_34_Length[0];
  @Test::BT_34_Len_End = BT_34_Length[1];
  /****************************************************************/
}
/*
    Type == 0:APP取正常范围数据  
    Type == 1:APP仅地址范围异常  
    Type == 2:APP仅长度范围异常  
    Type == 3:APP地址及长度范围异常  
    Type == 4:Flash取正常范围数据  
    Type == 5:Flash仅地址范围异常  
    Type == 6:Flash仅长度范围异常  
    Type == 7:Flash地址及长度范围异常 
*/
_Get_Serve_INI(byte Send_Data[],byte Serve,byte Serve_Address,byte Type) 
{
  char Temp_Value[500];
  char Temp_Value_1[500];
  char Temp_Value_2[500];
  char Temp_Value_3[500];
  char Temp_Value_4[500];
  char Temp_Value_5[500];
  byte Temp_data[5];
  int i,j;
  int Address_Len,Length_Len,Fun_Len;
  dword Temp_Address_Set,Temp_Address_Set_L;
  dword Temp_Length_Set;
//  dword BT_34_Address[2];
  dword BT_34_Length[2];
//  dword BT_Flash_Address[2];
  dword BT_Flash_Length[2];
  
  
  snprintf(Temp_Value,elCount(Temp_Value),"%s","");
  snprintf(Temp_Value_1,elCount(Temp_Value_1),"%s","");
  snprintf(Temp_Value_2,elCount(Temp_Value_2),"%s","");
  snprintf(Temp_Value_3,elCount(Temp_Value_3),"%s","");
  snprintf(Temp_Value_4,elCount(Temp_Value_4),"%s","");
  snprintf(Temp_Value_5,elCount(Temp_Value_5),"%s","");
  glbHandle1 = OpenFileRead(file_name_1,0);
  getProfileString("Project_Information", "ECU_project","Null",ECU_project, 100, file_name_1);
  getProfileString(ECU_project,"BT_34_Address","Null",Temp_Value_2, 500, file_name_1);
  getProfileString(ECU_project,"BT_34_Length","Null",Temp_Value_3, 500, file_name_1);
  getProfileString(ECU_project,"BT_Flash_Address","Null",Temp_Value_4, 500, file_name_1);
  getProfileString(ECU_project,"BT_Flash_Length","Null",Temp_Value_5, 500, file_name_1);
  fileClose(glbHandle1);
  Send_Data[0] = Serve;
  /***************************获取参数******************************/
  if(Type != 3 && Type != 7)
  {
    for(i=0;i<Serve_Data[Serve_Address].Serve_Para_Count[0];i++)
      Send_Data[i+1] = Serve_Data[Serve_Address].Serve_Para[0][i];
  }
  BT_34_Len = 3 + Len_34_Addr + Len_34_Length;
  /****************************************************************/
  /***************************获取地址范围*************************/
  if(Type == 0 || Type == 1 || Type == 2 || Type == 3)
  {
    _Get_0x34("BT_34_Address","BT_34_Length");
//    BT_34_Address[0] = @Test::BT_34_Add_Start;
//    BT_34_Address[1] = @Test::BT_34_Add_End;
    
    BT_34_Length[0] = @Test::BT_34_Len_Start;
    BT_34_Length[1] = @Test::BT_34_Len_End;
  }
  if(Type == 4 || Type == 5 || Type == 6 || Type == 7)
  {
    _Get_0x34("BT_Flash_Address","BT_Flash_Length");
//    BT_Flash_Address[0] = @Test::BT_34_Add_Start;
//    BT_Flash_Address[1] = @Test::BT_34_Add_End;
    BT_Flash_Length[0] = @Test::BT_34_Len_Start;
    BT_Flash_Length[1] = @Test::BT_34_Len_End;
  }
//  writeEx(-3,1,"@Test::BT_34_Add_Start = 0x%X, @Test::BT_34_Add_End = 0x%X",@Test::BT_34_Add_Start,@Test::BT_34_Add_End);
//  writeEx(-3,1,"BT_34_Address[0] = 0x%X, BT_34_Address[1] = 0x%X",BT_34_Address[0],BT_34_Address[1]);
//  writeEx(-3,1,"BT_34_Length[0] = 0x%X, BT_34_Length[1] = 0x%X",BT_34_Length[0],BT_34_Length[1] );
//  writeEx(-3,1,"BT_Flash_Address[0] = 0x%X, BT_Flash_Address[1] = 0x%X",BT_Flash_Address[0],BT_Flash_Address[1] );
//  writeEx(-3,1,"BT_Flash_Length[0] = 0x%X, BT_Flash_Length[1] = 0x%X",BT_Flash_Length[0],BT_Flash_Length[1] );
  /****************************************************************/
  /***************************取地址及长度*************************/
  Address_Len = Len_34_Addr;
  Length_Len = Len_34_Length;
  Fun_Len = 3;
  if(Type == 0) //正常范围
  {
//    do{
//      Temp_Address_Set = random(BT_34_Address[1]);
//    }while(Temp_Address_Set<=BT_34_Address[0] || Temp_Address_Set>=BT_34_Address[1]);
    do{
      Temp_Length_Set = random(BT_34_Length[1]);
    }while(Temp_Length_Set<=BT_34_Length[0] || Temp_Length_Set>=BT_34_Length[1]);
    
    Temp_Address_Set = ((@Test::BT_34_Add_Start + Temp_Length_Set)>>16);
    Temp_Address_Set_L = ((@Test::BT_34_Add_Start + Temp_Length_Set)&0xFFFF);
  }
  else if(Type==1)  //APP地址范围异常
  {
//    Temp_Address_Set = 0xFFFFFFFF;
    Temp_Address_Set = 0xFFFF;
    Temp_Address_Set_L = 0xFFFF;
    do{
      Temp_Length_Set = random(BT_34_Length[1]);
    }while(Temp_Length_Set<=BT_34_Length[0] || Temp_Length_Set>=BT_34_Length[1]);
  }  
  else if(Type==2) //APP长度范围异常
  {
//    do{
//      Temp_Address_Set = random(BT_34_Address[1]);
//    }while(Temp_Address_Set<=BT_34_Address[0] || Temp_Address_Set>=BT_34_Address[1]);
    Temp_Address_Set = (@Test::BT_34_Add_Start>>16);
    Temp_Address_Set_L = (@Test::BT_34_Add_Start&0xFFFF);
    Temp_Length_Set = 0xFFFFFFFF;
  }  
  else if(Type==3) //APP均异常
  {
//    Temp_Address_Set = 0xFFFFFFFF;
    Temp_Address_Set = 0xFFFF;
    Temp_Address_Set_L = 0xFFFF;
    Temp_Length_Set = 0xFFFFFFFF;
  }  
  else if(Type==4)  //Flash正常范围
  {
//    Temp_Address_Set = BT_Flash_Address[0];
    Temp_Address_Set = (@Test::BT_34_Add_Start>>16);
    Temp_Address_Set_L = (@Test::BT_34_Add_Start&0xFFFF);
    Temp_Length_Set = BT_Flash_Length[0];
  }  
  else if(Type==5)  //Flash地址范围异常
  {
//    Temp_Address_Set = 0xFFFFFFFF;
    Temp_Address_Set = 0xFFFF;
    Temp_Address_Set_L = 0xFFFF;
    do{
      Temp_Length_Set = random(BT_Flash_Length[1]);
    }while(Temp_Length_Set<=BT_Flash_Length[0] || Temp_Length_Set>=BT_Flash_Length[1]);
  }  
  else if(Type==6) //Flash长度范围异常
  {
//    do{
//      Temp_Address_Set = random(BT_Flash_Address[1]);
//    }while(Temp_Address_Set<=BT_Flash_Address[0] || Temp_Address_Set>=BT_Flash_Address[1]);
    Temp_Address_Set = (@Test::BT_34_Add_Start>>16);
    Temp_Address_Set_L = (@Test::BT_34_Add_Start&0xFFFF);
    Temp_Length_Set = 0xFFFFFFFF;
  }  
  else if(Type==7) //Flash均异常
  {
//    Temp_Address_Set = 0xFFFFFFFF;
    Temp_Address_Set = 0xFFFF;
    Temp_Address_Set_L = 0xFFFF;
    Temp_Length_Set = 0xFFFFFFFF;
  }  
  
  for(i = Fun_Len; i < Fun_Len + Address_Len/2; i++)
    Send_Data[i] = (Temp_Address_Set>>((Fun_Len + (Address_Len/2)-1-i)*8))&0xFF;
  for(i = Fun_Len + Address_Len/2; i < Fun_Len + Address_Len; i++)
    Send_Data[i] = (Temp_Address_Set_L>>((Fun_Len + Address_Len-1-i)*8))&0xFF;
  
  for(i = Fun_Len+Address_Len; i < BT_34_Len; i++)
    Send_Data[i] = (Temp_Length_Set>>((BT_34_Len-1-i)*8))&0xFF;
  /****************************************************************/ 
}

/*重置为默认会话或扩展会话*/
_SetSession(byte Session)
{
  if(Session==defsession)
  {
    _Switch_To_Def();
    Session_BIN = 0x01;
  }
  else if(Session==prosession)
  {
    _Switch_To_Pro();
    Session_BIN = 0x02;
  }
  else if(Session==exsession)
  {
    _Switch_To_Ex();
    Session_BIN = 0x04;
  }
}
/*请求重置为默认会话*/
void _Switch_To_Def()
{
  testCaseComment("请求重置为默认会话");
//  diagSetTarget(Cdd_Name);
  diagResize(Session_Start,2);
  DiagSetPrimitiveByte(Session_Start,0,0x10);
  DiagSetPrimitiveByte(Session_Start,1,defsession);
  diagSendRequest(Session_Start);
  testWaitForDiagRequestSent(Session_Start,500);
  testWaitForDiagResponse(Session_Start,p2cmax);
  testReportWriteDiagResponse(Session_Start);
  testWaitForTimeout(100); //防止复位导致后续无响应
  /*判断重置默认会话是否成功并体现在报告里*/
  if(diagGetLastResponseCode(Session_Start)==-1)
    testStepPass("重置默认会话成功");
  else
    testStepFail("重置默认会话失败");
}
/*请求重置为扩展会话*/
void _Switch_To_Ex()
{
  testCaseComment("请求重置为扩展会话");
//  diagSetTarget(Cdd_Name);
  _Switch_To_Def();
  testWaitForTimeout(500);
  diagResize(Session_Start,2);
  DiagSetPrimitiveByte(Session_Start,0,0x10);
  DiagSetPrimitiveByte(Session_Start,1,exsession);
  diagSendRequest(Session_Start);
  testWaitForDiagRequestSent(Session_Start,500);
  testWaitForDiagResponse(Session_Start,p2cmax);
  testReportWriteDiagResponse(Session_Start);
  testWaitForTimeout(100); //防止复位导致后续无响应
  /*判断重置扩展会话是否成功并体现在报告里*/
  if(diagGetLastResponseCode(Session_Start)==-1)
    testStepPass("重置扩展会话成功");
  else
    testStepFail("重置扩展会话失败");
}
/*请求重置为编程会话*/
void _Switch_To_Pro()
{
  testCaseComment("请求重置为编程会话");
  if(_Check_Serve(0x10,0x03,4) >= 0)  //20260409出现BT下不支持1003故修改
    _Switch_To_Ex();
  else
    _Switch_To_Def();
    
  testWaitForTimeout(500);
  if(Pre_Programmed_1002==1)
    _Pre_Programmed();
  if((_Check_Serve(0x10,0x02,5)==1) && (Pre_Programmed_UnlockECU==0) && (Pre_Programmed_1002==1))
    _unlockECU();
  diagResize(Session_Start,2);
  DiagSetPrimitiveByte(Session_Start,0,0x10);
  DiagSetPrimitiveByte(Session_Start,1,0x02);
  diagSendRequest(Session_Start);
  diagSetP2Extended(-1);
  testWaitForDiagRequestSent(Session_Start,500);
  testWaitForDiagResponse(Session_Start,p2cmax);
  if(diagGetLastResponseCode(Session_Start)==0x78)
    testWaitForDiagResponse(Session_Start,p2cmax*100);
  testReportWriteDiagResponse(Session_Start);
  if(diagGetLastResponseCode(Session_Start)==-1)
    testStepPass("重置编程会话成功");
  else
    testStepFail("重置编程会话失败");
  testWaitForTimeout(500);
}
_Other_1002()
{
  if(Pre_Programmed_1002 == 1)
    _Pre_Programmed();
  else if((Pre_Programmed_1002 == 1) && (Pre_Programmed_UnlockECU == 0) && (_Check_Serve(0x10,0x02,5)==1))
    _unlockECU();
  else if((_Check_Serve(0x10,0x02,5)==1) && (Pre_Programmed_1002 == 0))
    _unlockECU();
  else
  {
    _WriteEx_and_Report("","无其余条件，即10 02可直接响应");
  }
}
//用于创建Log,根据TestCase标题命名
void creat_log(char function[])
{
  //用于创造Log
  char log_name[400] = "./Logging";
  char testCaseTitle[400];
  char order[400];  
  long Time[9];
  char timeBuffer[400];
  
  snprintf(timeBuffer,elCount(timeBuffer),"%s","");
  getLocalTime(Time);
  snprintf(timeBuffer,400,"%s%s",timeBuffer,"___");
  snprintf(timeBuffer,400,"%s%d",timeBuffer,Time[5]+1900);
  snprintf(timeBuffer,400,"%s%s",timeBuffer,"-");
  snprintf(timeBuffer,400,"%s%d",timeBuffer,Time[4]+1);
  snprintf(timeBuffer,400,"%s%s",timeBuffer,"-");
  snprintf(timeBuffer,400,"%s%d",timeBuffer,Time[3]);
  snprintf(timeBuffer,400,"%s%s",timeBuffer,"_");
  if(Time[2]<10)
  {
    snprintf(timeBuffer,400,"%s%02X",timeBuffer,Time[2]);
  }
  if(Time[2]>=10)
  {
    snprintf(timeBuffer,400,"%s%d",timeBuffer,Time[2]);
  }
  snprintf(timeBuffer,400,"%s%s",timeBuffer,"-");
  if(Time[1]<10)
  {
    snprintf(timeBuffer,400,"%s%02X",timeBuffer,Time[1]);
  }
  if(Time[1]>=10)
  {
    snprintf(timeBuffer,400,"%s%d",timeBuffer,Time[1]);
  }
  snprintf(timeBuffer,400,"%s%s",timeBuffer,"-");
  if(Time[0]<10)
  {
    snprintf(timeBuffer,400,"%s%02X",timeBuffer,Time[0]);
  }
  if(Time[0]>=10)
  {
    snprintf(timeBuffer,400,"%s%d",timeBuffer,Time[0]);
  }
  x++;
  if(x < 10){
    order[0] = x+48;
    order[1] = '.';
  }
  else if(x < 100){
    order[0] = (x/10)+48;
    order[1] = (x%10)+48;
    order[2] = '.';
  }
  else if(x < 1000){
    order[0] = (x/100)+48;
    order[1] = (x/10%10)+48;
    order[2] = (x%10)+48;
    order[3] = '.';
  }
  testGetCurrentTestCaseTitle(testCaseTitle,400);
  log_name[0] = 92;
//  log_name[8] = 92;
  strncat(log_name,function,399-strlen(log_name));
  strncat(log_name,order,399-strlen(log_name));
  strncat(log_name,testCaseTitle,399-strlen(log_name));
  strncat(log_name,timeBuffer,399-strlen(log_name));
  strncat(log_name,".asc",399-strlen(log_name));
  setLogFileName(log_name);
  for(i = 9; log_name[i] !='\0'; i++ )
    log_name[i] = '\0';
}

void UDS_start_log()
{
  creat_log("//UDS_Logging//");
  startLogging();
}

void UDS_end_log()
{
  stopLogging();
  testWaitForTimeout(500);
}
/*初始化操作：让APP无效并进入相应的会话模式*/
void MainInit(byte session)
{
  _WriteEx_and_Report("","初始化");
  Get_value();
  _Init_Struct();
  diagSetTarget(Cdd_Name);
  UDS_start_log();
  _SetSession(session);

}
void End_Main()
{
  char TempStr[50];
  snprintf(TempStr,elCount(TempStr),"%s","");
  snprintf(TempStr,elCount(TempStr),"%s_Functional",Cdd_Name);
  diagStopTesterPresent(TempStr);
  diagStopTesterPresent(Cdd_Name);
  UDS_end_log();
  _Clear_Seed();
  Get_Seed_Flage = 0;
  Fun_NRC_Count = 0;
  writeEx(-3,1,"/*--------------- 测 试 结 束 --------------*/");
  testWaitForTimeout(1000);
}
/*
  发送诊断请求等待响应，并将请求和响应写进报告。
  如果响应是多帧不要使用此函数，因为p2cmax时间可能不够
*/
void _SendAndWriteReport(diagRequest* obj,dword msgID)
{
  char comment[300];
  byte primitiveRaw[300];
  long size;
  dword i;
  
  size=DiagGetPrimitiveData(obj,primitiveRaw,elCount(primitiveRaw));
  if(msgID==@sysvar::DID::phyreq_ID)
    snprintf(comment,elCount(comment),"已发送物理寻址请求:[%02X]",size);
  else
    snprintf(comment,elCount(comment),"已发送功能寻址请求:[%02X]",size);
  for(i=0;i<size;i++)
  {
    snprintf(comment,elCount(comment),"%s %02X",comment,primitiveRaw[i]);
  }
  if(msgID==@sysvar::DID::phyreq_ID)
  {
    diagSendRequest(obj);
  }
  else if(msgID==@sysvar::DID::funreq_ID)
  {
    diagSendFunctional(obj);
  }
  testWaitForDiagRequestSent(obj,1000);
  testCaseComment(comment);
  writeEx(-3,0,comment);
  testReportWriteDiagObject(obj);
  diagSetP2Extended(-1);
  testWaitForDiagResponse(obj,p2cmax);
  if(diagGetLastResponseCode(obj)==0x78)
    testWaitForDiagResponse(obj,p2cmax*100);
  testReportWriteDiagResponse(obj);
}
