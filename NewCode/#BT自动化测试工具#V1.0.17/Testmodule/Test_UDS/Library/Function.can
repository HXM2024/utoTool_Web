//发送请求等待响应，并将请求和响应写进报告。如果响应是多帧不要使用此函数，因为p2cmax时间可能不够
_SendAndWriteReport_NoTime(diagRequest* obj,dword msgID)
{
  char comment[70];
  byte primitiveRaw[300];
  long size;
  dword i;
  
  size=DiagGetPrimitiveData(obj,primitiveRaw,elCount(primitiveRaw));
  if(DiagGetPrimitiveByte(obj,0) == 0x10 || DiagGetPrimitiveByte(obj,0) == 0x11 || DiagGetPrimitiveByte(obj,0) == 0x27 || DiagGetPrimitiveByte(obj,0) == 0x3E)
  {
    NRC78_flag = 1;
  }
  if(msgID==@sysvar::DID::phyreq_ID)
    snprintf(comment,elCount(comment),"已发送物理寻址请求:[%02X]",size);
  else
    snprintf(comment,elCount(comment),"已发送功能寻址请求:[%02X]",size);
  for(i=0;i<size;i++)
  {
    snprintf(comment,elCount(comment),"%s %02X",comment,primitiveRaw[i]);
  }
  if(msgID==@sysvar::DID::phyreq_ID)
    diagSendRequest(obj);
  else if(msgID==@sysvar::DID::funreq_ID)
    diagSendFunctional(obj);
  
  diagSetP2Extended(-1);
  testWaitForDiagRequestSent(obj,1000);
  testCaseComment(comment);
  writeEx(-3,0,comment);
  testReportWriteDiagObject(obj);
}
/*
  使用物理寻址或功能寻址发送请求
  参数msgID:{phyreq_ID:物理寻址,funreq_ID:功能寻址}
  参数obj:诊断请求
*/
void _Send_Diag(int size,dword ID,byte Send_Data[])
{
  int i;
  dword LenSend;
  i=0;
  LenSend = elCount(Send_Data);
  diagResize(SendData,size);
  if(size<=LenSend)
  {
    for(i=0;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
  }
  else if(size>LenSend)
  {
    for(i=0;i<LenSend;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
    for(i=LenSend;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_filler);
  }
  _SendAndWriteReport(SendData,ID);
}

void _Send_Diag(int size,dword ID,byte Send_Data[],dword Time)
{
  int i;
  dword LenSend;
  i=0;
  LenSend = elCount(Send_Data);
  diagResize(SendData,size);
  if(size<=LenSend)
  {
    for(i=0;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
  }
  else if(size>LenSend)
  {
    for(i=0;i<LenSend;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
    for(i=LenSend;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_filler);
  }
  _SendAndWriteReport(SendData,ID,Time);
}
void _Send_Diag_NoTime(byte size,dword ID,byte Send_Data[])
{
  int i;
  dword LenSend;
  i=0;
  LenSend = elCount(Send_Data);
  diagResize(SendData,size);
  if(size<=LenSend)
  {
    for(i=0;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
  }
  else if(size>LenSend)
  {
    for(i=0;i<LenSend;i++)
      DiagSetPrimitiveByte(SendData,i,Send_Data[i]);
    for(i=LenSend;i<size;i++)
      DiagSetPrimitiveByte(SendData,i,Send_filler);
  }
  _SendAndWriteReport_NoTime(SendData,ID);
}
void _Send_Diag_And_Get_CF(byte size,dword ID,byte Send_Data[])
{
  _Send_Diag(size,ID,Send_Data);
//  testWaitForDiagResponseStart(SendData,p2cmax);
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,P2_can_server);
}
//根据测试通过条件，在报告上标记结果，功能寻址不响应NRC11、12、13、31、7E、7F
int _TestResult(diagRequest* obj,dword msgID,char stepid[],int passcondition)
{
  char comment[50];
  int Return_Value,RxLen;
  Return_Value = 0;
//  if(obj.GetPrimitiveByte(0) == 0x27 ) //&& ((obj.GetPrimitiveByte(1) & 0x80) == 0x80)
//  {
//    if(passcondition == -1)
//      writeEx(-3,1,"0x%X %X，期望正响应",obj.GetPrimitiveByte(0),obj.GetPrimitiveByte(1));
//    else if(passcondition == 0)
//      writeEx(-3,1,"0x%X %X，期望不响应",obj.GetPrimitiveByte(0),obj.GetPrimitiveByte(1));
//    else
//      writeEx(-3,1,"0x%X %X，期望响应NRC%X",obj.GetPrimitiveByte(0),obj.GetPrimitiveByte(1),passcondition);
//  }
  
  if(passcondition==-1)
    snprintf(comment,elCount(comment),"期望收到肯定响应");
  else if(passcondition==0)
    snprintf(comment,elCount(comment),"期望不响应");
  else
  {
    if(msgID==funreq_ID&& @AUTO::Config_Switch != 2 && (passcondition==0X11||passcondition==0X12||(passcondition==0X13 && Fun_NRC13==0)||passcondition==0X31||passcondition==0X7E||passcondition==0X7F))
      snprintf(comment,elCount(comment),"期望不响应");
    else
      snprintf(comment,elCount(comment),"期望收到否定响应NRC%02X",passcondition);
  }
  if(diagGetLastResponseCode(obj)==-1)
  {
    if(passcondition == -1)
    {
      byte Serve_Send;
      Serve_Send = DiagGetPrimitiveByte(obj,0);
      RxLen = DiagGetRespPrimitiveSize(obj);
      if(Serve_Send == 0x11 || Serve_Send == 0x85 || Serve_Send == 0x28)
      {
        if(RxLen != 2)
          testStepFail("","0x%02X服务，响应长度异常，当前为%d",Serve_Send,RxLen);
      }
      else if(Serve_Send == 0x2E)
      {
        if(RxLen != 3)
          testStepFail("","0x%02X服务，响应长度异常，当前为%d",Serve_Send,RxLen);
      }
      else if(Serve_Send == 0x27 && DiagGetPrimitiveByte(obj,1) == SendKey_27)
      {
        if(RxLen != 2)
          testStepFail("","0x%02X服务，响应长度异常，当前为%d",Serve_Send,RxLen);
      }
    }
    if(passcondition==-1)
      testStepPass(stepid,"%s，实际收到肯定响应",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到肯定响应",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0)
  { 
    if((passcondition==0)||(msgID==funreq_ID&&(passcondition==0X11||passcondition==0X12||(passcondition==0X13 && Fun_NRC13==0)||passcondition==0X31||passcondition==0X7E||passcondition==0X7F)))
    {
      testStepPass(stepid,"%s，实际未收到响应",comment);
      return 1;
    }  
    if(passcondition==-1)
    {
      testWaitForDiagResponse(obj,200);
      if(diagGetLastResponseCode(obj)==0)
      {
        Return_Value = -1;
        testStepFail(stepid,"%s，实际未收到响应",comment);
      }
      else if(diagGetLastResponseCode(obj)==-1)
        testStepPass(stepid,"%s，实际收到肯定响应",comment);
      else
      {
        Return_Value = -1;
        testStepFail(stepid,"%s，实际收到否定响应",comment);
      }
    }
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际未收到响应",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X10)
  {
    if((passcondition==0X10)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC10",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC10",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X11)
  {
    if((passcondition==0X11)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC11",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC11",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X12)
  {
    if((passcondition==0X12)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC12",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC12",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X13)
  {
    if((passcondition==0X13)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC13",comment);
    else if((passcondition==0X13)&&(msgID==funreq_ID && Fun_NRC13==1))
      testStepPass(stepid,"%s，实际收到否定响应NRC13",comment);
    else if((passcondition==0X13)&&(msgID==funreq_ID && @AUTO::Config_Switch == 2))
      testStepPass(stepid,"%s，实际收到否定响应NRC13",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC13",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X22)
  {
    if(passcondition==0X22)
      testStepPass(stepid,"%s，实际收到否定响应NRC22",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC22",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X24)
  {
    if(passcondition==0X24)
      testStepPass(stepid,"%s，实际收到否定响应NRC24",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC24",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X31)
  {
    if((passcondition==0X31)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC31",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC31",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X33)
  {
    if(passcondition==0X33)
      testStepPass(stepid,"%s，实际收到否定响应NRC33",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC33",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X7E)
  {
    if((passcondition==0X7E)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC7E",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC7E",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X7F)
  {
    if((passcondition==0X7F)&&(msgID==phyreq_ID))
      testStepPass(stepid,"%s，实际收到否定响应NRC7F",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC7F",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X78)
  {
    if((passcondition==0X78) && (passcondition!=0))
      testStepPass(stepid,"%s，实际收到否定响应NRC78",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC78",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X35)
  {
    if((passcondition==0X35))
      testStepPass(stepid,"%s，实际收到否定响应NRC35",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC35",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X36)
  {
    if((passcondition==0X36))
      testStepPass(stepid,"%s，实际收到否定响应NRC36",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC36",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X37)
  {
    if((passcondition==0X37))
      testStepPass(stepid,"%s，实际收到否定响应NRC37",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC37",comment);
    }
  }
  else if(diagGetLastResponseCode(obj)==0X72)
  {
    if((passcondition==0X72))
      testStepPass(stepid,"%s，实际收到否定响应NRC72",comment);
    else
    {
      Return_Value = -1;
      testStepFail(stepid,"%s，实际收到否定响应NRC72",comment);
    }
  }
  else
  {
    Return_Value = -1;
    testStepFail(stepid,"%s，实际收到否定响应NRC%02X",comment,diagGetLastResponseCode(obj));
  }
  return Return_Value;
}


/*
  判断2E服务的响应
*/
void _Check_Response_2E(diagRequest *Diag,byte Tx_Data[])
{
  dword ReSize,i;
  dword LenEx;
  byte Temp_Flage_1;
  LenEx = 0;i = 0;
  Temp_Flage_1=0;
  if(diagGetLastResponseCode(Diag) == 0)
    testWaitForDiagResponse(Diag,200);
  ReSize = DiagGetRespPrimitiveSize(Diag);
  if(diagGetLastResponseCode(Diag) == 0)
  {
    testStepFail("未收到响应");
    writeEx(-3,0,"未收到响应");
  }
  else if(diagGetLastResponseCode(Diag) > 0)
  {
    testStepFail("收到消极应答");
    writeEx(-3,0,"收到消极应答");
  }
  else if(diagGetLastResponseCode(Diag) == -1)
  {
    if(ReSize == DID_2E_TxLen)
      testStepPass("","反馈长度与预期一致");
    else
      testStepFail("","反馈长度与预期不一致,预期为：%d，实际为：%d",DID_2E_TxLen,ReSize);
    if(DiagGetRespPrimitiveByte(SendData,0)!=0x62)
      testStepFail("","反馈值与预期不一致,预期为0x%2X,实际为0x%2X",0x62,DiagGetRespPrimitiveByte(SendData,0));
    if(strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))
    {
      if(Tx_Data[0]==0x2E && Tx_Data[1] == 0xf1 && Tx_Data[2] == 0xa1)
      {
        for(i=3;i<DID_2E_TxLen-1;i++)
        {
          if(Tx_Data[i]!=0x00 && Tx_Data[i]!=0xFF)
            Temp_Flage_1 = 1;
        }
        if(Temp_Flage_1==0)
        {
          
          for(i=1;i<ReSize-1;i++)
          {
            if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
              testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
            else
              testStepPass("","反馈值与预期一致");
          } 
          if(DiagGetRespPrimitiveByte(SendData,ReSize-1)!=0x00)
            testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%X,实际为0x%X",ReSize,0x00,DiagGetRespPrimitiveByte(SendData,ReSize-1));
          else
            testStepPass("","反馈值与预期一致");
        }
      }
    }
    else
    {
      for(i=1;i<ReSize;i++)
      {
        if(DiagGetRespPrimitiveByte(SendData,i)!=Tx_Data[i])
          testStepFail("","第 %d 位,反馈值与预期不一致,预期为0x%2X,实际为0x%2X",i+1,Tx_Data[i],DiagGetRespPrimitiveByte(SendData,i));
        else
          testStepPass("","反馈值与预期一致");
      }
    }
  }
}
byte Check_APPValid()
{
  char comment[50];
  diagRequest ABS_ESP.FaultMemory_ReadAllIdentified req19;
  
  diagResize(req19,3);
  DiagSetPrimitiveByte(req19,0,0x19);
  DiagSetPrimitiveByte(req19,1,0x02);
  DiagSetPrimitiveByte(req19,2,0x01);
  _SendNoWrite(req19,phyreq_ID);
  
  testWaitForDiagResponse(req19,1000);
  if(diagGetLastResponseCode(req19) == -1)
  {
    snprintf(comment,elCount(comment),"/*----------当前APP有效---------*/");
    writeEx(-3,1,comment);
    testCaseComment(comment);
    return 1;
  }
  else
  {
    snprintf(comment,elCount(comment),"/*----------当前APP无效---------*/");
    writeEx(-3,1,comment);
    testCaseComment(comment);
    return 0;
  }
}

void _Pre_Programmed()
{
  if(Pre_Programmed_UnlockECU==1)
    _unlockECU();
  _WriteEx_and_Report("","发送预编程报文");
  UpdateCheck(phyreq_ID,-1);
}
