/* 
  操作完后将responseMsgs重置
*/
void _initMsg(message 0x00 msg[])
{
  message 0x00 init_msg;
  word i,j;
  for(i = 0; i < elCount(msg); i++)
    msg[i] = init_msg;
}

/*数组左移*/
void LeftMove(byte Serial_Num[],byte bit)
{
  dword i;
  byte carry;
  byte nextcarry;
  carry = 0;
  nextcarry = 0;
  for(i=15;i>=0;i--)
  {
    nextcarry = Serial_Num[i] >> (8 - bit);
    Serial_Num[i] = (Serial_Num[i] << bit) | carry;
    carry = nextcarry;
  }
}
/*数组逆向*/
void reverseNum(byte num[],dword size)
{
  dword startnum;
  dword temp;
  dword endnum;
  
  startnum = 0;
  endnum = size - 1;
  while(startnum < endnum)
  {
    temp = num[startnum];
    num[startnum] = num[endnum];
    num[endnum] = temp;
    startnum++;
    endnum--;
  }
}
_Clear_SendData(byte Send_Data[])
{
  int k;
  for(k=0;k<elcount(Send_Data);k++)
    Send_Data[k] = Send_filler;
}
_Get_31_ServeData(dword Serve_Poss,byte Send_Data[],byte type,byte Ctrl_Type_Pos) //
{
  byte Init_len;
  Init_len = 4;
  _Clear_SendData(Send_Data);
  Send_Data[0] = 0x31;
  if(type != 1)
  {
    Send_Data[1] = Serve_31_Hex[Serve_Poss].Control_Type[Ctrl_Type_Pos];
    Send_Data[2] = Serve_31_Hex[Serve_Poss].Routine[0];
    Send_Data[3] = Serve_31_Hex[Serve_Poss].Routine[1];
  }
  Len_31H = Serve_31_Hex[Serve_Poss].Control_Type_TxLen[Ctrl_Type_Pos];
 
  if(Serve_31_Hex[Serve_Poss].Control_Option_Count[0] != 0)
  {
    Init_len = 5;
    Send_Data[4] = Serve_31_Hex[Serve_Poss].Control_Option[0][0];
  }
  if(Len_31H == 4)
    return;
  else if(Len_31H == 6)
  {
    int n;
    word Temp_crc16;
    Temp_crc16 = random(0xFFFF);
    Send_Data[4] = (Temp_crc16 >> 8) & 0xFF;
    Send_Data[5] = Temp_crc16 & 0xFF;
    
  }
  else if(Len_31H == 8)
  {
    int n;
    word Temp_crc16_H;
    word Temp_crc16_L;
    Temp_crc16_H = random(0xFFFF);
    Temp_crc16_L = random(0xFFFF);
    Send_Data[4] = (Temp_crc16_H >> 8) & 0xFF;
    Send_Data[5] = Temp_crc16_H & 0xFF;
    Send_Data[6] = (Temp_crc16_L >> 8) & 0xFF;
    Send_Data[7] = Temp_crc16_L & 0xFF; 
  }
  
  if(Send_Data[2] == 0xFF && (Send_Data[3] == 0x00 || Send_Data[3] == 0x01))
  {
    int n;
    byte Address_Len,Length_Len;
    dword Temp_Address_Set,Temp_Length_Set;
    word Temp_crc16;
	  Address_Len = 4;Length_Len = 4;
    if(Send_Data[1] != 0x01)
    {
      Len_31H = Serve_31_Hex[Serve_Poss].Control_Type_TxLen[Ctrl_Type_Pos];
      return;
    }
    if(Send_Data[3] == 0x01 &&  ((strncmp(ECU_project,"Chery",strlen("Chery")) == 0 )|| @AUTO::Config_Switch == 7))
    {
      Len_31H = Serve_31_Hex[Serve_Poss].Control_Type_TxLen[Ctrl_Type_Pos];
      Temp_crc16 = random(0xFFFF);
      Send_Data[12] = (Temp_crc16 >> 16) & 0xFF;
      Send_Data[13] = Temp_crc16 & 0xFF;
    } 
    _Get_0x34("BT_34_Address","BT_34_Length");
    if(type == 0)
    {
      do{
        Temp_Address_Set = random(@Test::BT_34_Add_End);
      }while(Temp_Address_Set<=@Test::BT_34_Add_Start || Temp_Address_Set>=@Test::BT_34_Add_End);
      do{
        Temp_Length_Set = random(@Test::BT_34_Len_End);
      }while(Temp_Length_Set<=@Test::BT_34_Len_Start || Temp_Length_Set>=@Test::BT_34_Len_End);
    }
    else if(type == 1)
    {
      Temp_Address_Set = 0xFFFFFFFF;
      Temp_Length_Set = 0xFFFFFFFF;
    }
    else if(type == 2)
    {
      Temp_Address_Set = @Test::BT_34_Add_Start;
      Temp_Length_Set = @Test::BT_34_Len_End;
    }
    
    for(n=0;n<Address_Len;n++)
    {
      Send_Data[n+Init_len] = (Temp_Address_Set>>((Address_Len -n-1)*8)) & 0xFF;
    }
    for(n=0;n<Length_Len;n++)
    {
      Send_Data[n+Init_len+Address_Len] = (Temp_Length_Set>>((Length_Len -n-1 )*8))&0xFF;
    }
  
  }
}
/*
  检测输入数据是否在31结构体中
  Send_Data[];输入数组
*/
int _Check_SendData_In_31H(byte Send_Data[])
{
  int Return_Value;
  int m,Routine_Pos,Type_Pos;
  Routine_Pos = -1;
  Type_Pos = -1;
  for(m=0;m<Serve_31_Hex_Count;m++)
  {
    if((Serve_31_Hex[m].Routine[0] == Send_Data[2]) && (Serve_31_Hex[m].Routine[1] == Send_Data[3]))
    {
      Routine_Pos = m;
      break;
    }
  }
  if(m == Serve_31_Hex_Count)
    return -1;
//  for(m=0;m<Serve_31_Hex[Routine_Pos].Control_Type_Count;m++)
//  {
//    if(Serve_31_Hex[Routine_Pos].Control_Type[m] == Send_Data[1])
//    {
//      Type_Pos = m;
//      break;
//    }
//  }
  Return_Value = Routine_Pos;
  return Return_Value;
}
_get_NRC11(dword ID)
{
  message 0x00 msg;
  double starttime;
  double endtime1;
  double endtime2;
  byte result;
  byte sid;
  sid=DiagGetPrimitiveByte(SendData,0);
  starttime=(double)timeNow()/100;
  result=testWaitForMessage(Response_ID,p2cmax);
  if(ID==phyreq_ID)
  {
    if(result==1)
    {
      endtime1=(double)timeNow()/100;
      testGetWaitEventMsgData(msg);
      if((msg.byte(0)==0x03)&&(msg.byte(1)==0x7F)&&(msg.byte(2)==sid)&&(msg.byte(3)==0x11))
      {
        testStepPass("","收到否定响应NRC11");
        if((endtime1-starttime)<=p2cmax)
          testStepPass("","NRC11实际响应时间为%fms",endtime1-starttime);
        else
          testStepFail("","NRC11实际响应时间为%fms",endtime1-starttime);
      }
      else
        testStepFail("","收到非NRC11响应");
    }
    else
    {
      testStepFail("","未在规定时间内收到响应");
      return;
    }
  }
  else if(ID == funreq_ID)
  {
    if(result==1)
    {
      endtime1=(double)timeNow()/100;
      testGetWaitEventMsgData(msg);
      if((msg.byte(0)==0x03)&&(msg.byte(1)==0x7F)&&(msg.byte(2)==sid)&&(msg.byte(3)==0x11))
      {
        testStepFail("","收到否定响应NRC11");
        if((endtime1-starttime)<=p2cmax)
          testStepPass("","NRC11实际响应时间为%fms",endtime1-starttime);
        else
          testStepFail("","NRC11实际响应时间为%fms",endtime1-starttime);
      }
      else
        testStepFail("","收到非NRC11响应");
    }
    else
    {
      testStepPass("","功能寻址下NRC11不响应");
      return;
    }
  }
}
/***************************NRC优先级暂无优化策略**************************/
/*
  type == 0:均无效
  type == 2：均有效
  type == 3：地址无效
  type == 4：长度无效
*/
_Get_Invalid_Data(dword Serve_Poss,byte Send_Data[],byte type)  //Data无效
{
  int n;
  byte Address_Len,Length_Len;
  qword Temp_Address_Set,Temp_Length_Set;
  qword Add_End;
  qword BT_34_Address[2];
  qword BT_34_Length[2];
  byte Init_len;
  Init_len = 4;
  
  _Get_0x34("BT_34_Address","BT_34_Length");
  if(@AUTO::Config_Switch == 12 && (type == 2 || type == 3 || type == 4) && Send_Data[2] == 0xFF && Send_Data[3] == 0x00) //广汽测试Flash段
  {
    _Get_0x34("BT_Flash_Address","BT_Flash_Length");
  }
  Address_Len = Len_34_Addr;
  Length_Len = Len_34_Length;
  
  if(Serve_31_Hex[Serve_Poss].Control_Option_Count[0] != 0)
  {
    Init_len = 5;
  }
  
  if(type == 0)
  {
    Temp_Address_Set =0xFFFFFFFF;
    Temp_Length_Set = 0xFFFFFFFF;
  }
  else if( type == 1)
  {
    do{
       Temp_Address_Set = random(@Test::BT_34_Add_End);
     }while(Temp_Address_Set<=@Test::BT_34_Add_Start || Temp_Address_Set>=@Test::BT_34_Add_End);
    do{
      Temp_Length_Set = random(@Test::BT_34_Len_End);
    }while(Temp_Length_Set<=@Test::BT_34_Len_Start || Temp_Length_Set>= @Test::BT_34_Len_End);
  }
  else if( type == 2)
  {
    Temp_Address_Set = @Test::BT_34_Add_Start;
    Temp_Length_Set = @Test::BT_34_Len_End;
  }
  else if( type == 3)
  {
    Temp_Address_Set = 0xFFFFFFFF;
    Temp_Length_Set = @Test::BT_34_Len_End;
  }
  else if( type == 4)
  {
    Temp_Address_Set = @Test::BT_34_Add_Start;
    Temp_Length_Set = 0xFFFFFFFF;
  }
  
  for(n=0;n<Address_Len;n++)
    Send_Data[n+Init_len] = (Temp_Address_Set>>((Address_Len -n-1)*8))&0xFF;
  for(n=0;n<Length_Len;n++)
    Send_Data[n+Init_len+Address_Len] = (Temp_Length_Set>>((Length_Len -n-1 )*8))&0xFF;
}
word _Get_Invalid_RID(word Pos)   //RID无效
{
  int n,m;
  byte hash[0xFF+1][0xFF+1];
  for(m=0;m<Serve_31_Hex_Count;m++) 
  {
    hash[Serve_31_Hex[m].Routine[0]][Serve_31_Hex[m].Routine[1]] = 1;
  }
  for(n=1;n<=0xFF;n++)
  {
//    for(m=0;m<Serve_31_Hex_Count;m++)
//    {
//      if( n == Serve_31_Hex[m].Routine[1])
//        break;
//    }
//    if(m >= Serve_31_Hex_Count)
//      return n;
    if((hash[(Pos >> 8) & 0xFF][n]) != 1) return n;
  }
   return 0;
}
byte _Get_Invalid_RID_Control_Type(word Pos)   //RID控制类型无效
{
  int n,m,Serve_Pos;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    if(Serve_31_Hex[i].Routine[0] == ((Pos >> 8) & 0xFF) && Serve_31_Hex[i].Routine[1] == (Pos & 0xFF))
      break;
  }
  Serve_Pos = i;
  for(n=1;n<=0xFF;n++)
  {
    for(m=0;m<Serve_31_Hex[Serve_Pos].Control_Type_Count;m++)
    {
      if(n==Serve_31_Hex[Serve_Pos].Control_Type[m])
        break;
    }
    if(m>= Serve_31_Hex[Serve_Pos].Control_Type_Count)
      return n;
  }
  return 0;
}
/*
  获取控制选项
 Type = 0:获取无效的控制选项
 Type = 1:获取正常的控制选项
*/
byte _Get_Invalid_RID_Control_Option(byte Serve,word Pos,byte Type)  
{
  int n,m;
  int i,RID_Pos_,Control_Type_Pos;
  byte Data[2];
  Data[0] = (Pos>>8)&0xFF;
  Data[1] = Pos &0xFF;
  for(i=0;i<Serve_31_Hex_Count;i++)
  {
    if((Serve_31_Hex[i].Routine[0] == Data[0]) && (Serve_31_Hex[i].Routine[1] == Data[1]))
    {
      RID_Pos_ = i;
      break;
    }
  }
  Pos = RID_Pos_;
  for(m=0;m<Serve_31_Hex[Pos].Control_Type_Count;m++)
  {
    if(Serve_31_Hex[Pos].Control_Type[m] == Serve)
      break;
  }
  Control_Type_Pos = m;
  if(m>=Serve_31_Hex[Pos].Control_Type_Count)
    Control_Type_Pos = 0;
  if(Type == 0)
  {
    if(Data[0] == 0xFF)
    {
      return Serve_31_Hex[Pos].Control_Option[Control_Type_Pos][0] - 1;
    }
    else
    {
      for(m=0;m<0xFF;m++)
      {
        for(n=0;n<Serve_31_Hex[Pos].Control_Option_Count[Control_Type_Pos];n++)
        {
          if(m==Serve_31_Hex[Pos].Control_Option[Control_Type_Pos][n])
            break;
        }
        if(n >= Serve_31_Hex[Pos].Control_Option_Count[Control_Type_Pos])
          return m;
      }
    }
  }
  else
  {
    return Serve_31_Hex[Pos].Control_Option[Control_Type_Pos][0];
  }
  return 0;
}

/*
  获取NRC22条件并进行设置
  Serve: 服务
  Fun：子功能
  Type = 0：满足NRC22条件
  Type = 1：恢复NRC22条件
  Type = 2：查询NRC22条件
*/
int _Set_NRC22(byte Serve, dword Fun,byte Type)
{
  int Serve_Pos_22,Fun_Pos_22,Loop_22,NRC22_Flage;
  int Temp_NRC22;
  char Str_22[50];
  NRC22_Flage = 0;
  snprintf(Str_22,elCount(Str_22),"%s","");
  Fun_Pos_22 = -1;
  Serve_Pos_22 = -1;
  if(Fun<=0xFF)
    snprintf(Str_22,elCount(Str_22),"%s0x%02X 0x%02X",Str_22,Serve,Fun);
  else
    snprintf(Str_22,elCount(Str_22),"%s0x%02X 0x%02X 0x%02X",Str_22,Serve,(Fun>>8),(Fun & 0xFF));
  if((Serve != 0x01) && (Serve != 0x03))
  {
    Serve_Pos_22 = _Check_Serve(Serve,Fun,0);
    Fun_Pos_22 = _Check_Serve(Serve,Fun,4);
    if(Serve == 0x14)
      Fun_Pos_22 = 0;
    if(Fun_Pos_22 == -1)
    {
      _WriteEx_and_Report(Str_22,"未查询到该子功能");
      return -1;
    }
    else
    {
      for(Loop_22 = 0; Loop_22 < Serve_Data[Serve_Pos_22].Serve_NRC_Count[Fun_Pos_22];Loop_22++)
      {
        if(Serve_Data[Serve_Pos_22].Serve_NRC[Fun_Pos_22][Loop_22] == 0x22) //获取到NRC22在NRC列表中所在位置
        {
          NRC22_Flage = 1;
          break;
        }
      }
      if(NRC22_Flage == 0)
      {
        _WriteEx_and_Report(Str_22,"未查询到NRC22条件");
        return -1;
      }
      else
      {
        Temp_NRC22 = Serve_Data[Serve_Pos_22].Serve_NRC22[Fun_Pos_22];
        if(Type == 2)
        {
          return Temp_NRC22;  //提前结束返回，不进行操作
        }
        if(Type == 0)//满足NRC22
        {
          if((Temp_NRC22 & 0x1) != 0)//车速
          {
            _Set_CarSpd(NRC22_CarSpd+1);
            return 1;
          }
          else if((Temp_NRC22 & 0x20) != 0 ) //发动机
          {
            _Set_Ready(Ready_Active);
            return 0x20;
          }
          else if((Temp_NRC22 & 0x08) != 0 ) //档位
          {
            _Set_Gears(NRC_22_Gears_Normal+1);
            return 8;
          }
          else if((Temp_NRC22 & 0x02) != 0 ) //电压
          {
            _Set_Battery(NRC22_Battery_Hight+1);
            return 2;
          }
          else if((Temp_NRC22 & 0x04) != 0 ) //手力矩
          {
            diagStartTesterPresent(Cdd_Name);
            TestWaitForTesterConfirmation("控制手力矩为",NRC22_TasTorque+1);
            diagStopTesterPresent(Cdd_Name);
            return 4;
          }
          else if(Serve==0x10 && Fun==0x02)
          {
            /*10 02预编程*/
            return 0x80;
          }
          else
            return 0;
        }
        else if(Type == 1)//恢复NRC22
        {
          if((Temp_NRC22 & 0x1) != 0)//车速
          {
            _Set_CarSpd(0);
            return 0;
          }
          else if((Temp_NRC22 & 0x20) != 0 ) //发动机
          {
            _Set_Ready(0);
            return 0;
          }
          else if((Temp_NRC22 & 0x08) != 0 ) //档位
          {
            _Set_Gears(NRC_22_Gears_Normal);
            return 0;
          }
          else if((Temp_NRC22 & 0x02) != 0 )//电压
          {
            _Set_Battery(12);
            return 0;
          }
          else if((Temp_NRC22 & 0x04) != 0 )//手力矩
          {
            TestWaitForTesterConfirmation("松开方向盘",10000);
            return 0;
          }
          else if(Serve==0x10 && Fun==0x02)
          {
            /*10 02预编程*/
            _Pre_Programmed();
            return 0;
          }
        }
      }
    }
  }
  else
  {
    byte Da_1,Da_2;
    Da_1 = (Fun>>8)&0xFF;
    Da_2 = Fun&0xFF;
    for(Loop_22=0;Loop_22<Serve_31_Hex_Count;Loop_22++)
    {
      if((Serve_31_Hex[Loop_22].Routine[0] == Da_1) && (Serve_31_Hex[Loop_22].Routine[1] == Da_2))
      {
        Fun_Pos_22 = Loop_22;
        break;
      }
    }
    if(Fun_Pos_22 == -1)
    {
      _WriteEx_and_Report("","未查询到对应RID");
      return -1;
    }
    for(Loop_22=0;Loop_22<Serve_31_Hex[Fun_Pos_22].Control_Type_Count;Loop_22++)
    {
      if(Serve_31_Hex[Fun_Pos_22].Control_Type[Loop_22] == Serve)
      {
        Serve_Pos_22 = Loop_22;
        break;
      }
    }
    if(Serve_Pos_22 == -1)
    {
      _WriteEx_and_Report("","未查询到对应控制类型");
      return -1;
    }
    NRC22_Flage = _Check_Serve(Serve,Fun,10);
    {
      Temp_NRC22 = NRC22_Flage;
      if(Type == 2)
        return Temp_NRC22;  //提前结束返回，不进行操作
      if(Temp_NRC22 == 0)
      {
        _WriteEx_and_Report("","无NRC22条件");
        return -1;
      }
      if(Type == 0)//满足NRC22
      {
        if((Temp_NRC22 & 0x1) != 0)//车速
        {
          _Set_CarSpd(NRC22_CarSpd+1);
          return 1;
        }
        else if((Temp_NRC22 & 0x20) != 0 ) //发动机
        {
          _Set_Ready(Ready_Active);
          return 0x20;
        }
        else if((Temp_NRC22 & 0x08) != 0 ) //档位
        {
          _Set_Gears(NRC_22_Gears_Normal+1);
          return 8;
        }
        else if((Temp_NRC22 & 0x02) != 0 ) //电压
        {
          _Set_Battery(NRC22_Battery_Hight+1);
          return 2;
        }
        else if((Temp_NRC22 & 0x04) != 0 ) //手力矩
        {
          TestWaitForTesterConfirmation("控制手力矩为",NRC22_TasTorque+1);
          return 4;
        }
        else if((Temp_NRC22 & 0x10) != 0 ) //传感器
        {
          TestWaitForTesterConfirmation("拔掉传感器");
          return 16;
        }
      }
      else if(Type == 1)//恢复NRC22
      {
        if((Temp_NRC22 & 0x1) != 0)//车速
        {
          _Set_CarSpd(0);
          return 0;
        }
        else if((Temp_NRC22 & 0x20) != 0 ) //发动机
        {
          _Set_Ready(0);
          return 0;
        }
        else if((Temp_NRC22 & 0x08) != 0 ) //档位
        {
          _Set_Gears(NRC_22_Gears_Normal);
          return 0;
        }
        else if((Temp_NRC22 & 0x02) != 0 )//电压
        {
          _Set_Battery(12);
          return 0;
        }
        else if((Temp_NRC22 & 0x04) != 0 )//手力矩
        {
          TestWaitForTesterConfirmation("松开方向盘",10000);
          return 0;
        }
        else if((Temp_NRC22 & 0x10) != 0 ) //传感器
        {
          TestWaitForTesterConfirmation("恢复传感器");
          TestWaitForTesterConfirmation("恢复传感器存在上下电及会话问题,此部分会有风险,建议手动测试");
          return 16;
        }
      }
    }
  }
  return 0xFF;
}
/*
Type_ = 0:获取Total 13 长度
Type_ = 1:获取Mini 13 长度
Type_ = 2:获取正常 长度
*/
dword _Get_Serve_13_Len(byte Serve, dword Fun, byte Type_)
{
  dword Return_Len,Temp_Len;
  byte Min_Len,Max_Len;
  int Loop_Get_Max, Serve_Poss_, Fun_Pos_;
  Serve_Poss_ = _Check_Serve(Serve,0,0);
  Fun_Pos_ = _Check_Serve(Serve,Fun,4);
  for(Loop_Get_Max=0;Loop_Get_Max<Serve_Data[Serve_Poss_].Serve_Fun_Count;Loop_Get_Max++)
  {
    Temp_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Loop_Get_Max];
    if(Loop_Get_Max == 0)
      Return_Len = Temp_Len;
    if(Type_ == 0)
    {
      if(Temp_Len>=Return_Len)
        Return_Len = Temp_Len;
    }
    else if(Type_ == 1)
    {
      if(Temp_Len<=Return_Len)
        Return_Len = Temp_Len;
    }
    else if(Type_ == 2)
    {
      Return_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Fun_Pos_];
      break;
    }
  }
  if(Type_ == 0)
    Return_Len = Return_Len +1;
  else if(Type_ == 1)
    Return_Len = Return_Len -1;
  
  if(Serve == 0x34)
  {
    Return_Len = 3 + Len_34_Addr + Len_34_Length;
    if(Type_ == 0)
      Return_Len = Return_Len +1;
    else if(Type_ == 1)
      Return_Len = Return_Len -1;
    else if(Type_ == 2)
      Return_Len = 3 + Len_34_Addr + Len_34_Length;
    if(@AUTO::Config_Switch==6 && Type_ == 1)
      Return_Len = 2;
  }
  else if(Serve == 0x36)
  {
    if(Type_ == 2)
      Return_Len = 0x0C;
  }
  /* 22 服务 */
  if(Type_ == 0 && Serve == 0x22)
  {
    Return_Len = DID_22_Support*2+2;
  }
  /* 37 服务 */
  if((Type_ == 0 || Type_ == 1) && Serve == 0x37)
    Return_Len = 2;
  else if(Type_ == 2 && Serve == 0x37)
    Return_Len = 1;
  
  /* 2E 服务 */
  if(Serve == 0x2E)
  {
    if(Type_ == 1)
    {
      Return_Len = 3;
      if(@AUTO::Config_Switch == 5 || (strncmp(ECU_project,"SRM",strlen("SRM")) == 0))
        Return_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Fun_Pos_]+1;
    }
    else if(Type_ == 0)
      Return_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Fun_Pos_]+1;
    else if(Type_ == 2)
      Return_Len = Serve_Data[Serve_Poss_].Serve_Fun_Len[Fun_Pos_];
  }
  return Return_Len;
}
/*
  NRC10
  Type_ = 0：制造NRC10
  Type_ = 1: 恢复
  Len_Ex 数组长度
  Check_Pos：校验位所在位置
  Data数组,装载修改值
*/

void _Get_Serve_NRC10(byte Serve,byte Type_,byte Len_Ex,byte Check_Pos,byte Data[])
{
  int Serve_Pos_;
  int Fun_;
  Serve_Pos_ = _Check_Serve(Serve,0,0);
  if(Type_ == 0)
  {
    Data[Check_Pos] = 0;
  }
  else if(Type_ == 1)
  {
    if((strncmp(ECU_project,"BYD",strlen(ECU_project)) == 0 && strlen(ECU_project) == strlen("BYD"))|| @AUTO::Config_Switch == 1)
    {
      int i;
      dword Temp;
      Temp = 0;
      for(i=3;i<Len_Ex-1;i++)
        Temp = (Temp + Data[i])&0xFF;
      Temp = (Temp^0x55) &0xFF;
      Data[Check_Pos] = Temp;
    }
  }
}
/*
  NRC31操作
  Type_ = 0：制造NRC31
  Type_ = 1: 恢复
  Data数组,装载修改值
*/
void _Get_Serve_NRC31(byte Serve,byte Type_,byte Data[])
{
  int Serve_Pos_;
  int Fun_;
  int n;
  Serve_Pos_ = _Check_Serve(Serve,0,0);
  if(Type_ == 0)
  {
    if(Serve == 0x2E || Serve == 0x22)
    {
      do{
        Fun_ = random(0XFFFF);
      }while(_Check_Serve(Serve,Fun_,4)==1);
      Data[1] = (Fun_>>8);
      Data[2] = (Fun_&0xFF);
    }
    else if(Serve == 0x28)
    {
      for(Fun_=0;Fun_<0xFF;Fun_++)
      {
        for(n=0;n<Serve_Data[Serve_Pos_].Serve_Para_Count[0];n++)
        {
          if(Fun_ == Serve_Data[Serve_Pos_].Serve_Para[0][n])
            break;
        }
        if(n==Serve_Data[Serve_Pos_].Serve_Para_Count[0])
          break;
      }
      Data[2] = Fun_;
    }
    else if(Serve == 0x34)
      _Get_Serve_INI(Data,0x34,Serve_Pos_,3);

  }
  else if(Type_ == 1)
  {
    if(Serve == 0x2E)
    {
      Data[1] = (Serve_Data[Serve_Pos_].Serve_Fun[0]>>8);
      Data[2] = (Serve_Data[Serve_Pos_].Serve_Fun[0]&0xFF);
    }
    else if(Serve == 0x28)
    {
      Data[2] = Serve_Data[Serve_Pos_].Serve_Para[0][0];
    }
    else if(Serve == 0x22)
    {
      Data[1] = (Serve_Data[Serve_Pos_].Serve_Fun[0]>>8);
      Data[2] = (Serve_Data[Serve_Pos_].Serve_Fun[0]&0xFF);
    }
    else if(Serve == 0x34)
    {
      if(NRC_For34_FlashDrv == 1)
        _Get_Serve_INI(Data,0x34,Serve_Pos_,4);
      else
        _Get_Serve_INI(Data,0x34,Serve_Pos_,0);
    }
  }
}
/*
获取子功能
Type_ = 0:无效子功能
Type_ = 1:正常子功能
*/
byte _Get_Invalid_Fun(byte Serve,byte Type_)  
{
  int Loop_Get_Max,Fun_Count;
  int Serve_Poss_;
  byte Return_Fun;
  byte hash[0xff];
  Return_Fun = 0;
  Serve_Poss_ = _Check_Serve(Serve,0,0);
  if(Type_ == 0)
  {
    for(Fun_Count = 0;Fun_Count<Serve_Data[Serve_Poss_].Serve_Fun_Count;Fun_Count++)
    {
      hash[Serve_Data[Serve_Poss_].Serve_Fun[Fun_Count]] = 1;
    }
    for(Loop_Get_Max=1; Loop_Get_Max<=0xFF; Loop_Get_Max++)
    {
      if(hash[Loop_Get_Max]!= 1)
      {
        Return_Fun = Loop_Get_Max;
        break;
      }
    }
  }
  else if(Type_ == 1)
  {
    Return_Fun = Serve_Data[Serve_Poss_].Serve_Fun[0];
  }
  
  return Return_Fun;
}
/*
获取子功能
Type_ = 0:无效DID
Type_ = 1:正常DID
*/
word _Get_Invalid_DID(byte Serve,byte Type_)  
{
  int Loop_Get_Max,Fun_Count;
  int Serve_Poss_;
  word Return_Fun;
//  byte High_hash[0xff];
  byte Low_hash[0xff];
  byte Low_pos;
  
  Return_Fun = 0;
  Serve_Poss_ = _Check_Serve(Serve,0,0);
  if(Type_ == 0)
  {
    for(Fun_Count = 0;Fun_Count<Serve_Data[Serve_Poss_].Serve_Fun_Count;Fun_Count++)
    {
      Low_hash[Serve_Data[Serve_Poss_].Serve_Fun[Fun_Count] & 0xFF] = 1;
    }
    for(Loop_Get_Max=0x10; Loop_Get_Max<=0xFF; Loop_Get_Max++)
    {
      if(Low_hash[Loop_Get_Max]!= 1)
      {
        Low_pos = Loop_Get_Max ;
        Return_Fun = ((Serve_Data[Serve_Poss_].Serve_Fun[0] & 0xFF00) | Low_pos) & 0xFFFF ;
        break;
      }
    }
  }
  else if(Type_ == 1)
  {
    Return_Fun = Serve_Data[Serve_Poss_].Serve_Fun[0];
  }
  
  return Return_Fun;
}

/*---------------------------------------------NRC优先级-------------------------------*/
/*
  NRC优先级测试步骤
  Serve：服务
  Pos：子功能
  Type：获取NRC数据方式
*/
_Set_NRC_Step(byte Serve,dword Pos,byte Type,byte Send_Data[]) 
{
  int k;
  byte Serve_Pos;
  NRC31_Count = 0;
  NRC13_Count = 0;
  NRC34_31Count = 0;
  NRC31_total = 0;
  NRC13_total = 0;
  NRC34_31total = 0;
  Serve_Pos = _Check_Serve(Serve,Pos,Type); //获取NRC列表装载到Fun_NRC中
  
  for(k=Fun_NRC_Count-1;k>=0;k--)  //获取共多少个NRC13或NRC31
  {
    if(Fun_NRC[k]==0x13)
      NRC13_total++;
    else if(Fun_NRC[k]==0x31)
      NRC31_total++;
  }
//  writeEX(-3,1,"NRC13_total = %x,NRC31_total = %x",NRC13_total,NRC31_total);
  for(k=Fun_NRC_Count-1;k>=0;k--)
  {
    if(Send_Data[0] == 0x31)
    {
      /*待31服务时完善*/
      if(Fun_NRC[k]==0x22) //31服务NRC22
      {
        _Set_NRC22(Serve,Pos,0);
      }
      else if(Fun_NRC[k]==0x31 && NRC31_total==1) //RID无效
      {
        Send_Data[3] = _Get_Invalid_RID(Pos);
      }
      else if(Fun_NRC[k]==0x31 && NRC31_Count==0 && NRC31_total==2) //RID无效
      {
        Send_Data[3] = _Get_Invalid_RID(Pos);
        NRC31_Count++;
      }
      else if(Fun_NRC[k]==0x31 && NRC31_Count==1 && NRC31_total==2) //控制选项无效/数据无效
      {
        if(Serve_31_Hex[Serve_Pos].Control_Option_Count[0]  != 0)
          Send_Data[4] = _Get_Invalid_RID_Control_Option(Serve,Pos,0);
        _Get_Invalid_Data(Serve_Pos,Send_Data,0);
        NRC31_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_Count==0 && NRC13_total==2) //total13
      {
        Fun_NRC_Send_Len = Len_31H +1;
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_Count==1 && NRC13_total==2) //mini13
      {
        Fun_NRC_Send_Len = 3;
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_total==1) //mini13
        Fun_NRC_Send_Len = Len_31H + 1;  //3
      else if(Fun_NRC[k]==0x12) //子功能无效
        Send_Data[1] = _Get_Invalid_RID_Control_Type(Pos);
      else if(Fun_NRC[k]==0x33)
        NRC33_Pos = k; //NRC33所在位置
      
//      writeEx(-3,1,"NRC:%02X  Fun_NRC_Send_Len = %d,Send_Data = 31 %02X %02X %02X",Fun_NRC[k],Fun_NRC_Send_Len,Send_Data[1],Send_Data[2],Send_Data[3]);
    }
    else
    {
      if(Fun_NRC[k]==0x13 && NRC13_Count==0 && NRC13_total==2) //total13
      {
        Fun_NRC_Send_Len = _Get_Serve_13_Len(Serve,Pos,0);//遍历该服务下所有支持子功能,并返回最大长度
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_Count==1 && NRC13_total==2) //mini13
      {
        Fun_NRC_Send_Len = _Get_Serve_13_Len(Serve,Pos,1);//遍历该服务下所有支持子功能,并返回最小长度
        if(Send_Data[0] == 0x27)
          Fun_NRC_Send_Len = 1;
        NRC13_Count++;
      }
      else if(Fun_NRC[k]==0x13 && NRC13_total==1 ) //mini13
      {
//        if(Send_Data[0] == 0x34)
//        {
        Fun_NRC_Send_Len = (Serve == 0x36)? _Get_Serve_13_Len(Serve,Pos,1) : _Get_Serve_13_Len(Serve,Pos,0);
//          Fun_NRC_Send_Len = _Get_Serve_13_Len(Serve,Pos,0);
//        }
//        else
//          Fun_NRC_Send_Len = _Get_Serve_13_Len(Serve,Pos,1);
      }
      else if(Fun_NRC[k]==0x12 ) //子功能无效
        Send_Data[1] = _Get_Invalid_Fun(Serve,0);
      else if(Fun_NRC[k]==0x22 ) //NRC22条件
        _Set_NRC22(Serve,Pos,0);
      /*----------------------------------------------------------------------*/
      else if(Fun_NRC[k]==0x31 && NRC31_total==1) //数据无效 + DFI无效 + ALFID无效
      {
        _Get_Serve_NRC31(Serve,0,Send_Data);
        if(Send_Data[0] == 0x34)
        {
          NRC34_31total = 3;
          Send_Data[1] = Serve_Data[Pos].Serve_Para[0][0] + 1;
          Send_Data[2] = 0x43;
        }
      }
      else if(Fun_NRC[k]==0x31 && NRC31_Count==0 && NRC31_total==2) //DFI无效
      {
        if(Send_Data[0] == 0x34)
        {
          Send_Data[1] = Serve_Data[Pos].Serve_Para[0][0] + 1;
          Send_Data[2] = 0x43;
        }
        NRC31_Count++;
      }
      else if(Fun_NRC[k]==0x31 && NRC31_Count==1 && NRC31_total==2) //数据无效
      {
        if(Send_Data[0] == 0x34)
        {
          _Get_Serve_NRC31(Serve,0,Send_Data);
        }
        NRC31_Count++;
      }
     /*--------------------------------------------------------------------------*/
//      else if(Fun_NRC[k]==0x31 ) //NRC31条件
//      {
//        _Get_Serve_NRC31(Serve,0,Send_Data);
//        if(Send_Data[0] == 0x34)
//        {
//          NRC34_31total = 3;
//          Send_Data[1] = Serve_Data[Pos].Serve_Para[0][0] + 1;
//          Send_Data[2] = 0x43;
//          
//        }
//      }
    }
//     writeEx(-3,1,"Fun_NRC_Send_Len = %d",Fun_NRC_Send_Len);
  }
  /*清除计数防止后续执行恢复操作时报错*/
  NRC31_Count = 0;
  NRC13_Count = 0;
  NRC34_31Count = 0;
}
_Recover_NRC_Step(byte NRC,byte Pos,dword Fun_Pos,byte Send_Data[]) // Pos为所在结构体位置
{
  dword Fun_;
  if(Send_Data[0] != 0x31)
    Fun_ = Serve_Data[Pos].Serve_Fun[Fun_Pos];
  if( NRC == 0x33 )
    _unlockECU();
  /*---------------------------31服务------------------------*/
  else if(NRC != 0x33 && Send_Data[0] == 0x31)
  {
    if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==0)
    {
      Fun_NRC_Send_Len = Len_31H +1;
      NRC13_Count++;
//      if(Serve_31_Hex[Pos].Routine[0] == 0xFF && Serve_31_Hex[Pos].Routine[1] == 0x00)
//        Send_Data[Len_31H] = 0xFF;
    }
    else if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==1)
    {
      Fun_NRC_Send_Len = Len_31H;
      NRC13_Count++;
    }
    else if( NRC == 0x13 && NRC13_total ==1)
    {
      Fun_NRC_Send_Len = Len_31H;
    }
    else if( NRC == 0x31 && NRC31_total ==1)
    {
      Send_Data[2] = Serve_31_Hex[Pos].Routine[0];
      Send_Data[3] = Serve_31_Hex[Pos].Routine[1];
    }
    else if( NRC == 0x31 && NRC31_Count==0 && NRC31_total == 2)
    {
      Send_Data[2] = Serve_31_Hex[Pos].Routine[0];
      Send_Data[3] = Serve_31_Hex[Pos].Routine[1];
      NRC31_Count++;
    }
    else if( NRC == 0x31 && NRC31_Count==1 && NRC31_total == 2)
    {
      _Get_Invalid_Data(Pos,Send_Data,2);
      if(Serve_31_Hex[Pos].Control_Option_Count[0]  != 0)
        Send_Data[4] = _Get_Invalid_RID_Control_Option(Fun_Pos,Pos,1);
      NRC31_Count++;
    }
    else if( NRC == 0x12)
    {
      Send_Data[1] = Serve_31_Hex[Pos].Control_Type[0];
    }
    else if( NRC == 0x22)
    {
      _Set_NRC22(Serve_31_Hex[Pos].Control_Type[0],Pos,1);    
    }
  }
  /*---------------------------非31服务------------------------*/
  else if(NRC != 0x33 && Send_Data[0] != 0x31)
  {
    if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==0)
    {
      Fun_NRC_Send_Len =  _Get_Serve_13_Len(Send_Data[0],Fun_,0);
      NRC13_Count++;
    }
    else if( NRC == 0x13 && NRC13_total ==2 && NRC13_Count==1)
    {
      Fun_NRC_Send_Len =  _Get_Serve_13_Len(Send_Data[0],Fun_,2);
      NRC13_Count++;
    }
    else if( NRC == 0x13 && NRC13_total ==1)
    {
      Fun_NRC_Send_Len =  _Get_Serve_13_Len(Send_Data[0],Fun_,2);
    }
    else if( NRC == 0x12)
    {
      if(Send_Data[0] == 0x22 || Send_Data[0] == 0x2E)
      {
        Send_Data[1] = Serve_Data[Pos].Serve_Fun[Fun_Pos]>> 8 & 0xFF;
        Send_Data[2] = Serve_Data[Pos].Serve_Fun[Fun_Pos] & 0xFF;
      }
      else if(Send_Data[0] == 0x34)
      {
        Send_Data[1] = Serve_Data[Pos].Serve_Para[0][0];
        Send_Data[2] = Serve_Data[Pos].Serve_Para[0][1];
      }
      else
        Send_Data[1] = Serve_Data[Pos].Serve_Fun[Fun_Pos];
    }
    else if( NRC == 0x22)
      _Set_NRC22(Send_Data[0],Send_Data[1],1);
    else if( NRC == 0x10 && Send_Data[0]==0X2E)
      _Get_Serve_NRC10(Send_Data[0],1,Fun_NRC_Send_Len,10,Send_Data);
    else if( NRC == 0x31 && NRC31_total == 1)
    {
      if(Send_Data[0] == 0x34)
      {
        if(NRC34_31Count ==0)
          Send_Data[1] = Serve_Data[Pos].Serve_Para[0][0];
        else if(NRC34_31Count ==1)
          Send_Data[2] = Serve_Data[Pos].Serve_Para[0][1];
        else if(NRC34_31Count ==2)
          _Get_Serve_NRC31(Send_Data[0],1,Send_Data);
        NRC34_31Count++;
      }
      else
        _Get_Serve_NRC31(Send_Data[0],1,Send_Data);
    }
    else if(NRC == 0x31 && NRC31_total == 2 && NRC31_Count == 0)
    {
      if(Send_Data[0] == 0x34)
      {
        Send_Data[1] = Serve_Data[Pos].Serve_Para[0][0];
        Send_Data[2] = 0x44;
      }
      NRC31_Count++;
    }
    else if(NRC == 0x31 && NRC31_total == 2 && NRC31_Count == 1)
    {
      if(Send_Data[0] == 0x34)
      {
        _Get_Serve_NRC31(Send_Data[0],1,Send_Data);
      }
      NRC31_Count++;
    }
    /*--------------------------------------------------------------------------*/
//    else if( NRC == 0x31)
//    {
//      if(Send_Data[0] == 0x34)
//      {
//        if(NRC34_31Count ==0)
//          Send_Data[1] = Serve_Data[Pos].Serve_Para[0][0];
//        else if(NRC34_31Count ==1)
//          Send_Data[2] = Serve_Data[Pos].Serve_Para[0][1];
//        else if(NRC34_31Count ==2)
//          _Get_Serve_NRC31(Send_Data[0],1,Send_Data);
//        NRC34_31Count++;
//      }
//      else
//        _Get_Serve_NRC31(Send_Data[0],1,Send_Data);
//    }
    /*--------------------------------------------------------------------------*/
//    else if( NRC == 0x24)
//    {
//      Send_34(phyreq_ID);
//    }
      
  }
}
/**********************************************************************************/
void _Reset_By_11H() //11复位
{
  int Temp_Pos;
  byte Send[2];
  Temp_Pos = _Check_Serve(0x11,0,0);
  if( Temp_Pos!= -1)
  {
    Send[0] = 0x11;
    Send[1] = Serve_Data[Temp_Pos].Serve_Fun[0];
    if(Serve_Data[Temp_Pos].Security_Access[0] == 1)
    {
      _SetSession(exsession);
      _unlockECU();
    }
    _Send_Diag(2,phyreq_ID,Send);
    _TestResult(SendData,phyreq_ID,"",-1);
  }
  else
    _WriteEx_and_Report("0x11","该服务不支持");
}

int _Check_22H_Support(byte DID[])//检测所输入的参数是否被22服务所支持
{
  int Return_Value,n;
  int Serv_Pos;
  Serv_Pos = _Check_Serve(0x22,0,0);
  for(n=0;n<Serve_Data[Serv_Pos].Serve_Para_Count[0]*2-1;n=n+2)
  {
    if((DID[0]==Serve_Data[Serv_Pos].Serve_Para[0][n]) && (DID[1]==Serve_Data[Serv_Pos].Serve_Para[0][n+1]))
    {
      Return_Value = 1;
      return Return_Value;
    }
  }
  Return_Value = -1;
  return Return_Value;
}
/*
  检测所输入的参数是否被2E服务所支持
  Type = 0：检测所输入的参数是否被2E服务所支持(不使用ID及Session)
  Type = 1：当前寻址方式及会话下,该DID是否支持
*/
int _Check_2EH_Support(byte DID[],dword ID,byte Session,byte Type)//检测所输入的参数是否被2E服务所支持
{
  int Return_Value,n;
  int Serv_Pos;
  dword DID_Temp;
  DID_Temp = 0;
  Serv_Pos = _Check_Serve(0x2E,0,0);
  DID_Temp = ((DID[0]<<8 & 0xFF00) | DID[1]);
  if(Type == 0)
  {
    for(n=0;n<Serve_Data[Serv_Pos].Serve_Fun_Count;n++)
    {
      if(DID_Temp == Serve_Data[Serv_Pos].Serve_Fun[n])
      {
        Return_Value = 1;
        return Return_Value;
      }
    }
  }
  else if(Type == 1)
  {
    Return_Value = _Check_Fun_IDAndSess(0x2E,DID_Temp,ID,Session);
    return Return_Value;
  }
  Return_Value = -1;
  return Return_Value;
}
_Step_Serve_Fun(byte Serve,dword ID,byte session)//肯定响应抑制位测试(服务内的所有子功能均一致)
{
  byte Send_Data[100];
  int i,n,Fun_Poss,len,Serve_Poss;
  byte Size_Para;
  
  Serve_Poss = _Check_Serve(Serve,0,0);
  Send_Data[0] = Serve;
  for(i=0;i<=0xFF;i++)
  {
    Fun_Poss = _Check_Serve(Serve,i,4);
    len = 1+1;//服务+子功能
    if(Fun_Poss != -1)
    {
      Size_Para = Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][0];   //子功能对应的第一个参数长度
      if( Size_Para != 0)
      {
        for(n=0;n<Size_Para;n++)
          Send_Data[len+n] = Serve_Data[Serve_Poss].Serve_Para[Fun_Poss][n];
        len = len + Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][0];
      }
      Send_Data[1] = i;
      _Send_Diag(len,ID,Send_Data);
      _TestResult(SendData,ID,"",-1);
      if(_Check_Serve(Serve,i,3)==1)
      {
        Send_Data[1] = i|0x80;
        _Send_Diag(len,ID,Send_Data);
        _TestResult(SendData,ID,"",0);
      }
      else
        _WriteEx_and_Report("","当前子功能不支持肯定响应抑制位");
    }
  }
}

_Step_Serve_RSP(byte Serve,dword ID,byte session)//肯定响应抑制位测试(根据子功能情况确定响应状态)
{
  byte Send_Data[100];
  int i,n,Fun_Poss,len,Serve_Poss;
  byte Size_Para;
  int Count_;
  Count_ = 0;
  Serve_Poss = _Check_Serve(Serve,0,0);
  Send_Data[0] = Serve;
  for(i=1;i<=0xFF;i++)
  {
    Fun_Poss = _Check_Serve(Serve,i,4);
    len = 1+1;//服务+子功能
    if(Fun_Poss != -1)
    {
      Size_Para = Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][0];   //子功能对应的第一个参数长度
      if( Size_Para != 0)
      {
        for(n=0;n<Size_Para;n++)
          Send_Data[len+n] = Serve_Data[Serve_Poss].Serve_Para[Fun_Poss][n];
        len = len + Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][0];
      }
      Send_Data[1] = i;
      if(_Check_Serve(Serve,i,3)==1)
      {
        if(_Check_Fun_IDAndSess(Serve,i,ID,session) == 0) //寻址支持，但会话不支持
        {
          if(Serve == 0x10 ) //10服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            if((session != defsession) && (Count_ != 0))
              _SetSession(session);
            testWaitForTimeout(1000);
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            if(@AUTO::Config_Switch == 7 || (strncmp(ECU_project,"Chery",strlen("Chery")) == 0 ))
              _TestResult(SendData,ID,"",0x12);  
            else
              _TestResult(SendData,ID,"",0x7E);  
            _Send_And_Check_NowSession(ID,session);
            Count_++;
          }
          else
          {
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0x7E);
            _Send_And_Check_NowSession(ID,session);
          }
        }
        else if(_Check_Fun_IDAndSess(Serve,i,ID,session) == 1) //寻址和会话都支持
        {
          if(Serve == 0x10 ) //10服务特殊处理
          {
            _WriteEx_and_Report("","开始测试0x%02X肯定响应抑制位",i|0x80);
            if((session != defsession) && (Count_ != 0))
              _SetSession(session);
            testWaitForTimeout(1000);
            if((session == exsession) && (i==0x02)) //10 02特殊处理,加载前提条件
            {
              if(Pre_Programmed_1002 == 1)
              {
                _Pre_Programmed();
                if( (Pre_Programmed_UnlockECU == 0) && (_Check_Serve(Serve,i,5)==1))
                  _unlockECU();
              }
              else
              {
                if(_Check_Serve(Serve,i,5)==1)
                  _unlockECU();  
              }
            }
            Send_Data[1] = i|0x80;
            _Send_Diag_NoTime(len,ID,Send_Data);
            {
              diagSetP2Extended(-1);
              testWaitForDiagResponse(SendData,p2cmax);
              if(diagGetLastResponseCode(SendData)==0x78)
              {
                if((Sub_1082_NRC78 == 0) && (DiagGetPrimitiveByte(SendData,1)==0x82))
                  testStepFail("","0x82收到NRC78反馈,该项目预期0x82不响应NRC78");
                testWaitForDiagResponse(SendData,p2cmax*100);
                testReportWriteDiagResponse(SendData);
                _WriteEx_and_Report("","接收到NRC78响应,后续响应判断是否为正响应");
                _TestResult(SendData,ID,"",-1); 
              }
              else
              {
                testReportWriteDiagResponse(SendData);
                _TestResult(SendData,ID,"",0); 
                testWaitForTimeout(2000); 
                _reqseed();
                if(Send_Data[1] == 0x83)
                {
                  if(_Check_Fun_IDAndSess(0x27,RequestSeed_27,phyreq_ID,exsession)==1)
                    _TestResult(SendData,phyreq_ID,"",-1);  
                  else
                    _TestResult(SendData,phyreq_ID,"",0x7F); 
                  _Send_And_Check_NowSession(ID,exsession);
                }
                else if(Send_Data[1] == 0x81)
                {
                  _TestResult(SendData,phyreq_ID,"",0x7F);  
                  _Send_And_Check_NowSession(ID,defsession);
                }
                else
                {
                  _TestResult(SendData,phyreq_ID,"",-1);  
                  testWaitForTimeout(1000); 
                  _Send_And_Check_NowSession(ID,prosession);
                }
              }
            }
            Count_++;
          }
          else
          {
            Send_Data[1] = i|0x80;
            _Send_Diag(len,ID,Send_Data);
            _TestResult(SendData,ID,"",0);
//            _unlockECU();
            testWaitForTimeout(2000);
            _reqseed();
            _TestResult(SendData,phyreq_ID,"",0x7F);  
            _Send_And_Check_NowSession(ID,defsession);
          }
        }
        testWaitForTimeout(500);
      }
      else
      {
        _WriteEx_and_Report("","当前子功能不支持肯定响应抑制位");
        Send_Data[1] = i|0x80;
        _Send_Diag(len,ID,Send_Data);
        _TestResult(SendData,ID,"",0x12);
        _Send_And_Check_NowSession(ID,session);
      }
    }
  }
}
/*
  检测该服务在当前会话及寻址方式下是否支持
  适用于整个服务支持的寻址及会话一致的情况下
  Serve ： 服务
  ID ： 寻址方式
  session ： 会话
*/
int _Check_Serve_IDAndSess(byte Serve,dword ID,byte session)  
{
  int Temp_Serve_Pos;
  byte Add,Sess;
  char Tem_Fun[20];
  Temp_Serve_Pos = _Check_Serve(Serve,0,0);
  
  snprintf(Tem_Fun,elCount(Tem_Fun),"%s","");
  snprintf(Tem_Fun,elCount(Tem_Fun),"%02X服务",Serve);
  if(Temp_Serve_Pos == -1)
  {
    _WriteEx_and_Report(Tem_Fun,"当前服务不支持");
    return -2;
  }
  if(ID == funreq_ID)
    Add = 2;
  else if(ID == phyreq_ID)
    Add = 1;
  if(session == defsession)
    Sess = 1;
  else if(session == prosession)
    Sess = 2;
  else if(session == exsession)
    Sess = 4;
  if((Serve_Data[Temp_Serve_Pos].Serve_Addres[0] & Add) != 0)
  {
    if((Serve_Data[Temp_Serve_Pos].Serve_Session[0] & Sess) != 0)
      return 1;//该会话及寻址方式下支持该服务
    else
    {
      _WriteEx_and_Report(Tem_Fun,"寻址支持但会话不支持");
      return 0; //寻址支持但会话不支持
    }
  }
  else 
  {
    _WriteEx_and_Report(Tem_Fun,"当前寻址不支持该服务");
    return -1;
  }
}
int _Check_Serve_IDAndSess_(byte Serve,dword ID,byte session)  //检测该服务在当前会话及寻址方式下是否支持
{
  int Return_Value_Serve;
  byte Send_Data[2] = {0x85,0x03};
  int Addres,Addres2;
  int Len;
  Addres = -1;
  Addres2 = -1;
  Addres = _Check_Serve(Serve,0,0);
  Send_Data[0] = Serve;
  Return_Value_Serve = -1;
  if(Addres==-1)
  {
    testStep("","当前不支持%2X服务,验证返回NRC11",Serve);
    _Send_Diag(2,ID,Send_Data);
    _TestResult(SendData,ID,"",0x11);
  }
  else
  {
    Return_Value_Serve = 0;
    Addres2 = _Check_Serve(Serve,0,1);
    Send_Data[1] = Serve_Data[Addres].Serve_Fun[0];
    Len =  Serve_Data[Addres].Serve_Fun_Len[0] + 1;
    if((ID == phyreq_ID && (Addres2 & 1)!=0) || (ID == funreq_ID && (Addres2 & 2)!=0))
    {
      Addres2 = _Check_Serve(Serve,0,2);
      if((session == prosession && (Addres2 & 2)!=0) || (session == exsession && (Addres2 & 4)!=0) || (session == defsession && (Addres2 & 1)!=0))
      {
        Return_Value_Serve = Addres;//当前寻址方式和会话下支持该服务
      }
      else
        testStep("","当前会话不支持%2X服务",Serve);
    }
    else
      testStep("","当前寻址不支持%2X服务",Serve);
  }
  return Return_Value_Serve;
}

int _Check_31Serve_IDAndSess(byte Pos,byte Ctrl_Type,dword ID,byte session)  
{
  int Temp_Serve_Pos;
  byte Add,Sess;
  char Tem_Fun[20];
  
  Temp_Serve_Pos = 0;
  snprintf(Tem_Fun,elCount(Tem_Fun),"%s","");
  snprintf(Tem_Fun,elCount(Tem_Fun),"%02X %02X %02X %02X",0x31,Serve_31_Hex[Pos].Control_Type[Ctrl_Type],Serve_31_Hex[Pos].Routine[0],Serve_31_Hex[Pos].Routine[1]);
  if(Temp_Serve_Pos == -1)
  {
    _WriteEx_and_Report(Tem_Fun,"当前服务不支持");
    return -2;
  }
  if(ID == funreq_ID)
    Add = 2;
  else if(ID == phyreq_ID)
    Add = 1;
  if(session == defsession)
    Sess = 1;
  else if(session == prosession)
    Sess = 2;
  else if(session == exsession)
    Sess = 4;
  if((Serve_31_Hex[Pos].Serve_Addres[Ctrl_Type] & Add) != 0)
  {
    if((Serve_31_Hex[Pos].Serve_Session[Ctrl_Type] & Sess) != 0)
      return 1;//该会话及寻址方式下支持该服务
    else
    {
      _WriteEx_and_Report(Tem_Fun,"寻址支持但会话不支持");
      return 0; //寻址支持但会话不支持
    }
  }
  else 
  {
    _WriteEx_and_Report(Tem_Fun,"当前寻址不支持该服务");
    return -1;
  }
}
/*检测该子功能在当前会话及寻址方式下是否支持*/
int _Check_Fun_IDAndSess(byte Serve,dword Fun,dword ID,byte session)  
{
  int Temp_Serve_Pos,Temp_Fun_Pos;
  byte Add,Sess;
  char Tem_Fun[20];
  Temp_Serve_Pos = _Check_Serve(Serve,Fun,0);
  Temp_Fun_Pos = _Check_Serve(Serve,Fun,4);
  snprintf(Tem_Fun,elCount(Tem_Fun),"%s","");
  if(Fun<=0xFF)
    snprintf(Tem_Fun,elCount(Tem_Fun),"%s0x%02X 0x%02X",Tem_Fun,Serve,Fun);
  else
    snprintf(Tem_Fun,elCount(Tem_Fun),"%s0x%02X 0x%02X 0x%02X",Tem_Fun,Serve,(Fun>>8),(Fun & 0xFF));
  if((Temp_Serve_Pos == -1) || (Temp_Fun_Pos) == -1)
  {
    _WriteEx_and_Report(Tem_Fun,"当前服务不支持或子功能不支持");
    return -2;
  }
  if(ID == funreq_ID)
    Add = 2;
  else if(ID == phyreq_ID)
    Add = 1;
  if(session == defsession)
    Sess = 1;
  else if(session == exsession)
    Sess = 4;
  else if(session == prosession)
    Sess = 2;

  if((Serve_Data[Temp_Serve_Pos].Serve_Addres[Temp_Fun_Pos] & Add) != 0)
  {
    if((Serve_Data[Temp_Serve_Pos].Serve_Session[Temp_Fun_Pos] & Sess) != 0)
      return 1;//该会话及寻址方式下支持该子功能
    else
    {
      _WriteEx_and_Report(Tem_Fun,"寻址支持但会话不支持");
      return 0; 
    }
  }
  else 
  {
    _WriteEx_and_Report(Tem_Fun,"当前寻址不支持该子功能");
    return -1;
  }
}

/*检测对应服务及子功能下对应的该参数是否支持*/
int _Check_Para(byte Serve_Poss ,byte Fun_Poss,byte Para[],byte Para_Len)
{
  int Return_Value,k,flage_dif;
  int Len_,Start_Len;
  Return_Value = -1;
  Start_Len = 0;
  for(k=0;k<Serve_Data[Serve_Poss].Serve_Para_Count[Fun_Poss];k++)  //遍历所有参数组
  {
    flage_dif = 1;
    if((Para_Len-2)!= Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][k])   //长度不匹配则跳过
    {
      flage_dif = -1;
      continue;
    }
    else
    {
      for(Len_=Start_Len;Len_<Start_Len + Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][k];Len_++)
      {
        if(Para[Len_-Start_Len+2] != Serve_Data[Serve_Poss].Serve_Para[Fun_Poss][Len_])
        {
          flage_dif = -1;
          break;
        }
      }
      if(flage_dif==1)
        break;
    }
    Start_Len = Start_Len + Serve_Data[Serve_Poss].Serve_Para_Len[Fun_Poss][k];
  }
  if(flage_dif == 1)
    Return_Value = 1;
  return Return_Value;
}

/*
    检测服务结构体中对应的数据
    Fun ：子功能
    type = 0:检测服务是否支持(未查询到时表明服务不支持,位置为-1返回到外层)
    type = 1:检测服务所支持的寻址方式  (适用与整个服务所有子功能支持寻址方式均一致)
    type = 2:检测服务所支持的会话      (适用与整个服务所有子功能支持寻址方式均一致)
    type = 3:检测服务是否支持肯定响应抑制位      (适用与整个服务所有子功能支持寻址方式均一致)
    type = 4:检测子功能是否支持        (不支持返回-1,支持则返回所在列表位置)
    type = 5:检测子功能是否需要安全访问      (同时需要服务和子功能)
    type = 6:检测子功能对应的NRC列表      (同时需要服务和子功能)
    type = 7:检测子功能对应的NRC22条件      (同时需要服务和子功能)
    type = 8:检测子功能对应的NRC列表      (较为特殊,指定支持31服务,子功能改为31H结构体中RID所在位置)
    type = 9:检测31服务子功能是否支持肯定响应抑制位   
    type = 10:检测31服务对应的RID的控制类型下NRC22条件
    type = 11:检测31服务对应的RID的控制类型下安全访问条件
*/
int _Check_Serve(byte Serve ,dword Fun,byte type)
{
  int Return_Value,Possion_Serve,Possion_Fun;
  int Check_Fun;
  int k;
  char Common[30];
  snprintf(Common,elCount(Common),"%s","");
  snprintf(Common,elCount(Common),"0x%02X服务",Serve);
  snprintf(Common,elCount(Common),"%s0x%02X子功能",Common,Fun);
  Possion_Serve = -1;
  Possion_Fun = -1;
  for(k=0;k<Serve_Data_Count;k++)
  {
    if(Serve_Data[k].Serve==Serve)
    {
      Possion_Serve = k;  //查询服务所在结构体位置
      break;
    }
  }
  if( (type==0) && (Possion_Serve==-1) && (type != 8) && (type != 10)&& (type != 11))
    return -1;//未查询到服务 提前终止
  if(type == 8 || type == 10 || type == 11)
  {
    for(k=0;k<Serve_31_Hex_Count;k++)
    {
      if((Serve_31_Hex[k].Routine[0] == (Fun>>8)) && (Serve_31_Hex[k].Routine[1] == (Fun&0xFF)))
      {
        Possion_Serve = k;
        break;
      }
    }
//    writeEx(-3,0,"Possion_Serve %d ",Possion_Serve);
    if(Possion_Serve == -1)
      return -1;//未查询到RID 提前终止
    for(k=0;k<Serve_31_Hex[Possion_Serve].Control_Type_Count;k++)
    {
      if(Serve == Serve_31_Hex[Possion_Serve].Control_Type[k])
      {
        Possion_Fun = k;
        break;
      }
    }
//    writeEx(-3,0,"Possion_Fun %d ",Possion_Fun);
    if(Possion_Fun == -1)
      return -1;//未查询到控制类型 提前终止
  }
  else
  {
    for(k=0;k<Serve_Data[Possion_Serve].Serve_Fun_Count;k++)
    {
      if(Serve_Data[Possion_Serve].Serve_Fun[k]==Fun)
      {
        Possion_Fun = k;  //查询子功能所在列表位置
        break;
      }
    }
  }
  if(Fun == 0 && type != 4)  //未输入子功能默认选择第0个子功能,当检测子功能是否支持情况时除外
    Check_Fun = 0;
  else if(Fun>0)
    Check_Fun = Possion_Fun;
  if(((type>=5 && type< 8) || type == 9 ) && Possion_Fun == -1)
  {
    _WriteEx_and_Report(Common,"子功能不支持");
    return -1;//未查询到子功能 提前终止
  }
  if(type == 8)
  {
    snprintf(Common,elCount(Common),"%s","");
    snprintf(Common,elCount(Common),"31服务 0x%X RID",Fun);
    _WriteEx_and_Report(Common,"NRC列表");
  }
  if(type==0)
    Return_Value = Possion_Serve;  //返回结构体中所在位置
  else if(type==1)
    Return_Value = Serve_Data[Possion_Serve].Serve_Addres[Check_Fun];   //  Return_Value & 检测值 != 0即表示支持该寻址
  else if(type==2)
    Return_Value = Serve_Data[Possion_Serve].Serve_Session[Check_Fun];
  else if(type==3)
    Return_Value = Serve_Data[Possion_Serve].RSP[Check_Fun];
  else if(type==4)
    Return_Value = Possion_Fun;
  else if(type==5)
    Return_Value = Serve_Data[Possion_Serve].Security_Access[Check_Fun];
  else if(type==6)
  {
    for(k=0;k< Serve_Data[Possion_Serve].Serve_NRC_Count[Check_Fun];k++)
      Fun_NRC[k] = Serve_Data[Possion_Serve].Serve_NRC[Check_Fun][k];
    Fun_NRC_Count = Serve_Data[Possion_Serve].Serve_NRC_Count[Check_Fun];
    Return_Value = 1;
  }
  else if(type==7)
  {
    Return_Value = Serve_Data[Possion_Serve].Serve_NRC22[Check_Fun];
  }
  else if(type==8)
  {
    for(k=0;k< Serve_31_Hex[Possion_Serve].Serve_NRC_Count[Possion_Fun];k++)
    {
      Fun_NRC[k] = Serve_31_Hex[Possion_Serve].Serve_NRC[k];
    }
    Fun_NRC_Count = Serve_31_Hex[Possion_Serve].Serve_NRC_Count[Possion_Fun];
    Return_Value = Possion_Serve;
  }
  else if(type==9)
    Return_Value = Serve_Data[Possion_Serve].RSP[Check_Fun];
  else if(type==10)
    Return_Value = Serve_31_Hex[Possion_Serve].Serve_NRC22[Possion_Fun];
  else if(type==11)
    Return_Value = Serve_31_Hex[Possion_Serve].Security_Access[Possion_Fun];
  
  return Return_Value;
}
_TestDisableMsg(dword Node_ID)
{
  char Tem[20];
  snprintf(Tem,elCount(Tem),"0x%03X",Node_ID);
  _WriteEx_and_Report("丢失节点",Tem);
  testDisableMsg(Node_ID);
}
_TestEnableMsg(dword Node_ID)
{
  char Tem[20];
  snprintf(Tem,elCount(Tem),"0x%03X",Node_ID);
  _WriteEx_and_Report("恢复节点",Tem);
  testEnableMsg(Node_ID);
}
byte _Get_NRC_Input(byte NRC1,byte NRC2,byte Serve ,byte Fun)
{
  byte NRC;
  int Serve_Pos,Fun_Pos,i;
  if(Serve != 0x31)
  {
    Serve_Pos = _Check_Serve(Serve,0,0);
    Fun_Pos = _Check_Serve(Serve,Fun_Pos,4);
    for(i=0;i<Serve_Data[Serve_Pos].Serve_NRC_Count[Fun_Pos];i++)
    {
      if(Serve_Data[Serve_Pos].Serve_NRC[Fun_Pos][i] == NRC2)
      {
        NRC = NRC2;
        break;
      }
      if(Serve_Data[Serve_Pos].Serve_NRC[Fun_Pos][i] == NRC1)
      {
        NRC = NRC1;
        break;
      }
    }
  }
  return NRC;
}

/*
  Serve : 服务
  Fun_Pos : 功能所在位置
  Add : 寻址
  Session : 会话
  Type : 0:自动化测试部分 1:手动测试
*/
_NRC22_Test_Loop(int Serve,dword Fun_Pos,dword ID,byte Session,byte Type)
{
  byte Send_Data[100];
  dword Send_Len;
  byte Tar_NRC22;
  int m,Auto_Loop_22;
  int Serve_Pos,IsNRC22;
  char Step_Write[50];
  int Special;
  Special = 0;
  Send_Data[0] = Serve;
  snprintf(Step_Write,elCount(Step_Write),"0x%02X",Serve);
  {
    if(Serve != 0x31)
    {
      Serve_Pos = _Check_Serve(Serve,0,0);
      Send_Data[1] = Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos]; // 装载子功能
      Send_Len = Serve_Data[Serve_Pos].Serve_Fun_Len[Fun_Pos]; // 装载发送长度
      Tar_NRC22 = Serve_Data[Serve_Pos].Serve_NRC22[Fun_Pos]; // 装载NRC22条件
      
      snprintf(Step_Write,elCount(Step_Write),"%s 0x%02X",Step_Write,Send_Data[1]);
      if(Send_Data[0] == 0x28)
        Send_Data[2] = Serve_Data[Serve_Pos].Serve_Para[Fun_Pos][0];
      else if(Send_Data[0] == 0x22)
      {
        Send_Data[1] = (Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos]>>8);
        Send_Data[2] = (Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos]&0xFF);
        snprintf(Step_Write,elCount(Step_Write),"0x%02X 0x%02X 0x%02X",Serve,Send_Data[1],Send_Data[2]);
      }
      else if(Send_Data[0] == 0x2E)
      {
        dword Fun;
        int Fun_Pos_Ser;
        _get_2E_DID(Traversal_DID[Fun_Pos]);
        Send_Len = DID_2E_SendData_1_Len;
        Send_Data[1] = DID_2E_SendData_1[1];
        Send_Data[2] = DID_2E_SendData_1[2];
        Fun = ((Send_Data[1]<<8) | Send_Data[2]);
        Fun_Pos_Ser = _Check_Serve(Serve,Fun,4);
        Tar_NRC22 = Serve_Data[Serve_Pos].Serve_NRC22[Fun_Pos_Ser];
        snprintf(Step_Write,elCount(Step_Write),"0x%02X 0x%02X 0x%02X",Serve,Send_Data[1],Send_Data[2]);
        for(m=0;m<Send_Len;m++)
          Send_Data[m] = DID_2E_SendData_1[m];
      }
    }
    else
    {
      Send_Data[1] = Serve_31_Hex[Fun_Pos].Control_Type[0];
      Send_Data[2] = Serve_31_Hex[Fun_Pos].Routine[0];
      Send_Data[3] = Serve_31_Hex[Fun_Pos].Routine[1];
      Send_Len = Serve_31_Hex[Fun_Pos].Control_Type_TxLen[0];
      snprintf(Step_Write,elCount(Step_Write),"%s 0x%02X 0x%02X 0x%02X",Step_Write,Send_Data[1],Send_Data[2],Send_Data[3]);
      if(Serve_31_Hex[Fun_Pos].Control_Option_Count[0] != 0)
      {
        Send_Data[4] = Serve_31_Hex[Fun_Pos].Control_Option[0][0];
        snprintf(Step_Write,elCount(Step_Write),"%s 0x%02X",Step_Write,Send_Data[4]);
      }
      Tar_NRC22 = Serve_31_Hex[Fun_Pos].Serve_NRC22[0]; 
    }
    
    if((Send_Data[0] == 0x10) && (Send_Data[1] == 0x02))
      Special = 1;//10 02特殊处理部分
    else if(Send_Data[0] == 0x11)
      Special = 2;
    else if(Send_Data[0] == 0x28 && ((Send_Data[1]==0x02) || (Send_Data[1]==0x03)))
      Special = 3;
    else if(Send_Data[0] == 0x85 && Send_Data[1]==0x02)
      Special = 3;
    if(Type == 0)
    {
      Auto_Loop_22 = 3;
      if(Set_Battery_RS232 == 1)
        Auto_Loop_22 = 4;
      for(m=0;m<Auto_Loop_22;m++)
      {
//        Special_Requirements(exsession);
        if(@AUTO::Config_Switch!= 12)
        {
          _SetSession(defsession);
          if(Session != defsession)
            _SetSession(Session);    /*会话切换防止上一次干扰*/
        }
        if(Serve == 0x31 || Serve == 0x2E)
        {
          _Send_Key(SendKey_Len,phyreq_ID,_get_seed(phyreq_ID),0);
          _TestResult(SendData,phyreq_ID,"",-1);
          Get_Seed_Flage = 1;
        }
        testWaitForTimeout(100);
        if(m==0)//NRC22_车速
        {
          if((Tar_NRC22&0x1)!=0)
            IsNRC22 = 1;
          else
            IsNRC22 = 0;
          _NRC22_CarSpd(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special);
        }
        if(m==1)//NRC22_档位
        {
          if((Tar_NRC22&0x8)!=0)
            IsNRC22 = 1;
          else
            IsNRC22 = 0;
          _NRC22_Gears(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special);
        }
        if(m==2)//NRC22_发动机
        {
          if((Tar_NRC22 & 0x20)!=0)
            IsNRC22 = 1;
          else
            IsNRC22 = 0;
          _NRC22_Ready(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special);
        }
        if(m==3)//NRC22_电压
        {
          if((Tar_NRC22 & 0x02)!=0)
            IsNRC22 = 1;
          else
            IsNRC22 = 0;
          _NRC22_Battery(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special);
        }
        
      }
    }
    else if(Type == 1)
    {
      Auto_Loop_22 = 2;
      if(Set_Battery_RS232 == 0)
        Auto_Loop_22=3;
      for(m=0;m<Auto_Loop_22;m++)
      {
        _SetSession(defsession);
        if(Session != defsession)
          _SetSession(Session);    /*会话切换防止上一次干扰*/
        if(Serve == 0x31)
        {
          _Send_Key(SendKey_Len,phyreq_ID,_get_seed(phyreq_ID),0);
          _TestResult(SendData,phyreq_ID,"",-1);
          Get_Seed_Flage = 1;
        }
        if(m==2)//NRC22_电压
        {
          if((Tar_NRC22 & 0x02)!=0)
            IsNRC22 = 1;
          else
            IsNRC22 = 0;
          _NRC22_Battery(Send_Data,Send_Len,ID,Session,Step_Write,IsNRC22,Special);
        }
      }
    }
  }
}
/*
    自动化测试NRC22车速条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
*/
_NRC22_CarSpd(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special)
{
  byte Temp_NRC22_HigCar;
  int Temp_NRC22_InCar;
  dword Fun;
  int Flage_31;
  Temp_NRC22_HigCar = 0x22;
  Temp_NRC22_InCar = -1;
  Flage_31 = 0;
  _WriteEx_and_Report("","-----------------------");
  _WriteEx_and_Report("","NRC22_车速测试");
  _WriteEx_and_Report("","-----------------------");
  if(Send_Data[0] == 0x31 && Tpye == 1)
  {
    Fun = ((Send_Data[2]<<8) | (Send_Data[3]));
    Temp_NRC22_InCar = -1;
    Flage_31 = 1;
  }
  if(Special == 1)
    _Other_1002();
  if(Flage_31 == 0)
  {
    _WriteEx_and_Report("步骤1","设置车速 > NRC22车速");
    _Set_CarSpd(NRC22_CarSpd+1);
    if(Tpye == 0)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,-1);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    }
    else if(Tpye == 1)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Temp_NRC22_HigCar);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    }
    
    _WriteEx_and_Report("步骤2","设置车速 = NRC22车速");
    _Set_CarSpd(NRC22_CarSpd);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,-1);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    _WriteEx_and_Report("步骤3","设置车速 > NRC22车速，再丢失车速");
    _Set_CarSpd(NRC22_CarSpd+1);
    testWaitForTimeout(300);
    _TestDisableMsg(Car_Spd_ID);
    testWaitForTimeout(Lost_CarSpd_Time*1.1);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,-1);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    _TestEnableMsg(Car_Spd_ID);
    _Set_CarSpd(0);
    testWaitForTimeout(Lost_CarSpd_Time*1.1);
    _WriteEx_and_Report("步骤4","设置车速 > NRC22车速，再无效车速");
    _Set_CarSpd(NRC22_CarSpd+1);
    _Set_CarSpd_Invalid(Car_Spd_Invalid);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Temp_NRC22_InCar);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    _Reset_CarSpd_Invalid();
    _Set_CarSpd(0);
    testWaitForTimeout(500);
  }
  else
  {
    _WriteEx_and_Report("步骤1","设置车速 > 0车速");
    _Set_CarSpd(1);
    if(Tpye == 0)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,-1);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    }
    else if(Tpye == 1)
    {
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,Temp_NRC22_HigCar);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    }
    _WriteEx_and_Report("步骤2","设置车速 = 0车速，再丢失车速");
    _Set_CarSpd(0);
    testWaitForTimeout(100);
    _TestDisableMsg(Car_Spd_ID);
    testWaitForTimeout(Lost_CarSpd_Time*1.1);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Temp_NRC22_InCar);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    _WriteEx_and_Report("步骤3","设置车速丢失恢复，再无效车速");
    _TestEnableMsg(Car_Spd_ID);
    testWaitForTimeout(Lost_CarSpd_Time*1.1);
    _Set_CarSpd_Invalid(Car_Spd_Invalid);
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Temp_NRC22_InCar);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
    _Reset_CarSpd_Invalid();
    _Set_CarSpd(0);
    testWaitForTimeout(500);
  }
}
/*
    自动化测试NRC22档位条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
*/
_NRC22_Gears(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special)
{
  byte Temp_NRC22;
  byte Temp_27[2] = {0x27,0x01};
  int j;
  Temp_NRC22 = 0x22;
  Temp_27[1] = RequestSeed_27;
  if(Gears_ID != 0 && strncmp(Gears_Signal,"NULL",strlen(Gears_Signal)) != 0)
  {
    _WriteEx_and_Report("","-----------------------");
    _WriteEx_and_Report("","NRC22_档位测试");
    _WriteEx_and_Report("","-----------------------");
    if(Special == 1)
      _Other_1002();
    for(j=NRC_22_Gears_Range[0];j<NRC_22_Gears_Range[1];j++)
    {
      if(j==NRC_22_Gears_Normal)
        continue;
      
      _WriteEx_and_Report("步骤1","设置档位为非正常档位");
      _Set_Gears(j);
      if(Tpye == 0)
      {
        _Send_Diag(Send_Len,ID,Send_Data);
        _TestResult(SendData,phyreq_ID,Step,-1);
       _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
      }
      else if(Tpye == 1)
      {
        _Send_Diag(Send_Len,ID,Send_Data);
        _TestResult(SendData,ID,Step,Temp_NRC22);
        _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
      }
      _WriteEx_and_Report("步骤2","丢失档位");
      _TestDisableMsg(Gears_ID);
      testWaitForTimeout(1000);
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,-1);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
      _TestEnableMsg(Gears_ID);
      testWaitForTimeout(1000);
      _WriteEx_and_Report("步骤3","设置档位为正常档位");
      _Set_Gears(NRC_22_Gears_Normal);
      _Send_Diag(Send_Len,ID,Send_Data);
      _TestResult(SendData,ID,Step,-1);
      _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
      testWaitForTimeout(500);
    }
  }
  else
    writeEx(-3,0,"未输入档位条件,跳过测试");
}
/*
    自动化测试NRC22发动机条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
*/
_NRC22_Ready(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special)
{
  byte Temp_NRC22;
  byte Temp_27[2] = {0x27,0x01};
  Temp_NRC22 = 0x22;

  Temp_27[1] = RequestSeed_27;
  _WriteEx_and_Report("","-----------------------");
  _WriteEx_and_Report("","NRC22_发动机测试");
  _WriteEx_and_Report("","-----------------------");
  if(Special == 1)
    _Other_1002();
  _WriteEx_and_Report("步骤1","设置发动机满足NRC22条件");
  _Set_Ready(Ready_Active);
  if(Tpye == 0)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,phyreq_ID,Step,-1);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  }
  else if(Tpye == 1)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Temp_NRC22);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  }
  
  _WriteEx_and_Report("步骤2","丢失发动机信号");
  _TestDisableMsg(Ready_ID);
  testWaitForTimeout(1000);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,-1);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  _TestEnableMsg(Ready_ID);
  testWaitForTimeout(1000);
  if(strlen(ReadyInvalid_Sig) == 0 || strncmp(ReadyInvalid_Sig,"nan",strlen("nan")) == 0)
  {
    _WriteEx_and_Report("","无发动机无效相关测试");
    return;
  }
  _WriteEx_and_Report("步骤3","设置发动机无效");
  _Set_Sig(ReadyInvalid_Sig,Ready_Invalid);
  testWaitForTimeout(ReadyInvalid_Time*1.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,-1);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  _WriteEx_and_Report("步骤4","设置发动机到正常状态");
  _Set_Ready(0);
  _Set_Sig(ReadyInvalid_Sig,0);
  testWaitForTimeout(ReadyInvalid_Time*1.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,-1);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  testWaitForTimeout(500);
  _Set_Ready(0);
}
/*
    自动化测试NRC22电压条件
    Send_Data：发送数据
    Send_Len：发送长度
    ID：寻址
    Session: 会话
    Step ：打印内容
    Tpye ：0:正常响应,无NRC22条件   1:响应NRC22
*/
_NRC22_Battery(byte Send_Data[],dword Send_Len,dword ID,byte Session,char Step[],byte Tpye,int Special)
{
  byte Temp_NRC22_Hig,Temp_NRC22_Low;
  byte Temp_27[2] = {0x27,0x01};
  Temp_NRC22_Hig = 0x22;
  Temp_NRC22_Low = 0x22;
  Temp_27[1] = RequestSeed_27;
  _WriteEx_and_Report("","-----------------------");
  _WriteEx_and_Report("","NRC22_电压测试");
  _WriteEx_and_Report("","-----------------------");
  if(Special == 1)
    _Other_1002();
  
  _WriteEx_and_Report("步骤1","设置电压 > NRC22高压");
  _Set_Battery(NRC22_Battery_Hight+0.2);
  if(Tpye == 0)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,phyreq_ID,Step,-1);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  }
  else if(Tpye == 1)
  {
    _Send_Diag(Send_Len,ID,Send_Data);
    _TestResult(SendData,ID,Step,Temp_NRC22_Hig);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  }
  _WriteEx_and_Report("步骤2","设置电压 < NRC22高压");
  _Set_Battery(NRC22_Battery_Hight-0.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,-1);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  _WriteEx_and_Report("步骤3","设置电压 < NRC22低压");
  _Set_Battery(NRC22_Battery_Low-0.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  if(Tpye == 0)
  {
    _TestResult(SendData,phyreq_ID,Step,-1);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  }
  else if(Tpye == 1)
  {
    _TestResult(SendData,ID,Step,Temp_NRC22_Low);
    _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  }
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  _WriteEx_and_Report("步骤4","设置电压 > NRC22低压");
  _Set_Battery(NRC22_Battery_Low+0.2);
  _Send_Diag(Send_Len,ID,Send_Data);
  _TestResult(SendData,ID,Step,-1);
  _Special_Step(diagGetLastResponseCode(SendData),Special,Step,Session);
  testWaitForTimeout(500);
  _Set_Battery(12);;
}
void _Special_Step(int Code,byte Special,char St[],byte Session)
{
  int Serve34_Poss;
  byte Temp_34[11];
  byte Temp_27[2] = {0x27,0x01};
   
  Serve34_Poss = _Check_Serve(0x34,0,0);
  _Get_Serve_INI(Temp_34,0x34,Serve34_Poss,0);
  Temp_27[1] = RequestSeed_27;
  if(Code == -1)
  {
    if(Special == 1)
    {
      testWaitForTimeout(1000);
      _Send_Diag(BT_34_Len,phyreq_ID,Temp_34);
      if(@AUTO::Config_Switch == 4)
        _TestResult(SendData,phyreq_ID,St,0x24);
      else
        _TestResult(SendData,phyreq_ID,St,0x22);
      _SetSession(defsession);
      testWaitForTimeout(1000);
      _Other_1002();
//      if(Session_BIN !=4 && Session==exsession)
//        _SetSession(exsession);
      _SetSession(Session);
    }
    else if(Special == 2)
    {
      testWaitForTimeout(2000);
      _Send_Diag(2,phyreq_ID,Temp_27);
      _TestResult(SendData,phyreq_ID,St,0x7F);
      _SetSession(Session);
      testWaitForTimeout(200);
    }
    else if(Special == 3)
    {
      _SetSession(defsession);
      _SetSession(Session);
      testWaitForTimeout(200);
    }
  }
  else if(Code > 0)
  {
    if(Special == 1)
    {
      testWaitForTimeout(1000);
      _Send_Diag(BT_34_Len,phyreq_ID,Temp_34);
      _TestResult(SendData,phyreq_ID,St,0x7F);
    }
    else if(Special == 2)
    {
      testWaitForTimeout(2000);
      _Send_Diag(2,phyreq_ID,Temp_27);
      _TestResult(SendData,phyreq_ID,St,-1);
      _SetSession(defsession);
      _SetSession(Session);
      testWaitForTimeout(200);
    }
    else if(Special == 3)
    {
//      _SetSession(defsession); //上一次消极响应情况下可不在进行重新复位
//      _SetSession(Session);
      testWaitForTimeout(200);
    }
  }
}

