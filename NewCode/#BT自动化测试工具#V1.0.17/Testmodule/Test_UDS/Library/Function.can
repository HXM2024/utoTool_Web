/*请求解锁ECU*/
_unlockECU()
{
//  if(AES_128 != 2 && Session_BIN != 2)
//  {
//    _SetSession(exsession);
//    testWaitForTimeout(1000);
//  }
  diagResize(reqseed,2);
  diagResize(sendkey,SendKey_Len);
  DiagSetPrimitiveByte(reqseed,0,0x27);
  DiagSetPrimitiveByte(sendkey,0,0x27);
  DiagSetPrimitiveByte(reqseed,1,RequestSeed_27);
  DiagSetPrimitiveByte(sendkey,1,SendKey_27);
  if(AES_128==0 || @AUTO::Security_Switch == 0)
  {
    dword seed;
    dword skey;
    byte Send_Seed[2];
    byte Send_Key[20];
    Send_Seed[0] = 0x27;
    Send_Seed[1] = RequestSeed_27;
    Send_Key[0] = 0x27;
    Send_Key[1] = SendKey_27;
    
    testCaseComment("请求解锁ECU");
    _Send_Diag(2,phyreq_ID,Send_Seed);
    if(diagGetLastResponseCode(SendData)==-1)
    {
      int Seed_Pos,Seed_Len,Key_Loop;
      Seed_Len = DiagGetRespPrimitiveSize(SendData);
      seed = 0;skey = 0;
      for(Seed_Pos = 2 ;Seed_Pos < Seed_Len;Seed_Pos++)
        seed = seed | (DiagGetRespPrimitiveByte(SendData,Seed_Pos) << ((Seed_Len -3 -(Seed_Pos-2))*8));
      /*安全算法函数*/
      testStep("种子","种子为0x%08X",seed);
      SecurityAccess(seed,skey);
      testStep("密钥","计算出密钥为0x%08X",skey);
      DiagSetPrimitiveByte(sendkey,0,0x27);
      for(Key_Loop = 2;Key_Loop < SendKey_Len;Key_Loop++)
        Send_Key[Key_Loop] = (skey>>((SendKey_Len-1-Key_Loop)*8))&0xFF;
      _Send_Diag(SendKey_Len,phyreq_ID,Send_Key);

      /*判断是否解锁成功*/
      if(diagGetLastResponseCode(SendData)==-1)
        testStepPass("ECU解锁成功");
      else
        testStepFail("ECU解锁失败");
    }
    else
      testStepFail("ECU解锁,获取种子失败");
    testWaitForTimeout(500);
  }
  else if(AES_128==1 || @AUTO::Security_Switch==2) /*AES_CMAC*/
  {
    testWaitForTimeout(500);    //排除10 03的反馈干扰,会影响到获取种子
    testCaseComment("请求解锁ECU");
    _SendAndWriteReport_NoTime(reqseed,phyreq_ID);
    _saveMsg(p2cmax);
    _CheckCode(-1,4);
    testWaitForTimeout(200);
    diagResize(sendkey,SendKey_Len);
    _padding2702(0,sendkey);
    _SendAndWriteReport_NoTime(sendkey,phyreq_ID);
    _saveMsg(p2cmax);
    testWaitForTimeout(150);
  }
  else if(AES_128==2 || @AUTO::Security_Switch==1) /*AES_CBC*/
  {
    byte data[3]={0x22,0xF1,0x8C};
    int m;
    memcpy(ECU_Key,ECU_Key2,elCount(ECU_Key2));
    diagResize(reqseed,2);
    diagResize(sendkey,SendKey_Len);
    DiagSetPrimitiveByte(reqseed,0,0x27);
    DiagSetPrimitiveByte(sendkey,0,0x27);
    DiagSetPrimitiveByte(reqseed,1,RequestSeed_27);
    DiagSetPrimitiveByte(sendkey,1,SendKey_27);
    testCaseComment("获取序列号");
    _Send_Diag_And_Get_CF(3,phyreq_ID,data);
    if(diagGetLastResponseCode(SendData) == -1)
    {
      if(DiagGetRespPrimitiveSize(SendData) == 22)
      {
        for(m=0;m<16;m++)
          Serial_number[m] = DiagGetRespPrimitiveByte(SendData,m+6);
        /*序列号移位*/
        LeftMove(Serial_number,3);
//        for(m=0;m<16;m++)
//          writeEx(-3,0,"----------移位后序列号-------0x%2x",Serial_number[m]);
        /*用ECU KEY加密移位后的序列号 获取密钥KEY*/
        AES128_CBC_encrypt_buffer(Secret_KEY,Serial_number,KEY_Len,ECU_Key,Iv); 
//        if(@AUTO::Config_Switch != 1)
//          _SetSession(exsession);
        testWaitForTimeout(150);
        testCaseComment("请求解锁ECU");
        _SendAndWriteReport(reqseed,phyreq_ID,500);
        if(diagGetLastResponseCode(reqseed) == -1)
        {
          for(m=0;m<16;m++)
            RA[m]=DiagGetRespPrimitiveByte(reqseed,m+2);
          /*用密钥KEY解密RA 得到ra`*/
          AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,Iv);
          /*ra逆向*/
          reverseNum(ra,16);
          testWaitForTimeout(100);
          /*用密钥KEY加密r得到R*/
          AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,Iv);
          diagResize(sendkey,18);
          for(m=0;m<16;m++)
            DiagSetPrimitiveByte(sendkey,m+2,R[m]);
          diagSendRequest(sendkey);
          testWaitForDiagRequestSent(sendkey,50);
          testReportWriteDiagObject(sendkey);
          testWaitForDiagResponse(sendkey,1000);
          testReportWriteDiagResponse(sendkey); 
          if(diagGetLastResponseCode(sendkey)==-1)
            testStepPass("ECU解锁成功");
          else
            testStepFail("ECU解锁失败");
        }
        else
          testStepFail("","请求种子失败");
      }
      else
        testStepFail("","返回序列号长度错误,导致秘钥Key不可信");
    }
    else
      testStepFail("","未收到正确序列号,无法进行安全访问");
  }
}
/*
  各主机厂安全算法函数
  参数SaccSeed：请求种子
  参数SaccKey：安全访问密钥
*/
void SecurityAccess(dword SaccSeed,dword& SaccKey)
{
  if(@AUTO::Config_Switch==1)//BYD
  {
    dword KeyK;
    dword KeyResult;
    KeyK=0X00000137;
    KeyResult = ((((SaccSeed >> 1) ^ SaccSeed) <<3) ^ (SaccSeed >>2));
    SaccKey = KeyResult ^ KeyK;
  }
  else if(@AUTO::Config_Switch==2)//CA
  {
    dword seed;
    dword key1;
    dword key2;
    byte i;
    seed = 0;
    for(i=0;i<16;i++)
      seed=seed|(SaccSeed>>(31-i*2)&(1<<i));
    for(i=0;i<16;i++)
      seed=seed|(SaccSeed<<(31-i*2)&(0X80000000>>i));
    key1=SaccSeed^0X70F77302;
    key2=seed^0X70F77302;
    SaccKey=key1+key2;
  }
  else if(@AUTO::Config_Switch==3)//Geely 1.0
  {
    byte i;
    byte XorArray[4];
    byte calData[4];
    byte skeybyte[4];
    XorArray[0]=0xC1;
    XorArray[1]=0x1C;
    XorArray[2]=0x12;
    XorArray[3]=0x81;
    calData[0]=0;
    calData[1]=0;
    calData[2]=0;
    calData[3]=0;
    for (i = 0;i < 4;i++)
      calData[i] = ((SaccSeed>>(24-8*i))&0xFF)^ XorArray[i];/*修改秘钥传入方式为MSB*/
    skeybyte[0] = ((calData[2] & 0x03) << 6)|((calData[3]&0xFC)>>2);
    skeybyte[1] = ((calData[3] & 0x03) << 6 )|(calData[0]&0x3F);
    skeybyte[2] = (calData[0] & 0xFC)|((calData[1] & 0xC0) >> 6);
    skeybyte[3] = (calData[1] & 0xFC)|(calData[2] & 0x03);
    SaccKey=skeybyte[0];
    SaccKey=(SaccKey<<8)|skeybyte[1];
    SaccKey=(SaccKey<<8)|skeybyte[2];
    SaccKey=(SaccKey<<8)|skeybyte[3];
  }
  else if(@AUTO::Config_Switch==5)//鑫源
  {
    byte Seed[4];
    byte Skey[4];
    byte Xor[4]={0xA1,0x59,0xD4,0x30};
    byte Cal[4];
    byte i;
    Seed[0]=SaccSeed>>24;
    Seed[1]=SaccSeed>>16;
    Seed[2]=SaccSeed>>8;
    Seed[3]=SaccSeed; 
    for(i=0;i<4;i++)
      Cal[i]=Seed[i]^Xor[i];
    Skey[0]=((Cal[3]&0xF5)>>2) | ((Cal[0]&0x0F)<<6);
    Skey[1]=((Cal[2]&0x0F)<<4) | ((Cal[3]&0xC0)>>6);
    Skey[2]=((Cal[1]&0xFC)) | ((Cal[0]&0x3D));
    Skey[3]=((Cal[3]&0xE0)) | ((Cal[1]&0xF0)>>4);
    SaccKey=Skey[0];
    SaccKey=(SaccKey<<8)|Skey[1];
    SaccKey=(SaccKey<<8)|Skey[2];
    SaccKey=(SaccKey<<8)|Skey[3];
  }
  else if(@AUTO::Config_Switch==6)//瑞驰
  {
    byte i;
    dword tmpSaccSeed;
    dword mask = 0x5FD62190;//掩码5FD62190
    tmpSaccSeed = SaccSeed;
		for(i=0; i<32; i++)
		{
			if(tmpSaccSeed & 0x80000000)
			{
				tmpSaccSeed = tmpSaccSeed << 1;
				tmpSaccSeed = tmpSaccSeed ^ mask;
			}
			else
				tmpSaccSeed = tmpSaccSeed << 1;
		}
    SaccKey = tmpSaccSeed;
  }
  else if(@AUTO::Config_Switch==7)//奇瑞
  {
    byte Seed[2];
    dword remainder;
    byte n;
    byte i;
    Seed[0] = SaccSeed >> 8;
    Seed[1] = SaccSeed & 0xFF; 
    remainder =0xFFFE;
    for (n = 0; n < 2; n++)
    {
      remainder ^= ((Seed[n]) << 8);
      for (i = 0; i < 8; i++)
      {
        if (remainder & 0x8000)
        {
          if(remainder & 0x0080)
            remainder = (remainder << 1) ^ 0x8408;
          else
            remainder = (remainder << 1) ^ 0x8025;
        }
        else
          remainder = (remainder << 1);
      }
    }
    remainder = remainder & 0xFFFF;
    SaccKey = remainder;
  }
  else if(@AUTO::Config_Switch==8)//五菱
  {
    word uds_key_mul[32] = 
    {
      0x7678, 0x9130, 0xd753, 0x750f, 0x72cb, 0x55f7, 0x13da, 0x786b, 
      0x372a, 0x4932, 0x0e7c, 0x3687, 0x3261, 0xa82c, 0x8935, 0xd00c, 
      0x1995, 0x4311, 0xb854, 0x0d8d, 0x9863, 0x1a21, 0xf753, 0xd6d3,
      0xb15d, 0x7f3d, 0x6821, 0x791c, 0x26c5, 0x2e37, 0x0e69, 0x64a0 
    };
    dword temp;
  	word index;
  	word mult1;
  	word mult2;
    dword NC_DEFAULT_SEED;
    dword NC_UDS_KEYMASK;
    NC_DEFAULT_SEED=0xA548FD85;
    NC_UDS_KEYMASK=0x5C7D4EF3;
    index = 0x5D39;
  	if(SaccSeed == 0) 
  		SaccSeed = NC_DEFAULT_SEED;
  	for(temp=0x80000000;temp!=0;temp>>=1)
  	{
  		if(temp & SaccSeed) 
      {
  			index = croshortright(index,1);
  			if (temp & NC_UDS_KEYMASK) 
  				index ^= 0x74c9;
  		}
  	}
  	mult1 = (uds_key_mul[(index >> 2) & ((1 << 5) - 1)] ^ index);
  	mult2 = (uds_key_mul[(index >> 8) &((1 << 5) - 1)] ^ index);
  	temp = (((dword) mult1) << 16) | ((dword) mult2);
  	temp = mulu32(SaccSeed,temp);
  	SaccKey = temp;
  }
  else if(@AUTO::Config_Switch==9 || @AUTO::Config_Switch==10)//东风小康 || 赛力斯
  {
    byte Seed[4];
    byte Skey[4];
    byte Xor[4]={0xD1,0x31,0x54,0x07};
    byte Cal[4];
    byte i;
    Seed[0]=(SaccSeed>>24)&0xFF;
    Seed[1]=(SaccSeed>>16)&0xFF;
    Seed[2]=(SaccSeed>>8)&0xFF;
    Seed[3]=SaccSeed&0xFF;
    
    for(i=0;i<4;i++)
      Cal[i]=Seed[i]^Xor[i];
    
    Skey[0]=((Cal[0]&0x0f)<<4)|(Cal[1]&0x0f);
    Skey[1]=((Cal[1]&0xf0)>>4)|((Cal[2]&0x0f)<<4);
    Skey[2]=((Cal[2]&0xf0)>>4)|(Cal[3]&0xf0);
    Skey[3]=(Cal[3]&0x0f)|((Cal[0]&0xf0)>>4);
    
    SaccKey=Skey[0];
    SaccKey=(SaccKey<<8)|Skey[1];
    SaccKey=(SaccKey<<8)|Skey[2];
    SaccKey=(SaccKey<<8)|Skey[3];
  }
  else if(@AUTO::Config_Switch== 12)
  {
    dword AppKeyConst = 0x19870413;
    SaccKey = ((SaccSeed + 0x19870424)|AppKeyConst)&0xFFFFFFFF;
  }
}
/**/
void _SecurityAccess_AES(dword seed[], word Byte_[],word corresKey[])
{
  char M[16],mic[16];
  int i;
  char fixByte[16];
  word gHandle;
  for(i=0;i<16;i++)
  {
    fixByte[i] = Byte_[i];
  }
  gHandle = registerCAPLDLL();
  for(i = 0; i < 16; i++)
  {
    M[i] = seed[i];
  }
  aes_128_cmac(M,fixByte,mic);
  for(i = 0; i < 16; i++)
  {
    corresKey[i] = mic[i] & 0xFF;
  }
  fileClose(gHandle);
}
/*用于五菱安全算法*/
word croshortright(word c, word b)
{
	word right;
	word left;
	word crorightvalue;
  right = c >> b;
  left = c << (16 - b);
  crorightvalue = left | right;
	return crorightvalue;
}
/*用于五菱安全算法*/
dword croleft(dword c, word b)
{
	dword left;
	dword right;
	dword croleftvalue;
  left = c << b;
  right = c >> (32 - b);
  croleftvalue = left | right;
	return croleftvalue;
}
/*/用于五菱安全算法*/
dword mulu32(dword val1, dword val2)
{
	dword x, y, z, p;
  dword NC_UDS_KEYMASK=0x5c7d4ef3;
	x = (val1 & NC_UDS_KEYMASK) | ((~val1) & val2);
	y = ((croleft(val1, 1)) & (croleft(val2, 14)))
	        | ((croleft(NC_UDS_KEYMASK, 21)) & (~(croleft(val1, 30))));
	z = (croleft(val1, 17)) ^ (croleft(val2, 4))
	        ^ (croleft(NC_UDS_KEYMASK, 11));
	p = x ^ y ^ z;
	return p;
}

void _WriteEx_and_Report(char str1[],char str2[])
{
  char str[500];
  
  snprintf(str,elCount(str),"%s","");
  
  TestStep(str1,str2);
  strncpy(str,str1,elCount(str));
  strncat(str,"   ",elCount(str));
  strncat(str,str2,elCount(str));
  writeEx(-3,0,str);
}
void _WriteEx_and_Report(char str1[],char str2[],dword Da)
{
  char str[500];
  
  snprintf(str,elCount(str),"%s","");
  
  TestStep(str1,str2,Da);
  strncpy(str,str1,elCount(str));
  strncat(str,"   ",elCount(str));
  strncat(str,str2,elCount(str));
  writeEx(-3,0,str,Da);
}
//更新条件查询31 01 02 03
//参数msgID:{phyreq_ID:物理寻址,funreq_ID:功能寻址}
//参数Passcondition:{-1:期望收到积极响应,0:期望不收到响应,>0:期望收到的NRC}
void UpdateCheck(dword msgID,int Passcondition)
{
  diagRequest ABS_ESP.Check_Memory_Start req0203;
  snprintf(stepid,elCount(stepid),"");
  testStep(stepid,"开始更新条件查询");
  
  //瑞驰
  if(@AUTO::Config_Switch==6)
  {
    diagResize(req0203,0x04);
    DiagSetPrimitiveByte(req0203,0,0x31);
    DiagSetPrimitiveByte(req0203,1,0x01);
    DiagSetPrimitiveByte(req0203,2,0xF0);
    DiagSetPrimitiveByte(req0203,3,0x02);
  }
  else
  {
    diagResize(req0203,0x04);
    DiagSetPrimitiveByte(req0203,0,0x31);
    DiagSetPrimitiveByte(req0203,1,0x01);
    DiagSetPrimitiveByte(req0203,2,0x02);
    DiagSetPrimitiveByte(req0203,3,0x03);
  }
  _SendAndWriteReport(req0203,msgID);
  _TestResult(req0203,msgID,stepid,Passcondition); 
}

dword _Check_CANFD_Flage()
{
  dword data = 0;
  if(@AUTO::CANFD_Switch == 0)
  {
    _WriteEx_and_Report("","当前为CAN报文数据");
    data = 7;   
  }
  if(@AUTO::CANFD_Switch == 1)
  {
    _WriteEx_and_Report("","当前为CANFD报文数据");
    data = 0x3E;   
  }
  return data;
}
void _Check_10_01(dword size,byte Sub_Function,dword Time_1,dword Time_2)
{
  dword Temp_Time_1;
  dword Temp_Time_2;
  int i=0;
  char Buffer_Temp[100];
  byte result;
  message 0x00 msg;
  Temp_Time_1 = 0;Temp_Time_2 = 0;
  snprintf(Buffer_Temp,elCount(Buffer_Temp),"%s","");
  Buffer_Temp[0] = 0x50;
  Buffer_Temp[1] = Sub_Function;
  if(diagGetLastResponseCode(SendData) == 0)
    testWaitForDiagResponse(SendData,p2cmax);
  if(Sub_Function ==0x02 && Sub_1002_NRC78==1 && diagGetLastResponseCode(SendData) == 0x78)
  {
//    if((msg.byte(0)==0x03)&&(msg.byte(1)==0x7F)&&(msg.byte(3)==0x78))
      testStepFail("","收到否定响应NRC78");
//    else
//      testStepPass("","未收到否定响应NRC78");
  }
  if(diagGetLastResponseCode(SendData) == 0x78)
    testWaitForDiagResponse(SendData,p2cmax*10);
  testReportWriteDiagResponse(SendData);
  if(size==DiagGetRespPrimitiveSize(SendData))
  {
    testStepPass("","反馈长度与预期长度一致");
    writeEx(-3,0,"反馈长度与预期长度一致");
  }
  else
  {
    testStepFail("","预期长度%d，实际长度：%d",size,DiagGetRespPrimitiveSize(SendData));
    writeEx(-3,0,"预期长度%d，实际长度：%d",size,DiagGetRespPrimitiveSize(SendData));
  }
  for(i=0;i<2;i++)
  {
    if(DiagGetRespPrimitiveByte(SendData,i) != Buffer_Temp[i])
      testStepFail("","正响应部分异常，与期望不一致");
    else
      testStepPass("","响应与期望一致");
  }
  if(size == 2)
    return;
  if(Sub_Function==0x02 && Sub_1002_Time_Flage==0)
  {
    Temp_Time_1 = DiagGetRespPrimitiveByte(SendData,2)*256+DiagGetRespPrimitiveByte(SendData,3);
    if(Temp_Time_1 == Sub_1002_Time)
      testStepPass("","P2can_server时间与期望一致为%d",Time_1);
    else
      testStepFail("","P2can_server期望为%d,实际为%d",Sub_1002_Time,Temp_Time_1);
  }
  else
  {
    Temp_Time_1 = DiagGetRespPrimitiveByte(SendData,2)*256+DiagGetRespPrimitiveByte(SendData,3);
    Temp_Time_2 = DiagGetRespPrimitiveByte(SendData,4)*256+DiagGetRespPrimitiveByte(SendData,5);
    if(Temp_Time_1 == Time_1)
      testStepPass("","P2can_server时间与期望一致为%d",Time_1);
    else
      testStepFail("","P2can_server期望为%d,实际为%d",Time_1,Temp_Time_1);
    if(Temp_Time_2*10 == Time_2)
      testStepPass("","P2*can_server时间与期望一致为%d",Time_2);
    else
      testStepFail("","P2*can_server期望为%d,实际为%d",Time_2,Temp_Time_2*10);
  }
}

_Set_11_Restoration()
{
  byte Temp[2]={0x11,0x01};
  byte flage;
  int k,Fun_Pos,Serve_Pos;
  flage=0;
  Serve_Pos = _Check_Serve(0x11,0,0);
  if(Serve_Pos == -1)
  {
    _WriteEx_and_Report("","未查询到支持11服务");
    return;
  }
  if(Serve_Data[Serve_Pos].Security_Access[Fun_Pos]==1)
    _unlockECU();
  Temp[1] = Serve_Data[Serve_Pos].Serve_Fun[Fun_Pos];
  _Send_Diag(2,phyreq_ID,Temp);
  _TestResult(SendData,phyreq_ID,"",-1);
  testWaitForTimeout(2000); /*11复位后增加延时时间防止后续出错*/
}

/*遍历选中字符串的数据*/
void _get_Str_Traversal(char Str[])
{
  char Temp_Value1[2000];
  char Temp_Value2[20];
  int i,m=0,j=0;
  snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
  snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
  
  glbHandle1 = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project, Str,"Null",Temp_Value1, 2000, file_name_1);
  fileClose(glbHandle1);
  for(j=0;j<strlen(Temp_Value1);j++)
  {
    if(Temp_Value1[j]==91)
    {
      for(i=j+1;i<strlen(Temp_Value1);i++)
      {
        if(Temp_Value1[i]==93)
        {
          Traversal_Count = atol(Temp_Value2);
          break;
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[i]);
      }
    }
    if(Temp_Value1[j]==123)
    {
      for(i=j+1;i<strlen(Temp_Value1);i++)
      {
        if(Temp_Value1[i]==44 || Temp_Value1[i]==125)
        {
          m++;
          if(Temp_Value1[i]==125)
            break;
        }
        else
          snprintf(Traversal_DID[m],elCount(Traversal_DID[m]),"%s%c",Traversal_DID[m],Temp_Value1[i]);
      }
    }
  }
  testWaitForTimeout(1000);
}

/*获取DID为"Str"中的数据*/
_Get_DID(char Str[])
{
  char Temp_Value1[500];
  char Temp_Value2[100];
  char Temp_Value3[5000];
  char Temp_Value4[50];
  char Temp_Value5[50];
  
  char Temp_byte1[50];
  char Temp_byte2[50];
  char Temp_Str[1000];
  
  int j,m,Count;
  j=0;m=0;
  snprintf(Temp_Value3,elCount(Temp_Value3),"%s","");
  glbHandle1 = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project, Str,"Null",Temp_Value3, 5000, file_name_1);
  fileClose (glbHandle1);
  Count = 1;
  for(i = 0;i<strlen(Temp_Value3);i++)                  //查找INI文件中数组值并返回10进制
  {
    if(Temp_Value3[i] == 91 && Count == 1)/*取解析方式*/
    {
      snprintf(Temp_Value5,elCount(Temp_Value5),"%s","");
      for(j=i+1;j<=strlen(Temp_Value3);j++)
      {
        if(Temp_Value3[j]==93)
        {
          Analysis = atol(Temp_Value5);
          Count++;
          i=j;
          break;
        }
        else
          snprintf(Temp_Value5,elCount(Temp_Value5),"%s%c",Temp_Value5,Temp_Value3[j]);
      }
    }
    if(Temp_Value3[i] == 91 && Count == 2)/*取预期长度*/
    {
      snprintf(Temp_Value4,elCount(Temp_Value4),"%s","");
      for(j = i+1;j<strlen(Temp_Value3);j++)
      {
        if(Temp_Value3[j] == 93)
        {
          Count++;
          i=j;
          break;
        }
        snprintf(Temp_Value4,elCount(Temp_Value4),"%s%c",Temp_Value4,HexToAsc(Temp_Value3[j]));
      }
    }
    if(Temp_Value3[i] == 91 && Count == 3)/*取子服务DID*/
    {
      snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
      for(j = i;j<strlen(Temp_Value3);j++)
      {
        snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,HexToAsc(Temp_Value3[j]));
        if(Temp_Value3[j] == 93)/*取间隔符 */
        {
          Count++;
          i=j;
          break;
        }
      }
    }
    if(Temp_Value3[i] == 91  && Analysis == 1 && Count == 4)/*以16进制HEX格式获取数据*/
    {
      snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
      for(j=i+1;j<strlen(Temp_Value3);j++)
      {
        if(Temp_Value3[j]== 44)  /*取间隔符  */
        {
          DID_Data[m] = atol(Temp_Str);   /*取预期结果byte */
          snprintf(Temp_Str,elCount(Temp_Str),"%s","");
          m++;
        }
        else if(Temp_Value3[j]== 93 ) /*(最后一个byte终止) */
        {
          DID_Data[m] = atol(Temp_Str);
          if(strlen(Temp_Str) != 0) //防止输入为空时进行输入数据个数计数
            m++;  
          snprintf(Temp_Str,elCount(Temp_Str),"%s","");
          Count++;
          i=j;
          break;
        }
        else
          snprintf(Temp_Str,elCount(Temp_Str),"%s%c",Temp_Str,Temp_Value3[j]);
      }
    }
    else if(Temp_Value3[i] == 91  && Analysis == 2 && Count == 4)/*以ASCII码格式获取数据*/
    {
      snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
      snprintf(DID_Data_str,elCount(DID_Data_str),"%s","");
      for(j=i+1;j<strlen(Temp_Value3);j++)
      {
        if(Temp_Value3[j] == 93)
        {
          Count++;
          i=j;
          break;
        }
        snprintf(DID_Data_str,elCount(DID_Data_str),"%s%c",DID_Data_str,HexToAsc(Temp_Value3[j]));
      }
    }
    else if(Temp_Value3[i] == 91  && (Analysis == 3 ||Analysis == 4||Analysis == 5||Analysis == 6) && Count == 4)/*以字符串获取数据,3:整体转换为10进制判断,4:每个Byte分别转换10进制后拼接,5:原码拼接判断,6:混合判断*/
    {
      snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
      snprintf(DID_Data_str,elCount(DID_Data_str),"%s","");
      for(j=i+1;j<strlen(Temp_Value3);j++)
      {
        if(Temp_Value3[j] == 93)
        {
          Count++;
          i=j;
          break;
        }
        else
          snprintf(DID_Data_str,elCount(DID_Data_str),"%s%c",DID_Data_str,HexToAsc(Temp_Value3[j]));
      }
    }  
    if(Temp_Value3[i] == 91 && Count == 5) /*取可写性*/
    {
      snprintf(Temp_Value5,elCount(Temp_Value5),"%s","");
      for(j=i+1;j<=strlen(Temp_Value3);j++)
      {
        if(Temp_Value3[j]==93)
        {
          Write_Flage = atol(Temp_Value5);
          Count++;
          i=j;
          break;
        }
        else
          snprintf(Temp_Value5,elCount(Temp_Value5),"%s%c",Temp_Value5,Temp_Value3[j]);
      }
    }
    if(Temp_Value3[i] == 91 && Count == 6) /*取填充值*/
    {
      snprintf(Temp_Value5,elCount(Temp_Value5),"%s","");
      for(j=i+1;j<=strlen(Temp_Value3);j++)
      {
        if(Temp_Value3[j]==93)
        {
          UnUse_Byte = atol(Temp_Value5);
          Count++;
          i=j;
          break;
        }
        else
          snprintf(Temp_Value5,elCount(Temp_Value5),"%s%c",Temp_Value5,Temp_Value3[j]);
      }
    }
  }
  DID_len_Ex = atol(Temp_Value4)+3;
  for(i=0;i<strlen(Temp_Value2);i++)
  {
    if(Temp_Value2[i] == 91)
    {
      snprintf(Temp_byte1,elCount(Temp_byte1),"%s","");
      for(j = i+1;j<strlen(Temp_Value2);j++)
      {
        if(Temp_Value2[j] == 44)
          break;
        snprintf(Temp_byte1,elCount(Temp_byte1),"%s%c",Temp_byte1,Temp_Value2[j]);
      }
      DID_byte1 = atol(Temp_byte1);
    }
    if(Temp_Value2[i] == 44 )
    {
      snprintf(Temp_byte2,elCount(Temp_byte2),"%s","");
      for(j = i+1;j<strlen(Temp_Value2);j++)
      {
        if(Temp_Value2[j] == 93)
          break;
        snprintf(Temp_byte2,elCount(Temp_byte2),"%s%c",Temp_byte2,Temp_Value2[j]);
      }
      DID_byte2 = atol(Temp_byte2);
    } 
  }
  Len_Input = m;
}

_get_2E_DID(char Str[])
{
  char Temp_Value1[1000];  /*装载获取到的字符串对应的全部数据*/
  char Temp_Value2[500];  /*装载获取到的分段数据*/
  
  char Temp_Str[500];
  int i,n,j;
  int Send_1_Input,Send_2_Input;
  
  snprintf(Temp_Value1,elCount(Temp_Value1),"%s","");
  snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
  n = 0;
  DID_2E_SendData_1[0] = 0x2E;
  DID_2E_SendData_2[0] = 0x2E;
  Read_2E_DID[0] = 0x22;
  Send_1_Input = 0;
  Send_2_Input = 0;
  
  writeEx(-3,0,"获取数据 %s",Str);
  glbHandle1 = OpenFileRead (file_name_1,0);
  getProfileString(ECU_project,Str,"Null",Temp_Value1, 1000, file_name_1);
  fileClose (glbHandle1);
  DID_2E_TxFiller = Send_filler;
  for(i=0;i<strlen(Temp_Value1);i++) 
  {
    if(Temp_Value1[i]== 91 && n==0) //装载预期发送DID，ASCII 44 = ‘,’ 91 = '[', 93 = ']'
    {
      DID_2E_Len = 1;
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_SendData_1[DID_2E_Len]=atol(Temp_Value2);
          DID_2E_SendData_2[DID_2E_Len]=atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          DID_2E_Len++;
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==1) //装载预期发送数据1长度
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_SendData_1_Len = atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==2) //装载第一次预期发送数据
    {
      Send_1_Input = 0;
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_SendData_1[3 + Send_1_Input]=atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          Send_1_Input++;
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==3) //装载第一次预期发送数据预期响应
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_SendData_1_Response=atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==4) //装载预期发送数据2长度
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_SendData_2_Len = atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==5) //装载第二次预期发送数据
    {
      Send_2_Input = 0;
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_SendData_2[3 + Send_2_Input]=atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          Send_2_Input++;
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==6) //装载第二次预期发送数据预期响应
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_SendData_2_Response=atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==7) //装载发送填充值
    {
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          DID_2E_TxFiller = atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
    if(Temp_Value1[i]== 91 && n==8) //获取读取数据DID
    {
      Read_2E_DID_Len = 1;
      for(j=i+1;j<strlen(Temp_Value1);j++)
      {
        if(Temp_Value1[j]==44 || Temp_Value1[j]==93)
        {
          Read_2E_DID[Read_2E_DID_Len] = atol(Temp_Value2);
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s","");
          Read_2E_DID_Len++;
          if(Temp_Value1[j]==93)
          {
            n++; i = j;
            break;
          }
        }
        else
          snprintf(Temp_Value2,elCount(Temp_Value2),"%s%c",Temp_Value2,Temp_Value1[j]);
      }
    }
  }

  /*----------------判断是否需要填充值------------------*/
  if(Send_1_Input+3 < DID_2E_SendData_1_Len)
  {
    for(i=Send_1_Input+3;i<DID_2E_SendData_1_Len;i++)
      DID_2E_SendData_1[i] = DID_2E_TxFiller;
  }
  if(Send_2_Input+3 < DID_2E_SendData_2_Len)
  {
    for(i=Send_2_Input+3;i<DID_2E_SendData_2_Len;i++)
      DID_2E_SendData_2[i] = DID_2E_TxFiller;
  }
  
  if(Read_2E_DID_Len <= 2)
    Support_Read_2E_DID = -1;
  else
    Support_Read_2E_DID = 1;
}
/*请求种子*/
int _reqseed()
{
  diagSetTarget(Cdd_Name);
  _WriteEx_and_Report("","请求种子");
  diagResize(SendData,2);
  DiagSetPrimitiveByte(SendData,0,0x27);
  DiagSetPrimitiveByte(SendData,1,RequestSeed_27);
  diagSendRequest(SendData);
  testWaitForDiagRequestSent(SendData,500);
  testWaitForDiagResponse(SendData,p2cmax);
  return diagGetLastResponseCode(SendData);
}
/*获取种子*/
qword _get_seed(dword msgID)
{
  byte Temp[2] = {0x27,0x01};
  byte Serial_Num_Req[3] = {0x22,0xF1,0x8C};
  qword seed_Temp;
  byte Len,i,Falge_AES_CBC;
  byte m;
  Len = 0;
  m = 0;
  seed_Temp = 0;
  Falge_AES_CBC = 0;
  Temp[1] = RequestSeed_27;
  if(AES_128==2 && Get_Seed_Flage==0)/*重复请求种子时跳过发送此部分*/
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    _WriteEx_and_Report("","获取序列号");
    _Send_Diag_And_Get_CF(3,phyreq_ID,Serial_Num_Req);
    if(diagGetLastResponseCode(SendData) == -1)
    {
      if(DiagGetRespPrimitiveSize(SendData) == 22)
      {
        for(m=0;m<16;m++)
          Serial_number[m] = DiagGetRespPrimitiveByte(SendData,m+6);
        /*序列号移位*/
        LeftMove(Serial_number,3);
        /*用ECU KEY加密移位后的序列号 获取密钥KEY*/
        AES128_CBC_encrypt_buffer(Secret_KEY,Serial_number,KEY_Len,ECU_Key,Iv);
      }
      else
      {
        testStepFail("序列号长度错误");
        Falge_AES_CBC =1;
      }
    }
    else
    {
      testStepFail("获取序列号失败");
      Falge_AES_CBC =1;
    }
  }
  _Send_Diag_And_Get_CF(2,msgID,Temp);
  if(diagGetLastResponseCode(SendData)==-1)
  {
    Len = DiagGetRespPrimitiveSize(SendData);
    if(AES_128==0)
    {
      for(i=2;i<Len;i++)
        seed_Temp = seed_Temp | (DiagGetRespPrimitiveByte(SendData,i)<<((Len-i-1)*8));
      testStep("种子","获取到种子为0x%2X",seed_Temp);
      Seed_Count_List[Seed_Count] = seed_Temp;
      Seed_Count++;
      return seed_Temp;
    }
    else if(AES_128==1)
    {
      _WriteEx_and_Report(ECU_project,"当前采用AES-128算法");
      for(i=2;i<Len;i++)
      {
        Seed_AES[i-2] = DiagGetRespPrimitiveByte(SendData,i);
        Seed_Count_List_AES128[Seed_Count][i-2] = DiagGetRespPrimitiveByte(SendData,i);
      }
      Seed_Count++;
      return 0;
    }
    else if(AES_128==2 && Falge_AES_CBC == 0)
    {
      for(i=2;i<Len;i++)
      {
        Seed_CBC[i-2] = DiagGetRespPrimitiveByte(SendData,i);
        Seed_Count_List_AES128[Seed_Count][i-2] = DiagGetRespPrimitiveByte(SendData,i);
      }
      Seed_Count++;
      return 0;
    }
    else if(AES_128==2 && Falge_AES_CBC == 1)
    {
      _WriteEx_and_Report(ECU_project,"序列号错误导致计算的秘钥不可信");
      return -1;
    }
    else
    {
      _WriteEx_and_Report(ECU_project,"安全访问算法选择异常");
      return -1;
    }
  }
  else
  {
    testStep("","获取种子失败");
    return -1;
  }
}
/*通过种子计算出密钥并发送,type:0:正确密钥  1:错误密钥*/
void _Send_Key(byte len, dword msgID,qword Temp_seed,dword type)   
{
  byte Key_Data[18];
  dword m=0;
  dword Skey;
  word key_i;
  Key_Data[0] = 0x27;
  Key_Data[1] = SendKey_27;
  if(AES_128 == 0)
  {
    SecurityAccess(Temp_seed,Skey);
    testStep("密钥","计算出密钥为0x%2X",Skey);
    if(type == 1)
    {
      for(m=2;m<len;m++)
        Key_Data[m] = 0x00;
    }
    else
    {
      for(m=2;m<len;m++)
        Key_Data[m] = (Skey>>(abs(m+1-len)*8))&0xFF;
    }
    _Send_Diag(len,msgID,Key_Data);   
  }
  else if(AES_128 == 1 || @sysvar::AUTO::Security_Switch == 2)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-128算法");
    if(type == 0)
    {
//      if(@AUTO::Config_Switch == 4)
//        _SecurityAccess_AES(Seed_AES,fixByte_Geely_APP,corresKey);
//      else if(@AUTO::Config_Switch == 6)
//        _SecurityAccess_AES(Seed_AES,fixByte_RC_BT,corresKey);
//      else if(@AUTO::Config_Switch == 11)
//        _SecurityAccess_AES(Seed_AES,fixByte_Chery_BT,corresKey);
//      else if(@AUTO::Config_Switch == 2)//长安掩码
//        _SecurityAccess_AES(Seed_AES,fixByte_CCAG_APP,corresKey);
      _Key_Count();
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = corresKey[key_i];
    }
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = 0x00;
    }
    _Send_Diag(len,msgID,Key_Data);
  }
  else if(AES_128 == 2)
  {
    _WriteEx_and_Report(ECU_project,"当前采用AES-CBC算法");
    if(type == 0)
    {
      for(m=0;m<16;m++)
        RA[m]=Seed_CBC[m];
      /*用密钥KEY解密RA 得到ra`*/
      AES128_CBC_decrypt_buffer(ra,RA,KEY_Len,Secret_KEY,Iv);
      /*ra`逆向*/
      reverseNum(ra,16);
      testWaitForTimeout(50);
      /*用密钥KEY加密r得到R*/
      AES128_CBC_encrypt_buffer(R,ra,KEY_Len,Secret_KEY,Iv);
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = R[key_i];
    }
    else
    {
      for(key_i = 0; key_i < 16; key_i++)
        Key_Data[key_i+2] = 0x00;
    }
    _Send_Diag(len,msgID,Key_Data);
  }
  else
    _WriteEx_and_Report(ECU_project,"安全访问算法选择异常");
}
dword _Check_Repeat(dword Len)   
{
  dword Repeat_Count;
  dword Repeat_Count_0,Repeat_Count_;
  dword count;
  dword i,j,k;
  int Same_Flage;
  char comment[500];
  char comment_2[500];
  char comment_3[500];
  Repeat_Count = 0;
  Repeat_Count_0 = 0;
  count = 0;
  {
    if(AES_128==0)
    {      
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][0] = Seed_Count_List[i];
        Same_Flage = _Seed_Repeat( Seed_Count_List[i],i,0);
        if(Same_Flage == 1)
          Repeat_Count++;
      }
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][1]++; //初始值为1,出现次数在原基础上加上本身
        if(Seed_Count_List[i]==0)
          Repeat_Count_0++;
      }
      if(Repeat_Count_0==Len)   //若获取到的全部为0,则未收到种子，无重复
        Repeat_Count =0;
    }
    else
    {
      for(i=0;i<Len;i++)
      {
        Repeat_Count_ = 0;
        for(k=0;k<16;k++)
        {
          Seed_Count_AES_Rept[i][k] = Seed_Count_List_AES128[i][k];
          if(Seed_Count_List_AES128[i][k] == 0)
            Repeat_Count_++;
          if(Repeat_Count_ == 16)
            Repeat_Count_0++;
        }
        Same_Flage = _Seed_Repeat(Seed_Count_List_AES128[i],i);
        if(Same_Flage == 1)
          Repeat_Count++;
        Seed_Count_AES_Rept[i][16]++; //初始值为1,出现次数在原基础上加上本身
        testWaitForTimeout(10);
      }
    }
    
    {
      snprintf(comment,elCount(comment),"验证 %d 次,当前重复次数为 %d 次",Len,Repeat_Count);
      snprintf(comment_2,elCount(comment_2),"验证 %d 次,全0种子出现 %d 次",Len,Repeat_Count_0);
      _WriteEx_and_Report("",comment);
      _WriteEx_and_Report("",comment_2);
      if(AES_128 == 0)
      {
        for(i=0;i<Seed_Count;i++)
        {
          if(Seed_Count_Rept[i][1]>1)
          {
            snprintf(comment_3,elCount(comment_3),"种子 0x%08X ,出现次数 %d ",Seed_Count_Rept[i][0],Seed_Count_Rept[i][1]);
            _WriteEx_and_Report("",comment_3);
          }
        }
      }
      else
      {
        for(i=0;i<Seed_Count;i++)
        {
          if(Seed_Count_AES_Rept[i][16]>1)
          {
            char Temp_Str[200];
            snprintf(comment_3,elCount(comment_3),"");
            snprintf(Temp_Str,elCount(Temp_Str),"种子0x");
            for(k=0;k<16;k++)
              snprintf(Temp_Str,elCount(Temp_Str),"%s%02X",Temp_Str,Seed_Count_AES_Rept[i][k]);
            snprintf(comment_3,elCount(comment_3),"%s,出现次数 %d ",Temp_Str,Seed_Count_AES_Rept[i][16]);
            _WriteEx_and_Report("",comment_3);
          }
        }
      }
      if(Request_Seed_Consistency==1)
      {
        Repeat_Count++; //自加一次
        if(Repeat_Count!=Len )
          testStepFail("","重复次数与请求次数不等，重复次数为%d",Repeat_Count);
        else
          testStepPass("","重复次数与请求次数相等");
      }
    }
  }
  _Clear_Seed();
  return Repeat_Count;
}
dword _Check_Repeat(int Len,byte Type)   
{
  dword Repeat_Count;
  dword Repeat_Count_0,Repeat_Count_;
  dword count;
  dword i,j,k;
  char comment[500];
  char comment_2[500];
  char comment_3[500];
  int Same_Flage;
  Repeat_Count = 0;
  Repeat_Count_0 = 0;
  count = 0;
  if(Type==0)
    _Check_Repeat(Len);
  else
  {
    if(AES_128==0)
    {
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][0] = Seed_Count_List[i];
        Same_Flage = _Seed_Repeat( Seed_Count_List[i],i,0);
        if(Same_Flage == 1)
          Repeat_Count++;
      }
      for(i=0;i<Len;i++)
      {
        Seed_Count_Rept[i][1]++; //初始值为1,出现次数在原基础上加上本身
        if(Seed_Count_List[i]==0)
          Repeat_Count_0++;
      }
      if(Repeat_Count_0==Len)   //若获取到的全部为0,则未收到种子，无重复
        Repeat_Count =0;
    }
    else
    {
      for(i=0;i<Len;i++)
      {
        Repeat_Count_ = 0;
        for(k=0;k<16;k++)
        {
          Seed_Count_AES_Rept[i][k] = Seed_Count_List_AES128[i][k];
          if(Seed_Count_List_AES128[i][k] == 0)
