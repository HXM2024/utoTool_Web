  Serve_Data[0].Serve_NRC[1][0]      = 0x13;
  Serve_Data[0].Serve_NRC[1][1]      = 0x12;
  Serve_Data[0].Serve_NRC[1][2]      = 0x13;
                
  Serve_Data[0].Serve_Fun[2]         = 0x03;            //扩展诊断模式
