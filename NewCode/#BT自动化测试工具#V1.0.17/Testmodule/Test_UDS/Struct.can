  Serve_Data[0].Serve_NRC[2][1]      = 0x12;
  Serve_Data[0].Serve_NRC[2][2]      = 0x13;

  /********************11结构体*****************/        
  Serve_Data[1].Serve                = 0x11;
  Serve_Data[1].Serve_Fun_Count      = 2;

                
  Serve_Data[1].Serve_Fun[0]         = 0x01;            //硬件复位
