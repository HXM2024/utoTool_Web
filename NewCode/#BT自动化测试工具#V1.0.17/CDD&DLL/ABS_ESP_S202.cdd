<UNSDEF id='_000001E0F960C580' oid='280A70D8EA434d8f953CE06041D8DCEA' temploid='235F7419D767419e90A69EC1BA238AFA' attrcatref='_000001E0F8E6F2C0' usage='sys' v='500000' df='dec'>
<NAME>
<TUV xml:lang='en-US'>Baudrate</TUV>
</NAME>
<DESC>
<TUV xml:lang='en-US'>Bus Speed of the used transport media. Caution, the Bus Speed has to be set identical in all ECUs connected to one subnet.</TUV>
</DESC>
