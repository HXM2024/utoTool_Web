</NAME>
<DESC>
<TUV xml:lang='en-US'>Time until reception of next flow control</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeoutBs</QUAL>
</UNSDEF>
<UNSDEF id='_000001E0F95F2800' oid='4AEDBA4D77C94f63854E1F6465E566B7' temploid='05A3248BE91B459885223E8A7DA805EF' attrcatref='_000001E0F8E70600' usage='sys' v='100' df='dec'>
<NAME>
