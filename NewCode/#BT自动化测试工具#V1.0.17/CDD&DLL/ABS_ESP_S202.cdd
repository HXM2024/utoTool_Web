</NAME>
<DESC>
<TUV xml:lang='en-US'>Time for next transmission of flow control</TUV>
</DESC>
<QUAL>Comfort_CAN.TimeBr</QUAL>
</UNSDEF>
<UNSDEF id='_000001E0F95EFB70' oid='5EFE9A024D0943a7873A020F58F4EC1B' temploid='534360BC006F48c7824C6B165357740D' attrcatref='_000001E0F8E70600' usage='sys' v='100' df='dec'>
