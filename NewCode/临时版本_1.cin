  dword Serve_31_Hex_Count;
}


void _Init_Struct()
{
  writeEx(-3,1,"------------初始化结构体---------------");
  
'''

    def get_resource_path(self,relative_path):
        if getattr(sys, 'frozen', False):
            base_path = sys._MEIPASS
        else:
            base_path = os.path.dirname(os.path.abspath(__file__))
        return os.path.join(base_path, relative_path)
    
    def normalize_number(self,value, eps=1e-9):
        """
        判断数值是否"接近整数"，接近则取整返回 int，否则原样返回 float。
        可对 openpyxl / pandas / xlrd 读取到的任意数值统一处理。
        """
        if str(value) == 'nan':
            return value
        if isinstance(value, bool):
            return value
        if isinstance(value, int):
            return value
        if isinstance(value, float):
            rounded = round(value)
            # 与最近整数差值小于阈值，视为浮点精度误差，强制取整
            if abs(value - rounded) < eps:
                return int(rounded)
            return value
        return value

    def extract_zip_with_encoding(self, zip_path, extract_to, filename_encoding='gbk'):
        """
        解压 zip 文件，正确处理中文文件名编码，并转换 .can/.cin 文件编码为 gbk
        
        Args:
            zip_path: zip 文件路径
            extract_to: 解压目标目录
            filename_encoding: 文件名编码（默认为 UTF-8)
        """
        with zipfile.ZipFile(zip_path, 'r') as zip_ref:
            for file_info in zip_ref.infolist():
                # 处理文件名编码（解决中文文件名乱码）
                try:
                    # zip 文件中的文件名通常使用 cp437 编码存储
                    file_info.filename = file_info.filename.encode('cp437').decode(filename_encoding)
                except (UnicodeEncodeError, UnicodeDecodeError):
                    pass  # 如果失败，保持原文件名
                
                # 解压文件
                zip_ref.extract(file_info, extract_to)
                
                # 如果解压的是 .can 或 .cin 文件，转换其编码为 UTF-8（不修改内容）
                if file_info.filename.endswith('.can') or file_info.filename.endswith('.cin'):
                    file_full_path = os.path.join(extract_to, file_info.filename)
                    self.convert_file_to_gbk(file_full_path)
    
    def convert_file_to_gbk(self, file_path):
        """
        将文件编码转换为 gbk
        Args:
            file_path: 文件路径
        """
        try:
            # 读取文件内容（尝试多种编码）
            content = None
            for enc in ['utf-8', 'gbk', 'gb2312', 'latin-1']:
                try:
                    with open(file_path, 'r', encoding=enc) as f:
                        content = f.read()
                    break
                except UnicodeDecodeError:
                    continue
            if content is None:
                # print(f"无法读取文件: {file_path}")
                return
            content = content.replace('/*@!Encoding:65001*/', '/*@!Encoding:936*/')
            
            # 保存为 gbk 编码
            with open(file_path, 'w', encoding='gbk') as f:
                f.write(content)
                
        except Exception as e:
            print(f"转换文件编码时出错 {file_path}: {e}")
    
    def create_zip_from_folder(self,folder_path, output_zip_path):
        """
        使用zipfile模块将文件夹打包为ZIP文件
        可以更好地控制压缩选项
        如果已存在相同文件则删除后再压缩
        """
        
        if getattr(sys, 'frozen', False):
            return
        if os.path.exists(output_zip_path):
            os.remove(output_zip_path)
        with zipfile.ZipFile(output_zip_path, 'w', zipfile.ZIP_DEFLATED) as zipf:
            for root, dirs, files in os.walk(folder_path):
                for file in files:
                    file_path = os.path.join(root, file)
                    # 计算相对路径，保持文件夹结构
                    arcname = os.path.relpath(file_path, folder_path)
                    zipf.write(file_path, arcname)
    
    def Data_Change_For_Input(self,data: str):
        """
        将十六进制字符串转换为带0x前缀的格式
        
        Args:
            data: 输入字符串，如 "F1 A1 00 00 00 00 11 22 33 44 55"
        Returns:
            Change_Str: 转换后的字符串，如 "0xF1 0xA1 0x00 0x00 0x00 0x00 0x11 0x22 0x33 0x44 0x55"
            Data_Len: 数据长度
        """
        groups = data.split()
        Change_Str = " ".join([f"0x{x}" for x in groups])
        Data_Len = len(groups)
        
        return Change_Str, Data_Len
    
    def compare_strings(self,Str_1_Input, Str_2_Input, ignore_case, method):
        """
        字符串比较函数，支持多种不区分大小写的方法
        Args:
            Str_1_Input: 第一个字符串
            Str_2_Input: 第二个字符串
            ignore_case: 是否忽略大小写
            method: 方法，可选 "casefold", "lower", "upper"
        Returns:
            bool: 是否相等
        """
        str1 = Str_1_Input
        str2 = Str_2_Input
        # 提取字母
        letters_1 = ''.join([char for char in Str_1_Input if char.isalpha()])
        # 提取字母
        letters_2 = ''.join([char for char in Str_2_Input if char.isalpha()])
        # 提取数字
        digits_1 = ''.join([char for char in Str_1_Input if char.isdigit()])

        if ignore_case == 0 :
            return str1 == str2
        
        if letters_1.lower() == letters_2.lower():
            return digits_1 != "10"
        if method == "casefold":
            return str1.casefold() == str2.casefold()
        elif method == "lower":
            return str1.lower() == str2.lower()
        elif method == "upper":
            return str1.upper() == str2.upper()
        else:
            raise ValueError(f"不支持的比较方法: {method}")

    def parse_to_list(self,data):
        try:
            # 根据类型转换
            if isinstance(data, list):
                return data
            elif isinstance(data, tuple):
                return list(data)
            elif isinstance(data, set):
                return list(data)
            elif isinstance(data, (int, float, str, bool)):
                return [data]
            elif isinstance(data, dict):
                return [data]  # 或者 list(data.items())
            else:
                return [data]  # 其他未知类型，包装成列表
        except:
            return []  # 解析失败
    
    def safe_int_to_str(self,value):
        if pd.isna(value):
            return ""
        if isinstance(value, float) and value.is_integer():
            value = int(value)
        return str(value)

    def _parse_number(self, value):
        """解析数字值（支持十六进制）"""
        if pd.isna(value):
            return None
        
        # 处理字符串类型的数值
        if isinstance(value, str):
            value = value.strip().lower()
            # 处理十六进制
            if value.startswith('0x'):
                try:
                    return int(value, 16)
                except ValueError:
                    messagebox.showwarning("格式错误", f"非法十六进制值: {value}",parent=self.master)
                    return None
            # 处理二进制
            elif value.startswith('0b'):
                try:
                    return int(value, 2)
                except ValueError:
                    messagebox.showwarning("格式错误", f"非法二进制值: {value}",parent=self.master)
                    return None
            # 处理科学计数法
            elif 'e' in value:
                try:
                    return float(value)
                except ValueError:
                    messagebox.showwarning("格式错误", f"非法科学计数法值: {value}",parent=self.master)
                    return None
            elif '[' in value:
                try:
                    value.strip('[]')
                    pet=re.compile(r'0x[0-9a-fA-F]+|\d+')
                    mat=pet.findall(value)
                    listvalue=[]
                    for ma in mat:
                            if ma.startswith('0x'):
                                    listvalue.append(ma)
                            else:
                                    listvalue.append(int(ma)) 
                                        
                    return listvalue
                except ValueError:
                    messagebox.showwarning("格式错误", f"非法列表: {value}",parent=self.master)
                    return None                
            elif '.' in value:
                try:                                     
                    #print(value.strip('0').strip('.') if '.' in value else value)
                    return value.strip('0').strip('.') if '.' in value else value
                except ValueError:
                    messagebox.showwarning("格式错误", f"非法浮点字符串: {value}",parent=self.master)
                    return None                
            elif '/' == value or '\\'==value:
                try:                                     
                    
                    return 0
                except ValueError:
                    messagebox.showwarning("格式错误", f"非法浮点字符串: {value}",parent=self.master)
                    return None                   
        # 通用数值处理
        try:
            num = float(value)
            return int(num) if num.is_integer() else num
        except ValueError:
            messagebox.showwarning("格式错误", f"无法解析的数值: {value}",parent=self.master)
            return None
        
    def _load_excel_sheets(self,name):
        """统一加载所有Excel表"""
        try:
            return pd.read_excel(self.excel_file, sheet_name=name)
        except Exception as e:
            messagebox.showerror("Excel加载错误", f"读取Excel失败: {str(e),name}",parent=self.master)
            return
   
    def _handle_sheet_error(self, sheetname, excel_row, exc):
        """iterrows 循环内出错: 弹窗显示 sheet + Excel行号 + 错误信息"""
        import traceback
        tb_text = traceback.format_exc()
        err_msg = (
            f"Sheet工作表: {sheetname}\n"
            f"Excel行号: 第{excel_row}行\n"
            f"错误类型: {type(exc).__name__}\n"
            f"错误信息: {exc}\n"
            f"\n详细堆栈:\n{tb_text}"
        )
        messagebox.showerror("Sheet处理错误", err_msg, parent=self.master)
        self._error_shown = True
        try:
            log_path = os.path.join(os.path.dirname(self.excel_file), "Excel2Case_error.log")
            with open(log_path, 'a', encoding='utf-8') as lf:
                lf.write("\n" + "=" * 60 + "\n")
                lf.write(f"Sheet: {sheetname}, Excel行: {excel_row}\n")
                lf.write(tb_text)
        except Exception:
            pass
        raise exc

    def _handle_global_error(self, exc):
        """全局兜底: 非 iterrows 内的错误, 显示当前 sheet + 行号(若有)"""
        import traceback
        tb_text = traceback.format_exc()
        sheet_info = self._current_sheet if self._current_sheet else "未知(加载/保存阶段)"
        row_info = f"第{self._current_row}行" if self._current_row else "未进入数据行"
        err_msg = (
            f"当前Sheet: {sheet_info}\n"
            f"当前位置: {row_info}\n"
            f"错误类型: {type(exc).__name__}\n"
            f"错误信息: {exc}\n"
            f"\n详细堆栈:\n{tb_text}"
        )
        messagebox.showerror("运行错误", err_msg, parent=self.master)
        try:
            log_path = os.path.join(os.path.dirname(self.excel_file), "Excel2Case_error.log")
            with open(log_path, 'a', encoding='utf-8') as lf:
                lf.write("\n" + "=" * 60 + "\n")
                lf.write(f"[全局错误] Sheet: {sheet_info}, 行: {row_info}\n")
                lf.write(tb_text)
        except Exception:
            pass
        raise exc

    def _save_file(self):
        """统一保存文件"""
            
    # 弹出确认对话框
        User_Choice = messagebox.askyesno(
            "生成文件确认",
            "是否生成完整文件？\n\n"
            "【是】→ 解压模板并生成完整文件（ini + struct）\n"
            "【否】→ 仅生成（ini + struct）文件",
            icon='question'
        )
        #---------------------------------压缩文件Testmodule_UDS-------------------------------#
        current_dir = os.path.dirname(os.path.abspath(__file__))
        folder_to_zip = os.path.join(current_dir, "Testmodule_UDS")
        output_zip = os.path.join(current_dir, "Testmodule_UDS.zip")
        self.create_zip_from_folder(folder_to_zip, output_zip)
        #---------------------------------解压文件Testmodule_UDS-------------------------------#
        if User_Choice:
            rar_path = self.get_resource_path("Testmodule_UDS.zip")
            extract_to = os.path.dirname(self.excel_file) + "/Testmodule_UDS"
            ini_file_path=os.path.dirname(self.excel_file)+"/Testmodule_UDS/UDS_Main_info.ini"
            struct_file_path=os.path.dirname(self.excel_file)+"/Testmodule_UDS/Struct.cin"
            if os.path.exists(rar_path):
                # 使用带编码处理的解压函数（解决中文乱码问题）
                self.extract_zip_with_encoding(rar_path, extract_to, filename_encoding='gbk')
        else:
            ini_file_path=os.path.dirname(self.excel_file)+"/UDS_Main_info.ini"
            struct_file_path=os.path.dirname(self.excel_file)+"/Struct.cin"
        #---------------------------------保存路径，应当在此处进行修改-------------------------------#
        try:
            with open(ini_file_path, 'w', encoding='utf-8') as f:
                f.write(self.UDS_Main_info)
            with open(struct_file_path, 'w', encoding='gbk') as f:
                f.write(self.struct+'\n}')                
        except Exception as e:
            messagebox.showerror("保存失败", f"文件保存失败：{str(e)}",parent=self.master)
        
    def process_Other(self):
        """处理other配置表"""
        sheetname='Other'
        self._current_sheet = sheetname

        self._current_row = 0

        self._error_shown = False

        if sheetname not in self.sheetnames:
            messagebox.showerror("Excel加载错误",f"缺少{sheetname}工作表",parent=self.master)
            return 
        else:
            self.sheets[sheetname]=self._load_excel_sheets(sheetname)             
                    
        sheet = self.sheets[sheetname]  
        self.Other = sheet.set_index('Symbol')['Value'].to_dict()    
        columns=sheet.columns.tolist()
        for _excel_row,(_,row) in enumerate(sheet.iterrows(), start=2):

            try:

                self._current_row = _excel_row

                if pd.notna(row[columns[0]]):
                    if _ ==0:
                        self.UDS_Main_info+='#'+'******************************{group}******************************#\n'.format(group=row[columns[0]])
                    else:
                        self.UDS_Main_info+='\n\n#'+'******************************{group}******************************#\n'.format(group=row[columns[0]])
                if pd.notna(row[columns[1]]):
                    if pd.notna(row[columns[4]]):
                        self.UDS_Main_info+="\n#{comment}\n".format(comment=row[columns[4]])  
                    if 'ECU_project' in row[columns[1]]:
                        self.Current_Porject = row[columns[2]]  #将当前项目赋值给全局变量
                        self.UDS_Main_info+="[Project_Information]\n"
                        self.UDS_Main_info+="{Var} = {Value}\n".format(Var=row[columns[1]],Value=row[columns[2]])
                        self.UDS_Main_info+="[{}]\n".format(row[columns[2]])
                    else:
                        self.UDS_Main_info+="{Var} = {Value}\n".format(Var=row[columns[1]],Value=row[columns[2]])
                if pd.notna(row[columns[1]]) and  str(row[columns[1]]) == "DID_22_Support":
                    self.SupportDID_Read = row[columns[2]]
            except Exception as e:
                self._handle_sheet_error(sheetname, _excel_row, e)

    def process_1906(self):
        """处理1906配置表"""
        sheetname='1906'
        self._current_sheet = sheetname

        self._current_row = 0

        self._error_shown = False

        if sheetname not in self.sheetnames:
