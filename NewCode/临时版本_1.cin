    byte Security_Access[10];             /*是否需要安全访问(和控制类型对应)*/
    byte Serve_Addres[10];                /*支持的寻址方式(和控制类型对应)*/
    byte Serve_Session[10];               /*支持的会话(和控制类型对应)*/
