                0,##功能DID目前无输入接口，默认为0
                str(row[columns_FunDid[1]]).replace(".0",''),
                DID_Value[:2],
                DID_Value[2:],0,0)   #目前功能DID只验证长度
            except Exception as e:
                self._handle_sheet_error(sheetname_1 if 'sheetname_1' in locals() else sheetname, _excel_row, e)

            
        self.UDS_Main_info +=ini_info   
        
