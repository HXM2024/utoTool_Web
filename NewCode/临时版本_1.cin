    byte Serve_NRC_Special[10][20];       /*31服务下的特殊NRC优先级NRC(和控制类型对应)*/
    byte Serve_NRC_Special_Count[10];     /*31服务下的特殊NRC优先级个数(和控制类型对应)*/
    
  };
