                                                                                         Serve_Addres=Addres,Serve_Session=Session,
            structDIDNRC_Count= 0,
            Serve_NRC22 = 0,
            SSecurity_Access= 0 )   
                DID_Value = DID_Value[2:]
                ini_info+="DID_{} = [{}],[{}],[0x{},0x{}]:[],[{}],[{}]\n".format(
