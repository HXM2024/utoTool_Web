        txt='DTC_ExtendedDataRecord = {sub}'
        template=[]
        for date in sheet[columns[0]]:
            template.append('['+_returnStr(date)+']')
        self.UDS_Main_info+=txt.format(sub="{"+','.join(pd.Series(template).unique().tolist())).replace("'","")+"}\n"
        for _excel_row,(_,row) in enumerate(sheet.iterrows(), start=2):

            try:

                self._current_row = _excel_row

                if pd.notna(row[columns[0]]):
                    self.UDS_Main_info+=_returnStr(row[columns[0]])+" = "+'''[({sub1}),({sub2}),({sub3}),({sub4},{sub5})]\n'''.format(
                        sub1=row[columns[1]],
                        sub2=row[columns[2]],
                        sub3=row[columns[3]],
                        sub4=row[columns[4]],
                        sub5=row[columns[5]],
                        )
            except Exception as e:
                self._handle_sheet_error(sheetname, _excel_row, e)


        #20260609  新增
        if self.compare_strings(self.Current_Porject,"ChangAn",1,"lower"):  
