                if(len(str(_field_val_t))>3 or 'LocalTime' in str(row[columns_FunDid[9]]) or '时间' in str(row[columns_FunDid[9]])):
                    if(len(str(row[columns_FunDid[10]]))> 3):
                        if _field_parts_t[0] == "second":
                            second = ast.literal_eval(row[columns_FunDid[10]])
                        if _field_parts_t[0] == "minute":
                            minute = ast.literal_eval(row[columns_FunDid[10]])
                        if _field_parts_t[0] == "hour":
                            hour = ast.literal_eval(row[columns_FunDid[10]])
                        if _field_parts_t[0] == "day":
                            day = ast.literal_eval(row[columns_FunDid[10]])
                        if _field_parts_t[0] == "month":
                            month = ast.literal_eval(row[columns_FunDid[10]])
                        if _field_parts_t[0] == "year":
                            year = ast.literal_eval(row[columns_FunDid[10]])
