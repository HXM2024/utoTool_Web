    def _draw_gradient_background(self):
        """绘制渐变背景"""
        colors = self._generate_gradient('#0abab5', '#cff3f0', 10, 25)
        square_size = 20
        for row in range(10):
            for col in range(25):
                x1 = col * square_size
                y1 = row * square_size
                x2 = x1 + square_size
                y2 = y1 + square_size
                self.canvas.create_rectangle(x1, y1, x2, y2, 
                    fill=colors[row][col], outline="")

    def _generate_gradient(self, start_color, end_color, steps, rows):
        """生成渐变颜色矩阵"""
        start_rgb = [int(start_color[i:i+2], 16) for i in (1,3,5)]
        end_rgb = [int(end_color[i:i+2], 16) for i in (1,3,5)]
        rgb_steps = [(end - start)/steps for start, end in zip(start_rgb, end_rgb)]
        
        gradient = []
        for i in range(steps + 1):
            gradient_col = []
            for row in range(rows + 1):
                new_rgb = [
                    int(start + i*step + random.uniform(1,step))
                    if (row%2 == i%2) else 0xFF
                    for start, step in zip(start_rgb, rgb_steps)
                ]
                gradient_col.append('#%02x%02x%02x' % tuple(new_rgb))
            gradient.append(gradient_col)
        return gradient

    def select_file(self):
        """选择Excel文件"""
        file_path = filedialog.askopenfilename(filetypes=[("文件", "*.xlsx;*.dbc")])
        if file_path:
            self.excel_text.config(state=tk.NORMAL)
            self.excel_text.delete(1.0, tk.END)
            self.excel_text.insert(tk.END, file_path)
            self.excel_text.config(state=tk.DISABLED)

