                    str(row[columns_FunDid[8]]).replace('nan','').replace('/',''),
                    str(row[columns_FunDid[10]]).replace('nan','').replace('/','').replace('[','').replace(']',''),
                    str(row[columns_FunDid[11]]).replace('nan',',,').replace('/',',,').replace('[','').replace(']','')
                    ) 
            except Exception as e:
