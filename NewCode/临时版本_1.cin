            try:

                self._current_row = _excel_row

                DID_Value = str(row[columns_FunDid[0]])  
                DID_Value = str(DID_Value).replace('0X','').replace('0x','')
                for _i in range(4-len(str(row[columns_FunDid[0]]))):
