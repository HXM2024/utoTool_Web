                Temp_Str = "FunDID_" +str('0000'[:(4-len(str(row[columns_FunDid[0]])))]+str(row[columns_FunDid[0]])).upper()
                if(len(str(row[columns_FunDid[0]]).replace("nan",''))==0 or Temp_Str_2 == Temp_Str):
